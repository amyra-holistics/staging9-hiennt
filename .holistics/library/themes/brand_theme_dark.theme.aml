const brand_dark_theme_tokens = {
  primary: "#74CBE8",
  secondary: "#78DEE0",
  mode: "dark",
  background: "#111315",
  canvas_bg: "#171A1E",
  block_bg: "#20252B",
  text_primary: "#F4F6F8",
  text_muted: "#CBD2D9",
  text_subtle: "#929CA6",
  border: "#3A434D",
  focus_ring: "#A0E3F2",
  semantic_success: "#23A672",
  semantic_warning: "#A0E3F2",
  semantic_danger: "#E57A7A",
  font_body: "Inter",
  font_display: "Inter",
  corner_style: "rounded",
  density: "comfortable",
  elevation: "hairline"
}

PageTheme brand_theme_dark {
  title: "Brand Theme Dark"
  color { data: brand_color_palette }
  background { bg_color: brand_dark_theme_tokens("background") }

  canvas {
    background { bg_color: brand_dark_theme_tokens("canvas_bg") }
    border {
      border_width: 0
      border_radius: 12
      border_color: brand_dark_theme_tokens("border")
      border_style: "none"
    }
    shadow: "none"
    opacity: 1
  }

  block {
    background { bg_color: brand_dark_theme_tokens("block_bg") }
    border {
      border_width: 1
      border_radius: 12
      border_color: brand_dark_theme_tokens("border")
      border_style: "solid"
    }
    shadow: "none"
    padding: 16
    opacity: 1
    label {
      font_family: brand_dark_theme_tokens("font_display")
      font_size: 14
      font_color: brand_dark_theme_tokens("text_primary")
      font_weight: "semibold"
      font_style: "normal"
      letter_spacing: "0"
    }
    text {
      font_family: brand_dark_theme_tokens("font_body")
      font_size: 13
      font_color: brand_dark_theme_tokens("text_muted")
      font_weight: "normal"
      font_style: "normal"
    }
  }

  viz {
    table {
      general {
        bg_color: brand_dark_theme_tokens("block_bg")
        font_color: brand_dark_theme_tokens("text_muted")
        font_family: brand_dark_theme_tokens("font_body")
        font_size: 13
        border_color: brand_dark_theme_tokens("border")
        grid_color: brand_dark_theme_tokens("border")
        border_width: 1
        hover_color: "#2A3037"
        banding_color: "#252B31"
        cell_padding: DetailedSpacing { top: 10, right: 16, bottom: 10, left: 16 }
        borders { outer: true, vertical: false, horizontal: true, header: true, row_header: false }
      }
      header {
        bg_color: brand_dark_theme_tokens("background")
        font_color: brand_dark_theme_tokens("text_primary")
        font_size: 13
        font_weight: "semibold"
      }
      sub_header {
        bg_color: "#252B31"
        font_color: brand_dark_theme_tokens("text_muted")
        font_size: 13
        font_weight: "medium"
      }
      sub_title {
        font_color: brand_dark_theme_tokens("text_subtle")
        font_size: 12
        font_weight: "medium"
      }
      sparkline {
        line { color: brand_dark_theme_tokens("primary") }
        column { color: brand_dark_theme_tokens("secondary") }
      }
    }

    metric_kpi {
      alignment: "left"
      label {
        font_family: brand_dark_theme_tokens("font_body")
        font_size: 20
        font_color: brand_dark_theme_tokens("text_muted")
      }
      value {
        font_family: brand_dark_theme_tokens("font_display")
        font_size: 48
        font_color: brand_dark_theme_tokens("text_primary")
      }
      progress {
        indicator { bg_color: brand_dark_theme_tokens("primary") }
        track { bg_color: brand_dark_theme_tokens("border") }
        text { font_color: brand_dark_theme_tokens("text_muted") }
      }
      trend {
        positive { text { font_color: brand_dark_theme_tokens("semantic_success") font_weight: "medium" } background { bg_color: "oklch(0.38 0.05 155)" } }
        negative { text { font_color: brand_dark_theme_tokens("semantic_danger") font_weight: "medium" } background { bg_color: "oklch(0.38 0.05 25)" } }
        neutral { text { font_color: brand_dark_theme_tokens("text_muted") font_weight: "normal" } background { bg_color: "#2A3037" } }
      }
    }
  }

  custom_css: @css
    .dac-text-block {
      font-family: Inter;
      font-size: 14px;
      color: #CBD2D9;
      line-height: 1.6;
    }
    .dac-text-block h1, .dac-text-block h2, .dac-text-block h3, .dac-text-block h4, .dac-text-block h5, .dac-text-block h6 {
      font-family: Inter;
      color: #F4F6F8;
      line-height: 1.3;
      margin-top: 0;
      margin-bottom: 0.5em;
      font-weight: 600;
    }
  ;;
}