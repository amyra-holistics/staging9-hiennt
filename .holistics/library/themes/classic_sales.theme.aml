    label { font_family: classic_sales_brand("font_display") font_size: 14 font_color: classic_sales_brand("text_primary_dark") font_weight: "semibold" font_style: "normal" letter_spacing: "0" }
    text { font_family: classic_sales_brand("font_body") font_size: 13 font_color: classic_sales_brand("text_muted_dark") font_weight: "normal" font_style: "normal" }
  }
  viz {
    table {
      general {
        bg_color: classic_sales_brand("block_bg_dark")
        font_color: classic_sales_brand("text_muted_dark")
        font_family: classic_sales_brand("font_body")
        font_size: 13
        border_color: classic_sales_brand("border_dark")
        grid_color: classic_sales_brand("border_dark")
        border_width: 1
        hover_color: "oklch(0.37 0.018 250)"
        banding_color: "oklch(0.34 0.014 250)"
        cell_padding: DetailedSpacing { top: 10, right: 16, bottom: 10, left: 16 }
        borders { outer: true, vertical: false, horizontal: true, header: true, row_header: false }
      }
      header { bg_color: classic_sales_brand("background_dark") font_color: classic_sales_brand("text_primary_dark") font_size: 13 font_weight: "semibold" }
      sub_header { bg_color: "oklch(0.34 0.014 250)" font_color: classic_sales_brand("text_muted_dark") font_size: 13 font_weight: "medium" }
      sub_title { font_color: classic_sales_brand("text_subtle_dark") font_size: 12 font_weight: "medium" }
