      value { font_family: classic_sales_brand("font_display") font_size: 48 font_color: classic_sales_brand("text_primary_dark") }
      progress { indicator { bg_color: classic_sales_brand("primary") } track { bg_color: classic_sales_brand("border_dark") } text { font_color: classic_sales_brand("text_muted_dark") } }
      trend {
        positive { text { font_color: classic_sales_brand("semantic_success_dark") font_weight: "medium" } background { bg_color: "oklch(0.40 0.05 155)" } }
        negative { text { font_color: classic_sales_brand("semantic_danger_dark") font_weight: "medium" } background { bg_color: "oklch(0.40 0.05 25)" } }
        neutral { text { font_color: classic_sales_brand("text_muted_dark") font_weight: "normal" } background { bg_color: "oklch(0.37 0.018 250)" } }
