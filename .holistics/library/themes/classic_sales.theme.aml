    }
  }
  custom_css: @css
    .dac-text-block { font-family: Inter; font-size: 14px; color: oklch(0.78 0.02 250); line-height: 1.6; }
    .dac-text-block h1, .dac-text-block h2, .dac-text-block h3, .dac-text-block h4, .dac-text-block h5, .dac-text-block h6 { font-family: Georgia; color: oklch(0.94 0.01 250); line-height: 1.3; margin-top: 0; margin-bottom: 0.5em; font-weight: 600; }
  ;;
}
