      <span class="npr-rh-issue"></span>
      <span class="npr-folio"></span>
    </div>

    <div class="npr-sec is-live">
      <span class="npr-lab">Live</span>
      <h2>Good Progress</h2>
      <span class="npr-note">edit this note each week</span>
    </div>
    <h-block name="t_live" />

    <div class="npr-sec is-risk">
      <span class="npr-lab">Risk</span>
      <h2>Stuck at the line</h2>
      <span class="npr-note">edit this note each week</span>
    </div>
    <h-block name="t_risk" />

    <div class="npr-sec is-new">
      <span class="npr-lab">New</span>
      <h2>New</h2>
      <span class="npr-note">edit this note each week</span>
    </div>
    <h-block name="t_new" />

  </div>

  <!-- ============================ PAGE 4 ============================ -->
  <div class="npr-page">

    <div class="npr-runhead">
      <span class="npr-rh-title"></span>
      <span class="npr-rh-issue"></span>
      <span class="npr-folio"></span>
    </div>

    <div class="npr-sec is-hi">
      <span class="npr-lab">Moving</span>
      <h2>Highlights</h2>
      <span class="npr-note">edit this note each week</span>
    </div>
    <h-block name="t_highlights" />

    <div class="npr-sec is-quiet">
      <span class="npr-lab">Quiet</span>
      <h2>Quiet</h2>
      <span class="npr-note">edit this note each week</span>
    </div>
    <h-block name="t_quiet" />

  </div>

  <!-- ============================ PAGE 5 ============================ -->
  <div class="npr-page">

    <div class="npr-runhead">
      <span class="npr-rh-title"></span>
      <span class="npr-rh-issue"></span>
      <span class="npr-folio"></span>
    </div>

    <div class="npr-sec is-eng">
      <span class="npr-lab">Product</span>
      <h2>For product engineering</h2>
      <span class="npr-note">edit this note each week</span>
    </div>
    <h-block name="t_product" />

    <div class="npr-sec is-risk">
      <span class="npr-lab">Diary</span>
      <h2>What to watch next week</h2>
      <span class="npr-note">edit this note each week</span>
    </div>
    <h-block name="t_watch" />

    <div class="npr-sec is-pattern">
      <span class="npr-lab">Pattern</span>
      <h2>One thing we are noticing</h2>
      <span class="npr-note">edit this note each week</span>
    </div>
    <h-block name="t_pattern" />

    <!-- OPTIONAL full-width table slot. Uncomment with v_pattern above,
         or delete this div entirely. -->
    <div class="npr-figure is-wide">
      <!-- <h-block name="v_pattern" /> -->
    </div>

    <div class="npr-footer"></div>

  </div>

</div>

    ;;
  }
}
