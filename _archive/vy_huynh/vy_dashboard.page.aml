Dashboard untitled_4_2 {
  title: 'vy_dashboard'
  description: '2312321adasdasd32131'
  owner: 'vy.ht@holistics.io'
  block v_ntre: VizBlock {
    label: 'Date, Category, and Sales'
    viz: DataTable {
      dataset: vy_test
      fields: [
        VizFieldFull {
          ref: r(vy_test_filter_dependency_sheet_1_csv.date)
          format {
            type: 'text'
          }
          uname: 'vy_test_filter_dependency_sheet_1_csv_date_1'
        },
        VizFieldFull {
          ref: r(vy_test_filter_dependency_sheet_1_csv.category)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(vy_test_filter_dependency_sheet_1_csv.sales)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        show_row_number: true
        sorts: [
          SortSetting {
            key: 'vy_test_filter_dependency_sheet_1_csv_date_1'
            direction: 'asc'
          }
        ]
      }
    }
  }
  block f_0hsw: FilterBlock {
    label: 'Date'
    type: 'field'
    source: FieldFilterSource {
      dataset: vy_test
      field: r(vy_test_filter_dependency_sheet_1_csv.date)
    }
    default {
      operator: 'matches'
      value: '$H_NIL$'
    }
  }
  block f_o8ba: FilterBlock {
    label: 'Sale'
    type: 'field'
    source: FieldFilterSource {
      dataset: vy_test
      field: r(vy_test_filter_dependency_sheet_1_csv.sales)
    }
    default {
      operator: 'is'
      value: []
    }
  }
  block f_5nfr: FilterBlock {
    label: 'Category'
    type: 'field'
    source: FieldFilterSource {
      dataset: vy_test
      field: r(vy_test_filter_dependency_sheet_1_csv.category)
    }
    default {
      operator: 'is'
      value: []
    }
  }
  block v_ksvb: VizBlock {
    label: 'Count order ID and Count User by Month Order date'
    viz: PieChart {
      dataset: superstore
      calculation count_of_superstore_csv_order {
        label: 'Count order ID'
        formula: @aql count(superstore_csv.order_id);;
        calc_type: 'measure'
        data_type: 'number'
        format {
          type: 'number'
          pattern: 'none'
        }
      }
      calculation count_user {
        label: 'Count User'
        formula: @aql count(superstore_csv.customer_name);;
        calc_type: 'measure'
        data_type: 'number'
        format {
          type: 'number'
          pattern: 'none'
        }
      }
      calculation count_order_date {
        label: 'Count order date'
        formula: @aql count(superstore_csv.order_date);;
        calc_type: 'measure'
        data_type: 'number'
        format {
          type: 'number'
          pattern: 'none'
        }
      }
      legend: VizFieldFull {
        ref: r(superstore_csv.order_date)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      series {
        field: VizFieldFull {
          ref: 'count_of_superstore_csv_order'
          format {
            type: 'number'
            pattern: 'none'
          }
        }
