Dashboard r01_claude_canvas_a2 {
  title: 'Executive Sales Overview'
  description: 'Net Sales, Orders, AOV and Gross Margin for TheLook eCommerce, with monthly trend and top categories.'

  block title: TextBlock {
    content: @md
# Executive Sales Overview
Net sales performance for TheLook eCommerce. Net Sales exclude Cancelled and Returned items.
    ;;
  }

  block f_date: FilterBlock {
    label: 'Order Date'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
    default {
      operator: 'matches'
      value: 'last 12 months'
    }
  }

  block kpi_net_sales: VizBlock {
    label: 'Net Sales'
    description: 'Sale price of order items, excluding Cancelled and Returned items.'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block kpi_orders: VizBlock {
    label: 'Orders'
    description: 'Number of orders, every status.'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.total_orders)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block kpi_aov: VizBlock {
    label: 'Average Order Value'
    description: 'Net Sales per fulfilled order (orders with at least one item counted in Net Sales).'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block kpi_gross_margin: VizBlock {
    label: 'Gross Margin'
    description: '(Net Sales - COGS) / Net Sales.'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block v_monthly_net_sales: VizBlock {
    label: 'Monthly Net Sales'
    viz: LineChart {
      dataset: thelook
      x_axis: VizFieldFull {
        label: 'Month'
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
        show_data_points: true
      }
    }
  }

  block v_top_categories: VizBlock {
    label: 'Top 10 Categories by Net Sales'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        label: 'Category'
        ref: r(thelook_products.category)
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        row_limit: 10
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block note: TextBlock {
    content: @md
**Data source:** TheLook eCommerce dataset (`thelook`, data source `demodb`), order items grain. **Last updated:** 27 Sep 2026 (latest CSV import); orders available through 31 Aug 2026. All figures follow the Order Date filter.
    ;;
  }

  view: CanvasLayout {
    label: 'Overview'
    width: 1200
    height: 740
    grid_size: 20
    auto_expand_vertically: true
    block title {
      position: pos(20, 20, 840, 80)
    }
    block f_date {
      position: pos(880, 20, 300, 80)
    }
    block kpi_net_sales {
      position: pos(20, 120, 275, 130)
    }
    block kpi_orders {
      position: pos(315, 120, 275, 130)
    }
    block kpi_aov {
      position: pos(610, 120, 275, 130)
    }
    block kpi_gross_margin {
      position: pos(905, 120, 275, 130)
    }
    block v_monthly_net_sales {
      position: pos(20, 270, 700, 380)
    }
    block v_top_categories {
      position: pos(740, 270, 440, 380)
    }
    block note {
      position: pos(20, 670, 1160, 50)
    }
    mobile {
      mode: 'auto'
    }
  }

  theme: H.themes.vanilla
}
