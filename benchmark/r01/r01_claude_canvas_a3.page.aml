Dashboard r01_claude_canvas_a3 {
  title: 'Executive Sales Overview'
  description: 'Headline sales KPIs, monthly Net Sales trend and top categories for TheLook eCommerce.'

  block title: TextBlock {
    content: @md
      # Executive Sales Overview
      Net Sales exclude Cancelled and Returned items. All figures follow the order date filter.
    ;;
  }

  block f_order_date: FilterBlock {
    label: 'Order Date'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_orders.created_at)
    }
    default {
      operator: 'last'
      value: 12
      modifier: 'month'
      options {
        include_current_period: true
      }
    }
  }

  block kpi_net_sales: VizBlock {
    label: 'Net Sales'
    description: 'Sale price of order items, excluding Cancelled and Returned items.'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block kpi_orders: VizBlock {
    label: 'Orders'
    description: 'Number of orders, every status.'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.total_orders)
        label: 'Orders'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block kpi_aov: VizBlock {
    label: 'AOV'
    description: 'Average Order Value: Net Sales per fulfilled order.'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'AOV'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block kpi_gross_margin: VizBlock {
    label: 'Gross Margin'
    description: 'Gross Profit (Net Sales minus COGS) as a share of Net Sales.'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block v_monthly_net_sales: VizBlock {
    label: 'Monthly Net Sales'
    viz: LineChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_orders.created_at)
        label: 'Month'
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
        show_data_points: true
      }
    }
  }

  block v_top_categories: VizBlock {
    label: 'Top 10 Categories by Net Sales'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Category'
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        row_limit: 10
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block v_data_note: VizBlock {
    label: 'Data source'
    settings {
      hide_label: true
    }
    viz: MarkdownViz {
      dataset: thelook
      calculation last_updated {
        label: 'Last Updated'
        formula: @aql thelook_order_items | max(thelook_order_items.created_at);;
        calc_type: 'measure'
        data_type: 'datetime'
      }
      values: [
        VizFieldFull {
          ref: 'last_updated'
          label: 'Last Updated'
          format {
            type: 'datetime'
            pattern: 'LLL dd, yyyy HH:mm'
          }
        }
      ]
      content: @md
        <div style="color: #6B7280; font-size: 12px; line-height: 1.5;">
          <strong>Data source:</strong> TheLook eCommerce dataset (demodb) &nbsp;·&nbsp;
          <strong>Last updated:</strong> {{ rows[0].`Last Updated`.formatted }} (latest order item)
        </div>
      ;;
      settings {
        row_limit: 1
      }
    }
  }

  interactions: [
    FilterInteraction {
      from: 'f_order_date'
      to: [
        CustomMapping {
          block: 'v_data_note'
          disabled: true
        }
      ]
    }
  ]

  view: CanvasLayout {
    label: 'Overview'
    width: 1300
    height: 720
    grid_size: 20
    auto_expand_vertically: true
    block title {
      position: pos(20, 20, 900, 80)
    }
    block f_order_date {
      position: pos(940, 20, 340, 80)
    }
    block kpi_net_sales {
      position: pos(20, 120, 300, 120)
    }
    block kpi_orders {
      position: pos(340, 120, 300, 120)
    }
    block kpi_aov {
      position: pos(660, 120, 300, 120)
    }
    block kpi_gross_margin {
      position: pos(980, 120, 300, 120)
    }
    block v_monthly_net_sales {
      position: pos(20, 260, 820, 380)
    }
    block v_top_categories {
      position: pos(860, 260, 420, 380)
    }
    block v_data_note {
      position: pos(20, 660, 1260, 40)
    }
    mobile {
      mode: 'auto'
    }
  }

  theme: H.themes.vanilla
}
