Dashboard r01_claude_fd_canvas_a1 {
  title: 'Executive Sales Overview'
  description: 'Net Sales, Orders, AOV and Gross Margin for TheLook eCommerce, with monthly trend and top categories.'

  block t_header: TextBlock {
    content: @md
      <div style="padding: 4px 0;">
        <div style="font-size: 26px; font-weight: 700; color: #111827;">Executive Sales Overview</div>
        <div style="font-size: 13px; color: #6B7280; margin-top: 4px;">TheLook eCommerce · all figures follow the order date filter</div>
      </div>
    ;;
  }

  block f_date: FilterBlock {
    label: 'Order Date'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_orders.created_at)
    }
    default {
      operator: 'last'
      value: 12
      modifier: 'month'
      options: ConditionOptions {
        include_current_period: true
      }
    }
  }

  block v_net_sales: VizBlock {
    label: 'Net Sales'
    description: 'Sale price of order items, excluding Cancelled and Returned items.'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
    settings {
      hide_label: true
    }
  }

  block v_orders: VizBlock {
    label: 'Orders'
    description: 'Number of orders, every status.'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.total_orders)
        label: 'Orders'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
    settings {
      hide_label: true
    }
  }

  block v_aov: VizBlock {
    label: 'AOV'
    description: 'Net Sales per fulfilled order.'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'AOV'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
    settings {
      hide_label: true
    }
  }

  block v_gross_margin: VizBlock {
    label: 'Gross Margin'
    description: 'Gross Profit (Net Sales minus COGS) as a share of Net Sales.'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
    settings {
      hide_label: true
    }
  }

  block v_monthly_net_sales: VizBlock {
    label: 'Monthly Net Sales'
    viz: LineChart {
      dataset: thelook
      x_axis: VizFieldFull {
        label: 'Order Month'
        ref: r(thelook_orders.created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            label: 'Net Sales'
            ref: r(thelook.net_sales)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block v_top_categories: VizBlock {
    label: 'Top 10 Categories by Net Sales'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Category'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      settings {
        row_limit: 10
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block v_footer: VizBlock {
    label: 'Data source and last updated'
    viz: MarkdownViz {
      dataset: thelook
      calculation last_order {
        label: 'Last Order'
        formula: @aql max(thelook_order_items.created_at);;
        calc_type: 'measure'
        data_type: 'datetime'
      }
      values: [
        VizFieldFull {
          ref: 'last_order'
          label: 'Last Order'
          format {
            type: 'datetime'
            pattern: 'LLL dd, yyyy HH:mm'
          }
        }
      ]
      content: @md
        <div style="color: #6B7280; font-size: 12px; line-height: 1.5;">
          <b>Data source:</b> TheLook eCommerce dataset (demodb) &nbsp;·&nbsp;
          <b>Last updated:</b> {{ rows[0].values.`Last Order`.formatted }} (latest order item) &nbsp;·&nbsp;
          Net Sales and Gross Margin exclude Cancelled and Returned items; Orders count every status; AOV = Net Sales per fulfilled order.
        </div>
      ;;
      settings {
        row_limit: 1
      }
    }
    settings {
      hide_label: true
    }
  }

  interactions: [
    FilterInteraction {
      from: 'f_date'
      to: [
        CustomMapping {
          block: 'v_footer'
          disabled: true
        }
      ]
    }
  ]

  view: CanvasLayout {
    label: 'Overview'
    width: 1200
    height: 760
    grid_size: 20
    auto_expand_vertically: true
    block t_header {
      position: pos(20, 20, 820, 80)
    }
    block f_date {
      position: pos(860, 20, 320, 80)
    }
    block v_net_sales {
      position: pos(20, 120, 275, 120)
    }
    block v_orders {
      position: pos(315, 120, 275, 120)
    }
    block v_aov {
      position: pos(610, 120, 275, 120)
    }
    block v_gross_margin {
      position: pos(905, 120, 275, 120)
    }
    block v_monthly_net_sales {
      position: pos(20, 260, 700, 400)
    }
    block v_top_categories {
      position: pos(740, 260, 440, 400)
    }
    block v_footer {
      position: pos(20, 680, 1160, 60)
    }
    mobile {
      mode: 'auto'
    }
  }
}
