Dashboard r01_claude_fd_canvas_a2 {
  title: 'Executive Sales Overview'
  description: 'Net sales, orders, AOV and gross margin for TheLook eCommerce.'

  block t_header: TextBlock {
    content: @md
## Executive Sales Overview
Net Sales excludes Cancelled and Returned items. All figures follow the date filter (order item created date).
;;
  }

  block f_date: FilterBlock {
    label: 'Order Date'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
    default {
      operator: 'last'
      value: '12'
      modifier: 'month'
      options {
        include_current_period: true
      }
    }
  }

  block v_net_sales: VizBlock {
    label: 'Net Sales'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: '[$$]#,###0'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
  }

  block v_orders: VizBlock {
    label: 'Orders'
    description: 'Orders with at least one item counted in Net Sales (excludes fully cancelled or returned orders).'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        label: 'Orders'
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
  }

  block v_aov: VizBlock {
    label: 'AOV'
    description: 'Average Order Value: Net Sales per order.'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'AOV'
        format {
          type: 'number'
          pattern: '[$$]#,###0.00'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
  }

  block v_gross_margin: VizBlock {
    label: 'Gross Margin'
    description: '(Net Sales - COGS) / Net Sales.'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: '#,###0.0%'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
  }

  block v_monthly_net_sales: VizBlock {
    label: 'Monthly Net Sales'
    viz: LineChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        label: 'Month'
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
        row_limit: 5000
        show_data_points: true
      }
    }
  }

  block v_top_categories: VizBlock {
    label: 'Top 10 Categories by Net Sales'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Category'
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      settings {
        row_limit: 10
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block t_source: TextBlock {
    content: @md
**Data source:** TheLook eCommerce dataset (`thelook`, demodb). Sales grain is order items; COGS uses product cost.
;;
  }

  block v_last_updated: VizBlock {
    label: 'Last updated'
    description: 'Timestamp of the most recent order item in the data. Not affected by the date filter.'
    viz: MetricKpi {
      dataset: thelook
      calculation latest_order_item_at {
        label: 'Data as of'
        formula: @aql max(thelook_order_items.created_at) ;;
        calc_type: 'measure'
        data_type: 'datetime'
      }
      value: VizFieldFull {
        ref: 'latest_order_item_at'
        label: 'Data as of'
        format {
          type: 'datetime'
          pattern: 'yyyy-MM-dd HH:mm'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
        metric_value {
          font_size: 16
        }
        label {
          font_size: 12
        }
      }
    }
  }

  interactions: [
    FilterInteraction {
      from: 'f_date'
      to: [
        CustomMapping {
          block: 'v_last_updated'
          disabled: true
        }
      ]
    }
  ]

  view: CanvasLayout {
    label: 'Overview'
    width: 1200
    height: 760
    grid_size: 20
    auto_expand_vertically: true
    block t_header {
      position: pos(20, 20, 840, 80)
    }
    block f_date {
      position: pos(880, 20, 300, 80)
    }
    block v_net_sales {
      position: pos(20, 120, 275, 130)
    }
    block v_orders {
      position: pos(315, 120, 275, 130)
    }
    block v_aov {
      position: pos(610, 120, 275, 130)
    }
    block v_gross_margin {
      position: pos(905, 120, 275, 130)
    }
    block v_monthly_net_sales {
      position: pos(20, 270, 720, 400)
    }
    block v_top_categories {
      position: pos(760, 270, 420, 400)
    }
    block t_source {
      position: pos(20, 690, 840, 60)
    }
    block v_last_updated {
      position: pos(880, 690, 300, 60)
    }
    mobile {
      mode: 'auto'
    }
  }

  theme: H.themes.vanilla
}
