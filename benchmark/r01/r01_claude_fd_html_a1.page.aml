Dashboard r01_claude_fd_html_a1 {
  title: 'Executive Sales Overview'
  description: 'Net Sales, Orders, AOV and Gross Margin for TheLook eCommerce, with monthly trend and top categories.'

  block f_order_date: FilterBlock {
    label: 'Order Date'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_orders.created_at)
    }
    default {
      operator: 'matches'
      value: 'last 12 months'
    }
  }

  block kpi_net_sales: VizBlock {
    label: 'Net Sales'
    description: 'Sale price of order items, excluding Cancelled and Returned items.'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
      }
    }
  }

  block kpi_orders: VizBlock {
    label: 'Orders'
    description: 'Number of orders, every status.'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.total_orders)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
      }
    }
  }

  block kpi_aov: VizBlock {
    label: 'AOV'
    description: 'Average Order Value: Net Sales per fulfilled order.'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
      }
    }
  }

  block kpi_gross_margin: VizBlock {
    label: 'Gross Margin'
    description: 'Gross Profit (Net Sales minus COGS) as a share of Net Sales.'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
      }
    }
  }

  block net_sales_trend: VizBlock {
    label: 'Monthly Net Sales'
    viz: LineChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_orders.created_at)
        label: 'Order Month'
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        x_axis_label: 'Order Month'
        legend_label: 'hidden'
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block top_categories: VizBlock {
    label: 'Top 10 Categories by Net Sales'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Category'
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        row_limit: 10
        legend_label: 'hidden'
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block latest_order: VizBlock {
    label: 'Latest order in data'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook_orders.created_at)
        aggregation: 'max'
        format {
          type: 'date'
          pattern: 'LLL dd, yyyy'
        }
      }
      settings {
        display_mode: 'single'
      }
    }
  }

  block source_note: TextBlock {
    content: @md
**Data source:** TheLook eCommerce dataset (`thelook`) on `demodb`, loaded from CSV imports.
**Last updated:** Sep 27, 2026 (latest data import).
Net Sales excludes Cancelled and Returned items. Dates use order created date.
    ;;
  }

  // The freshness indicator should always show the latest order overall, not the filtered period
  interactions: [
    FilterInteraction {
      from: 'f_order_date'
      to: [
        CustomMapping {
          block: 'latest_order'
          disabled: true
        }
      ]
    }
  ]

  view: HTMLLayout {
    content: @html
      <style>
        .exec {
          --ink: #1b2430;
          --muted: #5b6675;
          --line: #e3e7ec;
          --accent: #1f5fbf;
          font-family: Inter, 'Segoe UI', system-ui, sans-serif;
          color: var(--ink);
          background: #f6f7f9;
          padding: 24px 28px 28px;
          display: flex;
          flex-direction: column;
          gap: 16px;
          min-height: 100%;
          box-sizing: border-box;
        }
        .exec-header {
          display: flex;
          justify-content: space-between;
          align-items: flex-end;
          gap: 24px;
          flex-wrap: wrap;
          padding-bottom: 14px;
          border-bottom: 1px solid var(--line);
        }
        .exec-title .eyebrow {
          font-size: 11px;
          font-weight: 600;
          letter-spacing: 0.08em;
          text-transform: uppercase;
          color: var(--accent);
          margin: 0 0 4px;
        }
        .exec-title h1 {
          font-size: 24px;
          font-weight: 650;
          margin: 0;
          letter-spacing: -0.01em;
        }
        .exec-title p {
          margin: 4px 0 0;
          font-size: 13px;
          color: var(--muted);
        }
        .exec-filter {
          width: 300px;
          min-height: 72px;
        }
        .kpi-row {
          display: grid;
          grid-template-columns: repeat(4, minmax(0, 1fr));
          gap: 16px;
        }
        .kpi {
          height: 130px;
          background: #fff;
          border: 1px solid var(--line);
          border-top: 3px solid var(--accent);
          border-radius: 8px;
          overflow: hidden;
        }
        .chart-row {
          display: grid;
          grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
          gap: 16px;
        }
        .panel {
          height: 400px;
          background: #fff;
          border: 1px solid var(--line);
          border-radius: 8px;
          overflow: hidden;
        }
        .footer {
          display: grid;
          grid-template-columns: minmax(0, 1fr) 240px;
          gap: 16px;
          align-items: stretch;
          border-top: 1px solid var(--line);
          padding-top: 12px;
        }
        .footer-note {
          min-height: 90px;
          font-size: 12px;
          color: var(--muted);
        }
        .footer-fresh {
          height: 90px;
          background: #fff;
          border: 1px solid var(--line);
          border-radius: 8px;
          overflow: hidden;
        }
        @media (max-width: 1000px) {
          .kpi-row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
          .chart-row, .footer { grid-template-columns: 1fr; }
          .exec-filter { width: 100%; }
        }
      </style>

      <div class="exec">
        <header class="exec-header">
          <div class="exec-title">
            <p class="eyebrow">TheLook eCommerce</p>
            <h1>Executive Sales Overview</h1>
            <p>Net sales performance by order date. Defaults to the last 12 months.</p>
          </div>
          <div class="exec-filter">
            <h-block name="f_order_date" />
          </div>
        </header>

        <section class="kpi-row">
          <div class="kpi"><h-block name="kpi_net_sales" /></div>
          <div class="kpi"><h-block name="kpi_orders" /></div>
          <div class="kpi"><h-block name="kpi_aov" /></div>
          <div class="kpi"><h-block name="kpi_gross_margin" /></div>
        </section>

        <section class="chart-row">
          <div class="panel"><h-block name="net_sales_trend" /></div>
          <div class="panel"><h-block name="top_categories" /></div>
        </section>

        <footer class="footer">
          <div class="footer-note"><h-block name="source_note" /></div>
          <div class="footer-fresh"><h-block name="latest_order" /></div>
        </footer>
      </div>
    ;;
  }
}
