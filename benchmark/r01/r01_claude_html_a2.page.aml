Dashboard r01_claude_html_a2 {
  title: 'Executive Sales Overview'
  description: 'Net Sales, Orders, AOV and Gross Margin with monthly trend and top categories.'

  block header: TextBlock {
    content: @md
      <div class="hdr">
        <h1>Executive Sales Overview</h1>
        <p>Net Sales exclude Cancelled and Returned items. All figures follow the Order Date filter.</p>
      </div>
    ;;
  }

  block f_order_date: FilterBlock {
    label: 'Order Date'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_orders.created_at)
    }
    default {
      operator: 'matches'
      value: 'last 12 months'
    }
  }

  block kpi_net_sales: VizBlock {
    label: 'Net Sales'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block kpi_orders: VizBlock {
    label: 'Orders'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.total_orders)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block kpi_aov: VizBlock {
    label: 'Average Order Value'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block kpi_gross_margin: VizBlock {
    label: 'Gross Margin'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block monthly_net_sales: VizBlock {
    label: 'Monthly Net Sales'
    viz: LineChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_orders.created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
        show_data_points: false
      }
    }
  }

  block top_categories: VizBlock {
    label: 'Top 10 Categories by Net Sales'
    viz: BarChart {
      dataset: thelook
      x_axis: r(thelook_products.category)
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        row_limit: 10
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block source_note: VizBlock {
    label: 'Data source'
    viz: MarkdownViz {
      dataset: thelook
      calculation last_updated {
        label: 'Last Updated'
        formula: @aql max(thelook_order_items.created_at);;
        calc_type: 'measure'
        data_type: 'datetime'
      }
      values: [
        VizFieldFull {
          ref: 'last_updated'
          label: 'Last Updated'
          format {
            type: 'datetime'
          }
        }
      ]
      content: @md
        **Data source:** TheLook eCommerce dataset (`thelook`, demodb) · **Last updated:** data through {{ rows[0].`Last Updated`.formatted }}
      ;;
      settings {
        row_limit: 1
      }
    }
  }

  interactions: [
    FilterInteraction {
      from: 'f_order_date'
      to: [
        CustomMapping {
          block: ['kpi_net_sales', 'kpi_orders', 'kpi_aov', 'kpi_gross_margin', 'monthly_net_sales', 'top_categories']
          field: r(thelook_orders.created_at)
        },
        CustomMapping {
          block: 'source_note'
          disabled: true
        }
      ]
    }
  ]

  view: HTMLLayout {
    content: @html
      <style>
        .page {
          display: flex;
          flex-direction: column;
          gap: 16px;
          padding: 20px 24px;
          background: #f6f7f9;
        }
        .top {
          display: flex;
          align-items: flex-end;
          justify-content: space-between;
          gap: 16px;
        }
        .hdr h1 { margin: 0 0 4px; font-size: 22px; }
        .hdr p { margin: 0; color: #6b7280; font-size: 13px; }
        .filter { width: 280px; flex-shrink: 0; }
        .kpis {
          display: grid;
          grid-template-columns: repeat(4, 1fr);
          gap: 16px;
        }
        .card {
          background: #ffffff;
          border: 1px solid #e5e7eb;
          border-radius: 8px;
        }
        .kpi { height: 120px; }
        .charts {
          display: grid;
          grid-template-columns: 3fr 2fr;
          gap: 16px;
        }
        .chart { height: 380px; }
        .note { height: 48px; }
      </style>

      <div class="page">
        <div class="top">
          <div class="title"><h-block name="header" /></div>
          <div class="filter"><h-block name="f_order_date" /></div>
        </div>

        <div class="kpis">
          <div class="card kpi"><h-block name="kpi_net_sales" /></div>
          <div class="card kpi"><h-block name="kpi_orders" /></div>
          <div class="card kpi"><h-block name="kpi_aov" /></div>
          <div class="card kpi"><h-block name="kpi_gross_margin" /></div>
        </div>

        <div class="charts">
          <div class="card chart"><h-block name="monthly_net_sales" /></div>
          <div class="card chart"><h-block name="top_categories" /></div>
        </div>

        <div class="note"><h-block name="source_note" /></div>
      </div>
    ;;
  }
}
