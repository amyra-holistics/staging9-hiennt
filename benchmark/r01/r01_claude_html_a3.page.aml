Dashboard r01_claude_html_a3 {
  title: 'Executive Sales Overview'
  description: 'Net Sales, Orders, AOV and Gross Margin for TheLook eCommerce, with monthly trend and top categories.'

  block f_date: FilterBlock {
    label: 'Order Date'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
    default {
      operator: 'last'
      value: '12'
      modifier: 'month'
      options {
        include_current_period: true
      }
    }
  }

  block kpi_net_sales: VizBlock {
    label: 'Net Sales'
    description: 'Sale price of order items, excluding Cancelled and Returned items.'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
    settings {
      hide_label: true
    }
  }

  block kpi_orders: VizBlock {
    label: 'Orders'
    description: 'Number of orders, every status.'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.total_orders)
        label: 'Orders'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
    settings {
      hide_label: true
    }
  }

  block kpi_aov: VizBlock {
    label: 'Average Order Value'
    description: 'Net Sales per fulfilled order.'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'AOV'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
    settings {
      hide_label: true
    }
  }

  block kpi_gross_margin: VizBlock {
    label: 'Gross Margin'
    description: 'Gross Profit (Net Sales minus COGS) as a share of Net Sales.'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
    settings {
      hide_label: true
    }
  }

  block net_sales_trend: VizBlock {
    label: 'Monthly Net Sales'
    viz: LineChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        label: 'Month'
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        x_axis_label: 'Month'
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block top_categories: VizBlock {
    label: 'Top 10 Categories by Net Sales'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Category'
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        row_limit: 10
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block freshness: VizBlock {
    label: 'Last Updated'
    viz: MarkdownViz {
      dataset: thelook
      values: [
        VizFieldFull {
          ref: r(thelook_order_items.created_at)
          label: 'Latest Order'
          aggregation: 'max'
          format {
            type: 'datetime'
            pattern: 'LLL d, yyyy HH:mm'
          }
        }
      ]
      content: @md
<div style="font-size: 12px; color: #64748b; line-height: 1.5;">
  <strong style="color: #334155;">Last updated:</strong> data through {{ rows[0].`Latest Order`.formatted }} (latest order item)
</div>
      ;;
    }
    settings {
      hide_label: true
      hide_controls: true
    }
  }

  interactions: [
    FilterInteraction {
      from: 'f_date'
      to: [
        CustomMapping {
          block: 'freshness'
          disabled: true
        }
      ]
    }
  ]

  view: HTMLLayout {
    content: @html
      <div class="exec">
        <style>
          .exec {
            --ink: #0f172a;
            --muted: #64748b;
            --line: #e2e8f0;
            --card: #ffffff;
            --page: #f8fafc;
            background: var(--page);
            padding: 24px;
            font-family: inherit;
            color: var(--ink);
            display: flex;
            flex-direction: column;
            gap: 16px;
          }
          .exec .header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 16px;
            flex-wrap: wrap;
          }
          .exec .title h1 {
            margin: 0;
            font-size: 22px;
            font-weight: 600;
          }
          .exec .title p {
            margin: 4px 0 0;
            font-size: 13px;
            color: var(--muted);
          }
          .exec .filter {
            width: 280px;
            height: 72px;
          }
          .exec .card {
            background: var(--card);
            border: 1px solid var(--line);
            border-radius: 10px;
            overflow: hidden;
          }
          .exec .kpis {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 16px;
          }
          .exec .kpi {
            height: 120px;
          }
          .exec .charts {
            display: grid;
            grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
            gap: 16px;
          }
          .exec .chart {
            height: 400px;
          }
          .exec .footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
            padding-top: 12px;
            border-top: 1px solid var(--line);
            font-size: 12px;
            color: var(--muted);
          }
          .exec .fresh {
            width: 440px;
            height: 44px;
          }
          @media (max-width: 900px) {
            .exec .kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .exec .charts { grid-template-columns: minmax(0, 1fr); }
          }
        </style>

        <div class="header">
          <div class="title">
            <h1>Executive Sales Overview</h1>
            <p>Net Sales exclude Cancelled and Returned items. All figures follow the Order Date filter.</p>
          </div>
          <div class="filter">
            <h-block name="f_date" />
          </div>
        </div>

        <div class="kpis">
          <div class="card kpi"><h-block name="kpi_net_sales" /></div>
          <div class="card kpi"><h-block name="kpi_orders" /></div>
          <div class="card kpi"><h-block name="kpi_aov" /></div>
          <div class="card kpi"><h-block name="kpi_gross_margin" /></div>
        </div>

        <div class="charts">
          <div class="card chart">
            <h-block name="net_sales_trend" />
          </div>
          <div class="card chart">
            <h-block name="top_categories" />
          </div>
        </div>

        <div class="footer">
          <div>
            <strong>Data source:</strong> TheLook eCommerce dataset (<code>thelook</code>), data source <code>demodb</code>: order items, orders and products.
          </div>
          <div class="fresh">
            <h-block name="freshness" />
          </div>
        </div>
      </div>
    ;;
  }
}
