Dashboard r01_hai_canvas_a1 {
  title: 'Executive Sales Overview'
  description: 'Executive view of commercial performance for TheLook eCommerce.'

  theme: H.themes.classic

  settings {
    timezone: 'UTC'
    autorun_on_open: true
    autorun_on_changes: true
    cache_duration: 60
  }

  // Header and operational notes
  block header: TextBlock {
    content: @md
# Executive Sales Overview

Monitor sales performance, order volume, basket value, and profitability.
;;
  }

  block data_note: TextBlock {
    content: @md
**Data source:** TheLook eCommerce (`demodb`)  
**Last updated:** at dashboard query run time · results cached for up to 60 minutes
;;
  }

  // Global date filter
  block date_filter: FilterBlock {
    label: 'Order Item Created Date'
    type: 'date'

    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  // KPI row
  block kpi_net_sales: VizBlock {
    label: 'Net Sales'

    settings {
      hide_label: true
    }

    viz: MetricKpi {
      dataset: thelook

      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'

        format {
          type: 'number'
          pattern: 'inherited'
        }
      }

      settings {
        display_mode: 'single'
      }
    }
  }

  block kpi_orders: VizBlock {
    label: 'Orders'

    settings {
      hide_label: true
    }

    viz: MetricKpi {
      dataset: thelook

      value: VizFieldFull {
        ref: r(thelook.total_orders)
        label: 'Orders'

        format {
          type: 'number'
          pattern: 'inherited'
        }
      }

      settings {
        display_mode: 'single'
      }
    }
  }

  block kpi_aov: VizBlock {
    label: 'Average Order Value'

    settings {
      hide_label: true
    }

    viz: MetricKpi {
      dataset: thelook

      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'

        format {
          type: 'number'
          pattern: 'inherited'
        }
      }

      settings {
        display_mode: 'single'
      }
    }
  }

  block kpi_gross_margin: VizBlock {
    label: 'Gross Margin'

    settings {
      hide_label: true
    }

    viz: MetricKpi {
      dataset: thelook

      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'

        format {
          type: 'number'
          pattern: 'inherited'
        }
      }

      settings {
        display_mode: 'single'
      }
    }
  }

  // Trend section
  block trend_heading: TextBlock {
    content: @md
## Monthly Sales Trend
;;
  }

  block monthly_net_sales: VizBlock {
    label: 'Monthly Net Sales'

    viz: LineChart {
      dataset: thelook

      x_axis: VizFieldFull {
        label: 'Month'
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'

        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }

      y_axis {
        series {
          field: VizFieldFull {
            label: 'Net Sales'
            ref: r(thelook.net_sales)

            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }

      settings {
        legend_label: 'hidden'
        show_data_points: false

        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  // Category section
  block category_heading: TextBlock {
    content: @md
## Category Performance
;;
  }

  block top_categories: VizBlock {
    label: 'Top 10 Categories by Net Sales'

    viz: BarChart {
      dataset: thelook

      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Product Category'

        format {
          type: 'text'
        }
      }

      y_axis {
        label: 'Net Sales'

        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'

            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }

      settings {
        row_limit: 10

        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'date_filter'
      to: [
        'kpi_net_sales',
        'kpi_orders',
        'kpi_aov',
        'kpi_gross_margin',
        'monthly_net_sales',
        'top_categories',
      ]
      field: r(thelook_order_items.created_at)
    },
  ]

  view: CanvasLayout {
    label: 'Executive Overview'
    width: 1280
    height: 1160
    margin: 20
    grid_size: 20
    auto_expand_vertically: true

    block header {
      position: pos(20, 20, 780, 100)
      layer: 1
    }

    block date_filter {
      position: pos(820, 20, 440, 100)
      layer: 1
    }

    block kpi_net_sales {
      position: pos(20, 140, 290, 150)
      layer: 1
    }

    block kpi_orders {
      position: pos(330, 140, 290, 150)
      layer: 1
    }

    block kpi_aov {
      position: pos(640, 140, 290, 150)
      layer: 1
    }

    block kpi_gross_margin {
      position: pos(950, 140, 310, 150)
      layer: 1
    }

    block trend_heading {
      position: pos(20, 320, 1240, 50)
      layer: 1
    }

    block monthly_net_sales {
      position: pos(20, 380, 1240, 370)
      layer: 1
    }

    block category_heading {
      position: pos(20, 790, 1240, 50)
      layer: 1
    }

    block top_categories {
      position: pos(20, 850, 840, 280)
      layer: 1
    }

    block data_note {
      position: pos(880, 850, 380, 140)
      layer: 1
    }

    mobile {
      mode: 'auto'
    }
  }
}
