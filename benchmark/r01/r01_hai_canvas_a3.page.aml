// benchmark/r01/r01_hai_canvas_a3.page.aml

Dashboard r01_hai_canvas_a3 {
  title: 'Executive Sales Overview'
  description: 'Executive overview of sales performance, order volume, average order value, gross margin, monthly Net Sales, and top-selling product categories.'
  theme: H.themes.classic

  settings {
    timezone: 'Etc/UTC'
    autorun_on_open: true
    autorun_on_changes: true
    cache_duration: 60
  }

  block title: TextBlock {
    content: @md
# Executive Sales Overview
Monitor commercial performance across sales, orders, profitability, and category demand.
;;
  }

  block date_filter: FilterBlock {
    label: 'Order Item Date'
    type: 'field'

    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block kpi_net_sales: VizBlock {
    label: 'Net Sales'
    settings {
      hide_label: true
    }

    viz: MetricKpi {
      dataset: thelook

      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'

        format {
          type: 'number'
          pattern: 'inherited'
        }
      }

      settings {
        display_mode: 'single'
      }
    }
  }

  block kpi_orders: VizBlock {
    label: 'Orders'
    settings {
      hide_label: true
    }

    viz: MetricKpi {
      dataset: thelook

      value: VizFieldFull {
        ref: r(thelook.total_orders)
        label: 'Orders'

        format {
          type: 'number'
          pattern: 'inherited'
        }
      }

      settings {
        display_mode: 'single'
      }
    }
  }

  block kpi_aov: VizBlock {
    label: 'Average Order Value'
    settings {
      hide_label: true
    }

    viz: MetricKpi {
      dataset: thelook

      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'

        format {
          type: 'number'
          pattern: 'inherited'
        }
      }

      settings {
        display_mode: 'single'
      }
    }
  }

  block kpi_gross_margin: VizBlock {
    label: 'Gross Margin'
    settings {
      hide_label: true
    }

    viz: MetricKpi {
      dataset: thelook

      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'

        format {
          type: 'number'
          pattern: 'inherited'
        }
      }

      settings {
        display_mode: 'single'
      }
    }
  }

  block section_sales_trend: TextBlock {
    content: @md
## Monthly Net Sales
;;
  }

  block monthly_net_sales: VizBlock {
    label: 'Monthly Net Sales'

    viz: LineChart {
      dataset: thelook

      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        label: 'Month'
        transformation: 'datetrunc month'

        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }

      y_axis {
        label: 'Net Sales'

        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'

            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }

      settings {
        legend_label: 'hidden'
        show_data_points: false

        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block section_category_performance: TextBlock {
    content: @md
## Category Performance
;;
  }

  block top_categories: VizBlock {
    label: 'Top 10 Categories by Net Sales'

    viz: CombinationChart {
      dataset: thelook

      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Product Category'

        format {
          type: 'text'
        }
      }

      y_axis {
        series {
          mark_type: 'bar'

          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'

            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }

      settings {
        row_limit: 10

        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block data_note: TextBlock {
    content: @md
**Data source:** TheLook eCommerce (`thelook`)  
**Last updated:** Dashboard results refresh automatically when opened and may be cached for up to 60 minutes.
;;
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'date_filter'
      to: [
        'kpi_net_sales',
        'kpi_aov',
        'kpi_gross_margin',
        'monthly_net_sales',
        'top_categories',
      ]
      field: r(thelook_order_items.created_at)
    },

    FilterInteraction {
      from: 'date_filter'
      to: ['kpi_orders']
      field: r(thelook_orders.created_at)
    },
  ]

  view: CanvasLayout {
    width: 1220
    height: 1280
    grid_size: 20
    auto_expand_vertically: true

    block title {
      position: pos(20, 20, 1180, 90)
      layer: 1
    }

    block date_filter {
      position: pos(920, 30, 280, 70)
      layer: 1
    }

    block kpi_net_sales {
      position: pos(20, 140, 280, 150)
      layer: 1
    }

    block kpi_orders {
      position: pos(320, 140, 280, 150)
      layer: 1
    }

    block kpi_aov {
      position: pos(620, 140, 280, 150)
      layer: 1
    }

    block kpi_gross_margin {
      position: pos(920, 140, 280, 150)
      layer: 1
    }

    block section_sales_trend {
      position: pos(20, 325, 1180, 50)
      layer: 1
    }

    block monthly_net_sales {
      position: pos(20, 385, 1180, 420)
      layer: 1
    }

    block section_category_performance {
      position: pos(20, 845, 1180, 50)
      layer: 1
    }

    block top_categories {
      position: pos(20, 905, 1180, 300)
      layer: 1
    }

    block data_note {
      position: pos(20, 1220, 1180, 50)
      layer: 1
    }

    mobile {
      mode: 'auto'
    }
  }
}
