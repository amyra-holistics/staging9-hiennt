Dashboard r01_hai_html_a1 {
  title: 'Executive Sales Overview'
  description: 'Executive sales monitoring dashboard for TheLook eCommerce.'
  theme: H.themes.classic

  settings {
    autorun_on_open: true
    cache_duration: 3600
  }

  block title: TextBlock {
    content: @md
# Executive Sales Overview
Monitor commercial performance, sales momentum, and category contribution.
    ;;
  }

  block date_filter: FilterBlock {
    label: 'Order Item Date'
    type: 'field'

    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block net_sales_kpi: VizBlock {
    label: 'Net Sales'

    settings {
      hide_label: true
    }

    viz: MetricKpi {
      dataset: thelook

      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'

        format {
          type: 'number'
          pattern: 'inherited'
        }
      }

      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block orders_kpi: VizBlock {
    label: 'Orders'

    settings {
      hide_label: true
    }

    viz: MetricKpi {
      dataset: thelook

      value: VizFieldFull {
        ref: r(thelook.total_orders)
        label: 'Orders'

        format {
          type: 'number'
          pattern: 'inherited'
        }
      }

      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block aov_kpi: VizBlock {
    label: 'Average Order Value'

    settings {
      hide_label: true
    }

    viz: MetricKpi {
      dataset: thelook

      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'

        format {
          type: 'number'
          pattern: 'inherited'
        }
      }

      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block gross_margin_kpi: VizBlock {
    label: 'Gross Margin'

    settings {
      hide_label: true
    }

    viz: MetricKpi {
      dataset: thelook

      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'

        format {
          type: 'number'
          pattern: 'inherited'
        }
      }

      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block monthly_net_sales: VizBlock {
    label: 'Monthly Net Sales'

    viz: LineChart {
      dataset: thelook

      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        label: 'Month'
        transformation: 'datetrunc month'

        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }

      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'

            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }

      settings {
        x_axis_label: 'Month'
        legend_label: 'hidden'
        show_data_points: false

        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block top_categories: VizBlock {
    label: 'Top 10 Categories by Net Sales'

    viz: BarChart {
      dataset: thelook

      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Product Category'

        format {
          type: 'text'
        }
      }

      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'

            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }

      settings {
        row_limit: 10

        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block data_note: TextBlock {
    content: @md
**Data source:** TheLook eCommerce (`thelook`)  
**Last updated:** 27 Sep 2026, 23:08 UTC
    ;;
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'date_filter'
      to: [
        'net_sales_kpi',
        'orders_kpi',
        'aov_kpi',
        'gross_margin_kpi',
        'monthly_net_sales',
        'top_categories',
      ]
      field: r(thelook_order_items.created_at)
    }
  ]

  view: HTMLLayout {
    content: @html
<style>
  .sales-dashboard {
    max-width: 1440px;
    margin: 0 auto;
    padding: 32px;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  .dashboard-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 28px;
    padding-bottom: 22px;
    border-bottom: 1px solid #e5e7eb;
  }

  .title-area {
    min-width: 0;
    flex: 1;
  }

  .filter-area {
    width: min(100%, 320px);
  }

  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 32px;
  }

  .kpi-card,
  .chart-card {
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    background: #ffffff;
    box-shadow: 0 1px 2px rgba(16, 24, 40, 0.04);
  }

  .kpi-card {
    min-height: 150px;
    padding: 8px 12px;
  }

  .section-heading {
    margin: 0 0 12px;
    color: #111827;
    font-size: 18px;
    font-weight: 700;
  }

  .chart-card {
    padding: 20px;
  }

  .trend-section {
    margin-bottom: 32px;
  }

  .chart-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
  }

  .dashboard-footer {
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid #e5e7eb;
    color: #6b7280;
    font-size: 13px;
  }

  @media (max-width: 960px) {
    .sales-dashboard {
      padding: 20px;
    }

    .dashboard-header {
      align-items: stretch;
      flex-direction: column;
    }

    .filter-area {
      width: 100%;
    }

    .kpi-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .kpi-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<div class="sales-dashboard">
  <header class="dashboard-header">
    <div class="title-area">
      <h-block name="title" />
    </div>

    <div class="filter-area">
      <h-block name="date_filter" />
    </div>
  </header>

  <section class="kpi-grid" aria-label="Executive KPIs">
    <div class="kpi-card">
      <h-block name="net_sales_kpi" />
    </div>

    <div class="kpi-card">
      <h-block name="orders_kpi" />
    </div>

    <div class="kpi-card">
      <h-block name="aov_kpi" />
    </div>

    <div class="kpi-card">
      <h-block name="gross_margin_kpi" />
    </div>
  </section>

  <section class="trend-section">
    <h2 class="section-heading">Sales Momentum</h2>
    <div class="chart-card">
      <h-block name="monthly_net_sales" />
    </div>
  </section>

  <section>
    <h2 class="section-heading">Category Performance</h2>
    <div class="chart-grid">
      <div class="chart-card">
        <h-block name="top_categories" />
      </div>
    </div>
  </section>

  <footer class="dashboard-footer">
    <h-block name="data_note" />
  </footer>
</div>
    ;;
  }
}
