Dashboard r01_hai_html_a3 {
  title: 'Executive Sales Overview'
  description: 'Executive view of net sales, orders, average order value, gross margin, sales trend, and category performance.'
  theme: H.themes.classic

  settings {
    timezone: 'Etc/UTC'
    autorun_on_open: true
    autorun_on_changes: true
    cache_duration: 60
  }

  block title: TextBlock {
    content: @md
# Executive Sales Overview
Monitor realized sales performance and the categories contributing most to Net Sales.
;;
  }

  block date_filter: FilterBlock {
    label: 'Order Date'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_orders.created_at)
    }
  }

  block net_sales_kpi: VizBlock {
    label: 'Net Sales'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
      }
    }
  }

  block orders_kpi: VizBlock {
    label: 'Orders'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.total_orders)
        label: 'Orders'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
      }
    }
  }

  block aov_kpi: VizBlock {
    label: 'Average Order Value'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
      }
    }
  }

  block gross_margin_kpi: VizBlock {
    label: 'Gross Margin'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
      }
    }
  }

  block monthly_net_sales: VizBlock {
    label: 'Monthly Net Sales'
    viz: LineChart {
      dataset: thelook

      x_axis: VizFieldFull {
        label: 'Month'
        ref: r(thelook_orders.created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }

      y_axis {
        series {
          field: VizFieldFull {
            label: 'Net Sales'
            ref: r(thelook.net_sales)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }

      settings {
        x_axis_label: 'Month'
        legend_label: 'hidden'
        connect_discontinuous_points: false
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block top_categories: VizBlock {
    label: 'Top 10 Categories by Net Sales'
    viz: BarChart {
      dataset: thelook

      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Product Category'
        format {
          type: 'text'
        }
      }

      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }

      settings {
        x_axis_label: 'Product Category'
        row_limit: 10
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block data_note: TextBlock {
    content: @md
**Data source:** demodb &nbsp; · &nbsp; **Last updated:** 28 Sep 2026, 08:19 UTC  
Net Sales excludes Cancelled and Returned order items.
;;
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'date_filter'
      to: [
        'net_sales_kpi',
        'orders_kpi',
        'aov_kpi',
        'gross_margin_kpi',
        'monthly_net_sales',
        'top_categories',
      ]
      field: r(thelook_orders.created_at)
    }
  ]

  view: HTMLLayout {
    content: @html
<style>
  .r01-dashboard {
    max-width: 1440px;
    margin: 0 auto;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .r01-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    padding-bottom: 8px;
    border-bottom: 1px solid #e5e7eb;
  }

  .r01-filter {
    min-width: 260px;
  }

  .r01-kpis {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .r01-section {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .r01-section h2 {
    margin: 0;
    font-size: 18px;
    font-weight: 650;
    color: #1f2937;
  }

  .r01-card {
    min-height: 380px;
    padding: 8px;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    background: #ffffff;
  }

  .r01-note {
    padding-top: 4px;
    border-top: 1px solid #e5e7eb;
    color: #6b7280;
    font-size: 13px;
  }

  @media (max-width: 960px) {
    .r01-dashboard {
      padding: 16px;
    }

    .r01-kpis {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .r01-kpis {
      grid-template-columns: 1fr;
    }

    .r01-filter {
      width: 100%;
    }
  }
</style>

<div class="r01-dashboard">
  <header class="r01-header">
    <div>
      <h-block name="title" />
    </div>
    <div class="r01-filter">
      <h-block name="date_filter" />
    </div>
  </header>

  <section class="r01-kpis">
    <h-block name="net_sales_kpi" />
    <h-block name="orders_kpi" />
    <h-block name="aov_kpi" />
    <h-block name="gross_margin_kpi" />
  </section>

  <section class="r01-section">
    <h2>Net Sales Trend</h2>
    <div class="r01-card">
      <h-block name="monthly_net_sales" />
    </div>
  </section>

  <section class="r01-section">
    <h2>Category Performance</h2>
    <div class="r01-card">
      <h-block name="top_categories" />
    </div>
  </section>

  <footer class="r01-note">
    <h-block name="data_note" />
  </footer>
</div>
;;
  }
}
