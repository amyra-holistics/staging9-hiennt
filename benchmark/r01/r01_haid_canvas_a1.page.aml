Dashboard r01_haid_canvas_a1 {
  title: 'Executive Sales Overview'
  description: @md A focused executive view of sales performance, trend, and category concentration.;;
  theme: H.themes.classic
  settings {
    autorun: true
  }

  block t_title: TextBlock {
    content: @md
# Executive Sales Overview
Monitor sales performance, monthly momentum, and category concentration. Use the date range to focus every metric and chart.
;;
  }

  block f_date: FilterBlock {
    label: 'Order Item Created At'
    type: 'date'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block v_net_sales: VizBlock {
    label: 'Net Sales'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block v_total_orders: VizBlock {
    label: 'Total Orders'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.total_orders)
        label: 'Total Orders'
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
    }
  }

  block v_aov: VizBlock {
    label: 'Average Order Value'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block v_gross_margin: VizBlock {
    label: 'Gross Margin'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: '#,###0.0%'
        }
      }
    }
  }

  block t_trend: TextBlock {
    content: @md ## Monthly Sales Momentum ;;
  }

  block v_monthly_net_sales: VizBlock {
    label: 'Monthly Net Sales Trend'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        label: 'Month'
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        x_axis_label: 'Month'
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block t_categories: TextBlock {
    content: @md ## Category Leaders ;;
  }

  block v_top_categories: VizBlock {
    label: 'Top 10 Product Categories by Net Sales'
    viz: CombinationChart {
      dataset: thelook
      calculation category_rank_by_net_sales {
        label: 'Category Rank By Net Sales'
        formula: @aql rank(order: net_sales | desc());;
        calc_type: 'measure'
        data_type: 'number'
      }
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Product Category'
      }
      y_axis {
        series {
          mark_type: 'bar'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      filter {
        field: 'category_rank_by_net_sales'
        operator: 'less_than'
        value: 11
      }
      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block t_source_note: TextBlock {
    content: @md
**Data source:** TheLook eCommerce / demodb  
**Freshness:** Values reflect the data available when this dashboard runs.
;;
  }

  interactions: [
    FilterInteraction {
      from: 'f_date'
      to: [
        CustomMapping {
          block: [
            'v_net_sales',
            'v_total_orders',
            'v_aov',
            'v_gross_margin',
            'v_monthly_net_sales',
            'v_top_categories'
          ]
          field: r(thelook_order_items.created_at)
        }
      ]
    }
  ]

  view: TabLayout {
    tab overview: CanvasLayout {
      label: 'Overview'
      width: 1220
      height: 1460
      grid_size: 20
      auto_expand_vertically: true

      block t_title { position: pos(20, 20, 1180, 100) layer: 1 }
      block f_date { position: pos(20, 140, 380, 100) layer: 1 }

      block v_net_sales { position: pos(20, 260, 280, 140) layer: 1 }
      block v_total_orders { position: pos(320, 260, 280, 140) layer: 1 }
      block v_aov { position: pos(620, 260, 280, 140) layer: 1 }
      block v_gross_margin { position: pos(920, 260, 280, 140) layer: 1 }

      block t_trend { position: pos(20, 420, 1180, 80) layer: 1 }
      block v_monthly_net_sales { position: pos(20, 520, 1180, 380) layer: 1 }

      block t_categories { position: pos(20, 920, 1180, 80) layer: 1 }
      block v_top_categories { position: pos(20, 1020, 1180, 300) layer: 1 }
      block t_source_note { position: pos(20, 1340, 1180, 100) layer: 1 }

      mobile { mode: 'auto' }
    }
  }
}
