Dashboard r01_haid_canvas_a2 {
  title: 'Executive Sales Overview'
  description: @md
    A sales monitoring view for executive review. Use the date control to set the reporting window across all KPIs and charts.
  ;;
  theme: H.themes.classic

  block t_title: TextBlock {
    content: @md
      # Executive Sales Overview
      Use the date control to review sales performance for the selected reporting window.
    ;;
  }

  block f_date: FilterBlock {
    label: 'Order Date'
    type: 'date'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block v_net_sales: VizBlock {
    label: 'Net Sales'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block v_orders: VizBlock {
    label: 'Orders'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.total_orders)
        label: 'Orders'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block v_aov: VizBlock {
    label: 'Average Order Value'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block v_gross_margin: VizBlock {
    label: 'Gross Margin'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block v_monthly_net_sales: VizBlock {
    label: 'Monthly Net Sales'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        label: 'Sales Month'
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        series {
          mark_type: 'line'
          field: VizFieldFull {
            label: 'Net Sales'
            ref: r(thelook.net_sales)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        x_axis_label: 'Sales Month'
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block v_top_categories: VizBlock {
    label: 'Top 10 Categories by Net Sales'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Product Category'
      }
      y_axis {
        series {
          mark_type: 'bar'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        row_limit: 10
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block t_source_note: TextBlock {
    content: @md
      **Source & freshness:** TheLook eCommerce on `demodb`. Data freshness follows the dataset refresh status.
    ;;
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'f_date'
      to: [
        'v_net_sales',
        'v_orders',
        'v_aov',
        'v_gross_margin',
        'v_monthly_net_sales',
        'v_top_categories'
      ]
      field: r(thelook_order_items.created_at)
    },
    FilterInteraction {
      from: 'f_date'
      to: ['t_title', 't_source_note']
      disabled: true
    }
  ]

  view: TabLayout {
    tab overview: CanvasLayout {
      label: 'Overview'
      width: 1220
      height: 1040
      grid_size: 20
      auto_expand_vertically: true

      block t_title { position: pos(20, 20, 1180, 100) layer: 1 }
      block f_date { position: pos(20, 140, 280, 100) layer: 1 }

      block v_net_sales { position: pos(20, 260, 280, 120) layer: 1 }
      block v_orders { position: pos(320, 260, 280, 120) layer: 1 }
      block v_aov { position: pos(620, 260, 280, 120) layer: 1 }
      block v_gross_margin { position: pos(920, 260, 280, 120) layer: 1 }

      block v_monthly_net_sales { position: pos(20, 400, 680, 400) layer: 1 }
      block v_top_categories { position: pos(720, 400, 480, 400) layer: 1 }

      block t_source_note { position: pos(20, 820, 1180, 100) layer: 1 }

      mobile { mode: 'auto' }
    }
  }
}
