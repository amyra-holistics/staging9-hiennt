Dashboard r01_haid_html_a2 {
  title: 'Executive Sales Overview'
  description: @md
    Executive monitoring view for sales performance, category contribution, and profitability.
  ;;

  block t_header: TextBlock {
    content: @md
      # Executive Sales Overview
      Monitor sales, order volume, customer value, and gross margin. **Data source:** TheLook eCommerce (`thelook`). **Last updated note:** reflects the latest available data when this dashboard is queried.
    ;;
  }

  block f_order_date: FilterBlock {
    label: 'Order Item Date'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block v_net_sales: VizBlock {
    label: 'Net Sales'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.net_sales)
    label: 'Net Sales'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
}
  }

  block v_orders: VizBlock {
    label: 'Orders'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.total_orders)
    label: 'Orders'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
}
  }

  block v_aov: VizBlock {
    label: 'Average Order Value'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.aov)
    label: 'Average Order Value'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
}
  }

  block v_gross_margin: VizBlock {
    label: 'Gross Margin'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.gross_margin)
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
}
  }

  block v_monthly_net_sales: VizBlock {
    label: 'Monthly Net Sales Trend'
    viz: CombinationChart {
  dataset: thelook
  x_axis: VizFieldFull {
    ref: r(thelook_order_items.created_at)
    transformation: 'datetrunc month'
    format {
      type: 'date'
      pattern: 'LLL yyyy'
    }
  }
  y_axis {
    series {
      mark_type: 'line'
      field: VizFieldFull {
        ref: r(thelook.net_sales)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }
  settings {
    sort: LineFamilySort {
      type: 'xaxis'
      direction: 'asc'
    }
  }
}
  }

  block v_top_categories: VizBlock {
    label: 'Top 10 Categories by Net Sales'
    viz: CombinationChart {
  dataset: thelook
  x_axis: VizFieldFull {
    ref: r(thelook_products.category)
    label: 'Product Category'
  }
  y_axis {
    series {
      mark_type: 'bar'
      field: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }
  settings {
    row_limit: 10
    sort: LineFamilySort {
      type: 'yaxis'
      field_index: 0
      direction: 'desc'
    }
  }
}
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'f_order_date'
      to: ['v_net_sales', 'v_orders', 'v_aov', 'v_gross_margin', 'v_monthly_net_sales', 'v_top_categories']
      field: r(thelook_order_items.created_at)
    }
  ]

  view: HTMLLayout {
    content: @html
      <style>
        .sales-overview { display: flex; flex-direction: column; gap: 20px; }
        .dashboard-header { max-width: 900px; }
        .control-row { max-width: 320px; }
        .kpi-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
        .chart-grid { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: 20px; }
        @media (max-width: 900px) {
          .kpi-grid, .chart-grid { grid-template-columns: 1fr; }
        }
      </style>
      <main class="sales-overview">
        <section class="dashboard-header"><h-block name="t_header" /></section>
        <section class="control-row"><h-block name="f_order_date" /></section>
        <section class="kpi-grid">
          <h-block name="v_net_sales" />
          <h-block name="v_orders" />
          <h-block name="v_aov" />
          <h-block name="v_gross_margin" />
        </section>
        <section class="chart-grid">
          <h-block name="v_monthly_net_sales" />
          <h-block name="v_top_categories" />
        </section>
      </main>
    ;;
  }
}
