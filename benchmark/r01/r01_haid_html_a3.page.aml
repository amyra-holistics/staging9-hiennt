Dashboard r01_haid_html_a3 {
  title: 'Executive Sales Dashboard'
  description: @md Executive sales performance for TheLook eCommerce. Use the Sales Date control to focus the KPIs and charts on a selected period. ;;

  block dashboard_title: TextBlock {
    content: @md
      # Executive Sales Dashboard
      Sales performance overview for TheLook eCommerce.
    ;;
  }

  block sales_date: FilterBlock {
    label: 'Sales Date'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block net_sales_kpi: VizBlock {
    label: 'Net Sales'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
    settings { hide_label: true }
  }

  block orders_kpi: VizBlock {
    label: 'Orders'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.total_orders)
        label: 'Orders'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
    settings { hide_label: true }
  }

  block aov_kpi: VizBlock {
    label: 'Average Order Value'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
    settings { hide_label: true }
  }

  block gross_margin_kpi: VizBlock {
    label: 'Gross Margin'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: '#,###0.0%'
        }
      }
    }
    settings { hide_label: true }
  }

  block monthly_net_sales_trend: VizBlock {
    label: 'Monthly Net Sales'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        label: 'Sales Month'
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        series {
          mark_type: 'line'
          field: VizFieldFull {
            label: 'Net Sales'
            ref: r(thelook.net_sales)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block top_ten_categories: VizBlock {
    label: 'Top 10 Categories by Net Sales'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Product Category'
        format { type: 'text' }
      }
      y_axis {
        series {
          mark_type: 'bar'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        row_limit: 10
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block source_note: TextBlock {
    content: @md Source: TheLook eCommerce (`demodb`). ;;
  }

  block coverage_note: TextBlock {
    content: @md Data is refreshed from the source. Static validation context: observed coverage through Sep 2026; validation date Sep 30, 2026. ;;
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'sales_date'
      to: [
        'net_sales_kpi',
        'orders_kpi',
        'aov_kpi',
        'gross_margin_kpi',
        'monthly_net_sales_trend',
        'top_ten_categories',
      ]
      field: r(thelook_order_items.created_at)
    }
  ]

  view: HTMLLayout {
    content: @html
      <style>
        .sales-dashboard {
          max-width: 1440px;
          margin: 0 auto;
          padding: 24px;
          background: #f7f9fc;
          color: #172033;
          font-family: Inter, ui-sans-serif, system-ui, sans-serif;
        }
        .sales-header { margin-bottom: 16px; }
        .filter-row {
          max-width: 300px;
          margin: 0 0 20px;
        }
        .kpi-grid {
          display: grid;
          grid-template-columns: repeat(4, minmax(0, 1fr));
          gap: 16px;
          margin-bottom: 24px;
        }
        .panel {
          background: #ffffff;
          border: 1px solid #e4e9f1;
          border-radius: 12px;
          box-shadow: 0 2px 8px rgba(23, 32, 51, 0.05);
          padding: 12px;
        }
        .chart-grid {
          display: grid;
          grid-template-columns: minmax(0, 3fr) minmax(320px, 2fr);
          gap: 20px;
          margin-bottom: 20px;
        }
        .note-row {
          display: grid;
          grid-template-columns: 1fr 1fr;
          gap: 16px;
          color: #536176;
          font-size: 13px;
        }
        .note-row .panel { padding: 8px 12px; }
        @media (max-width: 900px) {
          .kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
          .chart-grid, .note-row { grid-template-columns: 1fr; }
        }
        @media (max-width: 560px) {
          .sales-dashboard { padding: 12px; }
          .kpi-grid { grid-template-columns: 1fr; }
        }
      </style>
      <main class="sales-dashboard">
        <header class="sales-header">
          <h-block name="dashboard_title" />
        </header>
        <section class="filter-row">
          <h-block name="sales_date" />
        </section>
        <section class="kpi-grid" aria-label="Key performance indicators">
          <div class="panel"><h-block name="net_sales_kpi" /></div>
          <div class="panel"><h-block name="orders_kpi" /></div>
          <div class="panel"><h-block name="aov_kpi" /></div>
          <div class="panel"><h-block name="gross_margin_kpi" /></div>
        </section>
        <section class="chart-grid" aria-label="Sales performance charts">
          <div class="panel"><h-block name="monthly_net_sales_trend" /></div>
          <div class="panel"><h-block name="top_ten_categories" /></div>
        </section>
        <footer class="note-row">
          <div class="panel"><h-block name="source_note" /></div>
          <div class="panel"><h-block name="coverage_note" /></div>
        </footer>
      </main>
    ;;
  }
}
