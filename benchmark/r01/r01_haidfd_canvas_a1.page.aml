Dashboard r01_haidfd_canvas_a1 {
  title: 'Executive Sales'
  description: 'A focused executive view of sales performance, designed for date-based monitoring.'
  theme: H.themes.classic
  settings {
    autorun: true
  }

  block title: TextBlock {
    content: @md
# Executive Sales
A concise view of sales performance, order demand, value per fulfilled order, and margin.
;;
  }

  block date_range: FilterBlock {
    label: 'Order date'
    type: 'date'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_orders.created_at)
    }
  }

  block net_sales: VizBlock {
    label: 'Net Sales'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        label: 'Net Sales'
        ref: r(thelook.net_sales)
        format {
          type: 'number'
          pattern: 'inherited'
        }
        uname: 'custom_net_sales_1'
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block orders: VizBlock {
    label: 'Orders'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.total_orders)
        label: 'Orders'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
      }
    }
  }

  block aov: VizBlock {
    label: 'Average Order Value'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        label: 'Average Order Value'
        ref: r(thelook.aov)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block gross_margin: VizBlock {
    label: 'Gross Margin'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
      }
    }
  }

  block monthly_net_sales: VizBlock {
    label: 'Monthly Net Sales'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block top_categories: VizBlock {
    label: 'Top 10 Categories by Net Sales'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Product Category'
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        row_limit: 10
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block source_note: TextBlock {
    content: @md
Data source: **demodb** · Last updated at dashboard refresh time.
;;
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'date_range'
      to: ['net_sales', 'orders', 'aov', 'gross_margin']
      field: r(thelook_orders.created_at)
    },
    FilterInteraction {
      from: 'date_range'
      to: ['monthly_net_sales', 'top_categories']
      field: r(thelook_order_items.created_at)
    }
  ]

  view: TabLayout {
    tab overview: CanvasLayout {
      label: 'Overview'
      width: 1220
      height: 1080
      grid_size: 20
      auto_expand_vertically: true

      block title { position: pos(20, 20, 880, 100) layer: 1 }
      block date_range { position: pos(920, 20, 280, 100) layer: 1 }

      block net_sales { position: pos(20, 140, 280, 120) layer: 1 }
      block orders { position: pos(320, 140, 280, 120) layer: 1 }
      block aov { position: pos(620, 140, 280, 120) layer: 1 }
      block gross_margin { position: pos(920, 140, 280, 120) layer: 1 }

      block monthly_net_sales { position: pos(20, 280, 1180, 400) layer: 1 }
      block top_categories { position: pos(20, 700, 1180, 300) layer: 1 }
      block source_note { position: pos(20, 1020, 1180, 60) layer: 1 }

      mobile { mode: 'auto' }
    }
  }
}
