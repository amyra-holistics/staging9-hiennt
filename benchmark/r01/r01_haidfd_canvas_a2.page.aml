Dashboard r01_haidfd_canvas_a2 {
  title: 'Executive Sales Overview'
  description: @md
Executive monitoring view for sales performance, with an all-time opening state and a dashboard-wide order-item date filter.
;;
  theme: H.themes.classic

  block title_note: TextBlock {
    content: @md
# Executive Sales Overview
Source: TheLook eCommerce. Last updated: values reflect the most recent data available when this dashboard runs. Net Sales excludes Cancelled and Returned order items; Orders includes every order status.
;;
  }

  block date_filter: FilterBlock {
    label: 'Order Date'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block kpi_net_sales: VizBlock {
    label: 'Net Sales'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block kpi_orders: VizBlock {
    label: 'Orders'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.total_orders)
        label: 'Orders'
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
    }
  }

  block kpi_aov: VizBlock {
    label: 'Average Order Value'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'
        format {
          type: 'number'
          pattern: '[$$]#,###0.00'
        }
      }
    }
  }

  block kpi_gross_margin: VizBlock {
    label: 'Gross Margin'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        format {
          type: 'number'
          pattern: '#,###0.0%'
        }
      }
    }
  }

  block monthly_net_sales: VizBlock {
    label: 'Monthly Net Sales'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        label: 'Month'
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        series {
          mark_type: 'line'
          field: VizFieldFull {
            label: 'Net Sales'
            ref: r(thelook.net_sales)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        x_axis_label: 'Month'
        legend_label: 'hidden'
        show_data_points: false
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block category_net_sales: VizBlock {
    label: 'Top 10 Categories by Net Sales'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Product Category'
      }
      y_axis {
        series {
          mark_type: 'bar'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        row_limit: 10
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'date_filter'
      to: ['kpi_net_sales', 'kpi_orders', 'kpi_aov', 'kpi_gross_margin', 'monthly_net_sales', 'category_net_sales']
      field: r(thelook_order_items.created_at)
    }
  ]

  view: TabLayout {
    tab overview: CanvasLayout {
      label: 'Overview'
      width: 1220
      height: 1360
      grid_size: 20
      auto_expand_vertically: true

      block title_note { position: pos(20, 20, 1180, 120) layer: 1 }
      block date_filter { position: pos(20, 160, 280, 100) layer: 1 }

      block kpi_net_sales { position: pos(20, 280, 280, 120) layer: 1 }
      block kpi_orders { position: pos(320, 280, 280, 120) layer: 1 }
      block kpi_aov { position: pos(620, 280, 280, 120) layer: 1 }
      block kpi_gross_margin { position: pos(920, 280, 280, 120) layer: 1 }

      block monthly_net_sales { position: pos(20, 420, 1180, 400) layer: 1 }
      block category_net_sales { position: pos(20, 840, 1180, 460) layer: 1 }

      mobile { mode: 'auto' }
    }
  }

  settings {
    autorun_on_open: true
    autorun_on_changes: true
  }
}
