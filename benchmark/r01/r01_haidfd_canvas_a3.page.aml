Dashboard r01_haidfd_canvas_a3 {
  title: 'Sales Performance'

  block h_header: TextBlock {
    content: @md
      <div style="background:#071a3d;color:#f8fbff;padding:20px 24px;border-left:6px solid #2563eb;">
        <h1 style="margin:0 0 6px 0;color:#f8fbff;">Sales Performance</h1>
        <p style="margin:0;color:#bfd7ff;">A focused view of sales health across the selected period.</p>
      </div>
    ;;
  }

  block h_data_note: TextBlock {
    content: @md
      <div style="color:#173a73;border-left:3px solid #2563eb;padding:8px 12px;">
        <strong>Data source:</strong> TheLook eCommerce &nbsp;|&nbsp; <strong>Refresh:</strong> values reflect the data available when this report runs.
      </div>
    ;;
  }

  block f_order_date: FilterBlock {
    label: 'Order date'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_orders.created_at)
    }
  }

  block v_net_sales: VizBlock {
    label: 'Net Sales'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block v_orders: VizBlock {
    label: 'Orders'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.total_orders)
        label: 'Orders'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block v_aov: VizBlock {
    label: 'Average Order Value'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block v_gross_margin: VizBlock {
    label: 'Gross Margin'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block h_net_sales_trend: TextBlock {
    content: @md
      ## Monthly Net Sales Trend
    ;;
  }

  block v_monthly_net_sales: VizBlock {
    label: 'Monthly Net Sales Trend'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        label: 'Order Item Month'
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        series {
          mark_type: 'line'
          field: VizFieldFull {
            label: 'Net Sales'
            ref: r(thelook.net_sales)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block h_top_categories: TextBlock {
    content: @md
      ## Top Product Categories by Net Sales
    ;;
  }

  block v_top_categories: VizBlock {
    label: 'Top 10 Product Categories by Net Sales'
    viz: CombinationChart {
      dataset: thelook
      calculation top_10_product_categories {
        label: 'Top 10 Product Categories'
        formula: @aql top(
          10,
          thelook_products.category,
          by: net_sales,
          logic: 'dense',
        );;
        calc_type: 'measure'
        data_type: 'json'
      }
      calculation product_category_rank {
        label: 'Product Category Rank'
        formula: @aql dense_rank(order: net_sales | desc(), partition: []);;
        calc_type: 'measure'
        data_type: 'number'
      }
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Product Category'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          mark_type: 'bar'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      tooltips: [
        VizTooltip {
          field: VizFieldFull {
            ref: 'product_category_rank'
            label: 'Category Rank'
            format {
              type: 'number'
              pattern: '#,###'
            }
          }
        }
      ]
      conditions: [
        'thelook_products.category in top_10_product_categories',
      ]
      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'f_order_date'
      to: ['v_orders']
      field: r(thelook_orders.created_at)
    },
    FilterInteraction {
      from: 'f_order_date'
      to: ['v_net_sales', 'v_aov', 'v_gross_margin', 'v_monthly_net_sales', 'v_top_categories']
      field: r(thelook_order_items.created_at)
    }
  ]

  view: CanvasLayout {
    width: 1220
    height: 1500
    grid_size: 20
    auto_expand_vertically: true

    block h_header { position: pos(20, 20, 1180, 120) layer: 1 }
    block h_data_note { position: pos(20, 160, 1180, 100) layer: 1 }
    block f_order_date { position: pos(20, 280, 280, 100) layer: 1 }
    block v_net_sales { position: pos(20, 400, 280, 120) layer: 1 }
    block v_orders { position: pos(320, 400, 280, 120) layer: 1 }
    block v_aov { position: pos(620, 400, 280, 120) layer: 1 }
    block v_gross_margin { position: pos(920, 400, 280, 120) layer: 1 }
    block h_net_sales_trend { position: pos(20, 540, 1180, 80) layer: 1 }
    block v_monthly_net_sales { position: pos(20, 640, 1180, 360) layer: 1 }
    block h_top_categories { position: pos(20, 1020, 1180, 80) layer: 1 }
    block v_top_categories { position: pos(20, 1120, 1180, 360) layer: 1 }

    mobile { mode: 'auto' }
  }
}
