Dashboard r01_haidfd_html_a2 {
  title: 'Midnight Retail Ledger'
  description: @md
Executive view of sales performance, order volume, average order value, gross margin, and category contribution.
  ;;

  block b_title: TextBlock {
    content: @md
<div class="masthead-copy">
  <p class="kicker">Executive retail ledger</p>
  <h1>Midnight Retail Ledger</h1>
  <p>Read the sales pulse, then trace it through time and category mix.</p>
</div>
    ;;
  }

  block f_date: FilterBlock {
    label: 'Sales Date'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block k_net_sales: VizBlock {
    label: 'Net Sales'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block k_orders: VizBlock {
    label: 'Orders'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.total_orders)
        label: 'Orders'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block k_aov: VizBlock {
    label: 'Average Order Value'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
      }
    }
  }

  block k_gross_margin: VizBlock {
    label: 'Gross Margin'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block v_monthly_net_sales: VizBlock {
    label: 'Monthly Net Sales'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        label: 'Calendar Month'
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        series {
          mark_type: 'line'
          field: VizFieldFull {
            label: 'Net Sales'
            ref: r(thelook.net_sales)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block v_top_categories: VizBlock {
    label: 'Top 10 Categories by Net Sales'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Product Category'
        format {
          type: 'text'
        }
      }
      y_axis {
        label: 'Net Sales'
        series {
          mark_type: 'bar'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        row_limit: 10
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block b_provenance: TextBlock {
    content: @md
<div class="provenance-copy">
  <strong>Data source</strong> TheLook eCommerce &nbsp;·&nbsp; <strong>Last updated</strong> Dashboard query time
</div>
    ;;
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'f_date'
      to: ['k_net_sales', 'k_aov', 'k_gross_margin', 'v_monthly_net_sales', 'v_top_categories']
      field: r(thelook_order_items.created_at)
    },
    FilterInteraction {
      from: 'f_date'
      to: ['k_orders']
      field: r(thelook_orders.created_at)
    }
  ]

  view: HTMLLayout {
    content: @html
<style>
  :root {
    --ink: #f7f0df;
    --muted: #b8ad9a;
    --night: #101625;
    --ledger: #172036;
    --line: #34415a;
    --amber: #d7a84e;
    --plum: #4b3459;
  }
  .midnight-ledger {
    box-sizing: border-box;
    max-width: 1440px;
    margin: 0 auto;
    padding: 28px;
    color: var(--ink);
    background: radial-gradient(circle at 88% 0%, #263552 0, var(--night) 42%, #0b101c 100%);
    font-family: Georgia, 'Times New Roman', serif;
  }
  .midnight-ledger *, .midnight-ledger *::before, .midnight-ledger *::after { box-sizing: border-box; }
  .ledger-rule { border-top: 1px solid var(--amber); opacity: .8; }
  .masthead { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 24px; padding: 26px 0 20px; align-items: end; }
  .masthead-copy .kicker { margin: 0 0 10px; color: var(--amber); font: 600 12px/1.2 Arial, sans-serif; letter-spacing: .13em; text-transform: uppercase; }
  .masthead-copy h1 { margin: 0; color: var(--ink); font-size: clamp(32px, 5vw, 58px); line-height: .96; letter-spacing: -.045em; }
  .masthead-copy > p:last-child { max-width: 45rem; margin: 14px 0 0; color: var(--muted); font-size: 17px; line-height: 1.45; }
  .filter-well { align-self: stretch; padding: 14px 16px; border: 1px solid var(--line); background: rgba(23,32,54,.7); }
  .section-label { margin: 30px 0 10px; color: var(--amber); font: 600 12px/1.2 Arial, sans-serif; letter-spacing: .12em; text-transform: uppercase; }
  .kpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .kpi-cell { min-width: 0; padding: 18px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); background: rgba(23,32,54,.58); }
  .analysis-grid { display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(320px, 1fr); gap: 18px; margin-top: 18px; }
  .ledger-panel { min-width: 0; padding: 18px; border: 1px solid var(--line); background: rgba(23,32,54,.58); }
  .panel-title { margin: 0 0 12px; color: var(--ink); font: 600 16px/1.25 Arial, sans-serif; }
  .provenance { margin-top: 18px; padding: 14px 0 0; border-top: 1px solid var(--line); color: var(--muted); font: 13px/1.4 Arial, sans-serif; }
  .provenance-copy strong { color: var(--ink); font-weight: 600; }
  @media (max-width: 900px) { .masthead { grid-template-columns: 1fr; } .kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); } .analysis-grid { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .midnight-ledger { padding: 18px; } .kpis { grid-template-columns: 1fr; } }
</style>
<div class="midnight-ledger">
  <div class="ledger-rule"></div>
  <header class="masthead">
    <h-block name="b_title"></h-block>
    <aside class="filter-well"><h-block name="f_date"></h-block></aside>
  </header>
  <div class="ledger-rule"></div>

  <p class="section-label">Current read</p>
  <section class="kpis" aria-label="Executive key performance indicators">
    <div class="kpi-cell"><h-block name="k_net_sales"></h-block></div>
    <div class="kpi-cell"><h-block name="k_orders"></h-block></div>
    <div class="kpi-cell"><h-block name="k_aov"></h-block></div>
    <div class="kpi-cell"><h-block name="k_gross_margin"></h-block></div>
  </section>

  <section class="analysis-grid" aria-label="Sales analysis">
    <article class="ledger-panel">
      <h2 class="panel-title">Monthly net sales</h2>
      <h-block name="v_monthly_net_sales"></h-block>
    </article>
    <article class="ledger-panel">
      <h2 class="panel-title">Top categories by net sales</h2>
      <h-block name="v_top_categories"></h-block>
    </article>
  </section>

  <footer class="provenance"><h-block name="b_provenance"></h-block></footer>
</div>
    ;;
  }
}
