Dashboard r01_haidfd_html_a3 {
  title: 'Executive Sales Ledger'
  description: @md
A sales-grain executive view of realized Net Sales, orders, monthly performance, and leading product categories. Use the date range to focus every data visualization on the same order-item period.
;;

  block t_title: TextBlock {
    content: @md
# Executive Sales Ledger
;;
  }

  block t_explanation: TextBlock {
    content: @md
Track realized sales performance from order items. **Net Sales** excludes Cancelled and Returned items; the date control applies to every KPI and chart below.
;;
  }

  block f_sales_date: FilterBlock {
    label: 'Sales date range'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block v_net_sales: VizBlock {
    label: 'Net Sales'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block v_orders: VizBlock {
    label: 'Orders'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.total_orders)
        label: 'Orders'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block v_gross_margin: VizBlock {
    label: 'Gross Margin'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block v_aov: VizBlock {
    label: 'Average Order Value'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block v_monthly_net_sales: VizBlock {
    label: 'Monthly Net Sales'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block v_top_categories: VizBlock {
    label: 'Top Categories by Net Sales'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Product Category'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        row_limit: 10
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block t_provenance: TextBlock {
    content: @md
**Source:** demodb  
**Data coverage:** Sales data coverage through Sep 30, 2026. This is a coverage statement based on order-item creation time, not a refresh timestamp.
;;
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'f_sales_date'
      to: [
        'v_net_sales',
        'v_orders',
        'v_gross_margin',
        'v_aov',
        'v_monthly_net_sales',
        'v_top_categories'
      ]
      field: r(thelook_order_items.created_at)
    }
  ]

  view: HTMLLayout {
    content: @html
<style>
  .ledger-shell {
    --ink: #172421;
    --muted: #60706a;
    --paper: #f6f5ef;
    --panel: #ffffff;
    --rule: #d9ded6;
    --evergreen: #1d5c4d;
    --ledger-red: #b4493c;
    background: var(--paper);
    color: var(--ink);
    font-family: Georgia, 'Times New Roman', serif;
    padding: clamp(18px, 4vw, 52px);
  }
  .ledger-frame { max-width: 1440px; margin: 0 auto; }
  .ledger-header {
    border-top: 7px solid var(--evergreen);
    border-bottom: 1px solid var(--ink);
    padding: 22px 0 18px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 0.38fr);
    gap: 28px;
    align-items: end;
  }
  .ledger-header h1 { margin: 0; font-size: clamp(2rem, 5vw, 4.35rem); line-height: 0.98; letter-spacing: -0.045em; }
  .ledger-kicker, .section-title, .coverage-label {
    color: var(--evergreen);
    font-family: Arial, sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .header-stamp { border-left: 1px solid var(--rule); padding-left: 20px; color: var(--muted); font-size: 0.95rem; line-height: 1.45; }
  .ledger-shell h-block { display: block; min-width: 0; }
  .title-block, .explanation, .provenance { margin-top: 12px; }
  .title-block h-block { display: none; }
  .explanation { max-width: 800px; color: var(--muted); font-size: 1.02rem; line-height: 1.55; }
  .control-strip { margin: 28px 0 18px; max-width: 380px; }
  .kpi-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--rule); border-left: 1px solid var(--rule); }
  .kpi-grid h-block { background: var(--panel); border-right: 1px solid var(--rule); border-bottom: 1px solid var(--rule); min-height: 145px; }
  .analysis-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 22px; margin-top: 34px; }
  .analysis-panel { background: var(--panel); border: 1px solid var(--rule); padding: 20px; }
  .analysis-panel h-block { min-height: 355px; }
  .section-title { border-bottom: 1px solid var(--rule); margin: 0 0 14px; padding-bottom: 10px; }
  .provenance { border-top: 1px solid var(--ink); color: var(--muted); font-size: 0.88rem; line-height: 1.45; padding-top: 14px; }
  @media (max-width: 900px) {
    .ledger-header, .analysis-grid { grid-template-columns: 1fr; }
    .header-stamp { border-left: 0; border-top: 1px solid var(--rule); padding: 14px 0 0; }
    .kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) {
    .ledger-shell { padding: 16px; }
    .kpi-grid { grid-template-columns: 1fr; }
    .analysis-panel { padding: 12px; }
  }
</style>

<div class="ledger-shell">
  <main class="ledger-frame">
    <header class="ledger-header">
      <div>
        <div class="ledger-kicker">Executive performance review</div>
        <h1>Sales ledger</h1>
      </div>
      <div class="header-stamp">A concise record of realized sales, order volume, margin, and category concentration.</div>
    </header>

    <div class="title-block"><h-block name="t_title" /></div>
    <section class="explanation"><h-block name="t_explanation" /></section>
    <section class="control-strip"><h-block name="f_sales_date" /></section>

    <section class="kpi-grid" aria-label="Executive key performance indicators">
      <h-block name="v_net_sales" />
      <h-block name="v_orders" />
      <h-block name="v_gross_margin" />
      <h-block name="v_aov" />
    </section>

    <section class="analysis-grid">
      <article class="analysis-panel">
        <div class="section-title">Monthly sales trajectory</div>
        <h-block name="v_monthly_net_sales" />
      </article>
      <article class="analysis-panel">
        <div class="section-title">Category concentration</div>
        <h-block name="v_top_categories" />
      </article>
    </section>

    <footer class="provenance"><h-block name="t_provenance" /></footer>
  </main>
</div>
;;
  }
}
