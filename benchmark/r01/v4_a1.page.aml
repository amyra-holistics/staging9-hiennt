Dashboard v4_a1 {
  title: 'Executive Sales Overview'
  description: 'Net Sales, Orders, AOV and Gross Margin with the monthly Net Sales trend and top 10 categories. Source: TheLook eCommerce dataset.'

  theme: PageTheme {
    block {
      background { bg_color: 'transparent' }
      border {
        border_width: 0
        border_style: 'none'
      }
      shadow: 'none'
      padding: 0
      label {
        font_family: 'Inter, ui-sans-serif, system-ui, sans-serif'
        font_color: '#05264C'
        font_weight: 'semibold'
      }
      text {
        font_family: 'Inter, ui-sans-serif, system-ui, sans-serif'
        font_color: '#5C6E85'
      }
    }

    viz {
      metric_kpi {
        alignment: 'left'
        label {
          font_family: 'Inter, ui-sans-serif, system-ui, sans-serif'
          font_color: '#5C6E85'
          font_size: 13
          font_weight: 'medium'
        }
        value {
          font_family: 'Inter, ui-sans-serif, system-ui, sans-serif'
          font_color: '#05264C'
          font_size: 30
          font_weight: 'bold'
        }
      }
    }
  }

  block f_order_date: FilterBlock {
    label: 'Order Date'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_orders.created_at)
    }
    default {
      operator: 'matches'
      value: 'last 12 months'
    }
  }

  block k_net_sales: VizBlock {
    label: 'Net Sales'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
  }

  block k_orders: VizBlock {
    label: 'Orders'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.total_orders)
        label: 'Orders'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
  }

  block k_aov: VizBlock {
    label: 'AOV'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
  }

  block k_gross_margin: VizBlock {
    label: 'Gross Margin'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
  }

  block v_monthly_net_sales: VizBlock {
    label: 'Monthly Net Sales'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_orders.created_at)
        label: 'Month'
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        label: 'Net Sales'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        x_axis_label: 'Month'
        legend_label: 'hidden'
        show_data_points: true
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block v_top_categories: VizBlock {
    label: 'Top 10 Categories by Net Sales'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Category'
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      conditions: [
        "thelook_products.category in top(10, thelook_products.category, by: net_sales)",
      ]
      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block t_last_updated: VizBlock {
    label: 'Last updated'
    viz: DataTable {
      dataset: thelook
      calculation latest_order_at {
        label: 'Latest order'
        formula: @aql max(thelook_orders.created_at);;
        calc_type: 'measure'
        data_type: 'datetime'
      }
      fields: [
        VizFieldFull {
          ref: 'latest_order_at'
          label: 'Data through (latest order)'
          format {
            type: 'datetime'
            pattern: 'LLL dd, yyyy HH:mm'
          }
        }
      ]
    }
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'f_order_date'
      to: ['k_net_sales', 'k_orders', 'k_aov', 'k_gross_margin', 'v_monthly_net_sales', 'v_top_categories']
      field: r(thelook_orders.created_at)
    },
    FilterInteraction {
      from: 'f_order_date'
      to: ['t_last_updated']
      disabled: true
    }
  ]

  view: HTMLLayout {
    content: @html
      <style>
        .exec-sales,
        .exec-sales *,
        .exec-sales *::before,
        .exec-sales *::after { box-sizing: border-box; }

        .exec-sales {
          --t-bg: #FFFFFF;
          --t-surface: #F5F8FA;
          --t-border: #E1E7EE;
          --t-ink: #05264C;
          --t-ink-dim: #5C6E85;
          --t-ink-faint: #8FA0B4;
          --t-accent: #259B6C;
          --t-accent-lt: #3FBE88;
          --t-radius: 10px;
          --t-radius-sm: 6px;
          --t-pad: 20px;
          --t-font-sans: Inter, ui-sans-serif, system-ui, sans-serif;

          background: var(--t-bg);
          color: var(--t-ink);
          font-family: var(--t-font-sans);
          margin: 0 auto;
          max-width: 1440px;
          padding: 28px 32px 24px;
        }

        .exec-sales .exec-sales__header {
          align-items: flex-end;
          border-bottom: 1px solid var(--t-border);
          display: flex;
          gap: 24px;
          justify-content: space-between;
          margin-bottom: 20px;
          padding-bottom: 18px;
        }

        .exec-sales .exec-sales__eyebrow {
          color: var(--t-accent);
          font-size: 12px;
          font-weight: 600;
          letter-spacing: .12em;
          margin: 0 0 6px;
          text-transform: uppercase;
        }

        .exec-sales .exec-sales__title {
          font-size: 28px;
          font-weight: 700;
          letter-spacing: -.02em;
          line-height: 1.15;
          margin: 0 0 4px;
        }

        .exec-sales .exec-sales__lede {
          color: var(--t-ink-dim);
          font-size: 14px;
          margin: 0;
        }

        .exec-sales .exec-sales__filter {
          flex: 0 0 300px;
          min-height: 64px;
          min-width: 0;
        }

        .exec-sales .exec-sales__kpis {
          display: grid;
          gap: 16px;
          grid-template-columns: repeat(4, minmax(0, 1fr));
          margin-bottom: 16px;
        }

        .exec-sales .exec-sales__kpi {
          background: var(--t-surface);
          border: 1px solid var(--t-border);
          border-radius: var(--t-radius);
          border-top: 3px solid var(--t-accent);
          height: 120px;
          min-width: 0;
          padding: 12px 18px;
        }

        .exec-sales .exec-sales__charts {
          display: grid;
          gap: 16px;
          grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
          margin-bottom: 20px;
        }

        .exec-sales .exec-sales__card {
          background: var(--t-bg);
          border: 1px solid var(--t-border);
          border-radius: var(--t-radius);
          display: flex;
          flex-direction: column;
          min-width: 0;
          padding: var(--t-pad);
        }

        .exec-sales .exec-sales__card-note {
          color: var(--t-ink-faint);
          font-size: 12px;
          margin: 0 0 8px;
        }

        .exec-sales .exec-sales__chart {
          height: 400px;
          min-width: 0;
        }

        .exec-sales .exec-sales__footer {
          align-items: center;
          border-top: 1px solid var(--t-border);
          color: var(--t-ink-dim);
          display: grid;
          font-size: 12px;
          gap: 24px;
          grid-template-columns: minmax(0, 1fr) 280px;
          padding-top: 14px;
        }

        .exec-sales .exec-sales__source p { line-height: 1.5; margin: 0; }
        .exec-sales .exec-sales__source strong { color: var(--t-ink); font-weight: 600; }

        .exec-sales .exec-sales__updated {
          height: 76px;
          min-width: 0;
        }

        @media (max-width: 1000px) {
          .exec-sales .exec-sales__kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
          .exec-sales .exec-sales__charts { grid-template-columns: minmax(0, 1fr); }
        }

        @media (max-width: 640px) {
          .exec-sales { padding: 20px 16px; }
          .exec-sales .exec-sales__header { align-items: stretch; flex-direction: column; }
          .exec-sales .exec-sales__filter { flex-basis: auto; }
          .exec-sales .exec-sales__kpis,
          .exec-sales .exec-sales__footer { grid-template-columns: minmax(0, 1fr); }
          .exec-sales .exec-sales__chart { height: 340px; }
        }
      </style>

      <main class="exec-sales" aria-label="Executive sales overview">
        <header class="exec-sales__header">
          <div>
            <p class="exec-sales__eyebrow">TheLook eCommerce · Sales</p>
            <h1 class="exec-sales__title">Executive Sales Overview</h1>
            <p class="exec-sales__lede">Headline sales performance for the selected order date range.</p>
          </div>
          <div class="exec-sales__filter">
            <h-block name="f_order_date" />
          </div>
        </header>

        <section class="exec-sales__kpis" aria-label="Key performance indicators">
          <div class="exec-sales__kpi"><h-block name="k_net_sales" /></div>
          <div class="exec-sales__kpi"><h-block name="k_orders" /></div>
          <div class="exec-sales__kpi"><h-block name="k_aov" /></div>
          <div class="exec-sales__kpi"><h-block name="k_gross_margin" /></div>
        </section>

        <section class="exec-sales__charts">
          <div class="exec-sales__card">
            <p class="exec-sales__card-note">Net Sales by order month</p>
            <div class="exec-sales__chart"><h-block name="v_monthly_net_sales" /></div>
          </div>
          <div class="exec-sales__card">
            <p class="exec-sales__card-note">Ranked by Net Sales in the selected period</p>
            <div class="exec-sales__chart"><h-block name="v_top_categories" /></div>
          </div>
        </section>

        <footer class="exec-sales__footer">
          <div class="exec-sales__source">
            <p><strong>Data source:</strong> TheLook eCommerce dataset (thelook) on demodb.</p>
            <p>Net Sales and Gross Margin exclude Cancelled and Returned items. Orders counts all orders; AOV is Net Sales per fulfilled order. Dates use order created date.</p>
          </div>
          <div class="exec-sales__updated"><h-block name="t_last_updated" /></div>
        </footer>
      </main>
    ;;
  }
}
