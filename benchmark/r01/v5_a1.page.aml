Dashboard v5_a1 {
  title: 'Executive Sales Overview'
  description: 'Net Sales, Orders, AOV and Gross Margin for TheLook eCommerce, with monthly trend and top categories.'

  block title: TextBlock {
    content: @md
      # Executive Sales Overview
      Headline sales performance for TheLook eCommerce. Net Sales exclude Cancelled and Returned items.
    ;;
  }

  block date_filter: FilterBlock {
    label: 'Order Date'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_orders.created_at)
    }
    default {
      operator: 'matches'
      value: 'last 12 months'
    }
  }

  block kpi_net_sales: VizBlock {
    label: 'Net Sales'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: '[$$]#,###0'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
    settings {
      hide_label: true
    }
  }

  block kpi_orders: VizBlock {
    label: 'Orders'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.total_orders)
        label: 'Orders'
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
    settings {
      hide_label: true
    }
  }

  block kpi_aov: VizBlock {
    label: 'Average Order Value'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'
        format {
          type: 'number'
          pattern: '[$$]#,###0.00'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
    settings {
      hide_label: true
    }
  }

  block kpi_gross_margin: VizBlock {
    label: 'Gross Margin'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: '#,###0.0%'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
    settings {
      hide_label: true
    }
  }

  block monthly_net_sales: VizBlock {
    label: 'Monthly Net Sales'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_orders.created_at)
        label: 'Month'
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
        }
      }
      settings {
        sort {
          field_index: 0
          direction: 'asc'
          type: 'xaxis'
        }
        legend_label: 'hidden'
      }
    }
  }

  block top_categories: VizBlock {
    label: 'Top 10 Categories by Net Sales'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Category'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          mark_type: 'bar'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
        }
      }
      settings {
        row_limit: 10
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
        legend_label: 'hidden'
      }
    }
  }

  block source_note: TextBlock {
    content: @md
      **Data source:** TheLook eCommerce dataset (`thelook`, demodb): order items, orders and products. Net Sales and Gross Margin exclude Cancelled and Returned items; Orders count all statuses.
    ;;
  }

  block last_updated: VizBlock {
    label: 'Last Updated'
    viz: DataTable {
      dataset: thelook
      calculation latest_order_at {
        label: 'Data last updated (latest order)'
        formula: @aql max(thelook_orders.created_at);;
        calc_type: 'measure'
        data_type: 'datetime'
      }
      fields: [
        VizFieldFull {
          ref: 'latest_order_at'
          label: 'Data last updated (latest order)'
          format {
            type: 'datetime'
          }
        }
      ]
    }
    settings {
      hide_label: true
    }
  }

  interactions: [
    FilterInteraction {
      from: 'date_filter'
      to: [
        CustomMapping {
          block: 'last_updated'
          disabled: true
        }
      ]
    }
  ]

  view: CanvasLayout {
    width: 1220
    height: 1000
    grid_size: 20
    auto_expand_vertically: true

    block title {
      position: pos(20, 20, 880, 80)
      layer: 1
    }
    block date_filter {
      position: pos(920, 20, 280, 80)
      layer: 1
    }
    block kpi_net_sales {
      position: pos(20, 120, 280, 120)
      layer: 1
    }
    block kpi_orders {
      position: pos(320, 120, 280, 120)
      layer: 1
    }
    block kpi_aov {
      position: pos(620, 120, 280, 120)
      layer: 1
    }
    block kpi_gross_margin {
      position: pos(920, 120, 280, 120)
      layer: 1
    }
    block monthly_net_sales {
      position: pos(20, 260, 700, 400)
      layer: 1
    }
    block top_categories {
      position: pos(740, 260, 460, 400)
      layer: 1
    }
    block source_note {
      position: pos(20, 680, 880, 80)
      layer: 1
    }
    block last_updated {
      position: pos(920, 680, 280, 80)
      layer: 1
    }

    mobile {
      mode: 'auto'
    }
  }
}
