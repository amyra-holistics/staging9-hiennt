Dashboard v6_a1 {
  title: 'Executive Sales Overview'
  description: 'Net Sales, Orders, AOV and Gross Margin with the monthly Net Sales trend and top 10 categories. Source: TheLook eCommerce (thelook).'

  // HTML-layout theme: HTMLLayout owns page surfaces, so no background/canvas here.
  // Colour values mirror the CSS tokens in the layout below.
  theme: PageTheme {
    block {
      background { bg_color: 'transparent' }
      border {
        border_width: 0
        border_style: 'none'
      }
      shadow: 'none'
      padding: 0
      label {
        font_family: 'Inter'
        font_size: 14
        font_color: '#05264C'
        font_weight: 'semibold'
      }
      text {
        font_family: 'Inter'
        font_size: 13
        font_color: '#5C6E85'
        font_weight: 'normal'
      }
    }
    viz {
      metric_kpi {
        alignment: 'left'
        label {
          font_family: 'Inter'
          font_size: 13
          font_color: '#5C6E85'
        }
        value {
          font_family: 'Inter'
          font_size: 30
          font_color: '#05264C'
        }
      }
    }
  }

  // --- Filter ---------------------------------------------------------------
  block f_order_date: FilterBlock {
    label: 'Order Date'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
    default {
      operator: 'last'
      value: '12'
      modifier: 'month'
      options {
        include_current_period: true
      }
    }
  }

  // --- KPIs -----------------------------------------------------------------
  block k_net_sales: VizBlock {
    label: 'Net Sales'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
    settings { hide_label: true }
  }

  block k_orders: VizBlock {
    label: 'Orders'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        label: 'Orders'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
    settings { hide_label: true }
  }

  block k_aov: VizBlock {
    label: 'AOV'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'AOV'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
    settings { hide_label: true }
  }

  block k_gross_margin: VizBlock {
    label: 'Gross Margin'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
    settings { hide_label: true }
  }

  // --- Charts ---------------------------------------------------------------
  block v_net_sales_trend: VizBlock {
    label: 'Monthly Net Sales'
    viz: LineChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        label: 'Month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        legend_label: 'hidden'
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
    settings { hide_label: true }
  }

  block v_top_categories: VizBlock {
    label: 'Top 10 Categories by Net Sales'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Category'
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        legend_label: 'hidden'
        row_limit: 10
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
    settings { hide_label: true }
  }

  // --- Data freshness (not date-filtered, see interactions) ----------------
  block k_last_updated: VizBlock {
    label: 'Latest order in data'
    viz: MetricKpi {
      dataset: thelook
      calculation latest_order_at {
        label: 'Latest order in data'
        formula: @aql max(thelook_order_items.created_at);;
        calc_type: 'measure'
        data_type: 'datetime'
      }
      value: VizFieldFull {
        ref: 'latest_order_at'
        label: 'Latest order in data'
        format {
          type: 'datetime'
          pattern: 'dd LLL yyyy HH:mm'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
    settings { hide_label: true }
  }

  interactions: [
    FilterInteraction {
      from: 'f_order_date'
      to: [
        CustomMapping {
          block: ['k_last_updated']
          disabled: true
        }
      ]
    }
  ]

  view: HTMLLayout {
    content: @html
<style>
  .xso,
  .xso *,
  .xso *::before,
  .xso *::after { box-sizing: border-box; }

  .xso {
    --t-bg: #FFFFFF;
    --t-surface: #F5F8FA;
    --t-border: #E1E7EE;
    --t-ink: #05264C;
    --t-ink-dim: #5C6E85;
    --t-ink-faint: #8FA0B4;
    --t-accent: #259B6C;
    --t-accent-lt: #3FBE88;
    --t-accent-dk: #1B7A54;
    --t-radius: 10px;
    --t-radius-sm: 6px;
    --t-pad: 20px;
    --t-font-sans: Inter, ui-sans-serif, system-ui, sans-serif;
    --t-font-mono: "JetBrains Mono", ui-monospace, monospace;

    display: block;
    max-width: 1320px;
    margin: 0 auto;
    padding: 28px 28px 32px;
    background: var(--t-bg);
    color: var(--t-ink);
    font-family: var(--t-font-sans);
    font-size: 14px;
    line-height: 1.5;
  }

  /* Header */
  .xso .xso-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    padding-bottom: 20px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--t-border);
  }
  .xso .xso-title-wrap { min-width: 0; }
  .xso .xso-eyebrow {
    margin: 0 0 6px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--t-accent-dk);
  }
  .xso .xso-title {
    margin: 0;
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.2;
    color: var(--t-ink);
  }
  .xso .xso-subtitle {
    margin: 6px 0 0;
    font-size: 14px;
    color: var(--t-ink-dim);
  }
  .xso .xso-filter {
    width: 300px;
    max-width: 100%;
    min-height: 64px;
  }

  /* KPI row */
  .xso .xso-kpis {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 20px;
  }
  .xso .xso-kpi {
    position: relative;
    min-width: 0;
    padding: 16px var(--t-pad) 12px;
    background: var(--t-surface);
    border: 1px solid var(--t-border);
    border-radius: var(--t-radius);
    overflow: hidden;
  }
  .xso .xso-kpi::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--t-accent);
  }
  .xso .xso-kpi-label {
    margin: 0;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--t-ink-dim);
  }
  .xso .xso-kpi-value { height: 64px; }
  .xso .xso-kpi-note {
    margin: 0;
    font-size: 12px;
    color: var(--t-ink-faint);
  }

  /* Charts */
  .xso .xso-charts {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: 16px;
  }
  .xso .xso-card {
    min-width: 0;
    display: flex;
    flex-direction: column;
    padding: var(--t-pad);
    background: var(--t-bg);
    border: 1px solid var(--t-border);
    border-radius: var(--t-radius);
  }
  .xso .xso-card-head { margin-bottom: 12px; }
  .xso .xso-card-title {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    color: var(--t-ink);
  }
  .xso .xso-card-sub {
    margin: 2px 0 0;
    font-size: 13px;
    color: var(--t-ink-dim);
  }
  .xso .xso-chart { height: 380px; min-width: 0; }

  /* Footer: source + last updated */
  .xso .xso-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
    flex-wrap: wrap;
    margin-top: 20px;
    padding: 12px var(--t-pad);
    background: var(--t-surface);
    border: 1px solid var(--t-border);
    border-radius: var(--t-radius-sm);
    font-size: 12px;
    color: var(--t-ink-dim);
  }
  .xso .xso-footer p { margin: 0; }
  .xso .xso-footer strong { color: var(--t-ink); font-weight: 600; }
  .xso .xso-updated {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }
  .xso .xso-updated-label {
    font-weight: 600;
    white-space: nowrap;
    color: var(--t-ink);
  }
  .xso .xso-updated-value { width: 200px; height: 40px; }

  @media (max-width: 1000px) {
    .xso .xso-kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .xso .xso-charts { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 560px) {
    .xso { padding: 20px 16px; }
    .xso .xso-kpis { grid-template-columns: minmax(0, 1fr); }
    .xso .xso-filter { width: 100%; }
  }
</style>

<div class="xso">
  <header class="xso-header">
    <div class="xso-title-wrap">
      <p class="xso-eyebrow">Executive overview</p>
      <h1 class="xso-title">Sales Performance</h1>
      <p class="xso-subtitle">Net Sales exclude Cancelled and Returned items. All figures follow the order date filter.</p>
    </div>
    <div class="xso-filter">
      <h-block name="f_order_date" />
    </div>
  </header>

  <section class="xso-kpis">
    <div class="xso-kpi">
      <p class="xso-kpi-label">Net Sales</p>
      <div class="xso-kpi-value"><h-block name="k_net_sales" /></div>
      <p class="xso-kpi-note">Sale price, excl. cancelled &amp; returned</p>
    </div>
    <div class="xso-kpi">
      <p class="xso-kpi-label">Orders</p>
      <div class="xso-kpi-value"><h-block name="k_orders" /></div>
      <p class="xso-kpi-note">Orders with at least one net item</p>
    </div>
    <div class="xso-kpi">
      <p class="xso-kpi-label">AOV</p>
      <div class="xso-kpi-value"><h-block name="k_aov" /></div>
      <p class="xso-kpi-note">Net Sales per order</p>
    </div>
    <div class="xso-kpi">
      <p class="xso-kpi-label">Gross Margin</p>
      <div class="xso-kpi-value"><h-block name="k_gross_margin" /></div>
      <p class="xso-kpi-note">(Net Sales − COGS) ÷ Net Sales</p>
    </div>
  </section>

  <section class="xso-charts">
    <div class="xso-card">
      <div class="xso-card-head">
        <h2 class="xso-card-title">Monthly Net Sales</h2>
        <p class="xso-card-sub">Net Sales by order month</p>
      </div>
      <div class="xso-chart"><h-block name="v_net_sales_trend" /></div>
    </div>
    <div class="xso-card">
      <div class="xso-card-head">
        <h2 class="xso-card-title">Top 10 Categories</h2>
        <p class="xso-card-sub">Product categories ranked by Net Sales</p>
      </div>
      <div class="xso-chart"><h-block name="v_top_categories" /></div>
    </div>
  </section>

  <footer class="xso-footer">
    <p><strong>Data source:</strong> TheLook eCommerce dataset (thelook) · order items, orders and products</p>
    <div class="xso-updated">
      <span class="xso-updated-label">Last updated (latest order):</span>
      <div class="xso-updated-value"><h-block name="k_last_updated" /></div>
    </div>
  </footer>
</div>
    ;;
  }
}
