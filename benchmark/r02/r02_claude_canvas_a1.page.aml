Dashboard r02_claude_canvas_a1 {
  title: 'Sales Performance'
  description: 'Sales performance of TheLook eCommerce across overview, products, customers and geography. Filters are shared by every tab.'

  // ---------------------------------------------------------------
  // Shared filters (placed on every tab, so selections carry across)
  // ---------------------------------------------------------------
  block f_order_date: FilterBlock {
    label: 'Order Date'
    type: 'date'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }
  block f_country: FilterBlock {
    label: 'Country'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.country)
    }
    settings {
      input_type: 'multiple'
    }
  }
  block f_category: FilterBlock {
    label: 'Product Category'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.category)
    }
    settings {
      input_type: 'multiple'
    }
  }
  block f_department: FilterBlock {
    label: 'Department'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.department)
    }
    settings {
      input_type: 'multiple'
    }
  }

  // ---------------------------------------------------------------
  // Tab headers
  // ---------------------------------------------------------------
  block h_overview: TextBlock {
    content: @md
## Sales Performance · Overview
Headline sales, profit and order trends. Net figures exclude Cancelled and Returned items.
    ;;
    theme {
      background { bg_color: 'transparent' }
      border { border_width: 0 }
      shadow: 'none'
    }
  }
  block h_products: TextBlock {
    content: @md
## Sales Performance · Products
Which categories, departments and brands drive sales, margin and returns.
    ;;
    theme {
      background { bg_color: 'transparent' }
      border { border_width: 0 }
      shadow: 'none'
    }
  }
  block h_customers: TextBlock {
    content: @md
## Sales Performance · Customers
Who buys, how often and through which acquisition channels.
    ;;
    theme {
      background { bg_color: 'transparent' }
      border { border_width: 0 }
      shadow: 'none'
    }
  }
  block h_geography: TextBlock {
    content: @md
## Sales Performance · Geography
Where sales come from, by customer country.
    ;;
    theme {
      background { bg_color: 'transparent' }
      border { border_width: 0 }
      shadow: 'none'
    }
  }

  // ---------------------------------------------------------------
  // Overview
  // ---------------------------------------------------------------
  block ov_kpi_net_sales: VizBlock {
    label: 'Net Sales'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        format { type: 'number' pattern: 'inherited' }
      }
      settings { display_mode: 'single' alignment: 'center' }
    }
  }
  block ov_kpi_gross_profit: VizBlock {
    label: 'Gross Profit'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_profit)
        format { type: 'number' pattern: 'inherited' }
      }
      settings { display_mode: 'single' alignment: 'center' }
    }
  }
  block ov_kpi_orders: VizBlock {
    label: 'Fulfilled Orders'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        format { type: 'number' pattern: 'inherited' }
      }
      settings { display_mode: 'single' alignment: 'center' }
    }
  }
  block ov_kpi_aov: VizBlock {
    label: 'Average Order Value'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        format { type: 'number' pattern: 'inherited' }
      }
      settings { display_mode: 'single' alignment: 'center' }
    }
  }
  block ov_monthly_trend: VizBlock {
    label: 'Monthly Net Sales and Gross Profit'
    viz: LineChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format { type: 'date' pattern: 'LLL yyyy' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format { type: 'number' pattern: 'inherited' }
          }
        }
        series {
          field: VizFieldFull {
            ref: r(thelook.gross_profit)
            label: 'Gross Profit'
            format { type: 'number' pattern: 'inherited' }
          }
        }
      }
      settings {
        x_axis_label: 'Month'
        legend_label: 'bottom'
        show_data_points: false
        sort: LineFamilySort { type: 'xaxis' direction: 'asc' }
      }
    }
  }
  block ov_yearly_sales: VizBlock {
    label: 'Net Sales by Year'
    viz: ColumnChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc year'
        format { type: 'date' pattern: 'yyyy' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format { type: 'number' pattern: 'inherited' }
          }
        }
      }
      settings {
        sort: LineFamilySort { type: 'xaxis' direction: 'asc' }
      }
    }
  }
  block ov_status_mix: VizBlock {
    label: 'Gross Sales by Item Status'
    viz: PieChart {
      dataset: thelook
      legend: r(thelook_order_items.status)
      series {
        field: VizFieldFull {
          ref: r(thelook.gross_sales)
          format { type: 'number' pattern: 'inherited' }
        }
      }
      settings {
        display_as_donut: true
        legend_label: 'right'
        show_percentage: true
        sort: 'desc'
      }
    }
  }

  // ---------------------------------------------------------------
  // Products
  // ---------------------------------------------------------------
  block pr_kpi_items_sold: VizBlock {
    label: 'Items Sold'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.items_sold)
        format { type: 'number' pattern: 'inherited' }
      }
      settings { display_mode: 'single' alignment: 'center' }
    }
  }
  block pr_kpi_cogs: VizBlock {
    label: 'COGS'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.cogs)
        format { type: 'number' pattern: 'inherited' }
      }
      settings { display_mode: 'single' alignment: 'center' }
    }
  }
  block pr_kpi_margin: VizBlock {
    label: 'Gross Margin'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        format { type: 'number' pattern: 'inherited' }
      }
      settings { display_mode: 'single' alignment: 'center' }
    }
  }
  block pr_kpi_return_rate: VizBlock {
    label: 'Return Rate'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.return_rate)
        format { type: 'number' pattern: 'inherited' }
      }
      settings { display_mode: 'single' alignment: 'center' }
    }
  }
  block pr_top_categories: VizBlock {
    label: 'Top 10 Categories by Net Sales'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Category'
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format { type: 'number' pattern: 'inherited' }
          }
        }
      }
      settings {
        row_limit: 10
        sort: LineFamilySort { type: 'yaxis' field_index: 0 direction: 'desc' }
      }
    }
  }
  block pr_department_mix: VizBlock {
    label: 'Net Sales by Department'
    viz: PieChart {
      dataset: thelook
      legend: r(thelook_products.department)
      series {
        field: VizFieldFull {
          ref: r(thelook.net_sales)
          format { type: 'number' pattern: 'inherited' }
        }
      }
      settings {
        display_as_donut: true
        legend_label: 'right'
        show_percentage: true
        sort: 'desc'
      }
    }
  }
  block pr_brand_table: VizBlock {
    label: 'Brand Performance'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          ref: r(thelook_products.brand)
          label: 'Brand'
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format { type: 'number' pattern: 'inherited' }
        },
        VizFieldFull {
          ref: r(thelook.items_sold)
          label: 'Items Sold'
          format { type: 'number' pattern: 'inherited' }
        },
        VizFieldFull {
          ref: r(thelook.gross_profit)
          label: 'Gross Profit'
          format { type: 'number' pattern: 'inherited' }
        },
        VizFieldFull {
          ref: r(thelook.gross_margin)
          label: 'Gross Margin'
          format { type: 'number' pattern: 'inherited' }
        },
        VizFieldFull {
          ref: r(thelook.return_rate)
          label: 'Return Rate'
          format { type: 'number' pattern: 'inherited' }
        }
      ]
      settings {
        sorts: [
          IndexBasedSortSetting { field_index: 1 direction: 'desc' }
        ]
        pagination_size: 25
      }
    }
  }

  // ---------------------------------------------------------------
  // Customers
  // ---------------------------------------------------------------
  block cu_kpi_buyers: VizBlock {
    label: 'Buying Customers'
    viz: MetricKpi {
      dataset: thelook
      calculation buying_customers {
        label: 'Buying Customers'
        formula: @aql thelook_order_items | where(thelook_order_items.status not in ['Cancelled', 'Returned']) | count_distinct(thelook_orders.user_id) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'buying_customers'
        format { type: 'number' pattern: '#,###0' }
      }
      settings { display_mode: 'single' alignment: 'center' }
    }
  }
  block cu_kpi_orders_per_customer: VizBlock {
    label: 'Orders per Customer'
    viz: MetricKpi {
      dataset: thelook
      calculation orders_per_customer {
        label: 'Orders per Customer'
        formula: @aql safe_divide(fulfilled_orders, thelook_order_items | where(thelook_order_items.status not in ['Cancelled', 'Returned']) | count_distinct(thelook_orders.user_id)) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'orders_per_customer'
        format { type: 'number' pattern: '#,###0.00' }
      }
      settings { display_mode: 'single' alignment: 'center' }
    }
  }
  block cu_kpi_sales_per_customer: VizBlock {
    label: 'Net Sales per Customer'
    viz: MetricKpi {
      dataset: thelook
      calculation sales_per_customer {
        label: 'Net Sales per Customer'
        formula: @aql safe_divide(net_sales, thelook_order_items | where(thelook_order_items.status not in ['Cancelled', 'Returned']) | count_distinct(thelook_orders.user_id)) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'sales_per_customer'
        format { type: 'number' pattern: '[$$]#,###0.00' }
      }
      settings { display_mode: 'single' alignment: 'center' }
    }
  }
  block cu_kpi_aov: VizBlock {
    label: 'Average Order Value'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        format { type: 'number' pattern: 'inherited' }
      }
      settings { display_mode: 'single' alignment: 'center' }
    }
  }
  block cu_monthly_buyers: VizBlock {
    label: 'Monthly Buying Customers'
    viz: LineChart {
      dataset: thelook
      calculation buying_customers {
        label: 'Buying Customers'
        formula: @aql thelook_order_items | where(thelook_order_items.status not in ['Cancelled', 'Returned']) | count_distinct(thelook_orders.user_id) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format { type: 'date' pattern: 'LLL yyyy' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: 'buying_customers'
            label: 'Buying Customers'
            format { type: 'number' pattern: '#,###0' }
          }
        }
      }
      settings {
        x_axis_label: 'Month'
        legend_label: 'bottom'
        show_data_points: false
        sort: LineFamilySort { type: 'xaxis' direction: 'asc' }
      }
    }
  }
  block cu_traffic_source: VizBlock {
    label: 'Net Sales by Traffic Source'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.traffic_source)
        label: 'Traffic Source'
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format { type: 'number' pattern: 'inherited' }
          }
        }
      }
      settings {
        sort: LineFamilySort { type: 'yaxis' field_index: 0 direction: 'desc' }
      }
    }
  }
  block cu_gender_mix: VizBlock {
    label: 'Net Sales by Customer Gender'
    viz: PieChart {
      dataset: thelook
      legend: r(thelook_users.gender)
      series {
        field: VizFieldFull {
          ref: r(thelook.net_sales)
          format { type: 'number' pattern: 'inherited' }
        }
      }
      settings {
        display_as_donut: true
        legend_label: 'right'
        show_percentage: true
        sort: 'desc'
      }
    }
  }

  // ---------------------------------------------------------------
  // Geography
  // ---------------------------------------------------------------
  block ge_kpi_countries: VizBlock {
    label: 'Countries with Sales'
    viz: MetricKpi {
      dataset: thelook
      calculation countries_with_sales {
        label: 'Countries with Sales'
        formula: @aql thelook_order_items | where(thelook_order_items.status not in ['Cancelled', 'Returned']) | count_distinct(thelook_users.country) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'countries_with_sales'
        format { type: 'number' pattern: '#,###0' }
      }
      settings { display_mode: 'single' alignment: 'center' }
    }
  }
  block ge_kpi_net_sales: VizBlock {
    label: 'Net Sales'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        format { type: 'number' pattern: 'inherited' }
      }
      settings { display_mode: 'single' alignment: 'center' }
    }
  }
  block ge_kpi_orders: VizBlock {
    label: 'Fulfilled Orders'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        format { type: 'number' pattern: 'inherited' }
      }
      settings { display_mode: 'single' alignment: 'center' }
    }
  }
  block ge_kpi_return_rate: VizBlock {
    label: 'Return Rate'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.return_rate)
        format { type: 'number' pattern: 'inherited' }
      }
      settings { display_mode: 'single' alignment: 'center' }
    }
  }
  block ge_map: VizBlock {
    label: 'Net Sales by Country (Map)'
    viz: FilledMap {
      dataset: thelook
      location {
        field: r(thelook_users.country)
        location_type: 'country'
        primary_field: true
      }
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        format { type: 'number' pattern: 'inherited' }
      }
      settings {
        color_scale: 'vertical'
        map_background: 'light'
      }
    }
  }
  block ge_top_countries: VizBlock {
    label: 'Top 10 Countries by Net Sales'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.country)
        label: 'Country'
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format { type: 'number' pattern: 'inherited' }
          }
        }
      }
      settings {
        row_limit: 10
        sort: LineFamilySort { type: 'yaxis' field_index: 0 direction: 'desc' }
      }
    }
  }
  block ge_country_table: VizBlock {
    label: 'Country Performance'
    viz: DataTable {
      dataset: thelook
      calculation buying_customers {
        label: 'Buying Customers'
        formula: @aql thelook_order_items | where(thelook_order_items.status not in ['Cancelled', 'Returned']) | count_distinct(thelook_orders.user_id) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      fields: [
        VizFieldFull {
          ref: r(thelook_users.country)
          label: 'Country'
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format { type: 'number' pattern: 'inherited' }
        },
        VizFieldFull {
          ref: r(thelook.fulfilled_orders)
          label: 'Fulfilled Orders'
          format { type: 'number' pattern: 'inherited' }
        },
        VizFieldFull {
          ref: 'buying_customers'
          label: 'Buying Customers'
          format { type: 'number' pattern: '#,###0' }
        },
        VizFieldFull {
          ref: r(thelook.aov)
          label: 'Average Order Value'
          format { type: 'number' pattern: 'inherited' }
        },
        VizFieldFull {
          ref: r(thelook.gross_margin)
          label: 'Gross Margin'
          format { type: 'number' pattern: 'inherited' }
        }
      ]
      settings {
        sorts: [
          IndexBasedSortSetting { field_index: 1 direction: 'desc' }
        ]
        pagination_size: 25
      }
    }
  }

  // ---------------------------------------------------------------
  // Layout: every tab uses the same grid —
  //   header (y 20) · filters (y 100) · KPI row (y 190) · row 2 (y 320) · row 3 (y 680)
  // ---------------------------------------------------------------
  view: TabLayout {
    label: 'Sales Performance'

    tab overview: CanvasLayout {
      label: 'Overview'
      width: 1200
      height: 1040
      grid_size: 20
      auto_expand_vertically: true
      block h_overview { position: pos(20, 20, 1160, 70) }
      block f_order_date { position: pos(20, 100, 275, 70) }
      block f_country { position: pos(315, 100, 275, 70) }
      block f_category { position: pos(610, 100, 275, 70) }
      block f_department { position: pos(905, 100, 275, 70) }
      block ov_kpi_net_sales { position: pos(20, 190, 275, 110) }
      block ov_kpi_gross_profit { position: pos(315, 190, 275, 110) }
      block ov_kpi_orders { position: pos(610, 190, 275, 110) }
      block ov_kpi_aov { position: pos(905, 190, 275, 110) }
      block ov_monthly_trend { position: pos(20, 320, 1160, 340) }
      block ov_yearly_sales { position: pos(20, 680, 570, 340) }
      block ov_status_mix { position: pos(610, 680, 570, 340) }
      mobile { mode: 'auto' }
    }

    tab products: CanvasLayout {
      label: 'Products'
      width: 1200
      height: 1040
      grid_size: 20
      auto_expand_vertically: true
      block h_products { position: pos(20, 20, 1160, 70) }
      block f_order_date { position: pos(20, 100, 275, 70) }
      block f_country { position: pos(315, 100, 275, 70) }
      block f_category { position: pos(610, 100, 275, 70) }
      block f_department { position: pos(905, 100, 275, 70) }
      block pr_kpi_items_sold { position: pos(20, 190, 275, 110) }
      block pr_kpi_cogs { position: pos(315, 190, 275, 110) }
      block pr_kpi_margin { position: pos(610, 190, 275, 110) }
      block pr_kpi_return_rate { position: pos(905, 190, 275, 110) }
      block pr_top_categories { position: pos(20, 320, 570, 340) }
      block pr_department_mix { position: pos(610, 320, 570, 340) }
      block pr_brand_table { position: pos(20, 680, 1160, 340) }
      mobile { mode: 'auto' }
    }

    tab customers: CanvasLayout {
      label: 'Customers'
      width: 1200
      height: 1040
      grid_size: 20
      auto_expand_vertically: true
      block h_customers { position: pos(20, 20, 1160, 70) }
      block f_order_date { position: pos(20, 100, 275, 70) }
      block f_country { position: pos(315, 100, 275, 70) }
      block f_category { position: pos(610, 100, 275, 70) }
      block f_department { position: pos(905, 100, 275, 70) }
      block cu_kpi_buyers { position: pos(20, 190, 275, 110) }
      block cu_kpi_orders_per_customer { position: pos(315, 190, 275, 110) }
      block cu_kpi_sales_per_customer { position: pos(610, 190, 275, 110) }
      block cu_kpi_aov { position: pos(905, 190, 275, 110) }
      block cu_monthly_buyers { position: pos(20, 320, 1160, 340) }
      block cu_traffic_source { position: pos(20, 680, 570, 340) }
      block cu_gender_mix { position: pos(610, 680, 570, 340) }
      mobile { mode: 'auto' }
    }

    tab geography: CanvasLayout {
      label: 'Geography'
      width: 1200
      height: 1040
      grid_size: 20
      auto_expand_vertically: true
      block h_geography { position: pos(20, 20, 1160, 70) }
      block f_order_date { position: pos(20, 100, 275, 70) }
      block f_country { position: pos(315, 100, 275, 70) }
      block f_category { position: pos(610, 100, 275, 70) }
      block f_department { position: pos(905, 100, 275, 70) }
      block ge_kpi_countries { position: pos(20, 190, 275, 110) }
      block ge_kpi_net_sales { position: pos(315, 190, 275, 110) }
      block ge_kpi_orders { position: pos(610, 190, 275, 110) }
      block ge_kpi_return_rate { position: pos(905, 190, 275, 110) }
      block ge_map { position: pos(20, 320, 570, 340) }
      block ge_top_countries { position: pos(610, 320, 570, 340) }
      block ge_country_table { position: pos(20, 680, 1160, 340) }
      mobile { mode: 'auto' }
    }
  }

  // One theme for the whole page, so every tab looks the same
  theme: PageTheme {
    background { bg_color: '#F4F6FA' }
    canvas {
      background { bg_color: '#F4F6FA' }
      border { border_width: 0 }
      shadow: 'none'
    }
    block {
      background { bg_color: '#FFFFFF' }
      border {
        border_width: 1
        border_radius: 8
        border_color: '#E3E7EE'
        border_style: 'solid'
      }
      padding: 12
      shadow: 'sm'
      label {
        font_size: 14
        font_weight: 'semibold'
        font_color: '#1F2A44'
      }
    }
  }
}
