Dashboard r02_claude_canvas_a2 {
  title: 'Sales Performance'
  description: 'Sales performance of TheLook eCommerce across overview, products, customers and geography.'

  // ---------- Shared header & filters (synced on every tab) ----------
  block header: TextBlock {
    content: @md
      # Sales Performance
      TheLook eCommerce · Net Sales exclude Cancelled and Returned items. Filters apply to every tab.
    ;;
  }

  block f_order_date: FilterBlock {
    label: 'Order Date'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block f_country: FilterBlock {
    label: 'Country'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.country)
    }
  }

  block f_department: FilterBlock {
    label: 'Department'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.department)
    }
  }

  block f_category: FilterBlock {
    label: 'Category'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.category)
    }
  }

  // ---------- Overview ----------
  block ov_kpi_net_sales: VizBlock {
    label: 'Net Sales'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        format { type: 'number', pattern: 'inherited' }
      }
      settings { display_mode: 'single', alignment: 'center' }
    }
  }

  block ov_kpi_gross_profit: VizBlock {
    label: 'Gross Profit'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_profit)
        format { type: 'number', pattern: 'inherited' }
      }
      settings { display_mode: 'single', alignment: 'center' }
    }
  }

  block ov_kpi_margin: VizBlock {
    label: 'Gross Margin'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        format { type: 'number', pattern: 'inherited' }
      }
      settings { display_mode: 'single', alignment: 'center' }
    }
  }

  block ov_kpi_orders: VizBlock {
    label: 'Fulfilled Orders'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        format { type: 'number', pattern: 'inherited' }
      }
      settings { display_mode: 'single', alignment: 'center' }
    }
  }

  block ov_trend: VizBlock {
    label: 'Monthly Net Sales & Gross Profit'
    viz: LineChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format { type: 'date', pattern: 'LLL yyyy' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            format { type: 'number', pattern: 'inherited' }
          }
          settings { color: '#2563EB' }
        }
        series {
          field: VizFieldFull {
            ref: r(thelook.gross_profit)
            format { type: 'number', pattern: 'inherited' }
          }
          settings { color: '#0D9488' }
        }
      }
      settings {
        legend_label: 'bottom'
        show_data_points: false
        sort: LineFamilySort { type: 'xaxis', direction: 'asc' }
      }
    }
  }

  block ov_by_department: VizBlock {
    label: 'Net Sales by Department'
    viz: PieChart {
      dataset: thelook
      legend: VizFieldFull {
        ref: r(thelook_products.department)
        format { type: 'text' }
      }
      series {
        field: VizFieldFull {
          ref: r(thelook.net_sales)
          format { type: 'number', pattern: 'inherited' }
        }
      }
      settings {
        display_as_donut: true
        legend_label: 'bottom'
        show_percentage: true
        show_total: true
      }
    }
  }

  block ov_yearly: VizBlock {
    label: 'Yearly Performance'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          label: 'Year'
          ref: r(thelook_order_items.created_at)
          transformation: 'datetrunc year'
          format { type: 'date', pattern: 'yyyy' }
        },
        VizFieldFull { ref: r(thelook.gross_sales), format { type: 'number', pattern: 'inherited' } },
        VizFieldFull { ref: r(thelook.net_sales), format { type: 'number', pattern: 'inherited' } },
        VizFieldFull { ref: r(thelook.gross_profit), format { type: 'number', pattern: 'inherited' } },
        VizFieldFull { ref: r(thelook.gross_margin), format { type: 'number', pattern: 'inherited' } },
        VizFieldFull { ref: r(thelook.fulfilled_orders), format { type: 'number', pattern: 'inherited' } },
        VizFieldFull { ref: r(thelook.aov), format { type: 'number', pattern: 'inherited' } },
        VizFieldFull { ref: r(thelook.return_rate), format { type: 'number', pattern: 'inherited' } }
      ]
      settings {
        sorts: [ IndexBasedSortSetting { field_index: 0, direction: 'desc' } ]
        show_row_number: false
      }
    }
  }

  // ---------- Products ----------
  block pr_kpi_items: VizBlock {
    label: 'Items Sold'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.items_sold)
        format { type: 'number', pattern: 'inherited' }
      }
      settings { display_mode: 'single', alignment: 'center' }
    }
  }

  block pr_kpi_net_sales: VizBlock {
    label: 'Net Sales'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        format { type: 'number', pattern: 'inherited' }
      }
      settings { display_mode: 'single', alignment: 'center' }
    }
  }

  block pr_kpi_margin: VizBlock {
    label: 'Gross Margin'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        format { type: 'number', pattern: 'inherited' }
      }
      settings { display_mode: 'single', alignment: 'center' }
    }
  }

  block pr_kpi_return_rate: VizBlock {
    label: 'Return Rate'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.return_rate)
        format { type: 'number', pattern: 'inherited' }
      }
      settings { display_mode: 'single', alignment: 'center' }
    }
  }

  block pr_by_category: VizBlock {
    label: 'Net Sales & Gross Profit by Category'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        format { type: 'text' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            format { type: 'number', pattern: 'inherited' }
          }
          settings { color: '#2563EB' }
        }
        series {
          field: VizFieldFull {
            ref: r(thelook.gross_profit)
            format { type: 'number', pattern: 'inherited' }
          }
          settings { color: '#0D9488' }
        }
      }
      settings {
        legend_label: 'bottom'
        sort: LineFamilySort { type: 'yaxis', field_index: 0, direction: 'desc' }
      }
    }
  }

  block pr_top_brands: VizBlock {
    label: 'Top 10 Brands by Net Sales'
    viz: BarChart {
      dataset: thelook
      filter {
        field: r(thelook_products.brand)
        operator: 'top'
        value: 10
        options {
          rank_by {
            field: r(thelook.net_sales)
          }
        }
      }
      x_axis: VizFieldFull {
        ref: r(thelook_products.brand)
        format { type: 'text' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            format { type: 'number', pattern: 'inherited' }
          }
          settings { color: '#2563EB' }
        }
      }
      settings {
        legend_label: 'hidden'
        sort: LineFamilySort { type: 'yaxis', field_index: 0, direction: 'desc' }
      }
    }
  }

  block pr_top_products: VizBlock {
    label: 'Top Products'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull { ref: r(thelook_products.name), format { type: 'text' } },
        VizFieldFull { ref: r(thelook_products.brand), format { type: 'text' } },
        VizFieldFull { ref: r(thelook_products.category), format { type: 'text' } },
        VizFieldFull { ref: r(thelook.items_sold), format { type: 'number', pattern: 'inherited' } },
        VizFieldFull { ref: r(thelook.net_sales), format { type: 'number', pattern: 'inherited' } },
        VizFieldFull { ref: r(thelook.gross_profit), format { type: 'number', pattern: 'inherited' } },
        VizFieldFull { ref: r(thelook.gross_margin), format { type: 'number', pattern: 'inherited' } },
        VizFieldFull { ref: r(thelook.return_rate), format { type: 'number', pattern: 'inherited' } }
      ]
      settings {
        sorts: [ IndexBasedSortSetting { field_index: 4, direction: 'desc' } ]
        row_limit: 100
        show_row_number: true
      }
    }
  }

  // ---------- Customers ----------
  block cu_kpi_buyers: VizBlock {
    label: 'Buying Customers'
    viz: MetricKpi {
      dataset: thelook
      calculation buying_customers {
        label: 'Buying Customers'
        formula: @aql thelook_order_items | where(thelook_order_items.status not in ['Cancelled', 'Returned']) | count_distinct(thelook_users.id) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'buying_customers'
        format { type: 'number', pattern: '#,###0' }
      }
      settings { display_mode: 'single', alignment: 'center' }
    }
  }

  block cu_kpi_sales_per_customer: VizBlock {
    label: 'Net Sales per Customer'
    viz: MetricKpi {
      dataset: thelook
      calculation sales_per_customer {
        label: 'Net Sales per Customer'
        formula: @aql safe_divide(net_sales, thelook_order_items | where(thelook_order_items.status not in ['Cancelled', 'Returned']) | count_distinct(thelook_users.id)) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'sales_per_customer'
        format { type: 'number', pattern: '[$$]#,###0.00' }
      }
      settings { display_mode: 'single', alignment: 'center' }
    }
  }

  block cu_kpi_aov: VizBlock {
    label: 'Average Order Value'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        format { type: 'number', pattern: 'inherited' }
      }
      settings { display_mode: 'single', alignment: 'center' }
    }
  }

  block cu_kpi_orders_per_customer: VizBlock {
    label: 'Orders per Customer'
    viz: MetricKpi {
      dataset: thelook
      calculation orders_per_customer {
        label: 'Orders per Customer'
        formula: @aql safe_divide(fulfilled_orders, thelook_order_items | where(thelook_order_items.status not in ['Cancelled', 'Returned']) | count_distinct(thelook_users.id)) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'orders_per_customer'
        format { type: 'number', pattern: '#,###0.00' }
      }
      settings { display_mode: 'single', alignment: 'center' }
    }
  }

  block cu_by_age_gender: VizBlock {
    label: 'Net Sales by Age Group & Gender'
    viz: ColumnChart {
      dataset: thelook
      calculation age_group {
        label: 'Age Group'
        formula: @aql case(
          when: thelook_users.age < 25, then: 'Under 25',
          when: thelook_users.age < 35, then: '25-34',
          when: thelook_users.age < 45, then: '35-44',
          when: thelook_users.age < 55, then: '45-54',
          else: '55+'
        ) ;;
        calc_type: 'dimension'
        data_type: 'text'
      }
      x_axis: VizFieldFull {
        ref: 'age_group'
        format { type: 'text' }
      }
      legend: VizFieldFull {
        ref: r(thelook_users.gender)
        format { type: 'text' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            format { type: 'number', pattern: 'inherited' }
          }
          settings {
            point { value: 'F', color: '#2563EB' }
            point { value: 'M', color: '#0D9488' }
          }
        }
      }
      settings {
        legend_label: 'bottom'
        sort: LineFamilySort { type: 'xaxis', direction: 'asc' }
      }
    }
  }

  block cu_by_traffic_source: VizBlock {
    label: 'Net Sales by Traffic Source'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.traffic_source)
        format { type: 'text' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            format { type: 'number', pattern: 'inherited' }
          }
          settings { color: '#2563EB' }
        }
      }
      settings {
        legend_label: 'hidden'
        sort: LineFamilySort { type: 'yaxis', field_index: 0, direction: 'desc' }
      }
    }
  }

  block cu_top_customers: VizBlock {
    label: 'Top Customers'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull { ref: r(thelook_users.first_name), format { type: 'text' } },
        VizFieldFull { ref: r(thelook_users.last_name), format { type: 'text' } },
        VizFieldFull { ref: r(thelook_users.email), format { type: 'text' } },
        VizFieldFull { ref: r(thelook_users.country), format { type: 'text' } },
        VizFieldFull { ref: r(thelook_users.traffic_source), format { type: 'text' } },
        VizFieldFull { ref: r(thelook.fulfilled_orders), format { type: 'number', pattern: 'inherited' } },
        VizFieldFull { ref: r(thelook.net_sales), format { type: 'number', pattern: 'inherited' } },
        VizFieldFull { ref: r(thelook.aov), format { type: 'number', pattern: 'inherited' } }
      ]
      settings {
        sorts: [ IndexBasedSortSetting { field_index: 6, direction: 'desc' } ]
        row_limit: 100
        show_row_number: true
      }
    }
  }

  // ---------- Geography ----------
  block ge_kpi_net_sales: VizBlock {
    label: 'Net Sales'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        format { type: 'number', pattern: 'inherited' }
      }
      settings { display_mode: 'single', alignment: 'center' }
    }
  }

  block ge_kpi_countries: VizBlock {
    label: 'Countries with Sales'
    viz: MetricKpi {
      dataset: thelook
      calculation countries_with_sales {
        label: 'Countries with Sales'
        formula: @aql thelook_order_items | where(thelook_order_items.status not in ['Cancelled', 'Returned']) | count_distinct(thelook_users.country) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'countries_with_sales'
        format { type: 'number', pattern: '#,###0' }
      }
      settings { display_mode: 'single', alignment: 'center' }
    }
  }

  block ge_kpi_cities: VizBlock {
    label: 'Cities with Sales'
    viz: MetricKpi {
      dataset: thelook
      calculation cities_with_sales {
        label: 'Cities with Sales'
        formula: @aql thelook_order_items | where(thelook_order_items.status not in ['Cancelled', 'Returned']) | count_distinct(thelook_users.city) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'cities_with_sales'
        format { type: 'number', pattern: '#,###0' }
      }
      settings { display_mode: 'single', alignment: 'center' }
    }
  }

  block ge_kpi_aov: VizBlock {
    label: 'Average Order Value'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        format { type: 'number', pattern: 'inherited' }
      }
      settings { display_mode: 'single', alignment: 'center' }
    }
  }

  block ge_map: VizBlock {
    label: 'Net Sales by Country'
    viz: FilledMap {
      dataset: thelook
      location {
        field: VizFieldFull {
          ref: r(thelook_users.country)
          format { type: 'text' }
        }
        location_type: 'country'
      }
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        format { type: 'number', pattern: 'inherited' }
      }
      settings {
        color_scale: 'vertical'
        map_background: 'light'
        value_colors {
          min { type: 'percentage', value: 0, color: '#DBEAFE' }
          max { type: 'percentage', value: 100, color: '#1E3A8A' }
        }
      }
    }
  }

  block ge_by_country: VizBlock {
    label: 'Net Sales & Gross Profit by Country'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.country)
        format { type: 'text' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            format { type: 'number', pattern: 'inherited' }
          }
          settings { color: '#2563EB' }
        }
        series {
          field: VizFieldFull {
            ref: r(thelook.gross_profit)
            format { type: 'number', pattern: 'inherited' }
          }
          settings { color: '#0D9488' }
        }
      }
      settings {
        legend_label: 'bottom'
        sort: LineFamilySort { type: 'yaxis', field_index: 0, direction: 'desc' }
      }
    }
  }

  block ge_by_state: VizBlock {
    label: 'Top States / Regions'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull { ref: r(thelook_users.country), format { type: 'text' } },
        VizFieldFull { ref: r(thelook_users.state), format { type: 'text' } },
        VizFieldFull { ref: r(thelook.fulfilled_orders), format { type: 'number', pattern: 'inherited' } },
        VizFieldFull { ref: r(thelook.net_sales), format { type: 'number', pattern: 'inherited' } },
        VizFieldFull { ref: r(thelook.gross_profit), format { type: 'number', pattern: 'inherited' } },
        VizFieldFull { ref: r(thelook.gross_margin), format { type: 'number', pattern: 'inherited' } },
        VizFieldFull { ref: r(thelook.aov), format { type: 'number', pattern: 'inherited' } },
        VizFieldFull { ref: r(thelook.return_rate), format { type: 'number', pattern: 'inherited' } }
      ]
      settings {
        sorts: [ IndexBasedSortSetting { field_index: 3, direction: 'desc' } ]
        row_limit: 100
        show_row_number: true
      }
    }
  }

  // ---------- Layout: identical grid on every tab ----------
  view: TabLayout {
    label: 'Sales Performance'

    tab overview: CanvasLayout {
      label: 'Overview'
      width: 1280
      height: 1060
      grid_size: 20
      auto_expand_vertically: true
      block header { position: pos(20, 20, 1240, 80) }
      block f_order_date { position: pos(20, 120, 295, 80) }
      block f_country { position: pos(335, 120, 295, 80) }
      block f_department { position: pos(650, 120, 295, 80) }
      block f_category { position: pos(965, 120, 295, 80) }
      block ov_kpi_net_sales { position: pos(20, 220, 295, 120) }
      block ov_kpi_gross_profit { position: pos(335, 220, 295, 120) }
      block ov_kpi_margin { position: pos(650, 220, 295, 120) }
      block ov_kpi_orders { position: pos(965, 220, 295, 120) }
      block ov_trend { position: pos(20, 360, 800, 360) }
      block ov_by_department { position: pos(840, 360, 420, 360) }
      block ov_yearly { position: pos(20, 740, 1240, 300) }
      mobile { mode: 'auto' }
    }

    tab products: CanvasLayout {
      label: 'Products'
      width: 1280
      height: 1060
      grid_size: 20
      auto_expand_vertically: true
      block header { position: pos(20, 20, 1240, 80) }
      block f_order_date { position: pos(20, 120, 295, 80) }
      block f_country { position: pos(335, 120, 295, 80) }
      block f_department { position: pos(650, 120, 295, 80) }
      block f_category { position: pos(965, 120, 295, 80) }
      block pr_kpi_items { position: pos(20, 220, 295, 120) }
      block pr_kpi_net_sales { position: pos(335, 220, 295, 120) }
      block pr_kpi_margin { position: pos(650, 220, 295, 120) }
      block pr_kpi_return_rate { position: pos(965, 220, 295, 120) }
      block pr_by_category { position: pos(20, 360, 800, 360) }
      block pr_top_brands { position: pos(840, 360, 420, 360) }
      block pr_top_products { position: pos(20, 740, 1240, 300) }
      mobile { mode: 'auto' }
    }

    tab customers: CanvasLayout {
      label: 'Customers'
      width: 1280
      height: 1060
      grid_size: 20
      auto_expand_vertically: true
      block header { position: pos(20, 20, 1240, 80) }
      block f_order_date { position: pos(20, 120, 295, 80) }
      block f_country { position: pos(335, 120, 295, 80) }
      block f_department { position: pos(650, 120, 295, 80) }
      block f_category { position: pos(965, 120, 295, 80) }
      block cu_kpi_buyers { position: pos(20, 220, 295, 120) }
      block cu_kpi_sales_per_customer { position: pos(335, 220, 295, 120) }
      block cu_kpi_aov { position: pos(650, 220, 295, 120) }
      block cu_kpi_orders_per_customer { position: pos(965, 220, 295, 120) }
      block cu_by_age_gender { position: pos(20, 360, 800, 360) }
      block cu_by_traffic_source { position: pos(840, 360, 420, 360) }
      block cu_top_customers { position: pos(20, 740, 1240, 300) }
      mobile { mode: 'auto' }
    }

    tab geography: CanvasLayout {
      label: 'Geography'
      width: 1280
      height: 1060
      grid_size: 20
      auto_expand_vertically: true
      block header { position: pos(20, 20, 1240, 80) }
      block f_order_date { position: pos(20, 120, 295, 80) }
      block f_country { position: pos(335, 120, 295, 80) }
      block f_department { position: pos(650, 120, 295, 80) }
      block f_category { position: pos(965, 120, 295, 80) }
      block ge_kpi_net_sales { position: pos(20, 220, 295, 120) }
      block ge_kpi_countries { position: pos(335, 220, 295, 120) }
      block ge_kpi_cities { position: pos(650, 220, 295, 120) }
      block ge_kpi_aov { position: pos(965, 220, 295, 120) }
      block ge_map { position: pos(20, 360, 800, 360) }
      block ge_by_country { position: pos(840, 360, 420, 360) }
      block ge_by_state { position: pos(20, 740, 1240, 300) }
      mobile { mode: 'auto' }
    }
  }

  theme: PageTheme {
    background { bg_color: '#F3F5F9' }
    canvas {
      background { bg_color: '#F3F5F9' }
      border { border_width: 0 }
    }
    block {
      label { font_size: 14, font_weight: 'semibold', font_color: '#1F2937' }
      text { font_color: '#374151' }
      background { bg_color: '#FFFFFF' }
      border { border_width: 1, border_radius: 8, border_color: '#E5E7EB', border_style: 'solid' }
      padding: 12
      shadow: 'sm'
    }
  }
}
