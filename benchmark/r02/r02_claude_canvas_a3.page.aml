Dashboard r02_claude_canvas_a3 {
  title: 'Sales Performance'
  description: 'TheLook sales performance across overview, products, customers and geography. Filters are shared by every tab.'
  owner: 'thinh.nt@holistics.io'

  // ---------------------------------------------------------------------------
  // Shared filters (placed on every tab, so one selection applies everywhere)
  // ---------------------------------------------------------------------------
  block f_order_date: FilterBlock {
    label: 'Order Date'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }
  block f_country: FilterBlock {
    label: 'Country'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.country)
    }
    settings {
      input_type: 'multiple'
    }
  }
  block f_department: FilterBlock {
    label: 'Department'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.department)
    }
    settings {
      input_type: 'multiple'
    }
  }
  block f_category: FilterBlock {
    label: 'Category'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.category)
    }
    settings {
      input_type: 'multiple'
    }
  }

  // ---------------------------------------------------------------------------
  // Tab headers
  // ---------------------------------------------------------------------------
  block h_overview: TextBlock {
    content: @md
      ## Sales Performance · Overview
      Headline sales, profit and order volume. Net figures exclude cancelled and returned items.
    ;;
  }
  block h_products: TextBlock {
    content: @md
      ## Sales Performance · Products
      Which categories, departments, brands and products drive sales and margin.
    ;;
  }
  block h_customers: TextBlock {
    content: @md
      ## Sales Performance · Customers
      Who buys: active customers, spend per customer, acquisition channel and demographics.
    ;;
  }
  block h_geography: TextBlock {
    content: @md
      ## Sales Performance · Geography
      Where sales come from: countries and cities by customer location.
    ;;
  }

  // ---------------------------------------------------------------------------
  // Overview
  // ---------------------------------------------------------------------------
  block ov_kpi_net_sales: VizBlock {
    label: 'Net Sales'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
  }
  block ov_kpi_gross_profit: VizBlock {
    label: 'Gross Profit'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_profit)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
  }
  block ov_kpi_orders: VizBlock {
    label: 'Fulfilled Orders'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
  }
  block ov_kpi_aov: VizBlock {
    label: 'Average Order Value'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
  }
  block ov_sales_trend: VizBlock {
    label: 'Net Sales and Gross Profit by Month'
    viz: LineChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        label: 'Month'
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#2F5BD3'
          }
        }
        series {
          field: VizFieldFull {
            ref: r(thelook.gross_profit)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#16A394'
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
        legend_label: 'top'
        row_limit: 5000
      }
    }
  }
  block ov_status_mix: VizBlock {
    label: 'Gross Sales by Item Status'
    viz: PieChart {
      dataset: thelook
      legend: VizFieldFull {
        ref: r(thelook_order_items.status)
        format {
          type: 'text'
        }
      }
      series {
        field: VizFieldFull {
          ref: r(thelook.gross_sales)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      }
    }
  }
  block ov_sales_by_year: VizBlock {
    label: 'Net Sales by Year'
    viz: ColumnChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        label: 'Year'
        transformation: 'datetrunc year'
        format {
          type: 'date'
          pattern: 'yyyy'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#2F5BD3'
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      tooltips: [
        VizTooltip {
          field: VizFieldFull {
            ref: r(thelook.gross_margin)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      ]
      settings {
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
        legend_label: 'hidden'
      }
    }
  }
  block ov_margin_return_trend: VizBlock {
    label: 'Gross Margin and Return Rate by Month'
    viz: LineChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        label: 'Month'
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.gross_margin)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#2F5BD3'
          }
        }
        series {
          field: VizFieldFull {
            ref: r(thelook.return_rate)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#E0703A'
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
        legend_label: 'top'
        row_limit: 5000
      }
    }
  }

  // ---------------------------------------------------------------------------
  // Products
  // ---------------------------------------------------------------------------
  block pr_kpi_items_sold: VizBlock {
    label: 'Items Sold'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.items_sold)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
  }
  block pr_kpi_net_sales: VizBlock {
    label: 'Net Sales'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
  }
  block pr_kpi_gross_margin: VizBlock {
    label: 'Gross Margin'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
  }
  block pr_kpi_return_rate: VizBlock {
    label: 'Return Rate'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.return_rate)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
  }
  block pr_sales_by_category: VizBlock {
    label: 'Net Sales by Category'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#2F5BD3'
          }
        }
      }
      tooltips: [
        VizTooltip {
          field: VizFieldFull {
            ref: r(thelook.gross_margin)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      ]
      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
        legend_label: 'hidden'
      }
    }
  }
  block pr_sales_by_department: VizBlock {
    label: 'Net Sales by Department'
    viz: PieChart {
      dataset: thelook
      legend: VizFieldFull {
        ref: r(thelook_products.department)
        format {
          type: 'text'
        }
      }
      series {
        field: VizFieldFull {
          ref: r(thelook.net_sales)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      }
    }
  }
  block pr_top_brands: VizBlock {
    label: 'Top 10 Brands by Net Sales'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.brand)
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#2F5BD3'
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
        legend_label: 'hidden'
        row_limit: 10
      }
    }
  }
  block pr_top_products: VizBlock {
    label: 'Top Products'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          ref: r(thelook_products.name)
          label: 'Product'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(thelook_products.category)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(thelook.items_sold)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.gross_margin)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        sorts: [
          IndexBasedSortSetting {
            field_index: 3
            direction: 'desc'
          }
        ]
        row_limit: 50
        pagination_size: 25
        show_row_number: true
      }
    }
  }

  // ---------------------------------------------------------------------------
  // Customers
  // ---------------------------------------------------------------------------
  block cu_kpi_active_customers: VizBlock {
    label: 'Active Customers'
    description: 'Distinct customers with at least one item counted in Net Sales.'
    viz: MetricKpi {
      dataset: thelook
      calculation active_customers {
        label: 'Active Customers'
        formula: @aql thelook_order_items | count_distinct(thelook_order_items.user_id) | where(thelook_order_items.status not in ['Cancelled', 'Returned']) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'active_customers'
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
  }
  block cu_kpi_sales_per_customer: VizBlock {
    label: 'Net Sales per Customer'
    viz: MetricKpi {
      dataset: thelook
      calculation sales_per_customer {
        label: 'Net Sales per Customer'
        formula: @aql safe_divide(net_sales, thelook_order_items | count_distinct(thelook_order_items.user_id) | where(thelook_order_items.status not in ['Cancelled', 'Returned'])) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'sales_per_customer'
        format {
          type: 'number'
          pattern: '[$$]#,###0.00'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
  }
  block cu_kpi_orders_per_customer: VizBlock {
    label: 'Orders per Customer'
    viz: MetricKpi {
      dataset: thelook
      calculation orders_per_customer {
        label: 'Orders per Customer'
        formula: @aql safe_divide(fulfilled_orders, thelook_order_items | count_distinct(thelook_order_items.user_id) | where(thelook_order_items.status not in ['Cancelled', 'Returned'])) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'orders_per_customer'
        format {
          type: 'number'
          pattern: '#,###0.00'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
  }
  block cu_kpi_aov: VizBlock {
    label: 'Average Order Value'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
  }
  block cu_active_trend: VizBlock {
    label: 'Active Customers by Month'
    viz: ColumnChart {
      dataset: thelook
      calculation active_customers {
        label: 'Active Customers'
        formula: @aql thelook_order_items | count_distinct(thelook_order_items.user_id) | where(thelook_order_items.status not in ['Cancelled', 'Returned']) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        label: 'Month'
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: 'active_customers'
            format {
              type: 'number'
              pattern: '#,###0'
            }
          }
          settings {
            color: '#2F5BD3'
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
        legend_label: 'hidden'
        row_limit: 5000
      }
    }
  }
  block cu_sales_by_source: VizBlock {
    label: 'Net Sales by Traffic Source'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.traffic_source)
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#2F5BD3'
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
        legend_label: 'hidden'
      }
    }
  }
  block cu_age_gender: VizBlock {
    label: 'Net Sales by Age Band and Gender'
    viz: ColumnChart {
      dataset: thelook
      calculation age_band {
        label: 'Age Band'
        formula: @aql case(
          when: thelook_users.age < 25, then: '1. Under 25',
          when: thelook_users.age < 35, then: '2. 25-34',
          when: thelook_users.age < 45, then: '3. 35-44',
          when: thelook_users.age < 55, then: '4. 45-54',
          else: '5. 55+'
        ) ;;
        calc_type: 'dimension'
        data_type: 'text'
        model: thelook_users
      }
      x_axis: VizFieldFull {
        ref: 'age_band'
        format {
          type: 'text'
        }
      }
      legend: VizFieldFull {
        ref: r(thelook_users.gender)
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            point {
              value: 'F'
              color: '#E0703A'
            }
            point {
              value: 'M'
              color: '#2F5BD3'
            }
          }
        }
        settings {
          stack_series_by: 'value'
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
        legend_label: 'top'
      }
    }
  }
  block cu_top_customers: VizBlock {
    label: 'Top Customers'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          ref: r(thelook_users.email)
          label: 'Customer'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(thelook_users.country)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(thelook.fulfilled_orders)
          label: 'Orders'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        sorts: [
          IndexBasedSortSetting {
            field_index: 3
            direction: 'desc'
          }
        ]
        row_limit: 50
        pagination_size: 25
        show_row_number: true
      }
    }
  }

  // ---------------------------------------------------------------------------
  // Geography
  // ---------------------------------------------------------------------------
  block ge_kpi_countries: VizBlock {
    label: 'Countries with Sales'
    viz: MetricKpi {
      dataset: thelook
      calculation countries_with_sales {
        label: 'Countries with Sales'
        formula: @aql thelook_order_items | count_distinct(thelook_users.country) | where(thelook_order_items.status not in ['Cancelled', 'Returned']) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'countries_with_sales'
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
  }
  block ge_kpi_cities: VizBlock {
    label: 'Cities with Sales'
    viz: MetricKpi {
      dataset: thelook
      calculation cities_with_sales {
        label: 'Cities with Sales'
        formula: @aql thelook_order_items | count_distinct(thelook_users.city) | where(thelook_order_items.status not in ['Cancelled', 'Returned']) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'cities_with_sales'
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
  }
  block ge_kpi_net_sales: VizBlock {
    label: 'Net Sales'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
  }
  block ge_kpi_active_customers: VizBlock {
    label: 'Active Customers'
    description: 'Distinct customers with at least one item counted in Net Sales.'
    viz: MetricKpi {
      dataset: thelook
      calculation active_customers {
        label: 'Active Customers'
        formula: @aql thelook_order_items | count_distinct(thelook_order_items.user_id) | where(thelook_order_items.status not in ['Cancelled', 'Returned']) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'active_customers'
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
  }
  block ge_sales_map: VizBlock {
    label: 'Net Sales by Country'
    viz: FilledMap {
      dataset: thelook
      location {
        field: VizFieldFull {
          ref: r(thelook_users.country)
          format {
            type: 'text'
          }
        }
        location_type: 'country'
      }
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        color_scale: 'vertical'
        map_background: 'light'
        value_colors {
          min {
            color: '#DCE6FB'
          }
          max {
            color: '#2F5BD3'
          }
        }
      }
    }
  }
  block ge_sales_by_country: VizBlock {
    label: 'Country Ranking'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.country)
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#2F5BD3'
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
        legend_label: 'hidden'
      }
    }
  }
  block ge_top_cities: VizBlock {
    label: 'Top 10 Cities by Net Sales'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.city)
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#2F5BD3'
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
        legend_label: 'hidden'
        row_limit: 10
      }
    }
  }
  block ge_country_table: VizBlock {
    label: 'Country Performance'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          ref: r(thelook_users.country)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(thelook.fulfilled_orders)
          label: 'Orders'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.aov)
          label: 'AOV'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.gross_margin)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        sorts: [
          IndexBasedSortSetting {
            field_index: 2
            direction: 'desc'
          }
        ]
        pagination_size: 25
      }
    }
  }

  // ---------------------------------------------------------------------------
  // Layout: identical grid on every tab
  //   header (y 20) · filter bar (y 100) · 4 KPI tiles (y 190)
  //   row 1: wide chart + narrow chart (y 330) · row 2: two equal panels (y 710)
  // ---------------------------------------------------------------------------
  view: TabLayout {
    label: 'Sales Performance'

    tab overview: CanvasLayout {
      label: 'Overview'
      width: 1280
      height: 1110
      grid_size: 20
      auto_expand_vertically: true
      block h_overview { position: pos(20, 20, 1240, 70) }
      block f_order_date { position: pos(20, 100, 280, 70) }
      block f_country { position: pos(340, 100, 280, 70) }
      block f_department { position: pos(660, 100, 280, 70) }
      block f_category { position: pos(980, 100, 280, 70) }
      block ov_kpi_net_sales { position: pos(20, 190, 280, 120) }
      block ov_kpi_gross_profit { position: pos(340, 190, 280, 120) }
      block ov_kpi_orders { position: pos(660, 190, 280, 120) }
      block ov_kpi_aov { position: pos(980, 190, 280, 120) }
      block ov_sales_trend { position: pos(20, 330, 760, 360) }
      block ov_status_mix { position: pos(800, 330, 460, 360) }
      block ov_sales_by_year { position: pos(20, 710, 610, 380) }
      block ov_margin_return_trend { position: pos(650, 710, 610, 380) }
      mobile {
        mode: 'auto'
      }
    }

    tab products: CanvasLayout {
      label: 'Products'
      width: 1280
      height: 1110
      grid_size: 20
      auto_expand_vertically: true
      block h_products { position: pos(20, 20, 1240, 70) }
      block f_order_date { position: pos(20, 100, 280, 70) }
      block f_country { position: pos(340, 100, 280, 70) }
      block f_department { position: pos(660, 100, 280, 70) }
      block f_category { position: pos(980, 100, 280, 70) }
      block pr_kpi_items_sold { position: pos(20, 190, 280, 120) }
      block pr_kpi_net_sales { position: pos(340, 190, 280, 120) }
      block pr_kpi_gross_margin { position: pos(660, 190, 280, 120) }
      block pr_kpi_return_rate { position: pos(980, 190, 280, 120) }
      block pr_sales_by_category { position: pos(20, 330, 760, 360) }
      block pr_sales_by_department { position: pos(800, 330, 460, 360) }
      block pr_top_brands { position: pos(20, 710, 610, 380) }
      block pr_top_products { position: pos(650, 710, 610, 380) }
      mobile {
        mode: 'auto'
      }
    }

    tab customers: CanvasLayout {
      label: 'Customers'
      width: 1280
      height: 1110
      grid_size: 20
      auto_expand_vertically: true
      block h_customers { position: pos(20, 20, 1240, 70) }
      block f_order_date { position: pos(20, 100, 280, 70) }
      block f_country { position: pos(340, 100, 280, 70) }
      block f_department { position: pos(660, 100, 280, 70) }
      block f_category { position: pos(980, 100, 280, 70) }
      block cu_kpi_active_customers { position: pos(20, 190, 280, 120) }
      block cu_kpi_sales_per_customer { position: pos(340, 190, 280, 120) }
      block cu_kpi_orders_per_customer { position: pos(660, 190, 280, 120) }
      block cu_kpi_aov { position: pos(980, 190, 280, 120) }
      block cu_active_trend { position: pos(20, 330, 760, 360) }
      block cu_sales_by_source { position: pos(800, 330, 460, 360) }
      block cu_age_gender { position: pos(20, 710, 610, 380) }
      block cu_top_customers { position: pos(650, 710, 610, 380) }
      mobile {
        mode: 'auto'
      }
    }

    tab geography: CanvasLayout {
      label: 'Geography'
      width: 1280
      height: 1110
      grid_size: 20
      auto_expand_vertically: true
      block h_geography { position: pos(20, 20, 1240, 70) }
      block f_order_date { position: pos(20, 100, 280, 70) }
      block f_country { position: pos(340, 100, 280, 70) }
      block f_department { position: pos(660, 100, 280, 70) }
      block f_category { position: pos(980, 100, 280, 70) }
      block ge_kpi_countries { position: pos(20, 190, 280, 120) }
      block ge_kpi_cities { position: pos(340, 190, 280, 120) }
      block ge_kpi_net_sales { position: pos(660, 190, 280, 120) }
      block ge_kpi_active_customers { position: pos(980, 190, 280, 120) }
      block ge_sales_map { position: pos(20, 330, 760, 360) }
      block ge_sales_by_country { position: pos(800, 330, 460, 360) }
      block ge_top_cities { position: pos(20, 710, 610, 380) }
      block ge_country_table { position: pos(650, 710, 610, 380) }
      mobile {
        mode: 'auto'
      }
    }
  }

  // One page theme styles every tab the same way
  theme: PageTheme {
    background {
      bg_color: '#F3F5F9'
    }
    canvas {
      background {
        bg_color: '#F3F5F9'
      }
      border {
        border_width: 0
      }
    }
    block {
      label {
        font_size: 14
        font_weight: 'semibold'
        font_color: '#1F2A44'
      }
      text {
        font_color: '#1F2A44'
      }
      background {
        bg_color: '#FFFFFF'
      }
      border {
        border_width: 1
        border_radius: 8
        border_color: '#E1E6EF'
        border_style: 'solid'
      }
      padding: 12
      shadow: 'sm'
    }
  }
}
