Dashboard r02_claude_fd_canvas_a2 {
  title: 'Sales Performance'
  description: 'TheLook eCommerce sales performance across overview, products, customers and geography. Net figures exclude Cancelled and Returned items.'

  // ---------------------------------------------------------------------------
  // Shared header + filters (placed on every tab so they apply across tabs)
  // ---------------------------------------------------------------------------
  block header: TextBlock {
    content: @md
## Sales Performance
TheLook eCommerce · Net figures exclude Cancelled and Returned items · Filters apply to every tab
    ;;
    theme: BlockTheme {
      background: BgTheme { bg_color: '#1B2A41' }
      text: FontTheme { font_color: '#F4F6F8' }
      border: BorderTheme { border_width: 0, border_radius: 10 }
      padding: 16
      shadow: 'none'
    }
  }

  block f_date: FilterBlock {
    label: 'Order Date'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block f_country: FilterBlock {
    label: 'Customer Country'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.country)
    }
    settings {
      input_type: 'multiple'
    }
  }

  block f_category: FilterBlock {
    label: 'Product Category'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.category)
    }
    settings {
      input_type: 'multiple'
    }
  }

  block f_department: FilterBlock {
    label: 'Department'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.department)
    }
    settings {
      input_type: 'multiple'
    }
  }

  // ---------------------------------------------------------------------------
  // Overview
  // ---------------------------------------------------------------------------
  block ov_kpi_net_sales: VizBlock {
    label: 'Net Sales'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        format { type: 'number', pattern: 'inherited' }
      }
      settings { display_mode: 'single', alignment: 'left' }
    }
  }

  block ov_kpi_gross_profit: VizBlock {
    label: 'Gross Profit'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_profit)
        format { type: 'number', pattern: 'inherited' }
      }
      settings { display_mode: 'single', alignment: 'left' }
    }
  }

  block ov_kpi_margin: VizBlock {
    label: 'Gross Margin'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        format { type: 'number', pattern: 'inherited' }
      }
      settings { display_mode: 'single', alignment: 'left' }
    }
  }

  block ov_kpi_aov: VizBlock {
    label: 'Average Order Value'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        format { type: 'number', pattern: 'inherited' }
      }
      settings { display_mode: 'single', alignment: 'left' }
    }
  }

  block ov_trend: VizBlock {
    label: 'Net Sales and Gross Profit by Month'
    viz: LineChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        label: 'Month'
        format { type: 'date', pattern: 'LLL yyyy' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format { type: 'number', pattern: 'inherited' }
          }
          settings { color: '#1F4E79' }
        }
        series {
          field: VizFieldFull {
            ref: r(thelook.gross_profit)
            label: 'Gross Profit'
            format { type: 'number', pattern: 'inherited' }
          }
          settings { color: '#2A9D8F' }
        }
      }
      settings {
        legend_label: 'bottom'
        show_data_points: false
        sort: LineFamilySort { type: 'xaxis', direction: 'asc' }
      }
    }
  }

  block ov_status: VizBlock {
    label: 'Order Items by Status'
    viz: BarChart {
      dataset: thelook
      calculation item_count {
        label: 'Order Items'
        formula: @aql count(thelook_order_items.id) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.status)
        label: 'Status'
        format { type: 'text' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: 'item_count'
            label: 'Order Items'
            format { type: 'number', pattern: '#,###0' }
          }
          settings { color: '#1F4E79' }
        }
      }
      settings {
        legend_label: 'hidden'
        sort: LineFamilySort { type: 'yaxis', direction: 'desc' }
      }
    }
  }

  block ov_orders: VizBlock {
    label: 'Fulfilled Orders by Month'
    viz: ColumnChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        label: 'Month'
        format { type: 'date', pattern: 'LLL yyyy' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.fulfilled_orders)
            label: 'Fulfilled Orders'
            format { type: 'number', pattern: 'inherited' }
          }
          settings { color: '#1F4E79' }
        }
      }
      settings {
        legend_label: 'hidden'
        sort: LineFamilySort { type: 'xaxis', direction: 'asc' }
      }
    }
  }

  block ov_return_rate: VizBlock {
    label: 'Return Rate by Month'
    viz: LineChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        label: 'Month'
        format { type: 'date', pattern: 'LLL yyyy' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.return_rate)
            label: 'Return Rate'
            format { type: 'number', pattern: 'inherited' }
          }
          settings { color: '#D97706' }
        }
      }
      settings {
        legend_label: 'hidden'
        show_data_points: false
        sort: LineFamilySort { type: 'xaxis', direction: 'asc' }
      }
    }
  }

  // ---------------------------------------------------------------------------
  // Products
  // ---------------------------------------------------------------------------
  block pr_kpi_items: VizBlock {
    label: 'Items Sold'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.items_sold)
        format { type: 'number', pattern: 'inherited' }
      }
      settings { display_mode: 'single', alignment: 'left' }
    }
  }

  block pr_kpi_cogs: VizBlock {
    label: 'COGS'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.cogs)
        format { type: 'number', pattern: 'inherited' }
      }
      settings { display_mode: 'single', alignment: 'left' }
    }
  }

  block pr_kpi_margin: VizBlock {
    label: 'Gross Margin'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        format { type: 'number', pattern: 'inherited' }
      }
      settings { display_mode: 'single', alignment: 'left' }
    }
  }

  block pr_kpi_return: VizBlock {
    label: 'Return Rate'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.return_rate)
        format { type: 'number', pattern: 'inherited' }
      }
      settings { display_mode: 'single', alignment: 'left' }
    }
  }

  block pr_by_category: VizBlock {
    label: 'Net Sales by Category'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Category'
        format { type: 'text' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format { type: 'number', pattern: 'inherited' }
          }
          settings { color: '#1F4E79' }
        }
      }
      settings {
        legend_label: 'hidden'
        row_limit: 15
        sort: LineFamilySort { type: 'yaxis', direction: 'desc' }
      }
    }
  }

  block pr_by_department: VizBlock {
    label: 'Net Sales by Department'
    viz: PieChart {
      dataset: thelook
      legend: VizFieldFull {
        ref: r(thelook_products.department)
        label: 'Department'
        format { type: 'text' }
      }
      series {
        field: VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format { type: 'number', pattern: 'inherited' }
        }
        settings {
          point { value: 'Women', color: '#1F4E79' }
          point { value: 'Men', color: '#2A9D8F' }
        }
      }
      settings {
        display_as_donut: true
        legend_label: 'bottom'
        show_percentage: true
      }
    }
  }

  block pr_top_products: VizBlock {
    label: 'Top Products by Net Sales'
    viz: DataTable {
      dataset: thelook
      filter {
        field: r(thelook.net_sales)
        operator: 'greater_than'
        value: 0
      }
      fields: [
        VizFieldFull { ref: r(thelook_products.name), label: 'Product', format { type: 'text' } },
        VizFieldFull { ref: r(thelook_products.brand), label: 'Brand', format { type: 'text' } },
        VizFieldFull { ref: r(thelook_products.category), label: 'Category', format { type: 'text' } },
        VizFieldFull { ref: r(thelook.net_sales), label: 'Net Sales', format { type: 'number', pattern: 'inherited' } },
        VizFieldFull { ref: r(thelook.items_sold), label: 'Items Sold', format { type: 'number', pattern: 'inherited' } },
        VizFieldFull { ref: r(thelook.gross_margin), label: 'Gross Margin', format { type: 'number', pattern: 'inherited' } },
        VizFieldFull { ref: r(thelook.return_rate), label: 'Return Rate', format { type: 'number', pattern: 'inherited' } }
      ]
      settings {
        show_row_number: true
        pagination_size: 10
        row_limit: 100
        sorts: [IndexBasedSortSetting { field_index: 3, direction: 'desc' }]
      }
    }
  }

  // ---------------------------------------------------------------------------
  // Customers
  // ---------------------------------------------------------------------------
  block cu_kpi_active: VizBlock {
    label: 'Active Customers'
    viz: MetricKpi {
      dataset: thelook
      calculation active_customers {
        label: 'Active Customers'
        formula: @aql count_distinct(thelook_order_items.user_id) | where(thelook_order_items.status not in ['Cancelled', 'Returned']) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'active_customers'
        format { type: 'number', pattern: '#,###0' }
      }
      settings { display_mode: 'single', alignment: 'left' }
    }
  }

  block cu_kpi_sales_per_customer: VizBlock {
    label: 'Net Sales per Customer'
    viz: MetricKpi {
      dataset: thelook
      calculation sales_per_customer {
        label: 'Net Sales per Customer'
        formula: @aql safe_divide(net_sales, count_distinct(thelook_order_items.user_id) | where(thelook_order_items.status not in ['Cancelled', 'Returned'])) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'sales_per_customer'
        format { type: 'number', pattern: '[$$]#,###0.00' }
      }
      settings { display_mode: 'single', alignment: 'left' }
    }
  }

  block cu_kpi_orders_per_customer: VizBlock {
    label: 'Orders per Customer'
    viz: MetricKpi {
      dataset: thelook
      calculation orders_per_customer {
        label: 'Orders per Customer'
        formula: @aql safe_divide(fulfilled_orders, count_distinct(thelook_order_items.user_id) | where(thelook_order_items.status not in ['Cancelled', 'Returned'])) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'orders_per_customer'
        format { type: 'number', pattern: '#,###0.00' }
      }
      settings { display_mode: 'single', alignment: 'left' }
    }
  }

  block cu_kpi_aov: VizBlock {
    label: 'Average Order Value'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        format { type: 'number', pattern: 'inherited' }
      }
      settings { display_mode: 'single', alignment: 'left' }
    }
  }

  block cu_active_trend: VizBlock {
    label: 'Active Customers by Month'
    viz: LineChart {
      dataset: thelook
      calculation active_customers {
        label: 'Active Customers'
        formula: @aql count_distinct(thelook_order_items.user_id) | where(thelook_order_items.status not in ['Cancelled', 'Returned']) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        label: 'Month'
        format { type: 'date', pattern: 'LLL yyyy' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: 'active_customers'
            label: 'Active Customers'
            format { type: 'number', pattern: '#,###0' }
          }
          settings { color: '#1F4E79' }
        }
      }
      settings {
        legend_label: 'hidden'
        show_data_points: false
        sort: LineFamilySort { type: 'xaxis', direction: 'asc' }
      }
    }
  }

  block cu_by_source: VizBlock {
    label: 'Net Sales by Acquisition Source'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.traffic_source)
        label: 'Traffic Source'
        format { type: 'text' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format { type: 'number', pattern: 'inherited' }
          }
          settings { color: '#2A9D8F' }
        }
      }
      settings {
        legend_label: 'hidden'
        sort: LineFamilySort { type: 'yaxis', direction: 'desc' }
      }
    }
  }

  block cu_by_age_gender: VizBlock {
    label: 'Net Sales by Age Band and Gender'
    viz: ColumnChart {
      dataset: thelook
      calculation age_band {
        label: 'Age Band'
        formula: @aql case(
          when: thelook_users.age < 25, then: '1. Under 25',
          when: thelook_users.age < 35, then: '2. 25-34',
          when: thelook_users.age < 50, then: '3. 35-49',
          else: '4. 50+'
        ) ;;
        calc_type: 'dimension'
        data_type: 'text'
        model: thelook_users
      }
      x_axis: VizFieldFull {
        ref: 'age_band'
        label: 'Age Band'
        format { type: 'text' }
      }
      legend: VizFieldFull {
        ref: r(thelook_users.gender)
        label: 'Gender'
        format { type: 'text' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format { type: 'number', pattern: 'inherited' }
          }
          settings {
            point { value: 'F', color: '#1F4E79' }
            point { value: 'M', color: '#2A9D8F' }
          }
        }
      }
      settings {
        legend_label: 'bottom'
        sort: LineFamilySort { type: 'xaxis', direction: 'asc' }
      }
    }
  }

  block cu_top_customers: VizBlock {
    label: 'Top Customers by Net Sales'
    viz: DataTable {
      dataset: thelook
      calculation customer_name {
        label: 'Customer'
        formula: @aql concat(thelook_users.first_name, ' ', thelook_users.last_name) ;;
        calc_type: 'dimension'
        data_type: 'text'
        model: thelook_users
      }
      filter {
        field: r(thelook.net_sales)
        operator: 'greater_than'
        value: 0
      }
      fields: [
        VizFieldFull { ref: 'customer_name', label: 'Customer', format { type: 'text' } },
        VizFieldFull { ref: r(thelook_users.country), label: 'Country', format { type: 'text' } },
        VizFieldFull { ref: r(thelook.net_sales), label: 'Net Sales', format { type: 'number', pattern: 'inherited' } },
        VizFieldFull { ref: r(thelook.fulfilled_orders), label: 'Orders', format { type: 'number', pattern: 'inherited' } }
      ]
      settings {
        show_row_number: true
        pagination_size: 10
        row_limit: 100
        sorts: [IndexBasedSortSetting { field_index: 2, direction: 'desc' }]
      }
    }
  }

  // ---------------------------------------------------------------------------
  // Geography
  // ---------------------------------------------------------------------------
  block ge_kpi_countries: VizBlock {
    label: 'Countries with Sales'
    viz: MetricKpi {
      dataset: thelook
      calculation countries {
        label: 'Countries with Sales'
        formula: @aql thelook_order_items | count_distinct(thelook_users.country) | where(thelook_order_items.status not in ['Cancelled', 'Returned']) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'countries'
        format { type: 'number', pattern: '#,###0' }
      }
      settings { display_mode: 'single', alignment: 'left' }
    }
  }

  block ge_kpi_cities: VizBlock {
    label: 'Cities with Sales'
    viz: MetricKpi {
      dataset: thelook
      calculation cities {
        label: 'Cities with Sales'
        formula: @aql thelook_order_items | count_distinct(thelook_users.city) | where(thelook_order_items.status not in ['Cancelled', 'Returned']) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'cities'
        format { type: 'number', pattern: '#,###0' }
      }
      settings { display_mode: 'single', alignment: 'left' }
    }
  }

  block ge_kpi_net_sales: VizBlock {
    label: 'Net Sales'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        format { type: 'number', pattern: 'inherited' }
      }
      settings { display_mode: 'single', alignment: 'left' }
    }
  }

  block ge_kpi_orders: VizBlock {
    label: 'Fulfilled Orders'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        format { type: 'number', pattern: 'inherited' }
      }
      settings { display_mode: 'single', alignment: 'left' }
    }
  }

  block ge_map: VizBlock {
    label: 'Net Sales by Customer Country'
    viz: FilledMap {
      dataset: thelook
      location {
        field: VizFieldFull {
          ref: r(thelook_users.country)
          label: 'Country'
        }
        location_type: 'country'
        primary_field: true
      }
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format { type: 'number', pattern: 'inherited' }
      }
      settings {
        color_scale: 'vertical'
        map_background: 'light'
        value_colors {
          min { color: '#DCE8F2' }
          max { color: '#1F4E79' }
        }
      }
    }
  }

  block ge_by_country: VizBlock {
    label: 'Net Sales by Country'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.country)
        label: 'Country'
        format { type: 'text' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format { type: 'number', pattern: 'inherited' }
          }
          settings { color: '#1F4E79' }
        }
      }
      settings {
        legend_label: 'hidden'
        sort: LineFamilySort { type: 'yaxis', direction: 'desc' }
      }
    }
  }

  block ge_top_states: VizBlock {
    label: 'Top States / Regions'
    viz: DataTable {
      dataset: thelook
      filter {
        field: r(thelook.net_sales)
        operator: 'greater_than'
        value: 0
      }
      fields: [
        VizFieldFull { ref: r(thelook_users.country), label: 'Country', format { type: 'text' } },
        VizFieldFull { ref: r(thelook_users.state), label: 'State / Region', format { type: 'text' } },
        VizFieldFull { ref: r(thelook.net_sales), label: 'Net Sales', format { type: 'number', pattern: 'inherited' } },
        VizFieldFull { ref: r(thelook.fulfilled_orders), label: 'Orders', format { type: 'number', pattern: 'inherited' } },
        VizFieldFull { ref: r(thelook.aov), label: 'AOV', format { type: 'number', pattern: 'inherited' } }
      ]
      settings {
        show_row_number: true
        pagination_size: 10
        row_limit: 200
        sorts: [IndexBasedSortSetting { field_index: 2, direction: 'desc' }]
      }
    }
  }

  block ge_by_dc: VizBlock {
    label: 'Net Sales by Distribution Center'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_distribution_centers.name)
        label: 'Distribution Center'
        format { type: 'text' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format { type: 'number', pattern: 'inherited' }
          }
          settings { color: '#2A9D8F' }
        }
      }
      settings {
        legend_label: 'hidden'
        sort: LineFamilySort { type: 'yaxis', direction: 'desc' }
      }
    }
  }

  // ---------------------------------------------------------------------------
  // Layout: identical canvas, header, filter bar and KPI row on every tab
  // ---------------------------------------------------------------------------
  view: TabLayout {
    label: 'Sales Performance'

    tab overview: CanvasLayout {
      label: 'Overview'
      width: 1300
      height: 1140
      grid_size: 20
      auto_expand_vertically: true
      block header { position: pos(20, 20, 1260, 80) }
      block f_date { position: pos(20, 120, 300, 60) }
      block f_country { position: pos(340, 120, 300, 60) }
      block f_category { position: pos(660, 120, 300, 60) }
      block f_department { position: pos(980, 120, 300, 60) }
      block ov_kpi_net_sales { position: pos(20, 200, 300, 120) }
      block ov_kpi_gross_profit { position: pos(340, 200, 300, 120) }
      block ov_kpi_margin { position: pos(660, 200, 300, 120) }
      block ov_kpi_aov { position: pos(980, 200, 300, 120) }
      block ov_trend { position: pos(20, 340, 800, 380) }
      block ov_status { position: pos(840, 340, 440, 380) }
      block ov_orders { position: pos(20, 740, 620, 380) }
      block ov_return_rate { position: pos(660, 740, 620, 380) }
      mobile { mode: 'auto' }
    }

    tab products: CanvasLayout {
      label: 'Products'
      width: 1300
      height: 1140
      grid_size: 20
      auto_expand_vertically: true
      block header { position: pos(20, 20, 1260, 80) }
      block f_date { position: pos(20, 120, 300, 60) }
      block f_country { position: pos(340, 120, 300, 60) }
      block f_category { position: pos(660, 120, 300, 60) }
      block f_department { position: pos(980, 120, 300, 60) }
      block pr_kpi_items { position: pos(20, 200, 300, 120) }
      block pr_kpi_cogs { position: pos(340, 200, 300, 120) }
      block pr_kpi_margin { position: pos(660, 200, 300, 120) }
      block pr_kpi_return { position: pos(980, 200, 300, 120) }
      block pr_by_category { position: pos(20, 340, 800, 380) }
      block pr_by_department { position: pos(840, 340, 440, 380) }
      block pr_top_products { position: pos(20, 740, 1260, 380) }
      mobile { mode: 'auto' }
    }

    tab customers: CanvasLayout {
      label: 'Customers'
      width: 1300
      height: 1140
      grid_size: 20
      auto_expand_vertically: true
      block header { position: pos(20, 20, 1260, 80) }
      block f_date { position: pos(20, 120, 300, 60) }
      block f_country { position: pos(340, 120, 300, 60) }
      block f_category { position: pos(660, 120, 300, 60) }
      block f_department { position: pos(980, 120, 300, 60) }
      block cu_kpi_active { position: pos(20, 200, 300, 120) }
      block cu_kpi_sales_per_customer { position: pos(340, 200, 300, 120) }
      block cu_kpi_orders_per_customer { position: pos(660, 200, 300, 120) }
      block cu_kpi_aov { position: pos(980, 200, 300, 120) }
      block cu_active_trend { position: pos(20, 340, 800, 380) }
      block cu_by_source { position: pos(840, 340, 440, 380) }
      block cu_by_age_gender { position: pos(20, 740, 620, 380) }
      block cu_top_customers { position: pos(660, 740, 620, 380) }
      mobile { mode: 'auto' }
    }

    tab geography: CanvasLayout {
      label: 'Geography'
      width: 1300
      height: 1140
      grid_size: 20
      auto_expand_vertically: true
      block header { position: pos(20, 20, 1260, 80) }
      block f_date { position: pos(20, 120, 300, 60) }
      block f_country { position: pos(340, 120, 300, 60) }
      block f_category { position: pos(660, 120, 300, 60) }
      block f_department { position: pos(980, 120, 300, 60) }
      block ge_kpi_countries { position: pos(20, 200, 300, 120) }
      block ge_kpi_cities { position: pos(340, 200, 300, 120) }
      block ge_kpi_net_sales { position: pos(660, 200, 300, 120) }
      block ge_kpi_orders { position: pos(980, 200, 300, 120) }
      block ge_map { position: pos(20, 340, 800, 380) }
      block ge_by_country { position: pos(840, 340, 440, 380) }
      block ge_top_states { position: pos(20, 740, 620, 380) }
      block ge_by_dc { position: pos(660, 740, 620, 380) }
      mobile { mode: 'auto' }
    }
  }

  // One page theme shared by all tabs
  theme: PageTheme {
    background: BgTheme { bg_color: '#EEF1F5' }
    canvas: CanvasTheme {
      background: BgTheme { bg_color: '#EEF1F5' }
      border: BorderTheme { border_width: 0 }
      shadow: 'none'
    }
    block: BlockTheme {
      label: FontTheme { font_color: '#1B2A41', font_weight: 'semibold', font_size: 14 }
      text: FontTheme { font_color: '#334155' }
      background: BgTheme { bg_color: '#FFFFFF' }
      border: BorderTheme { border_width: 1, border_color: '#DDE3EA', border_radius: 10, border_style: 'solid' }
      padding: 12
      shadow: 'sm'
    }
    viz: VizTheme {
      table: TableTheme {
        header: TableHeaderTheme { bg_color: '#1B2A41', font_color: '#FFFFFF', font_weight: 'semibold' }
        general: TableGeneralTheme { banding_color: '#F6F8FA', hover_color: '#E8EEF5' }
      }
    }
  }
}
