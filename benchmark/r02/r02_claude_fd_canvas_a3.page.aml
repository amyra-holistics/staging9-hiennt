Dashboard r02_claude_fd_canvas_a3 {
  title: 'Sales Performance'
  description: 'TheLook sales performance across overview, products, customers and geography. Filters are shared by every tab.'
  owner: 'thinh.nt@holistics.io'

  // ---------------------------------------------------------------
  // Shared filters (placed on every tab, so a selection carries across tabs)
  // ---------------------------------------------------------------
  block f_date: FilterBlock {
    label: 'Order Date'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
    default {
      operator: 'matches'
      value: 'last 12 months'
    }
  }
  block f_department: FilterBlock {
    label: 'Department'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.department)
    }
    settings {
      input_type: 'multiple'
    }
  }
  block f_category: FilterBlock {
    label: 'Category'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.category)
    }
    settings {
      input_type: 'multiple'
    }
  }
  block f_country: FilterBlock {
    label: 'Customer Country'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.country)
    }
    settings {
      input_type: 'multiple'
    }
  }

  // ---------------------------------------------------------------
  // Tab headers
  // ---------------------------------------------------------------
  block h_overview: TextBlock {
    content: @md
## Sales Performance · Overview
Net sales, profit and order trends for the selected period. KPI changes compare with the same period last year.
;;
    theme: BlockTheme {
      background { bg_color: '#16243D' }
      text { font_color: '#FFFFFF' }
      border { border_width: 0 border_radius: 10 }
    }
  }
  block h_products: TextBlock {
    content: @md
## Sales Performance · Products
What sells, what earns margin and what comes back. KPI changes compare with the same period last year.
;;
    theme: BlockTheme {
      background { bg_color: '#16243D' }
      text { font_color: '#FFFFFF' }
      border { border_width: 0 border_radius: 10 }
    }
  }
  block h_customers: TextBlock {
    content: @md
## Sales Performance · Customers
Who buys, how often and how much. KPI changes compare with the same period last year.
;;
    theme: BlockTheme {
      background { bg_color: '#16243D' }
      text { font_color: '#FFFFFF' }
      border { border_width: 0 border_radius: 10 }
    }
  }
  block h_geography: TextBlock {
    content: @md
## Sales Performance · Geography
Where sales come from, by customer country and city, and which distribution centers ship them. KPI changes compare with the same period last year.
;;
    theme: BlockTheme {
      background { bg_color: '#16243D' }
      text { font_color: '#FFFFFF' }
      border { border_width: 0 border_radius: 10 }
    }
  }

  // ---------------------------------------------------------------
  // Overview
  // ---------------------------------------------------------------
  block ov_kpi_sales: VizBlock {
    label: 'Net Sales'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format { type: 'number' pattern: 'inherited' }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value: RelativePopValue { duration: 1 granularity: 'year' }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        label { font_size: 13 font_color: '#5B6472' }
        metric_value { font_size: 30 font_color: '#16243D' }
      }
    }
  }
  block ov_kpi_profit: VizBlock {
    label: 'Gross Profit'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_profit)
        label: 'Gross Profit'
        format { type: 'number' pattern: 'inherited' }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value: RelativePopValue { duration: 1 granularity: 'year' }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        label { font_size: 13 font_color: '#5B6472' }
        metric_value { font_size: 30 font_color: '#16243D' }
      }
    }
  }
  block ov_kpi_margin: VizBlock {
    label: 'Gross Margin'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format { type: 'number' pattern: 'inherited' }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value: RelativePopValue { duration: 1 granularity: 'year' }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        label { font_size: 13 font_color: '#5B6472' }
        metric_value { font_size: 30 font_color: '#16243D' }
      }
    }
  }
  block ov_kpi_orders: VizBlock {
    label: 'Fulfilled Orders'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        label: 'Fulfilled Orders'
        format { type: 'number' pattern: 'inherited' }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value: RelativePopValue { duration: 1 granularity: 'year' }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        label { font_size: 13 font_color: '#5B6472' }
        metric_value { font_size: 30 font_color: '#16243D' }
      }
    }
  }
  block ov_trend: VizBlock {
    label: 'Monthly Net Sales and Gross Profit'
    viz: LineChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        label: 'Month'
        transformation: 'datetrunc month'
        format { type: 'date' pattern: 'LLL yyyy' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format { type: 'number' pattern: 'inherited' }
          }
          settings { color: '#2A5BD7' }
        }
        series {
          field: VizFieldFull {
            ref: r(thelook.gross_profit)
            label: 'Gross Profit'
            format { type: 'number' pattern: 'inherited' }
          }
          settings { color: '#14A38B' }
        }
      }
      settings {
        legend_label: 'top'
        show_data_points: false
        sort: LineFamilySort { type: 'xaxis' direction: 'asc' }
      }
    }
  }
  block ov_department: VizBlock {
    label: 'Net Sales by Department'
    viz: PieChart {
      dataset: thelook
      legend: VizFieldFull {
        ref: r(thelook_products.department)
        label: 'Department'
        format { type: 'text' }
      }
      series {
        field: VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format { type: 'number' pattern: 'inherited' }
        }
        settings {
          point { value: 'Women' color: '#2A5BD7' }
          point { value: 'Men' color: '#14A38B' }
        }
      }
      settings {
        display_as_donut: true
        show_total: true
        show_percentage: true
        legend_label: 'bottom'
      }
    }
  }
  block ov_status: VizBlock {
    label: 'Gross Sales by Item Status'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.status)
        label: 'Item Status'
        format { type: 'text' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.gross_sales)
            label: 'Gross Sales'
            format { type: 'number' pattern: 'inherited' }
          }
          settings { color: '#2A5BD7' }
        }
      }
      settings {
        legend_label: 'hidden'
        sort: LineFamilySort { type: 'yaxis' direction: 'desc' }
      }
    }
  }
  block ov_aov: VizBlock {
    label: 'Monthly Average Order Value'
    viz: LineChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        label: 'Month'
        transformation: 'datetrunc month'
        format { type: 'date' pattern: 'LLL yyyy' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.aov)
            label: 'Average Order Value'
            format { type: 'number' pattern: 'inherited' }
          }
          settings { color: '#2A5BD7' }
        }
      }
      settings {
        legend_label: 'hidden'
        show_data_points: false
        sort: LineFamilySort { type: 'xaxis' direction: 'asc' }
      }
    }
  }

  // ---------------------------------------------------------------
  // Products
  // ---------------------------------------------------------------
  block pr_kpi_items: VizBlock {
    label: 'Items Sold'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.items_sold)
        label: 'Items Sold'
        format { type: 'number' pattern: 'inherited' }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value: RelativePopValue { duration: 1 granularity: 'year' }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        label { font_size: 13 font_color: '#5B6472' }
        metric_value { font_size: 30 font_color: '#16243D' }
      }
    }
  }
  block pr_kpi_cogs: VizBlock {
    label: 'COGS'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.cogs)
        label: 'COGS'
        format { type: 'number' pattern: 'inherited' }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value: RelativePopValue { duration: 1 granularity: 'year' }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        label { font_size: 13 font_color: '#5B6472' }
        metric_value { font_size: 30 font_color: '#16243D' }
        compare_value { reverse_color: true }
      }
    }
  }
  block pr_kpi_margin: VizBlock {
    label: 'Gross Margin'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format { type: 'number' pattern: 'inherited' }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value: RelativePopValue { duration: 1 granularity: 'year' }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        label { font_size: 13 font_color: '#5B6472' }
        metric_value { font_size: 30 font_color: '#16243D' }
      }
    }
  }
  block pr_kpi_returns: VizBlock {
    label: 'Return Rate'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.return_rate)
        label: 'Return Rate'
        format { type: 'number' pattern: 'inherited' }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value: RelativePopValue { duration: 1 granularity: 'year' }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        label { font_size: 13 font_color: '#5B6472' }
        metric_value { font_size: 30 font_color: '#16243D' }
        compare_value { reverse_color: true }
      }
    }
  }
  block pr_category: VizBlock {
    label: 'Net Sales by Category'
    viz: ColumnChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Category'
        format { type: 'text' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format { type: 'number' pattern: 'inherited' }
          }
          settings { color: '#2A5BD7' }
        }
      }
      settings {
        legend_label: 'hidden'
        sort: LineFamilySort { type: 'yaxis' direction: 'desc' }
      }
    }
  }
  block pr_brands: VizBlock {
    label: 'Top 10 Brands by Net Sales'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.brand)
        label: 'Brand'
        format { type: 'text' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format { type: 'number' pattern: 'inherited' }
          }
          settings { color: '#2A5BD7' }
        }
      }
      settings {
        legend_label: 'hidden'
        row_limit: 10
        sort: LineFamilySort { type: 'yaxis' direction: 'desc' }
      }
    }
  }
  block pr_top_products: VizBlock {
    label: 'Top 10 Products by Net Sales'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          ref: r(thelook_products.name)
          label: 'Product'
        },
        VizFieldFull {
          ref: r(thelook_products.brand)
          label: 'Brand'
        },
        VizFieldFull {
          ref: r(thelook_products.category)
          label: 'Category'
        },
        VizFieldFull {
          ref: r(thelook.items_sold)
          label: 'Items Sold'
          format { type: 'number' pattern: 'inherited' }
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format { type: 'number' pattern: 'inherited' }
        },
        VizFieldFull {
          ref: r(thelook.gross_margin)
          label: 'Gross Margin'
          format { type: 'number' pattern: 'inherited' }
        }
      ]
      settings {
        row_limit: 10
        pagination_size: 10
        show_row_number: true
        sorts: [
          IndexBasedSortSetting {
            field_index: 4
            direction: 'desc'
          }
        ]
      }
    }
  }
  block pr_margin_category: VizBlock {
    label: 'Gross Margin by Category'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Category'
        format { type: 'text' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.gross_margin)
            label: 'Gross Margin'
            format { type: 'number' pattern: 'inherited' }
          }
          settings { color: '#14A38B' }
        }
      }
      settings {
        legend_label: 'hidden'
        sort: LineFamilySort { type: 'yaxis' direction: 'desc' }
      }
    }
  }

  // ---------------------------------------------------------------
  // Customers
  // ---------------------------------------------------------------
  block cu_kpi_buyers: VizBlock {
    label: 'Buying Customers'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      calculation buyers {
        label: 'Buying Customers'
        formula: @aql thelook_order_items | count_distinct(thelook_orders.user_id) | where(thelook_order_items.status not in ['Cancelled', 'Returned']) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'buyers'
        label: 'Buying Customers'
        format { type: 'number' pattern: '#,###0' }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value: RelativePopValue { duration: 1 granularity: 'year' }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        label { font_size: 13 font_color: '#5B6472' }
        metric_value { font_size: 30 font_color: '#16243D' }
      }
    }
  }
  block cu_kpi_sales_per_buyer: VizBlock {
    label: 'Net Sales per Customer'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      calculation sales_per_buyer {
        label: 'Net Sales per Customer'
        formula: @aql safe_divide(net_sales, thelook_order_items | count_distinct(thelook_orders.user_id) | where(thelook_order_items.status not in ['Cancelled', 'Returned'])) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'sales_per_buyer'
        label: 'Net Sales per Customer'
        format { type: 'number' pattern: '[$$]#,###0.00' }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value: RelativePopValue { duration: 1 granularity: 'year' }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        label { font_size: 13 font_color: '#5B6472' }
        metric_value { font_size: 30 font_color: '#16243D' }
      }
    }
  }
  block cu_kpi_orders_per_buyer: VizBlock {
    label: 'Orders per Customer'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      calculation orders_per_buyer {
        label: 'Orders per Customer'
        formula: @aql safe_divide(fulfilled_orders, thelook_order_items | count_distinct(thelook_orders.user_id) | where(thelook_order_items.status not in ['Cancelled', 'Returned'])) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'orders_per_buyer'
        label: 'Orders per Customer'
        format { type: 'number' pattern: '#,###0.00' }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value: RelativePopValue { duration: 1 granularity: 'year' }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        label { font_size: 13 font_color: '#5B6472' }
        metric_value { font_size: 30 font_color: '#16243D' }
      }
    }
  }
  block cu_kpi_aov: VizBlock {
    label: 'Average Order Value'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'
        format { type: 'number' pattern: 'inherited' }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value: RelativePopValue { duration: 1 granularity: 'year' }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        label { font_size: 13 font_color: '#5B6472' }
        metric_value { font_size: 30 font_color: '#16243D' }
      }
    }
  }
  block cu_age_gender: VizBlock {
    label: 'Net Sales by Age Band and Gender'
    viz: ColumnChart {
      dataset: thelook
      calculation age_band {
        label: 'Age Band'
        formula: @aql case(when: thelook_users.age < 25, then: '12-24', when: thelook_users.age < 35, then: '25-34', when: thelook_users.age < 45, then: '35-44', when: thelook_users.age < 55, then: '45-54', else: '55+') ;;
        calc_type: 'dimension'
        data_type: 'text'
        model: thelook_users
      }
      x_axis: VizFieldFull {
        ref: ref('thelook_users', 'age_band')
        label: 'Age Band'
        format { type: 'text' }
      }
      legend: VizFieldFull {
        ref: r(thelook_users.gender)
        label: 'Gender'
        format { type: 'text' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format { type: 'number' pattern: 'inherited' }
          }
          settings {
            point { value: 'F' color: '#2A5BD7' }
            point { value: 'M' color: '#14A38B' }
          }
        }
      }
      settings {
        legend_label: 'top'
        sort: LineFamilySort { type: 'xaxis' direction: 'asc' }
      }
    }
  }
  block cu_traffic: VizBlock {
    label: 'Net Sales by Traffic Source'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.traffic_source)
        label: 'Traffic Source'
        format { type: 'text' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format { type: 'number' pattern: 'inherited' }
          }
          settings { color: '#2A5BD7' }
        }
      }
      settings {
        legend_label: 'hidden'
        sort: LineFamilySort { type: 'yaxis' direction: 'desc' }
      }
    }
  }
  block cu_buyers_trend: VizBlock {
    label: 'Monthly Buying Customers'
    viz: LineChart {
      dataset: thelook
      calculation buyers {
        label: 'Buying Customers'
        formula: @aql thelook_order_items | count_distinct(thelook_orders.user_id) | where(thelook_order_items.status not in ['Cancelled', 'Returned']) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        label: 'Month'
        transformation: 'datetrunc month'
        format { type: 'date' pattern: 'LLL yyyy' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: 'buyers'
            label: 'Buying Customers'
            format { type: 'number' pattern: '#,###0' }
          }
          settings { color: '#2A5BD7' }
        }
      }
      settings {
        legend_label: 'hidden'
        show_data_points: false
        sort: LineFamilySort { type: 'xaxis' direction: 'asc' }
      }
    }
  }
  block cu_top_customers: VizBlock {
    label: 'Top 10 Customers by Net Sales'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          ref: r(thelook_users.first_name)
          label: 'First Name'
        },
        VizFieldFull {
          ref: r(thelook_users.last_name)
          label: 'Last Name'
        },
        VizFieldFull {
          ref: r(thelook_users.country)
          label: 'Country'
        },
        VizFieldFull {
          ref: r(thelook.fulfilled_orders)
          label: 'Orders'
          format { type: 'number' pattern: 'inherited' }
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format { type: 'number' pattern: 'inherited' }
        }
      ]
      settings {
        row_limit: 10
        pagination_size: 10
        show_row_number: true
        sorts: [
          IndexBasedSortSetting {
            field_index: 4
            direction: 'desc'
          }
        ]
      }
    }
  }

  // ---------------------------------------------------------------
  // Geography
  // ---------------------------------------------------------------
  block ge_kpi_countries: VizBlock {
    label: 'Countries with Sales'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      calculation countries {
        label: 'Countries with Sales'
        formula: @aql thelook_order_items | count_distinct(thelook_users.country) | where(thelook_order_items.status not in ['Cancelled', 'Returned']) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'countries'
        label: 'Countries with Sales'
        format { type: 'number' pattern: '#,###0' }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value: RelativePopValue { duration: 1 granularity: 'year' }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        label { font_size: 13 font_color: '#5B6472' }
        metric_value { font_size: 30 font_color: '#16243D' }
      }
    }
  }
  block ge_kpi_cities: VizBlock {
    label: 'Cities with Sales'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      calculation cities {
        label: 'Cities with Sales'
        formula: @aql thelook_order_items | count_distinct(thelook_users.city) | where(thelook_order_items.status not in ['Cancelled', 'Returned']) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'cities'
        label: 'Cities with Sales'
        format { type: 'number' pattern: '#,###0' }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value: RelativePopValue { duration: 1 granularity: 'year' }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        label { font_size: 13 font_color: '#5B6472' }
        metric_value { font_size: 30 font_color: '#16243D' }
      }
    }
  }
  block ge_kpi_international: VizBlock {
    label: 'International Share'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      calculation international_share {
        label: 'International Share (non-US)'
        formula: @aql safe_divide(net_sales | where(thelook_users.country != 'United States'), net_sales) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'international_share'
        label: 'International Share (non-US)'
        format { type: 'number' pattern: '#,###0.0%' }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value: RelativePopValue { duration: 1 granularity: 'year' }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        label { font_size: 13 font_color: '#5B6472' }
        metric_value { font_size: 30 font_color: '#16243D' }
      }
    }
  }
  block ge_kpi_sales_per_country: VizBlock {
    label: 'Net Sales per Country'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      calculation sales_per_country {
        label: 'Net Sales per Country'
        formula: @aql safe_divide(net_sales, thelook_order_items | count_distinct(thelook_users.country) | where(thelook_order_items.status not in ['Cancelled', 'Returned'])) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'sales_per_country'
        label: 'Net Sales per Country'
        format { type: 'number' pattern: '[$$]#,###0' }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value: RelativePopValue { duration: 1 granularity: 'year' }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        label { font_size: 13 font_color: '#5B6472' }
        metric_value { font_size: 30 font_color: '#16243D' }
      }
    }
  }
  block ge_map: VizBlock {
    label: 'Net Sales by Customer Country'
    viz: FilledMap {
      dataset: thelook
      location {
        field: r(thelook_users.country)
        location_type: 'country'
        primary_field: true
      }
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format { type: 'number' pattern: 'inherited' }
      }
      settings {
        color_scale: 'vertical'
        map_background: 'light'
        value_colors {
          style: 'smooth'
          min { color: '#DCE6FA' }
          max { color: '#16243D' }
        }
      }
    }
  }
  block ge_country_table: VizBlock {
    label: 'Country Scorecard'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          ref: r(thelook_users.country)
          label: 'Country'
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format { type: 'number' pattern: 'inherited' }
        },
        VizFieldFull {
          ref: r(thelook.fulfilled_orders)
          label: 'Orders'
          format { type: 'number' pattern: 'inherited' }
        },
        VizFieldFull {
          ref: r(thelook.gross_margin)
          label: 'Margin'
          format { type: 'number' pattern: 'inherited' }
        }
      ]
      settings {
        pagination_size: 15
        sorts: [
          IndexBasedSortSetting {
            field_index: 1
            direction: 'desc'
          }
        ]
      }
    }
  }
  block ge_cities: VizBlock {
    label: 'Top 10 Cities by Net Sales'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.city)
        label: 'City'
        format { type: 'text' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format { type: 'number' pattern: 'inherited' }
          }
          settings { color: '#2A5BD7' }
        }
      }
      settings {
        legend_label: 'hidden'
        row_limit: 10
        sort: LineFamilySort { type: 'yaxis' direction: 'desc' }
      }
    }
  }
  block ge_dc: VizBlock {
    label: 'Net Sales by Distribution Center'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_distribution_centers.name)
        label: 'Distribution Center'
        format { type: 'text' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format { type: 'number' pattern: 'inherited' }
          }
          settings { color: '#2A5BD7' }
        }
      }
      settings {
        legend_label: 'hidden'
        sort: LineFamilySort { type: 'yaxis' direction: 'desc' }
      }
    }
  }

  // ---------------------------------------------------------------
  // Layout: every tab uses the same grid
  //   header y=20 | filters y=100 | KPIs y=200 | main row y=340 | bottom row y=740
  // ---------------------------------------------------------------
  view: TabLayout {
    label: 'Sales Performance'

    tab overview: CanvasLayout {
      label: 'Overview'
      width: 1240
      height: 1140
      grid_size: 20
      auto_expand_vertically: true
      block h_overview { position: pos(20, 20, 1200, 60) }
      block f_date { position: pos(20, 100, 290, 80) }
      block f_department { position: pos(330, 100, 290, 80) }
      block f_category { position: pos(640, 100, 290, 80) }
      block f_country { position: pos(950, 100, 270, 80) }
      block ov_kpi_sales { position: pos(20, 200, 285, 120) }
      block ov_kpi_profit { position: pos(325, 200, 285, 120) }
      block ov_kpi_margin { position: pos(630, 200, 285, 120) }
      block ov_kpi_orders { position: pos(935, 200, 285, 120) }
      block ov_trend { position: pos(20, 340, 790, 380) }
      block ov_department { position: pos(830, 340, 390, 380) }
      block ov_status { position: pos(20, 740, 590, 380) }
      block ov_aov { position: pos(630, 740, 590, 380) }
      mobile { mode: 'auto' }
    }

    tab products: CanvasLayout {
      label: 'Products'
      width: 1240
      height: 1140
      grid_size: 20
      auto_expand_vertically: true
      block h_products { position: pos(20, 20, 1200, 60) }
      block f_date { position: pos(20, 100, 290, 80) }
      block f_department { position: pos(330, 100, 290, 80) }
      block f_category { position: pos(640, 100, 290, 80) }
      block f_country { position: pos(950, 100, 270, 80) }
      block pr_kpi_items { position: pos(20, 200, 285, 120) }
      block pr_kpi_cogs { position: pos(325, 200, 285, 120) }
      block pr_kpi_margin { position: pos(630, 200, 285, 120) }
      block pr_kpi_returns { position: pos(935, 200, 285, 120) }
      block pr_category { position: pos(20, 340, 790, 380) }
      block pr_brands { position: pos(830, 340, 390, 380) }
      block pr_top_products { position: pos(20, 740, 590, 380) }
      block pr_margin_category { position: pos(630, 740, 590, 380) }
      mobile { mode: 'auto' }
    }

    tab customers: CanvasLayout {
      label: 'Customers'
      width: 1240
      height: 1140
      grid_size: 20
      auto_expand_vertically: true
      block h_customers { position: pos(20, 20, 1200, 60) }
      block f_date { position: pos(20, 100, 290, 80) }
      block f_department { position: pos(330, 100, 290, 80) }
      block f_category { position: pos(640, 100, 290, 80) }
      block f_country { position: pos(950, 100, 270, 80) }
      block cu_kpi_buyers { position: pos(20, 200, 285, 120) }
      block cu_kpi_sales_per_buyer { position: pos(325, 200, 285, 120) }
      block cu_kpi_orders_per_buyer { position: pos(630, 200, 285, 120) }
      block cu_kpi_aov { position: pos(935, 200, 285, 120) }
      block cu_age_gender { position: pos(20, 340, 790, 380) }
      block cu_traffic { position: pos(830, 340, 390, 380) }
      block cu_buyers_trend { position: pos(20, 740, 590, 380) }
      block cu_top_customers { position: pos(630, 740, 590, 380) }
      mobile { mode: 'auto' }
    }

    tab geography: CanvasLayout {
      label: 'Geography'
      width: 1240
      height: 1140
      grid_size: 20
      auto_expand_vertically: true
      block h_geography { position: pos(20, 20, 1200, 60) }
      block f_date { position: pos(20, 100, 290, 80) }
      block f_department { position: pos(330, 100, 290, 80) }
      block f_category { position: pos(640, 100, 290, 80) }
      block f_country { position: pos(950, 100, 270, 80) }
      block ge_kpi_countries { position: pos(20, 200, 285, 120) }
      block ge_kpi_cities { position: pos(325, 200, 285, 120) }
      block ge_kpi_international { position: pos(630, 200, 285, 120) }
      block ge_kpi_sales_per_country { position: pos(935, 200, 285, 120) }
      block ge_map { position: pos(20, 340, 790, 380) }
      block ge_country_table { position: pos(830, 340, 390, 380) }
      block ge_cities { position: pos(20, 740, 590, 380) }
      block ge_dc { position: pos(630, 740, 590, 380) }
      mobile { mode: 'auto' }
    }
  }

  theme: PageTheme {
    title: 'Sales Performance'
    background { bg_color: '#F3F5F8' }
    canvas {
      background { bg_color: '#F3F5F8' }
      border { border_width: 0 }
      shadow: 'none'
    }
    block {
      label { font_size: 14 font_weight: 'semibold' font_color: '#16243D' }
      text { font_size: 13 font_color: '#374151' }
      background { bg_color: '#FFFFFF' }
      border { border_width: 1 border_color: '#E2E6EC' border_radius: 10 border_style: 'solid' }
      padding: 14
      shadow: 'none'
    }
    viz {
      table {
        general { font_size: 12 banding_color: '#F8FAFC' border_color: '#E2E6EC' }
        header { bg_color: '#F3F5F8' font_weight: 'semibold' font_color: '#16243D' }
      }
    }
  }
}
