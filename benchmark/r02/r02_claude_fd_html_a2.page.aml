Dashboard r02_claude_fd_html_a2 {
  title: 'Sales Performance'
  description: 'TheLook eCommerce sales performance across overview, products, customers and geography. Filters apply to every tab.'

  // ---------------------------------------------------------------------------
  // Shared filters (rendered once above the tabs, apply to every tab)
  // ---------------------------------------------------------------------------
  block f_order_date: FilterBlock {
    label: 'Order Date'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }
  block f_department: FilterBlock {
    label: 'Department'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.department)
    }
    settings {
      input_type: 'multiple'
    }
  }
  block f_category: FilterBlock {
    label: 'Category'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.category)
    }
    settings {
      input_type: 'multiple'
    }
  }
  block f_country: FilterBlock {
    label: 'Country'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.country)
    }
    settings {
      input_type: 'multiple'
    }
  }
  block f_traffic_source: FilterBlock {
    label: 'Traffic Source'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.traffic_source)
    }
    settings {
      input_type: 'multiple'
    }
  }

  // ---------------------------------------------------------------------------
  // Overview
  // ---------------------------------------------------------------------------
  block ov_kpi_net_sales: VizBlock {
    label: 'Net Sales'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format { type: 'number', pattern: 'inherited' }
      }
      settings { display_mode: 'single', alignment: 'left' }
    }
  }
  block ov_kpi_gross_profit: VizBlock {
    label: 'Gross Profit'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_profit)
        label: 'Gross Profit'
        format { type: 'number', pattern: 'inherited' }
      }
      settings { display_mode: 'single', alignment: 'left' }
    }
  }
  block ov_kpi_orders: VizBlock {
    label: 'Fulfilled Orders'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        label: 'Fulfilled Orders'
        format { type: 'number', pattern: 'inherited' }
      }
      settings { display_mode: 'single', alignment: 'left' }
    }
  }
  block ov_kpi_aov: VizBlock {
    label: 'Average Order Value'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'
        format { type: 'number', pattern: 'inherited' }
      }
      settings { display_mode: 'single', alignment: 'left' }
    }
  }
  block ov_sales_trend: VizBlock {
    label: 'Monthly Net Sales & Gross Profit'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        label: 'Month'
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format { type: 'date', pattern: 'LLL yyyy' }
      }
      y_axis {
        label: 'Net Sales'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            label: 'Net Sales'
            ref: r(thelook.net_sales)
            format { type: 'number', pattern: 'inherited' }
          }
          settings { color: '#1F4E79' }
        }
      }
      y_axis {
        label: 'Gross Profit'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            label: 'Gross Profit'
            ref: r(thelook.gross_profit)
            format { type: 'number', pattern: 'inherited' }
          }
          settings { color: '#E07A2E' }
        }
        settings { alignment: 'right' }
      }
      settings {
        legend_label: 'bottom'
        sort: LineFamilySort { type: 'xaxis', direction: 'asc' }
      }
    }
  }
  block ov_sales_by_department: VizBlock {
    label: 'Net Sales by Department'
    viz: ColumnChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.department)
        label: 'Department'
        format { type: 'text' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format { type: 'number', pattern: 'inherited' }
          }
          settings { color: '#1F4E79' }
        }
        settings { show_data_label_by: 'value' }
      }
      settings {
        sort: LineFamilySort { type: 'yaxis', field_index: 0, direction: 'desc' }
      }
    }
  }
  block ov_items_by_status: VizBlock {
    label: 'Gross Sales by Item Status'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.status)
        label: 'Status'
        format { type: 'text' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.gross_sales)
            label: 'Gross Sales'
            format { type: 'number', pattern: 'inherited' }
          }
          settings { color: '#1F4E79' }
        }
        settings { show_data_label_by: 'value' }
      }
      settings {
        sort: LineFamilySort { type: 'yaxis', field_index: 0, direction: 'desc' }
      }
    }
  }

  // ---------------------------------------------------------------------------
  // Products
  // ---------------------------------------------------------------------------
  block pr_kpi_items_sold: VizBlock {
    label: 'Items Sold'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.items_sold)
        label: 'Items Sold'
        format { type: 'number', pattern: 'inherited' }
      }
      settings { display_mode: 'single', alignment: 'left' }
    }
  }
  block pr_kpi_asp: VizBlock {
    label: 'Average Selling Price'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      calculation avg_selling_price {
        label: 'Average Selling Price'
        formula: @aql safe_divide(net_sales, items_sold) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'avg_selling_price'
        label: 'Average Selling Price'
        format { type: 'number', pattern: '[$$]#,###0.00' }
      }
      settings { display_mode: 'single', alignment: 'left' }
    }
  }
  block pr_kpi_margin: VizBlock {
    label: 'Gross Margin'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format { type: 'number', pattern: 'inherited' }
      }
      settings { display_mode: 'single', alignment: 'left' }
    }
  }
  block pr_kpi_return_rate: VizBlock {
    label: 'Return Rate'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.return_rate)
        label: 'Return Rate'
        format { type: 'number', pattern: 'inherited' }
      }
      settings { display_mode: 'single', alignment: 'left' }
    }
  }
  block pr_sales_by_category: VizBlock {
    label: 'Net Sales by Category'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Category'
        format { type: 'text' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format { type: 'number', pattern: 'inherited' }
          }
          settings { color: '#1F4E79' }
        }
        settings { show_data_label_by: 'value' }
      }
      settings {
        row_limit: 15
        sort: LineFamilySort { type: 'yaxis', field_index: 0, direction: 'desc' }
      }
    }
  }
  block pr_margin_by_category: VizBlock {
    label: 'Gross Margin by Category'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Category'
        format { type: 'text' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.gross_margin)
            label: 'Gross Margin'
            format { type: 'number', pattern: 'inherited' }
          }
          settings { color: '#E07A2E' }
        }
        settings { show_data_label_by: 'value' }
      }
      settings {
        row_limit: 15
        sort: LineFamilySort { type: 'yaxis', field_index: 0, direction: 'desc' }
      }
    }
  }
  block pr_top_brands: VizBlock {
    label: 'Top Brands'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          ref: r(thelook_products.brand)
          label: 'Brand'
          format { type: 'text' }
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format { type: 'number', pattern: 'inherited' }
        },
        VizFieldFull {
          ref: r(thelook.items_sold)
          label: 'Items Sold'
          format { type: 'number', pattern: 'inherited' }
        },
        VizFieldFull {
          ref: r(thelook.gross_margin)
          label: 'Gross Margin'
          format { type: 'number', pattern: 'inherited' }
        },
        VizFieldFull {
          ref: r(thelook.return_rate)
          label: 'Return Rate'
          format { type: 'number', pattern: 'inherited' }
        }
      ]
      settings {
        row_limit: 10
        pagination_size: 10
        show_row_number: true
        sorts: [
          IndexBasedSortSetting { field_index: 1, direction: 'desc' }
        ]
        conditional_formats: [
          ConditionalFormat {
            ref: r(thelook.net_sales)
            format: ScaleFormat {
              min { type: 'percentage', value: 0, color: '#FFFFFF' }
              max { type: 'percentage', value: 100, color: '#C9D8E8' }
            }
          }
        ]
      }
    }
  }
  block pr_top_products: VizBlock {
    label: 'Top Products'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          ref: r(thelook_products.name)
          label: 'Product'
          format { type: 'text' }
        },
        VizFieldFull {
          ref: r(thelook_products.category)
          label: 'Category'
          format { type: 'text' }
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format { type: 'number', pattern: 'inherited' }
        },
        VizFieldFull {
          ref: r(thelook.items_sold)
          label: 'Items Sold'
          format { type: 'number', pattern: 'inherited' }
        }
      ]
      settings {
        row_limit: 10
        pagination_size: 10
        show_row_number: true
        sorts: [
          IndexBasedSortSetting { field_index: 2, direction: 'desc' }
        ]
        conditional_formats: [
          ConditionalFormat {
            ref: r(thelook.net_sales)
            format: ScaleFormat {
              min { type: 'percentage', value: 0, color: '#FFFFFF' }
              max { type: 'percentage', value: 100, color: '#C9D8E8' }
            }
          }
        ]
      }
    }
  }

  // ---------------------------------------------------------------------------
  // Customers
  // ---------------------------------------------------------------------------
  block cu_kpi_buyers: VizBlock {
    label: 'Buyers'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      calculation buyers {
        label: 'Buyers'
        formula: @aql count_distinct(thelook_order_items.user_id) | where(thelook_order_items.status not in ['Cancelled', 'Returned']) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'buyers'
        label: 'Buyers'
        format { type: 'number', pattern: '#,###0' }
      }
      settings { display_mode: 'single', alignment: 'left' }
    }
  }
  block cu_kpi_sales_per_buyer: VizBlock {
    label: 'Net Sales per Buyer'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      calculation sales_per_buyer {
        label: 'Net Sales per Buyer'
        formula: @aql safe_divide(net_sales, count_distinct(thelook_order_items.user_id) | where(thelook_order_items.status not in ['Cancelled', 'Returned'])) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'sales_per_buyer'
        label: 'Net Sales per Buyer'
        format { type: 'number', pattern: '[$$]#,###0.00' }
      }
      settings { display_mode: 'single', alignment: 'left' }
    }
  }
  block cu_kpi_orders_per_buyer: VizBlock {
    label: 'Orders per Buyer'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      calculation orders_per_buyer {
        label: 'Orders per Buyer'
        formula: @aql safe_divide(fulfilled_orders,count_distinct(thelook_order_items.user_id) | where(thelook_order_items.status not in ['Cancelled', 'Returned'])) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'orders_per_buyer'
        label: 'Orders per Buyer'
        format { type: 'number', pattern: '#,###0.00' }
      }
      settings { display_mode: 'single', alignment: 'left' }
    }
  }
  block cu_kpi_aov: VizBlock {
    label: 'Average Order Value'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'
        format { type: 'number', pattern: 'inherited' }
      }
      settings { display_mode: 'single', alignment: 'left' }
    }
  }
  block cu_buyers_trend: VizBlock {
    label: 'Monthly Buyers'
    viz: LineChart {
      dataset: thelook
      calculation monthly_buyers {
        label: 'Buyers'
        formula: @aql count_distinct(thelook_order_items.user_id) | where(thelook_order_items.status not in ['Cancelled', 'Returned']) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      x_axis: VizFieldFull {
        label: 'Month'
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format { type: 'date', pattern: 'LLL yyyy' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            label: 'Buyers'
            ref: 'monthly_buyers'
            format { type: 'number', pattern: '#,###0' }
          }
          settings { color: '#1F4E79' }
        }
      }
      settings {
        sort: LineFamilySort { type: 'xaxis', direction: 'asc' }
      }
    }
  }
  block cu_sales_by_traffic: VizBlock {
    label: 'Net Sales by Acquisition Channel'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.traffic_source)
        label: 'Traffic Source'
        format { type: 'text' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format { type: 'number', pattern: 'inherited' }
          }
          settings { color: '#1F4E79' }
        }
        settings { show_data_label_by: 'value' }
      }
      settings {
        sort: LineFamilySort { type: 'yaxis', field_index: 0, direction: 'desc' }
      }
    }
  }
  block cu_sales_by_gender: VizBlock {
    label: 'Net Sales & AOV by Gender'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.gender)
        label: 'Gender'
        format { type: 'text' }
      }
      y_axis {
        label: 'Net Sales'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format { type: 'number', pattern: 'inherited' }
          }
          settings { color: '#1F4E79' }
        }
      }
      y_axis {
        label: 'AOV'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.aov)
            label: 'Average Order Value'
            format { type: 'number', pattern: 'inherited' }
          }
          settings { color: '#E07A2E' }
        }
        settings { alignment: 'right' }
      }
      settings {
        legend_label: 'bottom'
      }
    }
  }
  block cu_top_customers: VizBlock {
    label: 'Top Customers'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          ref: r(thelook_users.email)
          label: 'Customer'
          format { type: 'text' }
        },
        VizFieldFull {
          ref: r(thelook_users.country)
          label: 'Country'
          format { type: 'text' }
        },
        VizFieldFull {
          ref: r(thelook.fulfilled_orders)
          label: 'Orders'
          format { type: 'number', pattern: 'inherited' }
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format { type: 'number', pattern: 'inherited' }
        }
      ]
      settings {
        row_limit: 10
        pagination_size: 10
        show_row_number: true
        sorts: [
          IndexBasedSortSetting { field_index: 3, direction: 'desc' }
        ]
        conditional_formats: [
          ConditionalFormat {
            ref: r(thelook.net_sales)
            format: ScaleFormat {
              min { type: 'percentage', value: 0, color: '#FFFFFF' }
              max { type: 'percentage', value: 100, color: '#C9D8E8' }
            }
          }
        ]
      }
    }
  }

  // ---------------------------------------------------------------------------
  // Geography
  // ---------------------------------------------------------------------------
  block ge_kpi_countries: VizBlock {
    label: 'Countries'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      calculation countries_served {
        label: 'Countries with Sales'
        formula: @aql thelook_order_items | count_distinct(thelook_users.country) | where(thelook_order_items.status not in ['Cancelled', 'Returned']) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'countries_served'
        label: 'Countries with Sales'
        format { type: 'number', pattern: '#,###0' }
      }
      settings { display_mode: 'single', alignment: 'left' }
    }
  }
  block ge_kpi_cities: VizBlock {
    label: 'Cities'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      calculation cities_served {
        label: 'Cities with Sales'
        formula: @aql thelook_order_items | count_distinct(thelook_users.city) | where(thelook_order_items.status not in ['Cancelled', 'Returned']) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'cities_served'
        label: 'Cities with Sales'
        format { type: 'number', pattern: '#,###0' }
      }
      settings { display_mode: 'single', alignment: 'left' }
    }
  }
  block ge_kpi_us_sales: VizBlock {
    label: 'US Net Sales'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      calculation us_net_sales {
        label: 'United States Net Sales'
        formula: @aql net_sales | where(thelook_users.country =='United States') ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'us_net_sales'
        label: 'United States Net Sales'
        format { type: 'number', pattern: '[$$]#,###0' }
      }
      settings { display_mode: 'single', alignment: 'left' }
    }
  }
  block ge_kpi_intl_share: VizBlock {
    label: 'International Share'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      calculation intl_share {
        label: 'International Share of Net Sales'
        formula: @aql safe_divide(net_sales | where(thelook_users.country != 'United States'), net_sales) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'intl_share'
        label: 'International Share of Net Sales'
        format { type: 'number', pattern: '#,###0.0%' }
      }
      settings { display_mode: 'single', alignment: 'left' }
    }
  }
  block ge_sales_by_country: VizBlock {
    label: 'Net Sales by Country'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.country)
        label: 'Country'
        format { type: 'text' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format { type: 'number', pattern: 'inherited' }
          }
          settings { color: '#1F4E79' }
        }
        settings { show_data_label_by: 'value' }
      }
      settings {
        sort: LineFamilySort { type: 'yaxis', field_index: 0, direction: 'desc' }
      }
    }
  }
  block ge_sales_by_dc: VizBlock {
    label: 'Net Sales by Distribution Center'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_distribution_centers.name)
        label: 'Distribution Center'
        format { type: 'text' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format { type: 'number', pattern: 'inherited' }
          }
          settings { color: '#E07A2E' }
        }
        settings { show_data_label_by: 'value' }
      }
      settings {
        sort: LineFamilySort { type: 'yaxis', field_index: 0, direction: 'desc' }
      }
    }
  }
  block ge_top_states: VizBlock {
    label: 'Top States / Regions'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          ref: r(thelook_users.country)
          label: 'Country'
          format { type: 'text' }
        },
        VizFieldFull {
          ref: r(thelook_users.state)
          label: 'State / Region'
          format { type: 'text' }
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format { type: 'number', pattern: 'inherited' }
        },
        VizFieldFull {
          ref: r(thelook.fulfilled_orders)
          label: 'Orders'
          format { type: 'number', pattern: 'inherited' }
        },
        VizFieldFull {
          ref: r(thelook.aov)
          label: 'AOV'
          format { type: 'number', pattern: 'inherited' }
        },
        VizFieldFull {
          ref: r(thelook.gross_margin)
          label: 'Gross Margin'
          format { type: 'number', pattern: 'inherited' }
        }
      ]
      settings {
        row_limit: 15
        pagination_size: 15
        show_row_number: true
        sorts: [
          IndexBasedSortSetting { field_index: 2, direction: 'desc' }
        ]
        conditional_formats: [
          ConditionalFormat {
            ref: r(thelook.net_sales)
            format: ScaleFormat {
              min { type: 'percentage', value: 0, color: '#FFFFFF' }
              max { type: 'percentage', value: 100, color: '#C9D8E8' }
            }
          }
        ]
      }
    }
  }

  // ---------------------------------------------------------------------------
  // Layout: CSS-only tabs (:target). Header + filter bar are shared across tabs;
  // every panel uses the same KPI strip + card grid so all tabs look alike.
  // ---------------------------------------------------------------------------
  view: HTMLLayout {
    content: @html
      <style>
        .sp {
          --ink: #16202B;
          --muted: #5B6675;
          --line: #E3E6EA;
          --paper: #F5F6F4;
          --card: #FFFFFF;
          --accent: #1F4E79;
          --warm: #E07A2E;
          font-family: "Inter", "Segoe UI", system-ui, -apple-system, sans-serif;
          color: var(--ink);
          background: var(--paper);
          padding: 28px 32px 40px;
          min-height: 100%;
          box-sizing: border-box;
        }
        .sp *, .sp *::before, .sp *::after { box-sizing: border-box; }

        /* Header */
        .sp-head {
          display: flex;
          align-items: flex-end;
          justify-content: space-between;
          gap: 24px;
          padding-bottom: 18px;
          border-bottom: 2px solid var(--ink);
        }
        .sp-eyebrow {
          font-size: 11px;
          letter-spacing: 0.14em;
          text-transform: uppercase;
          color: var(--warm);
          font-weight: 700;
          margin: 0 0 6px;
        }
        .sp-title {
          font-size: 30px;
          line-height: 1.1;
          font-weight: 800;
          letter-spacing: -0.02em;
          margin: 0;
        }
        .sp-sub {
          font-size: 13px;
          color: var(--muted);
          margin: 0;
          max-width: 360px;
          text-align: right;
        }

        /* Shared filter bar */
        .sp-filters {
          display: grid;
          grid-template-columns: 1.4fr repeat(4, 1fr);
          gap: 12px;
          margin: 18px 0 0;
          padding: 12px;
          background: var(--card);
          border: 1px solid var(--line);
          border-radius: 10px;
        }
        .sp-filter { min-height: 64px; }

        /* Tab navigation */
        .sp-tabs {
          display: flex;
          gap: 4px;
          margin: 22px 0 20px;
          border-bottom: 1px solid var(--line);
        }
        .sp-tab {
          padding: 10px 18px 12px;
          font-size: 14px;
          font-weight: 600;
          color: var(--muted);
          text-decoration: none;
          border-bottom: 3px solid transparent;
          margin-bottom: -1px;
          transition: color .15s ease, border-color .15s ease;
        }
        .sp-tab:hover { color: var(--ink); }
        .sp:has(#sp-overview:target) .sp-tab-overview,
        .sp:has(#sp-products:target) .sp-tab-products,
        .sp:has(#sp-customers:target) .sp-tab-customers,
        .sp:has(#sp-geography:target) .sp-tab-geography,
        .sp:not(:has(.sp-panel:target)) .sp-tab-overview {
          color: var(--ink);
          border-bottom-color: var(--accent);
        }

        /* Panels */
        .sp-panel { display: none; }
        .sp-panel:target,
        .sp:not(:has(.sp-panel:target)) #sp-overview {
          display: block;
          animation: sp-in .25s ease-out;
        }
        @keyframes sp-in {
          from { opacity: 0; transform: translateY(4px); }
          to { opacity: 1; transform: none; }
        }
        .sp-panel-intro {
          font-size: 13px;
          color: var(--muted);
          margin: 0 0 14px;
        }

        /* Shared card grid, identical on every tab */
        .sp-kpis {
          display: grid;
          grid-template-columns: repeat(4, 1fr);
          gap: 16px;
          margin-bottom: 16px;
        }
        .sp-kpi {
          height: 116px;
          background: var(--card);
          border: 1px solid var(--line);
          border-top: 3px solid var(--accent);
          border-radius: 10px;
          overflow: hidden;
        }
        .sp-grid {
          display: grid;
          grid-template-columns: repeat(12, 1fr);
          gap: 16px;
        }
        .sp-card {
          background: var(--card);
          border: 1px solid var(--line);
          border-radius: 10px;
          overflow: hidden;
          height: 360px;
        }
        .sp-card.tall { height: 440px; }
        .sp-span-12 { grid-column: span 12; }
        .sp-span-8 { grid-column: span 8; }
        .sp-span-7 { grid-column: span 7; }
        .sp-span-6 { grid-column: span 6; }
        .sp-span-5 { grid-column: span 5; }
        .sp-span-4 { grid-column: span 4; }

        @media (max-width: 1000px) {
          .sp-filters { grid-template-columns: 1fr 1fr; }
          .sp-kpis { grid-template-columns: 1fr 1fr; }
          .sp-span-8, .sp-span-7, .sp-span-6, .sp-span-5, .sp-span-4 { grid-column: span 12; }
          .sp-head { flex-direction: column; align-items: flex-start; }
          .sp-sub { text-align: left; }
        }
      </style>

      <div class="sp">
        <header class="sp-head">
          <div>
            <p class="sp-eyebrow">TheLook eCommerce</p>
            <h1 class="sp-title">Sales Performance</h1>
          </div>
          <p class="sp-sub">Net figures exclude cancelled and returned items. Filters below apply to every tab.</p>
        </header>

        <div class="sp-filters">
          <div class="sp-filter"><h-block name="f_order_date" /></div>
          <div class="sp-filter"><h-block name="f_department" /></div>
          <div class="sp-filter"><h-block name="f_category" /></div>
          <div class="sp-filter"><h-block name="f_country" /></div>
          <div class="sp-filter"><h-block name="f_traffic_source" /></div>
        </div>

        <nav class="sp-tabs">
          <a class="sp-tab sp-tab-overview" href="#sp-overview">Overview</a>
          <a class="sp-tab sp-tab-products" href="#sp-products">Products</a>
          <a class="sp-tab sp-tab-customers" href="#sp-customers">Customers</a>
          <a class="sp-tab sp-tab-geography" href="#sp-geography">Geography</a>
        </nav>

        <section class="sp-panel" id="sp-overview">
          <p class="sp-panel-intro">Headline revenue, profit and order volume, with the monthly trend.</p>
          <div class="sp-kpis">
            <div class="sp-kpi"><h-block name="ov_kpi_net_sales" /></div>
            <div class="sp-kpi"><h-block name="ov_kpi_gross_profit" /></div>
            <div class="sp-kpi"><h-block name="ov_kpi_orders" /></div>
            <div class="sp-kpi"><h-block name="ov_kpi_aov" /></div>
          </div>
          <div class="sp-grid">
            <div class="sp-card sp-span-12"><h-block name="ov_sales_trend" /></div>
            <div class="sp-card sp-span-6"><h-block name="ov_sales_by_department" /></div>
            <div class="sp-card sp-span-6"><h-block name="ov_items_by_status" /></div>
          </div>
        </section>

        <section class="sp-panel" id="sp-products">
          <p class="sp-panel-intro">What sells, what earns margin, and what comes back.</p>
          <div class="sp-kpis">
            <div class="sp-kpi"><h-block name="pr_kpi_items_sold" /></div>
            <div class="sp-kpi"><h-block name="pr_kpi_asp" /></div>
            <div class="sp-kpi"><h-block name="pr_kpi_margin" /></div>
            <div class="sp-kpi"><h-block name="pr_kpi_return_rate" /></div>
          </div>
          <div class="sp-grid">
            <div class="sp-card tall sp-span-6"><h-block name="pr_sales_by_category" /></div>
            <div class="sp-card tall sp-span-6"><h-block name="pr_margin_by_category" /></div>
            <div class="sp-card tall sp-span-6"><h-block name="pr_top_brands" /></div>
            <div class="sp-card tall sp-span-6"><h-block name="pr_top_products" /></div>
          </div>
        </section>

        <section class="sp-panel" id="sp-customers">
          <p class="sp-panel-intro">Who buys, how often, and which channels bring them in.</p>
          <div class="sp-kpis">
            <div class="sp-kpi"><h-block name="cu_kpi_buyers" /></div>
            <div class="sp-kpi"><h-block name="cu_kpi_sales_per_buyer" /></div>
            <div class="sp-kpi"><h-block name="cu_kpi_orders_per_buyer" /></div>
            <div class="sp-kpi"><h-block name="cu_kpi_aov" /></div>
          </div>
          <div class="sp-grid">
            <div class="sp-card sp-span-12"><h-block name="cu_buyers_trend" /></div>
            <div class="sp-card sp-span-6"><h-block name="cu_sales_by_traffic" /></div>
            <div class="sp-card sp-span-6"><h-block name="cu_sales_by_gender" /></div>
            <div class="sp-card tall sp-span-12"><h-block name="cu_top_customers" /></div>
          </div>
        </section>

        <section class="sp-panel" id="sp-geography">
          <p class="sp-panel-intro">Where sales come from and which distribution centers fulfil them.</p>
          <div class="sp-kpis">
            <div class="sp-kpi"><h-block name="ge_kpi_countries" /></div>
            <div class="sp-kpi"><h-block name="ge_kpi_cities" /></div>
            <div class="sp-kpi"><h-block name="ge_kpi_us_sales" /></div>
            <div class="sp-kpi"><h-block name="ge_kpi_intl_share" /></div>
          </div>
          <div class="sp-grid">
            <div class="sp-card tall sp-span-7"><h-block name="ge_sales_by_country" /></div>
            <div class="sp-card tall sp-span-5"><h-block name="ge_sales_by_dc" /></div>
            <div class="sp-card tall sp-span-12"><h-block name="ge_top_states" /></div>
          </div>
        </section>
      </div>
    ;;
  }

  theme: PageTheme {
    background {
      bg_color: '#F5F6F4'
    }
    canvas {
      background { bg_color: '#F5F6F4' }
      border { border_width: 0 }
      shadow: 'none'
    }
    block {
      label {
        font_size: 13
        font_color: '#16202B'
        font_weight: 'semibold'
      }
      text {
        font_color: '#16202B'
      }
      background { bg_color: 'transparent' }
      border { border_width: 0 }
      padding: 12
      shadow: 'none'
    }
    viz {
      table {
        general {
          font_size: 12
          font_color: '#16202B'
          border_color: '#E3E6EA'
          banding_color: '#FAFAF9'
        }
        header {
          bg_color: '#F0F2F4'
          font_weight: 'semibold'
          font_color: '#16202B'
        }
      }
    }
  }
}
