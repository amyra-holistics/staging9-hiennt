Dashboard r02_claude_fd_html_a3 {
  title: 'Sales Performance'
  description: 'TheLook eCommerce sales performance across overview, products, customers and geography. Filters in the header apply to every tab.'

  // ---------------------------------------------------------------- Filters (shared across tabs)
  block f_date: FilterBlock {
    label: 'Order Date'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }
  block f_country: FilterBlock {
    label: 'Country'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.country)
    }
  }
  block f_department: FilterBlock {
    label: 'Department'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.department)
    }
  }
  block f_category: FilterBlock {
    label: 'Category'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.category)
    }
  }

  // ---------------------------------------------------------------- Overview
  block ov_net_sales: VizBlock {
    label: 'Net Sales'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        format { type: 'number', pattern: '[$$]#,###0' }
      }
      settings { alignment: 'left' }
    }
  }
  block ov_gross_profit: VizBlock {
    label: 'Gross Profit'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_profit)
        format { type: 'number', pattern: '[$$]#,###0' }
      }
      settings { alignment: 'left' }
    }
  }
  block ov_gross_margin: VizBlock {
    label: 'Gross Margin'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        format { type: 'number', pattern: '#,###0.0%' }
      }
      settings { alignment: 'left' }
    }
  }
  block ov_orders: VizBlock {
    label: 'Fulfilled Orders'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        format { type: 'number', pattern: '#,###0' }
      }
      settings { alignment: 'left' }
    }
  }
  block ov_trend: VizBlock {
    label: 'Monthly Net Sales & Gross Profit'
    viz: LineChart {
      dataset: thelook
      x_axis: VizFieldFull {
        label: 'Month'
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format { type: 'date', pattern: 'LLL yyyy' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            format { type: 'number', pattern: '[$$]#,###0' }
          }
          settings { color: '#2F4BD9' }
        }
        series {
          field: VizFieldFull {
            ref: r(thelook.gross_profit)
            format { type: 'number', pattern: '[$$]#,###0' }
          }
          settings { color: '#1FA38A' }
        }
      }
      settings {
        sort: LineFamilySort { type: 'xaxis', direction: 'asc' }
        row_limit: 5000
      }
    }
  }
  block ov_department: VizBlock {
    label: 'Net Sales by Department'
    viz: PieChart {
      dataset: thelook
      legend: VizFieldFull {
        ref: r(thelook_products.department)
      }
      series {
        field: VizFieldFull {
          ref: r(thelook.net_sales)
          format { type: 'number', pattern: '[$$]#,###0' }
        }
      }
      settings {
        display_as_donut: true
        show_percentage: true
      }
    }
  }
  block ov_status: VizBlock {
    label: 'Gross Sales by Item Status'
    viz: ColumnChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.status)
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.gross_sales)
            format { type: 'number', pattern: '[$$]#,###0' }
          }
          settings { color: '#2F4BD9' }
        }
      }
      settings {
        sort: LineFamilySort { type: 'yaxis', field_index: 0, direction: 'desc' }
      }
    }
  }
  block ov_aov_trend: VizBlock {
    label: 'Monthly Average Order Value'
    viz: ColumnChart {
      dataset: thelook
      x_axis: VizFieldFull {
        label: 'Month'
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format { type: 'date', pattern: 'LLL yyyy' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.aov)
            format { type: 'number', pattern: '[$$]#,###0.00' }
          }
          settings { color: '#1FA38A' }
        }
      }
      settings {
        sort: LineFamilySort { type: 'xaxis', direction: 'asc' }
        row_limit: 5000
      }
    }
  }

  // ---------------------------------------------------------------- Products
  block pr_items_sold: VizBlock {
    label: 'Items Sold'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.items_sold)
        format { type: 'number', pattern: '#,###0' }
      }
      settings { alignment: 'left' }
    }
  }
  block pr_net_sales: VizBlock {
    label: 'Net Sales'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        format { type: 'number', pattern: '[$$]#,###0' }
      }
      settings { alignment: 'left' }
    }
  }
  block pr_cogs: VizBlock {
    label: 'COGS'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.cogs)
        format { type: 'number', pattern: '[$$]#,###0' }
      }
      settings { alignment: 'left' }
    }
  }
  block pr_return_rate: VizBlock {
    label: 'Return Rate'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.return_rate)
        format { type: 'number', pattern: '#,###0.0%' }
      }
      settings { alignment: 'left' }
    }
  }
  block pr_category: VizBlock {
    label: 'Net Sales by Category'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            format { type: 'number', pattern: '[$$]#,###0' }
          }
          settings { color: '#2F4BD9' }
        }
      }
      settings {
        sort: LineFamilySort { type: 'yaxis', field_index: 0, direction: 'desc' }
        row_limit: 15
      }
    }
  }
  block pr_brand: VizBlock {
    label: 'Top 10 Brands by Net Sales'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.brand)
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            format { type: 'number', pattern: '[$$]#,###0' }
          }
          settings { color: '#1FA38A' }
        }
      }
      settings {
        sort: LineFamilySort { type: 'yaxis', field_index: 0, direction: 'desc' }
        row_limit: 10
      }
    }
  }
  block pr_margin: VizBlock {
    label: 'Gross Margin by Category'
    viz: ColumnChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.gross_margin)
            format { type: 'number', pattern: '#,###0.0%' }
          }
          settings { color: '#2F4BD9' }
        }
      }
      settings {
        sort: LineFamilySort { type: 'yaxis', field_index: 0, direction: 'desc' }
      }
    }
  }
  block pr_top_products: VizBlock {
    label: 'Top Products'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull { ref: r(thelook_products.name) },
        VizFieldFull { ref: r(thelook_products.category) },
        VizFieldFull { ref: r(thelook_products.brand) },
        VizFieldFull {
          ref: r(thelook.items_sold)
          format { type: 'number', pattern: '#,###0' }
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          format { type: 'number', pattern: '[$$]#,###0' }
        },
        VizFieldFull {
          ref: r(thelook.gross_margin)
          format { type: 'number', pattern: '#,###0.0%' }
        }
      ]
      settings {
        sorts: [IndexBasedSortSetting { field_index: 4, direction: 'desc' }]
        row_limit: 100
        pagination_size: 10
      }
    }
  }

  // ---------------------------------------------------------------- Customers
  block cu_customers: VizBlock {
    label: 'Customers'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.customers)
        format { type: 'number', pattern: '#,###0' }
      }
      settings { alignment: 'left' }
    }
  }
  block cu_orders: VizBlock {
    label: 'Orders'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.total_orders)
        format { type: 'number', pattern: '#,###0' }
      }
      settings { alignment: 'left' }
    }
  }
  block cu_aov: VizBlock {
    label: 'Average Order Value'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        format { type: 'number', pattern: '[$$]#,###0.00' }
      }
      settings { alignment: 'left' }
    }
  }
  block cu_sales_per_customer: VizBlock {
    label: 'Net Sales per Customer'
    viz: MetricKpi {
      dataset: thelook
      calculation sales_per_customer {
        label: 'Net Sales per Customer'
        formula: @aql safe_divide(net_sales, customers) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'sales_per_customer'
        format { type: 'number', pattern: '[$$]#,###0.00' }
      }
      settings { alignment: 'left' }
    }
  }
  block cu_traffic: VizBlock {
    label: 'Net Sales by Traffic Source'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.traffic_source)
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            format { type: 'number', pattern: '[$$]#,###0' }
          }
          settings { color: '#2F4BD9' }
        }
      }
      settings {
        sort: LineFamilySort { type: 'yaxis', field_index: 0, direction: 'desc' }
      }
    }
  }
  block cu_gender: VizBlock {
    label: 'Net Sales by Customer Gender'
    viz: PieChart {
      dataset: thelook
      legend: VizFieldFull {
        ref: r(thelook_users.gender)
      }
      series {
        field: VizFieldFull {
          ref: r(thelook.net_sales)
          format { type: 'number', pattern: '[$$]#,###0' }
        }
      }
      settings {
        display_as_donut: true
        show_percentage: true
      }
    }
  }
  block cu_age: VizBlock {
    label: 'Customers by Age'
    viz: ColumnChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.age)
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.customers)
            format { type: 'number', pattern: '#,###0' }
          }
          settings { color: '#1FA38A' }
        }
      }
      settings {
        sort: LineFamilySort { type: 'xaxis', direction: 'asc' }
      }
    }
  }
  block cu_top_customers: VizBlock {
    label: 'Top Customers'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull { ref: r(thelook_users.first_name) },
        VizFieldFull { ref: r(thelook_users.last_name) },
        VizFieldFull { ref: r(thelook_users.country) },
        VizFieldFull {
          ref: r(thelook.fulfilled_orders)
          format { type: 'number', pattern: '#,###0' }
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          format { type: 'number', pattern: '[$$]#,###0' }
        }
      ]
      settings {
        sorts: [IndexBasedSortSetting { field_index: 4, direction: 'desc' }]
        row_limit: 100
        pagination_size: 10
      }
    }
  }

  // ---------------------------------------------------------------- Geography
  block ge_countries: VizBlock {
    label: 'Countries'
    viz: MetricKpi {
      dataset: thelook
      calculation country_count {
        label: 'Countries'
        formula: @aql count_distinct(thelook_users.country) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'country_count'
        format { type: 'number', pattern: '#,###0' }
      }
      settings { alignment: 'left' }
    }
  }
  block ge_cities: VizBlock {
    label: 'Cities'
    viz: MetricKpi {
      dataset: thelook
      calculation city_count {
        label: 'Cities'
        formula: @aql count_distinct(thelook_users.city) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'city_count'
        format { type: 'number', pattern: '#,###0' }
      }
      settings { alignment: 'left' }
    }
  }
  block ge_net_sales: VizBlock {
    label: 'Net Sales'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        format { type: 'number', pattern: '[$$]#,###0' }
      }
      settings { alignment: 'left' }
    }
  }
  block ge_customers: VizBlock {
    label: 'Customers'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.customers)
        format { type: 'number', pattern: '#,###0' }
      }
      settings { alignment: 'left' }
    }
  }
  block ge_country: VizBlock {
    label: 'Net Sales by Country'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.country)
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            format { type: 'number', pattern: '[$$]#,###0' }
          }
          settings { color: '#2F4BD9' }
        }
      }
      settings {
        sort: LineFamilySort { type: 'yaxis', field_index: 0, direction: 'desc' }
        row_limit: 15
      }
    }
  }
  block ge_dc: VizBlock {
    label: 'Net Sales by Distribution Center'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_distribution_centers.name)
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            format { type: 'number', pattern: '[$$]#,###0' }
          }
          settings { color: '#1FA38A' }
        }
      }
      settings {
        sort: LineFamilySort { type: 'yaxis', field_index: 0, direction: 'desc' }
      }
    }
  }
  block ge_city: VizBlock {
    label: 'Top 10 Cities by Net Sales'
    viz: ColumnChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.city)
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            format { type: 'number', pattern: '[$$]#,###0' }
          }
          settings { color: '#2F4BD9' }
        }
      }
      settings {
        sort: LineFamilySort { type: 'yaxis', field_index: 0, direction: 'desc' }
        row_limit: 10
      }
    }
  }
  block ge_state_table: VizBlock {
    label: 'Sales by State'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull { ref: r(thelook_users.country) },
        VizFieldFull { ref: r(thelook_users.state) },
        VizFieldFull {
          ref: r(thelook.customers)
          format { type: 'number', pattern: '#,###0' }
        },
        VizFieldFull {
          ref: r(thelook.fulfilled_orders)
          format { type: 'number', pattern: '#,###0' }
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          format { type: 'number', pattern: '[$$]#,###0' }
        },
        VizFieldFull {
          ref: r(thelook.aov)
          format { type: 'number', pattern: '[$$]#,###0.00' }
        }
      ]
      settings {
        sorts: [IndexBasedSortSetting { field_index: 4, direction: 'desc' }]
        row_limit: 500
        pagination_size: 10
      }
    }
  }

  view: HTMLLayout {
    content: @html
      <style>
        .sp {
          --ink: #16213A;
          --muted: #6B7489;
          --line: #E3E6EE;
          --paper: #F5F6FA;
          --card: #FFFFFF;
          --accent: #2F4BD9;
          font-family: "Inter", "Segoe UI", system-ui, sans-serif;
          color: var(--ink);
          background: var(--paper);
          padding: 28px 32px 40px;
          min-height: 100%;
          box-sizing: border-box;
        }
        .sp * { box-sizing: border-box; }

        .sp-head {
          display: flex;
          align-items: flex-end;
          justify-content: space-between;
          gap: 24px;
          padding-bottom: 20px;
        }
        .sp-eyebrow {
          font-size: 11px;
          font-weight: 600;
          letter-spacing: .12em;
          text-transform: uppercase;
          color: var(--accent);
          margin: 0 0 6px;
        }
        .sp-title {
          font-size: 28px;
          font-weight: 700;
          letter-spacing: -.01em;
          margin: 0;
        }
        .sp-sub { font-size: 13px; color: var(--muted); margin: 6px 0 0; }

        .sp-filters {
          display: grid;
          grid-template-columns: repeat(4, minmax(0, 1fr));
          gap: 12px;
          background: var(--card);
          border: 1px solid var(--line);
          border-radius: 12px;
          padding: 12px 14px;
          margin-bottom: 18px;
        }
        .sp-filter { height: 64px; }

        .sp-tabs {
          display: flex;
          gap: 4px;
          border-bottom: 1px solid var(--line);
          margin-bottom: 22px;
        }
        .sp-tabs a {
          padding: 10px 16px 12px;
          font-size: 14px;
          font-weight: 600;
          color: var(--muted);
          text-decoration: none;
          border-bottom: 2px solid transparent;
          margin-bottom: -1px;
          transition: color .15s, border-color .15s;
        }
        .sp-tabs a:hover { color: var(--ink); }

        .sp-panel { display: none; }
        .sp-panel:target { display: block; }
        .sp:not(:has(.sp-panel:target)) #overview { display: block; }

        .sp:not(:has(.sp-panel:target)) .sp-tabs a[href="#overview"],
        .sp:has(#overview:target) .sp-tabs a[href="#overview"],
        .sp:has(#products:target) .sp-tabs a[href="#products"],
        .sp:has(#customers:target) .sp-tabs a[href="#customers"],
        .sp:has(#geography:target) .sp-tabs a[href="#geography"] {
          color: var(--ink);
          border-bottom-color: var(--accent);
        }

        .sp-section-title {
          font-size: 13px;
          font-weight: 600;
          color: var(--muted);
          margin: 0 0 12px;
        }
        .sp-kpis {
          display: grid;
          grid-template-columns: repeat(4, minmax(0, 1fr));
          gap: 16px;
          margin-bottom: 16px;
        }
        .sp-grid {
          display: grid;
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 16px;
        }
        .sp-card {
          background: var(--card);
          border: 1px solid var(--line);
          border-radius: 12px;
          overflow: hidden;
        }
        .sp-kpi { height: 120px; border-top: 3px solid var(--accent); }
        .sp-chart { height: 360px; }
        .sp-wide { grid-column: 1 / -1; height: 440px; }

        @media (max-width: 1000px) {
          .sp-filters, .sp-kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
          .sp-grid { grid-template-columns: 1fr; }
        }
      </style>

      <div class="sp">
        <header class="sp-head">
          <div>
            <p class="sp-eyebrow">TheLook eCommerce</p>
            <h1 class="sp-title">Sales Performance</h1>
            <p class="sp-sub">Net sales exclude cancelled and returned items. Filters apply to every tab.</p>
          </div>
        </header>

        <div class="sp-filters">
          <div class="sp-filter"><h-block name="f_date" /></div>
          <div class="sp-filter"><h-block name="f_country" /></div>
          <div class="sp-filter"><h-block name="f_department" /></div>
          <div class="sp-filter"><h-block name="f_category" /></div>
        </div>

        <nav class="sp-tabs">
          <a href="#overview">Overview</a>
          <a href="#products">Products</a>
          <a href="#customers">Customers</a>
          <a href="#geography">Geography</a>
        </nav>

        <section id="overview" class="sp-panel">
          <div class="sp-kpis">
            <div class="sp-card sp-kpi"><h-block name="ov_net_sales" /></div>
            <div class="sp-card sp-kpi"><h-block name="ov_gross_profit" /></div>
            <div class="sp-card sp-kpi"><h-block name="ov_gross_margin" /></div>
            <div class="sp-card sp-kpi"><h-block name="ov_orders" /></div>
          </div>
          <div class="sp-grid">
            <div class="sp-card sp-wide"><h-block name="ov_trend" /></div>
            <div class="sp-card sp-chart"><h-block name="ov_department" /></div>
            <div class="sp-card sp-chart"><h-block name="ov_status" /></div>
            <div class="sp-card sp-wide"><h-block name="ov_aov_trend" /></div>
          </div>
        </section>

        <section id="products" class="sp-panel">
          <div class="sp-kpis">
            <div class="sp-card sp-kpi"><h-block name="pr_items_sold" /></div>
            <div class="sp-card sp-kpi"><h-block name="pr_net_sales" /></div>
            <div class="sp-card sp-kpi"><h-block name="pr_cogs" /></div>
            <div class="sp-card sp-kpi"><h-block name="pr_return_rate" /></div>
          </div>
          <div class="sp-grid">
            <div class="sp-card sp-chart"><h-block name="pr_category" /></div>
            <div class="sp-card sp-chart"><h-block name="pr_brand" /></div>
            <div class="sp-card sp-wide"><h-block name="pr_margin" /></div>
            <div class="sp-card sp-wide"><h-block name="pr_top_products" /></div>
          </div>
        </section>

        <section id="customers" class="sp-panel">
          <div class="sp-kpis">
            <div class="sp-card sp-kpi"><h-block name="cu_customers" /></div>
            <div class="sp-card sp-kpi"><h-block name="cu_orders" /></div>
            <div class="sp-card sp-kpi"><h-block name="cu_aov" /></div>
            <div class="sp-card sp-kpi"><h-block name="cu_sales_per_customer" /></div>
          </div>
          <div class="sp-grid">
            <div class="sp-card sp-chart"><h-block name="cu_traffic" /></div>
            <div class="sp-card sp-chart"><h-block name="cu_gender" /></div>
            <div class="sp-card sp-wide"><h-block name="cu_age" /></div>
            <div class="sp-card sp-wide"><h-block name="cu_top_customers" /></div>
          </div>
        </section>

        <section id="geography" class="sp-panel">
          <div class="sp-kpis">
            <div class="sp-card sp-kpi"><h-block name="ge_countries" /></div>
            <div class="sp-card sp-kpi"><h-block name="ge_cities" /></div>
            <div class="sp-card sp-kpi"><h-block name="ge_net_sales" /></div>
            <div class="sp-card sp-kpi"><h-block name="ge_customers" /></div>
          </div>
          <div class="sp-grid">
            <div class="sp-card sp-chart"><h-block name="ge_country" /></div>
            <div class="sp-card sp-chart"><h-block name="ge_dc" /></div>
            <div class="sp-card sp-wide"><h-block name="ge_city" /></div>
            <div class="sp-card sp-wide"><h-block name="ge_state_table" /></div>
          </div>
        </section>
      </div>
    ;;
  }

  theme: H.themes.vanilla
}
