  // ---------------------------------------------------------------------------
  // Layout
  // ---------------------------------------------------------------------------
  view: HTMLLayout {
    content: @html
      <style>
        .sp {
          --bg: #f5f7fb;
          --surface: #ffffff;
          --text: #1f2937;
          --muted: #6b7280;
          --border: #e2e8f0;
          --accent: #2563eb;
          --gap: 16px;
          min-height: 100%;
          padding: 24px;
          background: var(--bg);
          color: var(--text);
          font-family: inherit;
          display: flex;
          flex-direction: column;
        }
        .sp * { box-sizing: border-box; }

        .sp .sp-header { order: 1; margin-bottom: 16px; }
        .sp .sp-header h1 { margin: 0; font-size: 24px; font-weight: 700; }
        .sp .sp-header p { margin: 4px 0 0; color: var(--muted); font-size: 14px; }

        .sp .sp-filters {
          order: 2;
          display: grid;
          grid-template-columns: repeat(5, minmax(0, 1fr));
          gap: 12px;
          padding: 12px;
          margin-bottom: 16px;
          background: var(--surface);
          border: 1px solid var(--border);
          border-radius: 10px;
        }
        .sp .sp-filters > div { min-height: 64px; }

        /* Tabs nav is placed after panels in markup (for sibling selectors) but shown above them */
        .sp .sp-tabs {
          order: 3;
          display: flex;
          gap: 4px;
          border-bottom: 1px solid var(--border);
          margin-bottom: 20px;
        }
        .sp .sp-tab {
          padding: 10px 16px;
          color: var(--muted);
          font-weight: 600;
          font-size: 14px;
          text-decoration: none;
          border-bottom: 3px solid transparent;
          margin-bottom: -1px;
        }
        .sp .sp-tab:hover { color: var(--text); }

        .sp .sp-panel { order: 4; display: none; }
        .sp .sp-panel:target { display: block; }
        .sp:not(:has(.sp-panel:target)) #sp-overview { display: block; }

        .sp:has(#sp-overview:target) .sp-tab[href="#sp-overview"],
        .sp:has(#sp-products:target) .sp-tab[href="#sp-products"],
        .sp:has(#sp-customers:target) .sp-tab[href="#sp-customers"],
        .sp:has(#sp-geography:target) .sp-tab[href="#sp-geography"],
        .sp:not(:has(.sp-panel:target)) .sp-tab[href="#sp-overview"] {
          color: var(--accent);
          border-bottom-color: var(--accent);
        }

        .sp .sp-section-title {
          margin: 0 0 12px;
          font-size: 13px;
          font-weight: 600;
          letter-spacing: .04em;
          text-transform: uppercase;
          color: var(--muted);
        }

        .sp .sp-kpis {
          display: grid;
          grid-template-columns: repeat(4, minmax(0, 1fr));
          gap: var(--gap);
          margin-bottom: var(--gap);
        }
        .sp .sp-kpis.six { grid-template-columns: repeat(6, minmax(0, 1fr)); }

        .sp .sp-grid {
          display: grid;
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: var(--gap);
          margin-bottom: var(--gap);
        }
        .sp .sp-grid.wide-left { grid-template-columns: 2fr 1fr; }

        .sp .sp-card {
          background: var(--surface);
          border: 1px solid var(--border);
          border-radius: 10px;
          box-shadow: 0 1px 2px rgba(15, 23, 42, .04);
          overflow: hidden;
          height: 380px;
        }
        .sp .sp-card.kpi { height: 120px; }
        .sp .sp-card.tall { height: 460px; }

        @media (max-width: 1000px) {
          .sp .sp-kpis, .sp .sp-kpis.six { grid-template-columns: repeat(2, minmax(0, 1fr)); }
          .sp .sp-grid, .sp .sp-grid.wide-left { grid-template-columns: 1fr; }
          .sp .sp-filters { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        }
      </style>

      <div class="sp">
        <header class="sp-header">
          <h1>Sales Performance</h1>
          <p>TheLook eCommerce &middot; Filters apply to every tab</p>
        </header>

        <div class="sp-filters">
          <div><h-block name="f_order_date" /></div>
          <div><h-block name="f_department" /></div>
          <div><h-block name="f_category" /></div>
          <div><h-block name="f_country" /></div>
          <div><h-block name="f_traffic_source" /></div>
        </div>

        <!-- Overview -->
        <section id="sp-overview" class="sp-panel">
          <h2 class="sp-section-title">Headline metrics</h2>
          <div class="sp-kpis six">
            <div class="sp-card kpi"><h-block name="ov_net_sales" /></div>
            <div class="sp-card kpi"><h-block name="ov_gross_profit" /></div>
            <div class="sp-card kpi"><h-block name="ov_gross_margin" /></div>
            <div class="sp-card kpi"><h-block name="ov_orders" /></div>
            <div class="sp-card kpi"><h-block name="ov_aov" /></div>
            <div class="sp-card kpi"><h-block name="ov_return_rate" /></div>
          </div>
          <h2 class="sp-section-title">Trends</h2>
          <div class="sp-grid wide-left">
            <div class="sp-card"><h-block name="ov_sales_trend" /></div>
            <div class="sp-card"><h-block name="ov_sales_by_department" /></div>
          </div>
          <div class="sp-grid wide-left">
            <div class="sp-card"><h-block name="ov_orders_trend" /></div>
            <div class="sp-card"><h-block name="ov_sales_by_status" /></div>
          </div>
        </section>

        <!-- Products -->
        <section id="sp-products" class="sp-panel">
          <h2 class="sp-section-title">Product metrics</h2>
          <div class="sp-kpis">
            <div class="sp-card kpi"><h-block name="pr_items_sold" /></div>
            <div class="sp-card kpi"><h-block name="pr_cogs" /></div>
            <div class="sp-card kpi"><h-block name="pr_gross_margin" /></div>
            <div class="sp-card kpi"><h-block name="pr_units_in_stock" /></div>
          </div>
          <h2 class="sp-section-title">Categories</h2>
          <div class="sp-grid">
            <div class="sp-card tall"><h-block name="pr_sales_by_category" /></div>
            <div class="sp-card tall"><h-block name="pr_margin_by_category" /></div>
          </div>
          <h2 class="sp-section-title">Best sellers</h2>
          <div class="sp-grid">
            <div class="sp-card"><h-block name="pr_top_brands" /></div>
            <div class="sp-card"><h-block name="pr_top_products" /></div>
          </div>
        </section>

        <!-- Customers -->
        <section id="sp-customers" class="sp-panel">
          <h2 class="sp-section-title">Customer metrics</h2>
          <div class="sp-kpis">
            <div class="sp-card kpi"><h-block name="cu_customers" /></div>
            <div class="sp-card kpi"><h-block name="cu_aov" /></div>
            <div class="sp-card kpi"><h-block name="cu_sessions" /></div>
            <div class="sp-card kpi"><h-block name="cu_conversion" /></div>
          </div>
          <h2 class="sp-section-title">Segments</h2>
          <div class="sp-grid wide-left">
            <div class="sp-card"><h-block name="cu_sales_by_traffic" /></div>
            <div class="sp-card"><h-block name="cu_sales_by_gender" /></div>
          </div>
          <h2 class="sp-section-title">Acquisition &amp; top customers</h2>
          <div class="sp-grid">
            <div class="sp-card"><h-block name="cu_new_customers" /></div>
            <div class="sp-card"><h-block name="cu_top_customers" /></div>
          </div>
        </section>

        <!-- Geography -->
        <section id="sp-geography" class="sp-panel">
          <h2 class="sp-section-title">Sales by location</h2>
          <div class="sp-grid wide-left">
            <div class="sp-card tall"><h-block name="geo_map" /></div>
            <div class="sp-card tall"><h-block name="geo_top_countries" /></div>
          </div>
          <h2 class="sp-section-title">Details</h2>
          <div class="sp-grid">
            <div class="sp-card"><h-block name="geo_country_table" /></div>
            <div class="sp-card"><h-block name="geo_top_cities" /></div>
          </div>
        </section>

        <nav class="sp-tabs">
          <a class="sp-tab" href="#sp-overview">Overview</a>
          <a class="sp-tab" href="#sp-products">Products</a>
          <a class="sp-tab" href="#sp-customers">Customers</a>
          <a class="sp-tab" href="#sp-geography">Geography</a>
        </nav>
      </div>
    ;;
  }
}
