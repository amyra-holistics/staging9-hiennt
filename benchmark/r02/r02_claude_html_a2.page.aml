Dashboard r02_claude_html_a2 {
  title: 'Sales Performance'
  description: 'TheLook sales performance across overview, products, customers and geography. Filters in the header apply to every tab.'

  // ---------------------------------------------------------------------------
  // Shared filters (rendered once in the header, apply to all tabs)
  // ---------------------------------------------------------------------------
  block f_date: FilterBlock {
    label: 'Order Date'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }
  block f_country: FilterBlock {
    label: 'Country'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.country)
    }
  }
  block f_department: FilterBlock {
    label: 'Department'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.department)
    }
  }
  block f_category: FilterBlock {
    label: 'Product Category'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.category)
    }
  }

  // ---------------------------------------------------------------------------
  // Overview tab
  // ---------------------------------------------------------------------------
  block ov_kpi_net_sales: VizBlock {
    label: 'Net Sales'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format { type: 'number', pattern: '[$$]#,###0' }
      }
      settings { display_mode: 'single', alignment: 'left' }
    }
  }
  block ov_kpi_gross_profit: VizBlock {
    label: 'Gross Profit'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_profit)
        label: 'Gross Profit'
        format { type: 'number', pattern: '[$$]#,###0' }
      }
      settings { display_mode: 'single', alignment: 'left' }
    }
  }
  block ov_kpi_orders: VizBlock {
    label: 'Fulfilled Orders'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        label: 'Fulfilled Orders'
        format { type: 'number', pattern: '#,###0' }
      }
      settings { display_mode: 'single', alignment: 'left' }
    }
  }
  block ov_kpi_aov: VizBlock {
    label: 'Average Order Value'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'
        format { type: 'number', pattern: '[$$]#,###0.00' }
      }
      settings { display_mode: 'single', alignment: 'left' }
    }
  }
  block ov_trend: VizBlock {
    label: 'Net Sales & Gross Profit by Month'
    viz: LineChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        label: 'Month'
        transformation: 'datetrunc month'
        format { type: 'date', pattern: 'LLL yyyy' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format { type: 'number', pattern: 'inherited' }
          }
          settings { color: '#2563EB' }
        }
        series {
          field: VizFieldFull {
            ref: r(thelook.gross_profit)
            label: 'Gross Profit'
            format { type: 'number', pattern: 'inherited' }
          }
          settings { color: '#10B981' }
        }
      }
      settings {
        sort: LineFamilySort { type: 'xaxis', direction: 'asc' }
        legend_label: 'top'
      }
    }
  }
  block ov_status: VizBlock {
    label: 'Order Items by Status'
    viz: PieChart {
      dataset: thelook
      legend: VizFieldFull {
        ref: r(thelook_order_items.status)
        label: 'Status'
        format { type: 'text' }
      }
      series {
        field: VizFieldFull {
          ref: r(thelook_order_items.id)
          label: 'Order Items'
          aggregation: 'count'
          format { type: 'number', pattern: '#,###0' }
        }
      }
      settings {
        display_as_donut: true
        legend_label: 'bottom'
        show_percentage: true
      }
    }
  }
  block ov_yearly: VizBlock {
    label: 'Net Sales by Year'
    viz: ColumnChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        label: 'Year'
        transformation: 'datetrunc year'
        format { type: 'date', pattern: 'yyyy' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format { type: 'number', pattern: 'inherited' }
          }
          settings { color: '#2563EB' }
        }
      }
      settings {
        sort: LineFamilySort { type: 'xaxis', direction: 'asc' }
        legend_label: 'hidden'
      }
    }
  }
  block ov_margin: VizBlock {
    label: 'Gross Margin by Year'
    viz: LineChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        label: 'Year'
        transformation: 'datetrunc year'
        format { type: 'date', pattern: 'yyyy' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.gross_margin)
            label: 'Gross Margin'
            format { type: 'number', pattern: 'inherited' }
          }
          settings { color: '#10B981' }
        }
      }
      settings {
        sort: LineFamilySort { type: 'xaxis', direction: 'asc' }
        legend_label: 'hidden'
      }
    }
  }

  // ---------------------------------------------------------------------------
  // Products tab
  // ---------------------------------------------------------------------------
  block pr_kpi_items: VizBlock {
    label: 'Items Sold'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.items_sold)
        label: 'Items Sold'
        format { type: 'number', pattern: '#,###0' }
      }
      settings { display_mode: 'single', alignment: 'left' }
    }
  }
  block pr_kpi_products: VizBlock {
    label: 'Products Sold'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      calculation products_sold {
        label: 'Products Sold'
        formula: @aql thelook_order_items | count_distinct(thelook_products.id) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'products_sold'
        label: 'Distinct Products Sold'
        format { type: 'number', pattern: '#,###0' }
      }
      settings { display_mode: 'single', alignment: 'left' }
    }
  }
  block pr_kpi_margin: VizBlock {
    label: 'Gross Margin'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format { type: 'number', pattern: '#,###0.0%' }
      }
      settings { display_mode: 'single', alignment: 'left' }
    }
  }
  block pr_kpi_return: VizBlock {
    label: 'Return Rate'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.return_rate)
        label: 'Return Rate'
        format { type: 'number', pattern: '#,###0.0%' }
      }
      settings { display_mode: 'single', alignment: 'left' }
    }
  }
  block pr_category: VizBlock {
    label: 'Net Sales by Product Category'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Category'
        format { type: 'text' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format { type: 'number', pattern: 'inherited' }
          }
          settings { color: '#2563EB' }
        }
      }
      settings {
        sort: LineFamilySort { type: 'yaxis', field_index: 0, direction: 'desc' }
        legend_label: 'hidden'
      }
    }
  }
  block pr_department: VizBlock {
    label: 'Net Sales by Department'
    viz: PieChart {
      dataset: thelook
      legend: VizFieldFull {
        ref: r(thelook_products.department)
        label: 'Department'
        format { type: 'text' }
      }
      series {
        field: VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format { type: 'number', pattern: 'inherited' }
        }
      }
      settings {
        display_as_donut: true
        legend_label: 'bottom'
        show_percentage: true
      }
    }
  }
  block pr_top_products: VizBlock {
    label: 'Top 10 Products by Net Sales'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          ref: r(thelook_products.name)
          label: 'Product'
          format { type: 'text' }
        },
        VizFieldFull {
          ref: r(thelook_products.brand)
          label: 'Brand'
          format { type: 'text' }
        },
        VizFieldFull {
          ref: r(thelook.items_sold)
          label: 'Items Sold'
          format { type: 'number', pattern: 'inherited' }
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format { type: 'number', pattern: 'inherited' }
        },
        VizFieldFull {
          ref: r(thelook.gross_margin)
          label: 'Gross Margin'
          format { type: 'number', pattern: 'inherited' }
        }
      ]
      settings {
        sorts: [
          IndexBasedSortSetting { field_index: 3, direction: 'desc' }
        ]
        row_limit: 10
        pagination_size: 10
      }
    }
  }
  block pr_brands: VizBlock {
    label: 'Top 10 Brands by Net Sales'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.brand)
        label: 'Brand'
        format { type: 'text' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format { type: 'number', pattern: 'inherited' }
          }
          settings { color: '#10B981' }
        }
      }
      settings {
        sort: LineFamilySort { type: 'yaxis', field_index: 0, direction: 'desc' }
        row_limit: 10
        legend_label: 'hidden'
      }
    }
  }

  // ---------------------------------------------------------------------------
  // Customers tab
  // ---------------------------------------------------------------------------
  block cu_kpi_customers: VizBlock {
    label: 'Purchasing Customers'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      calculation purchasing_customers {
        label: 'Purchasing Customers'
        formula: @aql thelook_order_items | count_distinct(thelook_users.id) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'purchasing_customers'
        label: 'Purchasing Customers'
        format { type: 'number', pattern: '#,###0' }
      }
      settings { display_mode: 'single', alignment: 'left' }
    }
  }
  block cu_kpi_sales_per_customer: VizBlock {
    label: 'Net Sales per Customer'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      calculation sales_per_customer {
        label: 'Net Sales per Customer'
        formula: @aql safe_divide(net_sales, thelook_order_items | count_distinct(thelook_users.id)) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'sales_per_customer'
        label: 'Net Sales per Customer'
        format { type: 'number', pattern: '[$$]#,###0.00' }
      }
      settings { display_mode: 'single', alignment: 'left' }
    }
  }
  block cu_kpi_orders_per_customer: VizBlock {
    label: 'Orders per Customer'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      calculation orders_per_customer {
        label: 'Orders per Customer'
        formula: @aql safe_divide(fulfilled_orders, thelook_order_items | count_distinct(thelook_users.id)) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'orders_per_customer'
        label: 'Orders per Customer'
        format { type: 'number', pattern: '#,###0.00' }
      }
      settings { display_mode: 'single', alignment: 'left' }
    }
  }
  block cu_kpi_aov: VizBlock {
    label: 'Average Order Value'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'
        format { type: 'number', pattern: '[$$]#,###0.00' }
      }
      settings { display_mode: 'single', alignment: 'left' }
    }
  }
  block cu_trend: VizBlock {
    label: 'Purchasing Customers by Month'
    viz: LineChart {
      dataset: thelook
      calculation purchasing_customers {
        label: 'Purchasing Customers'
        formula: @aql thelook_order_items | count_distinct(thelook_users.id) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        label: 'Month'
        transformation: 'datetrunc month'
        format { type: 'date', pattern: 'LLL yyyy' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: 'purchasing_customers'
            label: 'Purchasing Customers'
            format { type: 'number', pattern: '#,###0' }
          }
          settings { color: '#2563EB' }
        }
      }
      settings {
        sort: LineFamilySort { type: 'xaxis', direction: 'asc' }
        legend_label: 'hidden'
      }
    }
  }
  block cu_gender: VizBlock {
    label: 'Net Sales by Gender'
    viz: PieChart {
      dataset: thelook
      legend: VizFieldFull {
        ref: r(thelook_users.gender)
        label: 'Gender'
        format { type: 'text' }
      }
      series {
        field: VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format { type: 'number', pattern: 'inherited' }
        }
      }
      settings {
        display_as_donut: true
        legend_label: 'bottom'
        show_percentage: true
      }
    }
  }
  block cu_age: VizBlock {
    label: 'Net Sales by Age Band'
    viz: ColumnChart {
      dataset: thelook
      calculation age_band {
        label: 'Age Band'
        formula: @aql case(
          when: thelook_users.age < 25, then: '0-24',
          when: thelook_users.age < 35, then: '25-34',
          when: thelook_users.age < 45, then: '35-44',
          when: thelook_users.age < 55, then: '45-54',
          else: '55+'
        ) ;;
        calc_type: 'dimension'
        data_type: 'text'
        model: thelook_users
      }
      x_axis: VizFieldFull {
        ref: 'age_band'
        label: 'Age Band'
        format { type: 'text' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format { type: 'number', pattern: 'inherited' }
          }
          settings { color: '#2563EB' }
        }
      }
      settings {
        sort: LineFamilySort { type: 'xaxis', direction: 'asc' }
        legend_label: 'hidden'
      }
    }
  }
  block cu_traffic: VizBlock {
    label: 'Net Sales by Traffic Source'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.traffic_source)
        label: 'Traffic Source'
        format { type: 'text' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format { type: 'number', pattern: 'inherited' }
          }
          settings { color: '#10B981' }
        }
      }
      settings {
        sort: LineFamilySort { type: 'yaxis', field_index: 0, direction: 'desc' }
        legend_label: 'hidden'
      }
    }
  }

  // ---------------------------------------------------------------------------
  // Geography tab
  // ---------------------------------------------------------------------------
  block geo_kpi_countries: VizBlock {
    label: 'Countries'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      calculation countries {
        label: 'Countries'
        formula: @aql thelook_order_items | count_distinct(thelook_users.country) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'countries'
        label: 'Countries with Sales'
        format { type: 'number', pattern: '#,###0' }
      }
      settings { display_mode: 'single', alignment: 'left' }
    }
  }
  block geo_kpi_states: VizBlock {
    label: 'States / Regions'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      calculation states {
        label: 'States / Regions'
        formula: @aql thelook_order_items | count_distinct(thelook_users.state) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'states'
        label: 'States / Regions with Sales'
        format { type: 'number', pattern: '#,###0' }
      }
      settings { display_mode: 'single', alignment: 'left' }
    }
  }
  block geo_kpi_cities: VizBlock {
    label: 'Cities'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      calculation cities {
        label: 'Cities'
        formula: @aql thelook_order_items | count_distinct(thelook_users.city) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'cities'
        label: 'Cities with Sales'
        format { type: 'number', pattern: '#,###0' }
      }
      settings { display_mode: 'single', alignment: 'left' }
    }
  }
  block geo_kpi_dcs: VizBlock {
    label: 'Distribution Centers'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      calculation dcs {
        label: 'Distribution Centers'
        formula: @aql thelook_order_items | count_distinct(thelook_distribution_centers.name) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'dcs'
        label: 'Distribution Centers Shipping'
        format { type: 'number', pattern: '#,###0' }
      }
      settings { display_mode: 'single', alignment: 'left' }
    }
  }
  block geo_map: VizBlock {
    label: 'Net Sales by Country (Map)'
    viz: FilledMap {
      dataset: thelook
      location {
        field: VizFieldFull {
          ref: r(thelook_users.country)
          label: 'Country'
          format { type: 'text' }
        }
        location_type: 'country'
        primary_field: true
      }
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format { type: 'number', pattern: 'inherited' }
      }
      settings {
        color_scale: 'vertical'
        map_background: 'light'
        value_colors {
          min { type: 'percentage', value: 0, color: '#DBEAFE' }
          max { type: 'percentage', value: 100, color: '#1D4ED8' }
        }
      }
    }
  }
  block geo_country: VizBlock {
    label: 'Net Sales by Country'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.country)
        label: 'Country'
        format { type: 'text' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format { type: 'number', pattern: 'inherited' }
          }
          settings { color: '#2563EB' }
        }
      }
      settings {
        sort: LineFamilySort { type: 'yaxis', field_index: 0, direction: 'desc' }
        legend_label: 'hidden'
      }
    }
  }
  block geo_states: VizBlock {
    label: 'Top 10 States / Regions by Net Sales'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          ref: r(thelook_users.country)
          label: 'Country'
          format { type: 'text' }
        },
        VizFieldFull {
          ref: r(thelook_users.state)
          label: 'State / Region'
          format { type: 'text' }
        },
        VizFieldFull {
          ref: r(thelook.fulfilled_orders)
          label: 'Fulfilled Orders'
          format { type: 'number', pattern: 'inherited' }
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format { type: 'number', pattern: 'inherited' }
        },
        VizFieldFull {
          ref: r(thelook.aov)
          label: 'AOV'
          format { type: 'number', pattern: 'inherited' }
        }
      ]
      settings {
        sorts: [
          IndexBasedSortSetting { field_index: 3, direction: 'desc' }
        ]
        row_limit: 10
        pagination_size: 10
      }
    }
  }
  block geo_dc: VizBlock {
    label: 'Net Sales by Distribution Center'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_distribution_centers.name)
        label: 'Distribution Center'
        format { type: 'text' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format { type: 'number', pattern: 'inherited' }
          }
          settings { color: '#10B981' }
        }
      }
      settings {
        sort: LineFamilySort { type: 'yaxis', field_index: 0, direction: 'desc' }
        legend_label: 'hidden'
      }
    }
  }

  // ---------------------------------------------------------------------------
  // Layout: CSS-only tabs (anchor links + :target). Header, tab bar and filter
  // bar sit outside the panels, so filters stay visible and apply on every tab.
  // Every panel uses the same structure: heading, 4 KPI cards, a 2:1 row and
  // a 1:1 row of charts.
  // ---------------------------------------------------------------------------
  view: HTMLLayout {
    content: @html
      <div class="sp">
        <style>
          .sp {
            display: flex;
            flex-direction: column;
            gap: 16px;
            padding: 20px 24px 32px;
            min-height: 600px;
            background: #F4F6FA;
            font-family: Inter, -apple-system, 'Segoe UI', Roboto, sans-serif;
            color: #0F172A;
          }
          .sp-header { order: 1; display: flex; align-items: flex-end; justify-content: space-between; }
          .sp-header h1 { margin: 0; font-size: 24px; font-weight: 700; }
          .sp-header p { margin: 4px 0 0; font-size: 13px; color: #64748B; }
          .sp-tabs {
            order: 2;
            display: flex;
            gap: 4px;
            border-bottom: 1px solid #E2E8F0;
          }
          .sp-tab {
            padding: 10px 18px;
            font-size: 14px;
            font-weight: 600;
            color: #64748B;
            text-decoration: none;
            border-bottom: 3px solid transparent;
            margin-bottom: -1px;
          }
          .sp-tab:hover { color: #0F172A; }
          .sp-filters {
            order: 3;
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 12px;
          }
          .sp-filter { height: 80px; }

          .sp-panel { order: 4; display: none; scroll-margin-top: 9999px; }
          .sp-panel:target { display: block; }
          .sp:not(:has(.sp-panel:target)) #sp-overview { display: block; }

          #sp-overview:target ~ .sp-tabs a[href="#sp-overview"],
          #sp-products:target ~ .sp-tabs a[href="#sp-products"],
          #sp-customers:target ~ .sp-tabs a[href="#sp-customers"],
          #sp-geography:target ~ .sp-tabs a[href="#sp-geography"],
          .sp:not(:has(.sp-panel:target)) .sp-tabs a[href="#sp-overview"] {
            color: #2563EB;
            border-bottom-color: #2563EB;
          }

          .sp-panel-head { margin: 4px 0 12px; }
          .sp-panel-head h2 { margin: 0; font-size: 18px; font-weight: 700; }
          .sp-panel-head p { margin: 2px 0 0; font-size: 13px; color: #64748B; }
          .sp-kpis {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 16px;
            margin-bottom: 16px;
          }
          .sp-kpi { height: 110px; }
          .sp-row {
            display: grid;
            gap: 16px;
            margin-bottom: 16px;
          }
          .sp-row.wide { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); }
          .sp-row.even { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
          .sp-chart { height: 380px; }

          @media (max-width: 900px) {
            .sp-filters, .sp-kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .sp-row.wide, .sp-row.even { grid-template-columns: minmax(0, 1fr); }
          }
        </style>

        <!-- Panels come before the tab bar in the DOM so ~ can highlight the active tab -->
        <section class="sp-panel" id="sp-overview">
          <div class="sp-panel-head">
            <h2>Overview</h2>
            <p>Headline sales, profit and order volume, and how they trend over time.</p>
          </div>
          <div class="sp-kpis">
            <div class="sp-kpi"><h-block name="ov_kpi_net_sales" /></div>
            <div class="sp-kpi"><h-block name="ov_kpi_gross_profit" /></div>
            <div class="sp-kpi"><h-block name="ov_kpi_orders" /></div>
            <div class="sp-kpi"><h-block name="ov_kpi_aov" /></div>
          </div>
          <div class="sp-row wide">
            <div class="sp-chart"><h-block name="ov_trend" /></div>
            <div class="sp-chart"><h-block name="ov_status" /></div>
          </div>
          <div class="sp-row even">
            <div class="sp-chart"><h-block name="ov_yearly" /></div>
            <div class="sp-chart"><h-block name="ov_margin" /></div>
          </div>
        </section>

        <section class="sp-panel" id="sp-products">
          <div class="sp-panel-head">
            <h2>Products</h2>
            <p>Which categories, departments, products and brands drive sales and margin.</p>
          </div>
          <div class="sp-kpis">
            <div class="sp-kpi"><h-block name="pr_kpi_items" /></div>
            <div class="sp-kpi"><h-block name="pr_kpi_products" /></div>
            <div class="sp-kpi"><h-block name="pr_kpi_margin" /></div>
            <div class="sp-kpi"><h-block name="pr_kpi_return" /></div>
          </div>
          <div class="sp-row wide">
            <div class="sp-chart"><h-block name="pr_category" /></div>
            <div class="sp-chart"><h-block name="pr_department" /></div>
          </div>
          <div class="sp-row even">
            <div class="sp-chart"><h-block name="pr_top_products" /></div>
            <div class="sp-chart"><h-block name="pr_brands" /></div>
          </div>
        </section>

        <section class="sp-panel" id="sp-customers">
          <div class="sp-panel-head">
            <h2>Customers</h2>
            <p>Who buys: customer counts, value per customer, demographics and acquisition channel.</p>
          </div>
          <div class="sp-kpis">
            <div class="sp-kpi"><h-block name="cu_kpi_customers" /></div>
            <div class="sp-kpi"><h-block name="cu_kpi_sales_per_customer" /></div>
            <div class="sp-kpi"><h-block name="cu_kpi_orders_per_customer" /></div>
            <div class="sp-kpi"><h-block name="cu_kpi_aov" /></div>
          </div>
          <div class="sp-row wide">
            <div class="sp-chart"><h-block name="cu_trend" /></div>
            <div class="sp-chart"><h-block name="cu_gender" /></div>
          </div>
          <div class="sp-row even">
            <div class="sp-chart"><h-block name="cu_age" /></div>
            <div class="sp-chart"><h-block name="cu_traffic" /></div>
          </div>
        </section>

        <section class="sp-panel" id="sp-geography">
          <div class="sp-panel-head">
            <h2>Geography</h2>
            <p>Where sales come from, by customer country and state, and which distribution centers ship them.</p>
          </div>
          <div class="sp-kpis">
            <div class="sp-kpi"><h-block name="geo_kpi_countries" /></div>
            <div class="sp-kpi"><h-block name="geo_kpi_states" /></div>
            <div class="sp-kpi"><h-block name="geo_kpi_cities" /></div>
            <div class="sp-kpi"><h-block name="geo_kpi_dcs" /></div>
          </div>
          <div class="sp-row wide">
            <div class="sp-chart"><h-block name="geo_map" /></div>
            <div class="sp-chart"><h-block name="geo_country" /></div>
          </div>
          <div class="sp-row even">
            <div class="sp-chart"><h-block name="geo_states" /></div>
            <div class="sp-chart"><h-block name="geo_dc" /></div>
          </div>
        </section>

        <header class="sp-header">
          <div>
            <h1>Sales Performance</h1>
            <p>TheLook eCommerce &middot; Net Sales exclude Cancelled and Returned items</p>
          </div>
        </header>

        <nav class="sp-tabs">
          <a class="sp-tab" href="#sp-overview">Overview</a>
          <a class="sp-tab" href="#sp-products">Products</a>
          <a class="sp-tab" href="#sp-customers">Customers</a>
          <a class="sp-tab" href="#sp-geography">Geography</a>
        </nav>

        <div class="sp-filters">
          <div class="sp-filter"><h-block name="f_date" /></div>
          <div class="sp-filter"><h-block name="f_country" /></div>
          <div class="sp-filter"><h-block name="f_department" /></div>
          <div class="sp-filter"><h-block name="f_category" /></div>
        </div>
      </div>
    ;;
  }

  theme: PageTheme {
    background { bg_color: '#F4F6FA' }
    block {
      background { bg_color: '#FFFFFF' }
      border {
        border_width: 1
        border_radius: 10
        border_color: '#E2E8F0'
        border_style: 'solid'
      }
      padding: 12
      shadow: 'none'
      label {
        font_size: 14
        font_weight: 'semibold'
        font_color: '#0F172A'
      }
    }
  }
}
