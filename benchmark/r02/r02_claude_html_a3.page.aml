Dashboard r02_claude_html_a3 {
  title: 'Sales Performance'
  description: 'TheLook eCommerce sales performance across overview, products, customers and geography.'

  // ---------------------------------------------------------------- Filters (shared by every tab)
  block f_order_date: FilterBlock {
    label: 'Order Date'
    type: 'date'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block f_department: FilterBlock {
    label: 'Department'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.department)
    }
    settings {
      input_type: 'multiple'
    }
  }

  block f_category: FilterBlock {
    label: 'Category'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.category)
    }
    settings {
      input_type: 'multiple'
    }
  }

  block f_country: FilterBlock {
    label: 'Country'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.country)
    }
    settings {
      input_type: 'multiple'
    }
  }

  // ---------------------------------------------------------------- Overview
  block ov_kpi_net_sales: VizBlock {
    label: 'Net Sales'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
  }

  block ov_kpi_gross_profit: VizBlock {
    label: 'Gross Profit'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_profit)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
  }

  block ov_kpi_margin: VizBlock {
    label: 'Gross Margin'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
  }

  block ov_kpi_orders: VizBlock {
    label: 'Fulfilled Orders'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
  }

  block ov_kpi_aov: VizBlock {
    label: 'Average Order Value'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
  }

  block ov_kpi_return_rate: VizBlock {
    label: 'Return Rate'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.return_rate)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
  }

  block ov_trend: VizBlock {
    label: 'Monthly Net Sales & Gross Profit'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        label: 'Month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        label: 'Sales'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#2563EB'
          }
        }
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.gross_profit)
            label: 'Gross Profit'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#F59E0B'
          }
        }
      }
      settings {
        legend_label: 'top'
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block ov_by_status: VizBlock {
    label: 'Gross Sales by Item Status'
    viz: PieChart {
      dataset: thelook
      legend: VizFieldFull {
        ref: r(thelook_order_items.status)
        format {
          type: 'text'
        }
      }
      series {
        field: VizFieldFull {
          ref: r(thelook.gross_sales)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      }
    }
  }

  // ---------------------------------------------------------------- Products
  block pr_kpi_items: VizBlock {
    label: 'Items Sold'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.items_sold)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
  }

  block pr_kpi_cogs: VizBlock {
    label: 'COGS'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.cogs)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
  }

  block pr_kpi_margin: VizBlock {
    label: 'Gross Margin'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
  }

  block pr_kpi_asp: VizBlock {
    label: 'Average Selling Price'
    viz: MetricKpi {
      dataset: thelook
      calculation avg_selling_price {
        label: 'Average Selling Price'
        formula: @aql safe_divide(net_sales, items_sold) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'avg_selling_price'
        format {
          type: 'number'
          pattern: '[$$]#,###0.00'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
  }

  block pr_by_category: VizBlock {
    label: 'Net Sales by Category'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Category'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#2563EB'
          }
        }
      }
      settings {
        legend_label: 'hidden'
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block pr_by_brand: VizBlock {
    label: 'Top 10 Brands by Net Sales'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.brand)
        label: 'Brand'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#2563EB'
          }
        }
      }
      settings {
        legend_label: 'hidden'
        row_limit: 10
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block pr_top_products: VizBlock {
    label: 'Top Products'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          ref: r(thelook_products.name)
          label: 'Product'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(thelook_products.brand)
          label: 'Brand'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(thelook_products.category)
          label: 'Category'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(thelook.items_sold)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.gross_margin)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        row_limit: 50
        pagination_size: 10
        sorts: [
          IndexBasedSortSetting {
            field_index: 4
            direction: 'desc'
          }
        ]
      }
    }
  }

  // ---------------------------------------------------------------- Customers
  block cu_kpi_customers: VizBlock {
    label: 'Purchasing Customers'
    viz: MetricKpi {
      dataset: thelook
      calculation purchasing_customers {
        label: 'Purchasing Customers'
        formula: @aql thelook_order_items | count_distinct(thelook_users.id) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'purchasing_customers'
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
  }

  block cu_kpi_sales_per_customer: VizBlock {
    label: 'Net Sales per Customer'
    viz: MetricKpi {
      dataset: thelook
      calculation sales_per_customer {
        label: 'Net Sales per Customer'
        formula: @aql safe_divide(net_sales, thelook_order_items | count_distinct(thelook_users.id)) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'sales_per_customer'
        format {
          type: 'number'
          pattern: '[$$]#,###0.00'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
  }

  block cu_kpi_aov: VizBlock {
    label: 'Average Order Value'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
  }

  block cu_kpi_orders_per_customer: VizBlock {
    label: 'Orders per Customer'
    viz: MetricKpi {
      dataset: thelook
      calculation orders_per_customer {
        label: 'Orders per Customer'
        formula: @aql safe_divide(fulfilled_orders, thelook_order_items | count_distinct(thelook_users.id)) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'orders_per_customer'
        format {
          type: 'number'
          pattern: '#,###0.00'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
  }

  block cu_monthly: VizBlock {
    label: 'Monthly Purchasing Customers'
    viz: LineChart {
      dataset: thelook
      calculation purchasing_customers {
        label: 'Purchasing Customers'
        formula: @aql thelook_order_items | count_distinct(thelook_users.id) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        label: 'Month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: 'purchasing_customers'
            label: 'Purchasing Customers'
            format {
              type: 'number'
              pattern: '#,###0'
            }
          }
          settings {
            color: '#2563EB'
          }
        }
      }
      settings {
        legend_label: 'hidden'
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block cu_by_traffic: VizBlock {
    label: 'Net Sales by Traffic Source'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.traffic_source)
        label: 'Traffic Source'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#2563EB'
          }
        }
      }
      settings {
        legend_label: 'hidden'
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block cu_by_gender: VizBlock {
    label: 'Net Sales by Gender'
    viz: PieChart {
      dataset: thelook
      legend: VizFieldFull {
        ref: r(thelook_users.gender)
        format {
          type: 'text'
        }
      }
      series {
        field: VizFieldFull {
          ref: r(thelook.net_sales)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      }
    }
  }

  block cu_top_customers: VizBlock {
    label: 'Top Customers'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          ref: r(thelook_users.first_name)
          label: 'First Name'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(thelook_users.last_name)
          label: 'Last Name'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(thelook_users.country)
          label: 'Country'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(thelook.fulfilled_orders)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        row_limit: 50
        pagination_size: 10
        sorts: [
          IndexBasedSortSetting {
            field_index: 4
            direction: 'desc'
          }
        ]
      }
    }
  }

  // ---------------------------------------------------------------- Geography
  block geo_kpi_countries: VizBlock {
    label: 'Countries with Sales'
    viz: MetricKpi {
      dataset: thelook
      calculation countries_with_sales {
        label: 'Countries with Sales'
        formula: @aql thelook_order_items | count_distinct(thelook_users.country) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'countries_with_sales'
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
  }

  block geo_kpi_net_sales: VizBlock {
    label: 'Net Sales'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
  }

  block geo_kpi_orders: VizBlock {
    label: 'Fulfilled Orders'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
  }

  block geo_kpi_aov: VizBlock {
    label: 'Average Order Value'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
  }

  block geo_map: VizBlock {
    label: 'Net Sales by Country'
    viz: FilledMap {
      dataset: thelook
      location {
        field: VizFieldFull {
          ref: r(thelook_users.country)
          format {
            type: 'text'
          }
        }
        location_type: 'country'
      }
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        color_scale: 'vertical'
        map_background: 'light'
        value_colors {
          min {
            color: '#DBEAFE'
          }
          max {
            color: '#1E40AF'
          }
        }
      }
    }
  }

  block geo_by_country: VizBlock {
    label: 'Country Performance'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          ref: r(thelook_users.country)
          label: 'Country'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(thelook.fulfilled_orders)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.aov)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.gross_margin)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        pagination_size: 10
        sorts: [
          IndexBasedSortSetting {
            field_index: 2
            direction: 'desc'
          }
        ]
      }
    }
  }

  block geo_top_states: VizBlock {
    label: 'Top 10 States by Net Sales'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.state)
        label: 'State'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#2563EB'
          }
        }
      }
      settings {
        legend_label: 'hidden'
        row_limit: 10
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  // ---------------------------------------------------------------- Layout
  view: HTMLLayout {
    content: @html
      <style>
        .sp {
          --sp-bg: #F4F6FA;
          --sp-card: #FFFFFF;
          --sp-border: #E3E8EF;
          --sp-text: #0F172A;
          --sp-muted: #64748B;
          --sp-accent: #2563EB;
          background: var(--sp-bg);
          color: var(--sp-text);
          font-family: Inter, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
          padding: 20px 24px 32px;
          min-height: 100%;
          box-sizing: border-box;
          display: flex;
          flex-direction: column;
        }
        .sp * { box-sizing: border-box; }

        /* Header + tabs + filters keep the same position on every tab */
        .sp-header { order: 1; display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin-bottom: 12px; }
        .sp-title { margin: 0; font-size: 22px; font-weight: 700; letter-spacing: -0.01em; }
        .sp-subtitle { margin: 2px 0 0; font-size: 13px; color: var(--sp-muted); }

        .sp-tabs { order: 2; display: flex; gap: 4px; border-bottom: 1px solid var(--sp-border); margin-bottom: 16px; }
        .sp-tab {
          padding: 10px 16px;
          font-size: 14px;
          font-weight: 600;
          color: var(--sp-muted);
          text-decoration: none;
          border-bottom: 2px solid transparent;
          margin-bottom: -1px;
        }
        .sp-tab:hover { color: var(--sp-text); }

        .sp-filters {
          order: 3;
          display: grid;
          grid-template-columns: repeat(4, minmax(0, 1fr));
          gap: 12px;
          background: var(--sp-card);
          border: 1px solid var(--sp-border);
          border-radius: 10px;
          padding: 8px 12px;
          margin-bottom: 16px;
        }
        .sp-filter { min-height: 64px; }

        .sp-panels { order: 4; }
        .sp-panel { display: none; scroll-margin-top: 9999px; }
        .sp-panel:target { display: block; }
        .sp:not(:has(.sp-panel:target)) #sp-overview { display: block; }

        /* Active tab */
        .sp:has(#sp-overview:target) .sp-tab[href="#sp-overview"],
        .sp:has(#sp-products:target) .sp-tab[href="#sp-products"],
        .sp:has(#sp-customers:target) .sp-tab[href="#sp-customers"],
        .sp:has(#sp-geography:target) .sp-tab[href="#sp-geography"],
        .sp:not(:has(.sp-panel:target)) .sp-tab[href="#sp-overview"] {
          color: var(--sp-accent);
          border-bottom-color: var(--sp-accent);
        }

        .sp-section-title { margin: 0 0 4px; font-size: 16px; font-weight: 700; }
        .sp-section-desc { margin: 0 0 14px; font-size: 13px; color: var(--sp-muted); }

        .sp-kpis { display: grid; gap: 12px; margin-bottom: 12px; }
        .sp-kpis-6 { grid-template-columns: repeat(6, minmax(0, 1fr)); }
        .sp-kpis-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
        .sp-kpi {
          height: 112px;
          background: var(--sp-card);
          border: 1px solid var(--sp-border);
          border-top: 3px solid var(--sp-accent);
          border-radius: 10px;
          overflow: hidden;
        }

        .sp-grid { display: grid; gap: 12px; margin-bottom: 12px; }
        .sp-grid-2-1 { grid-template-columns: 2fr 1fr; }
        .sp-grid-1-1 { grid-template-columns: 1fr 1fr; }
        .sp-card {
          background: var(--sp-card);
          border: 1px solid var(--sp-border);
          border-radius: 10px;
          overflow: hidden;
        }
        .sp-h-md { height: 380px; }
        .sp-h-lg { height: 460px; }

        @media (max-width: 1100px) {
          .sp-kpis-6 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
          .sp-filters { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        }
        @media (max-width: 760px) {
          .sp-kpis-6, .sp-kpis-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
          .sp-grid-2-1, .sp-grid-1-1, .sp-filters { grid-template-columns: 1fr; }
        }
      </style>

      <div class="sp">
        <div class="sp-panels">
          <!-- ============ Overview ============ -->
          <section class="sp-panel" id="sp-overview">
            <h2 class="sp-section-title">Overview</h2>
            <p class="sp-section-desc">Headline sales, profitability and order health.</p>
            <div class="sp-kpis sp-kpis-6">
              <div class="sp-kpi"><h-block name="ov_kpi_net_sales" /></div>
              <div class="sp-kpi"><h-block name="ov_kpi_gross_profit" /></div>
              <div class="sp-kpi"><h-block name="ov_kpi_margin" /></div>
              <div class="sp-kpi"><h-block name="ov_kpi_orders" /></div>
              <div class="sp-kpi"><h-block name="ov_kpi_aov" /></div>
              <div class="sp-kpi"><h-block name="ov_kpi_return_rate" /></div>
            </div>
            <div class="sp-grid sp-grid-2-1">
              <div class="sp-card sp-h-lg"><h-block name="ov_trend" /></div>
              <div class="sp-card sp-h-lg"><h-block name="ov_by_status" /></div>
            </div>
          </section>

          <!-- ============ Products ============ -->
          <section class="sp-panel" id="sp-products">
            <h2 class="sp-section-title">Products</h2>
            <p class="sp-section-desc">What sells: categories, brands and top products.</p>
            <div class="sp-kpis sp-kpis-4">
              <div class="sp-kpi"><h-block name="pr_kpi_items" /></div>
              <div class="sp-kpi"><h-block name="pr_kpi_cogs" /></div>
              <div class="sp-kpi"><h-block name="pr_kpi_margin" /></div>
              <div class="sp-kpi"><h-block name="pr_kpi_asp" /></div>
            </div>
            <div class="sp-grid sp-grid-1-1">
              <div class="sp-card sp-h-md"><h-block name="pr_by_category" /></div>
              <div class="sp-card sp-h-md"><h-block name="pr_by_brand" /></div>
            </div>
            <div class="sp-grid">
              <div class="sp-card sp-h-lg"><h-block name="pr_top_products" /></div>
            </div>
          </section>

          <!-- ============ Customers ============ -->
          <section class="sp-panel" id="sp-customers">
            <h2 class="sp-section-title">Customers</h2>
            <p class="sp-section-desc">Who buys, how often, and where they come from.</p>
            <div class="sp-kpis sp-kpis-4">
              <div class="sp-kpi"><h-block name="cu_kpi_customers" /></div>
              <div class="sp-kpi"><h-block name="cu_kpi_sales_per_customer" /></div>
              <div class="sp-kpi"><h-block name="cu_kpi_aov" /></div>
              <div class="sp-kpi"><h-block name="cu_kpi_orders_per_customer" /></div>
            </div>
            <div class="sp-grid sp-grid-2-1">
              <div class="sp-card sp-h-md"><h-block name="cu_monthly" /></div>
              <div class="sp-card sp-h-md"><h-block name="cu_by_gender" /></div>
            </div>
            <div class="sp-grid sp-grid-1-1">
              <div class="sp-card sp-h-lg"><h-block name="cu_by_traffic" /></div>
              <div class="sp-card sp-h-lg"><h-block name="cu_top_customers" /></div>
            </div>
          </section>

          <!-- ============ Geography ============ -->
          <section class="sp-panel" id="sp-geography">
            <h2 class="sp-section-title">Geography</h2>
            <p class="sp-section-desc">Where sales come from, by customer country and state.</p>
            <div class="sp-kpis sp-kpis-4">
              <div class="sp-kpi"><h-block name="geo_kpi_countries" /></div>
              <div class="sp-kpi"><h-block name="geo_kpi_net_sales" /></div>
              <div class="sp-kpi"><h-block name="geo_kpi_orders" /></div>
              <div class="sp-kpi"><h-block name="geo_kpi_aov" /></div>
            </div>
            <div class="sp-grid sp-grid-2-1">
              <div class="sp-card sp-h-lg"><h-block name="geo_map" /></div>
              <div class="sp-card sp-h-lg"><h-block name="geo_top_states" /></div>
            </div>
            <div class="sp-grid">
              <div class="sp-card sp-h-lg"><h-block name="geo_by_country" /></div>
            </div>
          </section>
        </div>

        <header class="sp-header">
          <div>
            <h1 class="sp-title">Sales Performance</h1>
            <p class="sp-subtitle">TheLook eCommerce &middot; Net sales exclude Cancelled and Returned items</p>
          </div>
        </header>

        <nav class="sp-tabs">
          <a class="sp-tab" href="#sp-overview">Overview</a>
          <a class="sp-tab" href="#sp-products">Products</a>
          <a class="sp-tab" href="#sp-customers">Customers</a>
          <a class="sp-tab" href="#sp-geography">Geography</a>
        </nav>

        <div class="sp-filters">
          <div class="sp-filter"><h-block name="f_order_date" /></div>
          <div class="sp-filter"><h-block name="f_department" /></div>
          <div class="sp-filter"><h-block name="f_category" /></div>
          <div class="sp-filter"><h-block name="f_country" /></div>
        </div>
      </div>
    ;;
  }

  theme {
    block {
      background {
        bg_color: 'transparent'
      }
      border {
        border_width: 0
      }
    }
  }
}
