      }

      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
        }
      }

      settings {
        row_limit: 15
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block products_return_by_category: VizBlock {
    label: 'Return Rate by Category'

    viz: BarChart {
