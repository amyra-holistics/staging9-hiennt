Dashboard r02_hai_canvas_a1 {
  title: 'Sales Performance'
  theme: H.themes.classic

  settings {
    timezone: 'UTC'
    autorun: true
    cache_duration: 3600
  }

  // ─────────────────────────────────────────────────────────────────────────────
  // Shared filter controls
  // ─────────────────────────────────────────────────────────────────────────────

  block f_date: FilterBlock {
    label: 'Order Date'
    type: 'date'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block f_country: FilterBlock {
    label: 'Customer Country'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.country)
    }
  }

  block f_category: FilterBlock {
    label: 'Product Category'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.category)
    }
  }

  // ─────────────────────────────────────────────────────────────────────────────
  // Overview tab blocks
  // ─────────────────────────────────────────────────────────────────────────────

  block overview_title: TextBlock {
    content: @md
# Sales Performance
Monitor commercial health, product performance, customer behavior, and geographic demand.
;;
  }

  block overview_net_sales: VizBlock {
    label: 'Net Sales'
    settings { hide_label: true }

    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: '[$$]#,###0'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block overview_fulfilled_orders: VizBlock {
    label: 'Fulfilled Orders'
    settings { hide_label: true }

    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        label: 'Fulfilled Orders'
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block overview_aov: VizBlock {
    label: 'Average Order Value'
    settings { hide_label: true }

    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'
        format {
          type: 'number'
          pattern: '[$$]#,###0.00'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block overview_margin: VizBlock {
    label: 'Gross Margin'
    settings { hide_label: true }

    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: '#,###0.0%'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block overview_trend_heading: TextBlock {
    content: @md
## Sales trend
;;
  }

  block overview_monthly_sales: VizBlock {
    label: 'Monthly Net Sales'

    viz: CombinationChart {
      dataset: thelook

      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        label: 'Month'
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }

      y_axis {
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
        }
      }

      settings {
        x_axis_label: 'Month'
        legend_label: 'hidden'
        show_data_points: false
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block overview_status_heading: TextBlock {
    content: @md
## Order-item status mix
;;
  }

  block overview_sales_by_status: VizBlock {
    label: 'Gross Sales by Status'

    viz: BarChart {
      dataset: thelook

      x_axis: VizFieldFull {
        ref: r(thelook_order_items.status)
        label: 'Order Item Status'
      }

      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.gross_sales)
            label: 'Gross Sales'
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
        }
      }

      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block overview_profit_by_status: VizBlock {
    label: 'Net Sales by Status'

    viz: BarChart {
      dataset: thelook

      x_axis: VizFieldFull {
        ref: r(thelook_order_items.status)
        label: 'Order Item Status'
      }

      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
        }
      }

      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

