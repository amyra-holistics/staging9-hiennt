        alignment: 'center'
      }
    }
  }

  block products_category_heading: TextBlock {
    content: @md
## Category performance
;;
  }

  block products_sales_by_category: VizBlock {
    label: 'Net Sales by Category'

    viz: BarChart {
      dataset: thelook

      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
