  // ─────────────────────────────────────────────────────────────────────────────
  // Shared interactions
  // ─────────────────────────────────────────────────────────────────────────────

  explicit_interactions: [
    FilterInteraction {
      from: 'f_date'
      to: [
        'overview_net_sales',
        'overview_fulfilled_orders',
        'overview_aov',
        'overview_margin',
        'overview_monthly_sales',
        'overview_sales_by_status',
        'overview_profit_by_status',
        'products_net_sales',
        'products_gross_profit',
        'products_items_sold',
        'products_return_rate',
        'products_sales_by_category',
        'products_profit_by_category',
        'products_sales_by_brand',
        'products_return_by_category',
        'customers_total',
        'customers_net_sales',
        'customers_orders',
        'customers_aov',
        'customers_sales_by_gender',
        'customers_count_by_country',
        'customers_sales_by_source',
        'customers_by_source',
        'geography_net_sales',
        'geography_orders',
        'geography_aov',
        'geography_margin',
        'geography_sales_by_country',
        'geography_orders_by_country',
        'geography_sales_by_state',
        'geography_margin_by_state',
      ]
      field: r(thelook_order_items.created_at)
    },

    FilterInteraction {
      from: 'f_country'
      to: [
        'overview_net_sales',
        'overview_fulfilled_orders',
        'overview_aov',
        'overview_margin',
        'overview_monthly_sales',
        'overview_sales_by_status',
        'overview_profit_by_status',
        'products_net_sales',
        'products_gross_profit',
        'products_items_sold',
        'products_return_rate',
        'products_sales_by_category',
        'products_profit_by_category',
        'products_sales_by_brand',
        'products_return_by_category',
        'customers_total',
        'customers_net_sales',
        'customers_orders',
        'customers_aov',
        'customers_sales_by_gender',
        'customers_count_by_country',
        'customers_sales_by_source',
        'customers_by_source',
        'geography_net_sales',
        'geography_orders',
        'geography_aov',
        'geography_margin',
        'geography_sales_by_country',
        'geography_orders_by_country',
        'geography_sales_by_state',
        'geography_margin_by_state',
      ]
      field: r(thelook_users.country)
    },

    FilterInteraction {
      from: 'f_category'
      to: [
        'overview_net_sales',
        'overview_fulfilled_orders',
        'overview_aov',
        'overview_margin',
        'overview_monthly_sales',
        'overview_sales_by_status',
        'overview_profit_by_status',
        'products_net_sales',
        'products_gross_profit',
        'products_items_sold',
        'products_return_rate',
        'products_sales_by_category',
        'products_profit_by_category',
        'products_sales_by_brand',
        'products_return_by_category',
        'customers_total',
        'customers_net_sales',
        'customers_orders',
        'customers_aov',
        'customers_sales_by_gender',
        'customers_count_by_country',
        'customers_sales_by_source',
        'customers_by_source',
        'geography_net_sales',
        'geography_orders',
        'geography_aov',
        'geography_margin',
        'geography_sales_by_country',
        'geography_orders_by_country',
        'geography_sales_by_state',
        'geography_margin_by_state',
      ]
      field: r(thelook_products.category)
    },
  ]

  // ─────────────────────────────────────────────────────────────────────────────
  // Canvas layout
  // ─────────────────────────────────────────────────────────────────────────────

  view: TabLayout {
    tab overview: CanvasLayout {
      label: 'Overview'
      width: 1220
      height: 1360
      grid_size: 20
