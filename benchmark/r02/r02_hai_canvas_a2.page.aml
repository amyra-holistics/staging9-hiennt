// Path: benchmark/r02/r02_hai_canvas_a2.page.aml

Dashboard r02_hai_canvas_a2 {
  title: 'Sales Performance'
  description: 'Sales performance dashboard across overview, products, customers, and geography.'
  theme: H.themes.classic

  // ---------- Shared filters ----------

  block f_date: FilterBlock {
    label: 'Activity Date'
    type: 'date'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block f_country: FilterBlock {
    label: 'Customer Country'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.country)
    }
  }

  block f_product_category: FilterBlock {
    label: 'Product Category'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.category)
    }
  }

  block f_gender: FilterBlock {
    label: 'Customer Gender'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.gender)
    }
  }

  // ---------- Overview ----------

  block t_overview: TextBlock {
    content: @md
# Sales Performance
Monitor revenue, profit, order volume, and customer value. Use the shared filters to analyze every tab in the same context.
    ;;
  }

  block t_overview_trend: TextBlock {
    content: @md
## Sales & Profit Trend
    ;;
  }

  block v_net_sales: VizBlock {
    label: 'Net Sales'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook

      calculation total_net_sales {
        label: 'Total Net Sales'
        formula: @aql net_sales | exclude_grains(thelook_order_items.created_at, keep_filters: true);;
        calc_type: 'measure'
        data_type: 'number'
      }

      calculation total_gross_profit {
        label: 'Total Gross Profit'
        formula: @aql gross_profit | exclude_grains(thelook_order_items.created_at, keep_filters: true);;
        calc_type: 'measure'
        data_type: 'number'
      }

      calculation total_fulfilled_orders {
        label: 'Total Fulfilled Orders'
        formula: @aql fulfilled_orders | exclude_grains(thelook_order_items.created_at, keep_filters: true);;
        calc_type: 'measure'
        data_type: 'number'
      }

      calculation total_average_order_value {
        label: 'Total Average Order Value'
        formula: @aql aov | exclude_grains(thelook_order_items.created_at, keep_filters: true);;
        calc_type: 'measure'
        data_type: 'number'
      }

      calculation total_return_rate {
        label: 'Total Return Rate'
        formula: @aql return_rate | exclude_grains(thelook_order_items.created_at, keep_filters: true);;
        calc_type: 'measure'
        data_type: 'number'
      }

      value: VizFieldFull {
        ref: 'total_net_sales'
        label: 'Total Net Sales'
        format {
          type: 'number'
          pattern: '[$$]#,###0'
        }
      }

      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block v_gross_profit: VizBlock {
    label: 'Gross Profit'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook

      calculation total_gross_profit {
        label: 'Total Gross Profit'
        formula: @aql gross_profit | exclude_grains(thelook_order_items.created_at, keep_filters: true);;
        calc_type: 'measure'
        data_type: 'number'
      }

      value: VizFieldFull {
        ref: 'total_gross_profit'
        label: 'Total Gross Profit'
        format {
          type: 'number'
          pattern: '[$$]#,###0'
        }
      }

      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block v_fulfilled_orders: VizBlock {
    label: 'Fulfilled Orders'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook

      calculation total_fulfilled_orders {
        label: 'Total Fulfilled Orders'
        formula: @aql fulfilled_orders | exclude_grains(thelook_order_items.created_at, keep_filters: true);;
        calc_type: 'measure'
        data_type: 'number'
      }

      value: VizFieldFull {
        ref: 'total_fulfilled_orders'
        label: 'Total Fulfilled Orders'
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }

      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block v_aov: VizBlock {
    label: 'Average Order Value'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook

      calculation total_average_order_value {
        label: 'Total Average Order Value'
        formula: @aql aov | exclude_grains(thelook_order_items.created_at, keep_filters: true);;
        calc_type: 'measure'
        data_type: 'number'
        format {
          type: 'number'
          pattern: '[$$]#,###0.00'
        }
      }

      value: VizFieldFull {
        ref: 'total_average_order_value'
        label: 'Total Average Order Value'
        format {
          type: 'number'
          pattern: '[$$]#,###0.00'
        }
      }

      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block v_monthly_sales: VizBlock {
    label: 'Monthly Sales and Gross Profit'
    viz: CombinationChart {
      dataset: thelook

      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        label: 'Order Item Created Month'
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }

      y_axis {
        label: 'Sales Performance'

        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Monthly Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }

        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.gross_profit)
            label: 'Monthly Gross Profit'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }

      settings {
        x_axis_label: 'Month'
        legend_label: 'bottom'
        show_data_points: true
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  // ---------- Products ----------

  block t_products: TextBlock {
    content: @md
# Product Performance
Identify the categories and brands generating the most sales and profit.
    ;;
  }

  block t_products_rank: TextBlock {
    content: @md
## Best-Selling Categories
    ;;
  }

  block v_product_categories: VizBlock {
    label: 'Top Product Categories by Net Sales'
    viz: CombinationChart {
      dataset: thelook

      calculation category_net_sales {
        label: 'Category Net Sales'
        formula: @aql net_sales | exclude_grains(thelook_products.brand);;
        calc_type: 'measure'
        data_type: 'number'
      }

      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Product Category'
      }

      y_axis {
        series {
          mark_type: 'bar'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }

      settings {
        row_limit: 10
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block v_product_detail: VizBlock {
    label: 'Product Category and Brand Performance'
    viz: DataTable {
      dataset: thelook

      calculation category_net_sales {
        label: 'Category Net Sales'
        formula: @aql net_sales | exclude_grains(thelook_products.brand);;
        calc_type: 'measure'
        data_type: 'number'
      }

      fields: [
        VizFieldFull {
          ref: r(thelook_products.category)
          label: 'Product Category'
          uname: 'product_category'
        },
        VizFieldFull {
          ref: r(thelook_products.brand)
          label: 'Product Brand'
          uname: 'product_brand'
        },
        VizFieldFull {
          ref: 'category_net_sales'
          label: 'Category Net Sales'
          format {
            type: 'number'
            pattern: '[$$]#,###0.00'
          }
          uname: 'category_net_sales'
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'net_sales'
        },
        VizFieldFull {
          ref: r(thelook.gross_profit)
          label: 'Gross Profit'
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'gross_profit'
        },
        VizFieldFull {
          ref: r(thelook.items_sold)
          label: 'Items Sold'
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'items_sold'
        },
        VizFieldFull {
          ref: r(thelook.return_rate)
          label: 'Return Rate'
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'return_rate'
        },
        VizFieldFull {
          ref: r(thelook.aov)
          label: 'Average Order Value'
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'average_order_value'
        },
      ]

      settings {
        pagination_size: 100
        show_row_number: true
        wrap_header_text: true
        sorts: [
          KeyBasedSortSetting {
            key: 'net_sales'
            direction: 'desc'
          },
          KeyBasedSortSetting {
            key: 'product_category'
            direction: 'asc'
          },
          KeyBasedSortSetting {
            key: 'product_brand'
            direction: 'asc'
          },
        ]
      }
    }
  }

  // ---------- Customers ----------

  block t_customers: TextBlock {
    content: @md
# Customer Performance
Track customer acquisition and compare customer segments by geography, gender, and age.
    ;;
  }

  block t_customers_acquisition: TextBlock {
    content: @md
## Customer Acquisition Trend
    ;;
  }

  block v_customer_acquisition: VizBlock {
    label: 'Monthly Registered Customer Count'
    viz: LineChart {
      dataset: thelook

      x_axis: VizFieldFull {
        label: 'Registration Month'
        ref: r(thelook_users.created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }

      y_axis {
        series {
          field: VizFieldFull {
            label: 'Registered Customer Count'
            ref: r(thelook.customers)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }

      settings {
        show_data_points: true
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block v_customer_detail: VizBlock {
    label: 'Customer Segmentation'
    viz: DataTable {
      dataset: thelook

      fields: [
        VizFieldFull {
          label: 'Acquisition Month'
          ref: r(thelook_users.created_at)
          transformation: 'datetrunc month'
          format {
            type: 'date'
            pattern: 'LLL yyyy'
          }
          uname: 'acquisition_month'
        },
        VizFieldFull {
          label: 'Customer Country'
          ref: r(thelook_users.country)
          format {
            type: 'text'
          }
          uname: 'customer_country'
        },
        VizFieldFull {
          label: 'Customer Gender'
          ref: r(thelook_users.gender)
          format {
            type: 'text'
          }
          uname: 'customer_gender'
        },
        VizFieldFull {
          label: 'Customer Age'
          ref: r(thelook_users.age)
          format {
            type: 'number'
            pattern: '#,###0'
          }
          uname: 'customer_age'
        },
        VizFieldFull {
          label: 'Net Sales'
          ref: r(thelook.net_sales)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'Fulfilled Orders'
          ref: r(thelook.fulfilled_orders)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'Customers'
          ref: r(thelook.customers)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'Average Order Value'
          ref: r(thelook.aov)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'Return Rate'
          ref: r(thelook.return_rate)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
      ]

      settings {
        pagination_size: 100
        show_row_number: true
        wrap_header_text: true
        wrap_cell_text: false
        sorts: [
          KeyBasedSortSetting {
            key: 'acquisition_month'
            direction: 'asc'
          },
          KeyBasedSortSetting {
            key: 'customer_country'
            direction: 'asc'
          },
          KeyBasedSortSetting {
            key: 'customer_gender'
            direction: 'asc'
          },
          KeyBasedSortSetting {
            key: 'customer_age'
            direction: 'asc'
          },
        ]
      }
    }
  }

  // ---------- Geography ----------

  block t_geography: TextBlock {
    content: @md
# Geographic Performance
Compare sales performance by customer country, state, and city.
    ;;
  }

  block t_geography_rank: TextBlock {
    content: @md
## Leading Customer Markets
    ;;
  }

  block v_country_sales: VizBlock {
    label: 'Top Customer Countries by Net Sales'
    viz: BarChart {
      dataset: thelook

      x_axis: VizFieldFull {
        ref: r(thelook_users.country)
        label: 'Customer Country'
        format {
          type: 'text'
        }
      }

      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }

      settings {
        row_limit: 10
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block v_geography_detail: VizBlock {
    label: 'Geographic Sales Performance'
    viz: DataTable {
      dataset: thelook

      fields: [
        VizFieldFull {
          label: 'Customer Country'
          ref: r(thelook_users.country)
          format {
            type: 'text'
          }
          uname: 'customer_country'
        },
        VizFieldFull {
          label: 'Customer State'
          ref: r(thelook_users.state)
          format {
            type: 'text'
          }
          uname: 'customer_state'
        },
        VizFieldFull {
          label: 'Customer City'
          ref: r(thelook_users.city)
          format {
            type: 'text'
          }
          uname: 'customer_city'
        },
        VizFieldFull {
          label: 'Net Sales'
          ref: r(thelook.net_sales)
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'net_sales'
        },
        VizFieldFull {
          label: 'Gross Profit'
          ref: r(thelook.gross_profit)
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'gross_profit'
        },
        VizFieldFull {
          label: 'Fulfilled Orders'
          ref: r(thelook.fulfilled_orders)
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'fulfilled_orders'
        },
        VizFieldFull {
          label: 'Customers'
          ref: r(thelook.customers)
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'customers'
        },
        VizFieldFull {
          label: 'Average Order Value'
          ref: r(thelook.aov)
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'average_order_value'
        },
        VizFieldFull {
          label: 'Return Rate'
          ref: r(thelook.return_rate)
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'return_rate'
        },
      ]

      settings {
        pagination_size: 100
        show_row_number: true
        wrap_header_text: true
        wrap_cell_text: false
        frozen_columns: 3
        sorts: [
          KeyBasedSortSetting {
            key: 'net_sales'
            direction: 'desc'
          },
          KeyBasedSortSetting {
            key: 'customer_country'
            direction: 'asc'
          },
          KeyBasedSortSetting {
            key: 'customer_state'
            direction: 'asc'
          },
          KeyBasedSortSetting {
            key: 'customer_city'
            direction: 'asc'
          },
        ]
      }
    }
  }

  // ---------- Shared filter interactions ----------

  explicit_interactions: [
    FilterInteraction {
      from: 'f_date'
      to: [
        'v_net_sales',
        'v_gross_profit',
        'v_fulfilled_orders',
        'v_aov',
        'v_monthly_sales',
        'v_product_categories',
        'v_product_detail',
        'v_customer_detail',
        'v_country_sales',
        'v_geography_detail',
      ]
      field: r(thelook_order_items.created_at)
    },
    FilterInteraction {
      from: 'f_date'
      to: ['v_customer_acquisition']
      field: r(thelook_users.created_at)
    },
    FilterInteraction {
      from: 'f_country'
      to: [
        'v_net_sales',
        'v_gross_profit',
        'v_fulfilled_orders',
        'v_aov',
        'v_monthly_sales',
        'v_product_categories',
        'v_product_detail',
        'v_customer_acquisition',
        'v_customer_detail',
        'v_country_sales',
        'v_geography_detail',
      ]
      field: r(thelook_users.country)
    },
    FilterInteraction {
      from: 'f_product_category'
      to: [
        'v_net_sales',
        'v_gross_profit',
        'v_fulfilled_orders',
        'v_aov',
        'v_monthly_sales',
        'v_product_categories',
        'v_product_detail',
        'v_customer_detail',
        'v_country_sales',
        'v_geography_detail',
      ]
      field: r(thelook_products.category)
    },
    FilterInteraction {
      from: 'f_gender'
      to: [
        'v_net_sales',
        'v_gross_profit',
        'v_fulfilled_orders',
        'v_aov',
        'v_monthly_sales',
        'v_product_categories',
        'v_product_detail',
        'v_customer_acquisition',
        'v_customer_detail',
        'v_country_sales',
        'v_geography_detail',
      ]
      field: r(thelook_users.gender)
    },
  ]

  // ---------- Tab layout ----------

  view: TabLayout {
    tab overview: CanvasLayout {
      label: 'Overview'
      width: 1220
      height: 1120
      grid_size: 20
      auto_expand_vertically: true

      block t_overview {
        position: pos(20, 20, 1180, 100)
        layer: 1
      }

      block f_date {
        position: pos(20, 140, 280, 80)
        layer: 1
      }

      block f_country {
        position: pos(320, 140, 280, 80)
        layer: 1
      }

      block f_product_category {
        position: pos(620, 140, 280, 80)
        layer: 1
      }

      block f_gender {
        position: pos(920, 140, 280, 80)
        layer: 1
      }

      block v_net_sales {
        position: pos(20, 240, 280, 150)
        layer: 1
      }

      block v_gross_profit {
        position: pos(320, 240, 280, 150)
        layer: 1
      }

      block v_fulfilled_orders {
        position: pos(620, 240, 280, 150)
        layer: 1
      }

      block v_aov {
        position: pos(920, 240, 280, 150)
        layer: 1
      }

      block t_overview_trend {
        position: pos(20, 420, 1180, 50)
        layer: 1
      }

      block v_monthly_sales {
        position: pos(20, 490, 1180, 540)
        layer: 1
      }

      mobile {
        mode: 'auto'
      }
    }

    tab products: CanvasLayout {
      label: 'Products'
      width: 1220
      height: 1220
      grid_size: 20
      auto_expand_vertically: true

      block t_products {
        position: pos(20, 20, 1180, 100)
        layer: 1
      }

      block f_date {
        position: pos(20, 140, 280, 80)
        layer: 1
      }

      block f_country {
        position: pos(320, 140, 280, 80)
        layer: 1
      }

      block f_product_category {
        position: pos(620, 140, 280, 80)
        layer: 1
      }

      block f_gender {
        position: pos(920, 140, 280, 80)
        layer: 1
      }

      block t_products_rank {
        position: pos(20, 240, 1180, 50)
        layer: 1
      }

      block v_product_categories {
        position: pos(20, 310, 1180, 380)
        layer: 1
      }

      block v_product_detail {
        position: pos(20, 720, 1180, 430)
        layer: 1
      }

      mobile {
        mode: 'auto'
      }
    }

    tab customers: CanvasLayout {
      label: 'Customers'
      width: 1220
      height: 1220
      grid_size: 20
      auto_expand_vertically: true

      block t_customers {
        position: pos(20, 20, 1180, 100)
        layer: 1
      }

      block f_date {
        position: pos(20, 140, 280, 80)
        layer: 1
      }

      block f_country {
        position: pos(320, 140, 280, 80)
        layer: 1
      }

      block f_product_category {
        position: pos(620, 140, 280, 80)
        layer: 1
      }

      block f_gender {
        position: pos(920, 140, 280, 80)
        layer: 1
      }

      block t_customers_acquisition {
        position: pos(20, 240, 1180, 50)
        layer: 1
      }

      block v_customer_acquisition {
        position: pos(20, 310, 1180, 380)
        layer: 1
      }

      block v_customer_detail {
        position: pos(20, 720, 1180, 430)
        layer: 1
      }

      mobile {
        mode: 'auto'
      }
    }

    tab geography: CanvasLayout {
      label: 'Geography'
      width: 1220
      height: 1220
      grid_size: 20
      auto_expand_vertically: true

      block t_geography {
        position: pos(20, 20, 1180, 100)
        layer: 1
      }

      block f_date {
        position: pos(20, 140, 280, 80)
        layer: 1
      }

      block f_country {
        position: pos(320, 140, 280, 80)
        layer: 1
      }

      block f_product_category {
        position: pos(620, 140, 280, 80)
        layer: 1
      }

      block f_gender {
        position: pos(920, 140, 280, 80)
        layer: 1
      }

      block t_geography_rank {
        position: pos(20, 240, 1180, 50)
        layer: 1
      }

      block v_country_sales {
        position: pos(20, 310, 1180, 380)
        layer: 1
      }

      block v_geography_detail {
        position: pos(20, 720, 1180, 430)
        layer: 1
      }

      mobile {
        mode: 'auto'
      }
    }
  }
}
