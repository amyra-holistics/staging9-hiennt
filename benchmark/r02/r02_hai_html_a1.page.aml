Dashboard r02_hai_html_a1 {
  title: 'Sales Performance'
  description: 'Cross-tab sales performance monitoring for the TheLook eCommerce dataset.'
  theme: H.themes.classic

  // ---- GLOBAL FILTERS
  block f_date: FilterBlock {
    label: 'Order Item Date'
    type: 'date'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block f_category: FilterBlock {
    label: 'Product Category'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.category)
    }
    settings {
      input_type: 'multiple'
    }
  }

  block f_country: FilterBlock {
    label: 'Customer Country'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.country)
    }
    settings {
      input_type: 'multiple'
    }
  }

  block f_gender: FilterBlock {
    label: 'Customer Gender'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.gender)
    }
    settings {
      input_type: 'multiple'
    }
  }

  // ---- OVERVIEW
  block v_net_sales: VizBlock {
    label: 'Net Sales'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
      }
    }
  }

  block v_gross_profit: VizBlock {
    label: 'Gross Profit'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_profit)
        label: 'Gross Profit'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
      }
    }
  }

  block v_fulfilled_orders: VizBlock {
    label: 'Fulfilled Orders'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        label: 'Fulfilled Orders'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block v_aov: VizBlock {
    label: 'Average Order Value'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
      }
    }
  }

  block v_sales_trend: VizBlock {
    label: 'Monthly Sales and Gross Profit'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        label: 'Order Item Month'
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        label: 'Sales Performance'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.gross_profit)
            label: 'Gross Profit'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        x_axis_label: 'Month'
        legend_label: 'top'
        show_data_points: false
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block v_gross_margin: VizBlock {
    label: 'Gross Margin'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block v_return_rate: VizBlock {
    label: 'Return Rate'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.return_rate)
        label: 'Return Rate'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  // ---- PRODUCTS
  block v_product_category_sales: VizBlock {
    label: 'Top Product Categories by Net Sales'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Product Category'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        row_limit: 10
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block v_items_sold: VizBlock {
    label: 'Items Sold'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.items_sold)
        label: 'Items Sold'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  // ---- CUSTOMERS
  block v_customer_sales_mix: VizBlock {
    label: 'Customer Sales by Country and Gender'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.country)
        label: 'Customer Country'
      }
      legend: VizFieldFull {
        ref: r(thelook_users.gender)
        label: 'Customer Gender'
      }
      y_axis {
        label: 'Net Sales'
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      filter {
        field: r(thelook_users.country)
        operator: 'top'
        value: 10
        options {
          rank_by {
            field: r(thelook.net_sales)
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  // ---- GEOGRAPHY
  block v_country_sales: VizBlock {
    label: 'Top Countries by Net Sales'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.country)
        label: 'Customer Country'
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        row_limit: 10
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'f_date'
      to: [
        'v_net_sales',
        'v_gross_profit',
        'v_fulfilled_orders',
        'v_aov',
        'v_sales_trend',
        'v_gross_margin',
        'v_return_rate',
        'v_product_category_sales',
        'v_items_sold',
        'v_customer_sales_mix',
        'v_country_sales'
      ]
      field: r(thelook_order_items.created_at)
    },
    FilterInteraction {
      from: 'f_category'
      to: [
        'v_net_sales',
        'v_gross_profit',
        'v_fulfilled_orders',
        'v_aov',
        'v_sales_trend',
        'v_gross_margin',
        'v_return_rate',
        'v_product_category_sales',
        'v_items_sold',
        'v_customer_sales_mix',
        'v_country_sales'
      ]
      field: r(thelook_products.category)
    },
    FilterInteraction {
      from: 'f_country'
      to: [
        'v_net_sales',
        'v_gross_profit',
        'v_fulfilled_orders',
        'v_aov',
        'v_sales_trend',
        'v_gross_margin',
        'v_return_rate',
        'v_product_category_sales',
        'v_items_sold',
        'v_customer_sales_mix',
        'v_country_sales'
      ]
      field: r(thelook_users.country)
    },
    FilterInteraction {
      from: 'f_gender'
      to: [
        'v_net_sales',
        'v_gross_profit',
        'v_fulfilled_orders',
        'v_aov',
        'v_sales_trend',
        'v_gross_margin',
        'v_return_rate',
        'v_product_category_sales',
        'v_items_sold',
        'v_customer_sales_mix',
        'v_country_sales'
      ]
      field: r(thelook_users.gender)
    }
  ]

  view: HTMLLayout {
    content: @html
      <style>
        .sales-dashboard {
          --ink: #152536;
          --muted: #617083;
          --line: #dfe6ee;
          --surface: #ffffff;
          --canvas: #f5f7fa;
          --accent: #2268d9;
          --accent-soft: #e9f0ff;
          background: var(--canvas);
          color: var(--ink);
          font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
          min-height: 100vh;
          padding: 28px;
        }

        .sales-dashboard * {
          box-sizing: border-box;
        }

        .shell {
          max-width: 1440px;
          margin: 0 auto;
        }

        .hero {
          display: flex;
          justify-content: space-between;
          align-items: end;
          gap: 24px;
          margin-bottom: 22px;
        }

        .eyebrow {
          color: var(--accent);
          font-size: 12px;
          font-weight: 800;
          letter-spacing: 0.1em;
          margin-bottom: 8px;
          text-transform: uppercase;
        }

        .hero h1 {
          font-size: 32px;
          line-height: 1.15;
          letter-spacing: -0.03em;
          margin: 0;
        }

        .hero p {
          color: var(--muted);
          margin: 8px 0 0;
        }

        .filter-bar {
          display: grid;
          grid-template-columns: repeat(4, minmax(0, 1fr));
          gap: 14px;
          background: var(--surface);
          border: 1px solid var(--line);
          border-radius: 14px;
          box-shadow: 0 2px 5px rgba(21, 37, 54, 0.04);
          margin-bottom: 24px;
          padding: 16px;
        }

        .filter-bar h-block {
          min-width: 0;
        }

        .tab-toggle {
          position: absolute;
          opacity: 0;
          pointer-events: none;
        }

        .tab-list {
          align-items: center;
          border-bottom: 1px solid var(--line);
          display: flex;
          gap: 26px;
          margin-bottom: 24px;
        }

        .tab-list label {
          border-bottom: 3px solid transparent;
          color: var(--muted);
          cursor: pointer;
          font-size: 14px;
          font-weight: 700;
          padding: 0 2px 13px;
          transition: color 0.15s ease, border-color 0.15s ease;
        }

        #tab-overview:checked ~ .tab-list label[for="tab-overview"],
        #tab-products:checked ~ .tab-list label[for="tab-products"],
        #tab-customers:checked ~ .tab-list label[for="tab-customers"],
        #tab-geography:checked ~ .tab-list label[for="tab-geography"] {
          border-color: var(--accent);
          color: var(--accent);
        }

        .tab-panel {
          display: none;
        }

        #tab-overview:checked ~ .tab-panels .panel-overview,
        #tab-products:checked ~ .tab-panels .panel-products,
        #tab-customers:checked ~ .tab-panels .panel-customers,
        #tab-geography:checked ~ .tab-panels .panel-geography {
          display: block;
        }

        .section-intro {
          margin: 0 0 18px;
        }

        .section-intro h2 {
          font-size: 20px;
          letter-spacing: -0.02em;
          margin: 0 0 5px;
        }

        .section-intro p {
          color: var(--muted);
          font-size: 14px;
          margin: 0;
        }

        .kpi-grid {
          display: grid;
          gap: 16px;
          grid-template-columns: repeat(4, minmax(0, 1fr));
          margin-bottom: 18px;
        }

        .compact-kpi-grid {
          display: grid;
          gap: 16px;
          grid-template-columns: repeat(3, minmax(0, 1fr));
          margin-bottom: 18px;
        }

        .card {
          background: var(--surface);
          border: 1px solid var(--line);
          border-radius: 14px;
          box-shadow: 0 2px 5px rgba(21, 37, 54, 0.04);
          min-width: 0;
          overflow: hidden;
          padding: 6px;
        }

        .card h-block {
          display: block;
          min-height: 100%;
        }

        .chart-card {
          min-height: 420px;
        }

        .half-grid {
          display: grid;
          gap: 16px;
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .note {
          color: var(--muted);
          font-size: 12px;
          margin: 16px 0 0;
        }

        @media (max-width: 980px) {
          .filter-bar,
          .kpi-grid,
          .compact-kpi-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
          }

          .half-grid {
            grid-template-columns: 1fr;
          }
        }

        @media (max-width: 640px) {
          .sales-dashboard {
            padding: 16px;
          }

          .hero {
            align-items: start;
            flex-direction: column;
          }

          .filter-bar,
          .kpi-grid,
          .compact-kpi-grid {
            grid-template-columns: 1fr;
          }

          .tab-list {
            gap: 16px;
            overflow-x: auto;
          }

          .tab-list label {
            white-space: nowrap;
          }
        }
      </style>

      <main class="sales-dashboard">
        <div class="shell">
          <header class="hero">
            <div>
              <div class="eyebrow">TheLook eCommerce</div>
              <h1>Sales Performance</h1>
              <p>Track commercial health, product mix, customer segments, and geographic performance.</p>
            </div>
          </header>

          <section class="filter-bar" aria-label="Dashboard filters">
            <h-block name="f_date"></h-block>
            <h-block name="f_category"></h-block>
            <h-block name="f_country"></h-block>
            <h-block name="f_gender"></h-block>
          </section>

          <input class="tab-toggle" type="radio" name="sales-tab" id="tab-overview" checked>
          <input class="tab-toggle" type="radio" name="sales-tab" id="tab-products">
          <input class="tab-toggle" type="radio" name="sales-tab" id="tab-customers">
          <input class="tab-toggle" type="radio" name="sales-tab" id="tab-geography">

          <nav class="tab-list" aria-label="Sales performance sections">
            <label for="tab-overview">Overview</label>
            <label for="tab-products">Products</label>
            <label for="tab-customers">Customers</label>
            <label for="tab-geography">Geography</label>
          </nav>

          <div class="tab-panels">
            <section class="tab-panel panel-overview">
              <div class="section-intro">
                <h2>Overview</h2>
                <p>Monitor sales volume, profitability, fulfillment, and order value over time.</p>
              </div>

              <div class="kpi-grid">
                <div class="card"><h-block name="v_net_sales"></h-block></div>
                <div class="card"><h-block name="v_gross_profit"></h-block></div>
                <div class="card"><h-block name="v_fulfilled_orders"></h-block></div>
                <div class="card"><h-block name="v_aov"></h-block></div>
              </div>

              <div class="card chart-card">
                <h-block name="v_sales_trend"></h-block>
              </div>

              <div class="compact-kpi-grid" style="margin-top: 18px;">
                <div class="card"><h-block name="v_gross_margin"></h-block></div>
                <div class="card"><h-block name="v_return_rate"></h-block></div>
                <div class="card"><h-block name="v_items_sold"></h-block></div>
              </div>
            </section>

            <section class="tab-panel panel-products">
              <div class="section-intro">
                <h2>Products</h2>
                <p>Identify the product categories contributing most to net sales.</p>
              </div>

              <div class="compact-kpi-grid">
                <div class="card"><h-block name="v_net_sales"></h-block></div>
                <div class="card"><h-block name="v_gross_profit"></h-block></div>
                <div class="card"><h-block name="v_items_sold"></h-block></div>
              </div>

              <div class="card chart-card">
                <h-block name="v_product_category_sales"></h-block>
              </div>

              <p class="note">The chart ranks the top 10 product categories by net sales after the selected dashboard filters are applied.</p>
            </section>

            <section class="tab-panel panel-customers">
              <div class="section-intro">
                <h2>Customers</h2>
                <p>Compare sales contribution across customer countries and gender segments.</p>
              </div>

              <div class="compact-kpi-grid">
                <div class="card"><h-block name="v_fulfilled_orders"></h-block></div>
                <div class="card"><h-block name="v_aov"></h-block></div>
                <div class="card"><h-block name="v_return_rate"></h-block></div>
              </div>

              <div class="card chart-card">
                <h-block name="v_customer_sales_mix"></h-block>
              </div>

              <p class="note">Countries are limited to the top 10 by net sales; gender is shown as the comparison series.</p>
            </section>

            <section class="tab-panel panel-geography">
              <div class="section-intro">
                <h2>Geography</h2>
                <p>Understand where sales and profit are concentrated geographically.</p>
              </div>

              <div class="compact-kpi-grid">
                <div class="card"><h-block name="v_net_sales"></h-block></div>
                <div class="card"><h-block name="v_gross_profit"></h-block></div>
                <div class="card"><h-block name="v_gross_margin"></h-block></div>
              </div>

              <div class="card chart-card">
                <h-block name="v_country_sales"></h-block>
              </div>

              <p class="note">Countries are ranked by net sales and respond to every filter in the shared control bar.</p>
            </section>
          </div>
        </div>
      </main>
    ;;
  }
}
