Dashboard r02_hai_html_a2 {
  title: 'Sales Performance'
  description: 'Sales performance dashboard for TheLook eCommerce with consistent global filters and responsive HTML tabs.'
  theme: H.themes.classic

  settings {
    autorun: true
    cache_duration: 3600
  }

  block f_date: FilterBlock {
    label: 'Order Date'
    type: 'date'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block f_category: FilterBlock {
    label: 'Product Category'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.category)
    }
  }

  block f_country: FilterBlock {
    label: 'Customer Country'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.country)
    }
  }

  block f_status: FilterBlock {
    label: 'Item Status'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.status)
    }
  }

  block kpi_net_sales: VizBlock {
    label: 'Net Sales'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block kpi_fulfilled_orders: VizBlock {
    label: 'Fulfilled Orders'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        label: 'Fulfilled Orders'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block kpi_aov: VizBlock {
    label: 'Average Order Value'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block kpi_gross_margin: VizBlock {
    label: 'Gross Margin'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block v_monthly_sales: VizBlock {
    label: 'Monthly Sales and Gross Profit'
    viz: LineChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        label: 'Month'
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        label: 'Sales and Profit'
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        series {
          field: VizFieldFull {
            ref: r(thelook.gross_profit)
            label: 'Gross Profit'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        x_axis_label: 'Month'
        legend_label: 'bottom'
        show_data_points: false
        connect_discontinuous_points: false
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block v_category_sales: VizBlock {
    label: 'Net Sales by Product Category'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Product Category'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      tooltips: [
        VizTooltip {
          field: VizFieldFull {
            ref: r(thelook.items_sold)
            label: 'Items Sold'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        },
      ]
      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block v_top_products: VizBlock {
    label: 'Top 10 Products by Net Sales'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          ref: r(thelook_products.name)
          label: 'Product Name'
          format {
            type: 'text'
          }
          uname: 'product_name'
        },
        VizFieldFull {
          ref: r(thelook_products.brand)
          label: 'Product Brand'
          format {
            type: 'text'
          }
          uname: 'product_brand'
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'net_sales'
        },
      ]
      settings {
        pagination_size: 10
        show_row_number: false
        row_limit: 10
        wrap_header_text: true
        wrap_cell_text: false
        sorts: [
          KeyBasedSortSetting {
            key: 'net_sales'
            direction: 'desc'
          },
          KeyBasedSortSetting {
            key: 'product_name'
            direction: 'asc'
          },
          KeyBasedSortSetting {
            key: 'product_brand'
            direction: 'asc'
          },
        ]
      }
    }
  }

  block v_traffic_source: VizBlock {
    label: 'Net Sales by Customer Traffic Source'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.traffic_source)
        label: 'Customer Traffic Source'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      tooltips: [
        VizTooltip {
          field: VizFieldFull {
            ref: r(thelook.fulfilled_orders)
            label: 'Fulfilled Orders'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        },
      ]
      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block v_gender_sales: VizBlock {
    label: 'Net Sales by Customer Gender'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.gender)
        label: 'Customer Gender'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      tooltips: [
        VizTooltip {
          field: VizFieldFull {
            ref: r(thelook.aov)
            label: 'Average Order Value'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        },
      ]
      settings {
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block v_country_sales: VizBlock {
    label: 'Net Sales by Country'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.country)
        label: 'Country'
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      tooltips: [
        VizTooltip {
          field: VizFieldFull {
            ref: r(thelook.fulfilled_orders)
            label: 'Fulfilled Orders'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        },
      ]
      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block v_state_sales: VizBlock {
    label: 'Top 15 States by Net Sales'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.state)
        label: 'State'
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        row_limit: 15
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'f_date'
      to: [
        'kpi_net_sales',
        'kpi_fulfilled_orders',
        'kpi_aov',
        'kpi_gross_margin',
        'v_monthly_sales',
        'v_category_sales',
        'v_top_products',
        'v_traffic_source',
        'v_gender_sales',
        'v_country_sales',
        'v_state_sales',
      ]
      field: r(thelook_order_items.created_at)
    },
    FilterInteraction {
      from: 'f_category'
      to: [
        'kpi_net_sales',
        'kpi_fulfilled_orders',
        'kpi_aov',
        'kpi_gross_margin',
        'v_monthly_sales',
        'v_category_sales',
        'v_top_products',
        'v_traffic_source',
        'v_gender_sales',
        'v_country_sales',
        'v_state_sales',
      ]
      field: r(thelook_products.category)
    },
    FilterInteraction {
      from: 'f_country'
      to: [
        'kpi_net_sales',
        'kpi_fulfilled_orders',
        'kpi_aov',
        'kpi_gross_margin',
        'v_monthly_sales',
        'v_category_sales',
        'v_top_products',
        'v_traffic_source',
        'v_gender_sales',
        'v_country_sales',
        'v_state_sales',
      ]
      field: r(thelook_users.country)
    },
    FilterInteraction {
      from: 'f_status'
      to: [
        'kpi_net_sales',
        'kpi_fulfilled_orders',
        'kpi_aov',
        'kpi_gross_margin',
        'v_monthly_sales',
        'v_category_sales',
        'v_top_products',
        'v_traffic_source',
        'v_gender_sales',
        'v_country_sales',
        'v_state_sales',
      ]
      field: r(thelook_order_items.status)
    },
  ]

  view: HTMLLayout {
    content: @html
      <style>
        .sales-dashboard {
          max-width: 1440px;
          margin: 0 auto;
          padding: 24px;
          color: #172033;
          font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        }

        .sales-dashboard__header {
          display: flex;
          align-items: flex-end;
          justify-content: space-between;
          gap: 24px;
          margin-bottom: 24px;
        }

        .sales-dashboard__eyebrow {
          margin: 0 0 8px;
          color: #56637a;
          font-size: 12px;
          font-weight: 700;
          letter-spacing: 0.1em;
          text-transform: uppercase;
        }

        .sales-dashboard__title {
          margin: 0;
          color: #0f172a;
          font-size: 32px;
          font-weight: 750;
          letter-spacing: -0.035em;
        }

        .sales-dashboard__subtitle {
          max-width: 560px;
          margin: 8px 0 0;
          color: #64748b;
          font-size: 14px;
          line-height: 1.5;
        }

        .filter-bar {
          display: grid;
          grid-template-columns: repeat(4, minmax(0, 1fr));
          gap: 12px;
          margin-bottom: 28px;
          padding: 16px;
          background: #f8fafc;
          border: 1px solid #e2e8f0;
          border-radius: 14px;
        }

        .tab-input {
          position: absolute;
          width: 1px;
          height: 1px;
          opacity: 0;
          pointer-events: none;
        }

        .tab-list {
          display: flex;
          gap: 8px;
          overflow-x: auto;
          margin-bottom: 24px;
          padding-bottom: 2px;
          border-bottom: 1px solid #e2e8f0;
        }

        .tab-list label {
          display: inline-flex;
          align-items: center;
          min-height: 38px;
          padding: 0 14px;
          color: #64748b;
          border-bottom: 2px solid transparent;
          cursor: pointer;
          font-size: 14px;
          font-weight: 650;
          white-space: nowrap;
        }

        #tab-overview:checked ~ .tab-list label[for="tab-overview"],
        #tab-products:checked ~ .tab-list label[for="tab-products"],
        #tab-customers:checked ~ .tab-list label[for="tab-customers"],
        #tab-geography:checked ~ .tab-list label[for="tab-geography"] {
          color: #2563eb;
          border-bottom-color: #2563eb;
        }

        .tab-panel {
          display: none;
        }

        #tab-overview:checked ~ .tab-panels .panel-overview,
        #tab-products:checked ~ .tab-panels .panel-products,
        #tab-customers:checked ~ .tab-panels .panel-customers,
        #tab-geography:checked ~ .tab-panels .panel-geography {
          display: grid;
          gap: 20px;
        }

        .kpi-grid {
          display: grid;
          grid-template-columns: repeat(4, minmax(0, 1fr));
          gap: 16px;
        }

        .two-column-grid {
          display: grid;
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 20px;
        }

        .section-heading {
          margin: 4px 0 -4px;
        }

        .section-heading h2 {
          margin: 0;
          color: #172033;
          font-size: 18px;
          font-weight: 700;
          letter-spacing: -0.015em;
        }

        .section-heading p {
          margin: 5px 0 0;
          color: #64748b;
          font-size: 13px;
        }

        .chart-card {
          min-width: 0;
          padding: 4px;
          background: #ffffff;
          border: 1px solid #e2e8f0;
          border-radius: 14px;
          box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
        }

        .kpi-card {
          min-width: 0;
          padding: 4px;
          background: #ffffff;
          border: 1px solid #e2e8f0;
          border-radius: 14px;
          box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
        }

        @media (max-width: 960px) {
          .filter-bar,
          .kpi-grid,
          .two-column-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
          }
        }

        @media (max-width: 640px) {
          .sales-dashboard {
            padding: 16px;
          }

          .sales-dashboard__header,
          .filter-bar,
          .kpi-grid,
          .two-column-grid {
            grid-template-columns: 1fr;
            display: grid;
          }

          .sales-dashboard__header {
            align-items: start;
          }

          .sales-dashboard__title {
            font-size: 26px;
          }
        }
      </style>

      <main class="sales-dashboard">
        <header class="sales-dashboard__header">
          <div>
            <p class="sales-dashboard__eyebrow">TheLook eCommerce</p>
            <h1 class="sales-dashboard__title">Sales Performance</h1>
            <p class="sales-dashboard__subtitle">
              Monitor commercial performance, product demand, customer segments, and geographic contribution.
            </p>
          </div>
        </header>

        <section class="filter-bar" aria-label="Dashboard filters">
          <h-block name="f_date" />
          <h-block name="f_category" />
          <h-block name="f_country" />
          <h-block name="f_status" />
        </section>

        <input class="tab-input" type="radio" id="tab-overview" name="sales-tab" checked />
        <input class="tab-input" type="radio" id="tab-products" name="sales-tab" />
        <input class="tab-input" type="radio" id="tab-customers" name="sales-tab" />
        <input class="tab-input" type="radio" id="tab-geography" name="sales-tab" />

        <nav class="tab-list" aria-label="Sales performance sections">
          <label for="tab-overview">Overview</label>
          <label for="tab-products">Products</label>
          <label for="tab-customers">Customers</label>
          <label for="tab-geography">Geography</label>
        </nav>

        <div class="tab-panels">
          <section class="tab-panel panel-overview">
            <div class="kpi-grid">
              <div class="kpi-card"><h-block name="kpi_net_sales" /></div>
              <div class="kpi-card"><h-block name="kpi_fulfilled_orders" /></div>
              <div class="kpi-card"><h-block name="kpi_aov" /></div>
              <div class="kpi-card"><h-block name="kpi_gross_margin" /></div>
            </div>

            <div class="section-heading">
              <h2>Sales trend</h2>
              <p>Track net sales and gross profit over time.</p>
            </div>
            <div class="chart-card">
              <h-block name="v_monthly_sales" />
            </div>
          </section>

          <section class="tab-panel panel-products">
            <div class="section-heading">
              <h2>Category performance</h2>
              <p>Compare categories by net sales and inspect unit volume in tooltips.</p>
            </div>
            <div class="chart-card">
              <h-block name="v_category_sales" />
            </div>

            <div class="section-heading">
              <h2>Top-selling products</h2>
              <p>Review the products generating the highest net sales.</p>
            </div>
            <div class="chart-card">
              <h-block name="v_top_products" />
            </div>
          </section>

          <section class="tab-panel panel-customers">
            <div class="two-column-grid">
              <div>
                <div class="section-heading">
                  <h2>Acquisition channel performance</h2>
                  <p>Compare customer traffic sources by net sales.</p>
                </div>
                <div class="chart-card">
                  <h-block name="v_traffic_source" />
                </div>
              </div>

              <div>
                <div class="section-heading">
                  <h2>Customer gender performance</h2>
                  <p>Review net sales and average order value by gender.</p>
                </div>
                <div class="chart-card">
                  <h-block name="v_gender_sales" />
                </div>
              </div>
            </div>
          </section>

          <section class="tab-panel panel-geography">
            <div class="two-column-grid">
              <div>
                <div class="section-heading">
                  <h2>Country contribution</h2>
                  <p>Identify the countries with the greatest sales contribution.</p>
                </div>
                <div class="chart-card">
                  <h-block name="v_country_sales" />
                </div>
              </div>

              <div>
                <div class="section-heading">
                  <h2>Leading states</h2>
                  <p>Focus on the top 15 states by net sales.</p>
                </div>
                <div class="chart-card">
                  <h-block name="v_state_sales" />
                </div>
              </div>
            </div>
          </section>
        </div>
      </main>
    ;;
  }
}
