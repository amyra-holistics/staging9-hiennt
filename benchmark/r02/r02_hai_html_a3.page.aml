Dashboard r02_hai_html_a3 {
  title: 'Sales Performance'
  description: 'Sales performance dashboard across products, customers, and geography.'
  theme: H.themes.classic

  settings {
    autorun_on_open: true
  }

  // Shared filters
  block f_order_date: FilterBlock {
    label: 'Order Item Date'
    type: 'date'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block f_category: FilterBlock {
    label: 'Product Category'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.category)
    }
    settings {
      input_type: 'multiple'
    }
  }

  block f_country: FilterBlock {
    label: 'Customer Country'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.country)
    }
    settings {
      input_type: 'multiple'
    }
  }

  block f_item_status: FilterBlock {
    label: 'Order Item Status'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.status)
    }
    settings {
      input_type: 'multiple'
    }
  }

  // Overview
  block v_net_sales: VizBlock {
    label: 'Net Sales'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block v_sales_trend: VizBlock {
    label: 'Monthly Net Sales and Gross Profit'
    viz: LineChart {
      dataset: thelook
      x_axis: VizFieldFull {
        label: 'Order Item Created Month'
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            label: 'Net Sales'
            ref: r(thelook.net_sales)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        series {
          field: VizFieldFull {
            label: 'Gross Profit'
            ref: r(thelook.gross_profit)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        legend_label: 'bottom'
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  // Products
  block v_category_sales: VizBlock {
    label: 'Top Product Categories by Net Sales'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Product Category'
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        row_limit: 10
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block v_top_products: VizBlock {
    label: 'Top Products Performance'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          ref: r(thelook_products.name)
          label: 'Product Name'
          format {
            type: 'text'
          }
          uname: 'thelook_products_name_1'
        },
        VizFieldFull {
          ref: r(thelook_products.brand)
          label: 'Brand'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'custom_net_sales_1'
        },
        VizFieldFull {
          ref: r(thelook.items_sold)
          label: 'Items Sold'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.gross_margin)
          label: 'Gross Margin'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
      ]
      settings {
        pagination_size: 10
        show_row_number: true
        row_limit: 10
        wrap_header_text: true
        wrap_cell_text: true
        sorts: [
          KeyBasedSortSetting {
            key: 'custom_net_sales_1'
            direction: 'desc'
          },
          KeyBasedSortSetting {
            key: 'thelook_products_name_1'
            direction: 'asc'
          },
        ]
        column_styles: [
          ColumnStyle {
            key: 'thelook_products_name_1'
            width: 280
          },
          ColumnStyle {
            key: 'custom_net_sales_1'
            width: 130
          },
        ]
      }
    }
  }

  // Customers
  block v_customers_by_age: VizBlock {
    label: 'Customers by Age'
    viz: ColumnChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.age)
        label: 'Customer Age'
        format {
          type: 'number'
          pattern: '#,###'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.customers)
            label: 'Customers'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block v_customer_segments: VizBlock {
    label: 'Customer Segments by Country and Gender'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          ref: r(thelook_users.country)
          label: 'Customer Country'
          format {
            type: 'text'
          }
          uname: 'thelook_users_country_1'
        },
        VizFieldFull {
          ref: r(thelook_users.gender)
          label: 'Customer Gender'
          format {
            type: 'text'
          }
          uname: 'thelook_users_gender_1'
        },
        VizFieldFull {
          ref: r(thelook.customers)
          label: 'Customers'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.fulfilled_orders)
          label: 'Fulfilled Orders'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.aov)
          label: 'Average Order Value'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
      ]
      settings {
        pagination_size: 100
        show_row_number: true
        frozen_columns: 2
        wrap_header_text: true
        wrap_cell_text: false
        sorts: [
          KeyBasedSortSetting {
            key: 'thelook_users_country_1'
            direction: 'asc'
          },
          KeyBasedSortSetting {
            key: 'thelook_users_gender_1'
            direction: 'asc'
          },
        ]
      }
    }
  }

  // Geography
  block v_country_sales: VizBlock {
    label: 'Top Countries by Net Sales'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.country)
        label: 'Customer Country'
      }
      y_axis {
        series {
          mark_type: 'bar'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        row_limit: 15
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block v_state_sales: VizBlock {
    label: 'Top States by Net Sales'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          ref: r(thelook_users.state)
          label: 'Customer State'
          format {
            type: 'text'
          }
          uname: 'thelook_users_state_1'
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'custom_net_sales_1'
        },
        VizFieldFull {
          ref: r(thelook.gross_profit)
          label: 'Gross Profit'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.fulfilled_orders)
          label: 'Fulfilled Orders'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
      ]
      settings {
        pagination_size: 15
        show_row_number: true
        row_limit: 15
        frozen_columns: 1
        wrap_header_text: true
        wrap_cell_text: false
        sorts: [
          KeyBasedSortSetting {
            key: 'custom_net_sales_1'
            direction: 'desc'
          },
          KeyBasedSortSetting {
            key: 'thelook_users_state_1'
            direction: 'asc'
          },
        ]
      }
    }
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'f_order_date'
      to: [
        'v_net_sales',
        'v_sales_trend',
        'v_category_sales',
        'v_top_products',
        'v_customers_by_age',
        'v_customer_segments',
        'v_country_sales',
        'v_state_sales',
      ]
      field: r(thelook_order_items.created_at)
    },
    FilterInteraction {
      from: 'f_category'
      to: [
        'v_net_sales',
        'v_sales_trend',
        'v_category_sales',
        'v_top_products',
        'v_customers_by_age',
        'v_customer_segments',
        'v_country_sales',
        'v_state_sales',
      ]
      field: r(thelook_products.category)
    },
    FilterInteraction {
      from: 'f_country'
      to: [
        'v_net_sales',
        'v_sales_trend',
        'v_category_sales',
        'v_top_products',
        'v_customers_by_age',
        'v_customer_segments',
        'v_country_sales',
        'v_state_sales',
      ]
      field: r(thelook_users.country)
    },
    FilterInteraction {
      from: 'f_item_status'
      to: [
        'v_net_sales',
        'v_sales_trend',
        'v_category_sales',
        'v_top_products',
        'v_customers_by_age',
        'v_customer_segments',
        'v_country_sales',
        'v_state_sales',
      ]
      field: r(thelook_order_items.status)
    },
  ]

  view: HTMLLayout {
    content: @html
      <style>
        .sales-dashboard {
          max-width: 1440px;
          margin: 0 auto;
          padding: 12px 8px 32px;
          font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
          color: #172033;
        }

        .dashboard-header {
          display: flex;
          align-items: end;
          justify-content: space-between;
          gap: 24px;
          padding: 16px 8px 20px;
          border-bottom: 1px solid #e7ebf3;
        }

        .dashboard-title {
          margin: 0;
          font-size: 30px;
          line-height: 1.15;
          letter-spacing: -0.025em;
        }

        .dashboard-subtitle {
          margin: 8px 0 0;
          color: #667085;
          font-size: 14px;
        }

        .filter-panel {
          display: grid;
          grid-template-columns: repeat(4, minmax(180px, 1fr));
          gap: 12px;
          padding: 20px 8px;
          background: #f8fafc;
          border-bottom: 1px solid #e7ebf3;
        }

        .tab-input {
          position: absolute;
          opacity: 0;
          pointer-events: none;
        }

        .tab-list {
          display: flex;
          gap: 4px;
          margin: 24px 8px 0;
          padding: 4px;
          width: fit-content;
          border: 1px solid #e2e8f0;
          border-radius: 10px;
          background: #f8fafc;
        }

        .tab-label {
          cursor: pointer;
          border-radius: 7px;
          color: #667085;
          font-size: 14px;
          font-weight: 600;
          padding: 9px 16px;
          transition: background 0.15s ease, color 0.15s ease;
        }

        #tab-overview:checked ~ .tab-list label[for="tab-overview"],
        #tab-products:checked ~ .tab-list label[for="tab-products"],
        #tab-customers:checked ~ .tab-list label[for="tab-customers"],
        #tab-geography:checked ~ .tab-list label[for="tab-geography"] {
          background: #ffffff;
          color: #175cd3;
          box-shadow: 0 1px 2px rgba(16, 24, 40, 0.08);
        }

        .tab-panel {
          display: none;
          grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
          gap: 20px;
          padding: 20px 8px 0;
        }

        #tab-overview:checked ~ .tab-panels #panel-overview,
        #tab-products:checked ~ .tab-panels #panel-products,
        #tab-customers:checked ~ .tab-panels #panel-customers,
        #tab-geography:checked ~ .tab-panels #panel-geography {
          display: grid;
        }

        .tab-heading {
          grid-column: 1 / -1;
          margin: 0;
          font-size: 19px;
          letter-spacing: -0.015em;
        }

        .tab-description {
          grid-column: 1 / -1;
          margin: -12px 0 0;
          color: #667085;
          font-size: 14px;
        }

        .card {
          min-width: 0;
          padding: 18px;
          border: 1px solid #e7ebf3;
          border-radius: 12px;
          background: #ffffff;
          box-shadow: 0 1px 2px rgba(16, 24, 40, 0.03);
        }

        .card-wide {
          grid-column: 1 / -1;
        }

        .card-label {
          margin: 0 0 12px;
          color: #344054;
          font-size: 14px;
          font-weight: 700;
        }

        @media (max-width: 900px) {
          .filter-panel,
          .tab-panel {
            grid-template-columns: 1fr;
          }

          .dashboard-header {
            align-items: start;
            flex-direction: column;
          }

          .tab-list {
            width: 100%;
            overflow-x: auto;
          }

          .tab-label {
            white-space: nowrap;
          }

          .card-wide {
            grid-column: auto;
          }
        }
      </style>

      <main class="sales-dashboard">
        <header class="dashboard-header">
          <div>
            <h1 class="dashboard-title">Sales Performance</h1>
            <p class="dashboard-subtitle">Monitor sales results and identify product, customer, and geographic opportunities.</p>
          </div>
        </header>

        <section class="filter-panel">
          <h-block name="f_order_date"></h-block>
          <h-block name="f_category"></h-block>
          <h-block name="f_country"></h-block>
          <h-block name="f_item_status"></h-block>
        </section>

        <input class="tab-input" type="radio" name="sales_tab" id="tab-overview" checked>
        <input class="tab-input" type="radio" name="sales_tab" id="tab-products">
        <input class="tab-input" type="radio" name="sales_tab" id="tab-customers">
        <input class="tab-input" type="radio" name="sales_tab" id="tab-geography">

        <nav class="tab-list" aria-label="Sales dashboard sections">
          <label class="tab-label" for="tab-overview">Overview</label>
          <label class="tab-label" for="tab-products">Products</label>
          <label class="tab-label" for="tab-customers">Customers</label>
          <label class="tab-label" for="tab-geography">Geography</label>
        </nav>

        <section class="tab-panels">
          <div class="tab-panel" id="panel-overview">
            <h2 class="tab-heading">Overview</h2>
            <p class="tab-description">Track headline sales performance and how net sales and profit are trending over time.</p>

            <div class="card">
              <p class="card-label">Headline Performance</p>
              <h-block name="v_net_sales"></h-block>
            </div>

            <div class="card">
              <p class="card-label">Monthly Sales and Profit Trend</p>
              <h-block name="v_sales_trend"></h-block>
            </div>
          </div>

          <div class="tab-panel" id="panel-products">
            <h2 class="tab-heading">Products</h2>
            <p class="tab-description">Compare category performance and identify the individual products generating the most net sales.</p>

            <div class="card">
              <p class="card-label">Top Categories</p>
              <h-block name="v_category_sales"></h-block>
            </div>

            <div class="card">
              <p class="card-label">Top Products</p>
              <h-block name="v_top_products"></h-block>
            </div>
          </div>

          <div class="tab-panel" id="panel-customers">
            <h2 class="tab-heading">Customers</h2>
            <p class="tab-description">Understand the customer base by age, country, and gender alongside the sales they generate.</p>

            <div class="card">
              <p class="card-label">Customer Age Distribution</p>
              <h-block name="v_customers_by_age"></h-block>
            </div>

            <div class="card">
              <p class="card-label">Customer Segments</p>
              <h-block name="v_customer_segments"></h-block>
            </div>
          </div>

          <div class="tab-panel" id="panel-geography">
            <h2 class="tab-heading">Geography</h2>
            <p class="tab-description">See where sales are concentrated and compare regional sales, profit, and order performance.</p>

            <div class="card">
              <p class="card-label">Top Countries</p>
              <h-block name="v_country_sales"></h-block>
            </div>

            <div class="card">
              <p class="card-label">Top States</p>
              <h-block name="v_state_sales"></h-block>
            </div>
          </div>
        </section>
      </main>
    ;;
  }
}
