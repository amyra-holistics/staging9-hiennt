Dashboard r02_haid_canvas_a1 {
  title: 'Sales Performance'
  theme: H.themes.classic

  block o_title: TextBlock { content: @md # Sales Overview ;; }
  block f_date: FilterBlock {
    label: 'Order Item Created Date'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
    default { operator: 'matches' value: '$H_NIL$' }
  }
  block f_category: FilterBlock { label: 'Product Category' type: 'field' source: FieldFilterSource {
    dataset: thelook
    field: r(thelook_products.category)
  } default { operator: 'matches' value: '$H_NIL$' } }
  block f_department: FilterBlock { label: 'Product Department' type: 'field' source: FieldFilterSource {
    dataset: thelook
    field: r(thelook_products.department)
  } default { operator: 'matches' value: '$H_NIL$' } }
  block f_country: FilterBlock { label: 'Customer Country' type: 'field' source: FieldFilterSource {
    dataset: thelook
    field: r(thelook_users.country)
  } default { operator: 'matches' value: '$H_NIL$' } }
  block d_grain: DateDrillBlock { label: 'Date Grain' default: 'default' }
  block p_compare: PopBlock { label: 'Period Comparison' default { type: 'relative' duration: [] } }
  block o_sales: VizBlock { label: 'Net Sales' settings { hide_label: true } viz: MetricKpi {
    dataset: thelook
    value: VizFieldFull { ref: r(thelook.net_sales) label: 'Net Sales' }
  } }
  block o_orders: VizBlock { label: 'Fulfilled Orders' settings { hide_label: true } viz: MetricKpi {
    dataset: thelook
    value: VizFieldFull { ref: r(thelook.fulfilled_orders) label: 'Fulfilled Orders' }
  } }
  block o_margin: VizBlock { label: 'Gross Margin' settings { hide_label: true } viz: MetricKpi {
    dataset: thelook
    value: VizFieldFull { ref: r(thelook.gross_margin) label: 'Gross Margin' }
  } }
  block o_trend: VizBlock { label: 'Monthly Net Sales Trend' viz: CombinationChart {
    dataset: thelook
    x_axis: VizFieldFull { ref: r(thelook_order_items.created_at) transformation: 'datetrunc month' }
    y_axis { series { mark_type: 'line' field: VizFieldFull { ref: r(thelook.net_sales) label: 'Net Sales' } } }
  } }
  block o_category_sales: VizBlock { label: 'Net Sales by Product Category' viz: CombinationChart {
    dataset: thelook
    x_axis: VizFieldFull { ref: r(thelook_products.category) label: 'Product Category' }
    y_axis { series { mark_type: 'bar' field: VizFieldFull { ref: r(thelook.net_sales) label: 'Net Sales' } } }
  } }
  block o_status_mix: VizBlock { label: 'Order Status Mix' viz: PieChart {
    dataset: thelook
    calculation order_item_count { formula: @aql thelook_order_items | count(thelook_order_items.id);; calc_type: 'measure' data_type: 'number' }
    legend: VizFieldFull { ref: r(thelook_order_items.status) label: 'Order Item Status' }
    series { field: VizFieldFull { ref: 'order_item_count' label: 'Order Item Count' } }
  } }

  block p_title: TextBlock { content: @md # Products ;; }
  block p_f_date: FilterBlock { label: 'Order Item Created Date' type: 'field' source: FieldFilterSource {
    dataset: thelook
    field: r(thelook_order_items.created_at)
  } default { operator: 'matches' value: '$H_NIL$' } }
  block p_f_category: FilterBlock { label: 'Product Category' type: 'field' source: FieldFilterSource {
    dataset: thelook
    field: r(thelook_products.category)
  } default { operator: 'matches' value: '$H_NIL$' } }
  block p_f_department: FilterBlock { label: 'Product Department' type: 'field' source: FieldFilterSource {
    dataset: thelook
    field: r(thelook_products.department)
  } default { operator: 'matches' value: '$H_NIL$' } }
  block p_f_country: FilterBlock { label: 'Customer Country' type: 'field' source: FieldFilterSource {
    dataset: thelook
    field: r(thelook_users.country)
  } default { operator: 'matches' value: '$H_NIL$' } }
  block p_d_grain: DateDrillBlock { label: 'Date Grain' default: 'default' }
  block p_p_compare: PopBlock { label: 'Period Comparison' default { type: 'relative' duration: [] } }
  block p_sales: VizBlock { label: 'Net Sales' settings { hide_label: true } viz: MetricKpi {
    dataset: thelook
    value: VizFieldFull { ref: r(thelook.net_sales) label: 'Net Sales' }
  } }
  block p_items: VizBlock { label: 'Items Sold' settings { hide_label: true } viz: MetricKpi {
    dataset: thelook
    value: VizFieldFull { ref: r(thelook.items_sold) label: 'Items Sold' }
  } }
  block p_aov: VizBlock { label: 'Average Order Value' settings { hide_label: true } viz: MetricKpi {
    dataset: thelook
    value: VizFieldFull { ref: r(thelook.aov) label: 'Average Order Value' }
  } }
  block p_trend: VizBlock { label: 'Monthly Net Sales Trend' viz: CombinationChart {
    dataset: thelook
    x_axis: VizFieldFull { ref: r(thelook_order_items.created_at) transformation: 'datetrunc month' }
    y_axis { series { mark_type: 'line' field: VizFieldFull { ref: r(thelook.net_sales) label: 'Net Sales' } } }
  } }
  block p_top: VizBlock { label: 'Top Products by Net Sales' viz: DataTable {
    dataset: thelook
    fields: [VizFieldFull { ref: r(thelook_products.name) label: 'Product Name' uname: 'product_name' }, VizFieldFull { ref: r(thelook.net_sales) label: 'Net Sales' uname: 'net_sales' }, VizFieldFull { ref: r(thelook.items_sold) label: 'Items Sold' uname: 'items_sold' }]
    settings { row_limit: 10 sorts: [KeyBasedSortSetting { key: 'net_sales' direction: 'desc' }] }
  } }
  block p_brand: VizBlock { label: 'Net Sales by Brand' viz: CombinationChart {
    dataset: thelook
    x_axis: VizFieldFull { ref: r(thelook_products.brand) label: 'Product Brand' }
    y_axis { series { mark_type: 'bar' field: VizFieldFull { ref: r(thelook.net_sales) label: 'Net Sales' } } }
  } }

  block c_title: TextBlock { content: @md # Customers ;; }
  block c_f_date: FilterBlock { label: 'Order Item Created Date' type: 'field' source: FieldFilterSource {
    dataset: thelook
    field: r(thelook_order_items.created_at)
  } default { operator: 'matches' value: '$H_NIL$' } }
  block c_f_category: FilterBlock { label: 'Product Category' type: 'field' source: FieldFilterSource {
    dataset: thelook
    field: r(thelook_products.category)
  } default { operator: 'matches' value: '$H_NIL$' } }
  block c_f_department: FilterBlock { label: 'Product Department' type: 'field' source: FieldFilterSource {
    dataset: thelook
    field: r(thelook_products.department)
  } default { operator: 'matches' value: '$H_NIL$' } }
  block c_f_country: FilterBlock { label: 'Customer Country' type: 'field' source: FieldFilterSource {
    dataset: thelook
    field: r(thelook_users.country)
  } default { operator: 'matches' value: '$H_NIL$' } }
  block c_d_grain: DateDrillBlock { label: 'Date Grain' default: 'default' }
  block c_p_compare: PopBlock { label: 'Period Comparison' default { type: 'relative' duration: [] } }
  block c_customers: VizBlock { label: 'Customers' settings { hide_label: true } viz: MetricKpi {
    dataset: thelook
    value: VizFieldFull { ref: r(thelook.customers) label: 'Customers' }
  } }
  block c_sales: VizBlock { label: 'Net Sales' settings { hide_label: true } viz: MetricKpi {
    dataset: thelook
    value: VizFieldFull { ref: r(thelook.net_sales) label: 'Net Sales' }
  } }
  block c_return: VizBlock { label: 'Return Rate' settings { hide_label: true } viz: MetricKpi {
    dataset: thelook
    value: VizFieldFull { ref: r(thelook.return_rate) label: 'Return Rate' }
  } }
  block c_trend: VizBlock { label: 'Monthly Net Sales Trend' viz: CombinationChart {
    dataset: thelook
    x_axis: VizFieldFull { ref: r(thelook_order_items.created_at) transformation: 'datetrunc month' }
    y_axis { series { mark_type: 'line' field: VizFieldFull { ref: r(thelook.net_sales) label: 'Net Sales' } } }
  } }
  block c_country: VizBlock { label: 'Customers by Country' viz: CombinationChart {
    dataset: thelook
    x_axis: VizFieldFull { ref: r(thelook_users.country) label: 'Country' }
    y_axis { series { mark_type: 'bar' field: VizFieldFull { ref: r(thelook.customers) label: 'Customers' } } }
  } }
  block c_locations: VizBlock { label: 'Customer Locations' viz: PointMap {
    dataset: thelook
    lat: VizFieldFull { ref: r(thelook_users.latitude) label: 'Latitude' }
    lng: VizFieldFull { ref: r(thelook_users.longitude) label: 'Longitude' }
    value: VizFieldFull { ref: r(thelook.customers) label: 'Customers' }
    conditions: ['thelook_users.latitude is not null', 'thelook_users.longitude is not null']
  } }

  block g_title: TextBlock { content: @md # Geography ;; }
  block g_f_date: FilterBlock { label: 'Order Item Created Date' type: 'field' source: FieldFilterSource {
    dataset: thelook
    field: r(thelook_order_items.created_at)
  } default { operator: 'matches' value: '$H_NIL$' } }
  block g_f_category: FilterBlock { label: 'Product Category' type: 'field' source: FieldFilterSource {
    dataset: thelook
    field: r(thelook_products.category)
  } default { operator: 'matches' value: '$H_NIL$' } }
  block g_f_department: FilterBlock { label: 'Product Department' type: 'field' source: FieldFilterSource {
    dataset: thelook
    field: r(thelook_products.department)
  } default { operator: 'matches' value: '$H_NIL$' } }
  block g_f_country: FilterBlock { label: 'Customer Country' type: 'field' source: FieldFilterSource {
    dataset: thelook
    field: r(thelook_users.country)
  } default { operator: 'matches' value: '$H_NIL$' } }
  block g_d_grain: DateDrillBlock { label: 'Date Grain' default: 'default' }
  block g_p_compare: PopBlock { label: 'Period Comparison' default { type: 'relative' duration: [] } }
  block g_sales: VizBlock { label: 'Net Sales' settings { hide_label: true } viz: MetricKpi {
    dataset: thelook
    value: VizFieldFull { ref: r(thelook.net_sales) label: 'Net Sales' }
  } }
  block g_orders: VizBlock { label: 'Fulfilled Orders' settings { hide_label: true } viz: MetricKpi {
    dataset: thelook
    value: VizFieldFull { ref: r(thelook.fulfilled_orders) label: 'Fulfilled Orders' }
  } }
  block g_margin: VizBlock { label: 'Gross Margin' settings { hide_label: true } viz: MetricKpi {
    dataset: thelook
    value: VizFieldFull { ref: r(thelook.gross_margin) label: 'Gross Margin' }
  } }
  block g_trend: VizBlock { label: 'Monthly Net Sales Trend' viz: CombinationChart {
    dataset: thelook
    x_axis: VizFieldFull { ref: r(thelook_order_items.created_at) transformation: 'datetrunc month' }
    y_axis { series { mark_type: 'line' field: VizFieldFull { ref: r(thelook.net_sales) label: 'Net Sales' } } }
  } }
  block g_country: VizBlock { label: 'Net Sales by Country' viz: CombinationChart {
    dataset: thelook
    x_axis: VizFieldFull { ref: r(thelook_users.country) label: 'Customer Country' }
    y_axis { series { mark_type: 'bar' field: VizFieldFull { ref: r(thelook.net_sales) label: 'Net Sales' } } }
  } }
  block g_state: VizBlock { label: 'Net Sales by State' viz: CombinationChart {
    dataset: thelook
    x_axis: VizFieldFull { ref: r(thelook_users.state) label: 'Customer State' }
    y_axis { series { mark_type: 'bar' field: VizFieldFull { ref: r(thelook.net_sales) label: 'Net Sales' } } }
  } }

  explicit_interactions: [
    FilterInteraction { from: 'f_date' to: ['o_sales', 'o_orders', 'o_margin', 'o_trend', 'o_category_sales', 'o_status_mix'] field: r(thelook_order_items.created_at) },
    FilterInteraction { from: 'f_category' to: ['o_sales', 'o_orders', 'o_margin', 'o_trend', 'o_category_sales', 'o_status_mix'] field: r(thelook_products.category) },
    FilterInteraction { from: 'f_department' to: ['o_sales', 'o_orders', 'o_margin', 'o_trend', 'o_category_sales', 'o_status_mix'] field: r(thelook_products.department) },
    FilterInteraction { from: 'f_country' to: ['o_sales', 'o_orders', 'o_margin', 'o_trend', 'o_category_sales', 'o_status_mix'] field: r(thelook_users.country) },
    DateDrillInteraction { from: 'd_grain' to: ['o_trend'] field: r(thelook_order_items.created_at) },
    PopInteraction { from: 'p_compare' to: ['o_sales', 'o_orders', 'o_margin', 'o_trend'] field: r(thelook_order_items.created_at) },
    FilterInteraction { from: 'p_f_date' to: ['p_sales', 'p_items', 'p_aov', 'p_trend', 'p_top', 'p_brand'] field: r(thelook_order_items.created_at) },
    FilterInteraction { from: 'p_f_category' to: ['p_sales', 'p_items', 'p_aov', 'p_trend', 'p_top', 'p_brand'] field: r(thelook_products.category) },
    FilterInteraction { from: 'p_f_department' to: ['p_sales', 'p_items', 'p_aov', 'p_trend', 'p_top', 'p_brand'] field: r(thelook_products.department) },
    FilterInteraction { from: 'p_f_country' to: ['p_sales', 'p_items', 'p_aov', 'p_trend', 'p_top', 'p_brand'] field: r(thelook_users.country) },
    DateDrillInteraction { from: 'p_d_grain' to: ['p_trend'] field: r(thelook_order_items.created_at) },
    PopInteraction { from: 'p_p_compare' to: ['p_sales', 'p_items', 'p_aov', 'p_trend'] field: r(thelook_order_items.created_at) },
    FilterInteraction { from: 'c_f_date' to: ['c_customers', 'c_sales', 'c_return', 'c_trend', 'c_country', 'c_locations'] field: r(thelook_order_items.created_at) },
    FilterInteraction { from: 'c_f_category' to: ['c_customers', 'c_sales', 'c_return', 'c_trend', 'c_country', 'c_locations'] field: r(thelook_products.category) },
    FilterInteraction { from: 'c_f_department' to: ['c_customers', 'c_sales', 'c_return', 'c_trend', 'c_country', 'c_locations'] field: r(thelook_products.department) },
    FilterInteraction { from: 'c_f_country' to: ['c_customers', 'c_sales', 'c_return', 'c_trend', 'c_country', 'c_locations'] field: r(thelook_users.country) },
    DateDrillInteraction { from: 'c_d_grain' to: ['c_trend'] field: r(thelook_order_items.created_at) },
    PopInteraction { from: 'c_p_compare' to: ['c_sales', 'c_return', 'c_trend'] field: r(thelook_order_items.created_at) },
    FilterInteraction { from: 'g_f_date' to: ['g_sales', 'g_orders', 'g_margin', 'g_trend', 'g_country', 'g_state'] field: r(thelook_order_items.created_at) },
    FilterInteraction { from: 'g_f_category' to: ['g_sales', 'g_orders', 'g_margin', 'g_trend', 'g_country', 'g_state'] field: r(thelook_products.category) },
    FilterInteraction { from: 'g_f_department' to: ['g_sales', 'g_orders', 'g_margin', 'g_trend', 'g_country', 'g_state'] field: r(thelook_products.department) },
    FilterInteraction { from: 'g_f_country' to: ['g_sales', 'g_orders', 'g_margin', 'g_trend', 'g_country', 'g_state'] field: r(thelook_users.country) },
    DateDrillInteraction { from: 'g_d_grain' to: ['g_trend'] field: r(thelook_order_items.created_at) },
    PopInteraction { from: 'g_p_compare' to: ['g_sales', 'g_orders', 'g_margin', 'g_trend'] field: r(thelook_order_items.created_at) }
  ]

  view: TabLayout {
    tab overview: CanvasLayout { label: 'Overview' width: 1220 height: 1120 grid_size: 20 auto_expand_vertically: true
      block o_title { position: pos(20, 20, 1180, 100) layer: 1 }
      block f_date { position: pos(20, 140, 180, 100) layer: 1 } block f_category { position: pos(220, 140, 180, 100) layer: 1 } block f_department { position: pos(420, 140, 180, 100) layer: 1 } block f_country { position: pos(620, 140, 180, 100) layer: 1 } block d_grain { position: pos(820, 140, 180, 100) layer: 1 } block p_compare { position: pos(1020, 140, 180, 100) layer: 1 }
      block o_sales { position: pos(20, 260, 380, 120) layer: 1 } block o_orders { position: pos(420, 260, 380, 120) layer: 1 } block o_margin { position: pos(820, 260, 380, 120) layer: 1 }
      block o_trend { position: pos(20, 400, 1180, 360) layer: 1 } block o_category_sales { position: pos(20, 780, 580, 320) layer: 1 } block o_status_mix { position: pos(620, 780, 580, 320) layer: 1 }
    }
    tab products: CanvasLayout { label: 'Products' width: 1220 height: 1120 grid_size: 20 auto_expand_vertically: true
      block p_title { position: pos(20, 20, 1180, 100) layer: 1 }
      block p_f_date { position: pos(20, 140, 180, 100) layer: 1 } block p_f_category { position: pos(220, 140, 180, 100) layer: 1 } block p_f_department { position: pos(420, 140, 180, 100) layer: 1 } block p_f_country { position: pos(620, 140, 180, 100) layer: 1 } block p_d_grain { position: pos(820, 140, 180, 100) layer: 1 } block p_p_compare { position: pos(1020, 140, 180, 100) layer: 1 }
      block p_sales { position: pos(20, 260, 380, 120) layer: 1 } block p_items { position: pos(420, 260, 380, 120) layer: 1 } block p_aov { position: pos(820, 260, 380, 120) layer: 1 }
      block p_trend { position: pos(20, 400, 1180, 360) layer: 1 } block p_top { position: pos(20, 780, 580, 320) layer: 1 } block p_brand { position: pos(620, 780, 580, 320) layer: 1 }
    }
    tab customers: CanvasLayout { label: 'Customers' width: 1220 height: 1120 grid_size: 20 auto_expand_vertically: true
      block c_title { position: pos(20, 20, 1180, 100) layer: 1 }
      block c_f_date { position: pos(20, 140, 180, 100) layer: 1 } block c_f_category { position: pos(220, 140, 180, 100) layer: 1 } block c_f_department { position: pos(420, 140, 180, 100) layer: 1 } block c_f_country { position: pos(620, 140, 180, 100) layer: 1 } block c_d_grain { position: pos(820, 140, 180, 100) layer: 1 } block c_p_compare { position: pos(1020, 140, 180, 100) layer: 1 }
      block c_customers { position: pos(20, 260, 380, 120) layer: 1 } block c_sales { position: pos(420, 260, 380, 120) layer: 1 } block c_return { position: pos(820, 260, 380, 120) layer: 1 }
      block c_trend { position: pos(20, 400, 1180, 360) layer: 1 } block c_country { position: pos(20, 780, 580, 320) layer: 1 } block c_locations { position: pos(620, 780, 580, 320) layer: 1 }
    }
    tab geography: CanvasLayout { label: 'Geography' width: 1220 height: 1120 grid_size: 20 auto_expand_vertically: true
      block g_title { position: pos(20, 20, 1180, 100) layer: 1 }
      block g_f_date { position: pos(20, 140, 180, 100) layer: 1 } block g_f_category { position: pos(220, 140, 180, 100) layer: 1 } block g_f_department { position: pos(420, 140, 180, 100) layer: 1 } block g_f_country { position: pos(620, 140, 180, 100) layer: 1 } block g_d_grain { position: pos(820, 140, 180, 100) layer: 1 } block g_p_compare { position: pos(1020, 140, 180, 100) layer: 1 }
      block g_sales { position: pos(20, 260, 380, 120) layer: 1 } block g_orders { position: pos(420, 260, 380, 120) layer: 1 } block g_margin { position: pos(820, 260, 380, 120) layer: 1 }
      block g_trend { position: pos(20, 400, 1180, 360) layer: 1 } block g_country { position: pos(20, 780, 580, 320) layer: 1 } block g_state { position: pos(620, 780, 580, 320) layer: 1 }
    }
  }
}