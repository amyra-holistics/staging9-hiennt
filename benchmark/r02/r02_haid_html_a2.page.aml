Dashboard r02_haid_html_a2 {
  title: 'Sales Performance Dashboard'
  description: @md
    Interactive sales performance monitoring across sales, products, customers, and geography.
    Use the shared date, category, and customer-country controls to refine every dashboard section.
  ;;
  theme: H.themes.classic

  settings {
    autorun_on_open: true
    autorun_on_changes: true
    cache_duration: 360
  }

  block f_order_item_created_at: FilterBlock {
    label: 'Order Item Created At'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block f_product_category: FilterBlock {
    label: 'Product Category'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.category)
    }
  }

  block f_customer_country: FilterBlock {
    label: 'Customer Country'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.country)
    }
  }

  block v_net_sales: VizBlock {
    label: 'Net Sales'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.net_sales)
    label: 'Net Sales'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
}
  }

  block v_gross_profit: VizBlock {
    label: 'Gross Profit'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.gross_profit)
    label: 'Gross Profit'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
}
  }

  block v_gross_margin: VizBlock {
    label: 'Gross Margin'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.gross_margin)
    label: 'Gross Margin'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
}
  }

  block v_total_orders: VizBlock {
    label: 'Orders'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.total_orders)
    label: 'Orders'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
}
  }

  block v_aov: VizBlock {
    label: 'Average Order Value'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.aov)
    label: 'Average Order Value'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
}
  }

  block v_sales_trend: VizBlock {
    label: 'Net Sales and Gross Profit Trend'
    viz: CombinationChart {
  dataset: thelook
  x_axis: VizFieldFull {
    label: 'Order Item Created Month'
    ref: r(thelook_order_items.created_at)
    transformation: 'datetrunc month'
    format {
      type: 'date'
      pattern: 'LLL yyyy'
    }
  }
  y_axis {
    label: 'Sales and Profit'
    series {
      mark_type: 'line'
      field: VizFieldFull {
        label: 'Net Sales'
        ref: r(thelook.net_sales)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
    series {
      mark_type: 'line'
      field: VizFieldFull {
        label: 'Gross Profit'
        ref: r(thelook.gross_profit)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }
  settings {
    x_axis_label: 'Order Item Created Month'
    legend_label: 'bottom'
    show_data_points: true
    sort: LineFamilySort {
      type: 'xaxis'
      direction: 'asc'
    }
  }
}
  }

  block v_status_mix: VizBlock {
    label: 'Sales and Item Mix by Status'
    viz: CombinationChart {
  dataset: thelook
  x_axis: VizFieldFull {
    ref: r(thelook_order_items.status)
    label: 'Order Item Status'
    format {
      type: 'text'
    }
  }
  y_axis {
    label: 'Gross Sales'
    series {
      mark_type: 'column'
      field: VizFieldFull {
        ref: r(thelook.gross_sales)
        label: 'Gross Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }
  y_axis {
    label: 'Items Sold'
    series {
      mark_type: 'column'
      field: VizFieldFull {
        ref: r(thelook.items_sold)
        label: 'Items Sold'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
    settings {
      alignment: 'right'
    }
  }
  settings {
    legend_label: 'top'
    sort: LineFamilySort {
      type: 'xaxis'
      direction: 'asc'
    }
  }
}
  }

  block v_product_category: VizBlock {
    label: 'Category Sales and Profit'
    viz: CombinationChart {
  dataset: thelook
  x_axis: VizFieldFull {
    ref: r(thelook_products.category)
    label: 'Product Category'
    format {
      type: 'text'
    }
  }
  y_axis {
    label: 'Sales and Profit'
    series {
      mark_type: 'bar'
      field: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
    series {
      mark_type: 'bar'
      field: VizFieldFull {
        ref: r(thelook.gross_profit)
        label: 'Gross Profit'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }
  settings {
    legend_label: 'top'
    sort: LineFamilySort {
      type: 'yaxis'
      field_index: 0
      direction: 'desc'
    }
  }
}
  }

  block v_product_brand: VizBlock {
    label: 'Brand Net Sales'
    viz: CombinationChart {
  dataset: thelook
  x_axis: VizFieldFull {
    ref: r(thelook_products.brand)
    label: 'Product Brand'
  }
  y_axis {
    series {
      mark_type: 'bar'
      field: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }
  settings {
    sort: LineFamilySort {
      type: 'yaxis'
      field_index: 0
      direction: 'desc'
    }
  }
}
  }

  block v_product_detail: VizBlock {
    label: 'Product Action Detail'
    viz: DataTable {
  dataset: thelook
  fields: [
    VizFieldFull {
      label: 'Product Name'
      ref: r(thelook_products.name)
      format {
        type: 'text'
      }
      uname: 'thelook_products_name_1'
    },
    VizFieldFull {
      label: 'SKU'
      ref: r(thelook_products.sku)
      format {
        type: 'text'
      }
      uname: 'thelook_products_sku_1'
    },
    VizFieldFull {
      label: 'Department'
      ref: r(thelook_products.department)
      format {
        type: 'text'
      }
    },
    VizFieldFull {
      label: 'Retail Price'
      ref: r(thelook_products.retail_price)
      format {
        type: 'number'
        pattern: '[$$]#,###0.00'
      }
    },
    VizFieldFull {
      label: 'Net Sales'
      ref: r(thelook.net_sales)
      format {
        type: 'number'
        pattern: 'inherited'
      }
      uname: 'custom_net_sales_1'
    },
    VizFieldFull {
      label: 'Gross Profit'
      ref: r(thelook.gross_profit)
      format {
        type: 'number'
        pattern: 'inherited'
      }
    },
    VizFieldFull {
      label: 'Items Sold'
      ref: r(thelook.items_sold)
      format {
        type: 'number'
        pattern: 'inherited'
      }
    },
    VizFieldFull {
      label: 'Return Rate'
      ref: r(thelook.return_rate)
      format {
        type: 'number'
        pattern: 'inherited'
      }
    }
  ]
  settings {
    pagination_size: 100
    show_row_number: true
    wrap_header_text: true
    sorts: [
      KeyBasedSortSetting {
        key: 'custom_net_sales_1'
        direction: 'desc'
      },
      KeyBasedSortSetting {
        key: 'thelook_products_name_1'
        direction: 'asc'
      },
      KeyBasedSortSetting {
        key: 'thelook_products_sku_1'
        direction: 'asc'
      }
    ]
    single_cell_display: 'normal'
  }
}
  }

  block v_customer_country: VizBlock {
    label: 'Customer Country Performance'
    viz: CombinationChart {
  dataset: thelook
  x_axis: VizFieldFull {
    ref: r(thelook_users.country)
    label: 'Customer Country'
    format {
      type: 'text'
    }
  }
  y_axis {
    label: 'Net Sales'
    series {
      mark_type: 'bar'
      field: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }
  y_axis {
    label: 'Customers'
    series {
      mark_type: 'bar'
      field: VizFieldFull {
        ref: r(thelook.customers)
        label: 'Customers'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
    settings {
      alignment: 'right'
    }
  }
  settings {
    legend_label: 'hidden'
    sort: LineFamilySort {
      type: 'yaxis'
      field_index: 0
      direction: 'desc'
    }
  }
}
  }

  block v_customer_gender: VizBlock {
    label: 'Sales and AOV by Gender'
    viz: CombinationChart {
  dataset: thelook
  x_axis: VizFieldFull {
    ref: r(thelook_users.gender)
    label: 'Customer Gender'
  }
  y_axis {
    label: 'Net Sales'
    series {
      mark_type: 'column'
      field: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }
  y_axis {
    label: 'Average Order Value'
    series {
      mark_type: 'column'
      field: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
    settings {
      alignment: 'right'
    }
  }
  settings {
    legend_label: 'top'
    sort: LineFamilySort {
      type: 'xaxis'
      direction: 'asc'
    }
  }
}
  }

  block v_customer_age: VizBlock {
    label: 'Sales and Orders by Age'
    viz: CombinationChart {
  dataset: thelook
  x_axis: VizFieldFull {
    ref: r(thelook_users.age)
    label: 'Customer Age'
    format {
      type: 'number'
      pattern: '#,###'
    }
  }
  y_axis {
    label: 'Net Sales'
    series {
      mark_type: 'column'
      field: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }
  y_axis {
    label: 'Orders'
    series {
      mark_type: 'column'
      field: VizFieldFull {
        ref: r(thelook.total_orders)
        label: 'Orders'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
    settings {
      alignment: 'right'
    }
  }
  settings {
    sort: LineFamilySort {
      type: 'xaxis'
      direction: 'asc'
    }
  }
}
  }

  block v_geography_country: VizBlock {
    label: 'Net Sales by Country'
    viz: FilledMap {
  dataset: thelook
  location {
    field: VizFieldFull {
      ref: r(thelook_users.country)
      label: 'Customer Country'
      format {
        type: 'text'
      }
    }
    location_type: 'country'
    primary_field: true
  }
  value: VizFieldFull {
    ref: r(thelook.net_sales)
    label: 'Net Sales'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
  settings {
    color_scale: 'vertical'
  }
}
  }

  block v_geography_city: VizBlock {
    label: 'Net Sales by City'
    viz: CombinationChart {
  dataset: thelook
  x_axis: VizFieldFull {
    ref: r(thelook_users.city)
    label: 'Customer City'
  }
  y_axis {
    label: 'Net Sales'
    series {
      mark_type: 'bar'
      field: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }
  settings {
    sort: LineFamilySort {
      type: 'yaxis'
      field_index: 0
      direction: 'desc'
    }
  }
}
  }

  block v_distribution_centers: VizBlock {
    label: 'Distribution Center Locations'
    viz: PointMap {
  dataset: thelook
  lat: VizFieldFull {
    ref: r(thelook_distribution_centers.latitude)
    format {
      type: 'number'
      pattern: '#,###0.00'
    }
  }
  lng: VizFieldFull {
    ref: r(thelook_distribution_centers.longitude)
    format {
      type: 'number'
      pattern: '#,###0.00'
    }
  }
}
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'f_order_item_created_at'
      to: [
        'v_net_sales', 'v_gross_profit', 'v_gross_margin', 'v_total_orders', 'v_aov',
        'v_sales_trend', 'v_status_mix', 'v_product_category', 'v_product_brand', 'v_product_detail',
        'v_customer_country', 'v_customer_gender', 'v_customer_age',
        'v_geography_country', 'v_geography_city', 'v_distribution_centers'
      ]
      field: r(thelook_order_items.created_at)
    },
    FilterInteraction {
      from: 'f_product_category'
      to: [
        'v_net_sales', 'v_gross_profit', 'v_gross_margin', 'v_total_orders', 'v_aov',
        'v_sales_trend', 'v_status_mix', 'v_product_category', 'v_product_brand', 'v_product_detail',
        'v_customer_country', 'v_customer_gender', 'v_customer_age',
        'v_geography_country', 'v_geography_city', 'v_distribution_centers'
      ]
      field: r(thelook_products.category)
    },
    FilterInteraction {
      from: 'f_customer_country'
      to: [
        'v_net_sales', 'v_gross_profit', 'v_gross_margin', 'v_total_orders', 'v_aov',
        'v_sales_trend', 'v_status_mix', 'v_product_category', 'v_product_brand', 'v_product_detail',
        'v_customer_country', 'v_customer_gender', 'v_customer_age',
        'v_geography_country', 'v_geography_city', 'v_distribution_centers'
      ]
      field: r(thelook_users.country)
    }
  ]

  view: HTMLLayout {
    content: @html
      <style>
        :root { --ink: #172033; --muted: #667085; --surface: #ffffff; --canvas: #f6f8fb; --line: #e3e8ef; --accent: #2563eb; }
        .sales-dashboard { max-width: 1440px; margin: 0 auto; padding: 24px; background: var(--canvas); color: var(--ink); font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
        .hero { padding: 28px 32px; border-radius: 18px; color: #ffffff; background: linear-gradient(120deg, #172554, #2563eb); }
        .eyebrow { margin: 0 0 8px; color: #bfdbfe; font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
        .hero h1 { margin: 0; font-size: 30px; line-height: 1.2; }
        .hero p { max-width: 720px; margin: 10px 0 0; color: #dbeafe; }
        .tab-nav { display: flex; gap: 8px; flex-wrap: wrap; margin: 20px 0; padding: 8px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); }
        .tab-nav a { padding: 9px 14px; border-radius: 8px; color: var(--muted); font-size: 14px; font-weight: 700; text-decoration: none; }
        .tab-nav a:hover { color: #ffffff; background: var(--accent); }
        .filter-bar, .kpi-grid, .two-col { display: grid; gap: 16px; }
        .filter-bar { grid-template-columns: repeat(3, minmax(220px, 1fr)); margin-bottom: 24px; }
        .kpi-grid { grid-template-columns: repeat(5, minmax(150px, 1fr)); }
        .two-col { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .tab-panel { scroll-margin-top: 16px; margin-top: 28px; padding: 24px; border: 1px solid var(--line); border-radius: 16px; background: var(--surface); box-shadow: 0 1px 3px rgba(16, 24, 40, .04); }
        .section-heading { margin: 0 0 4px; font-size: 22px; }
        .section-note { margin: 0 0 20px; color: var(--muted); }
        .chart-card { min-width: 0; padding: 4px; border: 1px solid var(--line); border-radius: 12px; background: #ffffff; }
        .chart-card--wide { margin-top: 16px; }
        .map-note { margin: 12px 0 0; color: var(--muted); font-size: 13px; }
        @media (max-width: 1024px) { .kpi-grid { grid-template-columns: repeat(3, minmax(150px, 1fr)); } }
        @media (max-width: 720px) { .sales-dashboard { padding: 12px; } .filter-bar, .kpi-grid, .two-col { grid-template-columns: 1fr; } .hero { padding: 22px; } }
      </style>

      <main class="sales-dashboard">
        <header class="hero">
          <p class="eyebrow">TheLook eCommerce</p>
          <h1>Sales Performance Dashboard</h1>
          <p>Monitor sales health, product performance, customer behavior, and geographic contribution through a single consistent lens.</p>
        </header>

        <nav class="tab-nav" aria-label="Dashboard sections">
          <a href="#overview">Overview</a>
          <a href="#products">Products</a>
          <a href="#customers">Customers</a>
          <a href="#geography">Geography</a>
        </nav>

        <section class="filter-bar" aria-label="Shared dashboard filters">
          <h-block name="f_order_item_created_at" />
          <h-block name="f_product_category" />
          <h-block name="f_customer_country" />
        </section>

        <section id="overview" class="tab-panel" aria-label="Overview tab">
          <h2 class="section-heading">Overview</h2>
          <p class="section-note">What is the current sales outcome, and how are sales and profit changing over time?</p>
          <div class="kpi-grid">
            <div class="chart-card"><h-block name="v_net_sales" /></div>
            <div class="chart-card"><h-block name="v_gross_profit" /></div>
            <div class="chart-card"><h-block name="v_gross_margin" /></div>
            <div class="chart-card"><h-block name="v_total_orders" /></div>
            <div class="chart-card"><h-block name="v_aov" /></div>
          </div>
          <div class="chart-card chart-card--wide"><h-block name="v_sales_trend" /></div>
          <div class="chart-card chart-card--wide"><h-block name="v_status_mix" /></div>
        </section>

        <section id="products" class="tab-panel" aria-label="Products tab">
          <h2 class="section-heading">Products</h2>
          <p class="section-note">Which categories, brands, and individual products create sales and gross profit?</p>
          <div class="two-col">
            <div class="chart-card"><h-block name="v_product_category" /></div>
            <div class="chart-card"><h-block name="v_product_brand" /></div>
          </div>
          <div class="chart-card chart-card--wide"><h-block name="v_product_detail" /></div>
        </section>

        <section id="customers" class="tab-panel" aria-label="Customers tab">
          <h2 class="section-heading">Customers</h2>
          <p class="section-note">How does customer value vary by country, gender, and age?</p>
          <div class="two-col">
            <div class="chart-card"><h-block name="v_customer_country" /></div>
            <div class="chart-card"><h-block name="v_customer_gender" /></div>
          </div>
          <div class="chart-card chart-card--wide"><h-block name="v_customer_age" /></div>
        </section>

        <section id="geography" class="tab-panel" aria-label="Geography tab">
          <h2 class="section-heading">Geography</h2>
          <p class="section-note">Where do customer sales concentrate, and where are the distribution centers located?</p>
          <div class="two-col">
            <div class="chart-card"><h-block name="v_geography_country" /></div>
            <div class="chart-card"><h-block name="v_geography_city" /></div>
          </div>
          <div class="chart-card chart-card--wide"><h-block name="v_distribution_centers" /></div>
          <p class="map-note">Distribution-center locations are an operational reference only; this dashboard does not attribute customer sales to distribution centers.</p>
        </section>
      </main>
    ;;
  }
}
