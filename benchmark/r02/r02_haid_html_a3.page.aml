Dashboard r02_haid_html_a3 {
  title: 'Sales Performance Hub'
  description: @md
    Explore sales performance across overview, product, customer, and geographic perspectives. Use the shared date, category, and country filters to focus every applicable view.
  ;;

  block f_date: FilterBlock {
    label: 'Sales Date'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block f_category: FilterBlock {
    label: 'Product Category'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.category)
    }
  }

  block f_country: FilterBlock {
    label: 'Customer Country'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.country)
    }
  }

  block v_net_sales: VizBlock {
    label: 'Net Sales'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.net_sales)
    label: 'Net Sales'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
}
  }

  block v_fulfilled_orders: VizBlock {
    label: 'Fulfilled Orders'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.fulfilled_orders)
    label: 'Fulfilled Orders'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
}
  }

  block v_gross_margin: VizBlock {
    label: 'Gross Margin'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.gross_margin)
    label: 'Gross Margin'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
}
  }

  block v_sales_trend: VizBlock {
    label: 'Monthly Net Sales'
    viz: CombinationChart {
  dataset: thelook
  x_axis: VizFieldFull {
    ref: r(thelook_order_items.created_at)
    transformation: 'datetrunc month'
    format {
      type: 'date'
      pattern: 'LLL yyyy'
    }
  }
  y_axis {
    series {
      mark_type: 'line'
      field: VizFieldFull {
        ref: r(thelook.net_sales)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }
  settings {
    sort: LineFamilySort {
      type: 'xaxis'
      direction: 'asc'
    }
  }
}
  }

  block v_sales_category: VizBlock {
    label: 'Net Sales by Category'
    viz: CombinationChart {
  dataset: thelook
  x_axis: VizFieldFull {
    ref: r(thelook_products.category)
    label: 'Product Category'
  }
  y_axis {
    series {
      mark_type: 'bar'
      field: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }
  tooltips: [
    VizTooltip {
      field: VizFieldFull {
        ref: r(thelook.gross_profit)
        label: 'Gross Profit'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  ]
  settings {
    sort: LineFamilySort {
      type: 'yaxis'
      field_index: 0
      direction: 'desc'
    }
  }
}
  }

  block v_product_performance: VizBlock {
    label: 'Product Performance'
    viz: DataTable {
  dataset: thelook
  fields: [
    VizFieldFull {
      label: 'Product Name'
      ref: r(thelook_products.name)
      format {
        type: 'text'
      }
      uname: 'product_name'
    },
    VizFieldFull {
      label: 'Brand'
      ref: r(thelook_products.brand)
      format {
        type: 'text'
      }
      uname: 'product_brand'
    },
    VizFieldFull {
      label: 'Net Sales'
      ref: r(thelook.net_sales)
      format {
        type: 'number'
        pattern: 'inherited'
      }
      uname: 'net_sales'
    },
    VizFieldFull {
      label: 'Gross Profit'
      ref: r(thelook.gross_profit)
      format {
        type: 'number'
        pattern: 'inherited'
      }
      uname: 'gross_profit'
    },
    VizFieldFull {
      label: 'Items Sold'
      ref: r(thelook.items_sold)
      format {
        type: 'number'
        pattern: 'inherited'
      }
      uname: 'items_sold'
    }
  ]
  settings {
    pagination_size: 100
    show_row_number: false
    wrap_header_text: true
    wrap_cell_text: false
    sorts: [
      KeyBasedSortSetting {
        key: 'net_sales'
        direction: 'desc'
      },
      KeyBasedSortSetting {
        key: 'product_name'
        direction: 'asc'
      },
      KeyBasedSortSetting {
        key: 'product_brand'
        direction: 'asc'
      }
    ]
  }
}
  }

  block v_customer_growth: VizBlock {
    label: 'Customer Registrations'
    viz: CombinationChart {
  dataset: thelook
  x_axis: VizFieldFull {
    ref: r(thelook_users.created_at)
    label: 'Registration Month'
    transformation: 'datetrunc month'
    format {
      type: 'date'
      pattern: 'LLL yyyy'
    }
  }
  y_axis {
    series {
      mark_type: 'line'
      field: VizFieldFull {
        ref: r(thelook.customers)
        label: 'Newly Registered Customers'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }
  settings {
    sort: LineFamilySort {
      type: 'xaxis'
      direction: 'asc'
    }
  }
}
  }

  block v_customer_mix: VizBlock {
    label: 'Customer Mix by Acquisition Channel'
    viz: CombinationChart {
  dataset: thelook
  x_axis: VizFieldFull {
    ref: r(thelook_users.traffic_source)
    label: 'Traffic Source'
    format {
      type: 'text'
    }
  }
  legend: VizFieldFull {
    ref: r(thelook_users.gender)
    label: 'Gender'
    format {
      type: 'text'
    }
  }
  y_axis {
    series {
      mark_type: 'column'
      field: VizFieldFull {
        ref: r(thelook.customers)
        label: 'Customer Count'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }
  settings {
    sort: LineFamilySort {
      type: 'xaxis'
      direction: 'asc'
    }
  }
}
  }

  block v_sales_country: VizBlock {
    label: 'Net Sales by Country'
    viz: CombinationChart {
  dataset: thelook
  x_axis: VizFieldFull {
    ref: r(thelook_users.country)
    label: 'Customer Country'
  }
  y_axis {
    series {
      mark_type: 'bar'
      field: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }
  settings {
    sort: LineFamilySort {
      type: 'yaxis'
      field_index: 0
      direction: 'desc'
    }
  }
}
  }

  block v_sales_state: VizBlock {
    label: 'Net Sales by State'
    viz: DataTable {
  dataset: thelook
  fields: [
    VizFieldFull {
      label: 'Customer State'
      ref: r(thelook_users.state)
      format {
        type: 'text'
      }
    },
    VizFieldFull {
      label: 'Net Sales'
      ref: r(thelook.net_sales)
      format {
        type: 'number'
        pattern: 'inherited'
      }
      uname: 'net_sales'
    }
  ]
  settings {
    pagination_size: 100
    show_row_number: false
    wrap_header_text: true
    sorts: [
      KeyBasedSortSetting {
        key: 'net_sales'
        direction: 'desc'
      }
    ]
  }
}
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'f_date'
      to: [
        'v_net_sales',
        'v_fulfilled_orders',
        'v_gross_margin',
        'v_sales_trend',
        'v_sales_category',
        'v_product_performance',
        'v_sales_country',
        'v_sales_state',
      ]
      field: r(thelook_order_items.created_at)
    },
    FilterInteraction {
      from: 'f_date'
      to: ['v_customer_growth', 'v_customer_mix']
      field: r(thelook_users.created_at)
    },
    FilterInteraction {
      from: 'f_category'
      to: [
        'v_net_sales',
        'v_fulfilled_orders',
        'v_gross_margin',
        'v_sales_trend',
        'v_sales_category',
        'v_product_performance',
        'v_sales_country',
        'v_sales_state',
      ]
      field: r(thelook_products.category)
    },
    FilterInteraction {
      from: 'f_country'
      to: [
        'v_net_sales',
        'v_fulfilled_orders',
        'v_gross_margin',
        'v_sales_trend',
        'v_sales_category',
        'v_product_performance',
        'v_customer_growth',
        'v_customer_mix',
        'v_sales_country',
        'v_sales_state',
      ]
      field: r(thelook_users.country)
    },
  ]

  view: HTMLLayout {
    content: @html
      <style>
        :root {
          --ink: #172033;
          --muted: #64748b;
          --brand: #2563eb;
          --brand-soft: #eff6ff;
          --surface: #ffffff;
          --canvas: #f8fafc;
          --border: #dbe4f0;
        }
        * { box-sizing: border-box; }
        .sales-dashboard {
          max-width: 1440px;
          margin: 0 auto;
          padding: 28px;
          color: var(--ink);
          background: var(--canvas);
          font-family: Inter, ui-sans-serif, system-ui, sans-serif;
        }
        .sales-hero {
          display: flex;
          justify-content: space-between;
          align-items: end;
          gap: 24px;
          margin-bottom: 22px;
        }
        .eyebrow { color: var(--brand); font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
        h1 { margin: 6px 0; font-size: 32px; line-height: 1.1; }
        .subtitle { margin: 0; color: var(--muted); }
        .filter-grid, .kpi-grid, .two-column { display: grid; gap: 18px; }
        .filter-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); margin-bottom: 22px; }
        .kpi-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); margin-bottom: 18px; }
        .two-column { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .tab-nav { display: flex; gap: 8px; border-bottom: 1px solid var(--border); margin: 26px 0 20px; overflow-x: auto; }
        .tab-nav a { color: var(--muted); padding: 12px 16px; text-decoration: none; font-weight: 650; border-bottom: 3px solid transparent; white-space: nowrap; }
        .tab-nav a:hover, .tab-nav a:focus { color: var(--brand); background: var(--brand-soft); }
        .tab-panel { display: none; }
        #tab-products:target, #tab-customers:target, #tab-geography:target { display: block; }
        #tab-overview { display: block; }
        #tab-products:target ~ #tab-overview, #tab-customers:target ~ #tab-overview, #tab-geography:target ~ #tab-overview { display: none; }
        .tab-heading { margin: 0 0 4px; font-size: 22px; }
        .tab-copy { margin: 0 0 18px; color: var(--muted); }
        .card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 16px; min-width: 0; }
        .card.tall { min-height: 430px; }
        .card.short { min-height: 360px; }
        h-block { display: block; min-width: 0; }
        @media (max-width: 860px) {
          .sales-dashboard { padding: 16px; }
          .sales-hero, .filter-grid, .kpi-grid, .two-column { grid-template-columns: 1fr; display: grid; }
        }
      </style>

      <main class="sales-dashboard">
        <header class="sales-hero">
          <div>
            <div class="eyebrow">TheLook Commerce</div>
            <h1>Sales Performance Hub</h1>
            <p class="subtitle">Monitor commercial performance, product demand, customer acquisition, and geographic mix.</p>
          </div>
        </header>

        <section class="filter-grid" aria-label="Shared filters">
          <div class="card"><h-block name="f_date" /></div>
          <div class="card"><h-block name="f_category" /></div>
          <div class="card"><h-block name="f_country" /></div>
        </section>

        <nav class="tab-nav" aria-label="Sales dashboard tabs">
          <a href="#tab-overview">Overview</a>
          <a href="#tab-products">Products</a>
          <a href="#tab-customers">Customers</a>
          <a href="#tab-geography">Geography</a>
        </nav>

        <section id="tab-products" class="tab-panel">
          <h2 class="tab-heading">Products</h2>
          <p class="tab-copy">Identify the categories and products contributing most to sales and profit.</p>
          <div class="two-column">
            <div class="card tall"><h-block name="v_sales_category" /></div>
            <div class="card tall"><h-block name="v_product_performance" /></div>
          </div>
        </section>

        <section id="tab-customers" class="tab-panel">
          <h2 class="tab-heading">Customers</h2>
          <p class="tab-copy">Track customer registrations and understand acquisition-channel mix.</p>
          <div class="two-column">
            <div class="card tall"><h-block name="v_customer_growth" /></div>
            <div class="card tall"><h-block name="v_customer_mix" /></div>
          </div>
        </section>

        <section id="tab-geography" class="tab-panel">
          <h2 class="tab-heading">Geography</h2>
          <p class="tab-copy">Compare customer markets at country and state level.</p>
          <div class="two-column">
            <div class="card tall"><h-block name="v_sales_country" /></div>
            <div class="card tall"><h-block name="v_sales_state" /></div>
          </div>
        </section>

        <section id="tab-overview" class="tab-panel">
          <h2 class="tab-heading">Overview</h2>
          <p class="tab-copy">Start with headline commercial health, then use the tabs to investigate the drivers.</p>
          <div class="kpi-grid">
            <div class="card"><h-block name="v_net_sales" /></div>
            <div class="card"><h-block name="v_fulfilled_orders" /></div>
            <div class="card"><h-block name="v_gross_margin" /></div>
          </div>
          <div class="card short"><h-block name="v_sales_trend" /></div>
        </section>
      </main>
    ;;
  }
}
