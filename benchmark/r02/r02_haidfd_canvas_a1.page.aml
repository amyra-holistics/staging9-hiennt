Dashboard r02_haidfd_canvas_a1 {
  title: 'Sales Performance'
  description: @md
A four-tab sales performance dashboard scaffold. Use the shared filters to define a neutral commercial slice before data blocks are added.
  ;;
  theme: H.themes.classic

  settings {
    autorun_on_open: false
    autorun_on_changes: false
  }

  // Shared, neutral controls. No defaults are declared, so each opens unfiltered.
  block f_sales_date: FilterBlock {
    label: 'Sales Date'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block f_product_department: FilterBlock {
    label: 'Product Department'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.department)
    }
  }

  block f_product_category: FilterBlock {
    label: 'Product Category'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.category)
    }
  }

  block f_customer_country: FilterBlock {
    label: 'Customer Country'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.country)
    }
  }

  block f_customer_state: FilterBlock {
    label: 'Customer State'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.state)
    }
  }

  block t_overview: TextBlock {
    content: @md
# Sales Performance

## Overview
Use the shared filters to set the sales slice. Data blocks will be added here.
    ;;
  }

  block t_products: TextBlock {
    content: @md
# Sales Performance

## Products
Use the shared filters to focus product performance. Data blocks will be added here.
    ;;
  }

  block t_customers: TextBlock {
    content: @md
# Sales Performance

## Customers
Use the shared filters to focus customer segments. Data blocks will be added here.
    ;;
  }

  block t_geography: TextBlock {
    content: @md
# Sales Performance

## Geography
Customer geography refers to the purchaser's registered location. Data blocks will be added here.
    ;;
  }

  block overview_net_sales_kpi: VizBlock {
    label: 'Net Sales'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block overview_fulfilled_orders_kpi: VizBlock {
    label: 'Fulfilled Orders'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        label: 'Fulfilled Orders'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block overview_gross_profit_kpi: VizBlock {
    label: 'Gross Profit'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_profit)
        label: 'Gross Profit'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block overview_average_order_value_kpi: VizBlock {
    label: 'Average Order Value'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block overview_monthly_net_sales_trend: VizBlock {
    label: 'Monthly Net Sales'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        label: 'Order Item Created Month'
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        series {
          mark_type: 'line'
          field: VizFieldFull {
            label: 'Net Sales'
            ref: r(thelook.net_sales)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block overview_net_sales_by_traffic_source: VizBlock {
    label: 'Net Sales by Traffic Source'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.traffic_source)
        label: 'Traffic Source'
      }
      y_axis {
        series {
          mark_type: 'bar'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block products_net_sales_kpi: VizBlock {
    label: 'Net Sales'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
    settings {
      hide_label: true
    }
  }

  block products_gross_margin_kpi: VizBlock {
    label: 'Gross Margin'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
    settings {
      hide_label: true
    }
  }

  block products_items_sold_kpi: VizBlock {
    label: 'Items Sold'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.items_sold)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
    settings {
      hide_label: true
    }
  }

  block products_return_rate_kpi: VizBlock {
    label: 'Return Rate'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.return_rate)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
    settings {
      hide_label: true
    }
  }

  block products_top_net_sales: VizBlock {
    label: 'Top Products by Net Sales'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.name)
        label: 'Product Name'
      }
      y_axis {
        series {
          mark_type: 'bar'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        row_limit: 10
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block products_category_sales_margin: VizBlock {
    label: 'Category Sales and Gross Margin'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Product Category'
      }
      y_axis {
        label: 'Net Sales'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        settings {
          alignment: 'left'
        }
      }
      y_axis {
        label: 'Gross Margin'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(thelook.gross_margin)
            label: 'Gross Margin'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        settings {
          alignment: 'right'
        }
      }
      settings {
        legend_label: 'bottom'
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block customer_fulfilled_orders_kpi: VizBlock {
    label: 'Fulfilled Orders'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        label: 'Fulfilled Orders'
        format { type: 'number' pattern: 'inherited' }
      }
    }
    settings { hide_label: true }
  }

  block customer_aov_kpi: VizBlock {
    label: 'Average Order Value'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'
        format { type: 'number' pattern: 'inherited' }
      }
    }
    settings { hide_label: true }
  }

  block customer_net_sales_kpi: VizBlock {
    label: 'Net Sales'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format { type: 'number' pattern: 'inherited' }
      }
    }
    settings { hide_label: true }
  }

  block customer_purchase_trend: VizBlock {
    label: 'Customer Purchase Trend'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        label: 'Order Item Month'
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format { type: 'date' pattern: 'LLL yyyy' }
      }
      y_axis {
        label: 'Net Sales'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            label: 'Net Sales'
            ref: r(thelook.net_sales)
            format { type: 'number' pattern: 'inherited' }
          }
        }
      }
      y_axis {
        label: 'Fulfilled Orders'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            label: 'Fulfilled Orders'
            ref: r(thelook.fulfilled_orders)
            format { type: 'number' pattern: 'inherited' }
          }
        }
        settings { alignment: 'right' }
      }
      settings {
        sort: LineFamilySort { type: 'xaxis' direction: 'asc' }
        legend_label: 'bottom'
      }
    }
  }

  block customer_acquisition_source_quality: VizBlock {
    label: 'Acquisition-source Quality'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.traffic_source)
        label: 'Customer Traffic Source'
        format { type: 'text' }
      }
      y_axis {
        label: 'Net Sales'
        series {
          mark_type: 'bar'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format { type: 'number' pattern: 'inherited' }
          }
        }
      }
      settings {
        legend_label: 'hidden'
        sort: LineFamilySort { type: 'yaxis' field_index: 0 direction: 'desc' }
      }
    }
  }

  block customer_gender_performance: VizBlock {
    label: 'Gender Performance'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.gender)
        label: 'Customer Gender'
        format { type: 'text' }
      }
      y_axis {
        label: 'Net Sales'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format { type: 'number' pattern: 'inherited' }
          }
        }
      }
      y_axis {
        label: 'Average Order Value'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(thelook.aov)
            label: 'Average Order Value'
            format { type: 'number' pattern: 'inherited' }
          }
        }
        settings { alignment: 'right' }
      }
      settings {
        legend_label: 'top'
        sort: LineFamilySort { type: 'xaxis' direction: 'asc' }
      }
    }
  }

  block customer_age_profile: VizBlock {
    label: 'Age Profile'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.age)
        label: 'Customer Age'
        format { type: 'number' pattern: '#,###' }
      }
      y_axis {
        label: 'Customer Count'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(thelook.customers)
            label: 'Customer Count'
            format { type: 'number' pattern: 'inherited' }
          }
        }
      }
      settings {
        x_axis_label: 'Customer Age'
        legend_label: 'hidden'
        sort: LineFamilySort { type: 'xaxis' direction: 'asc' }
      }
    }
  }

  block customer_segment_table: VizBlock {
    label: 'Customer Segment Table'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull { label: 'Traffic Source' ref: r(thelook_users.traffic_source) uname: 'traffic_source' },
        VizFieldFull { label: 'Gender' ref: r(thelook_users.gender) uname: 'gender' },
        VizFieldFull { label: 'Net Sales' ref: r(thelook.net_sales) format { type: 'number' pattern: 'inherited' } },
        VizFieldFull { label: 'Gross Margin' ref: r(thelook.gross_margin) format { type: 'number' pattern: 'inherited' } },
        VizFieldFull { label: 'Fulfilled Orders' ref: r(thelook.fulfilled_orders) format { type: 'number' pattern: 'inherited' } },
        VizFieldFull { label: 'Average Order Value' ref: r(thelook.aov) format { type: 'number' pattern: 'inherited' } },
        VizFieldFull { label: 'Return Rate' ref: r(thelook.return_rate) format { type: 'number' pattern: 'inherited' } }
      ]
      settings {
        pagination_size: 100
        show_row_number: true
        wrap_header_text: true
        sorts: [
          KeyBasedSortSetting { key: 'traffic_source' direction: 'asc' },
          KeyBasedSortSetting { key: 'gender' direction: 'asc' }
        ]
      }
    }
  }

  block geography_net_sales_kpi: VizBlock {
    label: 'Net Sales'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format { type: 'number' pattern: 'inherited' }
      }
    }
    settings { hide_label: true }
  }

  block geography_gross_profit_kpi: VizBlock {
    label: 'Gross Profit'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_profit)
        label: 'Gross Profit'
        format { type: 'number' pattern: 'inherited' }
      }
    }
    settings { hide_label: true }
  }

  block geography_gross_margin_kpi: VizBlock {
    label: 'Gross Margin'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format { type: 'number' pattern: 'inherited' }
      }
    }
    settings { hide_label: true }
  }

  block geography_country_performance: VizBlock {
    label: 'Country Performance'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.country)
        label: 'Customer Country'
        format { type: 'text' }
      }
      y_axis {
        series {
          mark_type: 'bar'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format { type: 'number' pattern: 'inherited' }
          }
        }
      }
      settings {
        sort: LineFamilySort { type: 'yaxis' field_index: 0 direction: 'desc' }
      }
    }
  }

  block geography_country_margin_comparison: VizBlock {
    label: 'Country Margin Comparison'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.country)
        label: 'Customer Country'
      }
      y_axis {
        label: 'Gross Margin'
        series {
          mark_type: 'bar'
          field: VizFieldFull {
            ref: r(thelook.gross_margin)
            label: 'Gross Margin'
            format { type: 'number' pattern: 'inherited' }
          }
        }
      }
      tooltips: [
        VizTooltip {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format { type: 'number' pattern: 'inherited' }
          }
        }
      ]
      settings {
        legend_label: 'hidden'
        sort: LineFamilySort { type: 'tooltip' field_index: 0 direction: 'desc' }
      }
    }
  }

  block geography_state_performance: VizBlock {
    label: 'State Performance'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.state)
        label: 'Customer State'
      }
      y_axis {
        label: 'Net Sales'
        series {
          mark_type: 'bar'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format { type: 'number' pattern: 'inherited' }
          }
        }
      }
      settings {
        row_limit: 15
        sort: LineFamilySort { type: 'yaxis' field_index: 0 direction: 'desc' }
      }
    }
  }

  block geography_city_leaderboard: VizBlock {
    label: 'City Leaderboard'
    viz: DataTable {
      dataset: thelook
      filter {
        field: r(thelook.net_sales)
        operator: 'not_null'
        value: []
      }
      fields: [
        VizFieldFull { label: 'Country' ref: r(thelook_users.country) format { type: 'text' } uname: 'customer_country' },
        VizFieldFull { label: 'State' ref: r(thelook_users.state) format { type: 'text' } uname: 'customer_state' },
        VizFieldFull { label: 'City' ref: r(thelook_users.city) format { type: 'text' } uname: 'customer_city' },
        VizFieldFull { label: 'Net Sales' ref: r(thelook.net_sales) format { type: 'number' pattern: 'inherited' } uname: 'net_sales' },
        VizFieldFull { label: 'Gross Profit' ref: r(thelook.gross_profit) format { type: 'number' pattern: 'inherited' } },
        VizFieldFull { label: 'Gross Margin' ref: r(thelook.gross_margin) format { type: 'number' pattern: 'inherited' } },
        VizFieldFull { label: 'Fulfilled Orders' ref: r(thelook.fulfilled_orders) format { type: 'number' pattern: 'inherited' } },
        VizFieldFull { label: 'Return Rate' ref: r(thelook.return_rate) format { type: 'number' pattern: 'inherited' } }
      ]
      settings {
        pagination_size: 100
        show_row_number: true
        sorts: [KeyBasedSortSetting { key: 'net_sales' direction: 'desc' }]
        single_cell_display: 'normal'
      }
    }
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'f_sales_date'
      to: [
        'overview_net_sales_kpi',
        'overview_fulfilled_orders_kpi',
        'overview_gross_profit_kpi',
        'overview_average_order_value_kpi',
        'overview_monthly_net_sales_trend',
        'overview_net_sales_by_traffic_source',
        'products_net_sales_kpi',
        'products_gross_margin_kpi',
        'products_items_sold_kpi',
        'products_return_rate_kpi',
        'products_top_net_sales',
        'products_category_sales_margin',
        'customer_fulfilled_orders_kpi',
        'customer_aov_kpi',
        'customer_net_sales_kpi',
        'customer_purchase_trend',
        'customer_acquisition_source_quality',
        'customer_gender_performance',
        'customer_segment_table',
        'geography_net_sales_kpi',
        'geography_gross_profit_kpi',
        'geography_gross_margin_kpi',
        'geography_country_performance',
        'geography_country_margin_comparison',
        'geography_state_performance',
        'geography_city_leaderboard'
      ]
      field: r(thelook_order_items.created_at)
    },
    FilterInteraction {
      from: 'f_product_department'
      to: [
        'overview_net_sales_kpi',
        'overview_fulfilled_orders_kpi',
        'overview_gross_profit_kpi',
        'overview_average_order_value_kpi',
        'overview_monthly_net_sales_trend',
        'overview_net_sales_by_traffic_source',
        'products_net_sales_kpi',
        'products_gross_margin_kpi',
        'products_items_sold_kpi',
        'products_return_rate_kpi',
        'products_top_net_sales',
        'products_category_sales_margin',
        'customer_fulfilled_orders_kpi',
        'customer_aov_kpi',
        'customer_net_sales_kpi',
        'customer_purchase_trend',
        'customer_acquisition_source_quality',
        'customer_gender_performance',
        'customer_segment_table',
        'geography_net_sales_kpi',
        'geography_gross_profit_kpi',
        'geography_gross_margin_kpi',
        'geography_country_performance',
        'geography_country_margin_comparison',
        'geography_state_performance',
        'geography_city_leaderboard'
      ]
      field: r(thelook_products.department)
    },
    FilterInteraction {
      from: 'f_product_category'
      to: [
        'overview_net_sales_kpi',
        'overview_fulfilled_orders_kpi',
        'overview_gross_profit_kpi',
        'overview_average_order_value_kpi',
        'overview_monthly_net_sales_trend',
        'overview_net_sales_by_traffic_source',
        'products_net_sales_kpi',
        'products_gross_margin_kpi',
        'products_items_sold_kpi',
        'products_return_rate_kpi',
        'products_top_net_sales',
        'products_category_sales_margin',
        'customer_fulfilled_orders_kpi',
        'customer_aov_kpi',
        'customer_net_sales_kpi',
        'customer_purchase_trend',
        'customer_acquisition_source_quality',
        'customer_gender_performance',
        'customer_segment_table',
        'geography_net_sales_kpi',
        'geography_gross_profit_kpi',
        'geography_gross_margin_kpi',
        'geography_country_performance',
        'geography_country_margin_comparison',
        'geography_state_performance',
        'geography_city_leaderboard'
      ]
      field: r(thelook_products.category)
    },
    FilterInteraction {
      from: 'f_customer_country'
      to: [
        'overview_net_sales_kpi',
        'overview_fulfilled_orders_kpi',
        'overview_gross_profit_kpi',
        'overview_average_order_value_kpi',
        'overview_monthly_net_sales_trend',
        'overview_net_sales_by_traffic_source',
        'products_net_sales_kpi',
        'products_gross_margin_kpi',
        'products_items_sold_kpi',
        'products_return_rate_kpi',
        'products_top_net_sales',
        'products_category_sales_margin',
        'customer_fulfilled_orders_kpi',
        'customer_aov_kpi',
        'customer_net_sales_kpi',
        'customer_purchase_trend',
        'customer_acquisition_source_quality',
        'customer_gender_performance',
        'customer_age_profile',
        'customer_segment_table',
        'geography_net_sales_kpi',
        'geography_gross_profit_kpi',
        'geography_gross_margin_kpi',
        'geography_country_performance',
        'geography_country_margin_comparison',
        'geography_state_performance',
        'geography_city_leaderboard'
      ]
      field: r(thelook_users.country)
    },
    FilterInteraction {
      from: 'f_customer_state'
      to: [
        'overview_net_sales_kpi',
        'overview_fulfilled_orders_kpi',
        'overview_gross_profit_kpi',
        'overview_average_order_value_kpi',
