Dashboard r02_haidfd_canvas_a2 {
  title: 'TheLook Commerce Atlas'
  description: @md
    A four-tab operating canvas for reading commercial performance, assortment, customers, and market reach.
  ;;
  theme: H.themes.classic

  settings {
    autorun_on_open: true
    autorun_on_changes: true
    cache_duration: 60
  }

  block f_order_item_date: FilterBlock {
    label: 'Order item date'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block f_product_category: FilterBlock {
    label: 'Product category'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.category)
    }
  }

  block f_customer_country: FilterBlock {
    label: 'Customer country'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.country)
    }
  }

  block t_overview_hero: TextBlock {
    content: @md
      # TheLook Commerce Atlas

      ## A practical reading room for retail decisions

      Set the shared filters once, then move from commercial pulse to products, customers, and market reach.
    ;;
  }

  block t_overview_section: TextBlock {
    content: @md
      ## Overview

      Start with the trading pulse. This canvas is reserved for headline performance, trend, and operational exceptions.
    ;;
  }

  block t_products_section: TextBlock {
    content: @md
      ## Products

      Use this tab to compare the assortment: category, brand, department, price, and inventory signals.
    ;;
  }

  block t_customers_section: TextBlock {
    content: @md
      ## Customers

      Use this tab to understand registered customers by demographic profile, acquisition source, and location.
    ;;
  }

  block t_geography_section: TextBlock {
    content: @md
      ## Geography

      Use this tab to compare commercial reach across customer countries, states, and cities.
    ;;
  }

  block overview_net_sales_kpi: VizBlock {
    label: 'Net Sales'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull { ref: r(thelook.net_sales) label: 'Net Sales' format { type: 'number' pattern: 'inherited' } }
      settings { display_mode: 'single' alignment: 'center' }
    }
  }
  block overview_gross_profit_kpi: VizBlock {
    label: 'Gross Profit'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull { ref: r(thelook.gross_profit) label: 'Gross Profit' format { type: 'number' pattern: 'inherited' } }
      settings { display_mode: 'single' alignment: 'center' }
    }
  }
  block overview_total_orders_kpi: VizBlock {
    label: 'Total Orders'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull { ref: r(thelook.total_orders) label: 'Total Orders' format { type: 'number' pattern: 'inherited' } }
      settings { display_mode: 'single' }
    }
  }
  block overview_aov_kpi: VizBlock {
    label: 'Average Order Value'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull { ref: r(thelook.aov) label: 'Average Order Value' format { type: 'number' pattern: 'inherited' } }
      settings { display_mode: 'single' }
    }
  }
  block overview_return_rate_visual: VizBlock {
    label: 'Return Rate'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull { ref: r(thelook.return_rate) label: 'Return Rate' format { type: 'number' pattern: 'inherited' } }
      settings { display_mode: 'single' }
    }
  }
  block overview_monthly_net_sales_trend: VizBlock {
    label: 'Monthly Net Sales Trend'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull { ref: r(thelook_order_items.created_at) label: 'Order Item Created Month' transformation: 'datetrunc month' format { type: 'date' pattern: 'LLL yyyy' } }
      y_axis { series { mark_type: 'line' field: VizFieldFull { ref: r(thelook.net_sales) label: 'Net Sales' format { type: 'number' pattern: 'inherited' } } } }
      settings { sort: LineFamilySort { type: 'xaxis' direction: 'asc' } }
    }
  }
  block overview_category_net_sales_comparison: VizBlock {
    label: 'Net Sales by Product Category'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull { ref: r(thelook_products.category) label: 'Product Category' }
      y_axis { series { mark_type: 'bar' field: VizFieldFull { ref: r(thelook.net_sales) label: 'Net Sales' format { type: 'number' pattern: 'inherited' } } } }
      settings { x_axis_label: 'Product Category' sort: LineFamilySort { type: 'yaxis' field_index: 0 direction: 'desc' } }
    }
  }

  block products_net_sales_kpi: VizBlock {
    label: 'Net Sales'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        format { type: 'number' pattern: 'inherited' }
      }
      settings { display_mode: 'single' }
    }
  }
  block products_gross_profit_kpi: VizBlock {
    label: 'Gross Profit'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_profit)
        label: 'Gross Profit'
        format { type: 'number' pattern: 'inherited' }
      }
      settings { display_mode: 'single' }
    }
  }
  block products_gross_margin_kpi: VizBlock {
    label: 'Gross Margin'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format { type: 'number' pattern: 'inherited' }
      }
      settings { display_mode: 'single' alignment: 'center' }
    }
  }
  block products_items_sold_kpi: VizBlock {
    label: 'Items Sold'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.items_sold)
        label: 'Items Sold'
        format { type: 'number' pattern: 'inherited' }
      }
      settings { display_mode: 'single' }
    }
  }
  block products_category_net_sales: VizBlock {
    label: 'Net Sales by Category'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull { ref: r(thelook_products.category) label: 'Product Category' format { type: 'text' } }
      y_axis { label: 'Net Sales' series { mark_type: 'bar' field: VizFieldFull { ref: r(thelook.net_sales) label: 'Net Sales' format { type: 'number' pattern: 'inherited' } } } }
      settings { legend_label: 'hidden' sort: LineFamilySort { type: 'yaxis' field_index: 0 direction: 'desc' } }
    }
  }
  block products_category_gross_margin: VizBlock {
    label: 'Gross Margin by Category'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull { ref: r(thelook_products.category) label: 'Product Category' format { type: 'text' } }
      y_axis { series { mark_type: 'bar' field: VizFieldFull { ref: r(thelook.gross_margin) label: 'Gross Margin' format { type: 'number' pattern: 'inherited' } } } }
      settings { sort: LineFamilySort { type: 'yaxis' field_index: 0 direction: 'desc' } }
    }
  }
  block products_top_products_by_net_sales: VizBlock {
    label: 'Top Products by Net Sales'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull { label: 'Product Name' ref: r(thelook_products.name) format { type: 'text' } },
        VizFieldFull { label: 'Net Sales' ref: r(thelook.net_sales) format { type: 'number' pattern: 'inherited' } uname: 'net_sales' }
      ]
      settings { pagination_size: 10 show_row_number: true sorts: [ KeyBasedSortSetting { key: 'net_sales' direction: 'desc' } ] row_limit: 10 single_cell_display: 'normal' }
    }
  }

  block customers_kpi: VizBlock {
    label: 'Registered Customers'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.customers)
        label: 'Registered Customers'
        format { type: 'number' pattern: 'inherited' }
      }
    }
  }
  block net_sales_kpi: VizBlock {
    label: 'Net Sales'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format { type: 'number' pattern: 'inherited' }
      }
      settings { alignment: 'center' }
    }
  }
  block total_orders_kpi: VizBlock {
    label: 'Orders'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.total_orders)
        label: 'Orders'
        format { type: 'number' pattern: 'inherited' }
      }
    }
  }
  block aov_kpi: VizBlock {
    label: 'Average Order Value'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'
        format { type: 'number' pattern: 'inherited' }
      }
    }
  }
  block customers_by_gender: VizBlock {
    label: 'Customers by Gender'
    viz: PieChart {
      dataset: thelook
      legend: VizFieldFull { ref: r(thelook_users.gender) label: 'Gender' }
      series {
        field: VizFieldFull {
          ref: r(thelook.customers)
          label: 'Customers'
          format { type: 'number' pattern: 'inherited' }
        }
      }
      settings { sort: 'asc' }
    }
  }
  block customers_by_age: VizBlock {
    label: 'Customers by Age'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull { ref: r(thelook_users.age) label: 'Age' format { type: 'number' pattern: '#,###' } }
      y_axis { series { mark_type: 'column' field: VizFieldFull { ref: r(thelook.customers) label: 'Customers' format { type: 'number' pattern: 'inherited' } } } }
      settings { x_axis_label: 'Age' sort: LineFamilySort { type: 'xaxis' direction: 'asc' } }
    }
  }
  block customers_by_traffic_source: VizBlock {
    label: 'Customers by Traffic Source'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull { ref: r(thelook_users.traffic_source) label: 'Traffic Source' }
      y_axis { series { mark_type: 'bar' field: VizFieldFull { ref: r(thelook.customers) label: 'Customers' format { type: 'number' pattern: 'inherited' } } } }
      settings { sort: LineFamilySort { type: 'yaxis' field_index: 0 direction: 'desc' } }
    }
  }
  block country_customer_detail: VizBlock {
    label: 'Country Customer Detail'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull { label: 'Country' ref: r(thelook_users.country) format { type: 'text' } uname: 'thelook_users_country_1' },
        VizFieldFull { label: 'Customers' ref: r(thelook.customers) format { type: 'number' pattern: 'inherited' } uname: 'custom_customers_1' },
        VizFieldFull { label: 'Net Sales' ref: r(thelook.net_sales) format { type: 'number' pattern: 'inherited' } },
        VizFieldFull { label: 'Orders' ref: r(thelook.total_orders) format { type: 'number' pattern: 'inherited' } },
        VizFieldFull { label: 'Average Order Value' ref: r(thelook.aov) format { type: 'number' pattern: 'inherited' } }
      ]
      settings { pagination_size: 100 show_row_number: true sorts: [ KeyBasedSortSetting { key: 'custom_customers_1' direction: 'desc' }, KeyBasedSortSetting { key: 'thelook_users_country_1' direction: 'asc' } ] single_cell_display: 'normal' }
    }
  }

  block geo_kpi_net_sales: VizBlock {
    label: 'Net Sales'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        format { type: 'number' pattern: 'inherited' }
      }
      settings { display_mode: 'single' }
    }
  }
  block geo_kpi_gross_profit: VizBlock {
    label: 'Gross Profit'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_profit)
        label: 'Gross Profit'
        format { type: 'number' pattern: 'inherited' }
      }
    }
  }
  block geo_kpi_total_orders: VizBlock {
    label: 'Total Orders'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.total_orders)
        label: 'Total Orders'
        format { type: 'number' pattern: '#,###0' }
      }
      settings { display_mode: 'single' alignment: 'center' }
    }
  }
  block geo_kpi_customers: VizBlock {
    label: 'Customers'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.customers)
        label: 'Customers'
        format { type: 'number' pattern: '#,###0' }
      }
    }
  }
  block geo_net_sales_by_country: VizBlock {
    label: 'Net Sales by Country'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull { ref: r(thelook_users.country) label: 'Customer Country' format { type: 'text' } }
      y_axis { label: 'Net Sales' series { mark_type: 'column' field: VizFieldFull { ref: r(thelook.net_sales) label: 'Net Sales' format { type: 'number' pattern: 'inherited' } } } }
      settings { sort: LineFamilySort { type: 'yaxis' field_index: 0 direction: 'desc' } }
    }
  }
  block geo_net_sales_by_state: VizBlock {
    label: 'Net Sales by State'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull { ref: r(thelook_users.state) label: 'Customer State' }
      y_axis { label: 'Net Sales' series { mark_type: 'bar' field: VizFieldFull { ref: r(thelook.net_sales) label: 'Net Sales' format { type: 'number' pattern: 'inherited' } } } }
      settings { sort: LineFamilySort { type: 'yaxis' field_index: 0 direction: 'desc' } }
    }
  }
  block geo_country_commercial_detail: VizBlock {
    label: 'Country Commercial Detail'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull { label: 'Customer Country' ref: r(thelook_users.country) format { type: 'text' } uname: 'customer_country' },
        VizFieldFull { label: 'Net Sales' ref: r(thelook.net_sales) format { type: 'number' pattern: 'inherited' } uname: 'net_sales' },
        VizFieldFull { label: 'Gross Profit' ref: r(thelook.gross_profit) format { type: 'number' pattern: 'inherited' } uname: 'gross_profit' },
        VizFieldFull { label: 'Gross Margin' ref: r(thelook.gross_margin) format { type: 'number' pattern: 'inherited' } uname: 'gross_margin' },
        VizFieldFull { label: 'Total Orders' ref: r(thelook.total_orders) format { type: 'number' pattern: 'inherited' } uname: 'total_orders' },
        VizFieldFull { label: 'Customers' ref: r(thelook.customers) format { type: 'number' pattern: 'inherited' } uname: 'customers' }
      ]
      settings { pagination_size: 100 show_row_number: true wrap_header_text: true wrap_cell_text: false sorts: [ KeyBasedSortSetting { key: 'net_sales' direction: 'desc' }, KeyBasedSortSetting { key: 'customer_country' direction: 'asc' } ] }
    }
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'f_order_item_date'
      to: [
        'overview_net_sales_kpi',
        'overview_gross_profit_kpi',
        'overview_total_orders_kpi',
        'overview_aov_kpi',
        'overview_return_rate_visual',
        'overview_monthly_net_sales_trend',
        'overview_category_net_sales_comparison',
        'products_net_sales_kpi',
        'products_gross_profit_kpi',
        'products_gross_margin_kpi',
        'products_items_sold_kpi',
        'products_category_net_sales',
        'products_category_gross_margin',
        'products_top_products_by_net_sales',
        'customers_kpi',
        'net_sales_kpi',
        'total_orders_kpi',
        'aov_kpi',
        'customers_by_gender',
        'customers_by_age',
        'customers_by_traffic_source',
        'country_customer_detail',
        'geo_kpi_net_sales',
        'geo_kpi_gross_profit',
        'geo_kpi_total_orders',
        'geo_kpi_customers',
        'geo_net_sales_by_country',
        'geo_net_sales_by_state',
        'geo_country_commercial_detail'
      ]
      field: r(thelook_order_items.created_at)
    },
    FilterInteraction {
      from: 'f_product_category'
      to: [
        'overview_net_sales_kpi',
        'overview_gross_profit_kpi',
        'overview_total_orders_kpi',
        'overview_aov_kpi',
        'overview_return_rate_visual',
        'overview_monthly_net_sales_trend',
        'overview_category_net_sales_comparison',
        'products_net_sales_kpi',
        'products_gross_profit_kpi',
        'products_gross_margin_kpi',
        'products_items_sold_kpi',
        'products_category_net_sales',
        'products_category_gross_margin',
        'products_top_products_by_net_sales',
        'customers_kpi',
        'net_sales_kpi',
        'total_orders_kpi',
        'aov_kpi',
        'customers_by_gender',
        'customers_by_age',
        'customers_by_traffic_source',
        'country_customer_detail',
        'geo_kpi_net_sales',
        'geo_kpi_gross_profit',
        'geo_kpi_total_orders',
        'geo_kpi_customers',
        'geo_net_sales_by_country',
        'geo_net_sales_by_state',
        'geo_country_commercial_detail'
      ]
      field: r(thelook_products.category)
    },
    FilterInteraction {
      from: 'f_customer_country'
      to: [
        'overview_net_sales_kpi',
        'overview_gross_profit_kpi',
        'overview_total_orders_kpi',
        'overview_aov_kpi',
        'overview_return_rate_visual',
        'overview_monthly_net_sales_trend',
        'overview_category_net_sales_comparison',
        'products_net_sales_kpi',
        'products_gross_profit_kpi',
        'products_gross_margin_kpi',
        'products_items_sold_kpi',
        'products_category_net_sales',
        'products_category_gross_margin',
        'products_top_products_by_net_sales',
        'customers_kpi',
        'net_sales_kpi',
        'total_orders_kpi',
        'aov_kpi',
        'customers_by_gender',
        'customers_by_age',
        'customers_by_traffic_source',
        'country_customer_detail',
        'geo_kpi_net_sales',
        'geo_kpi_gross_profit',
        'geo_kpi_total_orders',
        'geo_kpi_customers',
        'geo_net_sales_by_country',
        'geo_net_sales_by_state',
        'geo_country_commercial_detail'
      ]
      field: r(thelook_users.country)
    },
    FilterInteraction {
      from: 'f_order_item_date'
      to: ['f_product_category', 'f_customer_country']
      disabled: true
    },
    FilterInteraction {
      from: 'f_product_category'
      to: ['f_order_item_date', 'f_customer_country']
      disabled: true
    },
    FilterInteraction {
      from: 'f_customer_country'
      to: ['f_order_item_date', 'f_product_category']
      disabled: true
    }
  ]

  view: TabLayout {
    tab overview: CanvasLayout {
      label: 'Overview'
      width: 1220
      height: 1280
      grid_size: 20
      block t_overview_hero { position: pos(20, 20, 1180, 160) layer: 1 }
      block f_order_item_date { position: pos(20, 200, 380, 100) layer: 1 }
      block f_product_category { position: pos(420, 200, 380, 100) layer: 1 }
      block f_customer_country { position: pos(820, 200, 380, 100) layer: 1 }
      block t_overview_section { position: pos(20, 320, 1180, 120) layer: 1 }
      block overview_net_sales_kpi { position: pos(20, 460, 220, 120) layer: 1 }
      block overview_gross_profit_kpi { position: pos(260, 460, 220, 120) layer: 1 }
      block overview_total_orders_kpi { position: pos(500, 460, 220, 120) layer: 1 }
      block overview_aov_kpi { position: pos(740, 460, 220, 120) layer: 1 }
      block overview_return_rate_visual { position: pos(980, 460, 220, 120) layer: 1 }
      block overview_monthly_net_sales_trend { position: pos(20, 600, 1180, 320) layer: 1 }
      block overview_category_net_sales_comparison { position: pos(20, 940, 1180, 320) layer: 1 }
      mobile { mode: 'auto' }
    }

    tab products: CanvasLayout {
      label: 'Products'
      width: 1220
      height: 1280
      grid_size: 20
      block f_order_item_date { position: pos(20, 20, 380, 100) layer: 1 }
      block f_product_category { position: pos(420, 20, 380, 100) layer: 1 }
      block f_customer_country { position: pos(820, 20, 380, 100) layer: 1 }
      block t_products_section { position: pos(20, 140, 1180, 120) layer: 1 }
      block products_net_sales_kpi { position: pos(20, 280, 280, 120) layer: 1 }
      block products_gross_profit_kpi { position: pos(320, 280, 280, 120) layer: 1 }
      block products_gross_margin_kpi { position: pos(620, 280, 280, 120) layer: 1 }
      block products_items_sold_kpi { position: pos(920, 280, 280, 120) layer: 1 }
      block products_category_net_sales { position: pos(20, 420, 580, 340) layer: 1 }
      block products_category_gross_margin { position: pos(620, 420, 580, 340) layer: 1 }
      block products_top_products_by_net_sales { position: pos(20, 780, 1180, 480) layer: 1 }
      mobile { mode: 'auto' }
    }

    tab customers: CanvasLayout {
      label: 'Customers'
      width: 1220
      height: 1520
      grid_size: 20
      block f_order_item_date { position: pos(20, 20, 380, 100) layer: 1 }
      block f_product_category { position: pos(420, 20, 380, 100) layer: 1 }
      block f_customer_country { position: pos(820, 20, 380, 100) layer: 1 }
      block t_customers_section { position: pos(20, 140, 1180, 120) layer: 1 }
      block customers_kpi { position: pos(20, 280, 280, 120) layer: 1 }
      block net_sales_kpi { position: pos(320, 280, 280, 120) layer: 1 }
      block total_orders_kpi { position: pos(620, 280, 280, 120) layer: 1 }
      block aov_kpi { position: pos(920, 280, 280, 120) layer: 1 }
      block customers_by_gender { position: pos(20, 420, 380, 340) layer: 1 }
      block customers_by_age { position: pos(420, 420, 780, 340) layer: 1 }
      block customers_by_traffic_source { position: pos(20, 780, 1180, 320) layer: 1 }
      block country_customer_detail { position: pos(20, 1120, 1180, 380) layer: 1 }
      mobile { mode: 'auto' }
    }

    tab geography: CanvasLayout {
      label: 'Geography'
      width: 1220
      height: 1500
      grid_size: 20
      block f_order_item_date { position: pos(20, 20, 380, 100) layer: 1 }
      block f_product_category { position: pos(420, 20, 380, 100) layer: 1 }
      block f_customer_country { position: pos(820, 20, 380, 100) layer: 1 }
      block t_geography_section { position: pos(20, 140, 1180, 120) layer: 1 }
      block geo_kpi_net_sales { position: pos(20, 280, 280, 120) layer: 1 }
      block geo_kpi_gross_profit { position: pos(320, 280, 280, 120) layer: 1 }
      block geo_kpi_total_orders { position: pos(620, 280, 280, 120) layer: 1 }
      block geo_kpi_customers { position: pos(920, 280, 280, 120) layer: 1 }
      block geo_net_sales_by_country { position: pos(20, 420, 1180, 320) layer: 1 }
