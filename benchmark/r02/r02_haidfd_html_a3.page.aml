Dashboard r02_haidfd_html_a3 {
  title: 'Retail Operations Sales Desk'
  description: @md
A sales-operations dashboard for monitoring commercial performance, product mix, customer demand, and geographic coverage.
  ;;

  settings {
    autorun_on_open: true
    autorun_on_changes: true
    cache_duration: 60
  }

  block sales_date_filter: FilterBlock {
    label: 'Sales date'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block customer_country_filter: FilterBlock {
    label: 'Customer country'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.country)
    }
  }

  block product_department_filter: FilterBlock {
    label: 'Product department'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.department)
    }
  }

  block kpi_net_sales: VizBlock {
    label: 'Net sales'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.net_sales)
    label: 'Net Sales'
    format {
      type: 'number'
      pattern: '[$$]#,###0'
    }
  }
  settings {
    display_mode: 'single'
    alignment: 'center'
  }
}
  }

  block kpi_gross_profit: VizBlock {
    label: 'Gross profit'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.gross_profit)
    label: 'Gross Profit'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
  settings {
    display_mode: 'single'
  }
}
  }

  block kpi_gross_margin: VizBlock {
    label: 'Gross margin'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.gross_margin)
    label: 'Gross Margin'
    format {
      type: 'number'
      pattern: '#,###0.0%'
    }
  }
  settings {
    display_mode: 'single'
  }
}
  }

  block kpi_fulfilled_orders: VizBlock {
    label: 'Fulfilled orders'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.fulfilled_orders)
    label: 'Fulfilled Orders'
    format {
      type: 'number'
      pattern: '#,###0'
    }
  }
  settings {
    display_mode: 'single'
  }
}
  }

  block kpi_aov: VizBlock {
    label: 'Average order value'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.aov)
    label: 'Average Order Value'
    format {
      type: 'number'
      pattern: '[$$]#,###0.00'
    }
  }
  settings {
    display_mode: 'single'
    alignment: 'center'
  }
}
  }

  block kpi_items_sold: VizBlock {
    label: 'Items sold'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.items_sold)
    label: 'Items Sold'
    format {
      type: 'number'
      pattern: '#,###0'
    }
  }
}
  }

  block kpi_return_rate: VizBlock {
    label: 'Return rate'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.return_rate)
    label: 'Return Rate'
    format {
      type: 'number'
      pattern: '#,###0.0%'
    }
  }
  settings {
    display_mode: 'single'
  }
}
  }

  block overview_monthly_sales_profit_trend: VizBlock {
    label: 'Monthly sales and profit trend'
    viz: CombinationChart {
  dataset: thelook
  x_axis: VizFieldFull {
    ref: r(thelook_order_items.created_at)
    label: 'Sales Month'
    transformation: 'datetrunc month'
    format {
      type: 'date'
      pattern: 'LLL yyyy'
    }
  }
  y_axis {
    label: 'Sales'
    series {
      mark_type: 'line'
      field: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
    series {
      mark_type: 'line'
      field: VizFieldFull {
        ref: r(thelook.gross_profit)
        label: 'Gross Profit'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }
  settings {
    legend_label: 'bottom'
    show_data_points: false
    sort: LineFamilySort {
      type: 'xaxis'
      direction: 'asc'
    }
  }
}
  }

  block overview_sales_by_department: VizBlock {
    label: 'Net sales by department'
    viz: CombinationChart {
  dataset: thelook
  calculation department_rank_by_net_sales {
    label: 'Department Rank By Net Sales'
    formula: @aql rank(order: net_sales | desc(), partition: []);;
    calc_type: 'measure'
    data_type: 'number'
    hidden: true
  }
  x_axis: VizFieldFull {
    ref: r(thelook_products.department)
    label: 'Department'
  }
  y_axis {
    series {
      mark_type: 'bar'
      field: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }
  settings {
    sort: LineFamilySort {
      type: 'yaxis'
      field_index: 0
      direction: 'desc'
    }
  }
}
  }

  block products_category_performance: VizBlock {
    label: 'Category performance'
    viz: DataTable {
  dataset: thelook
  fields: [
    VizFieldFull {
      label: 'Product Category'
      ref: r(thelook_products.category)
      format {
        type: 'text'
      }
      uname: 'thelook_products_category_1'
    },
    VizFieldFull {
      label: 'Net Sales'
      ref: r(thelook.net_sales)
      format {
        type: 'number'
        pattern: '[$$]#,###0'
      }
      uname: 'custom_net_sales_1'
    },
    VizFieldFull {
      label: 'Gross Profit'
      ref: r(thelook.gross_profit)
      format {
        type: 'number'
        pattern: '[$$]#,###0'
      }
      uname: 'custom_gross_profit_1'
    },
    VizFieldFull {
      label: 'Gross Margin'
      ref: r(thelook.gross_margin)
      format {
        type: 'number'
        pattern: '#,###0.0%'
      }
      uname: 'custom_gross_margin_1'
    },
  ]
  settings {
    pagination_size: 100
    show_row_number: true
    wrap_header_text: true
    sorts: [
      KeyBasedSortSetting {
        key: 'custom_net_sales_1'
        direction: 'desc'
      },
      KeyBasedSortSetting {
        key: 'thelook_products_category_1'
        direction: 'asc'
      },
    ]
    single_cell_display: 'normal'
  }
}
  }

  block products_top_products: VizBlock {
    label: 'Top products by net sales'
    viz: CombinationChart {
  dataset: thelook

  // Retained from the AQL explore as a helper calculation; not displayed in the chart.
  calculation product_rank_by_net_sales {
    label: 'Product Rank By Net Sales'
    formula: @aql rank(order: net_sales | desc(), partition: []);;
    calc_type: 'measure'
    data_type: 'number'
    hidden: true
  }

  x_axis: VizFieldFull {
    ref: r(thelook_products.name)
    label: 'Product Name'
  }

  y_axis {
    series {
      mark_type: 'bar'
      field: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  settings {
    row_limit: 10
    legend_label: 'hidden'
    sort: LineFamilySort {
      type: 'yaxis'
      field_index: 0
      direction: 'desc'
    }
  }
}
  }

  block products_brand_detail: VizBlock {
    label: 'Brand performance detail'
    viz: DataTable {
  dataset: thelook
  calculation brand_rank_by_net_sales {
    label: 'Brand Rank by Net Sales'
    formula: @aql rank(order: net_sales | desc(), partition: []);;
    calc_type: 'measure'
    data_type: 'number'
    hidden: true
  }
  fields: [
    VizFieldFull {
      ref: r(thelook_products.brand)
      label: 'Brand'
      format {
        type: 'text'
      }
      uname: 'brand'
    },
    VizFieldFull {
      ref: r(thelook.net_sales)
      label: 'Net Sales'
      format {
        type: 'number'
        pattern: 'inherited'
      }
      uname: 'net_sales'
    },
    VizFieldFull {
      ref: r(thelook.gross_profit)
      label: 'Gross Profit'
      format {
        type: 'number'
        pattern: 'inherited'
      }
      uname: 'gross_profit'
    },
    VizFieldFull {
      ref: r(thelook.items_sold)
      label: 'Items Sold'
      format {
        type: 'number'
        pattern: '#,###0'
      }
      uname: 'items_sold'
    },
  ]
  settings {
    pagination_size: 100
    show_row_number: true
    sorts: [
      KeyBasedSortSetting {
        key: 'net_sales'
        direction: 'desc'
      },
      KeyBasedSortSetting {
        key: 'brand'
        direction: 'asc'
      },
    ]
    wrap_header_text: true
    wrap_cell_text: false
  }
}
  }

  block customers_sales_by_acquisition_source: VizBlock {
    label: 'Sales by acquisition source'
    viz: CombinationChart {
  dataset: thelook
  x_axis: VizFieldFull {
    ref: r(thelook_users.traffic_source)
    label: 'Acquisition Traffic Source'
  }
  y_axis {
    series {
      mark_type: 'bar'
      field: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }
  settings {
    sort: LineFamilySort {
      type: 'yaxis'
      field_index: 0
      direction: 'desc'
    }
  }
}
  }

  block customers_sales_by_gender: VizBlock {
    label: 'Sales and fulfilled orders by gender'
    viz: CombinationChart {
  dataset: thelook
  x_axis: VizFieldFull {
    ref: r(thelook_users.gender)
    label: 'User Gender'
  }
  y_axis {
    label: 'Net Sales'
    series {
      mark_type: 'column'
      field: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
    settings {
      alignment: 'left'
    }
  }
  y_axis {
    label: 'Fulfilled Orders'
    series {
      mark_type: 'line'
      field: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        label: 'Fulfilled Orders'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
    settings {
      alignment: 'right'
    }
  }
  settings {
    legend_label: 'top'
    show_data_points: true
    sort: LineFamilySort {
      type: 'xaxis'
      direction: 'asc'
    }
  }
}
  }

  block customers_sales_detail: VizBlock {
    label: 'Customer sales detail'
    viz: DataTable {
  dataset: thelook

  calculation customer_net_sales_rank {
    label: 'Customer Net Sales Rank'
    formula: @aql rank(order: net_sales | desc(), partition: []);;
    calc_type: 'measure'
    data_type: 'number'
    hidden: true
  }

  fields: [
    VizFieldFull {
      ref: r(thelook_users.first_name)
      label: 'First Name'
      format {
        type: 'text'
      }
    },
    VizFieldFull {
      ref: r(thelook_users.last_name)
      label: 'Last Name'
      format {
        type: 'text'
      }
    },
    VizFieldFull {
      ref: r(thelook_users.email)
      label: 'Email'
      format {
        type: 'text'
      }
      uname: 'customer_email'
    },
    VizFieldFull {
      ref: r(thelook_users.traffic_source)
      label: 'Traffic Source'
      format {
        type: 'text'
      }
    },
    VizFieldFull {
      ref: r(thelook.net_sales)
      label: 'Net Sales'
      format {
        type: 'number'
        pattern: 'inherited'
      }
    },
    VizFieldFull {
      ref: 'customer_net_sales_rank'
      hidden: true
      uname: 'customer_net_sales_rank'
    },
  ]

  settings {
    pagination_size: 100
    show_row_number: true
    sorts: [
      KeyBasedSortSetting {
        key: 'customer_net_sales_rank'
        direction: 'asc'
      },
      KeyBasedSortSetting {
        key: 'customer_email'
        direction: 'asc'
      },
    ]
    wrap_header_text: true
  }
}
  }

  block geography_sales_by_country: VizBlock {
    label: 'Net sales by country'
    viz: CombinationChart {
  dataset: thelook
  calculation net_sales_rank {
    label: 'Net Sales Rank'
    formula: @aql rank(order: net_sales | desc(), partition: []);;
    calc_type: 'measure'
    data_type: 'number'
    hidden: true
  }
  x_axis: VizFieldFull {
    ref: r(thelook_users.country)
    label: 'Country'
  }
  y_axis {
    series {
      mark_type: 'bar'
      field: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }
  settings {
    x_axis_label: 'Country'
    legend_label: 'hidden'
    sort: LineFamilySort {
      type: 'yaxis'
      field_index: 0
      direction: 'desc'
    }
  }
}
  }

  block geography_sales_by_state: VizBlock {
    label: 'Net sales by state'
    viz: CombinationChart {
  dataset: thelook
  x_axis: VizFieldFull {
    ref: r(thelook_users.state)
    label: 'State'
  }
  y_axis {
    label: 'Net Sales'
    series {
      mark_type: 'bar'
      field: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }
  settings {
    sort: LineFamilySort {
      type: 'yaxis'
      field_index: 0
      direction: 'desc'
    }
  }
}
  }

  block geography_city_sales_detail: VizBlock {
    label: 'City sales detail'
    viz: DataTable {
  dataset: thelook
  calculation net_sales_rank {
    label: 'Net Sales Rank'
    formula: @aql rank(order: net_sales | desc(), partition: []);;
    calc_type: 'measure'
    data_type: 'number'
  }
  fields: [
    VizFieldFull {
      ref: r(thelook_users.city)
      label: 'City'
      uname: 'city'
    },
    VizFieldFull {
      ref: r(thelook_users.state)
      label: 'State'
      uname: 'state'
    },
    VizFieldFull {
      ref: r(thelook_users.country)
      label: 'Country'
      uname: 'country'
    },
    VizFieldFull {
      ref: r(thelook.net_sales)
      label: 'Net Sales'
      uname: 'net_sales'
      format {
        type: 'number'
        pattern: '[$$]#,###0'
      }
    },
    VizFieldFull {
      ref: r(thelook.fulfilled_orders)
      label: 'Fulfilled Orders'
      uname: 'fulfilled_orders'
      format {
        type: 'number'
        pattern: '#,###0'
      }
    },
    VizFieldFull {
      ref: 'net_sales_rank'
      label: 'Net Sales Rank'
      uname: 'net_sales_rank'
      hidden: true
    },
  ]
  settings {
    pagination_size: 100
    show_row_number: true
    wrap_header_text: true
    sorts: [
      KeyBasedSortSetting {
        key: 'net_sales_rank'
        direction: 'asc'
      },
      KeyBasedSortSetting {
        key: 'country'
        direction: 'asc'
      },
      KeyBasedSortSetting {
        key: 'state'
        direction: 'asc'
      },
      KeyBasedSortSetting {
        key: 'city'
        direction: 'asc'
      },
    ]
  }
}
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'sales_date_filter'
      to: ['kpi_net_sales', 'kpi_gross_profit', 'kpi_gross_margin', 'kpi_fulfilled_orders', 'kpi_aov', 'kpi_items_sold', 'kpi_return_rate', 'overview_monthly_sales_profit_trend', 'overview_sales_by_department', 'products_category_performance', 'products_top_products', 'products_brand_detail', 'customers_sales_by_acquisition_source', 'customers_sales_by_gender', 'customers_sales_detail', 'geography_sales_by_country', 'geography_sales_by_state', 'geography_city_sales_detail']
      field: r(thelook_order_items.created_at)
    },
    FilterInteraction {
      from: 'customer_country_filter'
      to: ['kpi_net_sales', 'kpi_gross_profit', 'kpi_gross_margin', 'kpi_fulfilled_orders', 'kpi_aov', 'kpi_items_sold', 'kpi_return_rate', 'overview_monthly_sales_profit_trend', 'overview_sales_by_department', 'products_category_performance', 'products_top_products', 'products_brand_detail', 'customers_sales_by_acquisition_source', 'customers_sales_by_gender', 'customers_sales_detail', 'geography_sales_by_country', 'geography_sales_by_state', 'geography_city_sales_detail']
      field: r(thelook_users.country)
    },
    FilterInteraction {
      from: 'product_department_filter'
      to: ['kpi_net_sales', 'kpi_gross_profit', 'kpi_gross_margin', 'kpi_fulfilled_orders', 'kpi_aov', 'kpi_items_sold', 'kpi_return_rate', 'overview_monthly_sales_profit_trend', 'overview_sales_by_department', 'products_category_performance', 'products_top_products', 'products_brand_detail', 'customers_sales_by_acquisition_source', 'customers_sales_by_gender', 'customers_sales_detail', 'geography_sales_by_country', 'geography_sales_by_state', 'geography_city_sales_detail']
      field: r(thelook_products.department)
    }
  ]

  view: HTMLLayout {
    content: @html
<style>
  :root {
    --ink-navy: #11253d;
    --mineral-blue: #255d85;
    --cloud-gray: #eaf0f4;
    --mist: #f7fafc;
    --bright-coral: #f0645a;
    --line: #cbd9e3;
    --white: #ffffff;
    --radius: 14px;
  }
  .retail-desk { color: var(--ink-navy); font-family: "Avenir Next", Avenir, "Segoe UI", sans-serif; max-width: 1440px; margin: 0 auto; padding: 20px; }
  .desk-header { background: var(--ink-navy); border-radius: 18px; color: var(--white); padding: clamp(20px, 4vw, 42px); box-shadow: 0 14px 30px rgba(17, 37, 61, .16); }
  .brand-line { display: flex; justify-content: space-between; gap: 20px; align-items: end; }
  .brand-line h1 { font-size: clamp(1.75rem, 4vw, 3rem); line-height: 1.05; letter-spacing: -.035em; margin: 0; }
  .brand-line p { color: #cfe2ee; font-size: 1rem; margin: 10px 0 0; max-width: 44rem; }
  .status-dot { color: var(--bright-coral); font-size: 1.25rem; white-space: nowrap; }
  .filter-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin-top: 28px; }
  .filter-cell { background: rgba(255,255,255,.08); border: 1px solid rgba(207,226,238,.28); border-radius: 10px; padding: 8px; min-width: 0; }
  .tab-shell { margin-top: 24px; }
  .tab-radio { position: absolute; opacity: 0; pointer-events: none; }
  .tab-nav { display: flex; flex-wrap: wrap; gap: 8px; border-bottom: 1px solid var(--line); margin-bottom: 22px; padding-bottom: 12px; }
  .tab-nav label { border: 1px solid transparent; border-radius: 999px; color: var(--mineral-blue); cursor: pointer; font-weight: 700; padding: 10px 16px; }
  .tab-nav label:hover { background: var(--cloud-gray); }
  #tab-overview:checked ~ .tab-nav label[for="tab-overview"], #tab-products:checked ~ .tab-nav label[for="tab-products"], #tab-customers:checked ~ .tab-nav label[for="tab-customers"], #tab-geography:checked ~ .tab-nav label[for="tab-geography"] { background: var(--mineral-blue); color: var(--white); }
  #tab-overview:focus-visible ~ .tab-nav label[for="tab-overview"], #tab-products:focus-visible ~ .tab-nav label[for="tab-products"], #tab-customers:focus-visible ~ .tab-nav label[for="tab-customers"], #tab-geography:focus-visible ~ .tab-nav label[for="tab-geography"] { outline: 3px solid var(--bright-coral); outline-offset: 3px; }
  .panel { display: none; }
  #tab-overview:checked ~ .tab-panels .panel-overview, #tab-products:checked ~ .tab-panels .panel-products, #tab-customers:checked ~ .tab-panels .panel-customers, #tab-geography:checked ~ .tab-panels .panel-geography { display: block; }
  .section-heading { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 18px; align-items: end; margin: 4px 0 18px; }
  .section-heading h2 { font-size: clamp(1.4rem, 2.5vw, 2rem); letter-spacing: -.025em; margin: 0; }
  .section-heading p { color: #587086; margin: 5px 0 0; max-width: 48rem; }
  .section-code { color: var(--bright-coral); font-weight: 800; }
  .kpi-grid, .two-up { display: grid; gap: 16px; }
  .kpi-grid { grid-template-columns: repeat(7, minmax(150px, 1fr)); overflow-x: auto; padding-bottom: 4px; }
  .two-up { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .card { background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); min-width: 0; overflow: hidden; }
  .kpi-grid .card { min-width: 175px; }
  .card h-block { display: block; min-height: 100%; }
  .wide-card { margin-top: 16px; }
  .data-note { border-left: 4px solid var(--bright-coral); color: #587086; font-size: .92rem; margin: 18px 0; padding: 10px 14px; background: var(--mist); }
  @media (max-width: 840px) { .brand-line { align-items: start; flex-direction: column; } .filter-row, .two-up { grid-template-columns: 1fr; } .retail-desk { padding: 12px; } }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior: auto !important; transition: none !important; animation: none !important; } }
</style>

<main class="retail-desk" aria-label="Retail operations sales dashboard">
  <header class="desk-header">
    <div class="brand-line">
      <div>
        <h1>Retail operations sales desk</h1>
        <p>Monitor commercial health, then move from sales performance to the products, customers, and places behind it.</p>
      </div>
      <div class="status-dot" aria-label="Live filters">● Live filters</div>
    </div>
    <div class="filter-row" aria-label="Shared dashboard filters">
      <div class="filter-cell"><h-block name="sales_date_filter" /></div>
      <div class="filter-cell"><h-block name="customer_country_filter" /></div>
      <div class="filter-cell"><h-block name="product_department_filter" /></div>
    </div>
  </header>

  <section class="tab-shell" aria-label="Sales views">
    <input class="tab-radio" type="radio" id="tab-overview" name="sales-view" checked />
    <input class="tab-radio" type="radio" id="tab-products" name="sales-view" />
    <input class="tab-radio" type="radio" id="tab-customers" name="sales-view" />
    <input class="tab-radio" type="radio" id="tab-geography" name="sales-view" />
    <nav class="tab-nav" aria-label="Dashboard sections">
      <label for="tab-overview">Overview</label>
      <label for="tab-products">Products</label>
      <label for="tab-customers">Customers</label>
      <label for="tab-geography">Geography</label>
    </nav>

    <div class="tab-panels">
      <section class="panel panel-overview" aria-label="Overview">
        <div class="section-heading"><div><h2>Commercial pulse</h2><p>The core measures of profitable, fulfilled sales in the current filter context.</p></div><span class="section-code">01 / Overview</span></div>
        <div class="kpi-grid">
          <div class="card"><h-block name="kpi_net_sales" /></div>
          <div class="card"><h-block name="kpi_gross_profit" /></div>
          <div class="card"><h-block name="kpi_gross_margin" /></div>
          <div class="card"><h-block name="kpi_fulfilled_orders" /></div>
          <div class="card"><h-block name="kpi_aov" /></div>
          <div class="card"><h-block name="kpi_items_sold" /></div>
          <div class="card"><h-block name="kpi_return_rate" /></div>
        </div>
        <p class="data-note">Net sales exclude cancelled and returned items. Use the shared filters above to set the operating slice for every view.</p>
        <div class="two-up">
          <div class="card"><h-block name="overview_monthly_sales_profit_trend" /></div>
          <div class="card"><h-block name="overview_sales_by_department" /></div>
        </div>
      </section>

      <section class="panel panel-products" aria-label="Products">
        <div class="section-heading"><div><h2>Product portfolio</h2><p>Find the categories, products, and brands concentrating revenue and margin.</p></div><span class="section-code">02 / Products</span></div>
        <div class="two-up">
          <div class="card"><h-block name="products_category_performance" /></div>
          <div class="card"><h-block name="products_top_products" /></div>
        </div>
        <div class="card wide-card"><h-block name="products_brand_detail" /></div>
      </section>

      <section class="panel panel-customers" aria-label="Customers">
        <div class="section-heading"><div><h2>Customer demand</h2><p>Compare how acquisition and customer characteristics translate into completed sales.</p></div><span class="section-code">03 / Customers</span></div>
        <div class="two-up">
          <div class="card"><h-block name="customers_sales_by_acquisition_source" /></div>
          <div class="card"><h-block name="customers_sales_by_gender" /></div>
        </div>
        <div class="card wide-card"><h-block name="customers_sales_detail" /></div>
      </section>

      <section class="panel panel-geography" aria-label="Geography">
        <div class="section-heading"><div><h2>Market footprint</h2><p>Track where customers are generating sales, from national coverage down to cities.</p></div><span class="section-code">04 / Geography</span></div>
        <div class="two-up">
          <div class="card"><h-block name="geography_sales_by_country" /></div>
          <div class="card"><h-block name="geography_sales_by_state" /></div>
        </div>
        <div class="card wide-card"><h-block name="geography_city_sales_detail" /></div>
      </section>
    </div>
  </section>
</main>
    ;;
  }
}
