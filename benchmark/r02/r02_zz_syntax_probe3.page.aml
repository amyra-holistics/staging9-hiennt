Dashboard r02_zz_syntax_probe3 {
  title: 'probe3'
  block age: VizBlock {
    label: 'age'
    viz: ColumnChart {
      dataset: thelook
      calculation age_band {
        label: 'Age Band'
        formula: @aql case(when: thelook_users.age < 25, then: '12-24', when: thelook_users.age < 35, then: '25-34', when: thelook_users.age < 45, then: '35-44', when: thelook_users.age < 55, then: '45-54', else: '55+') ;;
        calc_type: 'dimension'
        data_type: 'text'
        model: thelook_users
      }
      x_axis: VizFieldFull {
        ref: ref('thelook_users', 'age_band')
        label: 'Age Band'
        format { type: 'text' }
      }
      legend: VizFieldFull {
        ref: r(thelook_users.gender)
        label: 'Gender'
        format { type: 'text' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format { type: 'number' pattern: 'inherited' }
          }
          settings {
            point { value: 'F' color: '#2A5BD7' }
            point { value: 'M' color: '#14A38B' }
          }
        }
      }
      settings {
        legend_label: 'top'
        sort: LineFamilySort { type: 'xaxis' direction: 'asc' }
      }
    }
  }
  view: CanvasLayout {
    width: 400
    height: 400
    block age { position: pos(0, 0, 300, 300) }
  }
}
