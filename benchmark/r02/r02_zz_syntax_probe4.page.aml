Dashboard r02_zz_syntax_probe4 {
  title: 'probe4'
  block map: VizBlock {
    label: 'map'
    viz: FilledMap {
      dataset: thelook
      location {
        field: r(thelook_users.country)
        location_type: 'country'
        primary_field: true
      }
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format { type: 'number' pattern: 'inherited' }
      }
      settings {
        color_scale: 'vertical'
        map_background: 'light'
        value_colors {
          style: 'smooth'
          min { color: '#DCE6FA' }
          max { color: '#16243D' }
        }
      }
    }
  }
  view: CanvasLayout {
    width: 400
    height: 400
    block map { position: pos(0, 0, 300, 300) }
  }
}
