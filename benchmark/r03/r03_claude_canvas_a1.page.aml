      }
      values: [
        VizFieldFull {
          ref: 'cur_value'
          label: 'Value'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: 'mom_change'
          label: 'Change'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        },
        VizFieldFull {
          ref: 'direction'
          label: 'Direction'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: 'cur_month'
          label: 'Month'
          format {
            type: 'date'
