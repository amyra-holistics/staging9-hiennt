  block kpi_aov: VizBlock {
    label: 'AOV'
    settings {
      hide_label: true
    }
    viz: MarkdownViz {
      dataset: thelook
      calculation cur_value {
        label: 'Value'
        formula: @aql aov | where(thelook_orders.created_at matches @(last month));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation mom_change {
        label: 'Change'
        formula: @aql abs(safe_divide((aov | where(thelook_orders.created_at matches @(last month))) - (aov | where(thelook_orders.created_at matches @(2 months ago))), aov | where(thelook_orders.created_at matches @(2 months ago))));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation direction {
        label: 'Direction'
        formula: @aql case(when: (aov | where(thelook_orders.created_at matches @(last month))) >= (aov | where(thelook_orders.created_at matches @(2 months ago))), then: "up", else: "down");;
        calc_type: 'measure'
        data_type: 'text'
