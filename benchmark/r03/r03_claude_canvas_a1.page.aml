        calc_type: 'measure'
        data_type: 'date'
      }
      calculation prev_month {
        label: 'Prior Month'
        formula: @aql max(thelook_orders.created_at | month()) | where(thelook_orders.created_at matches @(2 months ago));;
        calc_type: 'measure'
        data_type: 'date'
      }
      values: [
        VizFieldFull {
          ref: 'cur_value'
          label: 'Value'
          format {
            type: 'number'
            pattern: '[$$]#,###0.00'
          }
        },
        VizFieldFull {
          ref: 'mom_change'
          label: 'Change'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        },
        VizFieldFull {
          ref: 'direction'
          label: 'Direction'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: 'cur_month'
          label: 'Month'
          format {
            type: 'date'
            pattern: 'LLL yyyy'
          }
        },
        VizFieldFull {
          ref: 'prev_month'
          label: 'Prior Month'
          format {
            type: 'date'
            pattern: 'LLL yyyy'
          }
        },
      ]
      content: @md
        <style>
          @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;800&display=swap');
          .tl-kpi { font-family: Manrope, Arial, sans-serif; color: #1B1F3B; height: 100%; box-sizing: border-box; padding: 20px 22px; display: flex; flex-direction: column; justify-content: space-between; border-top: 4px solid #FF6B5A; }
          .tl-kpi-top { display: flex; align-items: center; gap: 12px; }
          .tl-kpi-icon { width: 40px; height: 40px; border-radius: 12px; background: #FFF0EE; display: flex; align-items: center; justify-content: center; }
          .tl-kpi-icon img { width: 22px; height: 22px; }
          .tl-kpi-label { font-size: 14px; font-weight: 600; color: #5B6477; text-transform: uppercase; letter-spacing: 0.06em; }
          .tl-kpi-value { font-size: 36px; font-weight: 800; letter-spacing: -0.02em; line-height: 1.1; margin: 10px 0 8px; }
          .tl-kpi-foot { display: flex; align-items: center; gap: 10px; font-size: 13px; color: #5B6477; }
          .tl-badge { display: inline-flex; align-items: center; gap: 4px; padding: 4px 10px; border-radius: 999px; font-size: 13px; font-weight: 600; }
          .tl-badge.up { background: #E3F4F1; color: #1F9E8F; }
          .tl-badge.down { background: #FBE7E7; color: #D64545; }
          .tl-badge.up::before { content: '▲'; font-size: 10px; }
          .tl-badge.down::before { content: '▼'; font-size: 10px; }
        </style>
