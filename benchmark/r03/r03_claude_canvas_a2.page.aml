Dashboard r03_claude_canvas_a2 {
  title: 'TheLook Business Review'
  description: 'Branded monthly business review: last complete month vs the month before.'

  // Branded header: logo, title and reporting period
  block header: VizBlock {
    label: 'Header'
    settings {
      hide_label: true
      hide_controls: true
    }
    theme {
      padding: 0
      background {
        bg_color: 'transparent'
      }
      border {
        border_width: 0
      }
    }
    viz: MarkdownViz {
      dataset: thelook
      calculation cur_month {
        label: 'Current Month'
        formula: @aql max(thelook_order_items.created_at | month()) | where(thelook_order_items.created_at matches @(last month));;
        calc_type: 'measure'
        data_type: 'date'
      }
      calculation prev_month {
        label: 'Previous Month'
        formula: @aql max(thelook_order_items.created_at | month()) | where(thelook_order_items.created_at matches @(2 months ago));;
        calc_type: 'measure'
        data_type: 'date'
      }
      values: [
        VizFieldFull {
          ref: 'cur_month'
          label: 'Current Month'
          format {
            type: 'date'
            pattern: 'LLLL yyyy'
          }
        },
        VizFieldFull {
          ref: 'prev_month'
          label: 'Previous Month'
          format {
            type: 'date'
            pattern: 'LLLL yyyy'
          }
        }
      ]
      content: @md
        <style>
          @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;800&display=swap');
          .tl-header {
            box-sizing: border-box;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
            padding: 0 32px;
            background: #FFFFFF;
            border-radius: 16px;
            border-bottom: 4px solid #FF6B5A;
            font-family: 'Manrope', Arial, sans-serif;
          }
          .tl-header__brand { display: flex; align-items: center; gap: 24px; }
          .tl-header__brand img { height: 40px; display: block; }
          .tl-header__divider { width: 1px; height: 44px; background: #E4DCCF; }
          .tl-header__title { margin: 0; color: #1B1F3B; font-size: 26px; font-weight: 800; letter-spacing: -0.5px; line-height: 1.15; }
          .tl-header__subtitle { margin: 4px 0 0; color: #5B6477; font-size: 14px; font-weight: 400; }
          .tl-header__period {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            padding: 10px 18px;
            background: #1B1F3B;
            border-radius: 12px;
          }
          .tl-header__period-label { color: #FF6B5A; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; }
          .tl-header__period-value { color: #F5EFE6; font-size: 18px; font-weight: 800; }
        </style>
        <div class="tl-header">
          <div class="tl-header__brand">
            <img alt="thelook" src="data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='176' height='40' viewBox='0 0 176 40'%3E%3Ccircle cx='18' cy='20' r='11' fill='%23FF6B5A'/%3E%3Ccircle cx='18' cy='20' r='4.5' fill='%23F5EFE6'/%3E%3Ctext x='38' y='28' font-family='Manrope, Arial, sans-serif' font-size='24' font-weight='800' letter-spacing='-0.5' fill='%231B1F3B'%3Ethelook%3C/text%3E%3C/svg%3E" />
            <div class="tl-header__divider"></div>
            <div>
              <h1 class="tl-header__title">Monthly Business Review</h1>
              <p class="tl-header__subtitle">Sales, orders and profitability · compared with {{ rows[0].values.`Previous Month`.formatted }}</p>
            </div>
          </div>
          <div class="tl-header__period">
            <span class="tl-header__period-label">Reporting month</span>
            <span class="tl-header__period-value">{{ rows[0].values.`Current Month`.formatted }}</span>
          </div>
        </div>
      ;;
      settings {
        row_limit: 1
      }
    }
  }

  // KPI card: Net Sales
  block kpi_net_sales: VizBlock {
    label: 'Net Sales'
    settings {
      hide_label: true
    }
    theme {
      padding: 0
    }
    viz: MarkdownViz {
      dataset: thelook
      calculation cur {
        label: 'Current'
        formula: @aql net_sales | where(thelook_order_items.created_at matches @(last month));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation prev {
        label: 'Previous'
        formula: @aql net_sales | where(thelook_order_items.created_at matches @(2 months ago));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation chg {
        label: 'Change'
        formula: @aql abs(safe_divide((net_sales | where(thelook_order_items.created_at matches @(last month))) - (net_sales | where(thelook_order_items.created_at matches @(2 months ago))), net_sales | where(thelook_order_items.created_at matches @(2 months ago))));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation dir {
        label: 'Direction'
        formula: @aql case(when: (net_sales | where(thelook_order_items.created_at matches @(last month))) >= (net_sales | where(thelook_order_items.created_at matches @(2 months ago))), then: 'up', else: 'down');;
        calc_type: 'measure'
        data_type: 'text'
      }
      values: [
        VizFieldFull {
          ref: 'cur'
          label: 'Current'
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
        },
        VizFieldFull {
          ref: 'prev'
          label: 'Previous'
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
        },
        VizFieldFull {
          ref: 'chg'
          label: 'Change'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        },
        VizFieldFull {
          ref: 'dir'
          label: 'Direction'
          format {
            type: 'text'
          }
        }
      ]
      content: @md
        <style>
          @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;800&display=swap');
          .tl-kpi { box-sizing: border-box; height: 100%; padding: 22px 24px; background: #FFFFFF; border-radius: 16px; font-family: 'Manrope', Arial, sans-serif; display: flex; flex-direction: column; justify-content: space-between; }
          .tl-kpi__top { display: flex; align-items: center; justify-content: space-between; }
          .tl-kpi__label { color: #5B6477; font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.8px; }
          .tl-kpi__icon { width: 44px; height: 44px; border-radius: 12px; background: #FFE9E6; color: #FF6B5A; display: flex; align-items: center; justify-content: center; }
          .tl-kpi__icon svg { width: 22px; height: 22px; }
          .tl-kpi__value { color: #1B1F3B; font-size: 34px; font-weight: 800; letter-spacing: -1px; line-height: 1.1; }
          .tl-kpi__foot { display: flex; align-items: center; gap: 10px; color: #5B6477; font-size: 13px; font-weight: 400; }
          .tl-badge { display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 999px; font-size: 13px; font-weight: 600; }
          .tl-badge.up { background: #E3F4F1; color: #1F9E8F; }
          .tl-badge.down { background: #FBE7E7; color: #D64545; }
          .tl-badge .arrow { display: none; }
          .tl-badge.up .arrow.up, .tl-badge.down .arrow.down { display: inline; }
        </style>
        <div class="tl-kpi">
          <div class="tl-kpi__top">
            <span class="tl-kpi__label">Net Sales</span>
            <span class="tl-kpi__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="2" x2="12" y2="22"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></span>
          </div>
          <div class="tl-kpi__value">{{ rows[0].values.`Current`.formatted }}</div>
          <div class="tl-kpi__foot">
            <span class="tl-badge {{ rows[0].values.`Direction`.raw }}"><span class="arrow up">▲</span><span class="arrow down">▼</span>{{ rows[0].values.`Change`.formatted }}</span>
            <span>MoM · vs {{ rows[0].values.`Previous`.formatted }}</span>
          </div>
        </div>
      ;;
      settings {
        row_limit: 1
      }
    }
  }

  // KPI card: Orders
  block kpi_orders: VizBlock {
    label: 'Orders'
    settings {
      hide_label: true
    }
    theme {
      padding: 0
    }
    viz: MarkdownViz {
      dataset: thelook
      calculation cur {
        label: 'Current'
        formula: @aql total_orders | where(thelook_orders.created_at matches @(last month));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation prev {
        label: 'Previous'
        formula: @aql total_orders | where(thelook_orders.created_at matches @(2 months ago));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation chg {
        label: 'Change'
        formula: @aql abs(safe_divide((total_orders | where(thelook_orders.created_at matches @(last month))) - (total_orders | where(thelook_orders.created_at matches @(2 months ago))), total_orders | where(thelook_orders.created_at matches @(2 months ago))));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation dir {
        label: 'Direction'
        formula: @aql case(when: (total_orders | where(thelook_orders.created_at matches @(last month))) >= (total_orders | where(thelook_orders.created_at matches @(2 months ago))), then: 'up', else: 'down');;
        calc_type: 'measure'
        data_type: 'text'
      }
      values: [
        VizFieldFull {
          ref: 'cur'
          label: 'Current'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: 'prev'
          label: 'Previous'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: 'chg'
          label: 'Change'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        },
        VizFieldFull {
          ref: 'dir'
          label: 'Direction'
          format {
            type: 'text'
          }
        }
      ]
      content: @md
        <style>
          @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;800&display=swap');
          .tl-kpi { box-sizing: border-box; height: 100%; padding: 22px 24px; background: #FFFFFF; border-radius: 16px; font-family: 'Manrope', Arial, sans-serif; display: flex; flex-direction: column; justify-content: space-between; }
          .tl-kpi__top { display: flex; align-items: center; justify-content: space-between; }
          .tl-kpi__label { color: #5B6477; font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.8px; }
          .tl-kpi__icon { width: 44px; height: 44px; border-radius: 12px; background: #FFE9E6; color: #FF6B5A; display: flex; align-items: center; justify-content: center; }
          .tl-kpi__icon svg { width: 22px; height: 22px; }
          .tl-kpi__value { color: #1B1F3B; font-size: 34px; font-weight: 800; letter-spacing: -1px; line-height: 1.1; }
          .tl-kpi__foot { display: flex; align-items: center; gap: 10px; color: #5B6477; font-size: 13px; font-weight: 400; }
          .tl-badge { display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 999px; font-size: 13px; font-weight: 600; }
          .tl-badge.up { background: #E3F4F1; color: #1F9E8F; }
          .tl-badge.down { background: #FBE7E7; color: #D64545; }
          .tl-badge .arrow { display: none; }
          .tl-badge.up .arrow.up, .tl-badge.down .arrow.down { display: inline; }
        </style>
        <div class="tl-kpi">
          <div class="tl-kpi__top">
            <span class="tl-kpi__label">Orders</span>
            <span class="tl-kpi__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg></span>
          </div>
          <div class="tl-kpi__value">{{ rows[0].values.`Current`.formatted }}</div>
          <div class="tl-kpi__foot">
            <span class="tl-badge {{ rows[0].values.`Direction`.raw }}"><span class="arrow up">▲</span><span class="arrow down">▼</span>{{ rows[0].values.`Change`.formatted }}</span>
            <span>MoM · vs {{ rows[0].values.`Previous`.formatted }}</span>
          </div>
        </div>
      ;;
      settings {
        row_limit: 1
      }
    }
  }

  // KPI card: Average Order Value
  block kpi_aov: VizBlock {
    label: 'AOV'
    settings {
      hide_label: true
    }
    theme {
      padding: 0
    }
    viz: MarkdownViz {
      dataset: thelook
      calculation cur {
        label: 'Current'
        formula: @aql aov | where(thelook_order_items.created_at matches @(last month));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation prev {
        label: 'Previous'
        formula: @aql aov | where(thelook_order_items.created_at matches @(2 months ago));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation chg {
        label: 'Change'
        formula: @aql abs(safe_divide((aov | where(thelook_order_items.created_at matches @(last month))) - (aov | where(thelook_order_items.created_at matches @(2 months ago))), aov | where(thelook_order_items.created_at matches @(2 months ago))));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation dir {
        label: 'Direction'
        formula: @aql case(when: (aov | where(thelook_order_items.created_at matches @(last month))) >= (aov | where(thelook_order_items.created_at matches @(2 months ago))), then: 'up', else: 'down');;
        calc_type: 'measure'
        data_type: 'text'
      }
      values: [
        VizFieldFull {
          ref: 'cur'
          label: 'Current'
          format {
            type: 'number'
            pattern: '[$$]#,###0.00'
          }
        },
        VizFieldFull {
          ref: 'prev'
          label: 'Previous'
          format {
            type: 'number'
            pattern: '[$$]#,###0.00'
          }
        },
        VizFieldFull {
          ref: 'chg'
          label: 'Change'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        },
        VizFieldFull {
          ref: 'dir'
          label: 'Direction'
          format {
            type: 'text'
          }
        }
      ]
      content: @md
        <style>
          @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;800&display=swap');
          .tl-kpi { box-sizing: border-box; height: 100%; padding: 22px 24px; background: #FFFFFF; border-radius: 16px; font-family: 'Manrope', Arial, sans-serif; display: flex; flex-direction: column; justify-content: space-between; }
          .tl-kpi__top { display: flex; align-items: center; justify-content: space-between; }
          .tl-kpi__label { color: #5B6477; font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.8px; }
          .tl-kpi__icon { width: 44px; height: 44px; border-radius: 12px; background: #FFE9E6; color: #FF6B5A; display: flex; align-items: center; justify-content: center; }
          .tl-kpi__icon svg { width: 22px; height: 22px; }
          .tl-kpi__value { color: #1B1F3B; font-size: 34px; font-weight: 800; letter-spacing: -1px; line-height: 1.1; }
          .tl-kpi__foot { display: flex; align-items: center; gap: 10px; color: #5B6477; font-size: 13px; font-weight: 400; }
          .tl-badge { display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 999px; font-size: 13px; font-weight: 600; }
          .tl-badge.up { background: #E3F4F1; color: #1F9E8F; }
          .tl-badge.down { background: #FBE7E7; color: #D64545; }
          .tl-badge .arrow { display: none; }
          .tl-badge.up .arrow.up, .tl-badge.down .arrow.down { display: inline; }
        </style>
        <div class="tl-kpi">
          <div class="tl-kpi__top">
            <span class="tl-kpi__label">Avg Order Value</span>
            <span class="tl-kpi__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg></span>
          </div>
          <div class="tl-kpi__value">{{ rows[0].values.`Current`.formatted }}</div>
          <div class="tl-kpi__foot">
            <span class="tl-badge {{ rows[0].values.`Direction`.raw }}"><span class="arrow up">▲</span><span class="arrow down">▼</span>{{ rows[0].values.`Change`.formatted }}</span>
            <span>MoM · vs {{ rows[0].values.`Previous`.formatted }}</span>
          </div>
        </div>
      ;;
      settings {
        row_limit: 1
      }
    }
  }

  // KPI card: Gross Margin (change shown in percentage points)
  block kpi_gross_margin: VizBlock {
    label: 'Gross Margin'
    settings {
      hide_label: true
    }
    theme {
      padding: 0
    }
    viz: MarkdownViz {
      dataset: thelook
      calculation cur {
        label: 'Current'
        formula: @aql gross_margin | where(thelook_order_items.created_at matches @(last month));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation prev {
        label: 'Previous'
        formula: @aql gross_margin | where(thelook_order_items.created_at matches @(2 months ago));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation chg {
        label: 'Change'
        formula: @aql abs((gross_margin | where(thelook_order_items.created_at matches @(last month))) - (gross_margin | where(thelook_order_items.created_at matches @(2 months ago)))) * 100;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation dir {
        label: 'Direction'
        formula: @aql case(when: (gross_margin | where(thelook_order_items.created_at matches @(last month))) >= (gross_margin | where(thelook_order_items.created_at matches @(2 months ago))), then: 'up', else: 'down');;
        calc_type: 'measure'
        data_type: 'text'
      }
      values: [
        VizFieldFull {
          ref: 'cur'
          label: 'Current'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        },
        VizFieldFull {
          ref: 'prev'
          label: 'Previous'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        },
        VizFieldFull {
          ref: 'chg'
          label: 'Change'
          format {
            type: 'number'
            pattern: '#,###0.0'
          }
        },
        VizFieldFull {
          ref: 'dir'
          label: 'Direction'
          format {
            type: 'text'
          }
        }
      ]
      content: @md
        <style>
          @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;800&display=swap');
          .tl-kpi { box-sizing: border-box; height: 100%; padding: 22px 24px; background: #FFFFFF; border-radius: 16px; font-family: 'Manrope', Arial, sans-serif; display: flex; flex-direction: column; justify-content: space-between; }
          .tl-kpi__top { display: flex; align-items: center; justify-content: space-between; }
          .tl-kpi__label { color: #5B6477; font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.8px; }
          .tl-kpi__icon { width: 44px; height: 44px; border-radius: 12px; background: #FFE9E6; color: #FF6B5A; display: flex; align-items: center; justify-content: center; }
          .tl-kpi__icon svg { width: 22px; height: 22px; }
          .tl-kpi__value { color: #1B1F3B; font-size: 34px; font-weight: 800; letter-spacing: -1px; line-height: 1.1; }
          .tl-kpi__foot { display: flex; align-items: center; gap: 10px; color: #5B6477; font-size: 13px; font-weight: 400; }
          .tl-badge { display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 999px; font-size: 13px; font-weight: 600; }
          .tl-badge.up { background: #E3F4F1; color: #1F9E8F; }
          .tl-badge.down { background: #FBE7E7; color: #D64545; }
          .tl-badge .arrow { display: none; }
          .tl-badge.up .arrow.up, .tl-badge.down .arrow.down { display: inline; }
        </style>
        <div class="tl-kpi">
          <div class="tl-kpi__top">
            <span class="tl-kpi__label">Gross Margin</span>
            <span class="tl-kpi__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.21 15.89A10 10 0 1 1 8 2.83"/><path d="M22 12A10 10 0 0 0 12 2v10z"/></svg></span>
          </div>
          <div class="tl-kpi__value">{{ rows[0].values.`Current`.formatted }}</div>
          <div class="tl-kpi__foot">
            <span class="tl-badge {{ rows[0].values.`Direction`.raw }}"><span class="arrow up">▲</span><span class="arrow down">▼</span>{{ rows[0].values.`Change`.formatted }} pts</span>
            <span>MoM · vs {{ rows[0].values.`Previous`.formatted }}</span>
          </div>
        </div>
      ;;
      settings {
        row_limit: 1
      }
    }
  }

  // Trend: Net Sales by month, last 12 complete months
  block net_sales_trend: VizBlock {
    label: 'Net Sales by Month · last 12 complete months'
    viz: ColumnChart {
      dataset: thelook
      filter {
        field: r(thelook_order_items.created_at)
        operator: 'matches'
        value: 'last 12 months'
      }
      x_axis: VizFieldFull {
        label: 'Month'
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            label: 'Net Sales'
            ref: r(thelook.net_sales)
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
          settings {
            color: '#FF6B5A'
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
        row_limit: 100
      }
    }
  }

  // Breakdown: Net Sales by category, reporting month
  block net_sales_by_category: VizBlock {
    label: 'Top Categories by Net Sales · reporting month'
    viz: BarChart {
      dataset: thelook
      filter {
        field: r(thelook_order_items.created_at)
        operator: 'matches'
        value: 'last month'
      }
      x_axis: VizFieldFull {
        label: 'Category'
        ref: r(thelook_products.category)
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            label: 'Net Sales'
            ref: r(thelook.net_sales)
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
          settings {
            color: '#1B1F3B'
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
        row_limit: 8
      }
    }
  }

  view: CanvasLayout {
    label: 'Business Review'
    width: 1280
    height: 820
    grid_size: 20
    auto_expand_vertically: true
    block header {
      position: pos(20, 20, 1240, 100)
    }
    block kpi_net_sales {
      position: pos(20, 140, 295, 160)
    }
    block kpi_orders {
      position: pos(335, 140, 295, 160)
    }
    block kpi_aov {
      position: pos(650, 140, 295, 160)
    }
    block kpi_gross_margin {
      position: pos(965, 140, 295, 160)
    }
    block net_sales_trend {
      position: pos(20, 320, 780, 440)
    }
    block net_sales_by_category {
      position: pos(820, 320, 440, 440)
    }
    theme {
      background {
        bg_color: '#F5EFE6'
      }
    }
    mobile {
      mode: 'auto'
    }
  }

  theme: PageTheme {
    background {
      bg_color: '#F5EFE6'
    }
    canvas {
      background {
        bg_color: '#F5EFE6'
      }
      border {
        border_width: 0
      }
    }
    block {
      label {
        font_family: 'Manrope, Arial, sans-serif'
        font_color: '#1B1F3B'
        font_size: 15
        font_weight: 'extrabold'
      }
      text {
        font_family: 'Manrope, Arial, sans-serif'
        font_color: '#5B6477'
        font_weight: 'normal'
      }
      background {
        bg_color: '#FFFFFF'
      }
      border {
        border_width: 0
        border_radius: 16
      }
      padding: 16
      shadow: 'none'
    }
    custom_css: @css
      @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;800&display=swap');
    ;;
  }
}
