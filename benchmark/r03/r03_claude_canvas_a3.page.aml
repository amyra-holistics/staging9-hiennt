  }

  block kpi_aov: VizBlock {
    label: 'AOV'
    settings {
      hide_label: true
    }
    viz: MarkdownViz {
      dataset: thelook
      calculation aov_current {
        label: 'Current'
        formula: @aql aov | where(thelook_order_items.created_at is @(last month)) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation aov_previous {
        label: 'Previous'
        formula: @aql aov | where(thelook_order_items.created_at is @(2 months ago)) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation aov_change {
        label: 'Change'
        formula: @aql abs(safe_divide(aov_current - aov_previous, aov_previous)) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation aov_direction {
        label: 'Direction'
        formula: @aql case(when: aov_current >= aov_previous, then: 'up', else: 'down') ;;
        calc_type: 'measure'
        data_type: 'text'
      }
      values: [
        VizFieldFull {
          ref: 'aov_current'
          format {
            type: 'number'
            pattern: '[$$]#,###0.00'
          }
        },
        VizFieldFull {
          ref: 'aov_previous'
          format {
            type: 'number'
            pattern: '[$$]#,###0.00'
          }
        },
        VizFieldFull {
          ref: 'aov_change'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        },
        VizFieldFull {
          ref: 'aov_direction'
          format {
            type: 'text'
          }
        }
      ]
      content: @md
