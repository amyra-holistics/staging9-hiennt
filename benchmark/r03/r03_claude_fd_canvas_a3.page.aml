Dashboard r03_claude_fd_canvas_a3 {
  title: 'TheLook Business Review'
  description: 'Branded monthly business review: Net Sales, Orders, AOV and Gross Margin with month-over-month change.'

  // ---------------------------------------------------------------- Header
  block header: TextBlock {
    content: @md
<div style="height:100%;box-sizing:border-box;display:flex;align-items:center;gap:28px;padding:0 36px;background:#1B1F3B;font-family:'Manrope',Arial,sans-serif;border-bottom:4px solid #FF6B5A;">
<div style="flex:none;display:flex;align-items:center;background:#F5EFE6;border-radius:12px;padding:8px 16px 8px 10px;"><img alt="TheLook" width="176" height="40" style="display:block;" src="data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='176' height='40' viewBox='0 0 176 40'%3E%3Ccircle cx='18' cy='20' r='11' fill='%23FF6B5A'/%3E%3Ccircle cx='18' cy='20' r='4.5' fill='%23F5EFE6'/%3E%3Ctext x='38' y='28' font-family='Manrope, Arial, sans-serif' font-size='24' font-weight='800' letter-spacing='-0.5' fill='%231B1F3B'%3Ethelook%3C/text%3E%3C/svg%3E" /></div>
<div style="width:1px;height:56px;background:rgba(245,239,230,0.18);"></div>
<div>
<div style="font-size:12px;font-weight:600;letter-spacing:0.14em;text-transform:uppercase;color:#FF6B5A;margin-bottom:4px;">Monthly Business Review</div>
<div style="font-size:30px;font-weight:800;letter-spacing:-0.02em;line-height:1.1;color:#F5EFE6;">Commercial Performance</div>
<div style="font-size:13px;font-weight:400;color:#B9BFCC;margin-top:6px;">Net sales exclude cancelled and returned items. Change is measured against the prior month.</div>
</div>
</div>
    ;;
    theme {
      background {
        bg_color: '#1B1F3B'
      }
      border {
        border_width: 0
        border_radius: 0
      }
      padding: 0
      shadow: 'none'
    }
  }

  block f_month: FilterBlock {
    label: 'Reporting month'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
    default {
      operator: 'last'
      value: '1'
      modifier: 'month'
    }
    theme {
      background {
        bg_color: 'transparent'
      }
      border {
        border_width: 0
      }
      label {
        font_color: '#F5EFE6'
        font_weight: 'semibold'
      }
      shadow: 'none'
    }
  }

  // ---------------------------------------------------------------- KPI cards
  block kpi_net_sales: VizBlock {
    label: 'Net Sales'
    settings {
      hide_label: true
    }
    viz: MarkdownViz {
      dataset: thelook
      calculation prev_value {
        label: 'Prior Value'
        formula: @aql net_sales | relative_period(thelook_order_items.created_at, interval(-1 month));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation mom_change {
        label: 'MoM Change'
        formula: @aql abs(safe_divide(net_sales - (net_sales | relative_period(thelook_order_items.created_at, interval(-1 month))), net_sales | relative_period(thelook_order_items.created_at, interval(-1 month))));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation direction {
        label: 'Direction'
        formula: @aql case(when: net_sales >= (net_sales | relative_period(thelook_order_items.created_at, interval(-1 month))), then: "up", else: "down");;
        calc_type: 'measure'
        data_type: 'text'
      }
      values: [
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Current Value'
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
        },
        VizFieldFull {
          ref: 'prev_value'
          label: 'Prior Value'
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
        },
        VizFieldFull {
          ref: 'mom_change'
          label: 'MoM Change'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        },
        VizFieldFull {
          ref: 'direction'
          label: 'Direction'
          format {
            type: 'text'
          }
        }
      ]
      content: @md
<style>
@import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;800&display=swap');
.tlk-card{height:100%;box-sizing:border-box;padding:20px 22px;display:flex;flex-direction:column;justify-content:space-between;font-family:'Manrope',Arial,sans-serif;color:#1B1F3B;}
.tlk-head{display:flex;align-items:center;gap:12px;}
.tlk-icon{width:40px;height:40px;border-radius:12px;background:#FFE8E4;color:#FF6B5A;display:flex;align-items:center;justify-content:center;flex:none;}
.tlk-icon svg{width:22px;height:22px;}
.tlk-label{font-size:14px;font-weight:600;color:#5B6477;}
.tlk-value{font-size:36px;font-weight:800;letter-spacing:-0.02em;line-height:1;color:#1B1F3B;margin:14px 0 12px;}
.tlk-foot{display:flex;align-items:center;gap:10px;font-size:12px;font-weight:400;color:#5B6477;}
.tlk-badge{display:inline-flex;align-items:center;gap:4px;padding:3px 9px;border-radius:999px;font-size:12px;font-weight:800;color:#FFFFFF;}
.tlk-badge.up{background:#1F9E8F;}
.tlk-badge.up::before{content:"▲";font-size:9px;}
.tlk-badge.down{background:#D64545;}
.tlk-badge.down::before{content:"▼";font-size:9px;}
</style>
<div class="tlk-card">
<div class="tlk-head"><span class="tlk-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></span><span class="tlk-label">Net Sales</span></div>
<div class="tlk-value">{{ rows[0].values.`Current Value`.formatted }}</div>
<div class="tlk-foot"><span class="tlk-badge {{ rows[0].values.`Direction`.raw }}">{{ rows[0].values.`MoM Change`.formatted }}</span><span>vs {{ rows[0].values.`Prior Value`.formatted }} prior month</span></div>
</div>
      ;;
      settings {
        row_limit: 1
      }
    }
  }

  block kpi_orders: VizBlock {
    label: 'Orders'
    settings {
      hide_label: true
    }
    viz: MarkdownViz {
      dataset: thelook
      calculation prev_value {
        label: 'Prior Value'
        formula: @aql total_orders | relative_period(thelook_order_items.created_at, interval(-1 month));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation mom_change {
        label: 'MoM Change'
        formula: @aql abs(safe_divide(total_orders - (total_orders | relative_period(thelook_order_items.created_at, interval(-1 month))), total_orders | relative_period(thelook_order_items.created_at, interval(-1 month))));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation direction {
        label: 'Direction'
        formula: @aql case(when: total_orders >= (total_orders | relative_period(thelook_order_items.created_at, interval(-1 month))), then: "up", else: "down");;
        calc_type: 'measure'
        data_type: 'text'
      }
      values: [
        VizFieldFull {
          ref: r(thelook.total_orders)
          label: 'Current Value'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: 'prev_value'
          label: 'Prior Value'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: 'mom_change'
          label: 'MoM Change'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        },
        VizFieldFull {
          ref: 'direction'
          label: 'Direction'
          format {
            type: 'text'
          }
        }
      ]
      content: @md
<style>
@import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;800&display=swap');
.tlk-card{height:100%;box-sizing:border-box;padding:20px 22px;display:flex;flex-direction:column;justify-content:space-between;font-family:'Manrope',Arial,sans-serif;color:#1B1F3B;}
.tlk-head{display:flex;align-items:center;gap:12px;}
.tlk-icon{width:40px;height:40px;border-radius:12px;background:#FFE8E4;color:#FF6B5A;display:flex;align-items:center;justify-content:center;flex:none;}
.tlk-icon svg{width:22px;height:22px;}
.tlk-label{font-size:14px;font-weight:600;color:#5B6477;}
.tlk-value{font-size:36px;font-weight:800;letter-spacing:-0.02em;line-height:1;color:#1B1F3B;margin:14px 0 12px;}
.tlk-foot{display:flex;align-items:center;gap:10px;font-size:12px;font-weight:400;color:#5B6477;}
.tlk-badge{display:inline-flex;align-items:center;gap:4px;padding:3px 9px;border-radius:999px;font-size:12px;font-weight:800;color:#FFFFFF;}
.tlk-badge.up{background:#1F9E8F;}
.tlk-badge.up::before{content:"▲";font-size:9px;}
.tlk-badge.down{background:#D64545;}
.tlk-badge.down::before{content:"▼";font-size:9px;}
</style>
<div class="tlk-card">
<div class="tlk-head"><span class="tlk-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg></span><span class="tlk-label">Orders</span></div>
<div class="tlk-value">{{ rows[0].values.`Current Value`.formatted }}</div>
<div class="tlk-foot"><span class="tlk-badge {{ rows[0].values.`Direction`.raw }}">{{ rows[0].values.`MoM Change`.formatted }}</span><span>vs {{ rows[0].values.`Prior Value`.formatted }} prior month</span></div>
</div>
      ;;
      settings {
        row_limit: 1
      }
    }
  }

  block kpi_aov: VizBlock {
    label: 'Average Order Value'
    settings {
      hide_label: true
    }
    viz: MarkdownViz {
      dataset: thelook
      calculation prev_value {
        label: 'Prior Value'
        formula: @aql aov | relative_period(thelook_order_items.created_at, interval(-1 month));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation mom_change {
        label: 'MoM Change'
        formula: @aql abs(safe_divide(aov - (aov | relative_period(thelook_order_items.created_at, interval(-1 month))), aov | relative_period(thelook_order_items.created_at, interval(-1 month))));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation direction {
        label: 'Direction'
        formula: @aql case(when: aov >= (aov | relative_period(thelook_order_items.created_at, interval(-1 month))), then: "up", else: "down");;
        calc_type: 'measure'
        data_type: 'text'
      }
      values: [
        VizFieldFull {
          ref: r(thelook.aov)
          label: 'Current Value'
          format {
            type: 'number'
            pattern: '[$$]#,###0.00'
          }
        },
        VizFieldFull {
          ref: 'prev_value'
          label: 'Prior Value'
          format {
            type: 'number'
            pattern: '[$$]#,###0.00'
          }
        },
        VizFieldFull {
          ref: 'mom_change'
          label: 'MoM Change'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        },
        VizFieldFull {
          ref: 'direction'
          label: 'Direction'
          format {
            type: 'text'
          }
        }
      ]
      content: @md
<style>
@import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;800&display=swap');
.tlk-card{height:100%;box-sizing:border-box;padding:20px 22px;display:flex;flex-direction:column;justify-content:space-between;font-family:'Manrope',Arial,sans-serif;color:#1B1F3B;}
.tlk-head{display:flex;align-items:center;gap:12px;}
