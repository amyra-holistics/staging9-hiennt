.tlk-icon svg{width:22px;height:22px;}
.tlk-label{font-size:14px;font-weight:600;color:#5B6477;}
.tlk-value{font-size:36px;font-weight:800;letter-spacing:-0.02em;line-height:1;color:#1B1F3B;margin:14px 0 12px;}
.tlk-foot{display:flex;align-items:center;gap:10px;font-size:12px;font-weight:400;color:#5B6477;}
.tlk-badge{display:inline-flex;align-items:center;gap:4px;padding:3px 9px;border-radius:999px;font-size:12px;font-weight:800;color:#FFFFFF;}
.tlk-badge.up{background:#1F9E8F;}
.tlk-badge.up::before{content:"▲";font-size:9px;}
.tlk-badge.down{background:#D64545;}
.tlk-badge.down::before{content:"▼";font-size:9px;}
</style>
<div class="tlk-card">
<div class="tlk-head"><span class="tlk-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><path d="M12 17.5v-11"/></svg></span><span class="tlk-label">Average Order Value</span></div>
<div class="tlk-value">{{ rows[0].values.`Current Value`.formatted }}</div>
<div class="tlk-foot"><span class="tlk-badge {{ rows[0].values.`Direction`.raw }}">{{ rows[0].values.`MoM Change`.formatted }}</span><span>vs {{ rows[0].values.`Prior Value`.formatted }} prior month</span></div>
</div>
      ;;
      settings {
        row_limit: 1
      }
    }
  }

  block kpi_gross_margin: VizBlock {
    label: 'Gross Margin'
    settings {
      hide_label: true
    }
    viz: MarkdownViz {
      dataset: thelook
      calculation prev_value {
        label: 'Prior Value'
        formula: @aql gross_margin | relative_period(thelook_order_items.created_at, interval(-1 month));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation pts_change {
        label: 'Pts Change'
        formula: @aql abs(gross_margin - (gross_margin | relative_period(thelook_order_items.created_at, interval(-1 month)))) * 100;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation direction {
        label: 'Direction'
        formula: @aql case(when: gross_margin >= (gross_margin | relative_period(thelook_order_items.created_at, interval(-1 month))), then: "up", else: "down");;
        calc_type: 'measure'
        data_type: 'text'
      }
      values: [
        VizFieldFull {
          ref: r(thelook.gross_margin)
          label: 'Current Value'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        },
        VizFieldFull {
          ref: 'prev_value'
          label: 'Prior Value'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        },
        VizFieldFull {
          ref: 'pts_change'
          label: 'Pts Change'
          format {
            type: 'number'
            pattern: '#,###0.0'
          }
        },
        VizFieldFull {
          ref: 'direction'
          label: 'Direction'
          format {
            type: 'text'
          }
        }
      ]
      content: @md
<style>
@import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;800&display=swap');
.tlk-card{height:100%;box-sizing:border-box;padding:20px 22px;display:flex;flex-direction:column;justify-content:space-between;font-family:'Manrope',Arial,sans-serif;color:#1B1F3B;}
.tlk-head{display:flex;align-items:center;gap:12px;}
.tlk-icon{width:40px;height:40px;border-radius:12px;background:#FFE8E4;color:#FF6B5A;display:flex;align-items:center;justify-content:center;flex:none;}
.tlk-icon svg{width:22px;height:22px;}
.tlk-label{font-size:14px;font-weight:600;color:#5B6477;}
.tlk-value{font-size:36px;font-weight:800;letter-spacing:-0.02em;line-height:1;color:#1B1F3B;margin:14px 0 12px;}
.tlk-foot{display:flex;align-items:center;gap:10px;font-size:12px;font-weight:400;color:#5B6477;}
.tlk-badge{display:inline-flex;align-items:center;gap:4px;padding:3px 9px;border-radius:999px;font-size:12px;font-weight:800;color:#FFFFFF;}
.tlk-badge.up{background:#1F9E8F;}
.tlk-badge.up::before{content:"▲";font-size:9px;}
.tlk-badge.down{background:#D64545;}
.tlk-badge.down::before{content:"▼";font-size:9px;}
</style>
<div class="tlk-card">
<div class="tlk-head"><span class="tlk-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 5 5 19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg></span><span class="tlk-label">Gross Margin</span></div>
<div class="tlk-value">{{ rows[0].values.`Current Value`.formatted }}</div>
<div class="tlk-foot"><span class="tlk-badge {{ rows[0].values.`Direction`.raw }}">{{ rows[0].values.`Pts Change`.formatted }} pts</span><span>vs {{ rows[0].values.`Prior Value`.formatted }} prior month</span></div>
</div>
      ;;
      settings {
        row_limit: 1
      }
    }
  }

  // ---------------------------------------------------------------- Context charts
  block v_sales_trend: VizBlock {
    label: 'Net Sales, last 12 months'
    viz: ColumnChart {
      dataset: thelook
      filter {
        field: r(thelook_order_items.created_at)
        operator: 'last'
        value: '12'
        modifier: 'month'
      }
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'MMM yyyy'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
          settings {
            color: '#1B1F3B'
          }
        }
      }
      settings {
        x_axis_label: ''
        legend_label: 'hidden'
        row_limit: 5000
      }
    }
  }

  block v_category_sales: VizBlock {
    label: 'Top categories by Net Sales, reporting month'
    viz: BarChart {
      dataset: thelook
      filter {
        field: r(thelook_products.category)
        operator: 'top'
        value: 8
        options {
          rank_by {
            field: r(thelook.net_sales)
          }
        }
      }
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
          settings {
            color: '#FF6B5A'
          }
        }
      }
      settings {
        x_axis_label: ''
        legend_label: 'hidden'
        row_limit: 5000
        sort {
          field_index: 0
          direction: 'desc'
          type: 'yaxis'
        }
      }
    }
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'f_month'
      to: ['kpi_net_sales', 'kpi_orders', 'kpi_aov', 'kpi_gross_margin', 'v_category_sales']
      field: r(thelook_order_items.created_at)
    }
  ]

  view: CanvasLayout {
    label: 'Business Review'
    width: 1200
    height: 760
    grid_size: 10
    auto_expand_vertically: true
    block header {
      position: pos(0, 0, 1200, 130)
      layer: 1
    }
    block f_month {
      position: pos(920, 30, 250, 76)
      layer: 2
    }
    block kpi_net_sales {
      position: pos(30, 160, 270, 170)
    }
    block kpi_orders {
      position: pos(320, 160, 270, 170)
    }
    block kpi_aov {
      position: pos(610, 160, 270, 170)
    }
    block kpi_gross_margin {
      position: pos(900, 160, 270, 170)
    }
    block v_sales_trend {
      position: pos(30, 350, 700, 380)
    }
    block v_category_sales {
      position: pos(750, 350, 420, 380)
    }
  }

  theme: PageTheme {
    background {
      bg_color: '#F5EFE6'
    }
    canvas {
      background {
        bg_color: '#F5EFE6'
      }
      border {
        border_width: 0
      }
      shadow: 'none'
    }
    block {
      label {
        font_family: 'Manrope, Arial, sans-serif'
        font_color: '#1B1F3B'
        font_size: 15
        font_weight: 'extrabold'
      }
      text {
        font_family: 'Manrope, Arial, sans-serif'
        font_color: '#5B6477'
        font_weight: 'normal'
      }
      background {
        bg_color: '#FFFFFF'
      }
      border {
        border_width: 1
        border_color: '#E9E1D5'
        border_radius: 16
        border_style: 'solid'
      }
      padding: 12
      shadow: 'none'
    }
    custom_css: @css
      @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;800&display=swap');
    ;;
  }
}
