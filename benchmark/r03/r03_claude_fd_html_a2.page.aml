.tl-kpi { font-family: 'Manrope', Arial, sans-serif; background: #FFFFFF; border-radius: 16px; padding: 20px 22px; height: 100%; box-sizing: border-box; border: 1px solid rgba(27,31,59,0.08); box-shadow: 0 1px 2px rgba(27,31,59,0.06); display: flex; flex-direction: column; gap: 10px; }
