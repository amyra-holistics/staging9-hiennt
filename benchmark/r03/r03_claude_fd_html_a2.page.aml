</style>
<div class="tl-kpi">
<div class="tl-kpi__head"><span class="tl-kpi__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg></span><span class="tl-kpi__label">Orders</span></div>
<div class="tl-kpi__value">{{ rows[0].values.`Value`.formatted }}</div>
<div class="tl-kpi__foot"><span class="tl-badge {{ rows[0].values.`Direction`.raw }}">{{ rows[0].values.`Change`.formatted }}</span><span>vs {{ rows[0].values.`Previous`.formatted }} prior month</span></div>
</div>
;;
    }
  }

  block kpi_aov: VizBlock {
    label: 'Average Order Value'
    settings { hide_label: true }
    theme {
      background { bg_color: 'transparent' }
      border { border_width: 0 }
      padding: 0
    }
    viz: MarkdownViz {
      dataset: thelook
      calculation prev {
        label: 'Previous'
        formula: @aql aov | relative_period(thelook_order_items.created_at, interval(-1 month)) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation mom {
        label: 'Change'
        formula: @aql abs(safe_divide(aov - (aov | relative_period(thelook_order_items.created_at, interval(-1 month))), aov | relative_period(thelook_order_items.created_at, interval(-1 month)))) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation dir {
        label: 'Direction'
        formula: @aql case(when: aov >= (aov | relative_period(thelook_order_items.created_at, interval(-1 month))), then: "up", else: "down") ;;
        calc_type: 'measure'
        data_type: 'text'
      }
      values: [
        VizFieldFull {
          ref: r(thelook.aov)
          label: 'Value'
          format { type: 'number' pattern: '[$$]#,###0.00' }
        },
        VizFieldFull {
          ref: 'prev'
          label: 'Previous'
          format { type: 'number' pattern: '[$$]#,###0.00' }
        },
        VizFieldFull {
          ref: 'mom'
          label: 'Change'
          format { type: 'number' pattern: '#,###0.0%' }
        },
        VizFieldFull {
          ref: 'dir'
          label: 'Direction'
          format { type: 'text' }
        }
      ]
      content: @md
