Dashboard r03_claude_fd_html_a2 {
  title: 'TheLook Business Review'
  description: 'Branded monthly business review: Net Sales, Orders, AOV and Gross Margin with month-over-month change.'

  // Reporting period. Month-over-month compares it with the same range shifted back one month.
  block f_period: FilterBlock {
    label: 'Reporting period'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: ref('thelook_order_items', 'created_at')
    }
    default {
      operator: 'matches'
      value: 'last month'
    }
    theme {
      background { bg_color: 'transparent' }
      border { border_width: 0 }
      padding: 0
      label { font_family: 'Manrope' font_weight: 'semibold' font_color: '#5B6477' }
    }
  }

  block kpi_net_sales: VizBlock {
    label: 'Net Sales'
    settings { hide_label: true }
    theme {
      background { bg_color: 'transparent' }
      border { border_width: 0 }
      padding: 0
    }
    viz: MarkdownViz {
      dataset: thelook
      calculation prev {
        label: 'Previous'
        formula: @aql net_sales | relative_period(thelook_order_items.created_at, interval(-1 month)) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation mom {
        label: 'Change'
        formula: @aql abs(safe_divide(net_sales - (net_sales | relative_period(thelook_order_items.created_at, interval(-1 month))), net_sales | relative_period(thelook_order_items.created_at, interval(-1 month)))) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation dir {
        label: 'Direction'
        formula: @aql case(when: net_sales >= (net_sales | relative_period(thelook_order_items.created_at, interval(-1 month))), then: "up", else: "down") ;;
        calc_type: 'measure'
        data_type: 'text'
      }
      values: [
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Value'
          format { type: 'number' pattern: '[$$]#,###0' }
        },
        VizFieldFull {
          ref: 'prev'
          label: 'Previous'
          format { type: 'number' pattern: '[$$]#,###0' }
        },
        VizFieldFull {
          ref: 'mom'
          label: 'Change'
          format { type: 'number' pattern: '#,###0.0%' }
        },
        VizFieldFull {
          ref: 'dir'
          label: 'Direction'
          format { type: 'text' }
        }
      ]
      content: @md
<style>
@import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;800&display=swap');
.tl-kpi { font-family: 'Manrope', Arial, sans-serif; background: #FFFFFF; border-radius: 16px; padding: 20px 22px; height: 100%; box-sizing: border-box; border: 1px solid rgba(27,31,59,0.08); box-shadow: 0 1px 2px rgba(27,31,59,0.06); display: flex; flex-direction: column; gap: 10px; }
.tl-kpi__head { display: flex; align-items: center; gap: 10px; }
.tl-kpi__icon { width: 36px; height: 36px; border-radius: 10px; background: rgba(255,107,90,0.14); color: #FF6B5A; display: flex; align-items: center; justify-content: center; flex: none; }
.tl-kpi__icon svg { width: 20px; height: 20px; }
.tl-kpi__label { color: #5B6477; font-size: 13px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; }
.tl-kpi__value { color: #1B1F3B; font-size: 34px; font-weight: 800; letter-spacing: -0.02em; line-height: 1.1; font-variant-numeric: tabular-nums; }
.tl-kpi__foot { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; color: #5B6477; font-size: 13px; font-weight: 400; }
.tl-badge { display: inline-flex; align-items: center; gap: 4px; padding: 3px 9px; border-radius: 999px; font-size: 13px; font-weight: 600; font-variant-numeric: tabular-nums; }
.tl-badge.up { background: rgba(31,158,143,0.12); color: #1F9E8F; }
.tl-badge.up::before { content: '▲'; font-size: 10px; }
.tl-badge.down { background: rgba(214,69,69,0.12); color: #D64545; }
.tl-badge.down::before { content: '▼'; font-size: 10px; }
</style>
<div class="tl-kpi">
<div class="tl-kpi__head"><span class="tl-kpi__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></span><span class="tl-kpi__label">Net Sales</span></div>
<div class="tl-kpi__value">{{ rows[0].values.`Value`.formatted }}</div>
<div class="tl-kpi__foot"><span class="tl-badge {{ rows[0].values.`Direction`.raw }}">{{ rows[0].values.`Change`.formatted }}</span><span>vs {{ rows[0].values.`Previous`.formatted }} prior month</span></div>
</div>
;;
    }
  }

  block kpi_orders: VizBlock {
    label: 'Orders'
    settings { hide_label: true }
    theme {
      background { bg_color: 'transparent' }
      border { border_width: 0 }
      padding: 0
    }
    viz: MarkdownViz {
      dataset: thelook
      calculation prev {
        label: 'Previous'
        formula: @aql total_orders | relative_period(thelook_order_items.created_at, interval(-1 month)) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation mom {
        label: 'Change'
        formula: @aql abs(safe_divide(total_orders - (total_orders | relative_period(thelook_order_items.created_at, interval(-1 month))), total_orders | relative_period(thelook_order_items.created_at, interval(-1 month)))) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation dir {
        label: 'Direction'
        formula: @aql case(when: total_orders >= (total_orders | relative_period(thelook_order_items.created_at, interval(-1 month))), then: "up", else: "down") ;;
        calc_type: 'measure'
        data_type: 'text'
      }
      values: [
        VizFieldFull {
          ref: r(thelook.total_orders)
          label: 'Value'
          format { type: 'number' pattern: '#,###0' }
        },
        VizFieldFull {
          ref: 'prev'
          label: 'Previous'
          format { type: 'number' pattern: '#,###0' }
        },
        VizFieldFull {
          ref: 'mom'
          label: 'Change'
          format { type: 'number' pattern: '#,###0.0%' }
        },
        VizFieldFull {
          ref: 'dir'
          label: 'Direction'
          format { type: 'text' }
        }
      ]
      content: @md
<style>
