    }
  }

  block kpi_gross_margin: VizBlock {
    label: 'Gross Margin'
    settings { hide_label: true }
    theme {
      background { bg_color: 'transparent' }
      border { border_width: 0 }
      padding: 0
    }
    viz: MarkdownViz {
      dataset: thelook
      calculation prev {
        label: 'Previous'
        formula: @aql gross_margin | relative_period(thelook_order_items.created_at, interval(-1 month)) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      // Margin is already a ratio, so its change is shown in percentage points.
      calculation mom {
        label: 'Change'
        formula: @aql abs(gross_margin - (gross_margin | relative_period(thelook_order_items.created_at, interval(-1 month)))) * 100 ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation dir {
        label: 'Direction'
        formula: @aql case(when: gross_margin >= (gross_margin | relative_period(thelook_order_items.created_at, interval(-1 month))), then: "up", else: "down") ;;
        calc_type: 'measure'
        data_type: 'text'
      }
      values: [
        VizFieldFull {
          ref: r(thelook.gross_margin)
          label: 'Value'
          format { type: 'number' pattern: '#,###0.0%' }
        },
        VizFieldFull {
          ref: 'prev'
          label: 'Previous'
          format { type: 'number' pattern: '#,###0.0%' }
        },
        VizFieldFull {
          ref: 'mom'
          label: 'Change'
          format { type: 'number' pattern: '#,###0.0' }
        },
        VizFieldFull {
          ref: 'dir'
          label: 'Direction'
          format { type: 'text' }
        }
      ]
      content: @md
<style>
@import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;800&display=swap');
.tl-kpi { font-family: 'Manrope', Arial, sans-serif; background: #FFFFFF; border-radius: 16px; padding: 20px 22px; height: 100%; box-sizing: border-box; border: 1px solid rgba(27,31,59,0.08); box-shadow: 0 1px 2px rgba(27,31,59,0.06); display: flex; flex-direction: column; gap: 10px; }
.tl-kpi__head { display: flex; align-items: center; gap: 10px; }
.tl-kpi__icon { width: 36px; height: 36px; border-radius: 10px; background: rgba(255,107,90,0.14); color: #FF6B5A; display: flex; align-items: center; justify-content: center; flex: none; }
.tl-kpi__icon svg { width: 20px; height: 20px; }
.tl-kpi__label { color: #5B6477; font-size: 13px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; }
.tl-kpi__value { color: #1B1F3B; font-size: 34px; font-weight: 800; letter-spacing: -0.02em; line-height: 1.1; font-variant-numeric: tabular-nums; }
.tl-kpi__foot { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; color: #5B6477; font-size: 13px; font-weight: 400; }
.tl-badge { display: inline-flex; align-items: center; gap: 4px; padding: 3px 9px; border-radius: 999px; font-size: 13px; font-weight: 600; font-variant-numeric: tabular-nums; }
.tl-badge.up { background: rgba(31,158,143,0.12); color: #1F9E8F; }
.tl-badge.up::before { content: '▲'; font-size: 10px; }
.tl-badge.down { background: rgba(214,69,69,0.12); color: #D64545; }
.tl-badge.down::before { content: '▼'; font-size: 10px; }
</style>
<div class="tl-kpi">
<div class="tl-kpi__head"><span class="tl-kpi__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="5" x2="5" y2="19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg></span><span class="tl-kpi__label">Gross Margin</span></div>
<div class="tl-kpi__value">{{ rows[0].values.`Value`.formatted }}</div>
<div class="tl-kpi__foot"><span class="tl-badge {{ rows[0].values.`Direction`.raw }}">{{ rows[0].values.`Change`.formatted }} pts</span><span>vs {{ rows[0].values.`Previous`.formatted }} prior month</span></div>
</div>
;;
    }
  }

  theme: PageTheme {
    background { bg_color: '#F5EFE6' }
  }

  view: HTMLLayout {
    content: @html
<style>
@import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;800&display=swap');
.tl-page { font-family: 'Manrope', Arial, sans-serif; background: #F5EFE6; color: #1B1F3B; min-height: 100%; padding: 28px 32px 40px; box-sizing: border-box; }
.tl-header { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; flex-wrap: wrap; padding-bottom: 20px; border-bottom: 3px solid #FF6B5A; }
.tl-brand { display: flex; flex-direction: column; gap: 14px; }
.tl-brand img { width: 176px; height: 40px; display: block; }
.tl-eyebrow { color: #FF6B5A; font-size: 12px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; margin: 0 0 4px; }
.tl-title { color: #1B1F3B; font-size: 32px; font-weight: 800; letter-spacing: -0.02em; line-height: 1.1; margin: 0; }
.tl-sub { color: #5B6477; font-size: 14px; font-weight: 400; margin: 6px 0 0; }
.tl-filter { width: 280px; height: 72px; }
.tl-section { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin: 28px 0 14px; }
.tl-section h2 { color: #1B1F3B; font-size: 18px; font-weight: 800; margin: 0; }
.tl-section p { color: #5B6477; font-size: 13px; font-weight: 400; margin: 0; }
.tl-legend { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; }
.tl-legend .up { color: #1F9E8F; }
.tl-legend .down { color: #D64545; }
.tl-kpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
.tl-kpis > div { height: 170px; }
@media (max-width: 1100px) { .tl-kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 600px) { .tl-kpis { grid-template-columns: 1fr; } .tl-page { padding: 20px 16px; } }
</style>
<div class="tl-page">
<header class="tl-header">
<div class="tl-brand">
<img alt="thelook" src="data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='176' height='40' viewBox='0 0 176 40'%3E%3Ccircle cx='18' cy='20' r='11' fill='%23FF6B5A'/%3E%3Ccircle cx='18' cy='20' r='4.5' fill='%23F5EFE6'/%3E%3Ctext x='38' y='28' font-family='Manrope, Arial, sans-serif' font-size='24' font-weight='800' letter-spacing='-0.5' fill='%231B1F3B'%3Ethelook%3C/text%3E%3C/svg%3E" />
<div>
<p class="tl-eyebrow">Monthly business review</p>
<h1 class="tl-title">Sales performance</h1>
<p class="tl-sub">Net sales exclude cancelled and returned items.</p>
</div>
</div>
<div class="tl-filter"><h-block name="f_period" /></div>
</header>
<section>
<div class="tl-section">
<h2>Headline KPIs</h2>
<p><span class="tl-legend"><span class="up">▲</span> up <span class="down">▼</span> down</span> &middot; vs the same period one month earlier</p>
</div>
<div class="tl-kpis">
<div><h-block name="kpi_net_sales" /></div>
<div><h-block name="kpi_orders" /></div>
<div><h-block name="kpi_aov" /></div>
<div><h-block name="kpi_gross_margin" /></div>
</div>
</section>
</div>
;;
  }
}
