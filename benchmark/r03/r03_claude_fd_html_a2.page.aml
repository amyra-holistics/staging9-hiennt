<div class="tl-kpi__foot"><span class="tl-badge {{ rows[0].values.`Direction`.raw }}">{{ rows[0].values.`Change`.formatted }}</span><span>vs {{ rows[0].values.`Previous`.formatted }} prior month</span></div>
