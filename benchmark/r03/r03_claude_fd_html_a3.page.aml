Dashboard r03_claude_fd_html_a3 {
  title: 'TheLook Business Review'
  description: 'Branded monthly business review: last full month compared with the month before.'

  block period: VizBlock {
    label: 'Review period'
    viz: MarkdownViz {
      dataset: thelook
      calculation cur_month {
        label: 'Current Month'
        formula: @aql max(thelook_orders.created_at) | where(thelook_orders.created_at matches @(last month));;
        calc_type: 'measure'
        data_type: 'datetime'
      }
      calculation prev_month {
        label: 'Previous Month'
        formula: @aql max(thelook_orders.created_at) | where(thelook_orders.created_at matches @(2 months ago));;
        calc_type: 'measure'
        data_type: 'datetime'
      }
      values: [
        VizFieldFull {
          ref: 'cur_month'
          label: 'Current Month'
          format {
            type: 'datetime'
            pattern: 'LLLL yyyy'
          }
        },
        VizFieldFull {
          ref: 'prev_month'
          label: 'Previous Month'
          format {
            type: 'datetime'
            pattern: 'LLL yyyy'
          }
        }
      ]
      content: @md
<style>
.tl-period-md { font-family: 'Manrope', Arial, sans-serif; color: #F5EFE6; line-height: 1.25; text-align: right; }
.tl-period-md .k { font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #FF6B5A; }
.tl-period-md .m { font-size: 20px; font-weight: 800; color: #FFFFFF; }
.tl-period-md .c { font-size: 12px; font-weight: 400; color: #C9CCD8; }
</style>
<div class="tl-period-md"><div class="k">Review month</div><div class="m">{{ rows[0].values.`Current Month`.formatted }}</div><div class="c">compared with {{ rows[0].values.`Previous Month`.formatted }}</div></div>
      ;;
    }
    settings {
      hide_label: true
      hide_controls: true
    }
  }

  block kpi_net_sales: VizBlock {
    label: 'Net Sales'
    viz: MarkdownViz {
      dataset: thelook
      calculation cur {
        label: 'Current'
        formula: @aql net_sales | where(thelook_orders.created_at matches @(last month));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation prev {
        label: 'Previous'
        formula: @aql net_sales | where(thelook_orders.created_at matches @(2 months ago));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation chg {
        label: 'Change'
        formula: @aql abs(safe_divide(cur - prev, prev));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation dir {
        label: 'Direction'
        formula: @aql case(when: cur >= prev, then: 'up', else: 'down');;
        calc_type: 'measure'
        data_type: 'text'
      }
      values: [
        VizFieldFull {
          ref: 'cur'
          label: 'Current'
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
        },
        VizFieldFull {
          ref: 'prev'
          label: 'Previous'
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
        },
        VizFieldFull {
          ref: 'chg'
          label: 'Change'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        },
        VizFieldFull {
          ref: 'dir'
          label: 'Direction'
          format {
            type: 'text'
          }
        }
      ]
      content: @md
<style>
.tl-kpi-md { font-family: 'Manrope', Arial, sans-serif; color: #1B1F3B; }
.tl-kpi-md .v { font-size: 34px; font-weight: 800; letter-spacing: -0.02em; line-height: 1.1; }
.tl-kpi-md .row { display: flex; align-items: center; gap: 8px; margin-top: 10px; flex-wrap: wrap; }
.tl-kpi-md .b { display: inline-flex; align-items: center; gap: 4px; padding: 3px 9px; border-radius: 999px; font-size: 12px; font-weight: 600; }
.tl-kpi-md .b.up { color: #1F9E8F; background: rgba(31, 158, 143, 0.12); }
.tl-kpi-md .b.down { color: #D64545; background: rgba(214, 69, 69, 0.12); }
.tl-kpi-md .b.up::before { content: '▲'; font-size: 9px; }
.tl-kpi-md .b.down::before { content: '▼'; font-size: 9px; }
.tl-kpi-md .p { font-size: 12px; font-weight: 400; color: #5B6477; }
</style>
<div class="tl-kpi-md"><div class="v">{{ rows[0].values.`Current`.formatted }}</div><div class="row"><span class="b {{ rows[0].values.`Direction`.raw }}">{{ rows[0].values.`Change`.formatted }} MoM</span><span class="p">vs {{ rows[0].values.`Previous`.formatted }}</span></div></div>
      ;;
    }
    settings {
      hide_label: true
      hide_controls: true
    }
  }

  block kpi_orders: VizBlock {
    label: 'Orders'
    viz: MarkdownViz {
      dataset: thelook
      calculation cur {
        label: 'Current'
        formula: @aql total_orders | where(thelook_orders.created_at matches @(last month));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation prev {
        label: 'Previous'
        formula: @aql total_orders | where(thelook_orders.created_at matches @(2 months ago));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation chg {
        label: 'Change'
        formula: @aql abs(safe_divide(cur - prev, prev));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation dir {
        label: 'Direction'
        formula: @aql case(when: cur >= prev, then: 'up', else: 'down');;
        calc_type: 'measure'
        data_type: 'text'
      }
      values: [
        VizFieldFull {
          ref: 'cur'
          label: 'Current'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: 'prev'
          label: 'Previous'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: 'chg'
          label: 'Change'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        },
        VizFieldFull {
          ref: 'dir'
          label: 'Direction'
          format {
            type: 'text'
          }
        }
      ]
      content: @md
<style>
.tl-kpi-md { font-family: 'Manrope', Arial, sans-serif; color: #1B1F3B; }
.tl-kpi-md .v { font-size: 34px; font-weight: 800; letter-spacing: -0.02em; line-height: 1.1; }
.tl-kpi-md .row { display: flex; align-items: center; gap: 8px; margin-top: 10px; flex-wrap: wrap; }
.tl-kpi-md .b { display: inline-flex; align-items: center; gap: 4px; padding: 3px 9px; border-radius: 999px; font-size: 12px; font-weight: 600; }
.tl-kpi-md .b.up { color: #1F9E8F; background: rgba(31, 158, 143, 0.12); }
.tl-kpi-md .b.down { color: #D64545; background: rgba(214, 69, 69, 0.12); }
.tl-kpi-md .b.up::before { content: '▲'; font-size: 9px; }
.tl-kpi-md .b.down::before { content: '▼'; font-size: 9px; }
.tl-kpi-md .p { font-size: 12px; font-weight: 400; color: #5B6477; }
</style>
<div class="tl-kpi-md"><div class="v">{{ rows[0].values.`Current`.formatted }}</div><div class="row"><span class="b {{ rows[0].values.`Direction`.raw }}">{{ rows[0].values.`Change`.formatted }} MoM</span><span class="p">vs {{ rows[0].values.`Previous`.formatted }}</span></div></div>
      ;;
    }
    settings {
      hide_label: true
      hide_controls: true
    }
  }

  block kpi_aov: VizBlock {
    label: 'Average Order Value'
    viz: MarkdownViz {
      dataset: thelook
      calculation cur {
        label: 'Current'
        formula: @aql aov | where(thelook_orders.created_at matches @(last month));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation prev {
        label: 'Previous'
        formula: @aql aov | where(thelook_orders.created_at matches @(2 months ago));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation chg {
        label: 'Change'
        formula: @aql abs(safe_divide(cur - prev, prev));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation dir {
        label: 'Direction'
        formula: @aql case(when: cur >= prev, then: 'up', else: 'down');;
        calc_type: 'measure'
        data_type: 'text'
      }
      values: [
        VizFieldFull {
          ref: 'cur'
          label: 'Current'
          format {
            type: 'number'
            pattern: '[$$]#,###0.00'
          }
        },
        VizFieldFull {
          ref: 'prev'
          label: 'Previous'
          format {
            type: 'number'
            pattern: '[$$]#,###0.00'
          }
        },
        VizFieldFull {
          ref: 'chg'
          label: 'Change'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        },
        VizFieldFull {
          ref: 'dir'
          label: 'Direction'
          format {
            type: 'text'
          }
        }
      ]
      content: @md
<style>
.tl-kpi-md { font-family: 'Manrope', Arial, sans-serif; color: #1B1F3B; }
.tl-kpi-md .v { font-size: 34px; font-weight: 800; letter-spacing: -0.02em; line-height: 1.1; }
.tl-kpi-md .row { display: flex; align-items: center; gap: 8px; margin-top: 10px; flex-wrap: wrap; }
.tl-kpi-md .b { display: inline-flex; align-items: center; gap: 4px; padding: 3px 9px; border-radius: 999px; font-size: 12px; font-weight: 600; }
.tl-kpi-md .b.up { color: #1F9E8F; background: rgba(31, 158, 143, 0.12); }
.tl-kpi-md .b.down { color: #D64545; background: rgba(214, 69, 69, 0.12); }
.tl-kpi-md .b.up::before { content: '▲'; font-size: 9px; }
.tl-kpi-md .b.down::before { content: '▼'; font-size: 9px; }
.tl-kpi-md .p { font-size: 12px; font-weight: 400; color: #5B6477; }
</style>
<div class="tl-kpi-md"><div class="v">{{ rows[0].values.`Current`.formatted }}</div><div class="row"><span class="b {{ rows[0].values.`Direction`.raw }}">{{ rows[0].values.`Change`.formatted }} MoM</span><span class="p">vs {{ rows[0].values.`Previous`.formatted }}</span></div></div>
      ;;
    }
    settings {
      hide_label: true
      hide_controls: true
    }
  }

  block kpi_gross_margin: VizBlock {
    label: 'Gross Margin'
    viz: MarkdownViz {
      dataset: thelook
      calculation cur {
        label: 'Current'
        formula: @aql gross_margin | where(thelook_orders.created_at matches @(last month));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation prev {
        label: 'Previous'
        formula: @aql gross_margin | where(thelook_orders.created_at matches @(2 months ago));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation chg_pts {
        label: 'Change'
        formula: @aql abs(cur - prev) * 100;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation dir {
        label: 'Direction'
        formula: @aql case(when: cur >= prev, then: 'up', else: 'down');;
        calc_type: 'measure'
        data_type: 'text'
      }
      values: [
        VizFieldFull {
          ref: 'cur'
          label: 'Current'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        },
        VizFieldFull {
          ref: 'prev'
          label: 'Previous'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        },
        VizFieldFull {
          ref: 'chg_pts'
          label: 'Change'
          format {
            type: 'number'
            pattern: '#,###0.0'
          }
        },
        VizFieldFull {
          ref: 'dir'
          label: 'Direction'
          format {
            type: 'text'
          }
        }
      ]
      content: @md
<style>
.tl-kpi-md { font-family: 'Manrope', Arial, sans-serif; color: #1B1F3B; }
.tl-kpi-md .v { font-size: 34px; font-weight: 800; letter-spacing: -0.02em; line-height: 1.1; }
.tl-kpi-md .row { display: flex; align-items: center; gap: 8px; margin-top: 10px; flex-wrap: wrap; }
.tl-kpi-md .b { display: inline-flex; align-items: center; gap: 4px; padding: 3px 9px; border-radius: 999px; font-size: 12px; font-weight: 600; }
.tl-kpi-md .b.up { color: #1F9E8F; background: rgba(31, 158, 143, 0.12); }
.tl-kpi-md .b.down { color: #D64545; background: rgba(214, 69, 69, 0.12); }
.tl-kpi-md .b.up::before { content: '▲'; font-size: 9px; }
.tl-kpi-md .b.down::before { content: '▼'; font-size: 9px; }
.tl-kpi-md .p { font-size: 12px; font-weight: 400; color: #5B6477; }
</style>
<div class="tl-kpi-md"><div class="v">{{ rows[0].values.`Current`.formatted }}</div><div class="row"><span class="b {{ rows[0].values.`Direction`.raw }}">{{ rows[0].values.`Change`.formatted }} pts MoM</span><span class="p">vs {{ rows[0].values.`Previous`.formatted }}</span></div></div>
      ;;
    }
    settings {
      hide_label: true
      hide_controls: true
    }
  }

  block net_sales_trend: VizBlock {
    label: 'Net Sales, last 12 months'
    viz: ColumnChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_orders.created_at)
        label: 'Month'
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#1B1F3B'
          }
        }
      }
      filter {
        field: r(thelook_orders.created_at)
        operator: 'last'
        value: 12
        modifier: 'month'
        options {
          include_current_period: false
        }
      }
      settings {
        legend_label: 'hidden'
        x_axis_label: 'Month'
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
    settings {
      hide_label: true
    }
  }

  view: HTMLLayout {
    content: @html
      <style>
        @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;800&display=swap');

        .tl {
          --ink: #1B1F3B;
          --coral: #FF6B5A;
          --sand: #F5EFE6;
          --teal: #1F9E8F;
          --alert: #D64545;
          --slate: #5B6477;
          font-family: 'Manrope', Arial, sans-serif;
          font-weight: 400;
          color: var(--ink);
          background: var(--sand);
          min-height: 100%;
          padding: 28px 32px 36px;
          box-sizing: border-box;
        }
        .tl *, .tl *::before, .tl *::after { box-sizing: border-box; }

        .tl-head {
          display: flex;
          align-items: stretch;
          background: #FFFFFF;
          border-radius: 18px;
          overflow: hidden;
          box-shadow: 0 1px 2px rgba(27, 31, 59, 0.06);
        }
        .tl-head-brand {
          display: flex;
          align-items: center;
          gap: 24px;
          flex: 1;
          padding: 22px 28px;
          border-left: 6px solid var(--coral);
        }
        .tl-head-brand img { height: 40px; width: 176px; display: block; }
        .tl-head-rule { width: 1px; align-self: stretch; background: #E7E1D6; }
        .tl-eyebrow {
          font-size: 11px;
          font-weight: 600;
          letter-spacing: 0.1em;
          text-transform: uppercase;
          color: var(--coral);
        }
        .tl h1 {
          margin: 2px 0 0;
          font-size: 26px;
          font-weight: 800;
          letter-spacing: -0.02em;
          color: var(--ink);
        }
        .tl-head-period {
          width: 260px;
          padding: 14px 28px;
          background: var(--ink);
        }

        .tl-kpis {
          display: grid;
          grid-template-columns: repeat(4, minmax(0, 1fr));
          gap: 16px;
          margin-top: 20px;
        }
        .tl-card {
          background: #FFFFFF;
          border-radius: 18px;
          padding: 20px 22px 16px;
          box-shadow: 0 1px 2px rgba(27, 31, 59, 0.06);
        }
        .tl-card-top { display: flex; align-items: center; gap: 12px; }
        .tl-icon {
          width: 40px;
          height: 40px;
          border-radius: 12px;
          background: var(--ink);
          display: flex;
          align-items: center;
          justify-content: center;
          flex: none;
        }
        .tl-icon img { width: 20px; height: 20px; display: block; }
        .tl-card-label { font-size: 14px; font-weight: 600; color: var(--ink); }
        .tl-card-sub { font-size: 12px; font-weight: 400; color: var(--slate); }
        .tl-card-body { height: 96px; margin-top: 14px; }

        .tl-panel {
          margin-top: 20px;
          background: #FFFFFF;
          border-radius: 18px;
          padding: 20px 22px 12px;
          box-shadow: 0 1px 2px rgba(27, 31, 59, 0.06);
        }
        .tl h2 {
          margin: 0;
          font-size: 17px;
          font-weight: 800;
          color: var(--ink);
        }
        .tl-panel-sub { margin-top: 2px; font-size: 12px; color: var(--slate); }
        .tl-chart { height: 320px; margin-top: 8px; }

        .tl-foot { margin-top: 14px; font-size: 12px; color: var(--slate); }

        @media (max-width: 1100px) {
          .tl-kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        }
        @media (max-width: 640px) {
          .tl { padding: 16px; }
          .tl-kpis { grid-template-columns: 1fr; }
          .tl-head { flex-direction: column; }
          .tl-head-brand { flex-wrap: wrap; gap: 12px; }
          .tl-head-rule { display: none; }
          .tl-head-period { width: auto; }
        }
      </style>

      <div class="tl">
        <header class="tl-head">
          <div class="tl-head-brand">
            <img alt="thelook" src="data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='176' height='40' viewBox='0 0 176 40'%3E%3Ccircle cx='18' cy='20' r='11' fill='%23FF6B5A'/%3E%3Ccircle cx='18' cy='20' r='4.5' fill='%23F5EFE6'/%3E%3Ctext x='38' y='28' font-family='Manrope, Arial, sans-serif' font-size='24' font-weight='800' letter-spacing='-0.5' fill='%231B1F3B'%3Ethelook%3C/text%3E%3C/svg%3E" />
            <div class="tl-head-rule"></div>
            <div>
              <div class="tl-eyebrow">Business Review</div>
              <h1>Monthly performance</h1>
            </div>
          </div>
          <div class="tl-head-period">
            <h-block name="period" />
          </div>
        </header>

        <section class="tl-kpis">
          <div class="tl-card">
            <div class="tl-card-top">
              <div class="tl-icon">
                <img alt="" src="data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%23FF6B5A' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M12 2v20'/%3E%3Cpath d='M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6'/%3E%3C/svg%3E" />
              </div>
              <div>
                <div class="tl-card-label">Net Sales</div>
                <div class="tl-card-sub">Excl. cancelled and returned</div>
              </div>
            </div>
            <div class="tl-card-body"><h-block name="kpi_net_sales" /></div>
          </div>

          <div class="tl-card">
            <div class="tl-card-top">
              <div class="tl-icon">
                <img alt="" src="data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%23FF6B5A' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z'/%3E%3Cpath d='M3 6h18'/%3E%3Cpath d='M16 10a4 4 0 0 1-8 0'/%3E%3C/svg%3E" />
              </div>
              <div>
                <div class="tl-card-label">Orders</div>
                <div class="tl-card-sub">All order statuses</div>
              </div>
            </div>
            <div class="tl-card-body"><h-block name="kpi_orders" /></div>
          </div>

          <div class="tl-card">
            <div class="tl-card-top">
              <div class="tl-icon">
                <img alt="" src="data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%23FF6B5A' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z'/%3E%3Cpath d='M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8'/%3E%3Cpath d='M12 17.5v-11'/%3E%3C/svg%3E" />
              </div>
              <div>
                <div class="tl-card-label">AOV</div>
                <div class="tl-card-sub">Net Sales per fulfilled order</div>
              </div>
            </div>
            <div class="tl-card-body"><h-block name="kpi_aov" /></div>
          </div>

          <div class="tl-card">
            <div class="tl-card-top">
              <div class="tl-icon">
                <img alt="" src="data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%23FF6B5A' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M19 5 5 19'/%3E%3Ccircle cx='6.5' cy='6.5' r='2.5'/%3E%3Ccircle cx='17.5' cy='17.5' r='2.5'/%3E%3C/svg%3E" />
              </div>
              <div>
                <div class="tl-card-label">Gross Margin</div>
                <div class="tl-card-sub">Gross Profit / Net Sales</div>
              </div>
            </div>
            <div class="tl-card-body"><h-block name="kpi_gross_margin" /></div>
          </div>
        </section>

        <section class="tl-panel">
          <h2>Net Sales, last 12 months</h2>
          <div class="tl-panel-sub">Full months only, by order date</div>
          <div class="tl-chart"><h-block name="net_sales_trend" /></div>
        </section>

        <div class="tl-foot">MoM compares the last full month with the month before, by order date. Gross Margin change is shown in percentage points.</div>
      </div>
    ;;
  }

  theme: PageTheme {
    background {
      bg_color: '#F5EFE6'
    }
    block {
      label {
        font_family: 'Manrope, Arial, sans-serif'
        font_color: '#1B1F3B'
      }
      text {
        font_family: 'Manrope, Arial, sans-serif'
        font_color: '#1B1F3B'
      }
      background {
        bg_color: 'transparent'
      }
      border {
        border_width: 0
      }
      padding: 0
      shadow: 'none'
    }
    custom_css: @css
      @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;800&display=swap');
    ;;
  }
}
