PageTheme thelook_brand {
  background {
    bg_color: '#F5EFE6'
  }
  block {
    label {
      font_family: 'Manrope'
      font_color: '#1B1F3B'
      font_weight: 'extrabold'
    }
    text {
      font_family: 'Manrope'
      font_color: '#5B6477'
    }
    background {
      bg_color: 'transparent'
    }
    border {
      border_width: 0
    }
    shadow: 'none'
    padding: 0
  }
  custom_css: @css
    @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;800&display=swap');

    .h-kpi-metric-label {
      font-family: 'Manrope', Arial, sans-serif;
      font-weight: 600;
      color: #5B6477;
    }
    .h-kpi-metric-kpi {
      font-family: 'Manrope', Arial, sans-serif;
      font-weight: 800;
      color: #1B1F3B;
      letter-spacing: -0.5px;
    }
    .h-kpi-metric-diff .friendly-diff {
      font-family: 'Manrope', Arial, sans-serif;
      font-weight: 600;
      border-radius: 999px;
      padding: 2px 10px;
    }
    .h-kpi-metric-diff .friendly-diff:not(.negative) {
      background: rgba(31, 158, 143, 0.12);
      color: #1F9E8F;
    }
    .h-kpi-metric-diff .friendly-diff.negative {
      background: rgba(214, 69, 69, 0.12);
      color: #D64545;
    }
  ;;
}

Dashboard r03_claude_html_a1 {
  title: 'TheLook Business Review'
  description: 'Branded monthly business review: Net Sales, Orders, AOV and Gross Margin with month-over-month change.'
  owner: 'thinh.nt@holistics.io'
  theme: thelook_brand

  block f_month: FilterBlock {
    label: 'Review month'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_orders.created_at)
    }
    default {
      operator: 'matches'
      value: 'last month'
    }
  }

  block kpi_net_sales: VizBlock {
    label: 'Net Sales'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_orders.created_at)
        show_growth_rate: true
        value {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        label {
          font_size: 14
        }
        metric_value {
          font_size: 34
        }
      }
    }
  }

  block kpi_orders: VizBlock {
    label: 'Orders'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.total_orders)
        label: 'Orders'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_orders.created_at)
        show_growth_rate: true
        value {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        label {
          font_size: 14
        }
        metric_value {
          font_size: 34
        }
      }
    }
  }

  block kpi_aov: VizBlock {
    label: 'AOV'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'AOV'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_orders.created_at)
        show_growth_rate: true
        value {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        label {
          font_size: 14
        }
        metric_value {
          font_size: 34
        }
      }
    }
  }

  block kpi_gross_margin: VizBlock {
    label: 'Gross Margin'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_orders.created_at)
        show_growth_rate: true
        value {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        label {
          font_size: 14
        }
        metric_value {
          font_size: 34
        }
      }
    }
  }

  view: HTMLLayout {
    content: @html
      <style>
        .tl-page {
          font-family: 'Manrope', Arial, sans-serif;
          font-weight: 400;
          color: #1B1F3B;
          background: #F5EFE6;
          padding: 28px 32px 36px;
          display: flex;
          flex-direction: column;
          gap: 24px;
        }
        .tl-header {
          background: #FFFFFF;
          border-radius: 16px;
          border-top: 5px solid #FF6B5A;
          box-shadow: 0 1px 2px rgba(27, 31, 59, 0.06);
          padding: 20px 28px;
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 24px;
          flex-wrap: wrap;
        }
        .tl-brand {
          display: flex;
          align-items: center;
          gap: 20px;
        }
        .tl-logo {
          height: 40px;
          width: 176px;
          display: block;
        }
        .tl-divider {
          width: 1px;
          height: 40px;
          background: #E4DCCF;
        }
        .tl-title {
          margin: 0;
          font-size: 24px;
          font-weight: 800;
          color: #1B1F3B;
          letter-spacing: -0.4px;
        }
        .tl-subtitle {
          margin: 2px 0 0;
          font-size: 13px;
          font-weight: 600;
          color: #5B6477;
        }
        .tl-filter {
          min-width: 240px;
        }
        .tl-section-title {
          margin: 0;
          font-size: 13px;
          font-weight: 800;
          letter-spacing: 1.2px;
          text-transform: uppercase;
          color: #5B6477;
        }
        .tl-kpis {
          display: grid;
          grid-template-columns: repeat(4, minmax(0, 1fr));
          gap: 20px;
        }
        .tl-card {
          background: #FFFFFF;
          border-radius: 16px;
          box-shadow: 0 1px 2px rgba(27, 31, 59, 0.06);
          padding: 20px 22px;
          display: flex;
          align-items: flex-start;
          gap: 16px;
          min-height: 140px;
        }
        .tl-icon {
          flex: 0 0 44px;
          width: 44px;
          height: 44px;
          border-radius: 12px;
          background: #1B1F3B;
          display: flex;
          align-items: center;
          justify-content: center;
        }
        .tl-icon svg {
          width: 22px;
          height: 22px;
        }
        .tl-kpi {
          flex: 1 1 auto;
          min-width: 0;
          height: 110px;
        }
        .tl-footer {
          font-size: 12px;
          color: #5B6477;
        }
        .tl-footer strong {
          font-weight: 600;
          color: #1B1F3B;
        }
        @media (max-width: 1100px) {
          .tl-kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        }
        @media (max-width: 640px) {
          .tl-kpis { grid-template-columns: 1fr; }
          .tl-divider { display: none; }
        }
      </style>

      <div class="tl-page">
        <header class="tl-header">
          <div class="tl-brand">
            <img class="tl-logo" alt="thelook" src="data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='176' height='40' viewBox='0 0 176 40'%3E%3Ccircle cx='18' cy='20' r='11' fill='%23FF6B5A'/%3E%3Ccircle cx='18' cy='20' r='4.5' fill='%23F5EFE6'/%3E%3Ctext x='38' y='28' font-family='Manrope, Arial, sans-serif' font-size='24' font-weight='800' letter-spacing='-0.5' fill='%231B1F3B'%3Ethelook%3C/text%3E%3C/svg%3E" />
            <div class="tl-divider"></div>
            <div>
              <h1 class="tl-title">Business Review</h1>
              <p class="tl-subtitle">Monthly performance vs. previous month</p>
            </div>
          </div>
          <div class="tl-filter">
            <h-block name="f_month" />
          </div>
        </header>

        <h2 class="tl-section-title">Key metrics</h2>

        <section class="tl-kpis">
          <div class="tl-card">
            <div class="tl-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="#FF6B5A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="2" x2="12" y2="22"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </div>
            <div class="tl-kpi"><h-block name="kpi_net_sales" /></div>
          </div>

          <div class="tl-card">
            <div class="tl-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="#FF6B5A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            </div>
            <div class="tl-kpi"><h-block name="kpi_orders" /></div>
          </div>

          <div class="tl-card">
            <div class="tl-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="#FF6B5A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"/></svg>
            </div>
            <div class="tl-kpi"><h-block name="kpi_aov" /></div>
          </div>

          <div class="tl-card">
            <div class="tl-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="#FF6B5A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="5" x2="5" y2="19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg>
            </div>
            <div class="tl-kpi"><h-block name="kpi_gross_margin" /></div>
          </div>
        </section>

        <div class="tl-footer">
          <strong>Net Sales</strong> and <strong>AOV</strong> exclude Cancelled and Returned items. <strong>Orders</strong> counts every order. Badges show change vs. the previous month.
        </div>
      </div>
    ;;
  }
}
