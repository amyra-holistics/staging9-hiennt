Dashboard r03_claude_html_a2 {
  title: 'TheLook Business Review'
  description: 'Branded monthly business review: Net Sales, Orders, AOV and Gross Margin for the latest complete month vs. the prior month.'

  // KPI cards: latest complete month (last month) vs. the month before (2 months ago).
  // Order month (thelook_orders.created_at) is the period anchor for every KPI.

  block kpi_net_sales: VizBlock {
    label: 'Net Sales'
    settings {
      hide_label: true
      hide_controls: true
    }
    viz: MarkdownViz {
      dataset: thelook
      calculation cur {
        label: 'Current'
        formula: @aql net_sales | where(thelook_orders.created_at matches @(last month)) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation prev {
        label: 'Previous'
        formula: @aql net_sales | where(thelook_orders.created_at matches @(2 months ago)) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation mom {
        label: 'MoM'
        formula: @aql abs(safe_divide((net_sales | where(thelook_orders.created_at matches @(last month))) - (net_sales | where(thelook_orders.created_at matches @(2 months ago))), net_sales | where(thelook_orders.created_at matches @(2 months ago)))) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation dir {
        label: 'Direction'
        formula: @aql case(when: (net_sales | where(thelook_orders.created_at matches @(last month))) >= (net_sales | where(thelook_orders.created_at matches @(2 months ago))), then: 'up', else: 'down') ;;
        calc_type: 'measure'
        data_type: 'text'
      }
      values: [
        VizFieldFull { ref: 'cur', format { type: 'number', pattern: '[$$]#,###0' } },
        VizFieldFull { ref: 'prev', format { type: 'number', pattern: '[$$]#,###0' } },
        VizFieldFull { ref: 'mom', format { type: 'number', pattern: '#,###0.0%' } },
        VizFieldFull { ref: 'dir' }
      ]
      content: @md
<style>
  .tl-kpi { font-family: 'Manrope', Arial, sans-serif; color: #1B1F3B; }
  .tl-kpi__value { font-size: 34px; font-weight: 800; letter-spacing: -0.5px; line-height: 1.1; }
  .tl-kpi__meta { display: flex; align-items: center; gap: 8px; margin-top: 10px; flex-wrap: wrap; }
  .tl-badge { display: inline-flex; align-items: center; padding: 3px 10px; border-radius: 999px; font-size: 13px; font-weight: 600; }
  .tl-badge--up { background: rgba(31, 158, 143, 0.14); color: #1F9E8F; }
  .tl-badge--up::before { content: '▲'; font-size: 10px; margin-right: 5px; }
  .tl-badge--down { background: rgba(214, 69, 69, 0.12); color: #D64545; }
  .tl-badge--down::before { content: '▼'; font-size: 10px; margin-right: 5px; }
  .tl-kpi__vs { font-size: 13px; font-weight: 400; color: #5B6477; }
</style>
<div class="tl-kpi">
  <div class="tl-kpi__value">{{ rows[0].`Current`.formatted }}</div>
  <div class="tl-kpi__meta">
    <span class="tl-badge tl-badge--{{ rows[0].`Direction`.raw }}">{{ rows[0].`MoM`.formatted }} MoM</span>
    <span class="tl-kpi__vs">vs {{ rows[0].`Previous`.formatted }}</span>
  </div>
</div>
      ;;
    }
  }

  block kpi_orders: VizBlock {
    label: 'Orders'
    settings {
      hide_label: true
      hide_controls: true
    }
    viz: MarkdownViz {
      dataset: thelook
      calculation cur {
        label: 'Current'
        formula: @aql total_orders | where(thelook_orders.created_at matches @(last month)) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation prev {
        label: 'Previous'
        formula: @aql total_orders | where(thelook_orders.created_at matches @(2 months ago)) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation mom {
        label: 'MoM'
        formula: @aql abs(safe_divide((total_orders | where(thelook_orders.created_at matches @(last month))) - (total_orders | where(thelook_orders.created_at matches @(2 months ago))), total_orders | where(thelook_orders.created_at matches @(2 months ago)))) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation dir {
        label: 'Direction'
        formula: @aql case(when: (total_orders | where(thelook_orders.created_at matches @(last month))) >= (total_orders | where(thelook_orders.created_at matches @(2 months ago))), then: 'up', else: 'down') ;;
        calc_type: 'measure'
        data_type: 'text'
      }
      values: [
        VizFieldFull { ref: 'cur', format { type: 'number', pattern: '#,###0' } },
        VizFieldFull { ref: 'prev', format { type: 'number', pattern: '#,###0' } },
        VizFieldFull { ref: 'mom', format { type: 'number', pattern: '#,###0.0%' } },
        VizFieldFull { ref: 'dir' }
      ]
      content: @md
<style>
  .tl-kpi { font-family: 'Manrope', Arial, sans-serif; color: #1B1F3B; }
  .tl-kpi__value { font-size: 34px; font-weight: 800; letter-spacing: -0.5px; line-height: 1.1; }
  .tl-kpi__meta { display: flex; align-items: center; gap: 8px; margin-top: 10px; flex-wrap: wrap; }
  .tl-badge { display: inline-flex; align-items: center; padding: 3px 10px; border-radius: 999px; font-size: 13px; font-weight: 600; }
  .tl-badge--up { background: rgba(31, 158, 143, 0.14); color: #1F9E8F; }
  .tl-badge--up::before { content: '▲'; font-size: 10px; margin-right: 5px; }
  .tl-badge--down { background: rgba(214, 69, 69, 0.12); color: #D64545; }
  .tl-badge--down::before { content: '▼'; font-size: 10px; margin-right: 5px; }
  .tl-kpi__vs { font-size: 13px; font-weight: 400; color: #5B6477; }
</style>
<div class="tl-kpi">
  <div class="tl-kpi__value">{{ rows[0].`Current`.formatted }}</div>
  <div class="tl-kpi__meta">
    <span class="tl-badge tl-badge--{{ rows[0].`Direction`.raw }}">{{ rows[0].`MoM`.formatted }} MoM</span>
    <span class="tl-kpi__vs">vs {{ rows[0].`Previous`.formatted }}</span>
  </div>
</div>
      ;;
    }
  }

  block kpi_aov: VizBlock {
    label: 'AOV'
    settings {
      hide_label: true
      hide_controls: true
    }
    viz: MarkdownViz {
      dataset: thelook
      calculation cur {
        label: 'Current'
        formula: @aql aov | where(thelook_orders.created_at matches @(last month)) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation prev {
        label: 'Previous'
        formula: @aql aov | where(thelook_orders.created_at matches @(2 months ago)) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation mom {
        label: 'MoM'
        formula: @aql abs(safe_divide((aov | where(thelook_orders.created_at matches @(last month))) - (aov | where(thelook_orders.created_at matches @(2 months ago))), aov | where(thelook_orders.created_at matches @(2 months ago)))) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation dir {
        label: 'Direction'
        formula: @aql case(when: (aov | where(thelook_orders.created_at matches @(last month))) >= (aov | where(thelook_orders.created_at matches @(2 months ago))), then: 'up', else: 'down') ;;
        calc_type: 'measure'
        data_type: 'text'
      }
      values: [
        VizFieldFull { ref: 'cur', format { type: 'number', pattern: '[$$]#,###0.00' } },
        VizFieldFull { ref: 'prev', format { type: 'number', pattern: '[$$]#,###0.00' } },
        VizFieldFull { ref: 'mom', format { type: 'number', pattern: '#,###0.0%' } },
        VizFieldFull { ref: 'dir' }
      ]
      content: @md
<style>
  .tl-kpi { font-family: 'Manrope', Arial, sans-serif; color: #1B1F3B; }
  .tl-kpi__value { font-size: 34px; font-weight: 800; letter-spacing: -0.5px; line-height: 1.1; }
  .tl-kpi__meta { display: flex; align-items: center; gap: 8px; margin-top: 10px; flex-wrap: wrap; }
  .tl-badge { display: inline-flex; align-items: center; padding: 3px 10px; border-radius: 999px; font-size: 13px; font-weight: 600; }
  .tl-badge--up { background: rgba(31, 158, 143, 0.14); color: #1F9E8F; }
  .tl-badge--up::before { content: '▲'; font-size: 10px; margin-right: 5px; }
  .tl-badge--down { background: rgba(214, 69, 69, 0.12); color: #D64545; }
  .tl-badge--down::before { content: '▼'; font-size: 10px; margin-right: 5px; }
  .tl-kpi__vs { font-size: 13px; font-weight: 400; color: #5B6477; }
</style>
<div class="tl-kpi">
  <div class="tl-kpi__value">{{ rows[0].`Current`.formatted }}</div>
  <div class="tl-kpi__meta">
    <span class="tl-badge tl-badge--{{ rows[0].`Direction`.raw }}">{{ rows[0].`MoM`.formatted }} MoM</span>
    <span class="tl-kpi__vs">vs {{ rows[0].`Previous`.formatted }}</span>
  </div>
</div>
      ;;
    }
  }

  // Gross Margin change is shown in percentage points, not relative %.
  block kpi_gross_margin: VizBlock {
    label: 'Gross Margin'
    settings {
      hide_label: true
      hide_controls: true
    }
    viz: MarkdownViz {
      dataset: thelook
      calculation cur {
        label: 'Current'
        formula: @aql gross_margin | where(thelook_orders.created_at matches @(last month)) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation prev {
        label: 'Previous'
        formula: @aql gross_margin | where(thelook_orders.created_at matches @(2 months ago)) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation mom {
        label: 'MoM'
        formula: @aql abs((gross_margin | where(thelook_orders.created_at matches @(last month))) - (gross_margin | where(thelook_orders.created_at matches @(2 months ago)))) * 100 ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation dir {
        label: 'Direction'
        formula: @aql case(when: (gross_margin | where(thelook_orders.created_at matches @(last month))) >= (gross_margin | where(thelook_orders.created_at matches @(2 months ago))), then: 'up', else: 'down') ;;
        calc_type: 'measure'
        data_type: 'text'
      }
      values: [
        VizFieldFull { ref: 'cur', format { type: 'number', pattern: '#,###0.0%' } },
        VizFieldFull { ref: 'prev', format { type: 'number', pattern: '#,###0.0%' } },
        VizFieldFull { ref: 'mom', format { type: 'number', pattern: '#,###0.0' } },
        VizFieldFull { ref: 'dir' }
      ]
      content: @md
<style>
  .tl-kpi { font-family: 'Manrope', Arial, sans-serif; color: #1B1F3B; }
  .tl-kpi__value { font-size: 34px; font-weight: 800; letter-spacing: -0.5px; line-height: 1.1; }
  .tl-kpi__meta { display: flex; align-items: center; gap: 8px; margin-top: 10px; flex-wrap: wrap; }
  .tl-badge { display: inline-flex; align-items: center; padding: 3px 10px; border-radius: 999px; font-size: 13px; font-weight: 600; }
  .tl-badge--up { background: rgba(31, 158, 143, 0.14); color: #1F9E8F; }
  .tl-badge--up::before { content: '▲'; font-size: 10px; margin-right: 5px; }
  .tl-badge--down { background: rgba(214, 69, 69, 0.12); color: #D64545; }
  .tl-badge--down::before { content: '▼'; font-size: 10px; margin-right: 5px; }
  .tl-kpi__vs { font-size: 13px; font-weight: 400; color: #5B6477; }
</style>
<div class="tl-kpi">
  <div class="tl-kpi__value">{{ rows[0].`Current`.formatted }}</div>
  <div class="tl-kpi__meta">
    <span class="tl-badge tl-badge--{{ rows[0].`Direction`.raw }}">{{ rows[0].`MoM`.formatted }} pts MoM</span>
    <span class="tl-kpi__vs">vs {{ rows[0].`Previous`.formatted }}</span>
  </div>
</div>
      ;;
    }
  }

  block net_sales_trend: VizBlock {
    label: 'Net Sales by Month'
    settings {
      hide_label: true
    }
    viz: ColumnChart {
      dataset: thelook
      calculation net_sales_m {
        label: 'Net Sales'
        formula: @aql net_sales ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      filter {
        field: r(thelook_orders.created_at)
        operator: 'matches'
        value: 'last 12 months'
      }
      x_axis: VizFieldFull {
        label: 'Order Month'
        ref: r(thelook_orders.created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            label: 'Net Sales'
            ref: 'net_sales_m'
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
          settings {
            color: '#FF6B5A'
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
        row_limit: 100
      }
    }
  }

  view: HTMLLayout {
    content: @html
<style>
  @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;800&display=swap');

  .tl-page {
    min-height: 100%;
    background: #F5EFE6;
    font-family: 'Manrope', Arial, sans-serif;
    font-weight: 400;
    color: #1B1F3B;
  }

  .tl-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 18px 40px;
    background: #FFFFFF;
    border-bottom: 4px solid #FF6B5A;
  }
  .tl-header__logo { display: block; height: 40px; width: 176px; }
  .tl-header__meta { text-align: right; }
  .tl-header__eyebrow {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #FF6B5A;
  }
  .tl-header__period { font-size: 14px; font-weight: 600; color: #5B6477; margin-top: 2px; }

  .tl-hero {
    padding: 32px 40px 88px;
    background: #1B1F3B;
    color: #F5EFE6;
  }
  .tl-hero h1 {
    margin: 0;
    font-size: 34px;
    font-weight: 800;
    letter-spacing: -0.5px;
    color: #FFFFFF;
  }
  .tl-hero p { margin: 8px 0 0; font-size: 15px; font-weight: 400; color: rgba(245, 239, 230, 0.75); }
  .tl-hero__accent { color: #FF6B5A; }

  .tl-main { max-width: 1280px; margin: -60px auto 0; padding: 0 40px 40px; }

  .tl-kpis {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }
  .tl-card {
    background: #FFFFFF;
    border-radius: 16px;
    box-shadow: 0 8px 24px rgba(27, 31, 59, 0.10);
    padding: 20px 22px 12px;
    border-top: 4px solid #FF6B5A;
  }
  .tl-card__head { display: flex; align-items: center; gap: 12px; }
  .tl-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: rgba(255, 107, 90, 0.12);
    flex-shrink: 0;
  }
  .tl-card__icon img { width: 22px; height: 22px; display: block; }
  .tl-card__label { font-size: 14px; font-weight: 600; color: #5B6477; letter-spacing: 0.02em; }
  .tl-card__body { height: 96px; margin-top: 6px; }

  .tl-section {
    margin-top: 28px;
    background: #FFFFFF;
    border-radius: 16px;
    box-shadow: 0 8px 24px rgba(27, 31, 59, 0.06);
    padding: 22px 24px 12px;
  }
  .tl-section h2 { margin: 0; font-size: 20px; font-weight: 800; color: #1B1F3B; }
  .tl-section p { margin: 4px 0 0; font-size: 13px; color: #5B6477; }
  .tl-section__chart { height: 360px; margin-top: 8px; }

  .tl-footer { margin-top: 20px; font-size: 12px; color: #5B6477; }

  @media (max-width: 1024px) {
    .tl-kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 600px) {
    .tl-kpis { grid-template-columns: 1fr; }
    .tl-header { flex-direction: column; align-items: flex-start; }
    .tl-header__meta { text-align: left; }
  }
</style>

<div class="tl-page">
  <header class="tl-header">
    <img class="tl-header__logo" alt="thelook" src="data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='176' height='40' viewBox='0 0 176 40'%3E%3Ccircle cx='18' cy='20' r='11' fill='%23FF6B5A'/%3E%3Ccircle cx='18' cy='20' r='4.5' fill='%23F5EFE6'/%3E%3Ctext x='38' y='28' font-family='Manrope, Arial, sans-serif' font-size='24' font-weight='800' letter-spacing='-0.5' fill='%231B1F3B'%3Ethelook%3C/text%3E%3C/svg%3E" />
    <div class="tl-header__meta">
      <div class="tl-header__eyebrow">Monthly Business Review</div>
      <div class="tl-header__period">Latest complete month vs. prior month</div>
    </div>
  </header>

  <section class="tl-hero">
    <h1>Business Review<span class="tl-hero__accent">.</span></h1>
    <p>Sales, order volume, basket size and profitability for TheLook eCommerce.</p>
  </section>

  <main class="tl-main">
    <div class="tl-kpis">
      <div class="tl-card">
        <div class="tl-card__head">
          <span class="tl-card__icon"><img alt="" src="data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%23FF6B5A' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cline x1='12' y1='2' x2='12' y2='22'/%3E%3Cpath d='M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6'/%3E%3C/svg%3E" /></span>
          <span class="tl-card__label">Net Sales</span>
        </div>
        <div class="tl-card__body"><h-block name="kpi_net_sales" /></div>
      </div>

      <div class="tl-card">
        <div class="tl-card__head">
          <span class="tl-card__icon"><img alt="" src="data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%23FF6B5A' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z'/%3E%3Cline x1='3' y1='6' x2='21' y2='6'/%3E%3Cpath d='M16 10a4 4 0 0 1-8 0'/%3E%3C/svg%3E" /></span>
          <span class="tl-card__label">Orders</span>
        </div>
        <div class="tl-card__body"><h-block name="kpi_orders" /></div>
      </div>

      <div class="tl-card">
        <div class="tl-card__head">
          <span class="tl-card__icon"><img alt="" src="data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%23FF6B5A' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Ccircle cx='9' cy='21' r='1'/%3E%3Ccircle cx='20' cy='21' r='1'/%3E%3Cpath d='M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6'/%3E%3C/svg%3E" /></span>
          <span class="tl-card__label">Average Order Value</span>
        </div>
        <div class="tl-card__body"><h-block name="kpi_aov" /></div>
      </div>

      <div class="tl-card">
        <div class="tl-card__head">
          <span class="tl-card__icon"><img alt="" src="data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%23FF6B5A' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cline x1='19' y1='5' x2='5' y2='19'/%3E%3Ccircle cx='6.5' cy='6.5' r='2.5'/%3E%3Ccircle cx='17.5' cy='17.5' r='2.5'/%3E%3C/svg%3E" /></span>
          <span class="tl-card__label">Gross Margin</span>
        </div>
        <div class="tl-card__body"><h-block name="kpi_gross_margin" /></div>
      </div>
    </div>

    <section class="tl-section">
      <h2>Net Sales by Month</h2>
      <p>Last 12 complete months, excluding Cancelled and Returned items.</p>
      <div class="tl-section__chart"><h-block name="net_sales_trend" /></div>
    </section>

    <div class="tl-footer">Source: TheLook eCommerce dataset. Periods are based on order date.</div>
  </main>
</div>
    ;;
  }

  theme: PageTheme {
    background {
      bg_color: '#F5EFE6'
    }
    block {
      label {
        font_family: 'Manrope, Arial, sans-serif'
        font_color: '#1B1F3B'
        font_weight: 'extrabold'
      }
      text {
        font_family: 'Manrope, Arial, sans-serif'
        font_color: '#1B1F3B'
      }
      border {
        border_width: 0
      }
      background {
        bg_color: 'transparent'
      }
      padding: 0
    }
    custom_css: @css
      @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;800&display=swap');
    ;;
  }
}
