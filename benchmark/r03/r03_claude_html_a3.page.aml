.tl-badge.up { color: #1F9E8F; background: rgba(31, 158, 143, 0.12); }
.tl-badge.down { color: #D64545; background: rgba(214, 69, 69, 0.12); }
.tl-badge.up::before { content: "▲ +"; }
.tl-badge.down::before { content: "▼ "; }
.tl-kpi-prev { font-weight: 400; font-size: 12px; color: #5B6477; }
</style>
<div class="tl-kpi">
<div class="tl-kpi-value">{{ rows[0].values.`Current`.formatted }}</div>
<div class="tl-kpi-foot">
<span class="tl-badge {{ rows[0].values.`Direction`.raw }}">{{ rows[0].values.`Change`.formatted }}</span>
<span class="tl-kpi-prev">vs {{ rows[0].values.`Previous`.formatted }} prior month</span>
</div>
</div>
      ;;
    }
  }

  // ---------- KPI: Gross Margin (change in percentage points) ----------
  block kpi_gross_margin: VizBlock {
    label: 'Gross Margin'
    settings {
      hide_label: true
      hide_controls: true
    }
    theme {
      background {
        bg_color: 'transparent'
      }
      padding: 0
    }
    viz: MarkdownViz {
      dataset: thelook
      calculation cur {
        label: 'Current'
        formula: @aql gross_margin | where(thelook_order_items.created_at matches @(last month));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation prev {
        label: 'Previous'
        formula: @aql gross_margin | where(thelook_order_items.created_at matches @(2 months ago));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation change {
        label: 'Change'
        formula: @aql ((gross_margin | where(thelook_order_items.created_at matches @(last month))) - (gross_margin | where(thelook_order_items.created_at matches @(2 months ago)))) * 100;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation dir {
        label: 'Direction'
        formula: @aql case(when: (gross_margin | where(thelook_order_items.created_at matches @(last month))) >= (gross_margin | where(thelook_order_items.created_at matches @(2 months ago))), then: "up", else: "down");;
        calc_type: 'measure'
        data_type: 'text'
      }
      values: [
        VizFieldFull {
          ref: 'cur'
          label: 'Current'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        },
        VizFieldFull {
          ref: 'prev'
          label: 'Previous'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        },
        VizFieldFull {
          ref: 'change'
          label: 'Change'
          format {
            type: 'number'
            pattern: '#,###0.0'
          }
        },
        VizFieldFull {
          ref: 'dir'
          label: 'Direction'
          format {
            type: 'text'
          }
        }
      ]
      content: @md
<style>
@import url("https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;800&display=swap");
.tl-kpi { font-family: "Manrope", Arial, sans-serif; color: #1B1F3B; }
.tl-kpi-value { font-weight: 800; font-size: 34px; line-height: 1.1; letter-spacing: -0.5px; }
.tl-kpi-foot { display: flex; align-items: center; gap: 8px; margin-top: 10px; flex-wrap: wrap; }
.tl-badge { display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 999px; font-weight: 600; font-size: 13px; }
.tl-badge.up { color: #1F9E8F; background: rgba(31, 158, 143, 0.12); }
.tl-badge.down { color: #D64545; background: rgba(214, 69, 69, 0.12); }
.tl-badge.up::before { content: "▲ +"; }
.tl-badge.down::before { content: "▼ "; }
.tl-kpi-prev { font-weight: 400; font-size: 12px; color: #5B6477; }
</style>
<div class="tl-kpi">
<div class="tl-kpi-value">{{ rows[0].values.`Current`.formatted }}</div>
<div class="tl-kpi-foot">
<span class="tl-badge {{ rows[0].values.`Direction`.raw }}">{{ rows[0].values.`Change`.formatted }} pts</span>
<span class="tl-kpi-prev">vs {{ rows[0].values.`Previous`.formatted }} prior month</span>
</div>
</div>
      ;;
    }
  }

  // ---------- Trend charts ----------
  block sales_margin_trend: VizBlock {
    label: 'Net Sales & Gross Margin, last 12 months'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        label: 'Net Sales'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#FF6B5A'
          }
        }
      }
      y_axis {
        label: 'Gross Margin'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.gross_margin)
            label: 'Gross Margin'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#1B1F3B'
          }
        }
        settings {
          alignment: 'right'
        }
      }
      filter {
        field: r(thelook_order_items.created_at)
        operator: 'matches'
        value: 'last 12 months'
      }
      settings {
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block orders_aov_trend: VizBlock {
    label: 'Orders & AOV, last 12 months'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        label: 'Fulfilled Orders'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(thelook.fulfilled_orders)
            label: 'Fulfilled Orders'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#1B1F3B'
          }
        }
      }
      y_axis {
        label: 'AOV'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.aov)
            label: 'AOV'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#FF6B5A'
          }
        }
        settings {
          alignment: 'right'
        }
      }
      filter {
        field: r(thelook_order_items.created_at)
        operator: 'matches'
        value: 'last 12 months'
      }
      settings {
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  view: HTMLLayout {
    content: @html
      <style>
        @import url("https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;800&display=swap");

        .tl-page {
          font-family: "Manrope", Arial, sans-serif;
          background: #F5EFE6;
          color: #1B1F3B;
          padding: 28px 32px 40px;
          max-width: 1280px;
          margin: 0 auto;
          box-sizing: border-box;
        }

        /* Branded header */
        .tl-header {
          display: flex;
          align-items: stretch;
          border-radius: 18px;
          overflow: hidden;
          background: #FFFFFF;
          box-shadow: 0 1px 2px rgba(27, 31, 59, 0.06);
        }
        .tl-header-brand {
          flex: 1;
          display: flex;
          align-items: center;
          gap: 24px;
          padding: 20px 28px;
          border-left: 6px solid #FF6B5A;
        }
        .tl-logo { height: 40px; width: 176px; display: block; }
        .tl-divider { width: 1px; align-self: stretch; background: #E6DED2; }
        .tl-title {
          margin: 0;
          font-weight: 800;
          font-size: 26px;
          letter-spacing: -0.5px;
          color: #1B1F3B;
        }
        .tl-subtitle {
          margin: 4px 0 0;
          font-weight: 400;
          font-size: 14px;
          color: #5B6477;
        }
        .tl-header-period {
          display: flex;
          flex-direction: column;
          justify-content: center;
          align-items: flex-end;
          min-width: 240px;
          padding: 16px 28px;
          background: #1B1F3B;
        }
        .tl-eyebrow {
          font-weight: 600;
          font-size: 11px;
          letter-spacing: 1.2px;
          text-transform: uppercase;
          color: #FF6B5A;
          margin-bottom: 4px;
        }
        .tl-period-block { width: 100%; height: 48px; }

        /* Section headings */
        .tl-section {
          margin: 28px 0 12px;
          font-weight: 800;
          font-size: 16px;
          color: #1B1F3B;
          display: flex;
          align-items: center;
          gap: 10px;
        }
        .tl-section::before {
          content: "";
          width: 18px;
          height: 4px;
          border-radius: 2px;
          background: #FF6B5A;
        }

        /* KPI cards */
        .tl-kpis {
          display: grid;
          grid-template-columns: repeat(4, minmax(0, 1fr));
          gap: 16px;
        }
        .tl-card {
          background: #FFFFFF;
          border-radius: 16px;
          padding: 20px 22px 18px;
          box-shadow: 0 1px 2px rgba(27, 31, 59, 0.06);
          border-top: 4px solid #1B1F3B;
        }
        .tl-card-head {
          display: flex;
          align-items: center;
          gap: 12px;
          margin-bottom: 14px;
        }
        .tl-icon {
          width: 40px;
          height: 40px;
          border-radius: 12px;
          background: rgba(255, 107, 90, 0.14);
          display: flex;
          align-items: center;
          justify-content: center;
          flex-shrink: 0;
        }
        .tl-icon svg { width: 22px; height: 22px; }
        .tl-card-label {
          font-weight: 600;
          font-size: 14px;
          color: #5B6477;
        }
        .tl-kpi-block { height: 90px; }

        /* Charts */
        .tl-charts {
          display: grid;
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 16px;
        }
        .tl-chart {
          background: #FFFFFF;
          border-radius: 16px;
          padding: 8px;
          height: 380px;
          box-shadow: 0 1px 2px rgba(27, 31, 59, 0.06);
        }

        .tl-footnote {
          margin-top: 18px;
          font-size: 12px;
          font-weight: 400;
          color: #5B6477;
        }

        @media (max-width: 1024px) {
          .tl-kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
          .tl-charts { grid-template-columns: 1fr; }
        }
        @media (max-width: 640px) {
          .tl-page { padding: 16px; }
          .tl-header { flex-direction: column; }
          .tl-header-brand { flex-wrap: wrap; gap: 12px; }
          .tl-divider { display: none; }
          .tl-header-period { align-items: flex-start; }
          .tl-kpis { grid-template-columns: 1fr; }
        }
      </style>

      <div class="tl-page">
        <header class="tl-header">
          <div class="tl-header-brand">
            <img class="tl-logo" alt="thelook" src="data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='176' height='40' viewBox='0 0 176 40'%3E%3Ccircle cx='18' cy='20' r='11' fill='%23FF6B5A'/%3E%3Ccircle cx='18' cy='20' r='4.5' fill='%23F5EFE6'/%3E%3Ctext x='38' y='28' font-family='Manrope, Arial, sans-serif' font-size='24' font-weight='800' letter-spacing='-0.5' fill='%231B1F3B'%3Ethelook%3C/text%3E%3C/svg%3E" />
            <div class="tl-divider"></div>
            <div>
              <h1 class="tl-title">Monthly Business Review</h1>
              <p class="tl-subtitle">Sales, orders and profitability for the last complete month</p>
            </div>
          </div>
          <div class="tl-header-period">
            <div class="tl-eyebrow">Review period</div>
            <div class="tl-period-block"><h-block name="period_label" /></div>
          </div>
        </header>

        <div class="tl-section">Headline KPIs · month over month</div>
        <section class="tl-kpis">
          <div class="tl-card">
            <div class="tl-card-head">
              <div class="tl-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="#FF6B5A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="2" x2="12" y2="22"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              </div>
              <div class="tl-card-label">Net Sales</div>
            </div>
            <div class="tl-kpi-block"><h-block name="kpi_net_sales" /></div>
          </div>

          <div class="tl-card">
            <div class="tl-card-head">
              <div class="tl-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="#FF6B5A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
              </div>
              <div class="tl-card-label">Orders</div>
            </div>
            <div class="tl-kpi-block"><h-block name="kpi_orders" /></div>
          </div>

          <div class="tl-card">
            <div class="tl-card-head">
              <div class="tl-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="#FF6B5A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
              </div>
              <div class="tl-card-label">Average Order Value</div>
            </div>
            <div class="tl-kpi-block"><h-block name="kpi_aov" /></div>
          </div>

          <div class="tl-card">
            <div class="tl-card-head">
              <div class="tl-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="#FF6B5A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.21 15.89A10 10 0 1 1 8 2.83"/><path d="M22 12A10 10 0 0 0 12 2v10z"/></svg>
              </div>
              <div class="tl-card-label">Gross Margin</div>
            </div>
            <div class="tl-kpi-block"><h-block name="kpi_gross_margin" /></div>
          </div>
        </section>

        <div class="tl-section">Trends</div>
        <section class="tl-charts">
          <div class="tl-chart"><h-block name="sales_margin_trend" /></div>
          <div class="tl-chart"><h-block name="orders_aov_trend" /></div>
        </section>

        <p class="tl-footnote">Net Sales, AOV and Gross Margin exclude Cancelled and Returned items. Orders count every order placed. Gross Margin change is shown in percentage points.</p>
      </div>
    ;;
  }
}
