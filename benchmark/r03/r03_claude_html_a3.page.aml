Dashboard r03_claude_html_a3 {
  title: 'TheLook Business Review'
  description: 'Branded monthly business review: last complete month vs the month before.'

  theme: PageTheme {
    background {
      bg_color: '#F5EFE6'
    }
    block {
      label {
        font_family: 'Manrope, Arial, sans-serif'
        font_color: '#1B1F3B'
        font_weight: 'extrabold'
      }
      text {
        font_family: 'Manrope, Arial, sans-serif'
        font_color: '#1B1F3B'
      }
      border {
        border_width: 0
        border_radius: 14
      }
      background {
        bg_color: '#FFFFFF'
      }
    }
    custom_css: @css
      @import url("https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;800&display=swap");
      .dac-viz-block-label {
        font-family: "Manrope", Arial, sans-serif;
        font-weight: 800;
        color: #1B1F3B;
      }
    ;;
  }

  // ---------- Header period label ----------
  block period_label: VizBlock {
    label: 'Review Period'
    settings {
      hide_label: true
      hide_controls: true
    }
    theme {
      background {
        bg_color: 'transparent'
      }
      padding: 0
    }
    viz: MarkdownViz {
      dataset: thelook
      calculation cur_month {
        label: 'Current Month'
        formula: @aql max(thelook_order_items.created_at) | where(thelook_order_items.created_at matches @(last month));;
        calc_type: 'measure'
        data_type: 'datetime'
      }
      calculation prev_month {
        label: 'Previous Month'
        formula: @aql max(thelook_order_items.created_at) | where(thelook_order_items.created_at matches @(2 months ago));;
        calc_type: 'measure'
        data_type: 'datetime'
      }
      values: [
        VizFieldFull {
          ref: 'cur_month'
          label: 'Current Month'
          format {
            type: 'date'
            pattern: 'MMMM yyyy'
          }
        },
        VizFieldFull {
          ref: 'prev_month'
          label: 'Previous Month'
          format {
            type: 'date'
            pattern: 'MMM yyyy'
          }
        }
      ]
      content: @md
<style>
@import url("https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;800&display=swap");
.tl-period { font-family: "Manrope", Arial, sans-serif; text-align: right; }
.tl-period-cur { font-weight: 800; font-size: 20px; color: #FFFFFF; }
.tl-period-prev { font-weight: 600; font-size: 12px; color: #F5EFE6; opacity: .8; margin-top: 2px; }
</style>
<div class="tl-period">
<div class="tl-period-cur">{{ rows[0].values.`Current Month`.formatted }}</div>
<div class="tl-period-prev">compared with {{ rows[0].values.`Previous Month`.formatted }}</div>
</div>
      ;;
    }
  }

  // ---------- KPI: Net Sales ----------
  block kpi_net_sales: VizBlock {
    label: 'Net Sales'
    settings {
      hide_label: true
      hide_controls: true
    }
    theme {
      background {
        bg_color: 'transparent'
      }
      padding: 0
    }
    viz: MarkdownViz {
      dataset: thelook
      calculation cur {
        label: 'Current'
        formula: @aql net_sales | where(thelook_order_items.created_at matches @(last month));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation prev {
        label: 'Previous'
        formula: @aql net_sales | where(thelook_order_items.created_at matches @(2 months ago));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation change {
        label: 'Change'
        formula: @aql safe_divide((net_sales | where(thelook_order_items.created_at matches @(last month))) - (net_sales | where(thelook_order_items.created_at matches @(2 months ago))), net_sales | where(thelook_order_items.created_at matches @(2 months ago)));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation dir {
        label: 'Direction'
        formula: @aql case(when: (net_sales | where(thelook_order_items.created_at matches @(last month))) >= (net_sales | where(thelook_order_items.created_at matches @(2 months ago))), then: "up", else: "down");;
        calc_type: 'measure'
        data_type: 'text'
      }
      values: [
        VizFieldFull {
          ref: 'cur'
          label: 'Current'
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
        },
        VizFieldFull {
          ref: 'prev'
          label: 'Previous'
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
        },
        VizFieldFull {
          ref: 'change'
          label: 'Change'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        },
        VizFieldFull {
          ref: 'dir'
          label: 'Direction'
          format {
            type: 'text'
          }
        }
      ]
      content: @md
<style>
@import url("https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;800&display=swap");
.tl-kpi { font-family: "Manrope", Arial, sans-serif; color: #1B1F3B; }
.tl-kpi-value { font-weight: 800; font-size: 34px; line-height: 1.1; letter-spacing: -0.5px; }
.tl-kpi-foot { display: flex; align-items: center; gap: 8px; margin-top: 10px; flex-wrap: wrap; }
.tl-badge { display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 999px; font-weight: 600; font-size: 13px; }
.tl-badge.up { color: #1F9E8F; background: rgba(31, 158, 143, 0.12); }
.tl-badge.down { color: #D64545; background: rgba(214, 69, 69, 0.12); }
.tl-badge.up::before { content: "▲ +"; }
.tl-badge.down::before { content: "▼ "; }
.tl-kpi-prev { font-weight: 400; font-size: 12px; color: #5B6477; }
</style>
<div class="tl-kpi">
<div class="tl-kpi-value">{{ rows[0].values.`Current`.formatted }}</div>
<div class="tl-kpi-foot">
<span class="tl-badge {{ rows[0].values.`Direction`.raw }}">{{ rows[0].values.`Change`.formatted }}</span>
<span class="tl-kpi-prev">vs {{ rows[0].values.`Previous`.formatted }} prior month</span>
</div>
</div>
      ;;
    }
  }

  // ---------- KPI: Orders ----------
  block kpi_orders: VizBlock {
    label: 'Orders'
    settings {
      hide_label: true
      hide_controls: true
    }
    theme {
      background {
        bg_color: 'transparent'
      }
      padding: 0
    }
    viz: MarkdownViz {
      dataset: thelook
      calculation cur {
        label: 'Current'
        formula: @aql total_orders | where(thelook_orders.created_at matches @(last month));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation prev {
        label: 'Previous'
        formula: @aql total_orders | where(thelook_orders.created_at matches @(2 months ago));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation change {
        label: 'Change'
        formula: @aql safe_divide((total_orders | where(thelook_orders.created_at matches @(last month))) - (total_orders | where(thelook_orders.created_at matches @(2 months ago))), total_orders | where(thelook_orders.created_at matches @(2 months ago)));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation dir {
        label: 'Direction'
        formula: @aql case(when: (total_orders | where(thelook_orders.created_at matches @(last month))) >= (total_orders | where(thelook_orders.created_at matches @(2 months ago))), then: "up", else: "down");;
        calc_type: 'measure'
        data_type: 'text'
      }
      values: [
        VizFieldFull {
          ref: 'cur'
          label: 'Current'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: 'prev'
          label: 'Previous'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: 'change'
          label: 'Change'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        },
        VizFieldFull {
          ref: 'dir'
          label: 'Direction'
          format {
            type: 'text'
          }
        }
      ]
      content: @md
<style>
@import url("https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;800&display=swap");
.tl-kpi { font-family: "Manrope", Arial, sans-serif; color: #1B1F3B; }
.tl-kpi-value { font-weight: 800; font-size: 34px; line-height: 1.1; letter-spacing: -0.5px; }
.tl-kpi-foot { display: flex; align-items: center; gap: 8px; margin-top: 10px; flex-wrap: wrap; }
.tl-badge { display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 999px; font-weight: 600; font-size: 13px; }
.tl-badge.up { color: #1F9E8F; background: rgba(31, 158, 143, 0.12); }
.tl-badge.down { color: #D64545; background: rgba(214, 69, 69, 0.12); }
.tl-badge.up::before { content: "▲ +"; }
.tl-badge.down::before { content: "▼ "; }
.tl-kpi-prev { font-weight: 400; font-size: 12px; color: #5B6477; }
</style>
<div class="tl-kpi">
<div class="tl-kpi-value">{{ rows[0].values.`Current`.formatted }}</div>
<div class="tl-kpi-foot">
<span class="tl-badge {{ rows[0].values.`Direction`.raw }}">{{ rows[0].values.`Change`.formatted }}</span>
<span class="tl-kpi-prev">vs {{ rows[0].values.`Previous`.formatted }} prior month</span>
</div>
</div>
      ;;
    }
  }

  // ---------- KPI: AOV ----------
  block kpi_aov: VizBlock {
    label: 'Average Order Value'
    settings {
      hide_label: true
      hide_controls: true
    }
    theme {
      background {
        bg_color: 'transparent'
      }
      padding: 0
    }
    viz: MarkdownViz {
      dataset: thelook
      calculation cur {
        label: 'Current'
        formula: @aql aov | where(thelook_order_items.created_at matches @(last month));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation prev {
        label: 'Previous'
        formula: @aql aov | where(thelook_order_items.created_at matches @(2 months ago));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation change {
        label: 'Change'
        formula: @aql safe_divide((aov | where(thelook_order_items.created_at matches @(last month))) - (aov | where(thelook_order_items.created_at matches @(2 months ago))), aov | where(thelook_order_items.created_at matches @(2 months ago)));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation dir {
        label: 'Direction'
        formula: @aql case(when: (aov | where(thelook_order_items.created_at matches @(last month))) >= (aov | where(thelook_order_items.created_at matches @(2 months ago))), then: "up", else: "down");;
        calc_type: 'measure'
        data_type: 'text'
      }
      values: [
        VizFieldFull {
          ref: 'cur'
          label: 'Current'
          format {
            type: 'number'
            pattern: '[$$]#,###0.00'
          }
        },
        VizFieldFull {
          ref: 'prev'
          label: 'Previous'
          format {
            type: 'number'
            pattern: '[$$]#,###0.00'
          }
        },
        VizFieldFull {
          ref: 'change'
          label: 'Change'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        },
        VizFieldFull {
          ref: 'dir'
          label: 'Direction'
          format {
            type: 'text'
          }
        }
      ]
      content: @md
<style>
@import url("https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;800&display=swap");
.tl-kpi { font-family: "Manrope", Arial, sans-serif; color: #1B1F3B; }
.tl-kpi-value { font-weight: 800; font-size: 34px; line-height: 1.1; letter-spacing: -0.5px; }
.tl-kpi-foot { display: flex; align-items: center; gap: 8px; margin-top: 10px; flex-wrap: wrap; }
