ColorPalette thelook_brand_palette {
  title: 'TheLook Brand Palette'

  categorical {
    colors: [
      '#FF6B5A',
      '#1F9E8F',
      '#1B1F3B',
      '#5B6477',
      '#D64545',
    ]
  }
}

Dashboard r03_hai_canvas_a1 {
  title: 'TheLook | Business Review'
  description: 'A branded monthly business review covering commercial performance, trends, and category mix.'

  theme: PageTheme {
    color {
      data: thelook_brand_palette
    }

    background {
      bg_color: '#F5EFE6'
    }

    canvas {
      background {
        bg_color: '#F5EFE6'
      }

      border {
        border_style: 'none'
        border_width: 0
      }

      shadow: 'none'
      opacity: 1
    }

    block {
      text {
        font_family: 'Manrope, Arial, sans-serif'
        font_size: 14
        font_color: '#5B6477'
        font_weight: 'normal'
      }

      label {
        font_family: 'Manrope, Arial, sans-serif'
        font_size: 14
        font_color: '#1B1F3B'
        font_weight: 'semibold'
      }

      background {
        bg_color: '#FFFFFF'
      }

      border {
        border_color: '#E7E0D6'
        border_style: 'solid'
        border_width: 1
        border_radius {
          top_left: 16
          top_right: 16
          bottom_left: 16
          bottom_right: 16
        }
      }

      padding {
        top: 20
        right: 20
        bottom: 20
        left: 20
      }

      shadow: 'sm'
      opacity: 1
    }

    viz {
      metric_kpi {
        alignment: 'left'

        label {
          font_family: 'Manrope, Arial, sans-serif'
          font_size: 13
          font_color: '#5B6477'
          font_weight: 'semibold'
        }

        value {
          font_family: 'Manrope, Arial, sans-serif'
          font_size: 34
          font_color: '#1B1F3B'
          font_weight: 'extrabold'
        }

        trend {
          positive {
            text {
              font_family: 'Manrope, Arial, sans-serif'
              font_color: '#0F766E'
              font_weight: 'bold'
            }

            background {
              bg_color: '#D9F3EE'
            }
          }

          negative {
            text {
              font_family: 'Manrope, Arial, sans-serif'
              font_color: '#B42318'
              font_weight: 'bold'
            }

            background {
              bg_color: '#FCE3E1'
            }
          }

          neutral {
            text {
              font_family: 'Manrope, Arial, sans-serif'
              font_color: '#5B6477'
              font_weight: 'bold'
            }

            background {
              bg_color: '#EEEAE4'
            }
          }
        }
      }

      table {
        general {
          font_family: 'Manrope, Arial, sans-serif'
          font_color: '#1B1F3B'
          bg_color: '#FFFFFF'
          hover_color: '#F5EFE6'
          banding_color: '#FCFAF7'
          grid_color: '#E7E0D6'
          border_color: '#E7E0D6'
        }

        header {
          bg_color: '#1B1F3B'
          font_color: '#FFFFFF'
          font_weight: 'bold'
        }
      }
    }

    custom_css: @css
      @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;800&display=swap');

      .dac-text-block {
        box-shadow: none !important;
      }

      .dac-text-block h1,
      .dac-text-block h2,
      .dac-text-block h3,
      .dac-text-block p {
        font-family: 'Manrope', Arial, sans-serif !important;
      }

      .dac-viz-block-label {
        font-family: 'Manrope', Arial, sans-serif !important;
        color: #1B1F3B !important;
        font-weight: 800 !important;
      }

      .thelook-header {
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 28px;
      }

      .thelook-logo-chip {
        display: flex;
        align-items: center;
        height: 58px;
        padding: 0 20px;
        border-radius: 14px;
        background: #F5EFE6;
      }

      .thelook-header-copy {
        flex: 1;
      }

      .thelook-eyebrow {
        color: #FFB0A7;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 1.8px;
        text-transform: uppercase;
        margin-bottom: 6px;
      }

      .thelook-title {
        color: #FFFFFF;
        font-size: 29px;
        font-weight: 800;
        letter-spacing: -0.8px;
        line-height: 1.15;
      }

      .thelook-subtitle {
        color: #CBD0DD;
        font-size: 13px;
        font-weight: 400;
        margin-top: 7px;
      }

      .thelook-status {
        color: #1B1F3B;
        background: #FFFFFF;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 800;
        padding: 10px 15px;
        white-space: nowrap;
      }

      .section-heading {
        display: flex;
        align-items: center;
        gap: 10px;
        height: 100%;
      }

      .section-heading .bar {
        width: 4px;
        height: 28px;
        border-radius: 4px;
        background: #FF6B5A;
      }

      .section-heading h2 {
        color: #1B1F3B;
        font-size: 20px;
        font-weight: 800;
        letter-spacing: -0.35px;
        margin: 0;
      }

      .section-heading span {
        color: #5B6477;
        font-size: 13px;
        font-weight: 400;
        margin-left: 4px;
      }
    ;;
  }

  block header: TextBlock {
    content: @md
      <div class="thelook-header">
        <div class="thelook-logo-chip">
          <img
            src="data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='176' height='40' viewBox='0 0 176 40'%3E%3Ccircle cx='18' cy='20' r='11' fill='%23FF6B5A'/%3E%3Ccircle cx='18' cy='20' r='4.5' fill='%23F5EFE6'/%3E%3Ctext x='38' y='28' font-family='Manrope, Arial, sans-serif' font-size='24' font-weight='800' letter-spacing='-0.5' fill='%231B1F3B'%3Ethelook%3C/text%3E%3C/svg%3E"
            alt="thelook"
            width="176"
            height="40"
          />
        </div>
        <div class="thelook-header-copy">
          <div class="thelook-eyebrow">Commercial performance</div>
          <div class="thelook-title">Monthly Business Review</div>
          <div class="thelook-subtitle">A focused view of sales, order health, and margin performance.</div>
        </div>
        <div class="thelook-status">MONTHLY VIEW</div>
      </div>
    ;;

    theme: BlockTheme {
      background {
        bg_color: '#1B1F3B'
      }

      border {
        border_style: 'none'
        border_width: 0
        border_radius {
          top_left: 20
          top_right: 20
          bottom_left: 20
          bottom_right: 20
        }
      }

      padding {
        top: 22
        right: 28
        bottom: 22
        left: 28
      }

      shadow: 'none'
    }
  }

  block f_reporting_month: FilterBlock {
    label: 'Reporting month'
    type: 'field'

    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }

    default {
      operator: 'last'
      value: 1
      modifier: 'month'

      options {
        include_current_period: false
      }
    }
  }

  block p_comparison: PopBlock {
    label: 'Compare with'

    default {
      type: 'relative'
      duration: 1
      granularity: 'month'
      show_growth_rate: true
    }
  }

  block kpi_net_sales: VizBlock {
    label: 'Net Sales'
    settings {
      hide_label: true
    }

    viz: MetricKpi {
      dataset: thelook

      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: '↗  Net Sales'

        format {
          type: 'number'
          pattern: 'inherited'
        }
      }

      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true

        value {
          duration: 1
          granularity: 'month'
        }
      }

      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
      }
    }
  }

  block kpi_orders: VizBlock {
    label: 'Orders'
    settings {
      hide_label: true
    }

    viz: MetricKpi {
      dataset: thelook

      value: VizFieldFull {
        ref: r(thelook.total_orders)
        label: '▦  Orders'

        format {
          type: 'number'
          pattern: 'inherited'
        }
      }

      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true

        value {
          duration: 1
          granularity: 'month'
        }
      }

      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
      }
    }
  }

  block kpi_aov: VizBlock {
    label: 'Average Order Value'
    settings {
      hide_label: true
    }

    viz: MetricKpi {
      dataset: thelook

      value: VizFieldFull {
        ref: r(thelook.aov)
        label: '◌  Average Order Value'

        format {
          type: 'number'
          pattern: 'inherited'
        }
      }

      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true

        value: RelativePopValue {
          duration: 1
          granularity: 'month'
        }
      }

      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
      }
    }
  }

  block kpi_gross_margin: VizBlock {
    label: 'Gross Margin'
    settings {
      hide_label: true
    }

    viz: MetricKpi {
      dataset: thelook

      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: '◒  Gross Margin'

        format {
          type: 'number'
          pattern: 'inherited'
        }
      }

      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true

        value: RelativePopValue {
          duration: 1
          granularity: 'month'
        }
      }

      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
      }
    }
  }

  block h_sales_trend: TextBlock {
    content: @md
      <div class="section-heading">
        <div class="bar"></div>
        <h2>Sales momentum</h2>
        <span>Net sales over the last 24 months</span>
      </div>
    ;;

    theme: BlockTheme {
      background {
        bg_color: 'transparent'
      }

      border {
        border_style: 'none'
        border_width: 0
      }

      padding: 0
      shadow: 'none'
    }
  }

  block v_monthly_net_sales: VizBlock {
    label: 'Monthly Net Sales'

    viz: CombinationChart {
      dataset: thelook

      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        label: 'Order Item Month'
        transformation: 'datetrunc month'

        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }

      y_axis {
        series {
          mark_type: 'line'

          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'

            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }

      conditions: [
        "thelook_order_items.created_at matches @(last 24 months)",
      ]

      settings {
        x_axis_label: 'Month'
        legend_label: 'hidden'
        show_data_points: false

        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block h_category_mix: TextBlock {
    content: @md
      <div class="section-heading">
        <div class="bar"></div>
        <h2>Category mix</h2>
        <span>Where net sales are coming from</span>
      </div>
    ;;

    theme: BlockTheme {
      background {
        bg_color: 'transparent'
      }

      border {
        border_style: 'none'
        border_width: 0
      }

      padding: 0
      shadow: 'none'
    }
  }

  block v_category_sales: VizBlock {
    label: 'Net Sales by Product Category'

    viz: BarChart {
      dataset: thelook

      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Product Category'
      }

      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'

            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }

      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'f_reporting_month'
      to: [
        'kpi_net_sales',
        'kpi_orders',
        'kpi_aov',
        'kpi_gross_margin',
        'v_category_sales',
      ]
      field: r(thelook_order_items.created_at)
    },

    PopInteraction {
      from: 'p_comparison'
      to: [
        'kpi_net_sales',
        'kpi_orders',
        'kpi_aov',
        'kpi_gross_margin',
      ]
      field: r(thelook_order_items.created_at)
    },
  ]

  settings {
    timezone: 'UTC'
    autorun_on_open: true
    autorun_on_changes: true
    cache_duration: 60
  }

  view: CanvasLayout {
    label: 'Business Review'
    width: 1280
    height: 1320
    margin: 24
    grid_size: 20
    auto_expand_vertically: true

    block header {
      position: pos(24, 24, 1232, 136)
      layer: 1
    }

    block f_reporting_month {
      position: pos(24, 184, 310, 84)
      layer: 1
    }

    block p_comparison {
      position: pos(354, 184, 310, 84)
      layer: 1
    }

    block kpi_net_sales {
      position: pos(24, 292, 292, 190)
      layer: 1
    }

    block kpi_orders {
      position: pos(336, 292, 292, 190)
      layer: 1
    }

    block kpi_aov {
      position: pos(648, 292, 292, 190)
      layer: 1
    }

    block kpi_gross_margin {
      position: pos(960, 292, 296, 190)
      layer: 1
    }

    block h_sales_trend {
      position: pos(24, 514, 1232, 42)
      layer: 1
    }

    block v_monthly_net_sales {
      position: pos(24, 572, 1232, 350)
      layer: 1
    }

    block h_category_mix {
      position: pos(24, 962, 1232, 42)
      layer: 1
    }

    block v_category_sales {
      position: pos(24, 1020, 1232, 300)
      layer: 1
    }

    mobile {
      mode: 'auto'
    }
  }
}
