Dashboard r03_hai_canvas_a2 {
  title: 'TheLook Executive Business Review'
  description: 'Branded monthly business review for TheLook eCommerce.'
  theme: PageTheme {
    background {
      bg_color: '#F5EFE6'
    }

    canvas {
      background {
        bg_color: '#F5EFE6'
      }
      border {
        border_width: 0
        border_radius: 0
      }
      shadow: 'none'
    }

    block {
      background {
        bg_color: '#FFFFFF'
      }
      border {
        border_width: 1
        border_color: '#E8E0D5'
        border_radius: 16
      }
      padding: 20
      shadow: 'sm'
      label {
        font_family: 'Manrope, Arial, sans-serif'
        font_color: '#1B1F3B'
        font_weight: 'extrabold'
      }
      text {
        font_family: 'Manrope, Arial, sans-serif'
        font_color: '#5B6477'
        font_weight: 'normal'
      }
    }

    viz {
      metric_kpi {
        alignment: 'left'

        label {
          font_family: 'Manrope, Arial, sans-serif'
          font_color: '#5B6477'
          font_size: 13
          font_weight: 'semibold'
        }

        value {
          font_family: 'Manrope, Arial, sans-serif'
          font_color: '#1B1F3B'
          font_size: 32
          font_weight: 'extrabold'
        }

        trend {
          positive {
            text {
              font_family: 'Manrope, Arial, sans-serif'
              font_color: '#1F9E8F'
              font_weight: 'bold'
            }
            background {
              bg_color: '#E1F3F0'
            }
          }

          negative {
            text {
              font_family: 'Manrope, Arial, sans-serif'
              font_color: '#D64545'
              font_weight: 'bold'
            }
            background {
              bg_color: '#FBE7E7'
            }
          }

          neutral {
            text {
              font_family: 'Manrope, Arial, sans-serif'
              font_color: '#5B6477'
              font_weight: 'semibold'
            }
            background {
              bg_color: '#EEE9E1'
            }
          }
        }
      }
    }

    custom_css: @css
      @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;800&display=swap');

      * {
        font-family: 'Manrope', Arial, sans-serif;
      }
    ;;
  }

  block brand_strip: TextBlock {
    content: @md &nbsp; ;;
    theme: BlockTheme {
      background {
        bg_color: '#FF6B5A'
      }
      border {
        border_width: 0
        border_radius: 0
      }
      padding: 0
      shadow: 'none'
    }
  }

  block brand_logo: TextBlock {
    content: @md
      ![thelook](data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='176' height='40' viewBox='0 0 176 40'%3E%3Ccircle cx='18' cy='20' r='11' fill='%23FF6B5A'/%3E%3Ccircle cx='18' cy='20' r='4.5' fill='%23F5EFE6'/%3E%3Ctext x='38' y='28' font-family='Manrope, Arial, sans-serif' font-size='24' font-weight='800' letter-spacing='-0.5' fill='%231B1F3B'%3Ethelook%3C/text%3E%3C/svg%3E)
    ;;
    theme: BlockTheme {
      background {
        bg_color: 'transparent'
      }
      border {
        border_width: 0
      }
      padding: 0
      shadow: 'none'
    }
  }

  block report_title: TextBlock {
    content: @md
      # Executive Business Review
    ;;
    theme: BlockTheme {
      background {
        bg_color: 'transparent'
      }
      border {
        border_width: 0
      }
      padding: 0
      shadow: 'none'
      text {
        font_family: 'Manrope, Arial, sans-serif'
        font_color: '#1B1F3B'
        font_size: 28
        font_weight: 'extrabold'
      }
    }
  }

  block report_subtitle: TextBlock {
    content: @md
      Monthly performance snapshot · Net sales, demand, order value, and profitability
    ;;
    theme: BlockTheme {
      background {
        bg_color: 'transparent'
      }
      border {
        border_width: 0
      }
      padding: 0
      shadow: 'none'
      text {
        font_family: 'Manrope, Arial, sans-serif'
        font_color: '#5B6477'
        font_size: 14
        font_weight: 'normal'
      }
    }
  }

  block f_date: FilterBlock {
    label: 'Order date'
    type: 'date'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block section_heading: TextBlock {
    content: @md
      ## Performance at a glance
      _Each badge compares the selected period with the prior month._
    ;;
    theme: BlockTheme {
      background {
        bg_color: 'transparent'
      }
      border {
        border_width: 0
      }
      padding: 0
      shadow: 'none'
      text {
        font_family: 'Manrope, Arial, sans-serif'
        font_color: '#1B1F3B'
        font_weight: 'extrabold'
      }
    }
  }

  block icon_net_sales: TextBlock {
    content: @md 💳 ;;
    theme: BlockTheme {
      background {
        bg_color: '#FFF0ED'
      }
      border {
        border_width: 0
        border_radius: 12
      }
      padding: 8
      shadow: 'none'
      text {
        font_size: 18
      }
    }
  }

  block icon_orders: TextBlock {
    content: @md 🛍️ ;;
    theme: BlockTheme {
      background {
        bg_color: '#FFF0ED'
      }
      border {
        border_width: 0
        border_radius: 12
      }
      padding: 8
      shadow: 'none'
      text {
        font_size: 18
      }
    }
  }

  block icon_aov: TextBlock {
    content: @md 🧾 ;;
    theme: BlockTheme {
      background {
        bg_color: '#FFF0ED'
      }
      border {
        border_width: 0
        border_radius: 12
      }
      padding: 8
      shadow: 'none'
      text {
        font_size: 18
      }
    }
  }

  block icon_gross_margin: TextBlock {
    content: @md ◔ ;;
    theme: BlockTheme {
      background {
        bg_color: '#E1F3F0'
      }
      border {
        border_width: 0
        border_radius: 12
      }
      padding: 8
      shadow: 'none'
      text {
        font_family: 'Manrope, Arial, sans-serif'
        font_color: '#1F9E8F'
        font_size: 20
        font_weight: 'extrabold'
      }
    }
  }

  block kpi_net_sales: VizBlock {
    label: 'Net Sales'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook

      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }

      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value {
          duration: 1
          granularity: 'month'
        }
      }

      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
      }
    }
  }

  block kpi_orders: VizBlock {
    label: 'Orders'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook

      value: VizFieldFull {
        ref: r(thelook.total_orders)
        label: 'Orders'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }

      compare_value: VizPopSettings {
        field: r(thelook_orders.created_at)
        show_growth_rate: true
        value {
          duration: 1
          granularity: 'month'
        }
      }

      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
      }
    }
  }

  block kpi_aov: VizBlock {
    label: 'Average Order Value'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook

      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }

      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value {
          duration: 1
          granularity: 'month'
        }
      }

      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
      }
    }
  }

  block kpi_gross_margin: VizBlock {
    label: 'Gross Margin'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook

      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }

      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value {
          duration: 1
          granularity: 'month'
        }
      }

      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
      }
    }
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'f_date'
      to: [
        'kpi_net_sales',
        'kpi_orders',
        'kpi_aov',
        'kpi_gross_margin',
      ]
      field: r(thelook_order_items.created_at)
    },
  ]

  view: CanvasLayout {
    width: 1440
    height: 490
    margin: 24
    grid_size: 8
    auto_expand_vertically: true

    block brand_strip {
      position: pos(0, 0, 1440, 8)
      layer: 1
    }

    block brand_logo {
      position: pos(32, 28, 176, 40)
      layer: 1
    }

    block report_title {
      position: pos(32, 86, 720, 42)
      layer: 1
    }

    block report_subtitle {
      position: pos(32, 128, 780, 28)
      layer: 1
    }

    block f_date {
      position: pos(1136, 56, 272, 76)
      layer: 1
    }

    block section_heading {
      position: pos(32, 190, 720, 68)
      layer: 1
    }

    block kpi_net_sales {
      position: pos(32, 278, 328, 176)
      layer: 1
    }

    block kpi_orders {
      position: pos(384, 278, 328, 176)
      layer: 1
    }

    block kpi_aov {
      position: pos(736, 278, 328, 176)
      layer: 1
    }

    block kpi_gross_margin {
      position: pos(1088, 278, 320, 176)
      layer: 1
    }

    block icon_net_sales {
      position: pos(296, 298, 44, 44)
      layer: 2
    }

    block icon_orders {
      position: pos(648, 298, 44, 44)
      layer: 2
    }

    block icon_aov {
      position: pos(1000, 298, 44, 44)
      layer: 2
    }

    block icon_gross_margin {
      position: pos(1344, 298, 44, 44)
      layer: 2
    }

    mobile {
      mode: 'auto'
    }
  }
}
