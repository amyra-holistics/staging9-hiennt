Dashboard r03_hai_canvas_a3 {
  title: 'TheLook | Business Review'
  description: 'Branded monthly ecommerce performance review for TheLook.'
  explicit_interactions: []

  theme: PageTheme {
    background {
      bg_color: '#F5EFE6'
    }

    canvas {
      background {
        bg_color: '#F5EFE6'
      }
      border {
        border_style: 'none'
      }
    }

    block {
      background {
        bg_color: 'transparent'
      }
      border {
        border_style: 'none'
      }
      padding: 0
      shadow: 'none'

      label {
        font_family: 'Manrope, Arial, sans-serif'
        font_color: '#1B1F3B'
        font_weight: 'extrabold'
      }

      text {
        font_family: 'Manrope, Arial, sans-serif'
        font_color: '#5B6477'
      }
    }

    custom_css: @css
      @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;800&display=swap');

      .dac-canvas {
        background: #F5EFE6;
      }

      .dac-viz-block,
      .dac-text-block {
        box-shadow: none;
        border: none;
        background: transparent;
      }

      .dac-viz-block-content,
      .dac-text-block-content {
        font-family: 'Manrope', Arial, sans-serif;
      }
    ;;
  }

  block branded_header: TextBlock {
    content: @md
      <div style="
        display:flex;
        align-items:center;
        justify-content:space-between;
        height:100%;
        padding:0 6px;
        font-family:'Manrope', Arial, sans-serif;
      ">
        <div style="display:flex; align-items:center; gap:22px;">
          <img
            src="data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='176' height='40' viewBox='0 0 176 40'%3E%3Ccircle cx='18' cy='20' r='11' fill='%23FF6B5A'/%3E%3Ccircle cx='18' cy='20' r='4.5' fill='%23F5EFE6'/%3E%3Ctext x='38' y='28' font-family='Manrope, Arial, sans-serif' font-size='24' font-weight='800' letter-spacing='-0.5' fill='%231B1F3B'%3Ethelook%3C/text%3E%3C/svg%3E"
            alt="thelook"
            style="width:176px; height:40px;"
          />
          <div style="width:1px; height:30px; background:#D9D1C7;"></div>
          <div>
            <div style="
              color:#1B1F3B;
              font-size:28px;
              line-height:1.1;
              font-weight:800;
              letter-spacing:-0.8px;
            ">
              Business review
            </div>
            <div style="
              margin-top:5px;
              color:#5B6477;
              font-size:13px;
              font-weight:600;
              letter-spacing:0.02em;
            ">
              Current calendar month performance
            </div>
          </div>
        </div>

        <div style="
          display:inline-flex;
          align-items:center;
          gap:8px;
          padding:9px 13px;
          border:1px solid #E0D8CF;
          border-radius:999px;
          background:#FFFDF9;
          color:#5B6477;
          font-size:12px;
          font-weight:600;
        ">
          <span style="
            width:8px;
            height:8px;
            border-radius:50%;
            background:#1F9E8F;
            display:inline-block;
          "></span>
          Live monthly snapshot
        </div>
      </div>
    ;;
  }

  block net_sales_kpi: VizBlock {
    label: 'Net Sales'
    settings {
      hide_label: true
      hide_controls: true
    }

    viz: MarkdownViz {
      dataset: thelook

      calculation current_month_net_sales {
        label: 'Net Sales'
        formula: @aql net_sales | where(thelook_order_items.created_at matches @(this month));;
        calc_type: 'measure'
        data_type: 'number'
      }

      calculation previous_month_net_sales {
        label: 'Previous Month Net Sales'
        formula: @aql net_sales | where(thelook_order_items.created_at matches @(last month));;
        calc_type: 'measure'
        data_type: 'number'
      }

      calculation net_sales_mom_change {
        label: 'MoM Change'
        formula: @aql safe_divide(current_month_net_sales - previous_month_net_sales, previous_month_net_sales);;
        calc_type: 'measure'
        data_type: 'number'
      }

      calculation net_sales_mom_direction {
        label: 'MoM Direction'
        formula: @aql case(
          when: net_sales_mom_change > 0, then: 'positive',
          when: net_sales_mom_change < 0, then: 'negative',
          else: 'neutral'
        );;
        calc_type: 'measure'
        data_type: 'text'
      }

      values: [
        VizFieldFull {
          ref: 'current_month_net_sales'
          label: 'Net Sales'
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
        },
        VizFieldFull {
          ref: 'net_sales_mom_change'
          label: 'MoM Change'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        },
        VizFieldFull {
          ref: 'net_sales_mom_direction'
          label: 'MoM Direction'
          format {
            type: 'text'
          }
        },
      ]

      content: @md
        <style>
          .thelook-kpi-card {
            height: 100%;
            box-sizing: border-box;
            padding: 22px;
            border: 1px solid #E3DBD1;
            border-radius: 18px;
            background: #FFFDF9;
            color: #1B1F3B;
            font-family: 'Manrope', Arial, sans-serif;
          }
          .thelook-kpi-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
          }
          .thelook-kpi-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 42px;
            height: 42px;
            border-radius: 12px;
            background: #FFE2DD;
            color: #FF6B5A;
            font-size: 20px;
            font-weight: 800;
          }
          .thelook-kpi-label {
            margin-top: 18px;
            color: #5B6477;
            font-size: 13px;
            font-weight: 600;
            letter-spacing: 0.02em;
          }
          .thelook-kpi-value {
            margin-top: 5px;
            color: #1B1F3B;
            font-size: 31px;
            line-height: 1.1;
            font-weight: 800;
            letter-spacing: -1px;
          }
          .thelook-kpi-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            margin-top: 15px;
            padding: 5px 9px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 800;
          }
          .thelook-kpi-badge.positive {
            background: #DDF4F1;
            color: #1F9E8F;
          }
          .thelook-kpi-badge.negative {
            background: #FBE2E2;
            color: #D64545;
          }
          .thelook-kpi-badge.neutral {
            background: #EEEAE4;
            color: #5B6477;
          }
        </style>

        <div class="thelook-kpi-card">
          <div class="thelook-kpi-top">
            <div class="thelook-kpi-icon" aria-hidden="true">$</div>
            <span style="color:#5B6477; font-size:11px; font-weight:600;">MONTHLY</span>
          </div>
          <div class="thelook-kpi-label">Net Sales</div>
          <div class="thelook-kpi-value">{{ rows[0].values.`Net Sales` }}</div>
          <div class="thelook-kpi-badge {{ rows[0].values.`MoM Direction`.raw }}">
            <span>{{ rows[0].values.`MoM Direction`.raw }}</span>
            <span>{{ rows[0].values.`MoM Change` }} vs last month</span>
          </div>
        </div>
      ;;

      settings {
        row_limit: 1
      }
    }
  }

  block orders_kpi: VizBlock {
    label: 'Orders'
    settings {
      hide_label: true
      hide_controls: true
    }

    viz: MarkdownViz {
      dataset: thelook

      calculation current_month_orders {
        label: 'Orders'
        formula: @aql total_orders | where(thelook_order_items.created_at matches @(this month));;
        calc_type: 'measure'
        data_type: 'number'
      }

      calculation previous_month_orders {
        label: 'Previous Month Orders'
        formula: @aql total_orders | where(thelook_order_items.created_at matches @(last month));;
        calc_type: 'measure'
        data_type: 'number'
      }

      calculation orders_mom_change {
        label: 'MoM Change'
        formula: @aql safe_divide(current_month_orders - previous_month_orders, previous_month_orders);;
        calc_type: 'measure'
        data_type: 'number'
      }

      calculation orders_mom_direction {
        label: 'MoM Direction'
        formula: @aql case(
          when: orders_mom_change > 0, then: 'positive',
          when: orders_mom_change < 0, then: 'negative',
          else: 'neutral'
        );;
        calc_type: 'measure'
        data_type: 'text'
      }

      values: [
        VizFieldFull {
          ref: 'current_month_orders'
          label: 'Orders'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: 'orders_mom_change'
          label: 'MoM Change'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        },
        VizFieldFull {
          ref: 'orders_mom_direction'
          label: 'MoM Direction'
          format {
            type: 'text'
          }
        },
      ]

      content: @md
        <style>
          .thelook-kpi-card { height:100%; box-sizing:border-box; padding:22px; border:1px solid #E3DBD1; border-radius:18px; background:#FFFDF9; color:#1B1F3B; font-family:'Manrope',Arial,sans-serif; }
          .thelook-kpi-top { display:flex; align-items:center; justify-content:space-between; }
          .thelook-kpi-icon { display:inline-flex; align-items:center; justify-content:center; width:42px; height:42px; border-radius:12px; background:#E0F3F0; color:#1F9E8F; font-size:20px; font-weight:800; }
          .thelook-kpi-label { margin-top:18px; color:#5B6477; font-size:13px; font-weight:600; letter-spacing:0.02em; }
          .thelook-kpi-value { margin-top:5px; color:#1B1F3B; font-size:31px; line-height:1.1; font-weight:800; letter-spacing:-1px; }
          .thelook-kpi-badge { display:inline-flex; align-items:center; gap:5px; margin-top:15px; padding:5px 9px; border-radius:999px; font-size:11px; font-weight:800; }
          .thelook-kpi-badge.positive { background:#DDF4F1; color:#1F9E8F; }
          .thelook-kpi-badge.negative { background:#FBE2E2; color:#D64545; }
          .thelook-kpi-badge.neutral { background:#EEEAE4; color:#5B6477; }
        </style>

        <div class="thelook-kpi-card">
          <div class="thelook-kpi-top">
            <div class="thelook-kpi-icon" aria-hidden="true">#</div>
            <span style="color:#5B6477; font-size:11px; font-weight:600;">MONTHLY</span>
          </div>
          <div class="thelook-kpi-label">Orders</div>
          <div class="thelook-kpi-value">{{ rows[0].values.`Orders` }}</div>
          <div class="thelook-kpi-badge {{ rows[0].values.`MoM Direction`.raw }}">
            <span>{{ rows[0].values.`MoM Direction`.raw }}</span>
            <span>{{ rows[0].values.`MoM Change` }} vs last month</span>
          </div>
        </div>
      ;;

      settings {
        row_limit: 1
      }
    }
  }

  block aov_kpi: VizBlock {
    label: 'Average Order Value'
    settings {
      hide_label: true
      hide_controls: true
    }

    viz: MarkdownViz {
      dataset: thelook

      calculation current_month_aov {
        label: 'Average Order Value'
        formula: @aql aov | where(thelook_order_items.created_at matches @(this month));;
        calc_type: 'measure'
        data_type: 'number'
      }

      calculation previous_month_aov {
        label: 'Previous Month AOV'
        formula: @aql aov | where(thelook_order_items.created_at matches @(last month));;
        calc_type: 'measure'
        data_type: 'number'
      }

      calculation aov_mom_change {
        label: 'MoM Change'
        formula: @aql safe_divide(current_month_aov - previous_month_aov, previous_month_aov);;
        calc_type: 'measure'
        data_type: 'number'
      }

      calculation aov_mom_direction {
        label: 'MoM Direction'
        formula: @aql case(
          when: aov_mom_change > 0, then: 'positive',
          when: aov_mom_change < 0, then: 'negative',
          else: 'neutral'
        );;
        calc_type: 'measure'
        data_type: 'text'
      }

      values: [
        VizFieldFull {
          ref: 'current_month_aov'
          label: 'Average Order Value'
          format {
            type: 'number'
            pattern: '[$$]#,###0.00'
          }
        },
        VizFieldFull {
          ref: 'aov_mom_change'
          label: 'MoM Change'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        },
        VizFieldFull {
          ref: 'aov_mom_direction'
          label: 'MoM Direction'
          format {
            type: 'text'
          }
        },
      ]

      content: @md
        <style>
          .thelook-kpi-card { height:100%; box-sizing:border-box; padding:22px; border:1px solid #E3DBD1; border-radius:18px; background:#FFFDF9; color:#1B1F3B; font-family:'Manrope',Arial,sans-serif; }
          .thelook-kpi-top { display:flex; align-items:center; justify-content:space-between; }
          .thelook-kpi-icon { display:inline-flex; align-items:center; justify-content:center; width:42px; height:42px; border-radius:12px; background:#FFF0DC; color:#FF6B5A; font-size:21px; font-weight:800; }
          .thelook-kpi-label { margin-top:18px; color:#5B6477; font-size:13px; font-weight:600; letter-spacing:0.02em; }
          .thelook-kpi-value { margin-top:5px; color:#1B1F3B; font-size:31px; line-height:1.1; font-weight:800; letter-spacing:-1px; }
          .thelook-kpi-badge { display:inline-flex; align-items:center; gap:5px; margin-top:15px; padding:5px 9px; border-radius:999px; font-size:11px; font-weight:800; }
          .thelook-kpi-badge.positive { background:#DDF4F1; color:#1F9E8F; }
          .thelook-kpi-badge.negative { background:#FBE2E2; color:#D64545; }
          .thelook-kpi-badge.neutral { background:#EEEAE4; color:#5B6477; }
        </style>

        <div class="thelook-kpi-card">
          <div class="thelook-kpi-top">
            <div class="thelook-kpi-icon" aria-hidden="true">◎</div>
            <span style="color:#5B6477; font-size:11px; font-weight:600;">MONTHLY</span>
          </div>
          <div class="thelook-kpi-label">Average Order Value</div>
          <div class="thelook-kpi-value">{{ rows[0].values.`Average Order Value` }}</div>
          <div class="thelook-kpi-badge {{ rows[0].values.`MoM Direction`.raw }}">
            <span>{{ rows[0].values.`MoM Direction`.raw }}</span>
            <span>{{ rows[0].values.`MoM Change` }} vs last month</span>
          </div>
        </div>
      ;;

      settings {
        row_limit: 1
      }
    }
  }

  block gross_margin_kpi: VizBlock {
    label: 'Gross Margin'
    settings {
      hide_label: true
      hide_controls: true
    }

    viz: MarkdownViz {
      dataset: thelook

      calculation current_month_gross_margin {
        label: 'Gross Margin'
        formula: @aql gross_margin | where(thelook_order_items.created_at matches @(this month));;
        calc_type: 'measure'
        data_type: 'number'
      }

      calculation previous_month_gross_margin {
        label: 'Previous Month Gross Margin'
        formula: @aql gross_margin | where(thelook_order_items.created_at matches @(last month));;
        calc_type: 'measure'
        data_type: 'number'
      }

      calculation gross_margin_mom_change {
        label: 'MoM Change'
        formula: @aql safe_divide(current_month_gross_margin - previous_month_gross_margin, previous_month_gross_margin);;
        calc_type: 'measure'
        data_type: 'number'
      }

      calculation gross_margin_mom_direction {
        label: 'MoM Direction'
        formula: @aql case(
          when: gross_margin_mom_change > 0, then: 'positive',
          when: gross_margin_mom_change < 0, then: 'negative',
          else: 'neutral'
        );;
        calc_type: 'measure'
        data_type: 'text'
      }

      values: [
        VizFieldFull {
          ref: 'current_month_gross_margin'
          label: 'Gross Margin'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        },
        VizFieldFull {
          ref: 'gross_margin_mom_change'
          label: 'MoM Change'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        },
        VizFieldFull {
          ref: 'gross_margin_mom_direction'
          label: 'MoM Direction'
          format {
            type: 'text'
          }
        },
      ]

      content: @md
        <style>
          .thelook-kpi-card { height:100%; box-sizing:border-box; padding:22px; border:1px solid #E3DBD1; border-radius:18px; background:#FFFDF9; color:#1B1F3B; font-family:'Manrope',Arial,sans-serif; }
          .thelook-kpi-top { display:flex; align-items:center; justify-content:space-between; }
          .thelook-kpi-icon { display:inline-flex; align-items:center; justify-content:center; width:42px; height:42px; border-radius:12px; background:#E8E7F4; color:#1B1F3B; font-size:20px; font-weight:800; }
          .thelook-kpi-label { margin-top:18px; color:#5B6477; font-size:13px; font-weight:600; letter-spacing:0.02em; }
          .thelook-kpi-value { margin-top:5px; color:#1B1F3B; font-size:31px; line-height:1.1; font-weight:800; letter-spacing:-1px; }
          .thelook-kpi-badge { display:inline-flex; align-items:center; gap:5px; margin-top:15px; padding:5px 9px; border-radius:999px; font-size:11px; font-weight:800; }
          .thelook-kpi-badge.positive { background:#DDF4F1; color:#1F9E8F; }
          .thelook-kpi-badge.negative { background:#FBE2E2; color:#D64545; }
          .thelook-kpi-badge.neutral { background:#EEEAE4; color:#5B6477; }
        </style>

        <div class="thelook-kpi-card">
          <div class="thelook-kpi-top">
            <div class="thelook-kpi-icon" aria-hidden="true">%</div>
            <span style="color:#5B6477; font-size:11px; font-weight:600;">MONTHLY</span>
          </div>
          <div class="thelook-kpi-label">Gross Margin</div>
          <div class="thelook-kpi-value">{{ rows[0].values.`Gross Margin` }}</div>
          <div class="thelook-kpi-badge {{ rows[0].values.`MoM Direction`.raw }}">
            <span>{{ rows[0].values.`MoM Direction`.raw }}</span>
            <span>{{ rows[0].values.`MoM Change` }} vs last month</span>
          </div>
        </div>
      ;;

      settings {
        row_limit: 1
      }
    }
  }

  block metric_note: TextBlock {
    content: @md
      <div style="
        display:flex;
        align-items:center;
        gap:10px;
        padding:0 6px;
        color:#5B6477;
        font-family:'Manrope', Arial, sans-serif;
        font-size:12px;
        line-height:1.5;
      ">
        <span style="
          display:inline-flex;
          align-items:center;
          justify-content:center;
          width:18px;
          height:18px;
          border-radius:50%;
          background:#1B1F3B;
          color:#F5EFE6;
          font-size:11px;
          font-weight:800;
        ">i</span>
        <span>
          Net Sales excludes cancelled and returned items. Gross Margin is Gross Profit as a share of Net Sales.
        </span>
      </div>
    ;;
  }

  view: CanvasLayout {
    width: 1440
    height: 460
    margin: 32
    grid_size: 8

    block branded_header {
      position: pos(32, 28, 1376, 86)
    }

    block net_sales_kpi {
      position: pos(32, 146, 326, 218)
    }

    block orders_kpi {
      position: pos(382, 146, 326, 218)
    }

    block aov_kpi {
      position: pos(732, 146, 326, 218)
    }

    block gross_margin_kpi {
      position: pos(1082, 146, 326, 218)
    }

    block metric_note {
      position: pos(32, 392, 1376, 34)
    }

    mobile: {
      mode: 'manual'

      block branded_header {
        height: 110
      }

      block net_sales_kpi {
        height: 205
      }

      block orders_kpi {
        height: 205
      }

      block aov_kpi {
        height: 205
      }

      block gross_margin_kpi {
        height: 205
      }

      block metric_note {
        height: 64
      }
    }
  }
}
