// benchmark/r03/r03_hai_html_a1.page.aml

Dashboard r03_hai_html_a1 {
  title: 'TheLook Business Review'
  description: 'Branded monthly business review for TheLook eCommerce.'
  theme: PageTheme {
    background {
      bg_color: '#F5EFE6'
    }

    block {
      label {
        font_family: 'Manrope, Arial, sans-serif'
        font_weight: 'extrabold'
        font_color: '#1B1F3B'
      }

      text {
        font_family: 'Manrope, Arial, sans-serif'
        font_color: '#1B1F3B'
      }

      background {
        bg_color: 'transparent'
      }

      border {
        border_style: 'none'
      }
    }

    viz {
      metric_kpi {
        alignment: 'left'

        value {
          font_family: 'Manrope, Arial, sans-serif'
          font_weight: 'extrabold'
          font_color: '#1B1F3B'
          font_size: '30px'
        }

        label {
          font_family: 'Manrope, Arial, sans-serif'
          font_weight: 'semibold'
          font_color: '#5B6477'
        }

        trend {
          positive {
            text {
              font_family: 'Manrope, Arial, sans-serif'
              font_weight: 'bold'
              font_color: '#1F9E8F'
            }

            background {
              bg_color: '#DDF4F1'
            }
          }

          negative {
            text {
              font_family: 'Manrope, Arial, sans-serif'
              font_weight: 'bold'
              font_color: '#D64545'
            }

            background {
              bg_color: '#FCE5E5'
            }
          }

          neutral {
            text {
              font_family: 'Manrope, Arial, sans-serif'
              font_weight: 'bold'
              font_color: '#5B6477'
            }

            background {
              bg_color: '#ECEEF2'
            }
          }
        }
      }
    }

    custom_css: @css
      @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;800&display=swap');

      * {
        font-family: 'Manrope', Arial, sans-serif;
      }
    ;;
  }

  block f_month: FilterBlock {
    label: 'Reporting month'
    type: 'field'

    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }

    default {
      operator: 'last'
      value: '1'
      modifier: 'month'
    }
  }

  block p_mom: PopBlock {
    label: 'Comparison'

    default {
      type: 'relative'
      duration: 1
      granularity: 'month'
      show_growth_rate: true
    }
  }

  block kpi_net_sales: VizBlock {
    label: 'Net Sales'
    settings {
      hide_label: true
    }

    viz: MetricKpi {
      dataset: thelook

      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'

        format {
          type: 'number'
          pattern: '[$$]#,###0'
        }
      }

      settings {
        alignment: 'left'
      }
    }
  }

  block kpi_orders: VizBlock {
    label: 'Orders'
    settings {
      hide_label: true
    }

    viz: MetricKpi {
      dataset: thelook

      value: VizFieldFull {
        ref: r(thelook.total_orders)
        label: 'Orders'

        format {
          type: 'number'
          pattern: 'inherited'
        }
      }

      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
  }

  block kpi_aov: VizBlock {
    label: 'Average Order Value'
    settings {
      hide_label: true
    }

    viz: MetricKpi {
      dataset: thelook

      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'

        format {
          type: 'number'
          pattern: 'inherited'
        }
      }

      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
  }

  block kpi_gross_margin: VizBlock {
    label: 'Gross Margin'
    settings {
      hide_label: true
    }

    viz: MetricKpi {
      dataset: thelook

      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'

        format {
          type: 'number'
          pattern: '#,###0.0%'
        }
      }

      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
  }

  block v_net_sales_trend: VizBlock {
    label: 'Net Sales Trend'

    viz: CombinationChart {
      dataset: thelook

      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        label: 'Month'
        transformation: 'datetrunc month'

        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }

      y_axis {
        label: 'Net Sales'

        series {
          mark_type: 'area'

          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales Area'
            merge_legend: true

            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }

        series {
          mark_type: 'line'

          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            merge_legend: true

            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }

      tooltips: [
        VizTooltip {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'

            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      ]

      settings {
        x_axis_label: 'Month'
        legend_label: 'hidden'
        show_data_points: true

        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'f_month'
      to: ['kpi_net_sales', 'kpi_aov', 'kpi_gross_margin', 'v_net_sales_trend']
      field: r(thelook_order_items.created_at)
    },

    FilterInteraction {
      from: 'f_month'
      to: ['kpi_orders']
      field: r(thelook_orders.created_at)
    },

    PopInteraction {
      from: 'p_mom'
      to: ['kpi_net_sales', 'kpi_aov', 'kpi_gross_margin', 'v_net_sales_trend']
      field: r(thelook_order_items.created_at)
    },

    PopInteraction {
      from: 'p_mom'
      to: ['kpi_orders']
      field: r(thelook_orders.created_at)
    }
  ]

  view: HTMLLayout {
    content: @html
      <style>
        .thelook-review {
          --ink: #1B1F3B;
          --coral: #FF6B5A;
          --sand: #F5EFE6;
          --teal: #1F9E8F;
          --alert: #D64545;
          --slate: #5B6477;
          --white: #FFFFFF;
          max-width: 1440px;
          margin: 0 auto;
          padding: 28px;
          color: var(--ink);
          background: var(--sand);
          box-sizing: border-box;
        }

        .thelook-review * {
          box-sizing: border-box;
        }

        .review-header {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 24px;
          padding: 25px 30px;
          border-radius: 20px;
          background: var(--white);
          border: 1px solid rgba(27, 31, 59, 0.08);
          box-shadow: 0 12px 32px rgba(27, 31, 59, 0.08);
        }

        .brand-lockup {
          display: flex;
          align-items: center;
          gap: 24px;
          min-width: 0;
        }

        .brand-logo {
          width: 176px;
          height: 40px;
          flex: 0 0 auto;
        }

        .header-rule {
          width: 1px;
          height: 40px;
          background: #E2DDD7;
          flex: 0 0 auto;
        }

        .header-copy {
          min-width: 0;
        }

        .eyebrow {
          margin: 0 0 3px;
          color: var(--coral);
          font-size: 11px;
          font-weight: 800;
          letter-spacing: 0.14em;
          text-transform: uppercase;
        }

        .header-title {
          margin: 0;
          color: var(--ink);
          font-size: 24px;
          font-weight: 800;
          letter-spacing: -0.04em;
          line-height: 1.15;
        }

        .header-subtitle {
          margin: 5px 0 0;
          color: var(--slate);
          font-size: 13px;
          font-weight: 400;
        }

        .controls {
          display: flex;
          align-items: center;
          justify-content: flex-end;
          gap: 10px;
          min-width: 340px;
        }

        .control-shell {
          min-width: 155px;
          padding: 2px 10px;
          border: 1px solid #E2DDD7;
          border-radius: 10px;
          background: #FCFAF7;
        }

        .performance-band {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 18px;
          margin: 32px 0 15px;
        }

        .section-title {
          margin: 0;
          color: var(--ink);
          font-size: 20px;
          font-weight: 800;
          letter-spacing: -0.035em;
        }

        .section-caption {
          display: flex;
          align-items: center;
          gap: 8px;
          margin: 0;
          color: var(--slate);
          font-size: 12px;
          font-weight: 600;
        }

        .live-dot {
          width: 8px;
          height: 8px;
          display: inline-block;
          border-radius: 50%;
          background: var(--teal);
          box-shadow: 0 0 0 4px rgba(31, 158, 143, 0.12);
        }

        .kpi-grid {
          display: grid;
          grid-template-columns: repeat(4, minmax(0, 1fr));
          gap: 16px;
        }

        .kpi-card {
          min-height: 190px;
          padding: 21px;
          overflow: hidden;
          position: relative;
          border: 1px solid rgba(27, 31, 59, 0.08);
          border-radius: 18px;
          background: var(--white);
          box-shadow: 0 8px 24px rgba(27, 31, 59, 0.06);
        }

        .kpi-card::after {
          position: absolute;
          top: 0;
          right: 0;
          width: 90px;
          height: 90px;
          content: '';
          background: linear-gradient(135deg, rgba(255, 107, 90, 0.09), transparent 68%);
          pointer-events: none;
        }

        .kpi-heading {
          display: flex;
          align-items: center;
          gap: 10px;
          margin-bottom: 10px;
          color: var(--slate);
          font-size: 12px;
          font-weight: 800;
          letter-spacing: 0.075em;
          text-transform: uppercase;
        }

        .kpi-icon {
          display: inline-flex;
          align-items: center;
          justify-content: center;
          width: 32px;
          height: 32px;
          border-radius: 10px;
          background: #FFF0ED;
          color: var(--coral);
        }

        .kpi-icon svg {
          width: 18px;
          height: 18px;
          stroke: currentColor;
          stroke-width: 2;
          fill: none;
          stroke-linecap: round;
          stroke-linejoin: round;
        }

        .kpi-value {
          min-height: 78px;
          position: relative;
          z-index: 1;
        }

        .kpi-value h-block {
          display: block;
        }

        .kpi-footnote {
          display: flex;
          align-items: center;
          gap: 7px;
          margin-top: 5px;
          color: var(--slate);
          font-size: 11px;
          font-weight: 600;
        }

        .mom-badge {
          display: inline-flex;
          align-items: center;
          gap: 5px;
          padding: 4px 7px;
          border-radius: 999px;
          background: #DDF4F1;
          color: var(--teal);
          font-size: 10px;
          font-weight: 800;
          letter-spacing: 0.02em;
          text-transform: uppercase;
        }

        .trend-panel {
          margin-top: 32px;
          padding: 25px;
          border: 1px solid rgba(27, 31, 59, 0.08);
          border-radius: 20px;
          background: var(--white);
          box-shadow: 0 8px 24px rgba(27, 31, 59, 0.06);
        }

        .trend-header {
          display: flex;
          align-items: flex-start;
          justify-content: space-between;
          gap: 20px;
          margin-bottom: 16px;
        }

        .trend-overline {
          margin: 0 0 4px;
          color: var(--coral);
          font-size: 11px;
          font-weight: 800;
          letter-spacing: 0.12em;
          text-transform: uppercase;
        }

        .trend-title {
          margin: 0;
          color: var(--ink);
          font-size: 19px;
          font-weight: 800;
          letter-spacing: -0.03em;
        }

        .trend-note {
          max-width: 310px;
          margin: 0;
          color: var(--slate);
          font-size: 12px;
          line-height: 1.55;
          text-align: right;
        }

        .trend-chart {
          min-height: 360px;
        }

        .trend-chart h-block {
          display: block;
          min-height: 360px;
        }

        .footer-note {
          margin: 20px 0 0;
          color: var(--slate);
          font-size: 11px;
          line-height: 1.5;
          text-align: center;
        }

        @media (max-width: 1040px) {
          .review-header {
            align-items: flex-start;
            flex-direction: column;
          }

          .controls {
            justify-content: flex-start;
            min-width: 0;
            width: 100%;
          }

          .kpi-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
          }
        }

        @media (max-width: 640px) {
          .thelook-review {
            padding: 16px;
          }

          .review-header,
          .trend-panel {
            padding: 20px;
          }

          .brand-lockup {
            align-items: flex-start;
            flex-direction: column;
            gap: 13px;
          }

          .header-rule {
            display: none;
          }

          .controls,
          .trend-header,
          .performance-band {
            align-items: flex-start;
            flex-direction: column;
          }

          .control-shell {
            width: 100%;
          }

          .kpi-grid {
            grid-template-columns: 1fr;
          }

          .trend-note {
            text-align: left;
          }
        }
      </style>

      <main class="thelook-review">
        <header class="review-header">
          <div class="brand-lockup">
            <img
              class="brand-logo"
              alt="thelook"
              src="data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='176' height='40' viewBox='0 0 176 40'%3E%3Ccircle cx='18' cy='20' r='11' fill='%23FF6B5A'/%3E%3Ccircle cx='18' cy='20' r='4.5' fill='%23F5EFE6'/%3E%3Ctext x='38' y='28' font-family='Manrope, Arial, sans-serif' font-size='24' font-weight='800' letter-spacing='-0.5' fill='%231B1F3B'%3Ethelook%3C/text%3E%3C/svg%3E"
            />

            <div class="header-rule"></div>

            <div class="header-copy">
              <p class="eyebrow">Commercial performance</p>
              <h1 class="header-title">Business Review</h1>
              <p class="header-subtitle">Monthly trading performance at a glance</p>
            </div>
          </div>

          <div class="controls">
            <div class="control-shell">
              <h-block name="f_month" />
            </div>

            <div class="control-shell">
              <h-block name="p_mom" />
            </div>
          </div>
        </header>

        <section aria-label="Key performance indicators">
          <div class="performance-band">
            <h2 class="section-title">Performance snapshot</h2>
            <p class="section-caption">
              <span class="live-dot"></span>
              Complete month · compared with prior month
            </p>
          </div>

          <div class="kpi-grid">
            <article class="kpi-card">
              <div class="kpi-heading">
                <span class="kpi-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24">
                    <path d="M3 6h18"></path>
                    <path d="M6 3v6"></path>
                    <path d="M18 3v6"></path>
                    <rect x="4" y="5" width="16" height="16" rx="2"></rect>
                    <path d="M8 13h8"></path>
                    <path d="M8 17h5"></path>
                  </svg>
                </span>
                Net Sales
              </div>

              <div class="kpi-value">
                <h-block name="kpi_net_sales" />
              </div>

              <div class="kpi-footnote">
                <span class="mom-badge">MoM</span>
                Sales after cancelled and returned items
              </div>
            </article>

            <article class="kpi-card">
              <div class="kpi-heading">
                <span class="kpi-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24">
                    <path d="M3 5h2l2 11h10l2-8H7"></path>
                    <circle cx="9" cy="20" r="1"></circle>
                    <circle cx="17" cy="20" r="1"></circle>
                  </svg>
                </span>
                Orders
              </div>

              <div class="kpi-value">
                <h-block name="kpi_orders" />
              </div>

              <div class="kpi-footnote">
                <span class="mom-badge">MoM</span>
                All placed orders
              </div>
            </article>

            <article class="kpi-card">
              <div class="kpi-heading">
                <span class="kpi-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24">
                    <path d="M4 6h16v12H4z"></path>
                    <path d="M4 10h16"></path>
                    <path d="M8 15h3"></path>
                  </svg>
                </span>
                AOV
              </div>

              <div class="kpi-value">
                <h-block name="kpi_aov" />
              </div>

              <div class="kpi-footnote">
                <span class="mom-badge">MoM</span>
                Net Sales per fulfilled order
              </div>
            </article>

            <article class="kpi-card">
              <div class="kpi-heading">
                <span class="kpi-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24">
                    <path d="M4 19V5"></path>
                    <path d="M4 19h16"></path>
                    <path d="M7 15l4-4 3 2 5-6"></path>
                    <path d="M16 7h3v3"></path>
                  </svg>
                </span>
                Gross Margin
              </div>

              <div class="kpi-value">
                <h-block name="kpi_gross_margin" />
              </div>

              <div class="kpi-footnote">
                <span class="mom-badge">MoM</span>
                Gross Profit as a share of Net Sales
              </div>
            </article>
          </div>
        </section>

        <section class="trend-panel" aria-label="Net Sales trend">
          <div class="trend-header">
            <div>
              <p class="trend-overline">Sales momentum</p>
              <h2 class="trend-title">Net Sales over time</h2>
            </div>

            <p class="trend-note">
              Use the reporting-month and comparison controls above to inspect month-over-month movement.
            </p>
          </div>

          <div class="trend-chart">
            <h-block name="v_net_sales_trend" />
          </div>
        </section>

        <p class="footer-note">
          Net Sales exclude cancelled and returned items. Gross Margin is calculated as Gross Profit divided by Net Sales.
        </p>
      </main>
    ;;
  }
}
