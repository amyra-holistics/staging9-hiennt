Dashboard r03_haid_canvas_a3 {
  title: 'Business Review'
  description: 'A branded monthly business review for TheLook commerce performance.'

  theme: PageTheme {
    background {
      bg_color: '#F5EFE6'
    }
    canvas {
      background {
        bg_color: '#F5EFE6'
      }
      border {
        border_color: '#F5EFE6'
        border_style: 'none'
      }
      shadow: 'none'
    }
    block {
      text {
        font_family: 'Manrope, Arial, sans-serif'
        font_color: '#1B1F3B'
        font_weight: 'normal'
      }
      label {
        font_family: 'Manrope, Arial, sans-serif'
        font_color: '#5B6477'
        font_weight: 'semibold'
      }
      background {
        bg_color: '#FFFFFF'
      }
      border {
        border_color: '#F5EFE6'
        border_style: 'solid'
        border_width: 1
        border_radius: 16
      }
      padding: 16
      shadow: 'sm'
    }
    viz {
      metric_kpi {
        alignment: 'left'
        label {
          font_family: 'Manrope, Arial, sans-serif'
          font_color: '#5B6477'
          font_weight: 'semibold'
        }
        value {
          font_family: 'Manrope, Arial, sans-serif'
          font_color: '#1B1F3B'
          font_weight: 'extrabold'
        }
        trend {
          positive {
            text { font_color: '#1F9E8F' }
            background { bg_color: '#E6F5F2' }
          }
          negative {
            text { font_color: '#D64545' }
            background { bg_color: '#FCE8E8' }
          }
        }
      }
    }
    custom_css: @css
      @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;800&display=swap');

      :root {
        --thelook-ink: #1B1F3B;
        --thelook-coral: #FF6B5A;
        --thelook-sand: #F5EFE6;
        --thelook-teal: #1F9E8F;
        --thelook-alert: #D64545;
        --thelook-slate: #5B6477;
      }

      .dac-text-block {
        background: transparent !important;
        border: none !important;
        box-shadow: none !important;
        padding: 0 !important;
      }

      .thelook-header {
        align-items: center;
        background: var(--thelook-ink);
        border-radius: 20px;
        box-sizing: border-box;
        color: #FFFFFF;
        display: flex;
        font-family: 'Manrope', Arial, sans-serif;
        gap: 18px;
        height: 100%;
        padding: 24px 32px;
      }

      .thelook-header img {
        flex: 0 0 48px;
        height: 48px;
        width: 48px;
      }

      .thelook-header__eyebrow {
        color: #FF6B5A;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.12em;
        margin: 0 0 2px;
        text-transform: uppercase;
      }

      .thelook-header__title {
        color: #FFFFFF;
        font-size: 28px;
        font-weight: 800;
        line-height: 1.15;
        margin: 0;
      }

      .thelook-header__subtitle {
        color: #F5EFE6;
        font-size: 13px;
        font-weight: 400;
        line-height: 1.4;
        margin: 5px 0 0;
      }
    ;;
  }

  block header: TextBlock {
    content: @md
      <section class="thelook-header" aria-label="TheLook Business Review">
        <img alt="TheLook logo" src="data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='176' height='40' viewBox='0 0 176 40'%3E%3Ccircle cx='18' cy='20' r='11' fill='%23FF6B5A'/%3E%3Ccircle cx='18' cy='20' r='4.5' fill='%23F5EFE6'/%3E%3Ctext x='38' y='28' font-family='Manrope, Arial, sans-serif' font-size='24' font-weight='800' letter-spacing='-0.5' fill='%231B1F3B'%3Ethelook%3C/text%3E%3C/svg%3E" />
        <div>
          <p class="thelook-header__eyebrow">TheLook Commerce</p>
          <h1 class="thelook-header__title">Business Review</h1>
          <p class="thelook-header__subtitle">Monthly performance snapshot with period-over-period comparison</p>
        </div>
      </section>
    ;;
  }

  block date_filter: FilterBlock {
    label: 'Reporting period'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
    default {
      operator: 'last'
      value: 1
      modifier: 'month'
      options { include_current_period: false }
    }
  }

  block period_comparison: PopBlock {
    label: 'Compare with'
    default {
      type: 'relative'
      duration: 1
      granularity: 'month'
      show_growth_rate: true
    }
  }

  block kpi_net_sales: VizBlock {
    label: '💰 Net Sales'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: '💰 Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block kpi_orders: VizBlock {
    label: '🛒 Orders'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.total_orders)
        label: '🛒 Orders'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block kpi_aov: VizBlock {
    label: '💰 Average Order Value'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: '💰 Average Order Value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block kpi_gross_margin: VizBlock {
    label: 'Gross Margin 📈'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin 📈'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'date_filter'
      to: ['kpi_net_sales', 'kpi_orders', 'kpi_aov', 'kpi_gross_margin']
      field: r(thelook_order_items.created_at)
    },
    PopInteraction {
      from: 'period_comparison'
      to: ['kpi_net_sales', 'kpi_orders', 'kpi_aov', 'kpi_gross_margin']
      field: r(thelook_order_items.created_at)
    }
  ]

  view: CanvasLayout {
    width: 1220
    height: 460
    grid_size: 20
    block header { position: pos(20, 20, 1180, 120) }
    block date_filter { position: pos(20, 160, 380, 100) }
    block period_comparison { position: pos(420, 160, 380, 100) }
    block kpi_net_sales { position: pos(20, 280, 280, 160) }
    block kpi_orders { position: pos(320, 280, 280, 160) }
    block kpi_aov { position: pos(620, 280, 280, 160) }
    block kpi_gross_margin { position: pos(920, 280, 280, 160) }
    mobile { mode: 'auto' }
  }
}
