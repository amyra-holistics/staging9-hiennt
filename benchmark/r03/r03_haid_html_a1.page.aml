Dashboard r03_haid_html_a1 {
  title: 'TheLook Business Review'
  description: @md
A responsive executive scorecard for reviewing sales performance, order volume, order value, and margin with date-range and month-over-month comparisons.
;;

  block f_order_date: FilterBlock {
    label: 'Review period'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block p_month_over_month: PopBlock {
    label: 'Compare with'
    default {
      type: 'relative'
      duration: 1
      granularity: 'month'
      show_growth_rate: true
    }
  }

  block k_net_sales: VizBlock {
    label: 'Net Sales'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.net_sales)
    label: 'Net Sales'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
}
  }

  block k_orders: VizBlock {
    label: 'Orders'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.total_orders)
    label: 'Orders'
    format {
      type: 'number'
      pattern: '#,###0'
    }
  }
}
  }

  block k_average_order_value: VizBlock {
    label: 'Average Order Value'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.aov)
    label: 'Average Order Value'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
}
  }

  block k_gross_margin: VizBlock {
    label: 'Gross Margin'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.gross_margin)
    label: 'Gross Margin'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
}
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'f_order_date'
      to: ['k_net_sales', 'k_average_order_value', 'k_gross_margin']
      field: r(thelook_order_items.created_at)
    },
    FilterInteraction {
      from: 'f_order_date'
      to: ['k_orders']
      field: r(thelook_orders.created_at)
    },
    PopInteraction {
      from: 'p_month_over_month'
      to: ['k_net_sales', 'k_average_order_value', 'k_gross_margin']
      field: r(thelook_order_items.created_at)
    },
    PopInteraction {
      from: 'p_month_over_month'
      to: ['k_orders']
      field: r(thelook_orders.created_at)
    }
  ]

  view: HTMLLayout {
    content: @html
<style>
  @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;800&display=swap');

  :root {
    --ink: #1B1F3B;
    --coral: #FF6B5A;
    --sand: #F5EFE6;
    --teal: #1F9E8F;
    --alert: #D64545;
    --slate: #5B6477;
    --surface: #FFFFFF;
  }

  .thelook-review {
    box-sizing: border-box;
    max-width: 1320px;
    margin: 0 auto;
    padding: 24px;
    background: var(--sand);
    color: var(--ink);
    font-family: 'Manrope', Arial, sans-serif;
  }

  .thelook-review *, .thelook-review *::before, .thelook-review *::after { box-sizing: border-box; }

  .review-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 28px 32px;
    border-radius: 20px;
    background: var(--ink);
    color: #FFFFFF;
  }

  .brand { display: flex; align-items: center; gap: 16px; min-width: 0; }
  .brand-logo { width: 48px; height: 48px; flex: 0 0 auto; }
  .eyebrow { margin: 0 0 4px; color: #FFB7AE; font-size: 11px; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; }
  .review-title { margin: 0; font-size: clamp(24px, 4vw, 38px); font-weight: 800; letter-spacing: -.04em; line-height: 1.08; }
  .review-subtitle { margin: 8px 0 0; color: #D8DBE8; font-size: 14px; font-weight: 400; }
  .brand-mark { color: #FFFFFF; font-size: 15px; font-weight: 800; letter-spacing: -.04em; white-space: nowrap; }

  .control-bar {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin: 24px 0;
    padding: 18px;
    border: 1px solid #E8DED1;
    border-radius: 16px;
    background: rgba(255, 255, 255, .82);
  }

  .control-cell { min-width: 0; }
  .control-cell .h-block { min-height: 0; }

  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .kpi-card {
    position: relative;
    overflow: hidden;
    min-width: 0;
    min-height: 208px;
    padding: 22px;
    border: 1px solid #E8DED1;
    border-radius: 18px;
    background: var(--surface);
    box-shadow: 0 8px 24px rgba(27, 31, 59, .06);
  }

  .kpi-card::after { content: ''; position: absolute; right: -28px; bottom: -38px; width: 112px; height: 112px; border-radius: 50%; background: var(--card-tint); opacity: .65; }
  .card-sales { --card-color: var(--coral); --card-tint: #FFE1DD; }
  .card-orders { --card-color: var(--teal); --card-tint: #D9F2EE; }
  .card-aov { --card-color: #7866D4; --card-tint: #E9E5FF; }
  .card-margin { --card-color: #D48B1D; --card-tint: #FFF0D7; }

  .kpi-card-top { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 10px; }
  .kpi-icon { display: grid; width: 42px; height: 42px; place-items: center; border-radius: 12px; color: var(--card-color); background: var(--card-tint); }
  .kpi-icon svg { width: 24px; height: 24px; stroke: currentColor; }
  .metric-shell { position: relative; z-index: 1; }

  .thelook-review .h-kpi-metric-kpi { color: var(--ink); font-family: 'Manrope', Arial, sans-serif; font-weight: 800; }
  .thelook-review .h-kpi-metric-label { color: var(--slate); font-family: 'Manrope', Arial, sans-serif; font-weight: 600; }
  .thelook-review .h-kpi-metric-diff .friendly-diff:not(.negative) { padding: 4px 8px; border-radius: 999px; background: #D9F2EE; color: #107065; font-weight: 800; }
  .thelook-review .h-kpi-metric-diff .friendly-diff.negative { padding: 4px 8px; border-radius: 999px; background: #FBE0E0; color: var(--alert); font-weight: 800; }

  .review-footer { margin: 22px 2px 0; color: var(--slate); font-size: 12px; font-weight: 600; }

  @media (max-width: 960px) {
    .kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 620px) {
    .thelook-review { padding: 14px; }
    .review-header { align-items: flex-start; flex-direction: column; padding: 22px; }
    .control-bar, .kpi-grid { grid-template-columns: 1fr; }
    .kpi-card { min-height: 190px; }
  }
</style>

<div class="thelook-review">
  <header class="review-header">
    <div class="brand">
      <img class="brand-logo" alt="TheLook" src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='16' fill='%23FF6B5A'/%3E%3Cpath d='M17 18h30v8H36v22h-8V26H17z' fill='white'/%3E%3C/svg%3E" />
      <div>
        <p class="eyebrow">Executive scorecard</p>
        <h1 class="review-title">Business Review</h1>
        <p class="review-subtitle">Commercial health at a glance, with a month-over-month lens.</p>
      </div>
    </div>
    <div class="brand-mark">THELOOK</div>
  </header>

  <section class="control-bar" aria-label="Business review controls">
    <div class="control-cell"><h-block name="f_order_date" /></div>
    <div class="control-cell"><h-block name="p_month_over_month" /></div>
  </section>

  <main class="kpi-grid" aria-label="Business review KPI cards">
    <section class="kpi-card card-sales">
      <div class="kpi-card-top"><div class="kpi-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M4 19V5m0 14h16"/><path d="m7 15 4-4 3 2 5-6"/></svg></div></div>
      <div class="metric-shell"><h-block name="k_net_sales" /></div>
    </section>
    <section class="kpi-card card-orders">
      <div class="kpi-card-top"><div class="kpi-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M6 3h12l1 5H5l1-5Z"/><path d="M5 8h14v12H5z"/><path d="M9 12h6"/></svg></div></div>
      <div class="metric-shell"><h-block name="k_orders" /></div>
    </section>
    <section class="kpi-card card-aov">
      <div class="kpi-card-top"><div class="kpi-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M4 6h16v12H4z"/><path d="M4 10h16"/><path d="M8 15h3"/></svg></div></div>
      <div class="metric-shell"><h-block name="k_average_order_value" /></div>
    </section>
    <section class="kpi-card card-margin">
      <div class="kpi-card-top"><div class="kpi-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M12 3 4 7v5c0 5 3.4 8.5 8 9 4.6-.5 8-4 8-9V7l-8-4Z"/><path d="m8.5 12 2.3 2.3 4.7-4.7"/></svg></div></div>
      <div class="metric-shell"><h-block name="k_gross_margin" /></div>
    </section>
  </main>

  <p class="review-footer">Use the review period to scope the scorecard and Compare with for month-over-month change.</p>
</div>
;;
  }
}
