Dashboard r03_haid_html_a2 {
  title: 'TheLook · Commerce Pulse'
  description: @md
    A branded monthly business review for TheLook commerce leaders. Each KPI compares the most recent complete month with the prior month.
  ;;
  theme: PageTheme {
    background {
      bg_color: '#F5EFE6'
    }
    canvas {
      background {
        bg_color: '#F5EFE6'
      }
      shadow: 'none'
      opacity: 1
    }
    block {
      background {
        bg_color: '#FFFFFF'
      }
      border {
        border_color: '#E2D9CC'
        border_style: 'solid'
        border_width {
          top: 1
          right: 1
          bottom: 1
          left: 1
        }
        border_radius {
          top_left: 18
          top_right: 18
          bottom_left: 18
          bottom_right: 18
        }
      }
      label {
        font_family: 'Manrope'
        font_color: '#1B1F3B'
        font_weight: 'bold'
        font_size: 14
      }
      text {
        font_family: 'Manrope'
        font_color: '#5B6477'
        font_size: 14
      }
      padding {
        top: 0
        right: 0
        bottom: 0
        left: 0
      }
      shadow: 'none'
      opacity: 1
    }
    custom_css: @css
      @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;800&display=swap');

      :root {
        --haid-ink: #1B1F3B;
        --haid-coral: #FF6B5A;
        --haid-sand: #F5EFE6;
        --haid-teal: #1F9E8F;
        --haid-alert: #D64545;
        --haid-slate: #5B6477;
      }

      .haid-shell,
      .haid-shell * {
        box-sizing: border-box;
      }

      .haid-shell {
        max-width: 1320px;
        margin: 0 auto;
        padding: 32px 28px 44px;
        color: var(--haid-ink);
        font-family: 'Manrope', Arial, sans-serif;
      }

      .haid-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 28px;
        padding: 6px 0 26px;
        border-bottom: 1px solid #DCD2C4;
      }

      .haid-brand {
        display: flex;
        align-items: center;
        gap: 14px;
      }

      .haid-logo {
        width: 45px;
        height: 45px;
        flex: 0 0 45px;
      }

      .haid-wordmark {
        color: var(--haid-ink);
        font-size: 20px;
        font-weight: 800;
        letter-spacing: .12em;
        line-height: 1;
      }

      .haid-eyebrow {
        margin: 7px 0 0;
        color: var(--haid-slate);
        font-size: 11px;
        font-weight: 800;
        letter-spacing: .14em;
        text-transform: uppercase;
      }

      .haid-context {
        margin: 0;
        color: var(--haid-slate);
        font-size: 13px;
        font-weight: 600;
        text-align: right;
      }

      .haid-context strong {
        color: var(--haid-teal);
        font-weight: 800;
      }

      .haid-heading {
        margin: 38px 0 8px;
        color: var(--haid-ink);
        font-size: clamp(28px, 4vw, 42px);
        font-weight: 800;
        letter-spacing: -.045em;
        line-height: 1.12;
      }

      .haid-subhead {
        max-width: 650px;
        margin: 0 0 28px;
        color: var(--haid-slate);
        font-size: 15px;
        line-height: 1.65;
      }

      .haid-rule {
        width: 54px;
        height: 5px;
        margin-bottom: 26px;
        border-radius: 999px;
        background: var(--haid-coral);
      }

      .haid-kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 18px;
      }

      .haid-kpi-grid h-block {
        display: block;
        min-width: 0;
      }

      .haid-kpi-grid .dac-viz-block,
      .haid-kpi-grid .viz-block-container {
        height: 100%;
        overflow: hidden;
        border: 1px solid #E6DED3 !important;
        border-radius: 18px !important;
        background: #FFFFFF !important;
        box-shadow: 0 10px 28px rgba(29, 39, 51, .06) !important;
        transition: transform .18s ease, box-shadow .18s ease;
      }

      .haid-kpi-grid .dac-viz-block:hover,
      .haid-kpi-grid .viz-block-container:hover {
        box-shadow: 0 15px 32px rgba(29, 39, 51, .11) !important;
        transform: translateY(-2px);
      }

      @media (max-width: 960px) {
        .haid-kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      }

      @media (max-width: 600px) {
        .haid-shell { padding: 22px 16px 32px; }
        .haid-header { align-items: flex-start; flex-direction: column; gap: 18px; }
        .haid-context { text-align: left; }
        .haid-heading { margin-top: 30px; }
        .haid-kpi-grid { grid-template-columns: 1fr; gap: 14px; }
      }
    ;;
  }

  block v_net_sales: VizBlock {
    label: 'Net Sales'
    settings { hide_label: true }
    viz: MarkdownViz {
      dataset: thelook
      calculation previous_month_net_sales {
        label: 'Previous Month Net Sales'
        formula: @aql net_sales | relative_period(thelook_order_items.created_at, interval(-1 month));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation mom_change {
        label: 'MoM Change'
        formula: @aql safe_divide(net_sales - previous_month_net_sales, previous_month_net_sales) * 100.0;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation mom_direction {
        label: 'MoM Direction'
        formula: @aql case(when: net_sales > previous_month_net_sales, then: 'up', when: net_sales < previous_month_net_sales, then: 'down', else: 'flat');;
        calc_type: 'measure'
        data_type: 'text'
      }
      filter {
        field: r(thelook_order_items.created_at)
        operator: 'matches'
        value: 'last month'
      }
      values: [
        VizFieldFull { ref: r(thelook.net_sales) label: 'Net Sales' format { type: 'number' pattern: '[$$]#,###0' } },
        VizFieldFull { ref: 'previous_month_net_sales' label: 'Previous Month Net Sales' },
        VizFieldFull { ref: 'mom_change' label: 'MoM Change' format { type: 'number' pattern: '#,###0.0\\%' } },
        VizFieldFull { ref: 'mom_direction' label: 'MoM Direction' }
      ]
      content: @md
        <style>
          .kpi{padding:20px;border:1px solid #E5E7EB;border-radius:12px;background:#FFF;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}.h{display:flex;align-items:center;gap:9px;color:#64748B;font-size:14px;font-weight:700}.i{display:grid;place-items:center;width:32px;height:32px;border-radius:8px;background:#EFF6FF;font-size:17px}.v{margin:15px 0 11px;color:#0F172A;font-size:36px;font-weight:700;line-height:1}.b{display:inline-flex;align-items:center;gap:5px;padding:5px 9px;border-radius:999px;font-size:12px;font-weight:700}.b.up{background:#DCFCE7;color:#15803D}.b.down{background:#FEE2E2;color:#B91C1C}.b.flat{background:#F1F5F9;color:#475569}.b.up:before{content:"↑"}.b.down:before{content:"↓"}.b.flat:before{content:"→"}.n{margin-left:6px;color:#64748B;font-size:12px}
        </style>
        <div class="kpi"><div class="h"><span class="i">🛍</span>Net Sales</div><div class="v">{{ rows[0].values.`Net Sales` }}</div><span class="b {{ rows[0].values.`MoM Direction`.raw }}">{{ rows[0].values.`MoM Change` }}</span><span class="n">vs. prior month</span></div>
      ;;
      settings { row_limit: 1 }
    }
  }

  block v_orders: VizBlock {
    label: 'Orders'
    settings { hide_label: true }
    viz: MarkdownViz {
      dataset: thelook
      calculation prior_orders {
        label: 'Prior Orders'
        formula: @aql total_orders | relative_period(thelook_orders.created_at, interval(-1 month));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation mom_change {
        label: 'MoM Change'
        formula: @aql safe_divide(total_orders - prior_orders, prior_orders);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation mom_direction {
        label: 'MoM Direction'
        formula: @aql case(when: total_orders > prior_orders, then: 'up', when: total_orders < prior_orders, then: 'down', else: 'flat');;
        calc_type: 'measure'
        data_type: 'text'
      }
      filter {
        field: r(thelook_orders.created_at)
        operator: 'matches'
        value: 'last month'
      }
      values: [
        VizFieldFull { ref: r(thelook.total_orders) label: 'Orders' format { type: 'number' pattern: '#,###0' } },
        VizFieldFull { ref: 'prior_orders' label: 'Prior Orders' },
        VizFieldFull { ref: 'mom_change' label: 'MoM Change' format { type: 'number' pattern: '#,###0.0%' } },
        VizFieldFull { ref: 'mom_direction' label: 'MoM Direction' }
      ]
      content: @md
        <style>
          .kpi{padding:20px;border:1px solid #E5E7EB;border-radius:12px;background:#FFF;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}.h{display:flex;align-items:center;gap:9px;color:#64748B;font-size:14px;font-weight:700}.i{display:grid;place-items:center;width:32px;height:32px;border-radius:8px;background:#EFF6FF;font-size:17px}.v{margin:15px 0 11px;color:#0F172A;font-size:36px;font-weight:700;line-height:1}.b{display:inline-flex;align-items:center;gap:5px;padding:5px 9px;border-radius:999px;font-size:12px;font-weight:700}.b.up{background:#DCFCE7;color:#15803D}.b.down{background:#FEE2E2;color:#B91C1C}.b.flat{background:#F1F5F9;color:#475569}.b.up:before{content:"↑"}.b.down:before{content:"↓"}.b.flat:before{content:"→"}.n{margin-left:6px;color:#64748B;font-size:12px}
        </style>
        <div class="kpi"><div class="h"><span class="i">🧾</span>Orders</div><div class="v">{{ rows[0].values.`Orders` }}</div><span class="b {{ rows[0].values.`MoM Direction`.raw }}">{{ rows[0].values.`MoM Change` }}</span><span class="n">vs. prior month</span></div>
      ;;
      settings { row_limit: 1 }
    }
  }

  block v_aov: VizBlock {
    label: 'Average Order Value'
    settings { hide_label: true }
    viz: MarkdownViz {
      dataset: thelook
      calculation prior_aov {
        label: 'Prior AOV'
        formula: @aql aov | relative_period(thelook_order_items.created_at, interval(-1 month));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation mom_change {
        label: 'MoM Change'
        formula: @aql safe_divide(aov - prior_aov, prior_aov);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation mom_direction {
        label: 'MoM Direction'
        formula: @aql case(when: aov > prior_aov, then: 'up', when: aov < prior_aov, then: 'down', else: 'flat');;
        calc_type: 'measure'
        data_type: 'text'
      }
      filter {
        field: r(thelook_order_items.created_at)
        operator: 'matches'
        value: 'last month'
      }
      values: [
        VizFieldFull { ref: r(thelook.aov) label: 'AOV' format { type: 'number' pattern: '[$$]#,###0.00' } },
        VizFieldFull { ref: 'prior_aov' label: 'Prior AOV' },
        VizFieldFull { ref: 'mom_change' label: 'MoM Change' format { type: 'number' pattern: '#,###0.0%' } },
        VizFieldFull { ref: 'mom_direction' label: 'MoM Direction' }
      ]
      content: @md
        <style>
          .kpi{padding:20px;border:1px solid #E5E7EB;border-radius:12px;background:#FFF;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}.h{display:flex;align-items:center;gap:9px;color:#64748B;font-size:14px;font-weight:700}.i{display:grid;place-items:center;width:32px;height:32px;border-radius:8px;background:#EFF6FF;font-size:17px}.v{margin:15px 0 11px;color:#0F172A;font-size:36px;font-weight:700;line-height:1}.b{display:inline-flex;align-items:center;gap:5px;padding:5px 9px;border-radius:999px;font-size:12px;font-weight:700}.b.up{background:#DCFCE7;color:#15803D}.b.down{background:#FEE2E2;color:#B91C1C}.b.flat{background:#F1F5F9;color:#475569}.b.up:before{content:"↑"}.b.down:before{content:"↓"}.b.flat:before{content:"→"}.n{margin-left:6px;color:#64748B;font-size:12px}
        </style>
        <div class="kpi"><div class="h"><span class="i">🏷</span>Average Order Value</div><div class="v">{{ rows[0].values.`AOV` }}</div><span class="b {{ rows[0].values.`MoM Direction`.raw }}">{{ rows[0].values.`MoM Change` }}</span><span class="n">vs. prior month</span></div>
      ;;
      settings { row_limit: 1 }
    }
  }

  block v_gross_margin: VizBlock {
    label: 'Gross Margin'
    settings { hide_label: true }
    viz: MarkdownViz {
      dataset: thelook
      calculation prior_margin {
        label: 'Prior Margin'
        formula: @aql gross_margin | relative_period(thelook_order_items.created_at, interval(-1 month));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation pp_change {
        label: 'MoM Change'
        formula: @aql (gross_margin - prior_margin) * 100.0;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation mom_direction {
        label: 'MoM Direction'
        formula: @aql case(when: gross_margin > prior_margin, then: 'up', when: gross_margin < prior_margin, then: 'down', else: 'flat');;
        calc_type: 'measure'
        data_type: 'text'
      }
      filter {
        field: r(thelook_order_items.created_at)
        operator: 'matches'
        value: 'last month'
      }
      values: [
        VizFieldFull { ref: r(thelook.gross_margin) label: 'Gross Margin' format { type: 'number' pattern: '#,###0.0%' } },
        VizFieldFull { ref: 'prior_margin' label: 'Prior Margin' },
        VizFieldFull { ref: 'pp_change' label: 'MoM Change' format { type: 'number' pattern: '#,###0.0' } },
        VizFieldFull { ref: 'mom_direction' label: 'MoM Direction' }
      ]
      content: @md
        <style>
          .kpi{padding:20px;border:1px solid #E5E7EB;border-radius:12px;background:#FFF;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}.h{display:flex;align-items:center;gap:9px;color:#64748B;font-size:14px;font-weight:700}.i{display:grid;place-items:center;width:32px;height:32px;border-radius:8px;background:#EEF2FF;font-size:17px}.v{margin:15px 0 11px;color:#0F172A;font-size:36px;font-weight:700;line-height:1}.b{display:inline-flex;align-items:center;gap:5px;padding:5px 9px;border-radius:999px;font-size:12px;font-weight:700}.b.up{background:#DCFCE7;color:#15803D}.b.down{background:#FEE2E2;color:#B91C1C}.b.flat{background:#F1F5F9;color:#475569}.b.up:before{content:"↑"}.b.down:before{content:"↓"}.b.flat:before{content:"→"}.n{margin-left:6px;color:#64748B;font-size:12px}
        </style>
        <div class="kpi"><div class="h"><span class="i">◈</span>Gross Margin</div><div class="v">{{ rows[0].values.`Gross Margin` }}</div><span class="b {{ rows[0].values.`MoM Direction`.raw }}">{{ rows[0].values.`MoM Change` }} pp</span><span class="n">vs. prior month</span></div>
      ;;
      settings { row_limit: 1 }
    }
  }

  view: HTMLLayout {
    content: @html
      <div class="haid-shell">
        <header class="haid-header">
          <div class="haid-brand">
            <img class="thelook-logo" alt="thelook" src="data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='176' height='40' viewBox='0 0 176 40'%3E%3Ccircle cx='18' cy='20' r='11' fill='%23FF6B5A'/%3E%3Ccircle cx='18' cy='20' r='4.5' fill='%23F5EFE6'/%3E%3Ctext x='38' y='28' font-family='Manrope, Arial, sans-serif' font-size='24' font-weight='800' letter-spacing='-0.5' fill='%231B1F3B'%3Ethelook%3C/text%3E%3C/svg%3E" />
            <div>
              <p class="haid-eyebrow">Commerce intelligence</p>
            </div>
          </div>
          <p class="haid-context"><strong>Monthly pulse</strong><br />Latest completed month</p>
        </header>

        <main>
          <h1 class="haid-heading">Performance, at a glance.</h1>
          <p class="haid-subhead">A focused readout of the four commercial signals that matter most—each benchmarked against the prior month.</p>
          <div class="haid-rule"></div>
          <section class="haid-kpi-grid" aria-label="Monthly commerce key performance indicators">
            <h-block name="v_net_sales" />
            <h-block name="v_orders" />
            <h-block name="v_aov" />
            <h-block name="v_gross_margin" />
          </section>
        </main>
      </div>
    ;;
  }
}
