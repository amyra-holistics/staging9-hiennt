Dashboard r03_haid_html_a3 {
  title: 'thelook | Executive Business Review'
  description: @md
    A leadership view of net sales, fulfilled orders, average order value, gross margin, monthly performance, and category contribution.
  ;;

  block f_date: FilterBlock {
    label: 'Reporting period'
    type: 'date'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block f_category: FilterBlock {
    label: 'Category'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.category)
    }
  }

  block f_brand: FilterBlock {
    label: 'Brand'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.brand)
    }
  }

  block f_country: FilterBlock {
    label: 'Customer country'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.country)
    }
  }

  block f_status: FilterBlock {
    label: 'Item status'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.status)
    }
  }

  block p_mom: PopBlock {
    label: 'Month-over-month comparison'
    default {
      type: 'relative'
      duration: 1
      granularity: 'month'
      show_growth_rate: true
    }
  }

  block kpi_net_sales: VizBlock {
    label: 'Net Sales'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.net_sales)
    label: 'Net Sales'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
  compare_value: VizPopSettings {
    field: r(thelook_order_items.created_at)
    show_growth_rate: true
    value {
      duration: 1
      granularity: 'month'
    }
  }
  settings {
    display_mode: 'compare_by_percent'
    compare_value {
      reverse_color: false
    }
  }
}
  }

  block kpi_orders: VizBlock {
    label: 'Orders'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.fulfilled_orders)
    label: 'Orders'
    format {
      type: 'number'
      pattern: '#,###0'
    }
  }
  compare_value: VizPopSettings {
    field: r(thelook_order_items.created_at)
    value {
      duration: 1
      granularity: 'month'
    }
  }
  settings {
    display_mode: 'compare_by_percent'
    alignment: 'center'
  }
}
  }

  block kpi_aov: VizBlock {
    label: 'Average Order Value'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.aov)
    label: 'Average Order Value'
    format {
      type: 'number'
      pattern: 'inherited'
    }
    uname: 'custom_aov_1'
  }
  settings {
    display_mode: 'compare_by_percent'
  }
}
  }

  block kpi_gross_margin: VizBlock {
    label: 'Gross Margin'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.gross_margin)
    label: 'Gross Margin'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
  settings {
    display_mode: 'compare_by_percent'
  }
}
  }

  block v_sales_trend: VizBlock {
    label: 'Monthly Net Sales Trend'
    viz: CombinationChart {
  dataset: thelook
  x_axis: VizFieldFull {
    ref: r(thelook_order_items.created_at)
    label: 'Month'
    transformation: 'datetrunc month'
    format {
      type: 'date'
      pattern: 'LLL yyyy'
    }
  }
  y_axis {
    series {
      mark_type: 'line'
      field: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }
  settings {
    x_axis_label: 'Month'
    legend_label: 'hidden'
    show_data_points: false
    sort: LineFamilySort {
      type: 'xaxis'
      direction: 'asc'
    }
  }
}
  }

  block v_category_sales: VizBlock {
    label: 'Net Sales by Product Category'
    viz: CombinationChart {
  dataset: thelook
  calculation net_sales_rank {
    label: 'Net Sales Rank'
    formula: @aql rank(order: net_sales | desc(), partition: []);;
    calc_type: 'measure'
    data_type: 'number'
  }
  x_axis: VizFieldFull {
    ref: r(thelook_products.category)
    label: 'Product Category'
  }
  y_axis {
    label: 'Net Sales'
    series {
      mark_type: 'bar'
      field: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }
  tooltips: [
    VizTooltip {
      field: VizFieldFull {
        ref: 'net_sales_rank'
        label: 'Net Sales Rank'
        format {
          type: 'number'
          pattern: '#,###'
        }
      }
    }
  ]
  settings {
    sort: LineFamilySort {
      type: 'yaxis'
      field_index: 0
      direction: 'desc'
    }
  }
}
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'f_date'
      to: ['kpi_net_sales', 'kpi_orders', 'kpi_aov', 'kpi_gross_margin', 'v_sales_trend', 'v_category_sales']
      field: r(thelook_order_items.created_at)
    },
    FilterInteraction {
      from: 'f_category'
      to: ['kpi_net_sales', 'kpi_orders', 'kpi_aov', 'kpi_gross_margin', 'v_sales_trend', 'v_category_sales']
      field: r(thelook_products.category)
    },
    FilterInteraction {
      from: 'f_brand'
      to: ['kpi_net_sales', 'kpi_orders', 'kpi_aov', 'kpi_gross_margin', 'v_sales_trend', 'v_category_sales']
      field: r(thelook_products.brand)
    },
    FilterInteraction {
      from: 'f_country'
      to: ['kpi_net_sales', 'kpi_orders', 'kpi_aov', 'kpi_gross_margin', 'v_sales_trend', 'v_category_sales']
      field: r(thelook_users.country)
    },
    FilterInteraction {
      from: 'f_status'
      to: ['kpi_net_sales', 'kpi_orders', 'kpi_aov', 'kpi_gross_margin', 'v_sales_trend', 'v_category_sales']
      field: r(thelook_order_items.status)
    },
    PopInteraction {
      from: 'p_mom'
      to: ['kpi_net_sales', 'kpi_orders', 'kpi_aov', 'kpi_gross_margin']
      field: r(thelook_order_items.created_at)
    }
  ]

  view: HTMLLayout {
    content: @html
      <style>
        @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;800&display=swap');
        .r03-look-review { --ink:#1B1F3B; --coral:#FF6B5A; --sand:#F5EFE6; --teal:#1F9E8F; --alert:#D64545; --slate:#5B6477; background:var(--sand); color:var(--ink); font-family:Manrope,Arial,sans-serif; padding:28px; }
        .r03-look-review * { box-sizing:border-box; }
        .r03-look-review .masthead { display:flex; justify-content:space-between; align-items:flex-start; gap:24px; padding:8px 0 24px; border-bottom:2px solid var(--ink); }
        .r03-look-review .brand-logo { width:176px; height:40px; display:block; }
        .r03-look-review .eyebrow { margin:20px 0 6px; color:var(--coral); font-size:12px; font-weight:800; letter-spacing:.14em; text-transform:uppercase; }
        .r03-look-review h1 { margin:0; font-size:clamp(28px,4vw,46px); font-weight:800; letter-spacing:-.055em; line-height:1.05; }
        .r03-look-review .context { margin:10px 0 0; color:var(--slate); font-size:14px; font-weight:600; }
        .r03-look-review .reporting-note { max-width:290px; color:var(--slate); font-size:12px; line-height:1.6; text-align:right; }
        .r03-look-review .control-grid { display:grid; grid-template-columns:1.35fr repeat(5,minmax(145px,1fr)); gap:12px; margin:22px 0; }
        .r03-look-review .control { background:#fff; border:1px solid rgba(27,31,59,.14); border-radius:12px; min-height:82px; padding:6px 10px; }
        .r03-look-review .kpi-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:16px; }
        .r03-look-review .kpi-card { position:relative; overflow:hidden; background:var(--ink); border-radius:16px; color:#fff; min-height:188px; padding:18px; box-shadow:0 8px 20px rgba(27,31,59,.13); }
        .r03-look-review .kpi-card:nth-child(2) { background:#24305a; }
        .r03-look-review .kpi-card:nth-child(3) { background:#173f51; }
        .r03-look-review .kpi-card:nth-child(4) { background:#542e3a; }
        .r03-look-review .kpi-top { display:flex; align-items:center; justify-content:space-between; gap:12px; }
        .r03-look-review .kpi-name { font-size:12px; font-weight:800; letter-spacing:.1em; text-transform:uppercase; }
        .r03-look-review .icon-wrap { display:grid; place-items:center; width:36px; height:36px; border-radius:10px; background:rgba(255,255,255,.13); color:var(--coral); }
        .r03-look-review .kpi-card:nth-child(3) .icon-wrap { color:var(--teal); }
        .r03-look-review .kpi-card:nth-child(4) .icon-wrap { color:#ffb1a8; }
        .r03-look-review .kpi-value { margin-top:13px; }
        .r03-look-review .kpi-card h-block { display:block; }
        .r03-look-review .kpi-card h-block * { color:inherit; }
        .r03-look-review .section-head { display:flex; justify-content:space-between; align-items:end; gap:16px; margin:34px 0 14px; }
        .r03-look-review h2 { margin:0; font-size:21px; font-weight:800; letter-spacing:-.035em; }
        .r03-look-review .section-head p { margin:0; color:var(--slate); font-size:13px; }
        .r03-look-review .chart-grid { display:grid; grid-template-columns:minmax(0,1.55fr) minmax(330px,.95fr); gap:16px; }
        .r03-look-review .chart-card { background:#fff; border:1px solid rgba(27,31,59,.12); border-radius:16px; min-height:390px; padding:12px; box-shadow:0 8px 20px rgba(27,31,59,.06); }
        .r03-look-review .chart-card h-block { display:block; height:100%; }
        .r03-look-review .footer { display:flex; justify-content:space-between; gap:20px; margin-top:20px; padding-top:16px; border-top:1px solid rgba(27,31,59,.18); color:var(--slate); font-size:11px; line-height:1.5; }
        @media (max-width:1180px) { .r03-look-review .control-grid { grid-template-columns:repeat(3,1fr); } .r03-look-review .kpi-grid { grid-template-columns:repeat(2,1fr); } }
        @media (max-width:760px) { .r03-look-review { padding:18px; } .r03-look-review .masthead,.r03-look-review .section-head,.r03-look-review .footer { display:block; } .r03-look-review .reporting-note { text-align:left; margin-top:14px; } .r03-look-review .control-grid,.r03-look-review .kpi-grid,.r03-look-review .chart-grid { grid-template-columns:1fr; } .r03-look-review .chart-card { min-height:330px; } }
      </style>
      <main class="r03-look-review">
        <header class="masthead">
          <div>
            <img class="brand-logo" alt="thelook" src="data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='176' height='40' viewBox='0 0 176 40'%3E%3Ccircle cx='18' cy='20' r='11' fill='%23FF6B5A'/%3E%3Ccircle cx='18' cy='20' r='4.5' fill='%23F5EFE6'/%3E%3Ctext x='38' y='28' font-family='Manrope, Arial, sans-serif' font-size='24' font-weight='800' letter-spacing='-0.5' fill='%231B1F3B'%3Ethelook%3C/text%3E%3C/svg%3E" />
            <p class="eyebrow">Executive business review</p>
            <h1>Sales performance, with the why close at hand.</h1>
            <p class="context">Net sales recognize fulfilled merchandise only; cancelled and returned items are excluded.</p>
          </div>
          <div class="reporting-note">Use the reporting period and commercial filters to focus the review. Change badges compare the selected period to the prior month.</div>
        </header>

        <section class="control-grid" aria-label="Review controls">
          <div class="control"><h-block name="f_date" /></div>
          <div class="control"><h-block name="p_mom" /></div>
          <div class="control"><h-block name="f_category" /></div>
          <div class="control"><h-block name="f_brand" /></div>
          <div class="control"><h-block name="f_country" /></div>
          <div class="control"><h-block name="f_status" /></div>
        </section>

        <section class="kpi-grid" aria-label="Executive metrics">
          <article class="kpi-card"><div class="kpi-top"><span class="kpi-name">Net sales</span><span class="icon-wrap"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 3v18h18"/><path d="m7 15 4-4 3 3 6-7"/></svg></span></div><div class="kpi-value"><h-block name="kpi_net_sales" /></div></article>
          <article class="kpi-card"><div class="kpi-top"><span class="kpi-name">Orders</span><span class="icon-wrap"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 7h15l-2 9H8L6 4H3"/><circle cx="9" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg></span></div><div class="kpi-value"><h-block name="kpi_orders" /></div></article>
          <article class="kpi-card"><div class="kpi-top"><span class="kpi-name">Average order value</span><span class="icon-wrap"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 12V7a2 2 0 0 0-2-2H6l-3 7 9 9 7-7z"/><circle cx="8.5" cy="8.5" r="1.2"/></svg></span></div><div class="kpi-value"><h-block name="kpi_aov" /></div></article>
          <article class="kpi-card"><div class="kpi-top"><span class="kpi-name">Gross margin</span><span class="icon-wrap"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3 4 7v5c0 5 3.4 8.4 8 9 4.6-.6 8-4 8-9V7l-8-4z"/><path d="m8 12 2.5 2.5L16 9"/></svg></span></div><div class="kpi-value"><h-block name="kpi_gross_margin" /></div></article>
        </section>

        <section>
          <div class="section-head"><div><p class="eyebrow">Momentum</p><h2>How net sales are moving</h2></div><p>Monthly view of recognized sales in the selected reporting period.</p></div>
          <div class="chart-grid">
            <article class="chart-card"><h-block name="v_sales_trend" /></article>
            <article class="chart-card"><h-block name="v_category_sales" /></article>
          </div>
        </section>

        <footer class="footer"><span>thelook executive business review</span><span>Metric scope: fulfilled merchandise only for Net Sales, Orders, AOV, and Gross Margin.</span></footer>
      </main>
    ;;
  }
}
