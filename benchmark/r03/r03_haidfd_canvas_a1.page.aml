Dashboard r03_haidfd_canvas_a1 {
  title: 'Business review'
  description: @md
A concise operating review for monitoring commercial performance, month-over-month movement, and the sales drivers behind it.
  ;;

  theme: PageTheme {
    background {
      bg_color: '#F5EFE6'
    }
    canvas {
      background {
        bg_color: '#F5EFE6'
      }
      shadow: 'none'
    }
    block {
      background {
        bg_color: '#FFFFFF'
      }
      border {
        border_color: '#E6DED3'
        border_width: 1
        border_radius: 12
      }
      padding: 16
      shadow: 'none'
      label {
        font_color: '#1B1F3B'
        font_weight: 'semibold'
      }
      text {
        font_color: '#5B6477'
      }
    }
    viz {
      metric_kpi {
        alignment: 'left'
        label {
          font_color: '#5B6477'
          font_weight: 'semibold'
        }
        value {
          font_color: '#1B1F3B'
          font_weight: 'extrabold'
        }
        trend {
          positive {
            text {
              font_color: '#1F9E8F'
              font_weight: 'bold'
            }
            background {
              bg_color: '#E1F3F0'
            }
          }
          negative {
            text {
              font_color: '#D64545'
              font_weight: 'bold'
            }
            background {
              bg_color: '#FBE7E7'
            }
          }
        }
      }
    }
    custom_css: @css
@import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;800&display=swap');

* { font-family: 'Manrope', sans-serif !important; }
.dac-text-block { background: transparent !important; border: 0 !important; box-shadow: none !important; }
.dac-text-block h2 { color: #1B1F3B !important; font-size: 22px !important; font-weight: 800 !important; line-height: 1.2 !important; margin: 0 !important; }
.dac-text-block p { color: #5B6477 !important; font-size: 14px !important; font-weight: 400 !important; line-height: 1.5 !important; margin: 6px 0 0 !important; }
.dac-viz-block-label { color: #1B1F3B !important; font-weight: 800 !important; }
    ;;
  }

  block brand_header: TextBlock {
    content: @md
<div style="display:flex;align-items:center;gap:16px;height:100%;">
  <img alt="TheLook" style="width:48px;height:48px;" src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48'%3E%3Crect width='48' height='48' rx='12' fill='%231B1F3B'/%3E%3Cpath d='M13 15h22v6H27v14h-6V21h-8z' fill='%23FF6B5A'/%3E%3C/svg%3E" />
  <div>
    <h2>Business review</h2>
    <p>Set the date range and category first; use Period Comparison to read movement against the previous period.</p>
  </div>
</div>
    ;;
  }

  block f_date_range: FilterBlock {
    label: 'Date range'
    type: 'date'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block f_product_category: FilterBlock {
    label: 'Product category'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.category)
    }
  }

  block p_period_comparison: PopBlock {
    label: 'Period comparison'
    default {
      type: 'relative'
      duration: 1
      granularity: 'month'
      show_growth_rate: true
    }
  }

  block kpi_net_sales: VizBlock {
    label: '◈ Net Sales'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        value: RelativePopValue {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
      }
    }
  }

  block kpi_orders: VizBlock {
    label: '◎ Orders'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.total_orders)
        label: 'Orders'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        value {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
      }
    }
  }

  block kpi_aov: VizBlock {
    label: '◌ AOV'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        value {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
      }
    }
  }

  block kpi_gross_margin: VizBlock {
    label: '◇ Gross Margin'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        value {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
      }
    }
  }

  block trend_section: TextBlock {
    content: @md
## Sales trajectory
<p>Use the monthly trend to confirm whether the selected period is accelerating or softening.</p>
    ;;
  }

  block v_monthly_net_sales: VizBlock {
    label: 'Monthly Net Sales'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        label: 'Month'
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        series {
          mark_type: 'line'
          field: VizFieldFull {
            label: 'Net Sales'
            ref: r(thelook.net_sales)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block drivers_section: TextBlock {
    content: @md
## Sales drivers
<p>Compare category mix with item-status contribution to identify where the selected period is being won or lost.</p>
    ;;
  }

  block v_net_sales_by_category: VizBlock {
    label: 'Net Sales by Product Category'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Product Category'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block v_net_sales_by_item_status: VizBlock {
    label: 'Net Sales by Order Item Status'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.status)
        label: 'Order Item Status'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'f_date_range'
      to: ['kpi_net_sales', 'kpi_orders', 'kpi_aov', 'kpi_gross_margin', 'v_monthly_net_sales', 'v_net_sales_by_category', 'v_net_sales_by_item_status']
      field: r(thelook_order_items.created_at)
    },
    FilterInteraction {
      from: 'f_product_category'
      to: ['kpi_net_sales', 'kpi_orders', 'kpi_aov', 'kpi_gross_margin', 'v_monthly_net_sales', 'v_net_sales_by_category', 'v_net_sales_by_item_status']
      field: r(thelook_products.category)
    },
    PopInteraction {
      from: 'p_period_comparison'
      to: ['kpi_net_sales', 'kpi_orders', 'kpi_aov', 'kpi_gross_margin', 'v_monthly_net_sales']
      field: r(thelook_order_items.created_at)
    }
  ]

  view: TabLayout {
    tab business_review: CanvasLayout {
      label: 'Business review'
      width: 1220
      height: 1460
      grid_size: 20
      auto_expand_vertically: true
      block brand_header { position: pos(20, 20, 1180, 120) layer: 1 }
      block f_date_range { position: pos(20, 160, 380, 100) layer: 1 }
      block f_product_category { position: pos(420, 160, 380, 100) layer: 1 }
      block p_period_comparison { position: pos(820, 160, 380, 100) layer: 1 }
      block kpi_net_sales { position: pos(20, 280, 280, 140) layer: 1 }
      block kpi_orders { position: pos(320, 280, 280, 140) layer: 1 }
      block kpi_aov { position: pos(620, 280, 280, 140) layer: 1 }
      block kpi_gross_margin { position: pos(920, 280, 280, 140) layer: 1 }
      block trend_section { position: pos(20, 440, 1180, 100) layer: 1 }
      block v_monthly_net_sales { position: pos(20, 560, 1180, 400) layer: 1 }
      block drivers_section { position: pos(20, 980, 1180, 100) layer: 1 }
      block v_net_sales_by_category { position: pos(20, 1100, 580, 340) layer: 1 }
      block v_net_sales_by_item_status { position: pos(620, 1100, 580, 340) layer: 1 }
      mobile { mode: 'auto' }
    }
  }
}
