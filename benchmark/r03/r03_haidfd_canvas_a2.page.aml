PageTheme r03_haidfd_thelook_theme {
  background {
    bg_color: '#F5EFE6'
  }

  canvas {
    border {
      border_style: 'none'
      border_width {
        top: 0
        left: 0
        right: 0
        bottom: 0
      }
    }
    shadow: 'none'
    background {
      bg_color: '#F5EFE6'
    }
  }

  block {
    text {
      font_size: 14
      font_color: '#1B1F3B'
      font_style: 'normal'
      font_family: 'Manrope, Arial, sans-serif'
      font_weight: 'normal'
    }
    label {
      font_size: 13
      font_color: '#1B1F3B'
      font_style: 'normal'
      font_family: 'Manrope, Arial, sans-serif'
      font_weight: 'semibold'
    }
    border {
      border_color: '#E4DCCF'
      border_style: 'solid'
      border_width {
        top: 1
        left: 1
        right: 1
        bottom: 1
      }
      border_radius {
        top_left: 14
        top_right: 14
        bottom_left: 14
        bottom_right: 14
      }
    }
    shadow: 'sm'
    opacity: 1
    padding {
      top: 16
      left: 16
      right: 16
      bottom: 16
    }
    background {
      bg_color: '#FFFFFF'
    }
  }

  custom_css: @css
    @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap');

    .dac-canvas {
      background: #F5EFE6;
    }

    .dac-viz-block,
    .dac-ic-block {
      box-shadow: 0 10px 24px rgba(27, 31, 59, 0.08);
    }

    .dac-viz-block-label,
    .dac-ic-block-label {
      color: #1B1F3B;
      font-family: 'Manrope', Arial, sans-serif;
      font-weight: 800;
    }

    .h-kpi-metric-kpi {
      color: #1B1F3B;
      font-family: 'Manrope', Arial, sans-serif;
      font-weight: 800;
    }

    .h-kpi-metric-label {
      color: #5B6477;
      font-family: 'Manrope', Arial, sans-serif;
      font-weight: 700;
    }

    .h-kpi-metric-diff .friendly-diff:not(.negative) {
      background: rgba(31, 158, 143, 0.14);
      color: #1F9E8F;
      border: 1px solid rgba(31, 158, 143, 0.24);
      border-radius: 999px;
      font-weight: 800;
    }

    .h-kpi-metric-diff .friendly-diff.negative {
      background: rgba(214, 69, 69, 0.12);
      color: #D64545;
      border: 1px solid rgba(214, 69, 69, 0.20);
      border-radius: 999px;
      font-weight: 800;
    }

    .h-theme-control-block {
      --h-select-text: #1B1F3B;
      --h-select-placeholder: #5B6477;
      --h-select-border: #D8D0C5;
      --h-select-border-hover: #1F9E8F;
      --h-select-border-focus: #1F9E8F;
      --h-select-trigger-icon: #1B1F3B;
      --h-input-text-color: #1B1F3B;
      --h-input-placeholder-color: #5B6477;
      --h-input-border: #D8D0C5;
      --h-input-border-hover: #1F9E8F;
      --h-input-border-focus: #1F9E8F;
      --h-badge-bg: #F5EFE6;
      --h-badge-text: #1B1F3B;
      --h-badge-border: #D8D0C5;
    }

    .highcharts-xaxis-labels span,
    .highcharts-yaxis-labels span {
      color: #5B6477 !important;
      font-family: 'Manrope', Arial, sans-serif !important;
    }
  ;;
}

Dashboard r03_haidfd_canvas_a2 {
  title: 'TheLook Business Review'
  description: @md
A business-review dashboard for monitoring sales performance, comparing periods, and identifying merchandise drivers.
  ;;
  theme: r03_haidfd_thelook_theme

  block b_header: TextBlock {
    content: @md
<div class="thelook-brand-header">
  <img src="data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='176' height='40' viewBox='0 0 176 40'%3E%3Ccircle cx='18' cy='20' r='11' fill='%23FF6B5A'/%3E%3Ccircle cx='18' cy='20' r='4.5' fill='%23F5EFE6'/%3E%3Ctext x='38' y='28' font-family='Manrope, Arial, sans-serif' font-size='24' font-weight='800' letter-spacing='-0.5' fill='%231B1F3B'%3Ethelook%3C/text%3E%3C/svg%3E" alt="TheLook" width="176" height="40" style="display:block;width:176px;height:40px;margin-bottom:8px;" />
  <div style="font-size:30px;line-height:1.12;font-weight:800;color:#1B1F3B;">Business review</div>
  <div style="margin-top:8px;font-size:14px;line-height:1.5;color:#5B6477;">Monitor commercial health, compare periods, and focus the merchandising conversation.</div>
</div>
    ;;
    theme: BlockTheme {
      border {
        border_style: 'none'
        border_width {
          top: 0
          left: 0
          right: 0
          bottom: 0
        }
      }
      shadow: 'none'
      background {
        bg_color: 'transparent'
      }
    }
  }

  block f_date: FilterBlock {
    label: 'Date'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
    default {
      operator: 'matches'
      value: '$H_NIL$'
    }
  }

  block f_brand: FilterBlock {
    label: 'Brand'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.brand)
    }
    default {
      operator: 'matches'
      value: '$H_NIL$'
    }
  }

  block f_category: FilterBlock {
    label: 'Category'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.category)
    }
    default {
      operator: 'matches'
      value: '$H_NIL$'
    }
  }

  block p_period_comparison: PopBlock {
    label: 'Period Comparison'
    default {
      type: 'relative'
      duration: []
    }
  }

  block v_net_sales: VizBlock {
    label: 'Net Sales · Revenue icon'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block v_total_orders: VizBlock {
    label: 'Orders · Order icon'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.total_orders)
        label: 'Orders'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block v_aov: VizBlock {
    label: 'Average Order Value · Basket icon'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        label: 'Average Order Value'
        ref: r(thelook.aov)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block v_gross_margin: VizBlock {
    label: 'Gross Margin · Margin icon'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block b_trend_heading: TextBlock {
    content: @md
<div style="font-size:20px;font-weight:800;color:#1B1F3B;">Sales pulse</div>
<div style="margin-top:4px;font-size:13px;color:#5B6477;">Monthly net sales, shaped by your current filters and comparison choice.</div>
    ;;
    theme: BlockTheme {
      border {
        border_style: 'none'
        border_width {
          top: 0
          left: 0
          right: 0
          bottom: 0
        }
      }
      shadow: 'none'
      background {
        bg_color: 'transparent'
      }
    }
  }

  block v_monthly_net_sales: VizBlock {
    label: 'Monthly Net Sales'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        label: 'Month'
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        series {
          mark_type: 'line'
          field: VizFieldFull {
            label: 'Net Sales'
            ref: r(thelook.net_sales)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block b_drivers_heading: TextBlock {
    content: @md
<div style="font-size:20px;font-weight:800;color:#1B1F3B;">Merchandise drivers</div>
<div style="margin-top:4px;font-size:13px;color:#5B6477;">See which categories and brands are contributing the most net sales.</div>
    ;;
    theme: BlockTheme {
      border {
        border_style: 'none'
        border_width {
          top: 0
          left: 0
          right: 0
          bottom: 0
        }
      }
      shadow: 'none'
      background {
        bg_color: 'transparent'
      }
    }
  }

  block v_net_sales_by_category: VizBlock {
    label: 'Net Sales by Category'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Product Category'
      }
      y_axis {
        series {
          mark_type: 'bar'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block v_net_sales_by_brand: VizBlock {
    label: 'Net Sales by Brand'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.brand)
        label: 'Brand'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          mark_type: 'bar'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'f_date'
      to: ['v_net_sales', 'v_total_orders', 'v_aov', 'v_gross_margin', 'v_monthly_net_sales', 'v_net_sales_by_category', 'v_net_sales_by_brand']
      field: r(thelook_order_items.created_at)
    },
    FilterInteraction {
      from: 'f_date'
      to: ['f_brand', 'f_category']
      disabled: true
    },
    FilterInteraction {
      from: 'f_brand'
      to: ['v_net_sales', 'v_total_orders', 'v_aov', 'v_gross_margin', 'v_monthly_net_sales', 'v_net_sales_by_category', 'v_net_sales_by_brand']
      field: r(thelook_products.brand)
    },
    FilterInteraction {
      from: 'f_brand'
      to: ['f_date', 'f_category']
      disabled: true
    },
    FilterInteraction {
      from: 'f_category'
      to: ['v_net_sales', 'v_total_orders', 'v_aov', 'v_gross_margin', 'v_monthly_net_sales', 'v_net_sales_by_category', 'v_net_sales_by_brand']
      field: r(thelook_products.category)
    },
    FilterInteraction {
      from: 'f_category'
      to: ['f_date', 'f_brand']
      disabled: true
    },
    PopInteraction {
      from: 'p_period_comparison'
      to: ['v_net_sales', 'v_total_orders', 'v_aov', 'v_gross_margin', 'v_monthly_net_sales']
      field: r(thelook_order_items.created_at)
    }
  ]

  settings {
    autorun_on_open: true
    autorun_on_changes: true
  }

  view: TabLayout {
    tab business_review: CanvasLayout {
      label: 'Business Review'
      width: 1220
      height: 1500
      grid_size: 20
      auto_expand_vertically: true

      block b_header { position: pos(20, 20, 1180, 140) layer: 1 }
      block f_date { position: pos(20, 180, 280, 100) layer: 1 }
      block f_brand { position: pos(320, 180, 280, 100) layer: 1 }
      block f_category { position: pos(620, 180, 280, 100) layer: 1 }
      block p_period_comparison { position: pos(920, 180, 280, 100) layer: 1 }

      block v_net_sales { position: pos(20, 300, 280, 160) layer: 1 }
      block v_total_orders { position: pos(320, 300, 280, 160) layer: 1 }
      block v_aov { position: pos(620, 300, 280, 160) layer: 1 }
      block v_gross_margin { position: pos(920, 300, 280, 160) layer: 1 }

      block b_trend_heading { position: pos(20, 480, 1180, 80) layer: 1 }
      block v_monthly_net_sales { position: pos(20, 580, 1180, 380) layer: 1 }

      block b_drivers_heading { position: pos(20, 980, 1180, 80) layer: 1 }
      block v_net_sales_by_category { position: pos(20, 1080, 580, 380) layer: 1 }
      block v_net_sales_by_brand { position: pos(620, 1080, 580, 380) layer: 1 }

      mobile {
        mode: 'auto'
      }
    }
  }
}
