Dashboard r03_haidfd_html_a1 {
  title: 'TheLook Business Review'
  description: @md
A branded business review for monitoring commercial performance over time.
;;

  block date_range: FilterBlock {
    label: 'Reporting period'
    type: 'date'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block month_over_month: PopBlock {
    label: 'Compare to'
    default {
      type: 'relative'
      duration: 1
      granularity: 'month'
      show_growth_rate: true
    }
  }

  block net_sales_kpi: VizBlock {
    label: 'Net Sales'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
        label {
          font_size: 14
        }
        metric_value {
          font_size: 32
        }
      }
    }
  }

  block orders_kpi: VizBlock {
    label: 'Orders'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.total_orders)
        label: 'Orders'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        alignment: 'left'
        label {
          font_size: 14
        }
        metric_value {
          font_size: 36
        }
      }
    }
  }

  block average_order_value_kpi: VizBlock {
    label: 'Average Order Value'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Avg. order value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
        label {
          font_color: '#475569'
          font_size: 14
        }
        metric_value {
          font_color: '#0F3D5E'
          font_size: 36
        }
      }
    }
  }

  block gross_margin_kpi: VizBlock {
    label: 'Gross Margin'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
        label {
          font_size: 14
        }
        metric_value {
          font_size: 32
        }
      }
    }
  }

  block monthly_net_sales_trend: VizBlock {
    label: 'Monthly Net Sales Trend'
    settings { hide_label: true }
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        label: 'Month'
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        label: 'Net Sales'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            label: 'Net Sales'
            ref: r(thelook.net_sales)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        x_axis_label: 'Month'
        legend_label: 'hidden'
        show_data_points: false
        connect_discontinuous_points: false
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'date_range'
      to: [
        'net_sales_kpi',
        'orders_kpi',
        'average_order_value_kpi',
        'gross_margin_kpi',
        'monthly_net_sales_trend'
      ]
      field: r(thelook_order_items.created_at)
    },
    FilterInteraction {
      from: 'date_range'
      to: ['month_over_month']
      disabled: true
    },
    PopInteraction {
      from: 'month_over_month'
      to: [
        'net_sales_kpi',
        'orders_kpi',
        'average_order_value_kpi',
        'gross_margin_kpi',
        'monthly_net_sales_trend'
      ]
      field: r(thelook_order_items.created_at)
    }
  ]

  view: HTMLLayout {
    content: @html
      <div class="thelook-review">
        <style>
          @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap');

          .thelook-review,
          .thelook-review * { box-sizing: border-box; }

          .thelook-review {
            --ink: #1B1F3B;
            --coral: #FF6B5A;
            --sand: #F5EFE6;
            --teal: #1F9E8F;
            --alert: #D64545;
            --slate: #5B6477;
            --paper: #FFFFFF;
            font-family: 'Manrope', sans-serif;
            color: var(--ink);
            background: var(--sand);
            padding: clamp(16px, 3vw, 44px);
            min-height: 100%;
          }

          .thelook-review .shell { max-width: 1440px; margin: 0 auto; }
          .thelook-review .hero {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 28px;
            padding: clamp(24px, 4vw, 54px);
            color: #FFFFFF;
            background: var(--ink);
            border-radius: 28px 28px 8px 8px;
            border-bottom: 6px solid var(--coral);
          }
          .thelook-review .brand { display: flex; align-items: center; gap: 14px; }
          .thelook-review .brand img { width: 42px; height: 42px; display: block; }
          .thelook-review .brand-name { font-size: 22px; font-weight: 800; letter-spacing: -0.05em; }
          .thelook-review .hero h1 { margin: 18px 0 8px; max-width: 680px; font-size: clamp(30px, 4vw, 52px); line-height: 1.05; letter-spacing: -0.055em; }
          .thelook-review .hero p { margin: 0; max-width: 600px; color: #D8DBE8; font-size: 15px; line-height: 1.65; }
          .thelook-review .hero-note { color: #FFFFFF; font-size: 13px; font-weight: 700; white-space: nowrap; }
          .thelook-review .hero-note span { color: var(--coral); }

          .thelook-review .controls {
            display: grid;
            grid-template-columns: minmax(240px, 1fr) minmax(240px, 1fr);
            gap: 16px;
            padding: 20px;
            background: #FFFFFF;
            border: 1px solid rgba(27, 31, 59, .10);
            border-top: 0;
            border-radius: 0 0 24px 24px;
          }
          .thelook-review .control { min-width: 0; }
          .thelook-review h-block { display: block; }

          .thelook-review .kpi-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 16px;
            margin-top: 24px;
          }
          .thelook-review .kpi-shell {
            position: relative;
            min-width: 0;
            overflow: hidden;
            padding: 22px 18px 14px;
            background: var(--paper);
            border: 1px solid rgba(27, 31, 59, .10);
            border-radius: 18px;
            box-shadow: 0 12px 28px rgba(27, 31, 59, .07);
          }
          .thelook-review .kpi-shell::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 5px;
            background: var(--accent);
          }
          .thelook-review .kpi-icon {
            position: absolute;
            top: 14px;
            right: 14px;
            width: 32px;
            height: 32px;
            padding: 7px;
            color: var(--accent);
            background: color-mix(in srgb, var(--accent) 12%, white);
            border-radius: 10px;
          }
          .thelook-review .kpi-icon svg { display: block; width: 100%; height: 100%; }
          .thelook-review .sales { --accent: var(--coral); }
          .thelook-review .orders { --accent: var(--teal); }
          .thelook-review .aov { --accent: var(--ink); }
          .thelook-review .margin { --accent: var(--alert); }

          .thelook-review .trend-surface {
            margin-top: 24px;
            padding: clamp(20px, 3vw, 32px);
            background: #FFFFFF;
            border: 1px solid rgba(27, 31, 59, .10);
            border-radius: 22px;
            box-shadow: 0 14px 34px rgba(27, 31, 59, .08);
          }
          .thelook-review .section-heading {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 16px;
            margin-bottom: 20px;
          }
          .thelook-review .section-heading h2 { margin: 0; font-size: 22px; letter-spacing: -0.04em; }
          .thelook-review .section-heading p { margin: 5px 0 0; color: var(--slate); font-size: 14px; line-height: 1.55; }
          .thelook-review .trend-chip { padding: 7px 10px; color: var(--teal); background: rgba(31, 158, 143, .10); border-radius: 999px; font-size: 12px; font-weight: 800; white-space: nowrap; }

          @media (max-width: 1000px) {
            .thelook-review .kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
          }
          @media (max-width: 680px) {
            .thelook-review { padding: 12px; }
            .thelook-review .hero { align-items: flex-start; flex-direction: column; border-radius: 20px 20px 6px 6px; }
            .thelook-review .controls, .thelook-review .kpi-grid { grid-template-columns: 1fr; }
            .thelook-review .section-heading { flex-direction: column; }
          }
        </style>

        <main class="shell">
          <header class="hero">
            <div>
              <div class="brand">
                <img alt="TheLook" src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48'%3E%3Cpath fill='%23FF6B5A' d='M24 3 42 13v22L24 45 6 35V13z'/%3E%3Cpath fill='%23F5EFE6' d='M14 16h20v5H27v13h-6V21h-7z'/%3E%3C/svg%3E" />
                <span class="brand-name">thelook</span>
              </div>
              <h1>Business review</h1>
              <p>Track the commercial signals that matter: realized sales, demand, order value, and margin — with a clear month-over-month comparison.</p>
            </div>
            <div class="hero-note"><span>●</span> Commercial performance</div>
          </header>

          <section class="controls" aria-label="Review controls">
            <div class="control"><h-block name="date_range" /></div>
            <div class="control"><h-block name="month_over_month" /></div>
          </section>

          <section class="kpi-grid" aria-label="Key performance indicators">
            <article class="kpi-shell sales">
              <span class="kpi-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19V5M4 19h16"/><path d="m7 15 4-4 3 3 5-7"/></svg></span>
              <h-block name="net_sales_kpi" />
            </article>
            <article class="kpi-shell orders">
              <span class="kpi-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 7h14l-1 12H6L5 7Z"/><path d="M9 9V5a3 3 0 0 1 6 0v4"/></svg></span>
              <h-block name="orders_kpi" />
            </article>
            <article class="kpi-shell aov">
              <span class="kpi-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 5h16v14H4z"/><path d="M8 15h8M8 10h3"/></svg></span>
              <h-block name="average_order_value_kpi" />
            </article>
            <article class="kpi-shell margin">
              <span class="kpi-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3 4 7v5c0 5 3.4 8.8 8 9 4.6-.2 8-4 8-9V7l-8-4Z"/><path d="m8.5 12 2.2 2.2 4.8-5"/></svg></span>
              <h-block name="gross_margin_kpi" />
            </article>
          </section>

          <section class="trend-surface">
            <div class="section-heading">
              <div>
                <h2>Net sales, month by month</h2>
                <p>A long-view trend of realized sales. Use the reporting period and comparison controls above to focus the review.</p>
              </div>
              <span class="trend-chip">Monthly cadence</span>
            </div>
            <h-block name="monthly_net_sales_trend" />
          </section>
        </main>
      </div>
    ;;
  }
}
