Dashboard r04_claude_canvas_a2 {
  title: 'Monthly Performance Review'
  description: 'Five 16:9 slides covering one reporting month: headline KPIs, 12-month trend, category breakdown and key takeaways.'

  // ---------- Slide 1: Title ----------
  block t_cover: TextBlock {
    content: @md
<div style="padding: 120px 100px; color: #FFFFFF;">
  <div style="font-size: 20px; letter-spacing: 4px; text-transform: uppercase; color: #9DB4E8;">TheLook eCommerce</div>
  <div style="font-size: 72px; font-weight: 700; margin-top: 24px; line-height: 1.1;">Monthly Performance Review</div>
  <div style="font-size: 26px; margin-top: 28px; color: #D5DEF2;">Sales, profitability and category mix for the reporting month</div>
  <div style="width: 120px; height: 6px; background: #4F8BFF; margin-top: 48px;"></div>
  <div style="font-size: 18px; margin-top: 40px; color: #9DB4E8;">Pick the reporting month below. It defaults to the last complete month.</div>
</div>
    ;;
    theme {
      background {
        bg_color: '#14213D'
      }
      border {
        border_width: 0
        border_radius: 0
      }
    }
  }

  block f_month: FilterBlock {
    label: 'Reporting Month'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
    default {
      operator: 'matches'
      value: 'last month'
    }
  }

  // ---------- Slide 2: Headline KPIs ----------
  block h_kpis: TextBlock {
    content: @md
## Headline KPIs
<span style="color: #6B7280;">Reporting month vs the previous month</span>
    ;;
  }

  block k_net_sales: VizBlock {
    label: 'Net Sales'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value: RelativePopValue {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'center'
        metric_value {
          font_size: 48
        }
      }
    }
  }

  block k_gross_profit: VizBlock {
    label: 'Gross Profit'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_profit)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value: RelativePopValue {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'center'
        metric_value {
          font_size: 48
        }
      }
    }
  }

  block k_gross_margin: VizBlock {
    label: 'Gross Margin'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value: RelativePopValue {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'center'
        metric_value {
          font_size: 48
        }
      }
    }
  }

  block k_orders: VizBlock {
    label: 'Fulfilled Orders'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value: RelativePopValue {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'center'
        metric_value {
          font_size: 48
        }
      }
    }
  }

  block k_aov: VizBlock {
    label: 'Average Order Value'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value: RelativePopValue {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'center'
        metric_value {
          font_size: 48
        }
      }
    }
  }

  block k_return_rate: VizBlock {
    label: 'Return Rate'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.return_rate)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value: RelativePopValue {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'center'
        metric_value {
          font_size: 48
        }
        compare_value {
          reverse_color: true
        }
      }
    }
  }

  block n_kpis: TextBlock {
    content: @md
<span style="color: #6B7280; font-size: 13px;">Net Sales, Gross Profit, Fulfilled Orders and AOV exclude Cancelled and Returned items. Return Rate counts returned items against all items, so a rise is shown in red.</span>
    ;;
  }

  // ---------- Slide 3: Trend ----------
  block h_trend: TextBlock {
    content: @md
## 12-Month Trend
<span style="color: #6B7280;">Net sales (columns) and fulfilled orders (line) for the last 12 complete months</span>
    ;;
  }

  block v_trend: VizBlock {
    label: 'Net Sales and Fulfilled Orders by Month'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        label: 'Net Sales'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#3B6FE0'
          }
        }
        settings {
          alignment: 'left'
          show_data_label_by: 'value'
        }
      }
      y_axis {
        label: 'Fulfilled Orders'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.fulfilled_orders)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#F28E2B'
          }
        }
        settings {
          alignment: 'right'
        }
      }
      filter {
        field: r(thelook_order_items.created_at)
        operator: 'last'
        value: 12
        modifier: 'month'
        options {
          include_current_period: false
        }
      }
      settings {
        legend_label: 'top'
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block n_trend: TextBlock {
    content: @md
<span style="color: #6B7280; font-size: 13px;">This slide always shows the last 12 complete months and ignores the Reporting Month filter.</span>
    ;;
  }

  // ---------- Slide 4: Category breakdown ----------
  block h_category: TextBlock {
    content: @md
## Category Breakdown
<span style="color: #6B7280;">Net sales by product category in the reporting month</span>
    ;;
  }

  block v_category_bar: VizBlock {
    label: 'Top 10 Categories by Net Sales'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Category'
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#3B6FE0'
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      settings {
        legend_label: 'hidden'
        row_limit: 10
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block v_category_table: VizBlock {
    label: 'Category Scorecard'
    viz: DataTable {
      dataset: thelook
      calculation mom_growth {
        label: 'MoM Growth'
        formula: @aql safe_divide(
          net_sales - (net_sales | relative_period(thelook_order_items.created_at, interval(-1 month))),
          net_sales | relative_period(thelook_order_items.created_at, interval(-1 month))
        );;
        calc_type: 'measure'
        data_type: 'number'
      }
      fields: [
        VizFieldFull {
          ref: r(thelook_products.category)
          label: 'Category'
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: '% of Total'
          analytic: PercentOfTotalField {
            of_all: 'grand_total'
          }
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        },
        VizFieldFull {
          ref: 'mom_growth'
          label: 'MoM Growth'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        },
        VizFieldFull {
          ref: r(thelook.gross_margin)
          label: 'Gross Margin'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.return_rate)
          label: 'Return Rate'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        pagination_size: 12
        sorts: [
          IndexBasedSortSetting {
            field_index: 1
            direction: 'desc'
          }
        ]
      }
    }
  }

  // ---------- Slide 5: Key takeaways ----------
  block h_takeaways: TextBlock {
    content: @md
## Key Takeaways
<span style="color: #6B7280;">Generated from the reporting month's data, so it updates with the filter</span>
    ;;
  }

  block v_takeaways: VizBlock {
    label: 'Key Takeaways'
    viz: MarkdownViz {
      dataset: thelook

      calculation share_of_sales {
        label: 'Share of Sales'
        formula: @aql safe_divide(net_sales, net_sales | of_all(thelook_products.category));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation total_net_sales {
        label: 'Total Net Sales'
        formula: @aql net_sales | of_all(thelook_products.category);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation prev_net_sales {
        label: 'Prev Net Sales'
        formula: @aql net_sales | of_all(thelook_products.category) | relative_period(thelook_order_items.created_at, interval(-1 month));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation sales_growth {
        label: 'Sales Growth'
        formula: @aql safe_divide(
          (net_sales | of_all(thelook_products.category)) - (net_sales | of_all(thelook_products.category) | relative_period(thelook_order_items.created_at, interval(-1 month))),
          net_sales | of_all(thelook_products.category) | relative_period(thelook_order_items.created_at, interval(-1 month))
        );;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation total_orders_m {
        label: 'Total Orders'
        formula: @aql fulfilled_orders | of_all(thelook_products.category);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation total_aov {
        label: 'Total AOV'
        formula: @aql aov | of_all(thelook_products.category);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation total_margin {
        label: 'Total Margin'
        formula: @aql gross_margin | of_all(thelook_products.category);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation total_return_rate {
        label: 'Total Return Rate'
        formula: @aql return_rate | of_all(thelook_products.category);;
        calc_type: 'measure'
        data_type: 'number'
      }

      rows: [
        VizFieldFull {
          ref: r(thelook_products.category)
          label: 'Category'
        }
      ]
      values: [
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: 'share_of_sales'
          label: 'Share of Sales'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        },
        VizFieldFull {
          ref: 'total_net_sales'
          label: 'Total Net Sales'
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
        },
        VizFieldFull {
          ref: 'prev_net_sales'
          label: 'Prev Net Sales'
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
        },
        VizFieldFull {
          ref: 'sales_growth'
          label: 'Sales Growth'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        },
        VizFieldFull {
          ref: 'total_orders_m'
          label: 'Total Orders'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: 'total_aov'
          label: 'Total AOV'
          format {
            type: 'number'
            pattern: '[$$]#,###0.00'
          }
        },
        VizFieldFull {
          ref: 'total_margin'
          label: 'Total Margin'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        },
        VizFieldFull {
          ref: 'total_return_rate'
          label: 'Total Return Rate'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        }
      ]

      content: @md
<div style="font-size: 22px; line-height: 1.7; padding: 8px 16px;">

1. **Sales:** Net sales were **{{ rows[0].values.`Total Net Sales` }}**, a change of **{{ rows[0].values.`Sales Growth` }}** from the previous month (**{{ rows[0].values.`Prev Net Sales` }}**).
2. **Volume and basket:** There were **{{ rows[0].values.`Total Orders` }}** fulfilled orders, with an average order value of **{{ rows[0].values.`Total AOV` }}**.
3. **Profitability:** Gross margin was **{{ rows[0].values.`Total Margin` }}** of net sales.
4. **Category mix:** **{{ rows[0].`Category` }}** was the top category with **{{ rows[0].values.`Net Sales` }}**, or **{{ rows[0].values.`Share of Sales` }}** of net sales. The rest of the sales were spread across many other categories.
5. **Returns:** **{{ rows[0].values.`Total Return Rate` }}** of items were returned. See the KPI slide for the month-over-month change.

</div>
      ;;

      settings {
        sorts: [
          IndexBasedSortSetting {
            field_index: 1
            direction: 'desc'
          }
        ]
      }
    }
    settings {
      hide_label: true
    }
  }

  interactions: [
    FilterInteraction {
      from: 'f_month'
      to: [
        CustomMapping {
          block: 'v_trend'
          disabled: true
        }
      ]
    }
  ]

  view: TabLayout {
    label: 'Slides'

    tab slide_1_title: CanvasLayout {
      label: '1. Title'
      width: 1600
      height: 900
      grid_size: 20
      default_zoom: 'fit_to_page'
      block t_cover {
        position: pos(0, 0, 1600, 900)
        layer: 1
      }
      block f_month {
        position: pos(100, 620, 400, 100)
        layer: 2
      }
    }

    tab slide_2_kpis: CanvasLayout {
      label: '2. Headline KPIs'
      width: 1600
      height: 900
      grid_size: 20
      default_zoom: 'fit_to_page'
      block h_kpis {
        position: pos(60, 40, 1060, 100)
      }
      block f_month {
        position: pos(1160, 40, 380, 100)
      }
      block k_net_sales {
        position: pos(60, 180, 460, 280)
      }
      block k_gross_profit {
        position: pos(570, 180, 460, 280)
      }
      block k_gross_margin {
        position: pos(1080, 180, 460, 280)
      }
      block k_orders {
        position: pos(60, 500, 460, 280)
      }
      block k_aov {
        position: pos(570, 500, 460, 280)
      }
      block k_return_rate {
        position: pos(1080, 500, 460, 280)
      }
      block n_kpis {
        position: pos(60, 820, 1480, 50)
      }
    }

    tab slide_3_trend: CanvasLayout {
      label: '3. Trend'
      width: 1600
      height: 900
      grid_size: 20
      default_zoom: 'fit_to_page'
      block h_trend {
        position: pos(60, 40, 1480, 100)
      }
      block v_trend {
        position: pos(60, 160, 1480, 640)
      }
      block n_trend {
        position: pos(60, 820, 1480, 50)
      }
    }

    tab slide_4_category: CanvasLayout {
      label: '4. Category Breakdown'
      width: 1600
      height: 900
      grid_size: 20
      default_zoom: 'fit_to_page'
      block h_category {
        position: pos(60, 40, 1060, 100)
      }
      block f_month {
        position: pos(1160, 40, 380, 100)
      }
      block v_category_bar {
        position: pos(60, 160, 700, 700)
      }
      block v_category_table {
        position: pos(800, 160, 740, 700)
      }
    }

    tab slide_5_takeaways: CanvasLayout {
      label: '5. Key Takeaways'
      width: 1600
      height: 900
      grid_size: 20
      default_zoom: 'fit_to_page'
      block h_takeaways {
        position: pos(60, 40, 1060, 100)
      }
      block f_month {
        position: pos(1160, 40, 380, 100)
      }
      block v_takeaways {
        position: pos(60, 160, 1480, 700)
      }
    }
  }

  theme: H.themes.vanilla
}
