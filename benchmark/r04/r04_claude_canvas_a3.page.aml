Dashboard r04_claude_canvas_a3 {
  title: 'Monthly Performance Review: September 2026'
  description: 'Five 16:9 slides summarising TheLook eCommerce performance for September 2026 vs August 2026.'

  // ---------- Slide 1: Title ----------
  block s1_title: TextBlock {
    content: @md
<br/>

### TheLook eCommerce

# Monthly Performance Review

## September 2026

<br/>

Net sales, profitability, orders and category mix, compared with August 2026 and the trailing 12 months.
    ;;
    theme {
      background {
        bg_color: '#13294B'
      }
      text {
        font_color: '#FFFFFF'
        font_size: 22
      }
      padding: 60
      border {
        border_radius: 12
      }
    }
  }

  block s1_footer: TextBlock {
    content: @md Source: TheLook eCommerce dataset (thelook) · Net figures exclude Cancelled and Returned items · Period: 1–30 Sep 2026 ;;
    theme {
      text {
        font_color: '#5B6475'
        font_size: 14
      }
    }
  }

  // ---------- Slide 2: Headline KPIs ----------
  block s2_header: TextBlock {
    content: @md
## Headline KPIs: September 2026
Each figure is compared with August 2026.
    ;;
  }

  block kpi_net_sales: VizBlock {
    label: 'Net Sales'
    viz: MetricKpi {
      dataset: thelook
      calculation sep_value {
        label: 'Net Sales'
        formula: @aql net_sales | where(thelook_order_items.created_at matches @2026-09) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation aug_value {
        label: 'vs Aug 2026'
        formula: @aql net_sales | where(thelook_order_items.created_at matches @2026-08) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'sep_value'
        format {
          type: 'number'
          pattern: '[$$]#,###0'
        }
      }
      compare_value: VizFieldFull {
        ref: 'aug_value'
        format {
          type: 'number'
          pattern: '[$$]#,###0'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'center'
        metric_value {
          font_size: 44
        }
        label {
          font_size: 18
        }
        compare_value {
          font_size: 16
        }
      }
    }
  }

  block kpi_gross_profit: VizBlock {
    label: 'Gross Profit'
    viz: MetricKpi {
      dataset: thelook
      calculation sep_value {
        label: 'Gross Profit'
        formula: @aql gross_profit | where(thelook_order_items.created_at matches @2026-09) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation aug_value {
        label: 'vs Aug 2026'
        formula: @aql gross_profit | where(thelook_order_items.created_at matches @2026-08) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'sep_value'
        format {
          type: 'number'
          pattern: '[$$]#,###0'
        }
      }
      compare_value: VizFieldFull {
        ref: 'aug_value'
        format {
          type: 'number'
          pattern: '[$$]#,###0'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'center'
        metric_value {
          font_size: 44
        }
        label {
          font_size: 18
        }
        compare_value {
          font_size: 16
        }
      }
    }
  }

  block kpi_gross_margin: VizBlock {
    label: 'Gross Margin'
    viz: MetricKpi {
      dataset: thelook
      calculation sep_value {
        label: 'Gross Margin'
        formula: @aql gross_margin | where(thelook_order_items.created_at matches @2026-09) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation aug_value {
        label: 'vs Aug 2026'
        formula: @aql gross_margin | where(thelook_order_items.created_at matches @2026-08) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'sep_value'
        format {
          type: 'number'
          pattern: '#,###0.0%'
        }
      }
      compare_value: VizFieldFull {
        ref: 'aug_value'
        format {
          type: 'number'
          pattern: '#,###0.0%'
        }
      }
      settings {
        display_mode: 'compare_by_number'
        alignment: 'center'
        metric_value {
          font_size: 44
        }
        label {
          font_size: 18
        }
        compare_value {
          font_size: 16
        }
      }
    }
  }

  block kpi_orders: VizBlock {
    label: 'Fulfilled Orders'
    viz: MetricKpi {
      dataset: thelook
      calculation sep_value {
        label: 'Fulfilled Orders'
        formula: @aql fulfilled_orders | where(thelook_order_items.created_at matches @2026-09) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation aug_value {
        label: 'vs Aug 2026'
        formula: @aql fulfilled_orders | where(thelook_order_items.created_at matches @2026-08) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'sep_value'
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      compare_value: VizFieldFull {
        ref: 'aug_value'
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'center'
        metric_value {
          font_size: 44
        }
        label {
          font_size: 18
        }
        compare_value {
          font_size: 16
        }
      }
    }
  }

  block kpi_aov: VizBlock {
    label: 'Average Order Value'
    viz: MetricKpi {
      dataset: thelook
      calculation sep_value {
        label: 'Average Order Value'
        formula: @aql aov | where(thelook_order_items.created_at matches @2026-09) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation aug_value {
        label: 'vs Aug 2026'
        formula: @aql aov | where(thelook_order_items.created_at matches @2026-08) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'sep_value'
        format {
          type: 'number'
          pattern: '[$$]#,###0.00'
        }
      }
      compare_value: VizFieldFull {
        ref: 'aug_value'
        format {
          type: 'number'
          pattern: '[$$]#,###0.00'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'center'
        metric_value {
          font_size: 44
        }
        label {
          font_size: 18
        }
        compare_value {
          font_size: 16
        }
      }
    }
  }

  block kpi_return_rate: VizBlock {
    label: 'Return Rate'
    viz: MetricKpi {
      dataset: thelook
      calculation sep_value {
        label: 'Return Rate'
        formula: @aql return_rate | where(thelook_order_items.created_at matches @2026-09) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation aug_value {
        label: 'vs Aug 2026'
        formula: @aql return_rate | where(thelook_order_items.created_at matches @2026-08) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'sep_value'
        format {
          type: 'number'
          pattern: '#,###0.0%'
        }
      }
      compare_value: VizFieldFull {
        ref: 'aug_value'
        format {
          type: 'number'
          pattern: '#,###0.0%'
        }
      }
      settings {
        display_mode: 'compare_by_number'
        alignment: 'center'
        metric_value {
          font_size: 44
        }
        label {
          font_size: 18
        }
        compare_value {
          font_size: 16
          reverse_color: true
        }
      }
    }
  }

  block s2_note: TextBlock {
    content: @md Gross Margin and Return Rate changes are shown in percentage points. A lower Return Rate is shown as a favourable change. ;;
    theme {
      text {
        font_color: '#5B6475'
        font_size: 14
      }
    }
  }

  // ---------- Slide 3: Trend ----------
  block s3_header: TextBlock {
    content: @md
## Trend: Trailing 12 Months
Net sales grew for the third consecutive month and reached a record in September. Order volume rose with it.
    ;;
  }

  block trend_sales_orders: VizBlock {
    label: 'Monthly Net Sales and Fulfilled Orders (Oct 2025 – Sep 2026)'
    viz: CombinationChart {
      dataset: thelook
      calculation net_sales_calc {
        label: 'Net Sales'
        formula: @aql net_sales ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation orders_calc {
        label: 'Fulfilled Orders'
        formula: @aql fulfilled_orders ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      filter {
        field: r(thelook_order_items.created_at)
        operator: 'between'
        value: ['2025-10-01', '2026-09-30']
      }
      x_axis: VizFieldFull {
        label: 'Month'
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        label: 'Net Sales'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: 'net_sales_calc'
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
          settings {
            color: '#2F5BD3'
          }
        }
        settings {
          alignment: 'left'
          show_data_label_by: 'value'
        }
      }
      y_axis {
        label: 'Fulfilled Orders'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: 'orders_calc'
            format {
              type: 'number'
              pattern: '#,###0'
            }
          }
          settings {
            color: '#F28C28'
          }
        }
        settings {
          alignment: 'right'
        }
      }
      settings {
        legend_label: 'top'
        show_data_points: true
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
        row_limit: 100
      }
    }
  }

  // ---------- Slide 4: Category breakdown ----------
  block s4_header: TextBlock {
    content: @md
## Category Breakdown: September 2026
Jeans, Outerwear & Coats and Shorts drove most of the growth. The top 5 categories made up 46% of net sales.
    ;;
  }

  block cat_top10: VizBlock {
    label: 'Top 10 Categories by Net Sales: Sep vs Aug 2026'
    viz: BarChart {
      dataset: thelook
      calculation sep_sales {
        label: 'Sep 2026'
        formula: @aql net_sales | where(thelook_order_items.created_at matches @2026-09) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation aug_sales {
        label: 'Aug 2026'
        formula: @aql net_sales | where(thelook_order_items.created_at matches @2026-08) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      filter {
        field: r(thelook_products.category)
        operator: 'top'
        value: 10
        options {
          rank_by {
            field: 'sep_sales'
          }
        }
      }
      x_axis: VizFieldFull {
        label: 'Category'
        ref: r(thelook_products.category)
        format {
          type: 'text'
        }
      }
      y_axis {
        label: 'Net Sales'
        series {
          field: VizFieldFull {
            ref: 'sep_sales'
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
          settings {
            color: '#2F5BD3'
          }
        }
        series {
          field: VizFieldFull {
            ref: 'aug_sales'
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
          settings {
            color: '#B8C0CC'
          }
        }
      }
      settings {
        legend_label: 'top'
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
        row_limit: 10
      }
    }
  }

  block cat_mom_change: VizBlock {
    label: 'Change in Net Sales vs Aug 2026, All Categories'
    viz: BarChart {
      dataset: thelook
      calculation mom_change {
        label: 'Change vs Aug'
        formula: @aql (net_sales | where(thelook_order_items.created_at matches @2026-09)) - (net_sales | where(thelook_order_items.created_at matches @2026-08)) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      x_axis: VizFieldFull {
        label: 'Category'
        ref: r(thelook_products.category)
        format {
          type: 'text'
        }
      }
      y_axis {
        label: 'Change in Net Sales'
        series {
          field: VizFieldFull {
            ref: 'mom_change'
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
          settings {
            color: '#2F5BD3'
          }
        }
      }
      settings {
        legend_label: 'hidden'
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
        row_limit: 50
      }
    }
  }

  // ---------- Slide 5: Key takeaways ----------
  block s5_header: TextBlock {
    content: @md
## Key Takeaways
    ;;
  }

  block s5_wins: TextBlock {
    content: @md
### What went well

- **Record month.** Net sales reached **$60.5K**, up **47.6%** on August ($41.0K) and about **4×** September 2025 ($15.0K).
- **Growth came from volume.** Fulfilled orders rose **52%** (470 → 714).
- **Margin held steady.** Gross margin was **51.5%**, within the 51–52.5% range of the past 12 months. Gross profit rose **46%** to **$31.2K**.
- **Fewer returns.** The return rate fell to **8.5%**, from 10.3% in August and 13.6% in July.
    ;;
    theme {
      background {
        bg_color: '#EEF3FC'
      }
      padding: 28
      border {
        border_radius: 10
      }
    }
  }

  block s5_watch: TextBlock {
    content: @md
### What to watch

- **Smaller baskets.** AOV fell **2.9%** to **$84.73**.
- **Growth is concentrated.** Jeans (+125%), Outerwear & Coats (+87%) and Shorts (+142%) contributed most of the gain. Jeans alone was 14% of sales, at a lower 46% margin.
- **Some categories declined.** Pants & Capris (−61%), Skirts (−55%), Suits (−47%) and Blazers & Jackets (−34%) fell from August.
- **Next step:** check stock depth for the fastest-growing categories, and review pricing and merchandising for the declining ones.
    ;;
    theme {
      background {
        bg_color: '#FFF4E8'
      }
      padding: 28
      border {
        border_radius: 10
      }
    }
  }

  // ---------- Slides ----------
  view: TabLayout {
    label: 'Monthly Performance Slides'

    tab slide_1_title: CanvasLayout {
      label: '1. Title'
      width: 1600
      height: 900
      grid_size: 10
      block s1_title {
        position: pos(80, 80, 1440, 640)
      }
      block s1_footer {
        position: pos(80, 760, 1440, 60)
      }
      mobile {
        mode: 'auto'
      }
    }

    tab slide_2_kpis: CanvasLayout {
      label: '2. Headline KPIs'
      width: 1600
      height: 900
      grid_size: 10
      block s2_header {
        position: pos(80, 40, 1440, 110)
      }
      block kpi_net_sales {
        position: pos(80, 180, 460, 270)
      }
      block kpi_gross_profit {
        position: pos(570, 180, 460, 270)
      }
      block kpi_gross_margin {
        position: pos(1060, 180, 460, 270)
      }
      block kpi_orders {
        position: pos(80, 480, 460, 270)
      }
      block kpi_aov {
        position: pos(570, 480, 460, 270)
      }
      block kpi_return_rate {
        position: pos(1060, 480, 460, 270)
      }
      block s2_note {
        position: pos(80, 780, 1440, 60)
      }
      mobile {
        mode: 'auto'
      }
    }

    tab slide_3_trend: CanvasLayout {
      label: '3. Trend'
      width: 1600
      height: 900
      grid_size: 10
      block s3_header {
        position: pos(80, 40, 1440, 110)
      }
      block trend_sales_orders {
        position: pos(80, 170, 1440, 670)
      }
      mobile {
        mode: 'auto'
      }
    }

    tab slide_4_categories: CanvasLayout {
      label: '4. Category Breakdown'
      width: 1600
      height: 900
      grid_size: 10
      block s4_header {
        position: pos(80, 40, 1440, 110)
      }
      block cat_top10 {
        position: pos(80, 170, 820, 670)
      }
      block cat_mom_change {
        position: pos(930, 170, 590, 670)
      }
      mobile {
        mode: 'auto'
      }
    }

    tab slide_5_takeaways: CanvasLayout {
      label: '5. Key Takeaways'
      width: 1600
      height: 900
      grid_size: 10
      block s5_header {
        position: pos(80, 40, 1440, 80)
      }
      block s5_wins {
        position: pos(80, 140, 700, 700)
      }
      block s5_watch {
        position: pos(820, 140, 700, 700)
      }
      mobile {
        mode: 'auto'
      }
    }
  }

  theme: H.themes.vanilla
}
