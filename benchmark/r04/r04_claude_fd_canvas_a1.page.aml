        border_width: 1
        border_color: '#E4E0D6'
        border_radius: 12
        border_style: 'solid'
      }
      padding: 20
      shadow: 'none'
    }
  }

  block k_aov: VizBlock {
    label: 'Average Order Value'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        value {
          duration: 1
          granularity: 'month'
        }
        show_growth_rate: true
      }
      filter {
        field: r(thelook_order_items.created_at)
        operator: 'matches'
        value: '2026-09'
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        metric_value {
          font_size: 44
