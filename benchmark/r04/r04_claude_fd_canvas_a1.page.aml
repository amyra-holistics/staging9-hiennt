Dashboard r04_claude_fd_canvas_a1 {
  title: 'Monthly Performance Slides: September 2026'
  description: 'Five 16:9 slides (1280 x 720) reviewing TheLook eCommerce performance for September 2026. Figures are based on order items created in the month; net figures exclude Cancelled and Returned items.'

  // ---------------------------------------------------------------- Slide 1: Title
  block s1_title: TextBlock {
    content: @md
<div style="height:720px;box-sizing:border-box;padding:64px 72px 36px 72px;display:flex;flex-direction:column;justify-content:space-between;background:#14213D;color:#F7F5F0;font-family:Inter,'Segoe UI',Helvetica,Arial,sans-serif;">
<div style="display:flex;justify-content:space-between;align-items:center;font-size:13px;letter-spacing:3px;text-transform:uppercase;color:#9FB3D1;"><span>TheLook eCommerce</span><span>Monthly Performance Review</span></div>
<div>
<div style="width:64px;height:4px;background:#E07A5F;margin-bottom:28px;"></div>
<div style="font-family:Georgia,'Times New Roman',serif;font-size:84px;line-height:1.05;letter-spacing:-1px;color:#FFFFFF;">September 2026</div>
<div style="font-size:24px;line-height:1.45;color:#C9D4E5;margin-top:22px;max-width:820px;">Net sales reached <b style="color:#FFFFFF;">$60.5K</b>, up <b style="color:#FFFFFF;">48%</b> on August and the highest month of the past thirteen.</div>
</div>
<div style="display:flex;justify-content:space-between;align-items:flex-end;border-top:1px solid #2E3E5E;padding-top:18px;">
<div style="display:flex;gap:40px;font-size:14px;color:#C9D4E5;"><span><b style="color:#E07A5F;">02</b>&nbsp; Headline KPIs</span><span><b style="color:#E07A5F;">03</b>&nbsp; Trend</span><span><b style="color:#E07A5F;">04</b>&nbsp; Category breakdown</span><span><b style="color:#E07A5F;">05</b>&nbsp; Key takeaways</span></div>
<div style="font-size:12px;color:#7F90AE;">1 / 5</div>
</div>
</div>
    ;;
    theme: BlockTheme {
      background {
        bg_color: '#14213D'
      }
      border {
        border_width: 0
        border_radius: 0
      }
      padding: 0
      shadow: 'none'
    }
  }

  // ---------------------------------------------------------------- Slide 2: Headline KPIs
  block s2_frame: TextBlock {
    content: @md
<div style="height:720px;box-sizing:border-box;padding:44px 40px 26px 40px;display:flex;flex-direction:column;justify-content:space-between;background:#F7F5F0;color:#1B1F2A;font-family:Inter,'Segoe UI',Helvetica,Arial,sans-serif;">
<div>
<div style="font-size:13px;letter-spacing:2px;text-transform:uppercase;color:#C8553D;font-weight:600;">02 &middot; Headline KPIs</div>
<div style="font-family:Georgia,'Times New Roman',serif;font-size:30px;line-height:1.2;margin-top:10px;">Volume drove the month: orders up 52% while order value eased 3%</div>
<div style="font-size:14px;color:#6B7280;margin-top:8px;">September 2026 vs. August 2026</div>
</div>
<div style="display:flex;justify-content:space-between;font-size:12px;color:#6B7280;border-top:1px solid #DDD8CC;padding-top:10px;"><span>TheLook eCommerce &middot; Monthly Performance &middot; September 2026</span><span>2 / 5</span></div>
</div>
    ;;
    theme: BlockTheme {
      background {
        bg_color: '#F7F5F0'
      }
      border {
        border_width: 0
        border_radius: 0
      }
      padding: 0
      shadow: 'none'
    }
  }

  block k_net_sales: VizBlock {
    label: 'Net Sales'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        value {
          duration: 1
          granularity: 'month'
        }
        show_growth_rate: true
      }
      filter {
        field: r(thelook_order_items.created_at)
        operator: 'matches'
        value: '2026-09'
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        metric_value {
          font_size: 44
          font_color: '#14213D'
        }
        label {
          font_size: 15
          font_color: '#6B7280'
        }
        compare_value {
          font_size: 15
        }
      }
    }
    theme: BlockTheme {
      background {
        bg_color: '#FFFFFF'
      }
      border {
        border_width: 1
        border_color: '#E4E0D6'
        border_radius: 12
        border_style: 'solid'
      }
      padding: 20
      shadow: 'none'
    }
  }

  block k_gross_profit: VizBlock {
    label: 'Gross Profit'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_profit)
        label: 'Gross Profit'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        value {
          duration: 1
          granularity: 'month'
        }
        show_growth_rate: true
      }
      filter {
        field: r(thelook_order_items.created_at)
        operator: 'matches'
        value: '2026-09'
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        metric_value {
          font_size: 44
          font_color: '#14213D'
        }
        label {
          font_size: 15
          font_color: '#6B7280'
        }
        compare_value {
          font_size: 15
        }
      }
    }
    theme: BlockTheme {
      background {
        bg_color: '#FFFFFF'
      }
      border {
        border_width: 1
        border_color: '#E4E0D6'
        border_radius: 12
        border_style: 'solid'
      }
      padding: 20
      shadow: 'none'
    }
  }

  block k_gross_margin: VizBlock {
    label: 'Gross Margin'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        value {
          duration: 1
          granularity: 'month'
        }
        show_growth_rate: true
      }
      filter {
        field: r(thelook_order_items.created_at)
        operator: 'matches'
        value: '2026-09'
      }
      settings {
        display_mode: 'compare_by_number'
        alignment: 'left'
        metric_value {
          font_size: 44
