      }
      border {
        border_width: 1
        border_color: '#E4E0D6'
        border_radius: 12
        border_style: 'solid'
      }
      padding: 20
      shadow: 'none'
    }
  }

  block k_return_rate: VizBlock {
    label: 'Return Rate'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.return_rate)
        label: 'Return Rate'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        value {
          duration: 1
          granularity: 'month'
        }
        show_growth_rate: true
      }
      filter {
        field: r(thelook_order_items.created_at)
        operator: 'matches'
        value: '2026-09'
      }
      settings {
        display_mode: 'compare_by_number'
        alignment: 'left'
        metric_value {
          font_size: 44
          font_color: '#14213D'
        }
        label {
          font_size: 15
          font_color: '#6B7280'
        }
        compare_value {
          font_size: 15
          reverse_color: true
        }
      }
    }
    theme: BlockTheme {
      background {
        bg_color: '#FFFFFF'
      }
      border {
        border_width: 1
        border_color: '#E4E0D6'
        border_radius: 12
        border_style: 'solid'
      }
      padding: 20
      shadow: 'none'
    }
  }

  // ---------------------------------------------------------------- Slide 3: Trend
  block s3_frame: TextBlock {
    content: @md
<div style="height:720px;box-sizing:border-box;padding:44px 40px 26px 40px;display:flex;flex-direction:column;justify-content:space-between;background:#F7F5F0;color:#1B1F2A;font-family:Inter,'Segoe UI',Helvetica,Arial,sans-serif;">
<div>
<div style="font-size:13px;letter-spacing:2px;text-transform:uppercase;color:#C8553D;font-weight:600;">03 &middot; Trend</div>
<div style="font-family:Georgia,'Times New Roman',serif;font-size:30px;line-height:1.2;margin-top:10px;">Net sales have quadrupled in a year, with growth accelerating since June</div>
<div style="font-size:14px;color:#6B7280;margin-top:8px;">Monthly net sales, September 2025 to September 2026</div>
</div>
<div style="display:flex;justify-content:space-between;font-size:12px;color:#6B7280;border-top:1px solid #DDD8CC;padding-top:10px;"><span>TheLook eCommerce &middot; Monthly Performance &middot; September 2026</span><span>3 / 5</span></div>
</div>
    ;;
    theme: BlockTheme {
      background {
        bg_color: '#F7F5F0'
      }
      border {
        border_width: 0
        border_radius: 0
      }
      padding: 0
      shadow: 'none'
    }
  }

  block v_trend: VizBlock {
    label: 'Net Sales by Month'
    viz: ColumnChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        label: 'Month'
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        label: 'Net Sales'
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#1F4E79'
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      filter {
        field: r(thelook_order_items.created_at)
        operator: 'matches'
        value: '2025-09 - 2026-09'
      }
      settings {
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
        row_limit: 100
      }
    }
    settings {
      hide_label: true
    }
    theme: BlockTheme {
      background {
        bg_color: '#FFFFFF'
      }
      border {
        border_width: 1
        border_color: '#E4E0D6'
        border_radius: 12
        border_style: 'solid'
      }
      padding: 16
      shadow: 'none'
    }
  }

  block s3_callouts: TextBlock {
    content: @md
<div style="height:100%;box-sizing:border-box;display:flex;flex-direction:column;gap:14px;font-family:Inter,'Segoe UI',Helvetica,Arial,sans-serif;color:#1B1F2A;">
<div style="background:#14213D;color:#F7F5F0;border-radius:12px;padding:20px 22px;">
<div style="font-size:12px;letter-spacing:1.5px;text-transform:uppercase;color:#9FB3D1;">Month over month</div>
<div style="font-family:Georgia,serif;font-size:40px;margin-top:4px;color:#FFFFFF;">+47.6%</div>
<div style="font-size:13px;color:#C9D4E5;">$41.0K in Aug &rarr; $60.5K in Sep</div>
</div>
<div style="background:#FFFFFF;border:1px solid #E4E0D6;border-radius:12px;padding:20px 22px;">
<div style="font-size:12px;letter-spacing:1.5px;text-transform:uppercase;color:#6B7280;">Year over year</div>
<div style="font-family:Georgia,serif;font-size:40px;margin-top:4px;color:#14213D;">4.0&times;</div>
<div style="font-size:13px;color:#6B7280;">$15.0K in Sep 2025 &rarr; $60.5K in Sep 2026</div>
</div>
<div style="background:#FFFFFF;border:1px solid #E4E0D6;border-radius:12px;padding:20px 22px;">
<div style="font-size:12px;letter-spacing:1.5px;text-transform:uppercase;color:#6B7280;">Momentum</div>
<div style="font-family:Georgia,serif;font-size:40px;margin-top:4px;color:#14213D;">3 months</div>
<div style="font-size:13px;color:#6B7280;">of consecutive growth (Jul, Aug, Sep), after a dip in June</div>
</div>
</div>
    ;;
    theme: BlockTheme {
      background {
        bg_color: 'transparent'
      }
      border {
        border_width: 0
      }
      padding: 0
      shadow: 'none'
    }
  }

  // ---------------------------------------------------------------- Slide 4: Category breakdown
  block s4_frame: TextBlock {
    content: @md
<div style="height:720px;box-sizing:border-box;padding:44px 40px 26px 40px;display:flex;flex-direction:column;justify-content:space-between;background:#F7F5F0;color:#1B1F2A;font-family:Inter,'Segoe UI',Helvetica,Arial,sans-serif;">
<div>
<div style="font-size:13px;letter-spacing:2px;text-transform:uppercase;color:#C8553D;font-weight:600;">04 &middot; Category breakdown</div>
<div style="font-family:Georgia,'Times New Roman',serif;font-size:30px;line-height:1.2;margin-top:10px;">Jeans and outerwear led; the top three categories drove a third of sales</div>
<div style="font-size:14px;color:#6B7280;margin-top:8px;">Top 10 product categories by net sales, September 2026</div>
</div>
<div style="display:flex;justify-content:space-between;font-size:12px;color:#6B7280;border-top:1px solid #DDD8CC;padding-top:10px;"><span>TheLook eCommerce &middot; Monthly Performance &middot; September 2026</span><span>4 / 5</span></div>
</div>
    ;;
    theme: BlockTheme {
      background {
        bg_color: '#F7F5F0'
      }
      border {
        border_width: 0
        border_radius: 0
      }
      padding: 0
      shadow: 'none'
    }
  }

  block v_category: VizBlock {
    label: 'Top 10 Categories by Net Sales'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Category'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#1F4E79'
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      filter {
        field: r(thelook_order_items.created_at)
        operator: 'matches'
        value: '2026-09'
      }
      filter {
        field: r(thelook_products.category)
        operator: 'top'
        value: 10
        options {
          rank_by {
            field: r(thelook.net_sales)
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
    settings {
      hide_label: true
    }
    theme: BlockTheme {
      background {
        bg_color: '#FFFFFF'
      }
      border {
        border_width: 1
        border_color: '#E4E0D6'
        border_radius: 12
        border_style: 'solid'
      }
      padding: 16
      shadow: 'none'
    }
  }

  block s4_callouts: TextBlock {
    content: @md
<div style="height:100%;box-sizing:border-box;display:flex;flex-direction:column;gap:14px;font-family:Inter,'Segoe UI',Helvetica,Arial,sans-serif;color:#1B1F2A;">
<div style="background:#FFFFFF;border:1px solid #E4E0D6;border-left:4px solid #1F4E79;border-radius:12px;padding:18px 22px;">
<div style="display:flex;justify-content:space-between;align-items:baseline;"><span style="font-size:17px;font-weight:600;">Jeans</span><span style="font-family:Georgia,serif;font-size:26px;color:#14213D;">$8.2K</span></div>
<div style="font-size:13px;color:#6B7280;margin-top:4px;">#1 category with 13.6% of net sales, up 125% on August ($3.6K).</div>
</div>
<div style="background:#FFFFFF;border:1px solid #E4E0D6;border-left:4px solid #1F4E79;border-radius:12px;padding:18px 22px;">
<div style="display:flex;justify-content:space-between;align-items:baseline;"><span style="font-size:17px;font-weight:600;">Outerwear &amp; Coats</span><span style="font-family:Georgia,serif;font-size:26px;color:#14213D;">$6.7K</span></div>
<div style="font-size:13px;color:#6B7280;margin-top:4px;">Up 87% on August ($3.6K), at a healthy 55.9% margin.</div>
</div>
<div style="background:#FFFFFF;border:1px solid #E4E0D6;border-left:4px solid #1F4E79;border-radius:12px;padding:18px 22px;">
<div style="display:flex;justify-content:space-between;align-items:baseline;"><span style="font-size:17px;font-weight:600;">Shorts</span><span style="font-family:Georgia,serif;font-size:26px;color:#14213D;">$4.8K</span></div>
<div style="font-size:13px;color:#6B7280;margin-top:4px;">Biggest jump among the leaders: up 142% on August ($2.0K).</div>
</div>
<div style="background:#FBEDE8;border:1px solid #F0CFC4;border-radius:12px;padding:18px 22px;">
<div style="font-size:12px;letter-spacing:1.5px;text-transform:uppercase;color:#C8553D;font-weight:600;">Margin watch</div>
<div style="font-size:13px;color:#1B1F2A;margin-top:6px;line-height:1.5;">Jeans run at a 46.0% gross margin against 51.5% overall, so their growing share pulls the blended margin down.</div>
</div>
</div>
    ;;
    theme: BlockTheme {
      background {
        bg_color: 'transparent'
      }
      border {
        border_width: 0
      }
      padding: 0
      shadow: 'none'
    }
  }

  // ---------------------------------------------------------------- Slide 5: Key takeaways
  block s5_frame: TextBlock {
    content: @md
<div style="height:720px;box-sizing:border-box;padding:44px 40px 26px 40px;display:flex;flex-direction:column;justify-content:space-between;background:#F7F5F0;color:#1B1F2A;font-family:Inter,'Segoe UI',Helvetica,Arial,sans-serif;">
<div>
<div style="font-size:13px;letter-spacing:2px;text-transform:uppercase;color:#C8553D;font-weight:600;">05 &middot; Key takeaways</div>
<div style="font-family:Georgia,'Times New Roman',serif;font-size:30px;line-height:1.2;margin-top:10px;">A breakout month for volume, with margin mix to watch</div>
</div>
<div style="display:flex;justify-content:space-between;font-size:12px;color:#6B7280;border-top:1px solid #DDD8CC;padding-top:10px;"><span>Source: TheLook eCommerce &middot; order items created 1 to 30 Sep 2026 &middot; net figures exclude Cancelled and Returned items</span><span>5 / 5</span></div>
</div>
    ;;
    theme: BlockTheme {
      background {
        bg_color: '#F7F5F0'
      }
      border {
        border_width: 0
        border_radius: 0
      }
      padding: 0
      shadow: 'none'
    }
  }

  block s5_takeaways: TextBlock {
    content: @md
<div style="height:100%;box-sizing:border-box;display:grid;grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr;gap:20px;font-family:Inter,'Segoe UI',Helvetica,Arial,sans-serif;color:#1B1F2A;">
<div style="background:#FFFFFF;border:1px solid #E4E0D6;border-radius:12px;padding:24px 28px;">
<div style="font-family:Georgia,serif;font-size:30px;color:#C8553D;">01</div>
<div style="font-size:19px;font-weight:600;margin-top:6px;">Strongest month in the last thirteen</div>
<div style="font-size:14px;line-height:1.55;color:#4B5563;margin-top:8px;">Net sales hit $60.5K, up 47.6% on August and about 4&times; September 2025. It is the third straight month of growth.</div>
</div>
<div style="background:#FFFFFF;border:1px solid #E4E0D6;border-radius:12px;padding:24px 28px;">
<div style="font-family:Georgia,serif;font-size:30px;color:#C8553D;">02</div>
<div style="font-size:19px;font-weight:600;margin-top:6px;">Growth came from volume, not basket size</div>
<div style="font-size:14px;line-height:1.55;color:#4B5563;margin-top:8px;">Fulfilled orders rose 52% (470 to 714), while average order value slipped 2.9% to $84.73.</div>
</div>
<div style="background:#FFFFFF;border:1px solid #E4E0D6;border-radius:12px;padding:24px 28px;">
<div style="font-family:Georgia,serif;font-size:30px;color:#C8553D;">03</div>
<div style="font-size:19px;font-weight:600;margin-top:6px;">Denim and outerwear did the heavy lifting</div>
<div style="font-size:14px;line-height:1.55;color:#4B5563;margin-top:8px;">Jeans (+$4.6K) and Outerwear &amp; Coats (+$3.1K) delivered about 40% of the $19.5K month-over-month increase.</div>
</div>
<div style="background:#14213D;border-radius:12px;padding:24px 28px;color:#F7F5F0;">
<div style="font-family:Georgia,serif;font-size:30px;color:#E07A5F;">04</div>
<div style="font-size:19px;font-weight:600;margin-top:6px;color:#FFFFFF;">Watch margin mix; returns improved</div>
<div style="font-size:14px;line-height:1.55;color:#C9D4E5;margin-top:8px;">Gross margin eased to 51.5% (&minus;0.6 pts) as lower-margin jeans gained share. The return rate improved to 8.5% from 10.3%.</div>
</div>
</div>
    ;;
    theme: BlockTheme {
      background {
        bg_color: 'transparent'
      }
      border {
        border_width: 0
      }
      padding: 0
      shadow: 'none'
    }
  }

  // Five 1280 x 720 (16:9) slides stacked vertically with a 40px gutter.
  // Slide origins (y): 40, 800, 1560, 2320, 3080.
  view: CanvasLayout {
    label: 'Slides'
    width: 1360
    height: 3840
    grid_size: 20
    default_zoom: 'fit_to_width'

    // Slide 1: Title
    block s1_title {
      position: pos(40, 40, 1280, 720)
      layer: 1
    }

    // Slide 2: Headline KPIs
    block s2_frame {
      position: pos(40, 800, 1280, 720)
      layer: 1
    }
    block k_net_sales {
      position: pos(80, 980, 380, 220)
      layer: 2
    }
    block k_gross_profit {
      position: pos(490, 980, 380, 220)
      layer: 2
    }
    block k_gross_margin {
      position: pos(900, 980, 380, 220)
      layer: 2
    }
    block k_orders {
      position: pos(80, 1220, 380, 220)
      layer: 2
    }
    block k_aov {
      position: pos(490, 1220, 380, 220)
      layer: 2
    }
    block k_return_rate {
      position: pos(900, 1220, 380, 220)
      layer: 2
    }

    // Slide 3: Trend
    block s3_frame {
      position: pos(40, 1560, 1280, 720)
      layer: 1
    }
    block v_trend {
      position: pos(80, 1740, 800, 460)
      layer: 2
    }
    block s3_callouts {
      position: pos(900, 1740, 380, 460)
      layer: 2
    }

    // Slide 4: Category breakdown
    block s4_frame {
      position: pos(40, 2320, 1280, 720)
      layer: 1
    }
    block v_category {
      position: pos(80, 2500, 720, 460)
      layer: 2
    }
    block s4_callouts {
      position: pos(820, 2500, 460, 460)
      layer: 2
    }

    // Slide 5: Key takeaways
    block s5_frame {
      position: pos(40, 3080, 1280, 720)
      layer: 1
    }
    block s5_takeaways {
      position: pos(80, 3220, 1200, 500)
      layer: 2
    }

    mobile {
      mode: 'auto'
    }
  }

  theme: PageTheme {
    background {
      bg_color: '#E7E4DD'
    }
    canvas {
      background {
        bg_color: '#E7E4DD'
      }
      border {
        border_width: 0
      }
      shadow: 'none'
    }
  }
}
