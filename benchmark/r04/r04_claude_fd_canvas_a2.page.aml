Dashboard r04_claude_fd_canvas_a2 {
  title: 'Monthly Performance Review'
  description: 'Monthly performance slides for TheLook eCommerce: headline KPIs, 12-month trend, category breakdown and key takeaways.'

  // ---------- Filter ----------
  block f_month: FilterBlock {
    label: 'Reporting month'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: ref('thelook_order_items', 'created_at')
    }
    default {
      operator: 'matches'
      value: 'last month'
    }
  }

  // ---------- Slide 1: Title ----------
  block t_title: TextBlock {
    content: @md
<div style="padding: 72px 80px; color: #F4F1EA; height: 100%; box-sizing: border-box;">
  <div style="font-size: 14px; letter-spacing: 4px; text-transform: uppercase; color: #E9A23B; font-weight: 600;">TheLook eCommerce · Monthly Business Review</div>
  <div style="font-size: 64px; line-height: 1.05; font-weight: 700; margin-top: 28px;">Monthly<br/>Performance</div>
  <div style="width: 96px; height: 4px; background: #E9A23B; margin: 36px 0 28px 0;"></div>
  <div style="font-size: 22px; line-height: 1.5; color: #C9D1DC; max-width: 720px;">Headline KPIs, the 12-month trend, what sold by category, and what to do next.</div>
  <div style="font-size: 15px; color: #8A97A8; margin-top: 150px;">Reporting period follows the <b style="color:#F4F1EA">Reporting month</b> filter (default: last complete month). Net figures exclude Cancelled and Returned items.</div>
</div>
    ;;
    theme {
      background {
        bg_color: '#14213D'
      }
      border {
        border_width: 0
        border_radius: 0
      }
      padding: 0
    }
  }

  block t_agenda: TextBlock {
    content: @md
<div style="padding: 8px 4px; color: #F4F1EA; font-size: 16px; line-height: 2.1;">
  <div style="font-size: 12px; letter-spacing: 3px; text-transform: uppercase; color: #E9A23B; font-weight: 600; margin-bottom: 8px;">Agenda</div>
  <div><span style="color:#E9A23B; font-weight:700;">02</span>&nbsp;&nbsp;Headline KPIs</div>
  <div><span style="color:#E9A23B; font-weight:700;">03</span>&nbsp;&nbsp;12-month trend</div>
  <div><span style="color:#E9A23B; font-weight:700;">04</span>&nbsp;&nbsp;Category breakdown</div>
  <div><span style="color:#E9A23B; font-weight:700;">05</span>&nbsp;&nbsp;Key takeaways</div>
</div>
    ;;
    theme {
      background {
        bg_color: '#1D2D50'
      }
      border {
        border_width: 0
        border_radius: 8
      }
      padding: 24
    }
  }

  // ---------- Slide 2: Headline KPIs ----------
  block t_kpi_header: TextBlock {
    content: @md
<div style="color: #14213D;">
  <div style="font-size: 12px; letter-spacing: 3px; text-transform: uppercase; color: #B5651D; font-weight: 600;">02 · Headline KPIs</div>
  <div style="font-size: 34px; font-weight: 700; margin-top: 6px;">How did the month perform?</div>
  <div style="font-size: 15px; color: #5B6778; margin-top: 4px;">Selected month vs. the previous month.</div>
</div>
    ;;
    theme {
      background {
        bg_color: 'transparent'
      }
      border {
        border_width: 0
      }
    }
  }

  block v_kpi_net_sales: VizBlock {
    label: 'Net Sales'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value: RelativePopValue {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        metric_value {
          font_size: 44
          font_color: '#14213D'
        }
      }
    }
  }

  block v_kpi_orders: VizBlock {
    label: 'Fulfilled Orders'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        label: 'Fulfilled Orders'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value: RelativePopValue {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        metric_value {
          font_size: 44
          font_color: '#14213D'
        }
      }
    }
  }

  block v_kpi_aov: VizBlock {
    label: 'Average Order Value'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value: RelativePopValue {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        metric_value {
          font_size: 44
          font_color: '#14213D'
        }
      }
    }
  }

  block v_kpi_gross_profit: VizBlock {
    label: 'Gross Profit'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_profit)
        label: 'Gross Profit'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value: RelativePopValue {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        metric_value {
          font_size: 44
          font_color: '#14213D'
        }
      }
    }
  }

  block v_kpi_margin: VizBlock {
    label: 'Gross Margin'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value: RelativePopValue {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        metric_value {
          font_size: 44
          font_color: '#14213D'
        }
      }
    }
  }

  block v_kpi_return_rate: VizBlock {
    label: 'Return Rate (lower is better)'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.return_rate)
        label: 'Return Rate'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value: RelativePopValue {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        metric_value {
          font_size: 44
          font_color: '#14213D'
        }
        compare_value {
          reverse_color: true
        }
      }
    }
  }

  // ---------- Slide 3: Trend ----------
  block t_trend_header: TextBlock {
    content: @md
<div style="color: #14213D;">
  <div style="font-size: 12px; letter-spacing: 3px; text-transform: uppercase; color: #B5651D; font-weight: 600;">03 · Trend</div>
  <div style="font-size: 34px; font-weight: 700; margin-top: 6px;">Twelve months of growth</div>
  <div style="font-size: 15px; color: #5B6778; margin-top: 4px;">Net Sales (columns) and Fulfilled Orders (line), last 12 complete months. Not affected by the month filter.</div>
</div>
    ;;
    theme {
      background {
        bg_color: 'transparent'
      }
      border {
        border_width: 0
      }
    }
  }

  block v_trend: VizBlock {
    label: 'Net Sales & Fulfilled Orders by Month'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        label: 'Net Sales'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        settings {
          alignment: 'left'
        }
      }
      y_axis {
        label: 'Fulfilled Orders'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.fulfilled_orders)
            label: 'Fulfilled Orders'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        settings {
          alignment: 'right'
        }
      }
      conditions: [
        "thelook_order_items.created_at matches @(last 12 months)",
      ]
      settings {
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  // ---------- Slide 4: Category breakdown ----------
  block t_cat_header: TextBlock {
    content: @md
<div style="color: #14213D;">
  <div style="font-size: 12px; letter-spacing: 3px; text-transform: uppercase; color: #B5651D; font-weight: 600;">04 · Category breakdown</div>
  <div style="font-size: 34px; font-weight: 700; margin-top: 6px;">Where the month's sales came from</div>
  <div style="font-size: 15px; color: #5B6778; margin-top: 4px;">Top 10 categories by Net Sales, with profitability and returns for every category.</div>
</div>
    ;;
    theme {
      background {
        bg_color: 'transparent'
      }
      border {
        border_width: 0
      }
    }
  }

  block v_cat_bar: VizBlock {
    label: 'Top 10 Categories by Net Sales'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Category'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      settings {
        row_limit: 10
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block v_cat_table: VizBlock {
    label: 'Category Scorecard'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          ref: r(thelook_products.category)
          label: 'Category'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.items_sold)
          label: 'Items'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.gross_margin)
          label: 'Margin'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.return_rate)
          label: 'Return Rate'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        pagination_size: 12
        sorts: [
          IndexBasedSortSetting {
            field_index: 1
            direction: 'desc'
          }
        ]
      }
    }
  }

  // ---------- Slide 5: Key takeaways ----------
  block t_take_header: TextBlock {
    content: @md
<div style="color: #14213D;">
  <div style="font-size: 12px; letter-spacing: 3px; text-transform: uppercase; color: #B5651D; font-weight: 600;">05 · Key takeaways</div>
  <div style="font-size: 34px; font-weight: 700; margin-top: 6px;">August 2026 in four points</div>
  <div style="font-size: 15px; color: #5B6778; margin-top: 4px;">Written from August 2026 results (last complete month as of 28 Sep 2026). Refresh this slide when reviewing a different month.</div>
</div>
    ;;
    theme {
      background {
        bg_color: 'transparent'
      }
      border {
        border_width: 0
      }
    }
  }

  block t_take_1: TextBlock {
    content: @md
<div style="color:#14213D;">
  <div style="font-size: 44px; font-weight: 700; color: #2A6F97;">+27%</div>
  <div style="font-size: 18px; font-weight: 700; margin: 6px 0 10px 0;">More orders drove the growth</div>
  <div style="font-size: 15px; line-height: 1.55; color: #3D4858;">Net Sales reached <b>$41.0K</b>, up from $32.3K in July and 2.6× August 2025 ($16.0K). Fulfilled orders rose 26% to <b>470</b>, while AOV held flat at <b>$87</b>, so growth came from more orders, not bigger baskets.</div>
</div>
    ;;
    theme {
      background {
        bg_color: '#FFFFFF'
      }
      border {
        border_width: 0
        border_radius: 10
      }
      shadow: 'sm'
      padding: 28
    }
  }

  block t_take_2: TextBlock {
    content: @md
<div style="color:#14213D;">
  <div style="font-size: 44px; font-weight: 700; color: #2A6F97;">52.1%</div>
  <div style="font-size: 18px; font-weight: 700; margin: 6px 0 10px 0;">Margin is stable, returns improved</div>
  <div style="font-size: 15px; line-height: 1.55; color: #3D4858;">Gross margin held at 52% (July 52.2%). Return rate fell to <b>10.3%</b> from 13.6%. That is its lowest level since May and it directly protects net revenue.</div>
</div>
    ;;
    theme {
      background {
        bg_color: '#FFFFFF'
      }
      border {
        border_width: 0
        border_radius: 10
      }
      shadow: 'sm'
      padding: 28
    }
  }

  block t_take_3: TextBlock {
    content: @md
<div style="color:#14213D;">
  <div style="font-size: 44px; font-weight: 700; color: #2A6F97;">3 × $3.5K+</div>
  <div style="font-size: 18px; font-weight: 700; margin: 6px 0 10px 0;">Growth was broad, with a few standouts</div>
  <div style="font-size: 15px; line-height: 1.55; color: #3D4858;">Jeans, Outerwear &amp; Coats and Suits &amp; Sport Coats (+43% MoM) led the month. Accessories (3.3×), Pants &amp; Capris (4.3×) and Sleep &amp; Lounge (+77%) jumped. Active fell 28%.</div>
</div>
    ;;
    theme {
      background {
        bg_color: '#FFFFFF'
      }
      border {
        border_width: 0
        border_radius: 10
      }
      shadow: 'sm'
      padding: 28
    }
  }

  block t_take_4: TextBlock {
    content: @md
<div style="color:#F4F1EA;">
  <div style="font-size: 12px; letter-spacing: 3px; text-transform: uppercase; color: #E9A23B; font-weight: 600;">Next steps</div>
  <div style="font-size: 16px; line-height: 1.7; margin-top: 10px;">
    <b>1.</b> Plan inventory for continued momentum: September month-to-date is already <b>$60.5K</b>.<br/>
    <b>2.</b> Look into the drop in Active and fix low-margin lines: Suits (39%) and Leggings (38%) trail the 52% average.<br/>
    <b>3.</b> Find what drove the lower return rate and apply it to other categories.
  </div>
</div>
    ;;
    theme {
      background {
        bg_color: '#14213D'
      }
      border {
        border_width: 0
        border_radius: 10
      }
      padding: 28
    }
  }

  // Trend uses its own fixed 12-month window
  interactions: [
    FilterInteraction {
      from: 'f_month'
      to: [
        CustomMapping {
          block: 'v_trend'
          disabled: true
        }
      ]
    }
  ]

  view: TabLayout {
    label: 'Slides'

    tab slide_1: CanvasLayout {
      label: '1 · Title'
      width: 1280
      height: 720
      grid_size: 20
      block t_title {
        position: pos(0, 0, 1280, 720)
      }
      block t_agenda {
        position: pos(900, 80, 300, 260)
        layer: 1
      }
      block f_month {
        position: pos(900, 560, 300, 80)
        layer: 1
      }
      mobile {
        mode: 'auto'
      }
    }

    tab slide_2: CanvasLayout {
      label: '2 · Headline KPIs'
      width: 1280
      height: 720
      grid_size: 20
      block t_kpi_header {
        position: pos(60, 40, 840, 120)
      }
      block f_month {
        position: pos(920, 60, 300, 80)
      }
      block v_kpi_net_sales {
        position: pos(60, 200, 373, 220)
      }
      block v_kpi_orders {
        position: pos(453, 200, 374, 220)
      }
      block v_kpi_aov {
        position: pos(847, 200, 373, 220)
      }
      block v_kpi_gross_profit {
        position: pos(60, 440, 373, 220)
      }
      block v_kpi_margin {
        position: pos(453, 440, 374, 220)
      }
      block v_kpi_return_rate {
        position: pos(847, 440, 373, 220)
      }
      mobile {
        mode: 'auto'
      }
    }

    tab slide_3: CanvasLayout {
      label: '3 · Trend'
      width: 1280
      height: 720
      grid_size: 20
      block t_trend_header {
        position: pos(60, 40, 1160, 120)
      }
      block v_trend {
        position: pos(60, 180, 1160, 500)
      }
      mobile {
        mode: 'auto'
      }
    }

    tab slide_4: CanvasLayout {
      label: '4 · Categories'
      width: 1280
      height: 720
      grid_size: 20
      block t_cat_header {
        position: pos(60, 40, 840, 120)
      }
      block f_month {
        position: pos(920, 60, 300, 80)
      }
      block v_cat_bar {
        position: pos(60, 180, 580, 500)
      }
      block v_cat_table {
        position: pos(660, 180, 560, 500)
      }
      mobile {
        mode: 'auto'
      }
    }

    tab slide_5: CanvasLayout {
      label: '5 · Takeaways'
      width: 1280
      height: 720
      grid_size: 20
      block t_take_header {
        position: pos(60, 40, 1160, 120)
      }
      block t_take_1 {
        position: pos(60, 180, 373, 300)
      }
      block t_take_2 {
        position: pos(453, 180, 374, 300)
      }
      block t_take_3 {
        position: pos(847, 180, 373, 300)
      }
      block t_take_4 {
        position: pos(60, 500, 1160, 180)
      }
      mobile {
        mode: 'auto'
      }
    }
  }

  theme: PageTheme {
    background {
      bg_color: '#E9E6DF'
    }
    canvas {
      background {
        bg_color: '#F7F5F0'
      }
      border {
        border_width: 0
        border_radius: 0
      }
      shadow: 'md'
    }
    block {
      label {
        font_size: 13
        font_color: '#5B6778'
        font_weight: 'semibold'
      }
      background {
        bg_color: '#FFFFFF'
      }
      border {
        border_width: 0
        border_radius: 10
      }
      padding: 16
    }
  }
}
