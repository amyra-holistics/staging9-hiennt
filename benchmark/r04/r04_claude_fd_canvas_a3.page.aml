Dashboard r04_claude_fd_canvas_a3 {
  title: 'Monthly Performance Review: August 2026'
  description: '''
Five 16:9 slides (1280 x 720) summarizing August 2026, the latest complete month, for TheLook eCommerce.
Month-over-month comparisons are against July 2026. Net Sales exclude Cancelled and Returned items.
'''

  // ---------------------------------------------------------------- Slide 1: Title
  block s1_title: TextBlock {
    content: @md
<div style="height:100%; display:flex; flex-direction:column; justify-content:space-between; padding:64px 72px; box-sizing:border-box; color:#F4EFE6; font-family:Georgia, 'Times New Roman', serif;">
  <div style="font-family:Helvetica, Arial, sans-serif; font-size:14px; letter-spacing:4px; text-transform:uppercase; color:#E9A23B;">TheLook eCommerce &middot; Monthly Business Review</div>
  <div>
    <div style="font-size:88px; line-height:1.0; font-weight:400;">August 2026</div>
    <div style="font-size:88px; line-height:1.05; font-style:italic; color:#E9A23B;">Performance</div>
    <div style="margin-top:28px; width:120px; height:4px; background:#E9A23B;"></div>
    <div style="margin-top:28px; font-family:Helvetica, Arial, sans-serif; font-size:22px; color:#C9D1DE; max-width:760px; line-height:1.45;">Headline KPIs, the 13-month sales trend, category performance and what it means for September.</div>
  </div>
  <div style="font-family:Helvetica, Arial, sans-serif; font-size:13px; color:#8C99AE; display:flex; justify-content:space-between;">
    <span>Reporting period: 1&ndash;31 Aug 2026 &middot; Comparisons vs. Jul 2026</span>
    <span>01 / 05</span>
  </div>
</div>
    ;;
    theme {
      background { bg_color: '#14213D' }
      padding: 0
      border { border_width: 0 }
    }
  }

  // ---------------------------------------------------------------- Slide 2: Headline KPIs
  block s2_header: TextBlock {
    content: @md
<div style="font-family:Helvetica, Arial, sans-serif;">
  <div style="font-size:13px; letter-spacing:3px; text-transform:uppercase; color:#C0661C;">02 &middot; Headline KPIs</div>
  <div style="font-family:Georgia, serif; font-size:40px; color:#14213D; margin-top:6px;">Sales up 27% on volume, not price</div>
</div>
    ;;
    theme {
      background { bg_color: 'transparent' }
      border { border_width: 0 }
      padding: 0
    }
  }

  block kpi_net_sales: VizBlock {
    label: 'Net Sales'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format { type: 'number' pattern: 'inherited' }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value { duration: 1 granularity: 'month' }
      }
      conditions: ["thelook_order_items.created_at matches @2026-08"]
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        metric_value { font_size: 44 font_color: '#14213D' }
        label { font_size: 15 font_color: '#5B6475' }
      }
    }
  }

  block kpi_gross_profit: VizBlock {
    label: 'Gross Profit'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_profit)
        label: 'Gross Profit'
        format { type: 'number' pattern: 'inherited' }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value { duration: 1 granularity: 'month' }
      }
      conditions: ["thelook_order_items.created_at matches @2026-08"]
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        metric_value { font_size: 44 font_color: '#14213D' }
        label { font_size: 15 font_color: '#5B6475' }
      }
    }
  }

  block kpi_orders: VizBlock {
    label: 'Fulfilled Orders'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        label: 'Fulfilled Orders'
        format { type: 'number' pattern: 'inherited' }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value { duration: 1 granularity: 'month' }
      }
      conditions: ["thelook_order_items.created_at matches @2026-08"]
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        metric_value { font_size: 44 font_color: '#14213D' }
        label { font_size: 15 font_color: '#5B6475' }
      }
    }
  }

  block kpi_aov: VizBlock {
    label: 'Average Order Value'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'
        format { type: 'number' pattern: 'inherited' }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value { duration: 1 granularity: 'month' }
      }
      conditions: ["thelook_order_items.created_at matches @2026-08"]
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        metric_value { font_size: 44 font_color: '#14213D' }
        label { font_size: 15 font_color: '#5B6475' }
      }
    }
  }

  block kpi_margin: VizBlock {
    label: 'Gross Margin'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format { type: 'number' pattern: 'inherited' }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value { duration: 1 granularity: 'month' }
      }
      conditions: ["thelook_order_items.created_at matches @2026-08"]
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        metric_value { font_size: 44 font_color: '#14213D' }
        label { font_size: 15 font_color: '#5B6475' }
      }
    }
  }

  block kpi_items: VizBlock {
    label: 'Items Sold'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.items_sold)
        label: 'Items Sold'
        format { type: 'number' pattern: 'inherited' }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value { duration: 1 granularity: 'month' }
      }
      conditions: ["thelook_order_items.created_at matches @2026-08"]
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        metric_value { font_size: 44 font_color: '#14213D' }
        label { font_size: 15 font_color: '#5B6475' }
      }
    }
  }

  block kpi_return_rate: VizBlock {
    label: 'Return Rate'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.return_rate)
        label: 'Return Rate (lower is better)'
        format { type: 'number' pattern: 'inherited' }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value { duration: 1 granularity: 'month' }
      }
      conditions: ["thelook_order_items.created_at matches @2026-08"]
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        metric_value { font_size: 44 font_color: '#14213D' }
        label { font_size: 15 font_color: '#5B6475' }
        compare_value { reverse_color: true }
      }
    }
  }

  block s2_note: TextBlock {
    content: @md
<div style="font-family:Helvetica, Arial, sans-serif; color:#F4EFE6; height:100%; display:flex; flex-direction:column; justify-content:center;">
  <div style="font-size:12px; letter-spacing:3px; text-transform:uppercase; color:#E9A23B;">Read-out</div>
  <div style="font-family:Georgia, serif; font-size:21px; line-height:1.4; margin-top:10px;">Orders <b>+26%</b> while AOV held at <b>~$87</b>. Margin steady at <b>52%</b>; returns fell to <b>10.3%</b>.</div>
</div>
    ;;
    theme {
      background { bg_color: '#14213D' }
      border { border_width: 0 border_radius: 10 }
      padding: 24
    }
  }

  block s2_footer: TextBlock {
    content: @md
<div style="font-family:Helvetica, Arial, sans-serif; font-size:12px; color:#8A8F99; display:flex; justify-content:space-between;"><span>August 2026 vs. July 2026 &middot; Net Sales exclude Cancelled and Returned items</span><span>02 / 05</span></div>
    ;;
    theme {
      background { bg_color: 'transparent' }
      border { border_width: 0 }
      padding: 0
    }
  }

  // ---------------------------------------------------------------- Slide 3: Trend
  block s3_header: TextBlock {
    content: @md
<div style="font-family:Helvetica, Arial, sans-serif;">
  <div style="font-size:13px; letter-spacing:3px; text-transform:uppercase; color:#C0661C;">03 &middot; Trend</div>
  <div style="font-family:Georgia, serif; font-size:40px; color:#14213D; margin-top:6px;">August is a record month, 2.6x a year ago</div>
</div>
    ;;
    theme {
      background { bg_color: 'transparent' }
      border { border_width: 0 }
      padding: 0
    }
  }

  block trend_chart: VizBlock {
    label: 'Net Sales and Gross Profit by Month (Aug 2025 to Aug 2026)'
    viz: ColumnChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        label: 'Month'
        transformation: 'datetrunc month'
        format { type: 'date' pattern: 'LLL yyyy' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format { type: 'number' pattern: 'inherited' }
          }
          settings { color: '#14213D' }
        }
        series {
          field: VizFieldFull {
            ref: r(thelook.gross_profit)
            label: 'Gross Profit'
            format { type: 'number' pattern: 'inherited' }
          }
          settings { color: '#E9A23B' }
        }
      }
      conditions: [
        "thelook_order_items.created_at >= @2025-08-01",
        "thelook_order_items.created_at < @2026-09-01",
      ]
      settings {
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block s3_callouts: TextBlock {
    content: @md
<div style="font-family:Helvetica, Arial, sans-serif; color:#14213D; line-height:1.45;">
  <div style="font-size:12px; letter-spacing:3px; text-transform:uppercase; color:#C0661C;">Net Sales, Aug 2026</div>
  <div style="font-family:Georgia, serif; font-size:52px; margin:4px 0 18px;">$41.0K</div>
  <div style="border-top:1px solid #D9D3C7; padding:14px 0;"><b style="font-size:24px;">+27%</b><br/><span style="color:#5B6475;">vs. Jul 2026 ($32.3K)</span></div>
  <div style="border-top:1px solid #D9D3C7; padding:14px 0;"><b style="font-size:24px;">+157%</b><br/><span style="color:#5B6475;">vs. Aug 2025 ($16.0K)</span></div>
  <div style="border-top:1px solid #D9D3C7; padding:14px 0;"><b style="font-size:24px;">2 months</b><br/><span style="color:#5B6475;">of consecutive growth after a soft June ($26.9K)</span></div>
</div>
    ;;
    theme {
      background { bg_color: '#FFFFFF' }
      border { border_width: 0 border_radius: 10 }
      padding: 28
    }
  }

  block s3_footer: TextBlock {
    content: @md
<div style="font-family:Helvetica, Arial, sans-serif; font-size:12px; color:#8A8F99; display:flex; justify-content:space-between;"><span>13 complete months, Aug 2025 to Aug 2026 &middot; September 2026 excluded (month in progress)</span><span>03 / 05</span></div>
    ;;
    theme {
      background { bg_color: 'transparent' }
      border { border_width: 0 }
      padding: 0
    }
  }

  // ---------------------------------------------------------------- Slide 4: Category breakdown
  block s4_header: TextBlock {
    content: @md
<div style="font-family:Helvetica, Arial, sans-serif;">
  <div style="font-size:13px; letter-spacing:3px; text-transform:uppercase; color:#C0661C;">04 &middot; Category Breakdown</div>
  <div style="font-family:Georgia, serif; font-size:40px; color:#14213D; margin-top:6px;">Growth was broad; Accessories and Pants led</div>
</div>
    ;;
    theme {
      background { bg_color: 'transparent' }
      border { border_width: 0 }
      padding: 0
    }
  }

  block cat_top10: VizBlock {
    label: 'Top 10 Categories by Net Sales, Aug 2026'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Category'
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format { type: 'number' pattern: 'inherited' }
          }
          settings { color: '#14213D' }
        }
        settings { show_data_label_by: 'value' }
      }
      conditions: ["thelook_order_items.created_at matches @2026-08"]
      settings {
        row_limit: 10
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block cat_mom: VizBlock {
    label: 'Change in Net Sales vs. Jul 2026, by Category'
    viz: BarChart {
      dataset: thelook
      calculation mom_change {
        label: 'MoM Change in Net Sales'
        formula: @aql (net_sales | where(thelook_order_items.created_at matches @2026-08)) - (net_sales | where(thelook_order_items.created_at matches @2026-07));;
        calc_type: 'measure'
        data_type: 'number'
      }
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Category'
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: 'mom_change'
            label: 'Change vs. Jul 2026'
            format { type: 'number' pattern: '[$$]#,###0' }
          }
          settings { color: '#E9A23B' }
        }
        settings { show_data_label_by: 'value' }
      }
      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block s4_footer: TextBlock {
    content: @md
<div style="font-family:Helvetica, Arial, sans-serif; font-size:12px; color:#8A8F99; display:flex; justify-content:space-between;"><span>Top 5 categories = 38% of August Net Sales &middot; 18 of 26 categories grew vs. July</span><span>04 / 05</span></div>
    ;;
    theme {
      background { bg_color: 'transparent' }
      border { border_width: 0 }
      padding: 0
    }
  }

  // ---------------------------------------------------------------- Slide 5: Key takeaways
  block s5_header: TextBlock {
    content: @md
<div style="font-family:Helvetica, Arial, sans-serif;">
  <div style="font-size:13px; letter-spacing:3px; text-transform:uppercase; color:#E9A23B;">05 &middot; Key Takeaways</div>
  <div style="font-family:Georgia, serif; font-size:40px; color:#F4EFE6; margin-top:6px;">What August tells us</div>
</div>
    ;;
    theme {
      background { bg_color: 'transparent' }
      border { border_width: 0 }
      padding: 0
    }
  }

  block s5_t1: TextBlock {
    content: @md
<div style="font-family:Helvetica, Arial, sans-serif; color:#14213D; line-height:1.45;">
  <div style="font-family:Georgia, serif; font-size:44px; color:#C0661C;">01</div>
  <div style="font-size:21px; font-weight:bold; margin:8px 0 10px;">Record month, driven by volume</div>
  <div style="font-size:15px; color:#4A5264;">Net Sales hit $41.0K (+27% MoM, +157% YoY). Fulfilled orders rose 26% to 470 while AOV was flat at $87, so demand, not pricing, drove growth.</div>
</div>
    ;;
    theme {
      background { bg_color: '#F4EFE6' }
      border { border_width: 0 border_radius: 10 }
      padding: 26
    }
  }

  block s5_t2: TextBlock {
    content: @md
<div style="font-family:Helvetica, Arial, sans-serif; color:#14213D; line-height:1.45;">
  <div style="font-family:Georgia, serif; font-size:44px; color:#C0661C;">02</div>
  <div style="font-size:21px; font-weight:bold; margin:8px 0 10px;">Profitability scaled cleanly</div>
  <div style="font-size:15px; color:#4A5264;">Gross Profit grew 27% to $21.4K and Gross Margin held at 52.1%, in line with its 51&ndash;53% range over the past year. Growth is not being bought with discounts.</div>
</div>
    ;;
    theme {
      background { bg_color: '#F4EFE6' }
      border { border_width: 0 border_radius: 10 }
      padding: 26
    }
  }

  block s5_t3: TextBlock {
    content: @md
<div style="font-family:Helvetica, Arial, sans-serif; color:#14213D; line-height:1.45;">
  <div style="font-family:Georgia, serif; font-size:44px; color:#C0661C;">03</div>
  <div style="font-size:21px; font-weight:bold; margin:8px 0 10px;">Mix is shifting</div>
  <div style="font-size:15px; color:#4A5264;">Accessories (+$1.5K, 3.3x) and Pants &amp; Capris (+$1.3K, 4.3x) led gains; Suits &amp; Sport Coats added $1.0K at a 60% margin. Active fell 28% and Jeans slipped 6% but is still #1.</div>
</div>
    ;;
    theme {
      background { bg_color: '#F4EFE6' }
      border { border_width: 0 border_radius: 10 }
      padding: 26
    }
  }

  block s5_t4: TextBlock {
    content: @md
<div style="font-family:Helvetica, Arial, sans-serif; color:#14213D; line-height:1.45;">
  <div style="font-family:Georgia, serif; font-size:44px; color:#C0661C;">04</div>
  <div style="font-size:21px; font-weight:bold; margin:8px 0 10px;">Returns improved</div>
  <div style="font-size:15px; color:#4A5264;">Return rate dropped to 10.3% from 13.6% in July, a 3.3-point improvement. Worth confirming whether this holds as newer August orders reach their return window.</div>
</div>
    ;;
    theme {
      background { bg_color: '#F4EFE6' }
      border { border_width: 0 border_radius: 10 }
      padding: 26
    }
  }

  block s5_next: TextBlock {
    content: @md
<div style="font-family:Helvetica, Arial, sans-serif; color:#F4EFE6; font-size:16px; line-height:1.5; display:flex; gap:28px; align-items:center;">
  <span style="font-size:12px; letter-spacing:3px; text-transform:uppercase; color:#E9A23B; white-space:nowrap;">Next steps</span>
  <span>Keep inventory deep in Accessories, Pants &amp; Capris and Suits &amp; Sport Coats &middot; Investigate the Active decline &middot; September is already at $60.5K month-to-date (as of 28 Sep), on pace for another record.</span>
</div>
    ;;
    theme {
      background { bg_color: 'transparent' }
      border { border_width: 1 border_color: '#3A4A6B' border_style: 'solid' border_radius: 10 }
      padding: 20
    }
  }

  block s5_footer: TextBlock {
    content: @md
<div style="font-family:Helvetica, Arial, sans-serif; font-size:12px; color:#8C99AE; display:flex; justify-content:space-between;"><span>Takeaways reflect data as of 28 Sep 2026</span><span>05 / 05</span></div>
    ;;
    theme {
      background { bg_color: 'transparent' }
      border { border_width: 0 }
      padding: 0
    }
  }

  // ---------------------------------------------------------------- Slides (16:9, 1280 x 720)
  view: TabLayout {
    tab slide_1_title: CanvasLayout {
      label: '1. Title'
      width: 1280
      height: 720
      grid_size: 20
      default_zoom: 'fit_to_page'
      theme {
        background { bg_color: '#14213D' }
      }
      block s1_title {
        position: pos(0, 0, 1280, 720)
      }
      mobile { mode: 'auto' }
    }

    tab slide_2_kpis: CanvasLayout {
      label: '2. Headline KPIs'
      width: 1280
      height: 720
      grid_size: 20
      default_zoom: 'fit_to_page'
      theme {
        background { bg_color: '#F4EFE6' }
      }
      block s2_header {
        position: pos(60, 40, 1160, 100)
      }
      block kpi_net_sales {
        position: pos(60, 160, 275, 220)
      }
      block kpi_gross_profit {
        position: pos(355, 160, 275, 220)
      }
      block kpi_orders {
        position: pos(650, 160, 275, 220)
      }
      block kpi_aov {
        position: pos(945, 160, 275, 220)
      }
      block kpi_margin {
        position: pos(60, 400, 275, 220)
      }
      block kpi_items {
        position: pos(355, 400, 275, 220)
      }
      block kpi_return_rate {
        position: pos(650, 400, 275, 220)
      }
      block s2_note {
        position: pos(945, 400, 275, 220)
      }
      block s2_footer {
        position: pos(60, 660, 1160, 30)
      }
      mobile { mode: 'auto' }
    }

    tab slide_3_trend: CanvasLayout {
      label: '3. Trend'
      width: 1280
      height: 720
      grid_size: 20
      default_zoom: 'fit_to_page'
      theme {
        background { bg_color: '#F4EFE6' }
      }
      block s3_header {
        position: pos(60, 40, 1160, 100)
      }
      block trend_chart {
        position: pos(60, 160, 820, 480)
      }
      block s3_callouts {
        position: pos(900, 160, 320, 480)
      }
      block s3_footer {
        position: pos(60, 660, 1160, 30)
      }
      mobile { mode: 'auto' }
    }

    tab slide_4_categories: CanvasLayout {
      label: '4. Category Breakdown'
      width: 1280
      height: 720
      grid_size: 20
      default_zoom: 'fit_to_page'
      theme {
        background { bg_color: '#F4EFE6' }
      }
      block s4_header {
        position: pos(60, 40, 1160, 100)
      }
      block cat_top10 {
        position: pos(60, 160, 570, 480)
      }
      block cat_mom {
        position: pos(650, 160, 570, 480)
      }
      block s4_footer {
        position: pos(60, 660, 1160, 30)
      }
      mobile { mode: 'auto' }
    }

    tab slide_5_takeaways: CanvasLayout {
      label: '5. Key Takeaways'
      width: 1280
      height: 720
      grid_size: 20
      default_zoom: 'fit_to_page'
      theme {
        background { bg_color: '#14213D' }
      }
      block s5_header {
        position: pos(60, 40, 1160, 100)
      }
      block s5_t1 {
        position: pos(60, 160, 275, 340)
      }
      block s5_t2 {
        position: pos(355, 160, 275, 340)
      }
      block s5_t3 {
        position: pos(650, 160, 275, 340)
      }
      block s5_t4 {
        position: pos(945, 160, 275, 340)
      }
      block s5_next {
        position: pos(60, 520, 1160, 120)
      }
      block s5_footer {
        position: pos(60, 660, 1160, 30)
      }
      mobile { mode: 'auto' }
    }
  }

  theme: H.themes.vanilla
}
