Dashboard r04_claude_fd_html_a2 {
  title: 'Monthly Performance Review'
  description: 'Five-slide monthly read-out for TheLook eCommerce: headline KPIs, 12-month trend, category breakdown and key takeaways.'

  // ---------- Filter ----------
  block f_month: FilterBlock {
    label: 'Reporting month'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
    default {
      operator: 'matches'
      value: 'last month'
    }
    settings {
      input_type: 'single'
    }
  }

  // ---------- Slide 2: headline KPIs ----------
  block kpi_net_sales: VizBlock {
    label: 'Net Sales'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        value {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
      }
    }
  }

  block kpi_gross_profit: VizBlock {
    label: 'Gross Profit'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_profit)
        label: 'Gross Profit'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        value {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
      }
    }
  }

  block kpi_gross_margin: VizBlock {
    label: 'Gross Margin'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        value {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_number'
        alignment: 'left'
      }
    }
  }

  block kpi_orders: VizBlock {
    label: 'Fulfilled Orders'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        label: 'Fulfilled Orders'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        value {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
      }
    }
  }

  block kpi_aov: VizBlock {
    label: 'Average Order Value'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        value {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
      }
    }
  }

  block kpi_return_rate: VizBlock {
    label: 'Return Rate'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.return_rate)
        label: 'Return Rate'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        value {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_number'
        alignment: 'left'
        compare_value {
          reverse_color: true
        }
      }
    }
  }

  // ---------- Slide 3: trend (fixed trailing 12 months, not tied to the month filter) ----------
  block trend_sales_margin: VizBlock {
    label: 'Net Sales and Gross Margin, last 12 complete months'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        label: 'Net Sales'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#B4532A'
          }
        }
        settings {
          alignment: 'left'
        }
      }
      y_axis {
        label: 'Gross Margin'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.gross_margin)
            label: 'Gross Margin'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#2E3A46'
          }
        }
        settings {
          alignment: 'right'
          axis_min: 0
          axis_max: 1
        }
      }
      filter {
        field: r(thelook_order_items.created_at)
        operator: 'matches'
        value: 'last 12 months'
      }
      settings {
        x_axis_label: 'Month'
        legend_label: 'top'
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  // ---------- Slide 4: category breakdown ----------
  block cat_bar: VizBlock {
    label: 'Top 10 categories by Net Sales'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Category'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#B4532A'
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      settings {
        row_limit: 10
        legend_label: 'hidden'
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block cat_table: VizBlock {
    label: 'Category scorecard'
    viz: DataTable {
      dataset: thelook
      // Shifts whatever month the filter selects back by one month
      calculation net_sales_mom {
        label: 'vs Prior Month'
        formula: @aql safe_divide(net_sales, net_sales | relative_period(thelook_order_items.created_at, interval(-1 month))) - 1 ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      fields: [
        VizFieldFull {
          ref: r(thelook_products.category)
          label: 'Category'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: 'net_sales_mom'
          label: 'vs Prior Month'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        },
        VizFieldFull {
          ref: r(thelook.gross_margin)
          label: 'Gross Margin'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.return_rate)
          label: 'Return Rate'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        pagination_size: 30
        show_row_number: false
        sorts: [
          IndexBasedSortSetting {
            field_index: 1
            direction: 'desc'
          }
        ]
      }
    }
  }

  interactions: [
    FilterInteraction {
      from: 'f_month'
      to: [
        CustomMapping {
          block: ['kpi_net_sales', 'kpi_gross_profit', 'kpi_gross_margin', 'kpi_orders', 'kpi_aov', 'kpi_return_rate', 'cat_bar', 'cat_table']
          field: r(thelook_order_items.created_at)
        },
        CustomMapping {
          block: 'trend_sales_margin'
          disabled: true
        }
      ]
    }
  ]

  view: HTMLLayout {
    content: @html
      <style>
        .deck {
          --paper: #F4F0E8;
          --card: #FFFFFF;
          --ink: #1C1B18;
          --muted: #6B665C;
          --rule: #DDD5C7;
          --accent: #B4532A;
          --slate: #2E3A46;
          background: #E7E1D6;
          padding: 28px 24px 20px;
          font-family: 'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif;
          color: var(--ink);
          box-sizing: border-box;
        }
        .deck *, .deck *::before, .deck *::after { box-sizing: border-box; }

        /* 16:9 slide frame */
        .slide {
          display: none;
          position: relative;
          width: 100%;
          max-width: 1280px;
          margin: 0 auto;
          aspect-ratio: 16 / 9;
          background: var(--paper);
          border-radius: 6px;
          box-shadow: 0 1px 2px rgba(28,27,24,.08), 0 12px 32px rgba(28,27,24,.10);
          padding: 44px 56px 56px;
          overflow: hidden;
          flex-direction: column;
          gap: 20px;
        }
        .slide:target { display: flex; }
        .deck:not(:has(.slide:target)) #slide-1 { display: flex; }

        .kicker {
          font-size: 12px;
          letter-spacing: .16em;
          text-transform: uppercase;
          color: var(--accent);
          font-weight: 600;
          margin: 0;
        }
        .headline {
          font-family: 'Fraunces', 'Georgia', 'Times New Roman', serif;
          font-weight: 500;
          font-size: 34px;
          line-height: 1.15;
          letter-spacing: -.01em;
          margin: 6px 0 0;
        }
        .sub { color: var(--muted); font-size: 14px; margin: 6px 0 0; max-width: 72ch; }
        .body { flex: 1; min-height: 0; display: grid; gap: 16px; }

        .card {
          background: var(--card);
          border: 1px solid var(--rule);
          border-radius: 4px;
          min-height: 0;
          overflow: hidden;
          display: flex;
          flex-direction: column;
        }
        .card > * { flex: 1; min-height: 0; }

        /* footer: page number + prev/next */
        .foot {
          position: absolute;
          left: 56px; right: 56px; bottom: 18px;
          display: flex; align-items: center; justify-content: space-between;
          font-size: 12px; color: var(--muted);
          border-top: 1px solid var(--rule);
          padding-top: 10px;
        }
        .foot .pager a {
          color: var(--ink); text-decoration: none; margin-left: 18px; font-weight: 500;
        }
        .foot .pager a:hover { color: var(--accent); }

        /* Slide 1: title */
        #slide-1 { background: var(--slate); color: #F4F0E8; justify-content: space-between; }
        #slide-1 .kicker { color: #E9A27F; }
        #slide-1 .title {
          font-family: 'Fraunces', 'Georgia', 'Times New Roman', serif;
          font-weight: 400;
          font-size: 72px;
          line-height: 1.0;
          letter-spacing: -.02em;
          margin: 18px 0 0;
          max-width: 12ch;
        }
        #slide-1 .title em { font-style: italic; color: #E9A27F; }
        #slide-1 .lede { font-size: 16px; color: #C9CFD6; max-width: 56ch; margin: 20px 0 0; line-height: 1.5; }
        #slide-1 .picker {
          display: grid; grid-template-columns: 1fr 340px; align-items: end; gap: 32px;
        }
        #slide-1 .picker .card { height: 96px; border: none; }
        #slide-1 .agenda { list-style: none; margin: 0; padding: 0; display: flex; gap: 28px; font-size: 13px; color: #C9CFD6; }
        #slide-1 .agenda a { color: inherit; text-decoration: none; }
        #slide-1 .agenda a:hover { color: #FFFFFF; }
        #slide-1 .agenda b { color: #E9A27F; font-weight: 600; margin-right: 6px; }
        #slide-1 .foot { border-top-color: rgba(244,240,232,.18); color: #9AA5B1; }
        #slide-1 .foot .pager a { color: #F4F0E8; }

        /* Slide 2: KPI grid */
        .kpis { grid-template-columns: repeat(3, 1fr); grid-template-rows: 1fr 1fr; }
        .kpis .card { border-top: 3px solid var(--accent); }
        .kpis .card.quality { border-top-color: var(--slate); }

        /* Slide 3: trend */
        .trend { grid-template-columns: 1fr 260px; }
        .notes { display: flex; flex-direction: column; gap: 18px; padding-top: 4px; }
        .notes .n { border-left: 2px solid var(--accent); padding-left: 14px; }
        .notes .n b { display: block; font-size: 12px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); font-weight: 600; margin-bottom: 4px; }
        .notes .n span { font-size: 14px; line-height: 1.45; }

        /* Slide 4: categories */
        .cats { grid-template-columns: 1fr 1.15fr; }

        /* Slide 5: takeaways */
        .takeaways { grid-template-columns: repeat(2, 1fr); grid-template-rows: 1fr 1fr; gap: 18px 28px; }
        .tk { border-top: 1px solid var(--rule); padding-top: 14px; display: grid; grid-template-columns: 44px 1fr; gap: 0 12px; align-content: start; }
        .tk .num { font-family: 'Fraunces', 'Georgia', serif; font-size: 34px; line-height: 1; color: var(--accent); }
        .tk h3 { margin: 0 0 6px; font-size: 17px; font-weight: 600; line-height: 1.3; }
        .tk p { margin: 0; font-size: 14px; line-height: 1.5; color: #3D3A34; }
        .tk.action .num { color: var(--slate); }

        /* bottom deck nav */
        .dots { display: flex; justify-content: center; gap: 8px; margin: 16px auto 0; max-width: 1280px; }
        .dots a {
          font-size: 12px; text-decoration: none; color: var(--muted);
          padding: 6px 12px; border-radius: 999px; border: 1px solid #CFC6B6; background: #F4F0E8;
        }
        .dots a:hover { color: var(--ink); border-color: var(--ink); }
      </style>

      <div class="deck">

        <!-- 1 · Title -->
        <section class="slide" id="slide-1">
          <div>
            <p class="kicker">TheLook eCommerce · Monthly business review</p>
            <h1 class="title">Monthly <em>performance</em> review</h1>
            <p class="lede">Sales, profitability and order quality for the reporting month, set against the prior month and the trailing twelve months.</p>
          </div>
          <div class="picker">
            <ul class="agenda">
              <li><a href="#slide-2"><b>02</b>Headline KPIs</a></li>
              <li><a href="#slide-3"><b>03</b>Trend</a></li>
              <li><a href="#slide-4"><b>04</b>Categories</a></li>
              <li><a href="#slide-5"><b>05</b>Takeaways</a></li>
            </ul>
            <div class="card"><h-block name="f_month" /></div>
          </div>
          <div class="foot"><span>01 / 05</span><span class="pager"><a href="#slide-2">Next →</a></span></div>
        </section>

        <!-- 2 · Headline KPIs -->
        <section class="slide" id="slide-2">
          <div>
            <p class="kicker">02 · Headline KPIs</p>
            <h2 class="headline">How the month landed</h2>
            <p class="sub">Reporting month vs the prior month. Net Sales, Gross Profit and Gross Margin exclude cancelled and returned items; a falling return rate shows in green.</p>
          </div>
          <div class="body kpis">
            <div class="card"><h-block name="kpi_net_sales" /></div>
            <div class="card"><h-block name="kpi_gross_profit" /></div>
            <div class="card"><h-block name="kpi_gross_margin" /></div>
            <div class="card quality"><h-block name="kpi_orders" /></div>
            <div class="card quality"><h-block name="kpi_aov" /></div>
            <div class="card quality"><h-block name="kpi_return_rate" /></div>
          </div>
          <div class="foot"><span>02 / 05 · Headline KPIs</span><span class="pager"><a href="#slide-1">← Prev</a><a href="#slide-3">Next →</a></span></div>
        </section>

        <!-- 3 · Trend -->
        <section class="slide" id="slide-3">
          <div>
            <p class="kicker">03 · Trend</p>
            <h2 class="headline">Sales are growing, and margin is holding</h2>
            <p class="sub">Monthly Net Sales (columns) and Gross Margin (line) for the last 12 complete months. This chart ignores the reporting-month filter.</p>
          </div>
          <div class="body trend">
            <div class="card"><h-block name="trend_sales_margin" /></div>
            <div class="notes">
              <div class="n"><b>Reading the bars</b><span>Every column is a full calendar month, so month-over-month steps compare like with like.</span></div>
              <div class="n"><b>Reading the line</b><span>Gross Margin is on the right axis (0–100%). A flat line means growth isn't coming from discounting.</span></div>
              <div class="n"><b>Scope</b><span>Order items by created date. Cancelled and returned items are excluded.</span></div>
            </div>
          </div>
          <div class="foot"><span>03 / 05 · Trend</span><span class="pager"><a href="#slide-2">← Prev</a><a href="#slide-4">Next →</a></span></div>
        </section>

        <!-- 4 · Category breakdown -->
        <section class="slide" id="slide-4">
          <div>
            <p class="kicker">04 · Category breakdown</p>
            <h2 class="headline">Where the month's sales came from</h2>
            <p class="sub">Top 10 product categories by Net Sales for the reporting month, with a scorecard for every category: change vs prior month, margin and returns.</p>
          </div>
          <div class="body cats">
            <div class="card"><h-block name="cat_bar" /></div>
            <div class="card"><h-block name="cat_table" /></div>
          </div>
          <div class="foot"><span>04 / 05 · Category breakdown</span><span class="pager"><a href="#slide-3">← Prev</a><a href="#slide-5">Next →</a></span></div>
        </section>

        <!-- 5 · Key takeaways -->
        <section class="slide" id="slide-5">
          <div>
            <p class="kicker">05 · Key takeaways · August 2026 read-out</p>
            <h2 class="headline">Growth came from more orders, not bigger baskets</h2>
            <p class="sub">Notes written for August 2026 against July 2026. The live slides update when you change the reporting month; these notes do not.</p>
          </div>
          <div class="body takeaways">
            <div class="tk">
              <div class="num">1</div>
              <div>
                <h3>Net Sales up 27% to about $41.0K</h3>
                <p>That's the best month in the last 12 and 2.7× September 2025 ($15.0K). Fulfilled orders rose 26% (372 → 470), so almost all the growth came from order volume.</p>
              </div>
            </div>
            <div class="tk">
              <div class="num">2</div>
              <div>
                <h3>Basket size and margin held flat</h3>
                <p>AOV was $87.23, up from $86.80. Gross Margin was 52.1%, compared with 52.2%. The extra volume didn't cost any price or mix quality.</p>
              </div>
            </div>
            <div class="tk">
              <div class="num">3</div>
              <div>
                <h3>Tailoring and accessories drove the gains</h3>
                <p>Accessories grew by $1.5K, Pants &amp; Capris by $1.3K and Suits &amp; Sport Coats by $1.0K. Jeans ($3.6K) and Outerwear &amp; Coats ($3.6K) still lead but were flat to slightly down.</p>
              </div>
            </div>
            <div class="tk action">
              <div class="num">4</div>
              <div>
                <h3>Returns eased, but watch Swim and Dresses</h3>
                <p>The return rate fell from 13.6% to 10.3%. Swim (18.8%) and Dresses (16.1%) are still well above average, so start there with sizing and product-page fixes.</p>
              </div>
            </div>
          </div>
          <div class="foot"><span>05 / 05 · Key takeaways</span><span class="pager"><a href="#slide-4">← Prev</a><a href="#slide-1">Back to start ↺</a></span></div>
        </section>

        <nav class="dots">
          <a href="#slide-1">1 · Title</a>
          <a href="#slide-2">2 · KPIs</a>
          <a href="#slide-3">3 · Trend</a>
          <a href="#slide-4">4 · Categories</a>
          <a href="#slide-5">5 · Takeaways</a>
        </nav>
      </div>
    ;;
  }
}
