Dashboard r04_claude_html_a1 {
  title: 'Monthly Performance Review – September 2026'
  description: 'Five 16:9 slides for the TheLook monthly review: title, headline KPIs, trend, category breakdown and key takeaways. Reporting month: Sep 2026, compared with Aug 2026.'

  // ---------- Slide 2: headline KPIs (Sep 2026 vs Aug 2026) ----------
  block kpi_net_sales: VizBlock {
    label: 'Net Sales'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        value: AbsolutePopValue {
          from: '2026-08-01'
          to: '2026-08-31'
        }
      }
      filter {
        field: r(thelook_order_items.created_at)
        operator: 'between'
        value: ['2026-09-01', '2026-09-30']
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'center'
      }
    }
  }

  block kpi_gross_profit: VizBlock {
    label: 'Gross Profit'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_profit)
        label: 'Gross Profit'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        value: AbsolutePopValue {
          from: '2026-08-01'
          to: '2026-08-31'
        }
      }
      filter {
        field: r(thelook_order_items.created_at)
        operator: 'between'
        value: ['2026-09-01', '2026-09-30']
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'center'
      }
    }
  }

  block kpi_orders: VizBlock {
    label: 'Fulfilled Orders'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        label: 'Fulfilled Orders'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        value: AbsolutePopValue {
          from: '2026-08-01'
          to: '2026-08-31'
        }
      }
      filter {
        field: r(thelook_order_items.created_at)
        operator: 'between'
        value: ['2026-09-01', '2026-09-30']
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'center'
      }
    }
  }

  block kpi_aov: VizBlock {
    label: 'Average Order Value'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        value: AbsolutePopValue {
          from: '2026-08-01'
          to: '2026-08-31'
        }
      }
      filter {
        field: r(thelook_order_items.created_at)
        operator: 'between'
        value: ['2026-09-01', '2026-09-30']
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'center'
      }
    }
  }

  block kpi_gross_margin: VizBlock {
    label: 'Gross Margin'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        value: AbsolutePopValue {
          from: '2026-08-01'
          to: '2026-08-31'
        }
      }
      filter {
        field: r(thelook_order_items.created_at)
        operator: 'between'
        value: ['2026-09-01', '2026-09-30']
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'center'
      }
    }
  }

  block kpi_return_rate: VizBlock {
    label: 'Return Rate'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.return_rate)
        label: 'Return Rate'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        value: AbsolutePopValue {
          from: '2026-08-01'
          to: '2026-08-31'
        }
      }
      filter {
        field: r(thelook_order_items.created_at)
        operator: 'between'
        value: ['2026-09-01', '2026-09-30']
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'center'
      }
    }
  }

  // ---------- Slide 3: 12-month trend ----------
  block trend_sales_margin: VizBlock {
    label: 'Net Sales & Gross Margin, last 12 months'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        label: 'Month'
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        label: 'Net Sales'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        settings {
          alignment: 'left'
        }
      }
      y_axis {
        label: 'Gross Margin'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.gross_margin)
            label: 'Gross Margin'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        settings {
          alignment: 'right'
        }
      }
      conditions: [
        "thelook_order_items.created_at matches @(2025-10-01 - 2026-09-30)",
      ]
      settings {
        legend_label: 'top'
        show_data_points: true
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  // ---------- Slide 4: category breakdown ----------
  block category_net_sales: VizBlock {
    label: 'Top 10 categories by Net Sales, Sep 2026'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Category'
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      conditions: [
        "thelook_order_items.created_at matches @(2026-09-01 - 2026-09-30)",
      ]
      settings {
        row_limit: 10
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  view: HTMLLayout {
    content: @html
      <style>
        .deck, .deck * { box-sizing: border-box; }
        .deck {
          display: flex;
          flex-direction: column;
          gap: 32px;
          padding: 24px;
          background: #e9edf2;
          font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
          color: #1f2937;
        }
        .slide {
          position: relative;
          width: 100%;
          max-width: 1400px;
          margin: 0 auto;
          aspect-ratio: 16 / 9;
          display: flex;
          flex-direction: column;
          overflow: hidden;
          padding: 4.5% 5% 3.5%;
          background: #ffffff;
          border-radius: 10px;
          box-shadow: 0 4px 16px rgba(15, 23, 42, 0.08);
        }
        .slide-head { margin-bottom: 20px; }
        .eyebrow {
          margin: 0 0 8px;
          font-size: 13px;
          font-weight: 600;
          letter-spacing: 0.1em;
          text-transform: uppercase;
          color: #2563eb;
        }
        .slide-title {
          margin: 0;
          font-size: 32px;
          line-height: 1.15;
          font-weight: 700;
          color: #0f172a;
        }
        .slide-body { flex: 1; min-height: 0; display: grid; gap: 20px; }
        .slide-foot {
          display: flex;
          justify-content: space-between;
          margin-top: 18px;
          padding-top: 12px;
          border-top: 1px solid #e5e7eb;
          font-size: 12px;
          color: #6b7280;
        }
        .panel {
          min-height: 0;
          height: 100%;
          border: 1px solid #e5e7eb;
          border-radius: 8px;
          overflow: hidden;
        }
        .note {
          display: flex;
          flex-direction: column;
          justify-content: center;
          gap: 18px;
          padding: 8px 4px;
        }
        .note h3 {
          margin: 0 0 4px;
          font-size: 13px;
          font-weight: 600;
          letter-spacing: 0.06em;
          text-transform: uppercase;
          color: #6b7280;
        }
        .note p, .note li { margin: 0; font-size: 15px; line-height: 1.5; color: #374151; }
        .note ul { margin: 0; padding-left: 18px; }
        .note li + li { margin-top: 4px; }
        .big { font-size: 26px; font-weight: 700; color: #0f172a; }
        .up { color: #15803d; font-weight: 600; }
        .down { color: #b91c1c; font-weight: 600; }

        /* Slide 1 – title */
        .title-slide {
          justify-content: center;
          background: #0f172a;
          color: #f8fafc;
        }
        .title-slide .eyebrow { color: #60a5fa; font-size: 15px; }
        .title-slide h1 {
          margin: 0 0 16px;
          font-size: 60px;
          line-height: 1.05;
          font-weight: 700;
        }
        .title-slide .sub { margin: 0; font-size: 22px; color: #cbd5e1; }
        .title-slide .meta {
          position: absolute;
          left: 5%;
          right: 5%;
          bottom: 6%;
          display: flex;
          justify-content: space-between;
          font-size: 14px;
          color: #94a3b8;
        }
        .title-slide .accent {
          width: 72px;
          height: 4px;
          margin-bottom: 28px;
          background: #3b82f6;
          border-radius: 2px;
        }

        /* Slide 2 – KPI grid */
        .kpi-grid { grid-template-columns: repeat(3, 1fr); grid-template-rows: 1fr 1fr; }

        /* Slide 3 & 4 – chart + notes */
        .chart-notes { grid-template-columns: 2.3fr 1fr; }

        /* Slide 5 – takeaways */
        .takeaways { grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; }
        .card {
          display: flex;
          gap: 16px;
          padding: 22px 24px;
          border: 1px solid #e5e7eb;
          border-left: 4px solid #2563eb;
          border-radius: 8px;
          background: #f8fafc;
        }
        .card.watch { border-left-color: #d97706; }
        .card .num { font-size: 28px; font-weight: 700; color: #cbd5e1; line-height: 1; }
        .card h3 { margin: 0 0 8px; font-size: 19px; color: #0f172a; }
        .card p { margin: 0; font-size: 15px; line-height: 1.5; color: #374151; }

        @media (max-width: 900px) {
          .slide { aspect-ratio: auto; min-height: 520px; }
          .kpi-grid, .chart-notes, .takeaways { grid-template-columns: 1fr; grid-template-rows: none; }
          .panel { height: 320px; }
        }
      </style>

      <main class="deck">

        <!-- 1. Title -->
        <section class="slide title-slide">
          <div class="accent"></div>
          <p class="eyebrow">TheLook eCommerce · Monthly Performance Review</p>
          <h1>September 2026</h1>
          <p class="sub">Record month: net sales up 48% on August, driven by volume across seasonal categories.</p>
          <div class="meta">
            <span>Reporting period: 1–30 Sep 2026 · compared with Aug 2026</span>
            <span>Source: TheLook eCommerce dataset</span>
          </div>
        </section>

        <!-- 2. Headline KPIs -->
        <section class="slide">
          <div class="slide-head">
            <p class="eyebrow">Headline KPIs</p>
            <h2 class="slide-title">Sales, profit and orders all grew by roughly half versus August</h2>
          </div>
          <div class="slide-body kpi-grid">
            <div class="panel"><h-block name="kpi_net_sales" /></div>
            <div class="panel"><h-block name="kpi_gross_profit" /></div>
            <div class="panel"><h-block name="kpi_orders" /></div>
            <div class="panel"><h-block name="kpi_aov" /></div>
            <div class="panel"><h-block name="kpi_gross_margin" /></div>
            <div class="panel"><h-block name="kpi_return_rate" /></div>
          </div>
          <div class="slide-foot"><span>Sep 2026 vs Aug 2026 · Net figures exclude cancelled and returned items</span><span>2 / 5</span></div>
        </section>

        <!-- 3. Trend -->
        <section class="slide">
          <div class="slide-head">
            <p class="eyebrow">12-month trend</p>
            <h2 class="slide-title">Growth has accelerated for three straight months while margin holds near 52%</h2>
          </div>
          <div class="slide-body chart-notes">
            <div class="panel"><h-block name="trend_sales_margin" /></div>
            <div class="note">
              <div>
                <h3>September net sales</h3>
                <p class="big">$60.5K</p>
                <p><span class="up">+48%</span> MoM · about 4× Sep 2025 ($14.5K)</p>
              </div>
              <div>
                <h3>Momentum</h3>
                <p>Net sales rose every month since June: $26.9K → $32.3K → $41.0K → $60.5K.</p>
              </div>
              <div>
                <h3>Margin</h3>
                <p>Gross margin stayed in a tight 51–53% band all year; September dipped to 51.5%.</p>
              </div>
            </div>
          </div>
          <div class="slide-foot"><span>Oct 2025 – Sep 2026 · Net Sales (columns) and Gross Margin (line)</span><span>3 / 5</span></div>
        </section>

        <!-- 4. Category breakdown -->
        <section class="slide">
          <div class="slide-head">
            <p class="eyebrow">Category breakdown</p>
            <h2 class="slide-title">Jeans and Outerwear led the month; gains were concentrated in cold-weather and denim lines</h2>
          </div>
          <div class="slide-body chart-notes">
            <div class="panel"><h-block name="category_net_sales" /></div>
            <div class="note">
              <div>
                <h3>Biggest gainers vs Aug</h3>
                <ul>
                  <li>Jeans: $8.2K, <span class="up">+125%</span></li>
                  <li>Shorts: $4.8K, <span class="up">+142%</span></li>
                  <li>Outerwear &amp; Coats: $6.7K, <span class="up">+87%</span></li>
                  <li>Hoodies &amp; Sweatshirts: $3.8K, <span class="up">+64%</span></li>
                </ul>
              </div>
              <div>
                <h3>Declines vs Aug</h3>
                <ul>
                  <li>Pants &amp; Capris: <span class="down">−61%</span></li>
                  <li>Skirts: <span class="down">−55%</span></li>
                  <li>Suits: <span class="down">−47%</span></li>
                  <li>Blazers &amp; Jackets: <span class="down">−34%</span></li>
                  <li>Dresses: <span class="down">−19%</span></li>
                </ul>
              </div>
            </div>
          </div>
          <div class="slide-foot"><span>Net Sales by product category, Sep 2026 (top 10 shown)</span><span>4 / 5</span></div>
        </section>

        <!-- 5. Key takeaways -->
        <section class="slide">
          <div class="slide-head">
            <p class="eyebrow">Key takeaways</p>
            <h2 class="slide-title">Volume is driving growth; protect margin and average order value</h2>
          </div>
          <div class="slide-body takeaways">
            <div class="card">
              <span class="num">01</span>
              <div>
                <h3>Record month on volume</h3>
                <p>Net sales hit $60.5K (+48% MoM) and gross profit $31.2K (+46%). Fulfilled orders rose 52% to 714, which accounts for almost all of the growth.</p>
              </div>
            </div>
            <div class="card">
              <span class="num">02</span>
              <div>
                <h3>Returns improved</h3>
                <p>The return rate fell to 8.5% from 10.3% in August and 13.6% in July, the lowest level since March.</p>
              </div>
            </div>
            <div class="card watch">
              <span class="num">03</span>
              <div>
                <h3>Watch: basket size and margin</h3>
                <p>AOV slipped 3% to $84.73 and gross margin eased to 51.5%. Lower-margin Jeans (46%) and Tops &amp; Tees (44%) took a bigger share of the mix.</p>
              </div>
            </div>
            <div class="card watch">
              <span class="num">04</span>
              <div>
                <h3>Watch: tailored and dress categories</h3>
                <p>Suits, Blazers, Skirts, Dresses and Pants &amp; Capris declined while the business grew. Review assortment and promotions ahead of Q4.</p>
              </div>
            </div>
          </div>
          <div class="slide-foot"><span>Figures: Sep 2026 vs Aug 2026 unless stated</span><span>5 / 5</span></div>
        </section>

      </main>
    ;;
  }

  theme {
    block {
      background {
        bg_color: "transparent"
      }
      border {
        border_width: 0
      }
    }
  }
}
