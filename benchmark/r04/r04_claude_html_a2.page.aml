Dashboard r04_claude_html_a2 {
  title: 'Monthly Performance Review'
  description: '5-slide 16:9 deck: title, headline KPIs, trend, category breakdown, key takeaways (TheLook eCommerce).'

  // ---------- Filter ----------
  block f_month: FilterBlock {
    label: 'Reporting month'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
    default {
      operator: 'matches'
      value: 'last 1 month'
    }
  }

  // ---------- Slide 2: headline KPIs (vs previous month) ----------
  block kpi_net_sales: VizBlock {
    label: 'Net Sales'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format { type: 'number' pattern: 'inherited' }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        value { duration: 1 granularity: 'month' }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        metric_value { font_size: 34 }
        label { font_size: 14 }
      }
    }
  }

  block kpi_gross_profit: VizBlock {
    label: 'Gross Profit'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_profit)
        label: 'Gross Profit'
        format { type: 'number' pattern: 'inherited' }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        value { duration: 1 granularity: 'month' }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        metric_value { font_size: 34 }
        label { font_size: 14 }
      }
    }
  }

  block kpi_gross_margin: VizBlock {
    label: 'Gross Margin'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format { type: 'number' pattern: 'inherited' }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        value { duration: 1 granularity: 'month' }
      }
      settings {
        display_mode: 'compare_by_number'
        alignment: 'left'
        metric_value { font_size: 34 }
        label { font_size: 14 }
      }
    }
  }

  block kpi_orders: VizBlock {
    label: 'Fulfilled Orders'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        label: 'Fulfilled Orders'
        format { type: 'number' pattern: 'inherited' }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        value { duration: 1 granularity: 'month' }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        metric_value { font_size: 34 }
        label { font_size: 14 }
      }
    }
  }

  block kpi_aov: VizBlock {
    label: 'Average Order Value'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'
        format { type: 'number' pattern: 'inherited' }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        value { duration: 1 granularity: 'month' }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        metric_value { font_size: 34 }
        label { font_size: 14 }
      }
    }
  }

  block kpi_return_rate: VizBlock {
    label: 'Return Rate'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.return_rate)
        label: 'Return Rate (lower is better)'
        format { type: 'number' pattern: 'inherited' }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        value { duration: 1 granularity: 'month' }
      }
      settings {
        display_mode: 'compare_by_number'
        alignment: 'left'
        metric_value { font_size: 34 }
        label { font_size: 14 }
        compare_value { reverse_color: true }
      }
    }
  }

  // ---------- Slide 3: trailing 13-month trend (not affected by the month filter) ----------
  block v_trend: VizBlock {
    label: 'Net Sales & Fulfilled Orders, last 13 months'
    settings { hide_label: true }
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format { type: 'date' pattern: 'LLL yyyy' }
      }
      y_axis {
        label: 'Net Sales'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format { type: 'number' pattern: 'inherited' }
          }
          settings { color: '#3B5BDB' }
        }
        settings { alignment: 'left' }
      }
      y_axis {
        label: 'Fulfilled Orders'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.fulfilled_orders)
            label: 'Fulfilled Orders'
            format { type: 'number' pattern: 'inherited' }
          }
          settings { color: '#F08C00' }
        }
        settings { alignment: 'right' }
      }
      conditions: [
        "thelook_order_items.created_at matches @(last 13 months)",
      ]
      settings {
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  // ---------- Slide 4: category breakdown ----------
  block v_category_bar: VizBlock {
    label: 'Top 10 categories by Net Sales'
    settings { hide_label: true }
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Category'
        format { type: 'text' }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format { type: 'number' pattern: 'inherited' }
          }
          settings { color: '#3B5BDB' }
        }
        settings { show_data_label_by: 'value' }
      }
      settings {
        row_limit: 10
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block v_category_table: VizBlock {
    label: 'Category scorecard'
    settings { hide_label: true }
    viz: DataTable {
      dataset: thelook
      // Shift the filtered date range back one month (works without a date dimension in the table)
      calculation net_sales_mom {
        label: 'MoM %'
        formula: @aql safe_divide(net_sales, relative_period(net_sales, thelook_order_items.created_at, interval(-1 month))) - 1 ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      fields: [
        VizFieldFull {
          ref: r(thelook_products.category)
          label: 'Category'
          format { type: 'text' }
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format { type: 'number' pattern: 'inherited' }
        },
        VizFieldFull {
          ref: 'net_sales_mom'
          label: 'MoM %'
          format { type: 'number' pattern: '#,###0.0%' }
        },
        VizFieldFull {
          ref: r(thelook.gross_margin)
          label: 'Margin'
          format { type: 'number' pattern: 'inherited' }
        },
      ]
      settings {
        row_limit: 10
        sorts: [
          IndexBasedSortSetting {
            field_index: 1
            direction: 'desc'
          },
        ]
        pagination_size: 10
        show_row_number: false
      }
    }
  }

  interactions: [
    FilterInteraction {
      from: 'f_month'
      to: [
        CustomMapping {
          block: 'v_trend'
          disabled: true
        }
      ]
    }
  ]

  view: HTMLLayout {
    content: @html
      <div class="deck">
        <style>
          .deck, .deck *, .deck *::before, .deck *::after { box-sizing: border-box; }
          .deck {
            --ink: #1B2437;
            --muted: #5F6B7E;
            --line: #E3E7EE;
            --surface: #FFFFFF;
            --canvas: #F5F7FB;
            --accent: #3B5BDB;
            --accent-2: #F08C00;
            --good: #2B8A3E;
            --bad: #C92A2A;
            width: 100%;
            max-width: 1440px;
            margin: 0 auto;
            aspect-ratio: 16 / 9;
            min-height: 720px;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            background: var(--canvas);
            color: var(--ink);
            border: 1px solid var(--line);
            border-radius: 10px;
            font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
          }

          /* Persistent top bar: brand + month filter */
          .deck .topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
            padding: 10px 36px;
            background: var(--surface);
            border-bottom: 1px solid var(--line);
          }
          .deck .brand { font-size: 13px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
          .deck .brand span { color: var(--accent); }
          .deck .month-filter { width: 280px; min-height: 64px; display: flex; }

          /* Slides: CSS-only navigation via :target */
          .deck .slides { flex: 1; display: flex; min-height: 0; }
          .deck .slide {
            display: none;
            flex: 1;
            flex-direction: column;
            padding: 28px 44px 16px;
            min-height: 0;
          }
          .deck .slide:target { display: flex; }
          .deck:not(:has(.slide:target)) #slide-1 { display: flex; }

          .deck .slide-head { margin-bottom: 20px; }
          .deck .eyebrow { color: var(--accent); font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
          .deck h2 { margin: 6px 0 0; font-size: 30px; line-height: 1.15; font-weight: 700; }
          .deck .sub { margin: 6px 0 0; color: var(--muted); font-size: 15px; }
          .deck .slide-body { flex: 1; min-height: 0; display: flex; }

          .deck .card {
            display: flex;
            flex-direction: column;
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: 10px;
            padding: 14px 16px;
            min-height: 0;
          }
          .deck .card-title { font-size: 13px; font-weight: 600; color: var(--muted); margin-bottom: 6px; }
          .deck .card .viz { flex: 1; display: flex; min-height: 0; }

          /* Footer nav */
          .deck .nav {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-top: 14px;
            margin-top: 16px;
            border-top: 1px solid var(--line);
            font-size: 13px;
            color: var(--muted);
          }
          .deck .dots { display: flex; gap: 8px; }
          .deck .dots a { width: 9px; height: 9px; border-radius: 50%; background: var(--line); }
          .deck .dots a.on { background: var(--accent); }
          .deck .btn {
            padding: 7px 14px;
            border: 1px solid var(--line);
            border-radius: 6px;
            background: var(--surface);
            color: var(--ink);
            text-decoration: none;
            font-weight: 600;
          }
          .deck .btn.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
          .deck .btn.ghost { visibility: hidden; }

          /* Slide 1: title */
          .deck .title-slide {
            flex: 1;
            display: grid;
            grid-template-columns: 1.4fr 1fr;
            gap: 48px;
            align-items: center;
          }
          .deck .title-slide h1 { margin: 12px 0 16px; font-size: 60px; line-height: 1.02; letter-spacing: -0.02em; }
          .deck .title-slide .lede { color: var(--muted); font-size: 18px; line-height: 1.55; max-width: 560px; }
          .deck .title-slide .rule { width: 72px; height: 5px; background: var(--accent); border-radius: 3px; }
          .deck .agenda { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 24px 28px; }
          .deck .agenda h3 { margin: 0 0 12px; font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
          .deck .agenda a {
            display: flex; gap: 14px; align-items: baseline;
            padding: 10px 0; border-top: 1px solid var(--line);
            color: var(--ink); text-decoration: none; font-size: 16px; font-weight: 600;
          }
          .deck .agenda a b { color: var(--accent); font-size: 13px; min-width: 22px; }

          /* Slide 2: KPI grid */
          .deck .kpi-grid {
            flex: 1;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            grid-template-rows: repeat(2, 1fr);
            gap: 18px;
          }
          .deck .kpi-grid .card { border-top: 4px solid var(--accent); }
          .deck .kpi-grid .card.warn { border-top-color: var(--accent-2); }

          /* Slide 3: trend */
          .deck .trend { flex: 1; display: grid; grid-template-columns: 1fr 290px; gap: 18px; }
          .deck .notes { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 18px 20px; font-size: 14px; line-height: 1.55; }
          .deck .notes h4 { margin: 0 0 10px; font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
          .deck .notes p { margin: 0 0 12px; }
          .deck .legend-dot { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin-right: 6px; vertical-align: middle; }

          /* Slide 4: categories */
          .deck .cats { flex: 1; display: grid; grid-template-columns: 1.15fr 1fr; gap: 18px; }

          /* Slide 5: takeaways */
          .deck .takeaways { flex: 1; display: grid; grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(2, 1fr); gap: 16px; }
          .deck .tk { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 18px 20px; display: flex; flex-direction: column; gap: 8px; }
          .deck .tk .num { font-size: 12px; font-weight: 700; color: var(--accent); letter-spacing: 0.1em; }
          .deck .tk h4 { margin: 0; font-size: 17px; line-height: 1.3; }
          .deck .tk p { margin: 0; color: var(--muted); font-size: 14px; line-height: 1.5; }
          .deck .tk.next { background: var(--ink); border-color: var(--ink); }
          .deck .tk.next h4, .deck .tk.next li { color: #fff; }
          .deck .tk.next .num { color: #9DB2FF; }
          .deck .tk.next ul { margin: 0; padding-left: 18px; font-size: 14px; line-height: 1.6; }
          .deck .up { color: var(--good); font-weight: 700; }
          .deck .down { color: var(--bad); font-weight: 700; }

          @media (max-width: 1000px) {
            .deck { aspect-ratio: auto; }
            .deck .title-slide, .deck .trend, .deck .cats { grid-template-columns: 1fr; }
            .deck .kpi-grid, .deck .takeaways { grid-template-columns: repeat(2, 1fr); grid-template-rows: none; }
            .deck .kpi-grid .card { min-height: 150px; }
            .deck .card .viz { min-height: 320px; }
          }
        </style>

        <header class="topbar">
          <div class="brand">TheLook <span>·</span> Monthly Performance Review</div>
          <div class="month-filter"><h-block name="f_month" /></div>
        </header>

        <div class="slides">

          <!-- 1. Title -->
          <section class="slide" id="slide-1">
            <div class="title-slide">
              <div>
                <div class="rule"></div>
                <div class="eyebrow" style="margin-top:20px">TheLook eCommerce · Business Review</div>
                <h1>Monthly Performance Review</h1>
                <p class="lede">
                  Sales, profitability and category performance for the selected reporting month,
                  compared with the month before. Defaults to the last complete month; change it
                  with the <b>Reporting month</b> filter in the top bar.
                </p>
              </div>
              <nav class="agenda">
                <h3>Agenda</h3>
                <a href="#slide-2"><b>02</b> Headline KPIs</a>
                <a href="#slide-3"><b>03</b> 13-month trend</a>
                <a href="#slide-4"><b>04</b> Category breakdown</a>
                <a href="#slide-5"><b>05</b> Key takeaways</a>
              </nav>
            </div>
            <div class="nav">
              <span class="btn ghost">← Previous</span>
              <div class="dots"><a class="on" href="#slide-1"></a><a href="#slide-2"></a><a href="#slide-3"></a><a href="#slide-4"></a><a href="#slide-5"></a></div>
              <a class="btn primary" href="#slide-2">Next →</a>
            </div>
          </section>

          <!-- 2. Headline KPIs -->
          <section class="slide" id="slide-2">
            <div class="slide-head">
              <div class="eyebrow">02 · Headline KPIs</div>
              <h2>How the month landed</h2>
              <p class="sub">Selected month vs previous month. Net figures exclude cancelled and returned items; margin and return rate changes are in percentage points.</p>
            </div>
            <div class="kpi-grid">
              <div class="card"><div class="viz"><h-block name="kpi_net_sales" /></div></div>
              <div class="card"><div class="viz"><h-block name="kpi_gross_profit" /></div></div>
              <div class="card"><div class="viz"><h-block name="kpi_gross_margin" /></div></div>
              <div class="card"><div class="viz"><h-block name="kpi_orders" /></div></div>
              <div class="card"><div class="viz"><h-block name="kpi_aov" /></div></div>
              <div class="card warn"><div class="viz"><h-block name="kpi_return_rate" /></div></div>
            </div>
            <div class="nav">
              <a class="btn" href="#slide-1">← Previous</a>
              <div class="dots"><a href="#slide-1"></a><a class="on" href="#slide-2"></a><a href="#slide-3"></a><a href="#slide-4"></a><a href="#slide-5"></a></div>
              <a class="btn primary" href="#slide-3">Next →</a>
            </div>
          </section>

          <!-- 3. Trend -->
          <section class="slide" id="slide-3">
            <div class="slide-head">
              <div class="eyebrow">03 · Trend</div>
              <h2>Sales momentum over the last 13 months</h2>
              <p class="sub">Trailing 13 complete months; this chart ignores the month filter.</p>
            </div>
            <div class="trend">
              <div class="card">
                <div class="card-title">
                  <span class="legend-dot" style="background:#3B5BDB"></span>Net Sales (columns)
                  &nbsp;&nbsp;<span class="legend-dot" style="background:#F08C00"></span>Fulfilled Orders (line)
                </div>
                <div class="viz"><h-block name="v_trend" /></div>
              </div>
              <aside class="notes">
                <h4>Reading the trend</h4>
                <p>Columns and line moving together mean growth is <b>volume-led</b>; a gap between them means order value is shifting.</p>
                <p>Compare the latest column with the same month a year earlier (first column) for a seasonality-adjusted read.</p>
                <p>Details for the selected month are on slides 02 and 04.</p>
              </aside>
            </div>
            <div class="nav">
              <a class="btn" href="#slide-2">← Previous</a>
              <div class="dots"><a href="#slide-1"></a><a href="#slide-2"></a><a class="on" href="#slide-3"></a><a href="#slide-4"></a><a href="#slide-5"></a></div>
              <a class="btn primary" href="#slide-4">Next →</a>
            </div>
          </section>

          <!-- 4. Category breakdown -->
          <section class="slide" id="slide-4">
            <div class="slide-head">
              <div class="eyebrow">04 · Category breakdown</div>
              <h2>Where the month's sales came from</h2>
              <p class="sub">Top 10 product categories by Net Sales for the selected month, with month-over-month change and gross margin.</p>
            </div>
            <div class="cats">
              <div class="card">
                <div class="card-title">Net Sales by category (top 10)</div>
                <div class="viz"><h-block name="v_category_bar" /></div>
              </div>
              <div class="card">
                <div class="card-title">Category scorecard</div>
                <div class="viz"><h-block name="v_category_table" /></div>
              </div>
            </div>
            <div class="nav">
              <a class="btn" href="#slide-3">← Previous</a>
              <div class="dots"><a href="#slide-1"></a><a href="#slide-2"></a><a href="#slide-3"></a><a class="on" href="#slide-4"></a><a href="#slide-5"></a></div>
              <a class="btn primary" href="#slide-5">Next →</a>
            </div>
          </section>

          <!-- 5. Key takeaways -->
          <section class="slide" id="slide-5">
            <div class="slide-head">
              <div class="eyebrow">05 · Key takeaways</div>
              <h2>August 2026: best month in the last 15</h2>
              <p class="sub">Commentary written for the August 2026 close (vs July 2026). The live slides update with the filter; this commentary does not.</p>
            </div>
            <div class="takeaways">
              <div class="tk">
                <div class="num">01 · TOP LINE</div>
                <h4>Net Sales $41.0K, <span class="up">+27% MoM</span></h4>
                <p>Up from $32.3K in July and about 2.6× August 2025 ($16.0K). Second straight month of growth.</p>
              </div>
              <div class="tk">
                <div class="num">02 · VOLUME-LED</div>
                <h4>470 fulfilled orders, <span class="up">+26%</span></h4>
                <p>AOV was flat at $87.23 (+0.5%), so almost all of the growth came from more orders, not bigger baskets.</p>
              </div>
              <div class="tk">
                <div class="num">03 · PROFITABILITY</div>
                <h4>Gross margin steady at 52.1%</h4>
                <p>Within the 50–52% range of the past 15 months. Gross profit grew in line with sales.</p>
              </div>
              <div class="tk">
                <div class="num">04 · RETURNS</div>
                <h4>Return rate <span class="up">10.3%</span>, down from 13.6%</h4>
                <p>July's return rate was the highest in 15 months; August brought it back toward the ~10% norm.</p>
              </div>
              <div class="tk">
                <div class="num">05 · CATEGORIES</div>
                <h4>Tailoring and accessories drove gains</h4>
                <p>Jeans, Outerwear &amp; Coats and Suits &amp; Sport Coats led at $3.5–3.6K each. Largest gains: Accessories (+$1.5K), Pants &amp; Capris (+$1.3K), Suits &amp; Sport Coats (+$1.0K). <span class="down">Active fell 28%</span>.</p>
              </div>
              <div class="tk next">
                <div class="num">NEXT STEPS</div>
                <h4>Focus for September</h4>
                <ul>
                  <li>Keep the order-volume drivers running</li>
                  <li>Test bundles to lift the flat AOV</li>
                  <li>Look into the drop in Active</li>
                  <li>Watch returns to confirm July was one-off</li>
                </ul>
              </div>
            </div>
            <div class="nav">
              <a class="btn" href="#slide-4">← Previous</a>
              <div class="dots"><a href="#slide-1"></a><a href="#slide-2"></a><a href="#slide-3"></a><a href="#slide-4"></a><a class="on" href="#slide-5"></a></div>
              <a class="btn primary" href="#slide-1">Back to start ↺</a>
            </div>
          </section>

        </div>
      </div>
    ;;
  }

  theme: PageTheme {
    background { bg_color: '#FFFFFF' }
    block {
      background { bg_color: 'transparent' }
      border { border_width: 0 }
      padding: 0
    }
  }
}
