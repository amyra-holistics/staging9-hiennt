Dashboard r04_claude_html_a3 {
  title: 'Monthly Performance Review — August 2026'
  description: '''
Five 16:9 slides summarising TheLook eCommerce performance for August 2026 (the latest complete month):
title, headline KPIs vs July 2026, 12-month trend, category breakdown and key takeaways.
'''

  // ---------- Slide 2: headline KPIs (Aug 2026 vs Jul 2026) ----------
  block kpi_net_sales: VizBlock {
    label: 'Net Sales'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value: RelativePopValue {
          duration: 1
          granularity: 'month'
        }
      }
      filter {
        field: r(thelook_order_items.created_at)
        operator: 'matches'
        value: '2026-08'
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'center'
      }
    }
  }

  block kpi_orders: VizBlock {
    label: 'Fulfilled Orders'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        label: 'Fulfilled Orders'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value: RelativePopValue {
          duration: 1
          granularity: 'month'
        }
      }
      filter {
        field: r(thelook_order_items.created_at)
        operator: 'matches'
        value: '2026-08'
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'center'
      }
    }
  }

  block kpi_aov: VizBlock {
    label: 'Average Order Value'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value: RelativePopValue {
          duration: 1
          granularity: 'month'
        }
      }
      filter {
        field: r(thelook_order_items.created_at)
        operator: 'matches'
        value: '2026-08'
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'center'
      }
    }
  }

  block kpi_margin: VizBlock {
    label: 'Gross Margin'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value: RelativePopValue {
          duration: 1
          granularity: 'month'
        }
      }
      filter {
        field: r(thelook_order_items.created_at)
        operator: 'matches'
        value: '2026-08'
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'center'
      }
    }
  }

  block kpi_return_rate: VizBlock {
    label: 'Return Rate'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.return_rate)
        label: 'Return Rate'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value: RelativePopValue {
          duration: 1
          granularity: 'month'
        }
      }
      filter {
        field: r(thelook_order_items.created_at)
        operator: 'matches'
        value: '2026-08'
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'center'
      }
    }
  }

  // ---------- Slide 3: 12-month trend ----------
  block trend_chart: VizBlock {
    label: 'Net Sales & Fulfilled Orders — Sep 2025 to Aug 2026'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        label: 'Net Sales'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        settings {
          alignment: 'left'
        }
      }
      y_axis {
        label: 'Fulfilled Orders'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.fulfilled_orders)
            label: 'Fulfilled Orders'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        settings {
          alignment: 'right'
        }
      }
      conditions: [
        "thelook_order_items.created_at >= @2025-09-01",
        "thelook_order_items.created_at < @2026-09-01"
      ]
      settings {
        x_axis_label: 'Month'
        legend_label: 'bottom'
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  // ---------- Slide 4: category breakdown ----------
  block category_chart: VizBlock {
    label: 'Top 10 Categories by Net Sales — August 2026'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Category'
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      tooltips: [
        VizTooltip {
          field: VizFieldFull {
            ref: r(thelook.gross_margin)
            label: 'Gross Margin'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      ]
      conditions: [
        "thelook_order_items.created_at matches @2026-08"
      ]
      settings {
        row_limit: 10
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  view: HTMLLayout {
    content: @html
      <style>
        .deck {
          --ink: #1b2330;
          --muted: #5d6778;
          --line: #e3e6ec;
          --accent: #2f5bea;
          --pos: #1f8a4c;
          --neg: #c2412d;
          --paper: #ffffff;
          --bg: #eef0f4;
          box-sizing: border-box;
          background: var(--bg);
          padding: 24px 16px 40px;
          font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
          color: var(--ink);
        }
        .deck *, .deck *::before, .deck *::after { box-sizing: border-box; }

        .deck-nav {
          position: sticky;
          top: 0;
          z-index: 5;
          display: flex;
          gap: 8px;
          justify-content: center;
          flex-wrap: wrap;
          max-width: 1280px;
          margin: 0 auto 20px;
          padding: 8px;
          background: var(--bg);
        }
        .deck-nav a {
          font-size: 13px;
          color: var(--muted);
          text-decoration: none;
          padding: 6px 12px;
          border: 1px solid var(--line);
          border-radius: 999px;
          background: var(--paper);
        }
        .deck-nav a:hover { color: var(--accent); border-color: var(--accent); }

        /* 16:9 slide frame */
        .slide {
          width: 100%;
          max-width: 1280px;
          aspect-ratio: 16 / 9;
          margin: 0 auto 28px;
          padding: 44px 56px 36px;
          background: var(--paper);
          border-radius: 10px;
          box-shadow: 0 1px 3px rgba(20, 30, 50, 0.08), 0 8px 24px rgba(20, 30, 50, 0.06);
          display: flex;
          flex-direction: column;
          overflow: hidden;
          position: relative;
          scroll-margin-top: 64px;
        }
        .slide-head { margin-bottom: 20px; }
        .eyebrow {
          font-size: 13px;
          font-weight: 600;
          letter-spacing: 0.08em;
          text-transform: uppercase;
          color: var(--accent);
          margin: 0 0 6px;
        }
        .slide h2 {
          font-size: 30px;
          line-height: 1.2;
          font-weight: 700;
          margin: 0;
        }
        .slide-body { flex: 1; min-height: 0; }
        .slide-foot {
          display: flex;
          justify-content: space-between;
          font-size: 12px;
          color: var(--muted);
          border-top: 1px solid var(--line);
          padding-top: 10px;
          margin-top: 16px;
        }

        /* Slide 1: title */
        .slide.title {
          background: linear-gradient(135deg, #16213a 0%, #253a73 60%, #2f5bea 100%);
          color: #fff;
          justify-content: center;
          padding: 72px 88px;
        }
        .slide.title .eyebrow { color: #a9bdff; font-size: 15px; }
        .slide.title h1 {
          font-size: 60px;
          line-height: 1.05;
          font-weight: 800;
          margin: 8px 0 20px;
        }
        .slide.title .sub { font-size: 22px; color: #d5ddf7; margin: 0 0 40px; max-width: 760px; }
        .slide.title .meta { display: flex; gap: 40px; font-size: 14px; color: #a9bdff; }
        .slide.title .meta b { display: block; color: #fff; font-size: 16px; margin-top: 4px; }
        .slide.title .slide-foot { position: absolute; left: 88px; right: 88px; bottom: 32px; color: #a9bdff; border-color: rgba(255,255,255,0.18); }

        /* Slide 2: KPIs */
        .kpi-grid {
          display: grid;
          grid-template-columns: repeat(5, 1fr);
          gap: 16px;
          height: 46%;
        }
        .kpi-card {
          border: 1px solid var(--line);
          border-radius: 10px;
          padding: 8px;
          min-height: 0;
          display: flex;
          flex-direction: column;
        }
        .kpi-card > * { flex: 1; min-height: 0; }
        .kpi-notes {
          display: grid;
          grid-template-columns: repeat(3, 1fr);
          gap: 16px;
          margin-top: 22px;
        }
        .note {
          background: #f6f7fa;
          border-left: 4px solid var(--accent);
          border-radius: 6px;
          padding: 14px 16px;
          font-size: 15px;
          line-height: 1.45;
          color: var(--ink);
        }
        .note b { display: block; font-size: 13px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 4px; }
        .note.good { border-left-color: var(--pos); }

        /* Slide 3 & 4: chart + side commentary */
        .chart-split {
          display: grid;
          grid-template-columns: 1fr 300px;
          gap: 28px;
          height: 100%;
        }
        .chart-area { min-height: 0; height: 100%; }
        .chart-area > * { height: 100%; }
        .side { display: flex; flex-direction: column; gap: 14px; }
        .stat { border-bottom: 1px solid var(--line); padding-bottom: 12px; }
        .stat .v { font-size: 28px; font-weight: 700; }
        .stat .v.up { color: var(--pos); }
        .stat .v.down { color: var(--neg); }
        .stat .l { font-size: 13px; color: var(--muted); margin-top: 2px; line-height: 1.35; }

        /* Slide 5: takeaways */
        .takeaways {
          display: grid;
          grid-template-columns: 1fr 1fr;
          gap: 18px 28px;
          align-content: start;
        }
        .tk {
          display: grid;
          grid-template-columns: 44px 1fr;
          gap: 14px;
          align-items: start;
        }
        .tk .n {
          width: 44px; height: 44px;
          border-radius: 50%;
          background: #e8eeff;
          color: var(--accent);
          font-weight: 700;
          font-size: 18px;
          display: flex; align-items: center; justify-content: center;
        }
        .tk h3 { margin: 2px 0 6px; font-size: 18px; }
        .tk p { margin: 0; font-size: 14.5px; line-height: 1.5; color: var(--muted); }
        .next {
          margin-top: 22px;
          padding: 16px 20px;
          border-radius: 8px;
          background: #16213a;
          color: #fff;
          font-size: 15px;
          line-height: 1.5;
        }
        .next b { color: #a9bdff; margin-right: 6px; }

        @media (max-width: 900px) {
          .slide { aspect-ratio: auto; padding: 28px 24px; }
          .slide.title h1 { font-size: 40px; }
          .kpi-grid { grid-template-columns: repeat(2, 1fr); height: auto; }
          .kpi-card { height: 150px; }
          .kpi-notes, .takeaways, .chart-split { grid-template-columns: 1fr; }
          .chart-area { height: 380px; }
        }
        @media print {
          .deck { background: #fff; padding: 0; }
          .deck-nav { display: none; }
          .slide { box-shadow: none; border-radius: 0; margin: 0; page-break-after: always; }
        }
      </style>

      <main class="deck">
        <nav class="deck-nav">
          <a href="#s1">1 · Title</a>
          <a href="#s2">2 · Headline KPIs</a>
          <a href="#s3">3 · Trend</a>
          <a href="#s4">4 · Categories</a>
          <a href="#s5">5 · Takeaways</a>
        </nav>

        <!-- Slide 1: Title -->
        <section class="slide title" id="s1">
          <p class="eyebrow">Monthly Performance Review</p>
          <h1>August 2026</h1>
          <p class="sub">TheLook eCommerce — sales, orders, margin and category performance for the latest complete month.</p>
          <div class="meta">
            <div>Reporting period<b>1 – 31 Aug 2026</b></div>
            <div>Comparison<b>vs. July 2026</b></div>
            <div>Source<b>TheLook eCommerce dataset</b></div>
          </div>
          <div class="slide-foot"><span>Net Sales exclude Cancelled and Returned items</span><span>01 / 05</span></div>
        </section>

        <!-- Slide 2: Headline KPIs -->
        <section class="slide" id="s2">
          <div class="slide-head">
            <p class="eyebrow">Headline KPIs · Aug 2026 vs Jul 2026</p>
            <h2>Net Sales up ~27% on higher order volume</h2>
          </div>
          <div class="slide-body">
            <div class="kpi-grid">
              <div class="kpi-card"><h-block name="kpi_net_sales" /></div>
              <div class="kpi-card"><h-block name="kpi_orders" /></div>
              <div class="kpi-card"><h-block name="kpi_aov" /></div>
              <div class="kpi-card"><h-block name="kpi_margin" /></div>
              <div class="kpi-card"><h-block name="kpi_return_rate" /></div>
            </div>
            <div class="kpi-notes">
              <div class="note good"><b>Volume-led growth</b>Fulfilled orders rose from 372 to 470; Net Sales reached ~$41.0K, the best complete month of the last 12.</div>
              <div class="note"><b>Stable unit economics</b>AOV held at ~$87 and Gross Margin at ~52% — growth did not come from discounting.</div>
              <div class="note good"><b>Fewer returns</b>Return Rate fell from 13.6% to 10.3% of items after July's spike.</div>
            </div>
          </div>
          <div class="slide-foot"><span>KPI change shown vs. previous month</span><span>02 / 05</span></div>
        </section>

        <!-- Slide 3: Trend -->
        <section class="slide" id="s3">
          <div class="slide-head">
            <p class="eyebrow">12-Month Trend · Sep 2025 – Aug 2026</p>
            <h2>Net Sales have nearly tripled in twelve months</h2>
          </div>
          <div class="slide-body">
            <div class="chart-split">
              <div class="chart-area"><h-block name="trend_chart" /></div>
              <aside class="side">
                <div class="stat"><div class="v up">2.7×</div><div class="l">Aug 2026 Net Sales vs Sep 2025 (~$41.0K vs ~$15.0K)</div></div>
                <div class="stat"><div class="v up">+52%</div><div class="l">Net Sales growth Jun → Aug 2026 (~$26.9K → ~$41.0K)</div></div>
                <div class="stat"><div class="v">~$81–87</div><div class="l">AOV range across the period — orders, not basket size, drive the trend</div></div>
              </aside>
            </div>
          </div>
          <div class="slide-foot"><span>Columns: Net Sales · Line: Fulfilled Orders (right axis)</span><span>03 / 05</span></div>
        </section>

        <!-- Slide 4: Category breakdown -->
        <section class="slide" id="s4">
          <div class="slide-head">
            <p class="eyebrow">Category Breakdown · Aug 2026</p>
            <h2>Jeans, Outerwear and Suits lead; Accessories surged</h2>
          </div>
          <div class="slide-body">
            <div class="chart-split">
              <div class="chart-area"><h-block name="category_chart" /></div>
              <aside class="side">
                <div class="stat"><div class="v up">+$1.5K</div><div class="l">Accessories vs July (~$0.6K → ~$2.1K), the largest gain of any category</div></div>
                <div class="stat"><div class="v up">+$1.0K</div><div class="l">Suits &amp; Sport Coats (~$3.5K) at ~60% margin — high value and high margin</div></div>
                <div class="stat"><div class="v down">−$0.6K</div><div class="l">Active (~$2.0K → ~$1.5K), the largest decline; Jeans also dipped slightly</div></div>
              </aside>
            </div>
          </div>
          <div class="slide-foot"><span>Hover a bar to see Gross Margin</span><span>04 / 05</span></div>
        </section>

        <!-- Slide 5: Key takeaways -->
        <section class="slide" id="s5">
          <div class="slide-head">
            <p class="eyebrow">Key Takeaways</p>
            <h2>What August tells us</h2>
          </div>
          <div class="slide-body">
            <div class="takeaways">
              <div class="tk"><div class="n">1</div><div><h3>Demand is the growth engine</h3><p>Net Sales +27% MoM came almost entirely from more orders (+26%); AOV was flat at ~$87.</p></div></div>
              <div class="tk"><div class="n">2</div><div><h3>Margin held through the growth</h3><p>Gross Margin stayed at ~52%, in line with the 12-month range — no sign of margin erosion.</p></div></div>
              <div class="tk"><div class="n">3</div><div><h3>Returns eased</h3><p>Return Rate dropped to 10.3% from 13.6% in July; worth checking whether July was a one-off.</p></div></div>
              <div class="tk"><div class="n">4</div><div><h3>Mix is broadening</h3><p>Accessories, Pants &amp; Capris, Suits &amp; Sport Coats and Sleep &amp; Lounge added ~$4.8K together; Active softened.</p></div></div>
            </div>
            <div class="next"><b>Next steps:</b>Plan inventory for continued order growth in top categories, investigate the Active decline, and monitor whether September's pace holds.</div>
          </div>
          <div class="slide-foot"><span>TheLook eCommerce · Monthly Performance Review</span><span>05 / 05</span></div>
        </section>
      </main>
    ;;
  }

  theme {
    block {
      background {
        bg_color: "transparent"
      }
      border {
        border_width: 0
      }
    }
  }
}
