Dashboard r04_hai_html_a1 {
  title: 'Monthly Performance Slides'
  description: @md
A five-slide monthly performance deck for TheLook eCommerce.
;;
  theme: H.themes.classic

  settings {
    timezone: 'Etc/UTC'
    autorun_on_open: true
    autorun_on_changes: true
    cache_duration: 360
  }

  // Slide 1 — Title
  block slide_title: TextBlock {
    content: @md
# TheLook eCommerce
## Monthly Performance Review

**Sales, profitability, category performance, and operating signals**

Use the reporting-period selector to focus the deck on a specific month or date range.
;;
  }

  block reporting_period: FilterBlock {
    label: 'Reporting Period'
    type: 'date'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block title_note: TextBlock {
    content: @md
### Deck guide

1. **Headline KPIs** — current performance snapshot  
2. **Trend** — sales, profit, and margin over time  
3. **Category breakdown** — highest-value product categories  
4. **Key takeaways** — category-level decision support  
;;
  }

  // Slide 2 — Headline KPIs
  block kpi_net_sales: VizBlock {
    label: 'Net Sales'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block kpi_gross_margin: VizBlock {
    label: 'Gross Margin'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
      }
    }
  }

  block kpi_fulfilled_orders: VizBlock {
    label: 'Fulfilled Orders'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block kpi_return_rate: VizBlock {
    label: 'Return Rate'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.return_rate)
        label: 'Return Rate'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block kpi_context: TextBlock {
    content: @md
## Headline KPIs

Net Sales excludes cancelled and returned items.  
Gross Margin is calculated as Gross Profit divided by Net Sales.
;;
  }

  // Slide 3 — Trend
  block trend_context: TextBlock {
    content: @md
## Sales and Profit Trend

Track the relationship between top-line sales, gross profit, and gross margin over time.
;;
  }

  block monthly_trend: VizBlock {
    label: 'Monthly Sales, Profit, and Margin'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        label: 'Calendar Month'
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
        uname: 'datetrunc_month_created_at_1'
      }
      y_axis {
        label: 'Sales and Profit'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            label: 'Net Sales'
            ref: r(thelook.net_sales)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        series {
          mark_type: 'column'
          field: VizFieldFull {
            label: 'Gross Profit'
            ref: r(thelook.gross_profit)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        settings {
          alignment: 'left'
        }
      }
      y_axis {
        label: 'Gross Margin'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            label: 'Gross Margin'
            ref: r(thelook.gross_margin)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        settings {
          alignment: 'right'
        }
      }
      settings {
        legend_label: 'bottom'
        show_data_points: true
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  // Slide 4 — Category breakdown
  block category_context: TextBlock {
    content: @md
## Category Breakdown

Rank product categories by Net Sales to identify the largest commercial contributors.
;;
  }

  block category_sales: VizBlock {
    label: 'Net Sales by Product Category'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Product Category'
      }
      y_axis {
        label: 'Net Sales'
        series {
          mark_type: 'bar'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        legend_label: 'hidden'
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  // Slide 5 — Key takeaways
  block takeaways_context: TextBlock {
    content: @md
## Key Takeaways

Use this view to balance **sales scale**, **gross-margin quality**, and **return-rate risk** by category.

- Prioritize categories with high Net Sales and healthy Gross Margin.
- Investigate categories with elevated Return Rate before scaling demand.
- Use Items Sold to distinguish high-value from high-volume categories.
;;
  }

  block category_takeaways: VizBlock {
    label: 'Category Sales and Profitability Takeaways'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          ref: r(thelook_products.category)
          label: 'Category'
          format {
            type: 'text'
          }
          uname: 'category'
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'net_sales'
        },
        VizFieldFull {
          ref: r(thelook.gross_profit)
          label: 'Gross Profit'
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'gross_profit'
        },
        VizFieldFull {
          ref: r(thelook.gross_margin)
          label: 'Gross Margin'
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'gross_margin'
        },
        VizFieldFull {
          ref: r(thelook.items_sold)
          label: 'Items Sold'
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'items_sold'
        },
        VizFieldFull {
          ref: r(thelook.return_rate)
          label: 'Return Rate'
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'return_rate'
        },
      ]
      settings {
        pagination_size: 100
        show_row_number: false
        wrap_header_text: true
        wrap_cell_text: false
        sorts: [
          KeyBasedSortSetting {
            key: 'net_sales'
            direction: 'desc'
          },
          KeyBasedSortSetting {
            key: 'category'
            direction: 'asc'
          },
        ]
      }
    }
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'reporting_period'
      to: [
        'kpi_net_sales',
        'kpi_gross_margin',
        'kpi_fulfilled_orders',
        'kpi_return_rate',
        'monthly_trend',
        'category_sales',
        'category_takeaways',
      ]
      field: r(thelook_order_items.created_at)
    },
  ]

  view: HTMLLayout {
    content: @html
<style>
  .deck {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 24px;
    background: #f4f7fb;
  }

  .slide {
    box-sizing: border-box;
    width: 100%;
    aspect-ratio: 16 / 9;
    min-height: 660px;
    padding: 52px 64px;
    overflow: hidden;
    border: 1px solid #dfe7f1;
    border-radius: 18px;
    background: #ffffff;
    box-shadow: 0 12px 32px rgba(18, 38, 63, 0.08);
  }

  .slide-dark {
    color: #ffffff;
    border: none;
    background: linear-gradient(135deg, #102a43 0%, #1f4b6e 58%, #217b8f 100%);
  }

  .slide-number {
    margin-bottom: 12px;
    color: #6b7c93;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .slide-dark .slide-number {
    color: #9fd5df;
  }

  .title-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 48px;
    align-items: center;
    height: 100%;
  }

  .controls {
    align-self: start;
    padding: 18px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.12);
  }

  .slide-heading {
    margin-bottom: 28px;
  }

  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin: 28px 0;
  }

  .kpi-card {
    min-height: 180px;
    padding: 18px;
    border: 1px solid #e3eaf2;
    border-radius: 14px;
    background: #fbfdff;
  }

  .chart-area {
    height: calc(100% - 115px);
    min-height: 470px;
  }

  .takeaways-layout {
    display: grid;
    grid-template-columns: 30% minmax(0, 1fr);
    gap: 32px;
    height: calc(100% - 42px);
  }

  .takeaways-copy {
    padding: 24px;
    border-radius: 14px;
    background: #edf6f7;
  }

  .table-area {
    min-width: 0;
    overflow: auto;
  }

  h-block {
    display: block;
    height: 100%;
  }

  @media (max-width: 900px) {
    .slide {
      aspect-ratio: auto;
      min-height: 0;
      padding: 32px 24px;
    }

    .title-layout,
    .takeaways-layout {
      grid-template-columns: 1fr;
    }

    .kpi-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .chart-area {
      height: 480px;
      min-height: 0;
    }
  }
</style>

<div class="deck">
  <section class="slide slide-dark">
    <div class="slide-number">Slide 01 · Monthly Performance Review</div>
    <div class="title-layout">
      <div>
        <h-block name="slide_title"></h-block>
      </div>
      <div class="controls">
        <h-block name="reporting_period"></h-block>
        <h-block name="title_note"></h-block>
      </div>
    </div>
  </section>

  <section class="slide">
    <div class="slide-number">Slide 02 · Headline KPIs</div>
    <div class="slide-heading">
      <h-block name="kpi_context"></h-block>
    </div>
    <div class="kpi-grid">
      <div class="kpi-card"><h-block name="kpi_net_sales"></h-block></div>
      <div class="kpi-card"><h-block name="kpi_gross_margin"></h-block></div>
      <div class="kpi-card"><h-block name="kpi_fulfilled_orders"></h-block></div>
      <div class="kpi-card"><h-block name="kpi_return_rate"></h-block></div>
    </div>
  </section>

  <section class="slide">
    <div class="slide-number">Slide 03 · Trend</div>
    <div class="slide-heading">
      <h-block name="trend_context"></h-block>
    </div>
    <div class="chart-area">
      <h-block name="monthly_trend"></h-block>
    </div>
  </section>

  <section class="slide">
    <div class="slide-number">Slide 04 · Category Breakdown</div>
    <div class="slide-heading">
      <h-block name="category_context"></h-block>
    </div>
    <div class="chart-area">
      <h-block name="category_sales"></h-block>
    </div>
  </section>

  <section class="slide">
    <div class="slide-number">Slide 05 · Key Takeaways</div>
    <div class="takeaways-layout">
      <aside class="takeaways-copy">
        <h-block name="takeaways_context"></h-block>
      </aside>
      <div class="table-area">
        <h-block name="category_takeaways"></h-block>
      </div>
    </div>
  </section>
</div>
;;
  }
}
