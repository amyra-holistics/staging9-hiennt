Dashboard r04_hai_html_a2 {
  title: 'Monthly Performance Slides'
  description: @md
    Executive-ready monthly performance deck for TheLook eCommerce.
  ;;
  theme: H.themes.classic

  settings {
    timezone: 'Etc/UTC'
    autorun_on_open: true
    autorun_on_changes: true
    cache_duration: 360
  }

  // ─────────────────────────────────────────────────────────────────────────────
  // Slide 1 — Title
  // ─────────────────────────────────────────────────────────────────────────────
  block title_heading: TextBlock {
    content: @md
      # Monthly Performance Review

      ## TheLook eCommerce
    ;;
  }

  block title_subtitle: TextBlock {
    content: @md
      **Executive performance deck**

      Review commercial performance, profitability, category mix, and the actions
      that merit attention in the selected reporting period.
    ;;
  }

  block f_reporting_period: FilterBlock {
    label: 'Reporting Period'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block title_scope: TextBlock {
    content: @md
      **Definitions**

      - **Net Sales** excludes cancelled and returned order items.
      - **Gross Profit** equals Net Sales less product cost.
      - **Gross Margin** equals Gross Profit divided by Net Sales.
      - All metrics use order-item creation date for the selected period.
    ;;
  }

  // ─────────────────────────────────────────────────────────────────────────────
  // Slide 2 — Headline KPIs
  // ─────────────────────────────────────────────────────────────────────────────
  block kpi_heading: TextBlock {
    content: @md
      # Headline KPIs

      Core commercial and operating outcomes for the selected reporting period.
    ;;
  }

  block monthly_kpis: VizBlock {
    label: 'Monthly Performance KPIs'
    viz: MetricSheet {
      dataset: thelook

      date_field: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }

      rows: [
        MetricSeries {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        },
        MetricSeries {
          field: VizFieldFull {
            ref: r(thelook.gross_profit)
            label: 'Gross Profit'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        },
        MetricSeries {
          field: VizFieldFull {
            ref: r(thelook.gross_margin)
            label: 'Gross Margin'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        },
        MetricSeries {
          field: VizFieldFull {
            ref: r(thelook.fulfilled_orders)
            label: 'Fulfilled Orders'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        },
        MetricSeries {
          field: VizFieldFull {
            ref: r(thelook.aov)
            label: 'Average Order Value'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        },
        MetricSeries {
          field: VizFieldFull {
            ref: r(thelook.return_rate)
            label: 'Return Rate'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      ]
    }
  }

  block kpi_interpretation: TextBlock {
    content: @md
      ### How to read this slide

      Use **Net Sales** and **Gross Profit** to assess scale and earnings quality.
      Pair **AOV** with **Fulfilled Orders** to distinguish price or basket movement
      from volume movement. Monitor **Return Rate** alongside Gross Margin to surface
      value leakage.
    ;;
  }

  // ─────────────────────────────────────────────────────────────────────────────
  // Slide 3 — Trend
  // ─────────────────────────────────────────────────────────────────────────────
  block trend_heading: TextBlock {
    content: @md
      # Performance Trend

      Monthly Net Sales and Gross Profit show the pace and quality of growth.
    ;;
  }

  block monthly_sales_trend: VizBlock {
    label: 'Monthly Net Sales and Gross Profit'
    viz: CombinationChart {
      dataset: thelook

      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }

      y_axis {
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }

        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.gross_profit)
            label: 'Gross Profit'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }

      settings {
        legend_label: 'bottom'
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block trend_callout: TextBlock {
    content: @md
      ### Discussion prompts

      - Is profit growing in line with sales, or is margin compressing?
      - Which months show the largest change in commercial momentum?
      - Are changes primarily driven by fulfilled-order volume or average order value?
    ;;
  }

  // ─────────────────────────────────────────────────────────────────────────────
  // Slide 4 — Category Breakdown
  // ─────────────────────────────────────────────────────────────────────────────
  block category_heading: TextBlock {
    content: @md
      # Category Breakdown

      Compare category scale with profitability to identify where growth is most valuable.
    ;;
  }

  block category_performance: VizBlock {
    label: 'Product Category Net Sales and Gross Margin'
    viz: CombinationChart {
      dataset: thelook

      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Product Category'
      }

      y_axis {
        label: 'Net Sales'

        series {
          mark_type: 'bar'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }

      y_axis {
        label: 'Gross Margin'

        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.gross_margin)
            label: 'Gross Margin'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }

        settings {
          alignment: 'right'
        }
      }

      settings {
        legend_label: 'bottom'
        show_data_points: true
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block category_interpretation: TextBlock {
    content: @md
      ### What to look for

      Prioritize categories that combine **high Net Sales** with **above-average Gross
      Margin**. Investigate large categories with weaker margins, as they offer the
      greatest potential profit improvement.
    ;;
  }

  // ─────────────────────────────────────────────────────────────────────────────
  // Slide 5 — Key Takeaways
  // ─────────────────────────────────────────────────────────────────────────────
  block takeaway_heading: TextBlock {
    content: @md
      # Key Takeaways

      A decision-ready view of the category portfolio for the selected period.
    ;;
  }

  block category_takeaways: VizBlock {
    label: 'Category Performance Table'
    viz: DataTable {
      dataset: thelook

      fields: [
        VizFieldFull {
          label: 'Product Category'
          ref: r(thelook_products.category)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'Net Sales'
          ref: r(thelook.net_sales)
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'net_sales'
        },
        VizFieldFull {
          label: 'Gross Profit'
          ref: r(thelook.gross_profit)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'Gross Margin'
          ref: r(thelook.gross_margin)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'Fulfilled Orders'
          ref: r(thelook.fulfilled_orders)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'Return Rate'
          ref: r(thelook.return_rate)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]

      settings {
        pagination_size: 100
        show_row_number: true
        wrap_header_text: true
        sorts: [
          KeyBasedSortSetting {
            key: 'net_sales'
            direction: 'desc'
          }
        ]
      }
    }
  }

  block takeaway_actions: TextBlock {
    content: @md
      ### Recommended discussion points1. **Protect profitable scale** — sustain availability and demand in categories
         with both strong sales and margin.
      2. **Improve value leakage** — review return-heavy categories for merchandising,
         fit, quality, or expectation gaps.
      3. **Focus commercial investment** — prioritize growth initiatives where category
         sales, gross profit, and return performance align.
    ;;
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'f_reporting_period'
      to: [
        'monthly_kpis',
        'monthly_sales_trend',
        'category_performance',
        'category_takeaways'
      ]
      field: r(thelook_order_items.created_at)
    }
  ]

  view: HTMLLayout {
    content: @html
      <style>
        :root {
          --deck-ink: #14213d;
          --deck-muted: #61708a;
          --deck-line: #dce4ef;
          --deck-blue: #2855a6;
          --deck-blue-light: #edf3ff;
          --deck-bg: #f3f6fb;
          --deck-card: #ffffff;
        }

        .performance-deck {
          display: flex;
          flex-direction: column;
          gap: 32px;
          padding: 24px;
          background: var(--deck-bg);
          color: var(--deck-ink);
        }

        .slide {
          box-sizing: border-box;
          display: flex;
          flex-direction: column;
          width: 100%;
          min-height: 680px;
          aspect-ratio: 16 / 9;
          overflow: hidden;
          padding: 44px 52px;
          border: 1px solid var(--deck-line);
          border-radius: 18px;
          background: var(--deck-card);
          box-shadow: 0 12px 36px rgba(20, 33, 61, 0.08);
        }

        .title-slide {
          justify-content: space-between;
          color: #ffffff;
          border: 0;
          background:
            radial-gradient(circle at 82% 12%, rgba(90, 153, 255, 0.45), transparent 28%),
            linear-gradient(135deg, #14213d 0%, #1f3c78 62%, #2855a6 100%);
        }

        .slide-number {
          margin-bottom: 12px;
          color: var(--deck-blue);
          font-size: 12px;
          font-weight: 700;
          letter-spacing: 0.14em;
          text-transform: uppercase;
        }

        .title-slide .slide-number {
          color: #b9ceff;
        }

        .slide-head {
          flex: 0 0 auto;
          margin-bottom: 22px;
        }

        .slide-body {
          flex: 1 1 auto;
          min-height: 0;
        }

        .split-65-35,
        .split-72-28 {
          display: grid;
          flex: 1 1 auto;
          min-height: 0;
          gap: 28px;
        }

        .split-65-35 {
          grid-template-columns: minmax(0, 1.9fr) minmax(250px, 0.9fr);
        }

        .split-72-28 {
          grid-template-columns: minmax(0, 2.5fr) minmax(230px, 0.8fr);
        }

        .content-card,
        .note-card,
        .filter-card {
          box-sizing: border-box;
          border: 1px solid var(--deck-line);
          border-radius: 14px;
          background: #ffffff;
        }

        .content-card {
          height: 100%;
          padding: 16px;
        }

        .note-card {
          padding: 22px;
          background: var(--deck-blue-light);
        }

        .filter-card {
          width: min(360px, 100%);
          padding: 14px 18px;
          background: rgba(255, 255, 255, 0.12);
          border-color: rgba(255, 255, 255, 0.26);
          backdrop-filter: blur(10px);
        }

        .kpi-card {
          flex: 1 1 auto;
          padding: 18px;
        }

        .title-footer {
          display: flex;
          align-items: end;
          justify-content: space-between;
          gap: 28px;
        }

        .title-mark {
          color: #b9ceff;
          font-size: 13px;
          font-weight: 700;
          letter-spacing: 0.12em;
          text-transform: uppercase;
        }

        h-block {
          display: block;
          min-height: 0;
        }

        .content-card > h-block,
        .kpi-card > h-block {
          height: 100%;
        }

        @media (max-width: 900px) {
          .slide {
            min-height: auto;
            aspect-ratio: auto;
            padding: 28px 24px;
          }

          .split-65-35,
          .split-72-28 {
            grid-template-columns: 1fr;
          }

          .title-footer {
            align-items: stretch;
            flex-direction: column;
          }
        }
      </style>

      <main class="performance-deck">
        <!-- Slide 1: Title -->
        <section class="slide title-slide">
          <div>
            <div class="slide-number">01 / 05 — Executive Review</div>
            <h-block name="title_heading"></h-block>
            <h-block name="title_subtitle"></h-block>
          </div>

          <div class="title-footer">
            <div class="filter-card">
              <h-block name="f_reporting_period"></h-block>
            </div>
            <div class="title-mark">TheLook eCommerce · Monthly performance slides</div>
          </div>
        </section>

        <!-- Slide 2: Headline KPIs -->
        <section class="slide">
          <div class="slide-head">
            <div class="slide-number">02 / 05 — Performance Snapshot</div>
            <h-block name="kpi_heading"></h-block>
          </div>

          <div class="split-72-28 slide-body">
            <div class="content-card kpi-card">
              <h-block name="monthly_kpis"></h-block>
            </div>
            <aside class="note-card">
              <h-block name="kpi_interpretation"></h-block>
            </aside>
          </div>
        </section>

        <!-- Slide 3: Trend -->
        <section class="slide">
          <div class="slide-head">
            <div class="slide-number">03 / 05 — Trend</div>
            <h-block name="trend_heading"></h-block>
          </div>

          <div class="split-65-35 slide-body">
            <div class="content-card">
              <h-block name="monthly_sales_trend"></h-block>
            </div>
            <aside class="note-card">
              <h-block name="trend_callout"></h-block>
            </aside>
          </div>
        </section>

        <!-- Slide 4: Category Breakdown -->
        <section class="slide">
          <div class="slide-head">
            <div class="slide-number">04 / 05 — Category Mix</div>
            <h-block name="category_heading"></h-block>
          </div>

          <div class="split-65-35 slide-body">
            <div class="content-card">
              <h-block name="category_performance"></h-block>
            </div>
            <aside class="note-card">
              <h-block name="category_interpretation"></h-block>
            </aside>
          </div>
        </section>

        <!-- Slide 5: Key Takeaways -->
        <section class="slide">
          <div class="slide-head">
            <div class="slide-number">05 / 05 — Decision Summary</div>
            <h-block name="takeaway_heading"></h-block>
          </div>

          <div class="split-72-28 slide-body">
            <div class="content-card">
              <h-block name="category_takeaways"></h-block>
            </div>
            <aside class="note-card">
              <h-block name="takeaway_actions"></h-block>
            </aside>
          </div>
        </section>

        <!-- Scope and definitions -->
        <section class="slide" style="min-height: 340px; aspect-ratio: auto;">
          <div class="slide-number">Appendix — Metric Scope</div>
          <div class="note-card" style="max-width: 760px;">
            <h-block name="title_scope"></h-block>
          </div>
        </section>
      </main>
    ;;
  }
}
