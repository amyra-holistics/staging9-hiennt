Dashboard r04_hai_html_a3 {
  title: 'Monthly Performance Review'
  description: 'A five-slide executive performance review for TheLook eCommerce.'
  theme: H.themes.classic

  settings {
    timezone: 'UTC'
    autorun: true
    cache_duration: 3600
  }

  block title_slide: TextBlock {
    content: @md
# Monthly Performance Review

## TheLook eCommerce

**Executive business review**  
Sales, profitability, customer demand, and category performance

Use the following slides to monitor current performance, identify trend direction, and focus category actions.
    ;;
  }

  block kpi_slide_heading: TextBlock {
    content: @md
# Headline KPIs

Use the date control to focus this review on a specific month, quarter, or reporting period.
    ;;
  }

  block order_item_date: FilterBlock {
    label: 'Order Item Created At'
    type: 'date'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block net_sales_kpi: VizBlock {
    label: 'Net Sales'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block gross_profit_kpi: VizBlock {
    label: 'Gross Profit'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_profit)
        label: 'Gross Profit'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block fulfilled_orders_kpi: VizBlock {
    label: 'Fulfilled Orders'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        label: 'Fulfilled Orders'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block aov_kpi: VizBlock {
    label: 'Average Order Value'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block return_rate_kpi: VizBlock {
    label: 'Return Rate'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.return_rate)
        label: 'Return Rate'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block trend_slide_heading: TextBlock {
    content: @md
# Sales and Profit Trend

Track whether profitable growth is keeping pace with revenue growth over time.
    ;;
  }

  block monthly_sales_profit_trend: VizBlock {
    label: 'Monthly Net Sales and Gross Profit'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        label: 'Month'
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        label: 'Sales and Profit'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.gross_profit)
            label: 'Gross Profit'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      settings {
        x_axis_label: 'Month'
        legend_label: 'top'
        show_data_points: false
        connect_discontinuous_points: false
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block category_slide_heading: TextBlock {
    content: @md
# Category Breakdown

Rank categories by sales contribution and compare their profit contribution.
    ;;
  }

  block category_performance: VizBlock {
    label: 'Product Category Performance'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Product Category'
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        series {
          field: VizFieldFull {
            ref: r(thelook.gross_profit)
            label: 'Gross Profit'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        legend_label: 'top'
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block takeaway_slide: TextBlock {
    content: @md
# Key Takeaways

## Executive review checklist

1. **Growth quality**  
   Compare Net Sales with Gross Profit. If sales rise faster than profit, investigate category mix, discounts, and product costs.

2. **Demand health**  
   Review Fulfilled Orders alongside Average Order Value to distinguish order-volume movement from basket-size movement.

3. **Post-purchase risk**  
   Monitor Return Rate alongside category performance. High-return categories can reduce realized sales and pressure profitability.

4. **Category actions**  
   Prioritize categories that combine strong Net Sales with strong Gross Profit. Investigate high-sales categories whose profit contribution lags.

> **Metric note:** Net Sales, Gross Profit, Fulfilled Orders, AOV, and category performance exclude Cancelled and Returned order items where defined by the dataset.
    ;;
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'order_item_date'
      to: [
        'net_sales_kpi',
        'gross_profit_kpi',
        'fulfilled_orders_kpi',
        'aov_kpi',
        'return_rate_kpi',
        'monthly_sales_profit_trend',
        'category_performance',
      ]
      field: r(thelook_order_items.created_at)
    }
  ]

  view: HTMLLayout {
    content: @html
<style>
  :root {
    --ink: #172033;
    --muted: #667085;
    --line: #dfe5ec;
    --paper: #ffffff;
    --canvas: #f3f6f9;
    --navy: #102a43;
    --blue: #1877f2;
    --mint: #e8f7f2;
  }

  .deck {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 24px;
    background: var(--canvas);
  }

  .slide {
    width: min(100%, 1280px);
    aspect-ratio: 16 / 9;
    margin: 0 auto;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 48px 56px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 18px;
    box-shadow: 0 12px 32px rgba(16, 42, 67, 0.08);
  }

  .slide-number {
    margin-bottom: 14px;
    color: var(--blue);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .slide-title {
    margin: 0 0 12px;
    color: var(--ink);
    font-size: clamp(24px, 2.25vw, 38px);
    font-weight: 750;
    letter-spacing: -0.03em;
  }

  .slide-subtitle {
    margin: 0 0 24px;
    color: var(--muted);
    font-size: 16px;
  }

  .title-slide {
    justify-content: center;
    background:
      radial-gradient(circle at top right, rgba(24, 119, 242, 0.22), transparent 35%),
      linear-gradient(135deg, #102a43 0%, #173f67 62%, #1877f2 160%);
    border: none;
  }

  .title-slide h-block {
    max-width: 760px;
    color: #ffffff;
  }

  .title-slide h-block * {
    color: #ffffff;
  }

  .kpi-layout {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 16px;
    align-items: stretch;
    flex: 1;
  }

  .kpi-card {
    min-width: 0;
    display: flex;
    align-items: center;
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: #ffffff;
  }

  .kpi-card h-block {
    width: 100%;
  }

  .date-control {
    width: min(360px, 100%);
    margin-bottom: 22px;
  }

  .chart-wrap {
    flex: 1;
    min-height: 0;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: #ffffff;
  }

  .chart-wrap h-block {
    display: block;
    width: 100%;
    height: 100%;
  }

  .takeaway-slide {
    justify-content: center;
    background: linear-gradient(135deg, #ffffff 0%, var(--mint) 100%);
  }

  .takeaway-slide h-block {
    max-width: 920px;
  }

  @media (max-width: 900px) {
    .deck {
      padding: 12px;
    }

    .slide {
      aspect-ratio: auto;
      min-height: 720px;
      padding: 32px 24px;
    }

    .kpi-layout {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

<div class="deck">
  <section class="slide title-slide">
    <div class="slide-number">01 / 05</div>
    <h-block name="title_slide" />
  </section>

  <section class="slide">
    <div class="slide-number">02 / 05</div>
    <h1 class="slide-title">Headline KPIs</h1>
    <p class="slide-subtitle">Select a reporting period, then review the commercial and operational scorecard.</p>
    <div class="date-control">
      <h-block name="order_item_date" />
    </div>
    <div class="kpi-layout">
      <div class="kpi-card"><h-block name="net_sales_kpi" /></div>
      <div class="kpi-card"><h-block name="gross_profit_kpi" /></div>
      <div class="kpi-card"><h-block name="fulfilled_orders_kpi" /></div>
      <div class="kpi-card"><h-block name="aov_kpi" /></div>
      <div class="kpi-card"><h-block name="return_rate_kpi" /></div>
    </div>
  </section>

  <section class="slide">
    <div class="slide-number">03 / 05</div>
    <h1 class="slide-title">Sales and Profit Trend</h1>
    <p class="slide-subtitle">Monitor sales momentum and confirm that profit follows revenue growth.</p>
    <div class="chart-wrap">
      <h-block name="monthly_sales_profit_trend" />
    </div>
  </section>

  <section class="slide">
    <div class="slide-number">04 / 05</div>
    <h1 class="slide-title">Category Breakdown</h1>
    <p class="slide-subtitle">Compare category sales contribution with gross-profit contribution.</p>
    <div class="chart-wrap">
      <h-block name="category_performance" />
    </div>
  </section>

  <section class="slide takeaway-slide">
    <div class="slide-number">05 / 05</div>
    <h-block name="takeaway_slide" />
  </section>
</div>
    ;;
  }
}
