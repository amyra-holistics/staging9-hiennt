Dashboard r04_haid_canvas_a2 {
  title: 'Monthly Performance Canvas'
  description: @md
    A five-slide monthly performance review covering headline KPIs, trend, category performance, and key takeaways.
  ;;
  theme: H.themes.classic

  // Static slide framing
  block t_title: TextBlock {
    content: @md
      # Monthly Performance Review

      **TheLook eCommerce**  
      A concise, month-filtered view of sales, profit, orders, and category performance.
    ;;
  }

  block t_headline: TextBlock {
    content: @md
      # Headline KPIs

      Use the month/date control to set the reporting period. All four KPIs update together.
    ;;
  }

  block t_trend: TextBlock {
    content: @md
      # Trend

      Compare monthly Net Sales and Gross Profit over the selected date range.
    ;;
  }

  block t_category: TextBlock {
    content: @md
      # Category Breakdown

      Identify the product categories contributing the most Net Sales in the selected period.
    ;;
  }

  block t_takeaways: TextBlock {
    content: @md
      # Key Takeaways

      Review the latest month in the selected range, including month-over-month movement.
    ;;
  }

  // Shared reporting-period control, placed on each data slide.
  block f_month: FilterBlock {
    label: 'Month / Date Range'
    type: 'date'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block v_net_sales: VizBlock {
    label: 'Net Sales'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block v_gross_profit: VizBlock {
    label: 'Gross Profit'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_profit)
        label: 'Gross Profit'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block v_gross_margin: VizBlock {
    label: 'Gross Margin'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block v_fulfilled_orders: VizBlock {
    label: 'Fulfilled Orders'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        label: 'Fulfilled Orders'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block v_monthly_sales_profit: VizBlock {
    label: 'Monthly Net Sales and Gross Profit'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        label: 'Month'
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        series {
          mark_type: 'line'
          field: VizFieldFull {
            label: 'Net Sales'
            ref: r(thelook.net_sales)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        series {
          mark_type: 'line'
          field: VizFieldFull {
            label: 'Gross Profit'
            ref: r(thelook.gross_profit)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        legend_label: 'bottom'
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block v_sales_by_category: VizBlock {
    label: 'Net Sales by Category'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Product Category'
      }
      y_axis {
        series {
          mark_type: 'bar'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block v_monthly_takeaways: VizBlock {
    label: 'Monthly Performance Takeaways'
    viz: MarkdownViz {
      dataset: thelook
      rows: [
        VizFieldFull {
          ref: r(thelook_order_items.created_at)
          label: 'Month'
          transformation: 'datetrunc month'
          format {
            type: 'date'
            pattern: 'LLL yyyy'
          }
          uname: 'datetrunc_month_created_at_1'
        }
      ]
      values: [
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format { type: 'number' pattern: 'inherited' }
        },
        VizFieldFull {
          ref: r(thelook.gross_profit)
          label: 'Gross Profit'
          format { type: 'number' pattern: 'inherited' }
        },
        VizFieldFull {
          ref: r(thelook.gross_margin)
          label: 'Gross Margin'
          format { type: 'number' pattern: 'inherited' }
        },
        VizFieldFull {
          ref: r(thelook.fulfilled_orders)
          label: 'Fulfilled Orders'
          format { type: 'number' pattern: 'inherited' }
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales MoM Change'
          format { type: 'number' pattern: 'inherited' }
          analytic: PeriodOverPeriodComparison {
            time_dimension: r(thelook_order_items.created_at)
            display: 'change'
            comparison_period: '1 month ago'
          }
        },
        VizFieldFull {
          ref: r(thelook.gross_profit)
          label: 'Gross Profit MoM Change'
          format { type: 'number' pattern: 'inherited' }
          analytic: PeriodOverPeriodComparison {
            time_dimension: r(thelook_order_items.created_at)
            display: 'change'
            comparison_period: '1 month ago'
          }
        }
      ]
      content: @md
        <style>
          .monthly-takeaway { display: none; max-width: 720px; padding: 24px; color: #1F2937; background: #FFFFFF; border: 1px solid #E5E7EB; border-radius: 12px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
          .monthly-takeaway:last-child { display: block; }
          .takeaway-kicker { margin: 0 0 4px; color: #6B7280; font-size: 13px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; }
          .takeaway-title { margin: 0 0 12px; color: #111827; font-size: 24px; font-weight: 700; }
          .takeaway-summary { margin: 0 0 20px; color: #4B5563; font-size: 15px; line-height: 1.55; }
          .takeaway-metrics { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin-bottom: 18px; }
          .takeaway-metric { padding: 14px; background: #F9FAFB; border-radius: 8px; }
          .takeaway-label { color: #6B7280; font-size: 12px; font-weight: 600; text-transform: uppercase; }
          .takeaway-value { margin-top: 5px; color: #111827; font-size: 20px; font-weight: 700; }
          .takeaway-comparison { padding-top: 16px; color: #4B5563; border-top: 1px solid #E5E7EB; font-size: 14px; line-height: 1.6; }
          .takeaway-comparison strong { color: #111827; }
          @media (max-width: 480px) { .takeaway-metrics { grid-template-columns: 1fr; } }
        </style>
        {% map(rows) %}
          <article class="monthly-takeaway">
            <p class="takeaway-kicker">Latest month · {{ `Month` }}</p>
            <h2 class="takeaway-title">Monthly Performance Takeaways</h2>
            <p class="takeaway-summary">In {{ `Month` }}, Net Sales were <strong>{{ values.`Net Sales` }}</strong> and Gross Profit was <strong>{{ values.`Gross Profit` }}</strong>.</p>
            <div class="takeaway-metrics">
              <div class="takeaway-metric"><div class="takeaway-label">Net Sales</div><div class="takeaway-value">{{ values.`Net Sales` }}</div></div>
              <div class="takeaway-metric"><div class="takeaway-label">Gross Profit</div><div class="takeaway-value">{{ values.`Gross Profit` }}</div></div>
              <div class="takeaway-metric"><div class="takeaway-label">Gross Margin</div><div class="takeaway-value">{{ values.`Gross Margin` }}</div></div>
              <div class="takeaway-metric"><div class="takeaway-label">Fulfilled Orders</div><div class="takeaway-value">{{ values.`Fulfilled Orders` }}</div></div>
            </div>
            <div class="takeaway-comparison">Month over month, Net Sales moved <strong>{{ values.`Net Sales MoM Change` }}</strong> and Gross Profit moved <strong>{{ values.`Gross Profit MoM Change` }}</strong>.</div>
          </article>
        {% end %}
      ;;
      settings {
        sorts: [
          KeyBasedSortSetting {
            key: 'datetrunc_month_created_at_1'
            direction: 'asc'
          }
        ]
      }
    }
  }

  interactions: [
    FilterInteraction {
      from: 'f_month'
      to: [
        'v_net_sales',
        'v_gross_profit',
        'v_gross_margin',
        'v_fulfilled_orders',
        'v_monthly_sales_profit',
        'v_sales_by_category',
        'v_monthly_takeaways'
      ]
      field: r(thelook_order_items.created_at)
    }
  ]

  view: TabLayout {
    tab title: CanvasLayout {
      label: 'Title'
      width: 1280
      height: 720
      grid_size: 20
      block t_title { position: pos(120, 230, 1040, 240) layer: 1 }
      mobile { mode: 'auto' }
    }

    tab headline_kpis: CanvasLayout {
      label: 'Headline KPIs'
      width: 1280
      height: 720
      grid_size: 20
      block t_headline { position: pos(40, 40, 1200, 120) layer: 1 }
      block f_month { position: pos(40, 180, 360, 100) layer: 1 }
      block v_net_sales { position: pos(40, 320, 280, 180) layer: 1 }
      block v_gross_profit { position: pos(340, 320, 280, 180) layer: 1 }
      block v_gross_margin { position: pos(640, 320, 280, 180) layer: 1 }
      block v_fulfilled_orders { position: pos(940, 320, 280, 180) layer: 1 }
      mobile { mode: 'auto' }
    }

    tab trend: CanvasLayout {
      label: 'Trend'
      width: 1280
      height: 720
      grid_size: 20
      block t_trend { position: pos(40, 40, 1200, 100) layer: 1 }
      block f_month { position: pos(40, 160, 360, 100) layer: 1 }
      block v_monthly_sales_profit { position: pos(40, 300, 1200, 360) layer: 1 }
      mobile { mode: 'auto' }
    }

    tab category_breakdown: CanvasLayout {
      label: 'Category Breakdown'
      width: 1280
      height: 720
      grid_size: 20
      block t_category { position: pos(40, 40, 1200, 100) layer: 1 }
      block f_month { position: pos(40, 160, 360, 100) layer: 1 }
      block v_sales_by_category { position: pos(40, 300, 1200, 360) layer: 1 }
      mobile { mode: 'auto' }
    }

    tab key_takeaways: CanvasLayout {
      label: 'Key Takeaways'
      width: 1280
      height: 720
      grid_size: 20
      block t_takeaways { position: pos(40, 40, 1200, 100) layer: 1 }
      block f_month { position: pos(40, 160, 360, 100) layer: 1 }
      block v_monthly_takeaways { position: pos(260, 280, 760, 400) layer: 1 }
      mobile { mode: 'auto' }
    }
  }
}
