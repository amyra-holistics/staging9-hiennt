Dashboard r04_haid_html_a1 {
  title: 'TheLook Monthly Performance Review'
  description: @md A five-slide monthly performance review covering headline performance, sales trend, category mix, and return quality. Use the date range to scope every KPI and chart. ;;
  theme: H.themes.classic

  block f_order_item_date: FilterBlock {
    label: 'Order Item Date Range'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block v_net_sales: VizBlock {
    label: 'Net Sales'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format { type: 'number' pattern: 'inherited' }
      }
    }
  }

  block v_orders: VizBlock {
    label: 'Orders'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.total_orders)
        label: 'Orders'
        format { type: 'number' pattern: 'inherited' }
      }
    }
  }

  block v_gross_profit: VizBlock {
    label: 'Gross Profit'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_profit)
        label: 'Gross Profit'
        format { type: 'number' pattern: 'inherited' }
      }
    }
  }

  block v_gross_margin: VizBlock {
    label: 'Gross Margin'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format { type: 'number' pattern: 'inherited' }
      }
    }
  }

  block v_aov: VizBlock {
    label: 'Average Order Value'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'
        format { type: 'number' pattern: 'inherited' }
      }
      settings { display_mode: 'single' alignment: 'center' }
    }
  }

  block v_monthly_net_sales: VizBlock {
    label: 'Monthly Net Sales Trend'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        label: 'Order Item Month'
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format { type: 'date' pattern: 'LLL yyyy' }
        uname: 'datetrunc_month_created_at_1'
      }
      y_axis {
        series {
          mark_type: 'line'
          field: VizFieldFull {
            label: 'Net Sales'
            ref: r(thelook.net_sales)
            format { type: 'number' pattern: 'inherited' }
          }
        }
      }
      settings {
        x_axis_label: 'Order Item Month'
        legend_label: 'hidden'
        show_data_points: true
        sort: LineFamilySort { type: 'xaxis' direction: 'asc' }
      }
    }
  }

  block v_net_sales_by_category: VizBlock {
    label: 'Net Sales by Product Category'
    viz: CombinationChart {
      dataset: thelook
      calculation net_sales_rank {
        label: 'Net Sales Rank'
        formula: @aql rank(order: net_sales | desc(), partition: []);;
        calc_type: 'measure'
        data_type: 'number'
      }
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Product Category'
      }
      y_axis {
        series {
          mark_type: 'bar'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format { type: 'number' pattern: 'inherited' }
          }
        }
      }
      settings {
        sort: LineFamilySort { type: 'yaxis' field_index: 0 direction: 'desc' }
      }
    }
  }

  block v_monthly_return_rate: VizBlock {
    label: 'Monthly Return Rate'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        label: 'Order Item Month'
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format { type: 'date' pattern: 'LLL yyyy' }
      }
      y_axis {
        series {
          mark_type: 'line'
          field: VizFieldFull {
            label: 'Return Rate'
            ref: r(thelook.return_rate)
            format { type: 'number' pattern: '#,###0.0%' }
          }
        }
      }
      settings {
        legend_label: 'hidden'
        sort: LineFamilySort { type: 'xaxis' direction: 'asc' }
      }
    }
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'f_order_item_date'
      to: [
        'v_net_sales',
        'v_orders',
        'v_gross_profit',
        'v_gross_margin',
        'v_aov',
        'v_monthly_net_sales',
        'v_net_sales_by_category',
        'v_monthly_return_rate',
      ]
      field: r(thelook_order_items.created_at)
    }
  ]

  view: HTMLLayout {
    content: @html
      <style>
        .r04-deck { background: #f4f7fb; color: #132238; font-family: Inter, Arial, sans-serif; padding: 24px; }
        .r04-slide { aspect-ratio: 16 / 9; box-sizing: border-box; min-height: 640px; margin: 0 auto 28px; max-width: 1440px; padding: 56px 64px; background: #ffffff; border: 1px solid #dbe4ef; border-radius: 18px; box-shadow: 0 10px 30px rgba(30, 55, 90, .08); display: flex; flex-direction: column; gap: 22px; }
        .r04-title { background: linear-gradient(135deg, #112b46, #1b5d85); color: #ffffff; justify-content: center; }
        .r04-kicker { color: #77d6ff; font-size: 13px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
        .r04-title h1 { font-size: clamp(42px, 6vw, 78px); line-height: 1.02; margin: 0; max-width: 820px; }
        .r04-subtitle { color: #d7e8f5; font-size: 21px; line-height: 1.45; max-width: 720px; }
        .r04-title .filter { max-width: 400px; margin-top: 24px; }
        .r04-slide h2 { color: #173b61; font-size: 33px; margin: 0; }
        .r04-slide p { color: #617089; margin: 0; }
        .r04-kpis { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 16px; flex: 1; align-items: center; }
        .r04-kpi { min-height: 190px; padding: 18px; border: 1px solid #dbe4ef; border-radius: 14px; background: #fbfdff; }
        .r04-chart { flex: 1; min-height: 0; }
        .r04-chart h-block { display: block; height: 100%; }
        .r04-footer { color: #7e8ba0; font-size: 13px; margin-top: auto; }
        @media (max-width: 900px) { .r04-slide { aspect-ratio: auto; min-height: 0; padding: 32px 24px; } .r04-kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
      </style>
      <main class="r04-deck">
        <section class="r04-slide r04-title">
          <div class="r04-kicker">TheLook eCommerce</div>
          <h1>Monthly Performance Review</h1>
          <p class="r04-subtitle">A focused five-slide view of sales momentum, product-category mix, and return quality.</p>
          <div class="filter"><h-block name="f_order_item_date" /></div>
          <div class="r04-footer">Use the date range to scope every KPI and chart in this deck.</div>
        </section>

        <section class="r04-slide">
          <div class="r04-kicker">Slide 2</div>
          <h2>Headline KPIs</h2>
          <p>Commercial performance for the selected order-item date range.</p>
          <div class="r04-kpis">
            <div class="r04-kpi"><h-block name="v_net_sales" /></div>
            <div class="r04-kpi"><h-block name="v_orders" /></div>
            <div class="r04-kpi"><h-block name="v_gross_profit" /></div>
            <div class="r04-kpi"><h-block name="v_gross_margin" /></div>
            <div class="r04-kpi"><h-block name="v_aov" /></div>
          </div>
        </section>

        <section class="r04-slide">
          <div class="r04-kicker">Slide 3</div>
          <h2>Monthly Net Sales Trend</h2>
          <p>Net Sales exclude cancelled and returned order items.</p>
          <div class="r04-chart"><h-block name="v_monthly_net_sales" /></div>
        </section>

        <section class="r04-slide">
          <div class="r04-kicker">Slide 4</div>
          <h2>Net Sales by Product Category</h2>
          <p>Use this ranking to focus merchandising attention on the largest net-sales contributors.</p>
          <div class="r04-chart"><h-block name="v_net_sales_by_category" /></div>
        </section>

        <section class="r04-slide">
          <div class="r04-kicker">Slide 5</div>
          <h2>Operational Quality: Return Rate</h2>
          <p>Return Rate is the share of all order items with a Returned status; review spikes alongside category performance.</p>
          <div class="r04-chart"><h-block name="v_monthly_return_rate" /></div>
        </section>
      </main>
    ;;
  }
}
