Dashboard r04_haid_html_a2 {
  title: 'Commerce Performance Slides'
  description: @md
    An interactive five-slide commerce performance briefing. Use the controls on the headline KPI slide to update all applicable visuals.
  ;;

  block t_title: TextBlock {
    content: @md
      <div class="title-copy">
        <p class="eyebrow">THELOOK ECOMMERCE</p>
        <h1>Commerce Performance Briefing</h1>
        <p class="subtitle">A five-slide view of headline performance, monthly momentum, category mix, and live takeaways.</p>
      </div>
    ;;
  }

  block t_kpi_frame: TextBlock {
    content: @md
      <div class="section-copy">
        <p class="eyebrow">SLIDE 02</p>
        <h2>Headline KPIs</h2>
        <p>Adjust the date range, product category, and department to focus the briefing.</p>
      </div>
    ;;
  }

  block t_trend_frame: TextBlock {
    content: @md
      <div class="section-copy">
        <p class="eyebrow">SLIDE 03</p>
        <h2>Monthly Performance Trend</h2>
        <p>Track the relationship between sales, profit, fulfilled orders, and average order value.</p>
      </div>
    ;;
  }

  block t_category_frame: TextBlock {
    content: @md
      <div class="section-copy">
        <p class="eyebrow">SLIDE 04</p>
        <h2>Category Breakdown</h2>
        <p>Compare net sales across product categories under the active controls.</p>
      </div>
    ;;
  }

  block t_takeaways_frame: TextBlock {
    content: @md
      <div class="section-copy">
        <p class="eyebrow">SLIDE 05</p>
        <h2>Key Takeaways</h2>
        <p>Live monthly performance inputs for the selected period and product slice.</p>
      </div>
    ;;
  }

  block f_order_item_date: FilterBlock {
    label: 'Order Item Created at'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block f_product_category: FilterBlock {
    label: 'Product Category'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.category)
    }
  }

  block f_product_department: FilterBlock {
    label: 'Product Department'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.department)
    }
  }

  block v_kpi_sheet: VizBlock {
    label: 'Monthly Commerce KPI Sheet'
    viz: MetricSheet {
      dataset: thelook
      date_field: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        label: 'Order Item Month'
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      rows: [
        MetricSeries {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        },
        MetricSeries {
          field: VizFieldFull {
            ref: r(thelook.gross_profit)
            label: 'Gross Profit'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        },
        MetricSeries {
          field: VizFieldFull {
            ref: r(thelook.gross_margin)
            label: 'Gross Margin'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        },
        MetricSeries {
          field: VizFieldFull {
            ref: r(thelook.fulfilled_orders)
            label: 'Fulfilled Orders'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        },
        MetricSeries {
          field: VizFieldFull {
            ref: r(thelook.aov)
            label: 'Average Order Value'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        },
      ]
    }
  }

  block v_sales_profit_trend: VizBlock {
    label: 'Monthly Net Sales and Gross Profit'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        label: 'Month'
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        label: 'USD'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.gross_profit)
            label: 'Gross Profit'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        legend_label: 'bottom'
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block v_orders_aov_trend: VizBlock {
    label: 'Monthly Fulfilled Orders and Average Order Value'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        label: 'Order Item Created Month'
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        label: 'Fulfilled Orders'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.fulfilled_orders)
            label: 'Fulfilled Orders'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        settings {
          alignment: 'left'
        }
      }
      y_axis {
        label: 'Average Order Value'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.aov)
            label: 'Average Order Value'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        settings {
          alignment: 'right'
        }
      }
      settings {
        x_axis_label: 'Order Item Created Month'
        legend_label: 'bottom'
        show_data_points: true
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block v_category_ranking: VizBlock {
    label: 'Net Sales by Product Category'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Product Category'
      }
      y_axis {
        series {
          mark_type: 'bar'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block v_monthly_takeaways: VizBlock {
    label: 'Monthly Performance Takeaways'
    viz: MarkdownViz {
      dataset: thelook
      rows: [
        VizFieldFull {
          ref: r(thelook_order_items.created_at)
          label: 'Month'
          transformation: 'datetrunc month'
          format {
            type: 'date'
            pattern: 'LLL yyyy'
          }
          uname: 'month'
        },
      ]
      values: [
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format { type: 'number' pattern: 'inherited' }
        },
        VizFieldFull {
          ref: r(thelook.gross_margin)
          label: 'Gross Margin'
          format { type: 'number' pattern: 'inherited' }
        },
        VizFieldFull {
          ref: r(thelook.aov)
          label: 'Average Order Value'
          format { type: 'number' pattern: 'inherited' }
        },
        VizFieldFull {
          ref: r(thelook.return_rate)
          label: 'Return Rate'
          format { type: 'number' pattern: 'inherited' }
        },
        VizFieldFull {
          ref: r(thelook.fulfilled_orders)
          label: 'Fulfilled Orders'
          format { type: 'number' pattern: 'inherited' }
        },
      ]
      content: @md
        <style>
          .monthly-performance-card { border: 1px solid #E5E7EB; border-radius: 10px; background: #FFFFFF; padding: 1.25rem 1.5rem; margin-bottom: 1rem; }
          .monthly-performance-card h3 { margin: 0; color: #111827; font-size: 1.05rem; }
          .monthly-performance-month { margin: 0.3rem 0 0.8rem; color: #4B5563; font-weight: 600; }
          .monthly-performance-card ul { margin: 0; padding-left: 1.2rem; color: #374151; line-height: 1.7; }
          .monthly-performance-card strong { color: #111827; }
          .monthly-performance-note { margin: 0.8rem 0 0; color: #6B7280; font-size: 0.875rem; }
        </style>

        {% map(rows) %}
        <section class="monthly-performance-card">
          <h3>Monthly performance</h3>
          <p class="monthly-performance-month">{{ `Month` }}</p>
          <ul>
            <li><strong>Net Sales:</strong> {{ values.`Net Sales` }}</li>
            <li><strong>Gross Margin:</strong> {{ values.`Gross Margin` }}</li>
            <li><strong>Average Order Value:</strong> {{ values.`Average Order Value` }}</li>
            <li><strong>Return Rate:</strong> {{ values.`Return Rate` }}</li>
            <li><strong>Fulfilled Orders:</strong> {{ values.`Fulfilled Orders` }}</li>
          </ul>
          <p class="monthly-performance-note">These values are monthly performance inputs.</p>
        </section>
        {% end %}
      ;;
      settings {
        sorts: [
          KeyBasedSortSetting {
            key: 'month'
            direction: 'asc'
          },
        ]
      }
    }
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'f_order_item_date'
      to: ['v_kpi_sheet', 'v_sales_profit_trend', 'v_orders_aov_trend', 'v_monthly_takeaways']
      field: r(thelook_order_items.created_at)
    },
    FilterInteraction {
      from: 'f_product_category'
      to: ['v_kpi_sheet', 'v_sales_profit_trend', 'v_orders_aov_trend', 'v_category_ranking', 'v_monthly_takeaways']
      field: r(thelook_products.category)
    },
    FilterInteraction {
      from: 'f_product_department'
      to: ['v_kpi_sheet', 'v_sales_profit_trend', 'v_orders_aov_trend', 'v_category_ranking', 'v_monthly_takeaways']
      field: r(thelook_products.department)
    },
  ]

  view: HTMLLayout {
    content: @html
      <style>
        .slide-deck { max-width: 1440px; margin: 0 auto; color: #0F172A; font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
        .slide { display: none; box-sizing: border-box; aspect-ratio: 16 / 9; min-height: 680px; padding: clamp(2rem, 4vw, 4.5rem); background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 24px; box-shadow: 0 20px 45px rgba(15, 23, 42, 0.10); flex-direction: column; gap: 1.25rem; overflow: auto; }
        #slide-title { display: flex; background: linear-gradient(135deg, #0F172A 0%, #172554 58%, #1D4ED8 100%); color: #F8FAFC; justify-content: center; }
        .slide:target { display: flex; }
        .slide-deck:has(.slide:target) #slide-title:not(:target) { display: none; }
        .slide-deck:has(.slide:target) .slide:target { display: flex; }
        .title-copy { max-width: 920px; margin: auto 0; }
        .title-copy h1 { margin: 0.35rem 0 1rem; color: #FFFFFF; font-size: clamp(3rem, 6vw, 6.5rem); line-height: 0.98; letter-spacing: -0.06em; }
        .subtitle { max-width: 680px; margin: 0; color: #CBD5E1; font-size: clamp(1.05rem, 2vw, 1.45rem); line-height: 1.6; }
        .eyebrow { margin: 0; color: #2563EB; font-size: 0.75rem; font-weight: 800; letter-spacing: 0.16em; }
        .title-copy .eyebrow { color: #93C5FD; }
        .section-copy h2 { margin: 0.35rem 0; font-size: clamp(1.8rem, 3vw, 2.8rem); letter-spacing: -0.04em; }
        .section-copy p { margin: 0; color: #475569; font-size: 1rem; }
        .controls { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; padding: 1rem; background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 16px; }
        .viz-fill { flex: 1; min-height: 0; background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 16px; padding: 0.75rem; }
        .trend-grid { display: grid; grid-template-columns: 1fr 1fr; flex: 1; min-height: 0; gap: 1.25rem; }
        .trend-grid .viz-fill { min-height: 420px; }
        .takeaways { flex: 1; min-height: 0; overflow: auto; background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 16px; padding: 1rem; }
        .slide-nav { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: auto; padding-top: 0.5rem; }
        .slide-nav a { color: inherit; background: #FFFFFF; border: 1px solid #CBD5E1; border-radius: 999px; padding: 0.55rem 0.95rem; text-decoration: none; font-size: 0.9rem; font-weight: 700; }
        .slide-nav a:hover { background: #DBEAFE; border-color: #60A5FA; }
        #slide-title .slide-nav a { background: rgba(255, 255, 255, 0.12); border-color: rgba(255, 255, 255, 0.35); color: #FFFFFF; }
        .slide-counter { color: #64748B; font-size: 0.85rem; font-weight: 700; }
        #slide-title .slide-counter { color: #BFDBFE; }
        @media (max-width: 900px) { .slide { aspect-ratio: auto; min-height: 100vh; } .controls, .trend-grid { grid-template-columns: 1fr; } .trend-grid .viz-fill { min-height: 360px; } }
      </style>

      <main class="slide-deck">
        <section id="slide-title" class="slide" aria-label="Title slide">
          <h-block name="t_title" />
          <nav class="slide-nav" aria-label="Slide navigation">
            <span class="slide-counter">01 / 05</span>
            <a href="#slide-kpis">Next: Headline KPIs →</a>
          </nav>
        </section>

        <section id="slide-kpis" class="slide" aria-label="Headline KPIs slide">
          <h-block name="t_kpi_frame" />
          <div class="controls">
            <h-block name="f_order_item_date" />
            <h-block name="f_product_category" />
            <h-block name="f_product_department" />
          </div>
          <div class="viz-fill"><h-block name="v_kpi_sheet" /></div>
          <nav class="slide-nav" aria-label="Slide navigation">
            <a href="#slide-title">← Previous: Title</a>
            <span class="slide-counter">02 / 05</span>
            <a href="#slide-trend">Next: Trend →</a>
          </nav>
        </section>

        <section id="slide-trend" class="slide" aria-label="Trend slide">
          <h-block name="t_trend_frame" />
          <div class="trend-grid">
            <div class="viz-fill"><h-block name="v_sales_profit_trend" /></div>
            <div class="viz-fill"><h-block name="v_orders_aov_trend" /></div>
          </div>
          <nav class="slide-nav" aria-label="Slide navigation">
            <a href="#slide-kpis">← Previous: Headline KPIs</a>
            <span class="slide-counter">03 / 05</span>
            <a href="#slide-category">Next: Category Breakdown →</a>
          </nav>
        </section>

        <section id="slide-category" class="slide" aria-label="Category breakdown slide">
          <h-block name="t_category_frame" />
          <div class="viz-fill"><h-block name="v_category_ranking" /></div>
          <nav class="slide-nav" aria-label="Slide navigation">
            <a href="#slide-trend">← Previous: Trend</a>
            <span class="slide-counter">04 / 05</span>
            <a href="#slide-takeaways">Next: Key Takeaways →</a>
          </nav>
        </section>

        <section id="slide-takeaways" class="slide" aria-label="Key takeaways slide">
          <h-block name="t_takeaways_frame" />
          <div class="takeaways"><h-block name="v_monthly_takeaways" /></div>
          <nav class="slide-nav" aria-label="Slide navigation">
            <a href="#slide-category">← Previous: Category Breakdown</a>
            <span class="slide-counter">05 / 05</span>
            <a href="#slide-title">Back to title ↺</a>
          </nav>
        </section>
      </main>
    ;;
  }
}
