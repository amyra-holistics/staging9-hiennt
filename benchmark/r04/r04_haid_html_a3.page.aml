Dashboard r04_haid_html_a3 {
  title: 'Monthly Performance Review'
  description: @md
    A presentation-style monthly performance dashboard for monitoring sales, orders, profitability, and category mix.
  ;;

  block title_slide: TextBlock {
    content: @md
      # Monthly Performance Review

      A compact executive readout of sales, fulfillment, and margin performance. Use the controls to focus every slide on a period or product category.
    ;;
  }

  block f_order_item_date: FilterBlock {
    label: 'Order Item Date'
    type: 'date'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block f_product_category: FilterBlock {
    label: 'Product Category'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.category)
    }
  }

  block kpi_net_sales: VizBlock {
    label: 'Net Sales'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format { type: 'number' pattern: 'inherited' }
      }
    }
  }

  block kpi_fulfilled_orders: VizBlock {
    label: 'Fulfilled Orders'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        label: 'Fulfilled Orders'
        format { type: 'number' pattern: 'inherited' }
      }
    }
  }

  block kpi_aov: VizBlock {
    label: 'Average Order Value'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'
        format { type: 'number' pattern: 'inherited' }
      }
    }
  }

  block kpi_gross_margin: VizBlock {
    label: 'Gross Margin'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format { type: 'number' pattern: 'inherited' }
      }
    }
  }

  block monthly_trend: VizBlock {
    label: 'Monthly Net Sales and Gross Profit Trend'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        label: 'Month'
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format { type: 'date' pattern: 'LLL yyyy' }
      }
      y_axis {
        series {
          mark_type: 'line'
          field: VizFieldFull {
            label: 'Net Sales'
            ref: r(thelook.net_sales)
            format { type: 'number' pattern: 'inherited' }
          }
        }
        series {
          mark_type: 'line'
          field: VizFieldFull {
            label: 'Gross Profit'
            ref: r(thelook.gross_profit)
            format { type: 'number' pattern: 'inherited' }
          }
        }
      }
      settings {
        sort: LineFamilySort { type: 'xaxis' field_index: 0 direction: 'asc' }
      }
    }
  }

  block category_breakdown: VizBlock {
    label: 'Net Sales by Product Category'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Product Category'
      }
      y_axis {
        series {
          mark_type: 'bar'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format { type: 'number' pattern: 'inherited' }
          }
        }
      }
      settings {
        sort: LineFamilySort { type: 'yaxis' field_index: 0 direction: 'desc' }
      }
    }
  }

  block key_takeaways: VizBlock {
    label: 'Key Takeaways'
    viz: MarkdownViz {
      dataset: thelook
      values: [
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format { type: 'number' pattern: 'inherited' }
        },
        VizFieldFull {
          ref: r(thelook.gross_profit)
          label: 'Gross Profit'
          format { type: 'number' pattern: 'inherited' }
        },
        VizFieldFull {
          ref: r(thelook.gross_margin)
          label: 'Gross Margin'
          format { type: 'number' pattern: 'inherited' }
        },
        VizFieldFull {
          ref: r(thelook.return_rate)
          label: 'Return Rate'
          format { type: 'number' pattern: 'inherited' }
        }
      ]
      content: @md
        <style>
          .key-takeaways-card { padding: 1.25rem 1.5rem; border: 1px solid #E5E7EB; border-radius: 12px; background: #FFFFFF; color: #111827; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
          .key-takeaways-card h2 { margin: 0 0 1rem; font-size: 1.125rem; font-weight: 700; line-height: 1.35; }
          .key-takeaways-metrics { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.75rem; }
          .key-takeaways-metric { padding: 0.75rem 0.9rem; border-radius: 8px; background: #F8FAFC; }
          .key-takeaways-label { color: #64748B; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.03em; text-transform: uppercase; }
          .key-takeaways-value { margin-top: 0.25rem; color: #0F172A; font-size: 1.2rem; font-weight: 700; line-height: 1.25; white-space: nowrap; }
          @media (max-width: 640px) { .key-takeaways-metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
        </style>
        <section class="key-takeaways-card">
          <h2>Key takeaways</h2>
          <div class="key-takeaways-metrics">
            <div class="key-takeaways-metric"><div class="key-takeaways-label">Net Sales</div><div class="key-takeaways-value">{{ rows[0].values.`Net Sales` }}</div></div>
            <div class="key-takeaways-metric"><div class="key-takeaways-label">Gross Profit</div><div class="key-takeaways-value">{{ rows[0].values.`Gross Profit` }}</div></div>
            <div class="key-takeaways-metric"><div class="key-takeaways-label">Gross Margin</div><div class="key-takeaways-value">{{ rows[0].values.`Gross Margin` }}</div></div>
            <div class="key-takeaways-metric"><div class="key-takeaways-label">Return Rate</div><div class="key-takeaways-value">{{ rows[0].values.`Return Rate` }}</div></div>
          </div>
        </section>
      ;;
    }
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'f_order_item_date'
      to: ['kpi_net_sales', 'kpi_fulfilled_orders', 'kpi_aov', 'kpi_gross_margin', 'monthly_trend', 'category_breakdown', 'key_takeaways']
      field: r(thelook_order_items.created_at)
    },
    FilterInteraction {
      from: 'f_order_item_date'
      to: ['f_product_category']
      disabled: true
    },
    FilterInteraction {
      from: 'f_product_category'
      to: ['kpi_net_sales', 'kpi_fulfilled_orders', 'kpi_aov', 'kpi_gross_margin', 'monthly_trend', 'category_breakdown', 'key_takeaways']
      field: r(thelook_products.category)
    },
    FilterInteraction {
      from: 'f_product_category'
      to: ['f_order_item_date']
      disabled: true
    }
  ]

  view: HTMLLayout {
    content: @html
      <style>
        :host { --ink: #102A43; --muted: #627D98; --navy: #0B1F3A; --blue: #176B87; --aqua: #38A3A5; --mist: #F4F8FB; --line: #D9E2EC; }
        .deck { background: #EAF1F7; padding: 28px; display: grid; gap: 28px; font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
        .slide { aspect-ratio: 16 / 9; min-height: 560px; box-sizing: border-box; overflow: hidden; background: #FFFFFF; border-radius: 20px; box-shadow: 0 16px 42px rgba(15, 42, 67, 0.13); padding: clamp(28px, 4vw, 64px); display: flex; flex-direction: column; }
        .eyebrow { margin: 0 0 14px; color: var(--aqua); font-size: 0.8rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; }
        .slide-heading { margin: 0 0 10px; color: var(--ink); font-size: clamp(1.6rem, 3vw, 2.6rem); letter-spacing: -0.04em; }
        .slide-copy { margin: 0 0 28px; color: var(--muted); max-width: 46rem; line-height: 1.5; }
        .title-slide { justify-content: space-between; background: linear-gradient(135deg, #0B1F3A 0%, #123D5A 58%, #176B87 100%); color: #FFFFFF; position: relative; }
        .title-slide::after { content: ''; position: absolute; width: 38vw; height: 38vw; right: -13vw; top: -13vw; border: 2px solid rgba(255,255,255,.15); border-radius: 50%; box-shadow: 0 0 0 42px rgba(255,255,255,.04), 0 0 0 85px rgba(255,255,255,.03); }
        .title-slide .eyebrow, .title-slide .slide-copy { color: #B9E6E8; }
        .title-slide h1 { color: #FFFFFF; max-width: 760px; font-size: clamp(2.6rem, 6vw, 5.5rem); line-height: 0.98; letter-spacing: -0.06em; }
        .title-content { position: relative; z-index: 1; }
        .control-row { position: relative; z-index: 1; display: grid; grid-template-columns: repeat(2, minmax(0, 320px)); gap: 16px; align-items: end; }
        .slide-kpis { background: linear-gradient(160deg, #F8FBFD 0%, #FFFFFF 70%); }
        .kpi-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; flex: 1; align-items: center; }
        .kpi-grid h-block { background: #FFFFFF; border: 1px solid var(--line); border-radius: 14px; min-height: 170px; padding: 8px; box-shadow: 0 8px 22px rgba(15, 42, 67, .06); }
        .chart-wrap { flex: 1; min-height: 0; border: 1px solid var(--line); border-radius: 16px; padding: 12px; background: #FFFFFF; }
        .takeaways-wrap { flex: 1; display: flex; align-items: center; background: linear-gradient(135deg, #EEF8F8 0%, #FFFFFF 72%); border-radius: 16px; padding: 28px; }
        .takeaways-wrap h-block { width: 100%; }
        @media (max-width: 800px) { .slide { aspect-ratio: auto; min-height: 0; } .kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .control-row { grid-template-columns: 1fr; } }
      </style>
      <main class="deck">
        <section class="slide title-slide">
          <div class="title-content">
            <p class="eyebrow">TheLook · Executive performance deck</p>
            <h-block name="title_slide" />
          </div>
          <div class="control-row">
            <h-block name="f_order_item_date" />
            <h-block name="f_product_category" />
          </div>
        </section>
        <section class="slide slide-kpis">
          <p class="eyebrow">Slide 2 · Headline KPIs</p>
          <h2 class="slide-heading">Performance at a glance</h2>
          <p class="slide-copy">The core measures for the current filter selection.</p>
          <div class="kpi-grid">
            <h-block name="kpi_net_sales" />
            <h-block name="kpi_fulfilled_orders" />
            <h-block name="kpi_aov" />
            <h-block name="kpi_gross_margin" />
          </div>
        </section>
        <section class="slide">
          <p class="eyebrow">Slide 3 · Trend</p>
          <h2 class="slide-heading">Sales and profit momentum</h2>
          <p class="slide-copy">Track monthly net sales alongside gross profit to assess both scale and profitability.</p>
          <div class="chart-wrap"><h-block name="monthly_trend" /></div>
        </section>
        <section class="slide">
          <p class="eyebrow">Slide 4 · Category breakdown</p>
          <h2 class="slide-heading">Where net sales come from</h2>
          <p class="slide-copy">Compare category contribution, ranked from highest to lowest net sales.</p>
          <div class="chart-wrap"><h-block name="category_breakdown" /></div>
        </section>
        <section class="slide">
          <p class="eyebrow">Slide 5 · Key takeaways</p>
          <h2 class="slide-heading">The current performance snapshot</h2>
          <p class="slide-copy">A concise summary that updates with the selected date range and product category.</p>
          <div class="takeaways-wrap"><h-block name="key_takeaways" /></div>
        </section>
      </main>
    ;;
  }
}
