Dashboard r04_haidfd_html_a3 {
  title: 'Commerce edit — September 2026'
  description: @md
    A five-slide commerce review for the September 2026 completed month, with live sales, profitability, demand, category, and source-context evidence.
  ;;

  block slide_title: TextBlock {
    content: @md
      <div class="deck-title-copy">
        <p class="kicker">The commerce edit</p>
        <h1>September<br>in focus.</h1>
        <p class="standfirst">A completed-month read on demand, margin, returns, and the categories that set the pace.</p>
      </div>
    ;;
  }

  block slide_kpis: TextBlock {
    content: @md
      <div class="section-copy"><p class="kicker">01 / The month</p><h2>The live scorecard.</h2><p>Sales and contribution sit beside demand and post-purchase signals. Read order-item and event metrics in their own source context.</p></div>
    ;;
  }

  block slide_trend: TextBlock {
    content: @md
      <div class="section-copy"><p class="kicker">02 / The runway</p><h2>Thirteen complete months, one clear view.</h2><p>Net Sales and Gross Profit share the same currency scale, so the gap is legible without a secondary axis.</p></div>
    ;;
  }

  block slide_category: TextBlock {
    content: @md
      <div class="section-copy"><p class="kicker">03 / The assortment</p><h2>Where the month was made.</h2><p>Rank sales first, then weigh margin, demand, basket value, unit volume, and returns together before changing the assortment.</p></div>
    ;;
  }

  block slide_decisions: TextBlock {
    content: @md
      <div class="decision-copy"><p class="kicker">04 / Decision desk</p><h2>Act on the evidence,<br>not the average.</h2><ol><li><strong>Protect profitable demand.</strong> Use the trend to test whether the sales–profit spread is holding as volume moves.</li><li><strong>Prioritize the sales leaders.</strong> Jeans led September category net sales at $8,209.19; validate its category-quality profile before adding inventory or promotion.</li><li><strong>Watch the handoff.</strong> Return Rate is an order-item measure; Sessions and Purchase Conversion Rate are event measures. They describe different populations and must not be ratioed together.</li></ol><p class="source-note"><strong>Period:</strong> September 1–30, 2026 for completed-month KPIs and category views. Trend covers September 2025–September 2026, with an end-exclusive filter at October 1, 2026. Currency measures are USD. Source: @Dataset:thelook.</p></div>
    ;;
  }

  block completed_month_net_sales: VizBlock {
    label: 'Net Sales'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format { type: 'number' pattern: 'inherited' }
      }
      filter { field: r(thelook_order_items.created_at) operator: 'matches' value: '2026-09-01 until 2026-10-01' }
      settings { display_mode: 'single' }
    }
  }

  block completed_month_gross_profit: VizBlock {
    label: 'Gross Profit'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_profit)
        label: 'Gross Profit'
        format { type: 'number' pattern: 'inherited' }
      }
      conditions: [ "thelook_order_items.created_at matches @(2026-09-01 until 2026-10-01)" ]
      settings { display_mode: 'single' alignment: 'center' }
    }
  }

  block completed_month_gross_margin: VizBlock {
    label: 'Gross Margin'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format { type: 'number' pattern: 'inherited' }
      }
      conditions: [ "thelook_order_items.created_at matches @(2026-09-01 until 2026-10-01)" ]
    }
  }

  block completed_month_fulfilled_orders: VizBlock {
    label: 'Fulfilled Orders'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        label: 'Fulfilled Orders'
        format { type: 'number' pattern: '#,###0' }
      }
      filter { field: r(thelook_order_items.created_at) operator: 'matches' value: '2026-09-01 until 2026-10-01' }
      settings { display_mode: 'single' }
    }
  }

  block completed_month_return_rate: VizBlock {
    label: 'Return Rate'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.return_rate)
        label: 'Return Rate'
        format { type: 'number' pattern: 'inherited' }
      }
      filter { field: r(thelook_order_items.created_at) operator: 'matches' value: '2026-09-01 until 2026-10-01' }
      settings { display_mode: 'single' }
    }
  }

  block completed_month_sessions: VizBlock {
    label: 'Sessions'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.sessions)
        label: 'Sessions'
        format { type: 'number' pattern: '#,###0' }
      }
      conditions: [ "thelook_events.created_at matches @(2026-09-01 until 2026-10-01)" ]
      settings { display_mode: 'single' row_limit: 1 }
    }
  }

  block completed_month_purchase_conversion_rate: VizBlock {
    label: 'Purchase Conversion Rate'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.purchase_conversion_rate)
        label: 'Purchase Conversion Rate'
        format { type: 'number' pattern: '#,###0.0%' }
      }
      filter { field: r(thelook_events.created_at) operator: 'matches' value: '2026-09-01 until 2026-10-01' }
      settings { display_mode: 'single' }
    }
  }

  block commerce_trend_13_complete_months: VizBlock {
    label: 'Monthly Net Sales and Gross Profit'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        label: 'Month'
        transformation: 'datetrunc month'
        format { type: 'date' pattern: 'LLL yyyy' }
      }
      y_axis {
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format { type: 'number' pattern: 'inherited' }
          }
        }
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.gross_profit)
            label: 'Gross Profit'
            format { type: 'number' pattern: 'inherited' }
          }
        }
      }
      filter { field: r(thelook_order_items.created_at) operator: 'matches' value: '2025-09-01 until 2026-10-01' }
      settings {
        x_axis_label: 'Month'
        legend_label: 'bottom'
        show_data_points: false
        sort: LineFamilySort { type: 'xaxis' direction: 'asc' }
      }
    }
  }

  block completed_month_category_net_sales_ranking: VizBlock {
    label: 'Category Net Sales Ranking'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull { ref: r(thelook_products.category) label: 'Product Category' }
      y_axis {
        label: 'Net Sales'
        series {
          mark_type: 'bar'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format { type: 'number' pattern: 'inherited' }
          }
        }
      }
      conditions: [ "thelook_order_items.created_at matches @(2026-09-01 until 2026-10-01)" ]
      settings { sort: LineFamilySort { type: 'yaxis' field_index: 0 direction: 'desc' } }
    }
  }

  block completed_month_category_quality: VizBlock {
    label: 'Category Quality'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull { label: 'Product Category' ref: r(thelook_products.category) format { type: 'text' } uname: 'product_category' },
        VizFieldFull { label: 'Gross Margin' ref: r(thelook.gross_margin) format { type: 'number' pattern: '#,###0.0%' } },
        VizFieldFull { label: 'Fulfilled Orders' ref: r(thelook.fulfilled_orders) format { type: 'number' pattern: '#,###0' } },
        VizFieldFull { label: 'Average Order Value' ref: r(thelook.aov) format { type: 'number' pattern: '[$$]#,###0.00' } },
        VizFieldFull { label: 'Items Sold' ref: r(thelook.items_sold) format { type: 'number' pattern: '#,###0' } },
        VizFieldFull { label: 'Return Rate' ref: r(thelook.return_rate) format { type: 'number' pattern: '#,###0.0%' } },
      ]
      conditions: [ "thelook_order_items.created_at matches @(@2026-09-01 until @2026-10-01)" ]
      settings {
        pagination_size: 100
        show_row_number: true
        sorts: [ KeyBasedSortSetting { key: 'product_category' direction: 'asc' } ]
        single_cell_display: 'normal'
      }
    }
  }

  view: HTMLLayout {
    content: @html
      <style>
        :root { --ink:#102A43; --bone:#F7F3EA; --vermilion:#D9644A; --cobalt:#2867B2; --mist:#DCEAF7; }
        .commerce-deck { max-width: 1440px; margin: 0 auto; padding: 24px; color:var(--ink); font-family:Arial, Helvetica, sans-serif; }
        .commerce-deck * { box-sizing:border-box; }
        .deck-nav { display:flex; justify-content:space-between; align-items:center; margin:0 auto 14px; max-width:1280px; font-size:12px; letter-spacing:.08em; }
        .deck-nav .brand { font-family:Georgia, 'Times New Roman', serif; font-size:17px; font-weight:700; letter-spacing:0; }
        .deck-nav .links { display:flex; gap:10px; flex-wrap:wrap; justify-content:flex-end; }
        .deck-nav a { color:var(--ink); text-decoration:none; border-bottom:1px solid transparent; padding:5px 0; }
        .deck-nav a:hover, .deck-nav a:focus { color:var(--vermilion); border-color:var(--vermilion); outline:none; }
        .slide { display:none; width:100%; aspect-ratio:16 / 9; min-height:620px; overflow:auto; background:var(--bone); border:1px solid var(--ink); padding:clamp(26px,4vw,64px); }
        .commerce-deck:not(:has(.slide:target)) #slide-title { display:grid; }
        .commerce-deck:has(.slide:target) .slide:target { display:grid; }
        .slide-title { grid-template-columns:1.3fr .7fr; align-items:end; background:var(--ink); color:var(--bone); }
        .slide-title .deck-title-copy { max-width:700px; }
        .kicker { margin:0 0 16px; color:var(--vermilion); font-size:12px; font-weight:700; letter-spacing:.12em; text-transform:uppercase; }
        h1, h2 { margin:0; font-family:Georgia, 'Times New Roman', serif; font-weight:700; letter-spacing:-.045em; line-height:.9; }
        h1 { font-size:clamp(64px,10vw,150px); }
        h2 { font-size:clamp(38px,5vw,72px); }
        .standfirst { max-width:500px; margin:28px 0 0; font-size:clamp(16px,1.5vw,22px); line-height:1.35; color:var(--mist); }
        .title-mark { align-self:start; justify-self:end; width:20vw; max-width:260px; aspect-ratio:1; background:var(--vermilion); border-radius:50%; }
        .slide-kpis, .slide-trend, .slide-category, .slide-decisions { grid-template-rows:auto 1fr; gap:22px; }
        .section-copy { display:grid; grid-template-columns:1.3fr .7fr; gap:36px; align-items:end; border-bottom:2px solid var(--ink); padding-bottom:20px; }
        .section-copy .kicker { grid-column:1 / -1; margin-bottom:0; }
        .section-copy p:last-child { max-width:420px; margin:0; line-height:1.4; }
        .kpi-grid { display:grid; grid-template-columns:repeat(4, 1fr); gap:14px; align-content:center; }
        .kpi-grid .metric { background:#fffdf8; border-top:5px solid var(--cobalt); min-height:130px; padding:12px; }
        .kpi-grid .metric:nth-child(2), .kpi-grid .metric:nth-child(6) { border-color:var(--vermilion); }
        .kpi-grid .metric:nth-child(n+5) { grid-column:span 1; }
        .trend-body, .category-grid { min-height:0; }
        .trend-body { background:#fffdf8; padding:12px; }
        .category-grid { display:grid; grid-template-columns:.9fr 1.1fr; gap:20px; min-height:0; }
        .category-grid > div { min-height:0; background:#fffdf8; padding:10px; }
        .decision-copy { display:grid; grid-template-columns:1.05fr .95fr; gap:40px; align-content:start; }
        .decision-copy .kicker, .decision-copy .source-note { grid-column:1 / -1; }
        .decision-copy ol { margin:0; padding-left:22px; font-size:17px; line-height:1.45; }
        .decision-copy li { margin:0 0 18px; padding-left:6px; }
        .source-note { border-top:1px solid var(--ink); margin:0; padding-top:16px; font-size:12px; line-height:1.4; }
        h-block { display:block; width:100%; height:100%; }
        @media (max-width:800px) { .commerce-deck { padding:12px; } .slide { aspect-ratio:auto; min-height:720px; padding:28px 22px; } .slide-title, .section-copy, .decision-copy, .category-grid { grid-template-columns:1fr; } .title-mark { justify-self:start; width:90px; } .kpi-grid { grid-template-columns:repeat(2,1fr); } .section-copy .kicker, .decision-copy .kicker, .decision-copy .source-note { grid-column:auto; } }
        @media (prefers-reduced-motion:reduce) { * { scroll-behavior:auto !important; } }
      </style>
      <main class="commerce-deck">
        <nav class="deck-nav" aria-label="Deck navigation">
          <span class="brand">The Look / commerce</span>
          <span class="links"><a href="#slide-title">Cover</a><a href="#slide-kpis">Scorecard</a><a href="#slide-trend">Trend</a><a href="#slide-category">Category</a><a href="#slide-decisions">Decisions</a></span>
        </nav>

        <section id="slide-title" class="slide slide-title" aria-label="Title slide">
          <h-block name="slide_title" />
          <div class="title-mark" aria-hidden="true"></div>
        </section>

        <section id="slide-kpis" class="slide slide-kpis" aria-label="September KPI slide">
          <h-block name="slide_kpis" />
          <div class="kpi-grid">
            <div class="metric"><h-block name="completed_month_net_sales" /></div>
            <div class="metric"><h-block name="completed_month_gross_profit" /></div>
            <div class="metric"><h-block name="completed_month_gross_margin" /></div>
            <div class="metric"><h-block name="completed_month_fulfilled_orders" /></div>
            <div class="metric"><h-block name="completed_month_return_rate" /></div>
            <div class="metric"><h-block name="completed_month_sessions" /></div>
            <div class="metric"><h-block name="completed_month_purchase_conversion_rate" /></div>
          </div>
        </section>

        <section id="slide-trend" class="slide slide-trend" aria-label="Commerce trend slide">
          <h-block name="slide_trend" />
          <div class="trend-body"><h-block name="commerce_trend_13_complete_months" /></div>
        </section>

        <section id="slide-category" class="slide slide-category" aria-label="Category performance slide">
          <h-block name="slide_category" />
          <div class="category-grid">
            <div><h-block name="completed_month_category_net_sales_ranking" /></div>
            <div><h-block name="completed_month_category_quality" /></div>
          </div>
        </section>

        <section id="slide-decisions" class="slide slide-decisions" aria-label="Decision checklist slide">
          <h-block name="slide_decisions" />
        </section>
      </main>
    ;;
  }
}
