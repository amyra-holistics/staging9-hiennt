// Printable finance report on TheLook eCommerce.
// The canvas is 794 px wide (A4 at 96 dpi). Each page is 1123 px tall and starts at y = (page - 1) * 1123,
// with its own header (y + 24) and footer (y + 1063), so no block crosses a page boundary.

// Page header: report name, section and the reporting period (first and last order-item date under the period filter).
Func r05ca1_header(section: String) {
  VizBlock {
    label: 'Page Header'
    settings {
      hide_label: true
      hide_controls: true
    }
    viz: MarkdownViz {
      dataset: thelook
      calculation period_start {
        label: 'Period Start'
        formula: @aql min(thelook_order_items.created_at);;
        calc_type: 'measure'
        data_type: 'datetime'
      }
      calculation period_end {
        label: 'Period End'
        formula: @aql max(thelook_order_items.created_at);;
        calc_type: 'measure'
        data_type: 'datetime'
      }
      values: [
        VizFieldFull {
          ref: 'period_start'
          label: 'Period Start'
          format {
            type: 'datetime'
            pattern: 'dd LLL yyyy'
          }
        },
        VizFieldFull {
          ref: 'period_end'
          label: 'Period End'
          format {
            type: 'datetime'
            pattern: 'dd LLL yyyy'
          }
        }
      ]
      content: @md
        <div style="display: flex; justify-content: space-between; align-items: flex-end; border-bottom: 2px solid #1F2937; padding-bottom: 4px; font-size: 12px; color: #1F2937; white-space: nowrap;">
          <span><strong>TheLook eCommerce · Finance Report</strong> &nbsp;|&nbsp; ${section}</span>
          <span>Period: {{ rows[0].values.`Period Start`.formatted }} – {{ rows[0].values.`Period End`.formatted }}</span>
        </div>
      ;;
    }
  }
}

// Page footer: reporting period and page number.
Func r05ca1_footer(page: Number) {
  VizBlock {
    label: 'Page Footer'
    settings {
      hide_label: true
      hide_controls: true
    }
    viz: MarkdownViz {
      dataset: thelook
      calculation period_start {
        label: 'Period Start'
        formula: @aql min(thelook_order_items.created_at);;
        calc_type: 'measure'
        data_type: 'datetime'
      }
      calculation period_end {
        label: 'Period End'
        formula: @aql max(thelook_order_items.created_at);;
        calc_type: 'measure'
        data_type: 'datetime'
      }
      values: [
        VizFieldFull {
          ref: 'period_start'
          label: 'Period Start'
          format {
            type: 'datetime'
            pattern: 'dd LLL yyyy'
          }
        },
        VizFieldFull {
          ref: 'period_end'
          label: 'Period End'
          format {
            type: 'datetime'
            pattern: 'dd LLL yyyy'
          }
        }
      ]
      content: @md
        <div style="display: flex; justify-content: space-between; border-top: 1px solid #9CA3AF; padding-top: 4px; font-size: 11px; color: #4B5563; white-space: nowrap;">
          <span>Reporting period: {{ rows[0].values.`Period Start`.formatted }} – {{ rows[0].values.`Period End`.formatted }}</span>
          <span>Confidential · Finance</span>
          <span>Page ${page} of 5</span>
        </div>
      ;;
    }
  }
}

Func r05ca1_section_title(num: Number, heading: String, subtitle: String) {
  TextBlock {
    content: @md
      <div style="border-left: 6px solid #1F4E79; padding-left: 12px;">
        <div style="font-size: 12px; color: #6B7280; letter-spacing: 0.08em; text-transform: uppercase;">Section ${num}</div>
        <div style="font-size: 24px; font-weight: 700; color: #111827;">${heading}</div>
        <div style="font-size: 13px; color: #4B5563;">${subtitle}</div>
      </div>
    ;;
  }
}

Func r05ca1_dept_table(department: String) {
  VizBlock {
    label: '${department}: Net Sales, COGS and Gross Profit by Category'
    viz: PivotTable {
      dataset: thelook
      filter {
        field: r(thelook_products.department)
        operator: 'is'
        value: department
      }
      rows: [
        VizFieldFull {
          ref: r(thelook_products.category)
          label: 'Category'
        }
      ]
      values: [
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.cogs)
          label: 'COGS'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.gross_profit)
          label: 'Gross Profit'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.gross_margin)
          label: 'GM %'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        show_column_total: true
        show_row_total: false
        pagination_size: 100
        wrap_header_text: true
        sorts: [
          KeyBasedSortSetting {
            key: 'net_sales'
            direction: 'desc'
          }
        ]
      }
    }
  }
}

Func r05ca1_dept_chart(department: String) {
  VizBlock {
    label: '${department}: Gross Profit by Category'
    viz: BarChart {
      dataset: thelook
      filter {
        field: r(thelook_products.department)
        operator: 'is'
        value: department
      }
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Category'
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.gross_profit)
            label: 'Gross Profit'
            format {
              type: 'number'
              pattern: '[$$]#,###0,"K"'
            }
          }
          settings {
            color: '#2E7D5B'
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
        row_limit: 100
      }
    }
  }
}

Dashboard r05_claude_canvas_a1 {
  title: 'Finance Report: Net Sales, COGS & Gross Profit (Printable)'
  description: '''
Printable A4 finance report on TheLook eCommerce. Each 794 x 1123 px block of the canvas is one A4 page with its own header and footer.
Export with Export > PDF.
'''

  // ---------- Filter ----------
  block f_period: FilterBlock {
    label: 'Report Period (Order Item Created Date)'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
    default {
      operator: 'last'
      value: 1
      modifier: 'year'
    }
  }

  // ---------- Page headers & footers ----------
  block p1_header: r05ca1_header('Cover & Contents')
  block p1_footer: r05ca1_footer(1)
  block p2_header: r05ca1_header('Summary by Department')
  block p2_footer: r05ca1_footer(2)
  block p3_header: r05ca1_header('Men: Category Detail')
  block p3_footer: r05ca1_footer(3)
  block p4_header: r05ca1_header('Women: Category Detail')
  block p4_footer: r05ca1_footer(4)
  block p5_header: r05ca1_header('Metric Definitions')
  block p5_footer: r05ca1_footer(5)

  // ---------- Page 1: cover, headline KPIs, table of contents ----------
  block cover_title: TextBlock {
    content: @md
      <div style="padding-top: 8px;">
        <div style="font-size: 13px; color: #6B7280; letter-spacing: 0.1em; text-transform: uppercase;">TheLook eCommerce</div>
        <div style="font-size: 34px; font-weight: 700; color: #111827; line-height: 1.2;">Finance Report</div>
        <div style="font-size: 16px; color: #374151; margin-top: 6px;">Net Sales, COGS and Gross Profit by department and category</div>
        <div style="font-size: 12px; color: #6B7280; margin-top: 10px;">Select the reporting period below, then use <strong>Export → PDF</strong> to print. The period is shown in every page header and footer.</div>
      </div>
    ;;
  }
  block kpi_net_sales: VizBlock {
    label: 'Net Sales'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
        metric_value {
          font_size: 26
        }
      }
    }
  }
  block kpi_cogs: VizBlock {
    label: 'COGS'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.cogs)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
        metric_value {
          font_size: 26
        }
      }
    }
  }
  block kpi_gross_profit: VizBlock {
    label: 'Gross Profit'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_profit)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
        metric_value {
          font_size: 26
        }
      }
    }
  }
  block kpi_gross_margin: VizBlock {
    label: 'Gross Margin'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
        metric_value {
          font_size: 26
        }
      }
    }
  }

  block toc: TextBlock {
    content: @md
## Contents

| # | Section | Page |
|---|---------|-----:|
| 1 | [Summary by Department](#block-s1_title) | 2 |
| 2 | [Men: Net Sales, COGS & Gross Profit by Category](#block-s2_title) | 3 |
| 3 | [Women: Net Sales, COGS & Gross Profit by Category](#block-s3_title) | 4 |
| 4 | [Metric Definitions](#block-s4_title) | 5 |

All figures cover order items created in the selected reporting period. Cancelled and Returned items are excluded from Net Sales, COGS and Gross Profit.
    ;;
  }

  // ---------- Page 2: Section 1, summary by department ----------
  block s1_title: r05ca1_section_title(1, 'Summary by Department', 'Net Sales, COGS, Gross Profit and Gross Margin for each department')

  block s1_dept_table: VizBlock {
    label: 'Net Sales, COGS and Gross Profit by Department'
    viz: PivotTable {
      dataset: thelook
      rows: [
        VizFieldFull {
          ref: r(thelook_products.department)
          label: 'Department'
        }
      ]
      values: [
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.cogs)
          label: 'COGS'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.gross_profit)
          label: 'Gross Profit'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.gross_margin)
          label: 'Gross Margin'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        show_column_total: true
        show_row_total: false
        sorts: [
          KeyBasedSortSetting {
            key: 'net_sales'
            direction: 'desc'
          }
        ]
      }
    }
  }

  block s1_dept_chart: VizBlock {
    label: 'Net Sales vs COGS vs Gross Profit by Department'
    viz: ColumnChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.department)
        label: 'Department'
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#1F4E79'
          }
        }
        series {
          field: VizFieldFull {
            ref: r(thelook.cogs)
            label: 'COGS'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#B0B7C3'
          }
        }
        series {
          field: VizFieldFull {
            ref: r(thelook.gross_profit)
            label: 'Gross Profit'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#2E7D5B'
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      settings {
        row_limit: 100
      }
    }
  }

  block s1_note: TextBlock {
    content: @md
**Reading this section.** Gross Profit = Net Sales − COGS. Gross Margin is Gross Profit as a share of Net Sales. The totals row covers all departments.
Category detail for each department follows on the next pages: [Men](#block-s2_title) · [Women](#block-s3_title).
    ;;
  }

  // ---------- Page 3: Section 2, Men ----------
  block s2_title: r05ca1_section_title(2, 'Men: Category Detail', 'Net Sales, COGS and Gross Profit by product category, sorted by Net Sales')
  block s2_table: r05ca1_dept_table('Men')
  block s2_chart: r05ca1_dept_chart('Men')

  // ---------- Page 4: Section 3, Women ----------
  block s3_title: r05ca1_section_title(3, 'Women: Category Detail', 'Net Sales, COGS and Gross Profit by product category, sorted by Net Sales')
  block s3_table: r05ca1_dept_table('Women')
  block s3_chart: r05ca1_dept_chart('Women')

  // ---------- Page 5: Section 4, metric definitions ----------
  block s4_title: r05ca1_section_title(4, 'Metric Definitions', 'How each figure in this report is calculated')

  block s4_definitions: TextBlock {
    content: @md
| Metric | Definition | Calculation |
|--------|------------|-------------|
| **Net Sales** | Sale price of order items, excluding Cancelled and Returned items. | `sum(sale_price)` where status not in (Cancelled, Returned) |
| **COGS** | Cost of goods sold: the product cost of the order items counted in Net Sales. | `sum(product cost)` where status not in (Cancelled, Returned) |
| **Gross Profit** | What is left of Net Sales after product costs. | Net Sales − COGS |
| **Gross Margin (GM %)** | Gross Profit as a share of Net Sales. | Gross Profit ÷ Net Sales |

**Dimensions**

- **Department**: product department (Men, Women).
- **Category**: product category within a department.

**Reporting period**

- The period filters order items by their **created date**. The dates in every page header and footer are the first and last order-item dates inside the selected period.
- Order item statuses: Processing, Shipped, Complete, Cancelled, Returned. Processing, Shipped and Complete count toward Net Sales.

**Source**: TheLook eCommerce dataset (order items joined to products). Amounts are in USD.

[↑ Back to contents](#block-toc)
    ;;
  }

  view: CanvasLayout {
    label: 'A4 Report'
    width: 794
    height: 5615
    grid_size: 5
    default_zoom: 'fit_to_width'

    // Page 1 (y 0 – 1123)
    block p1_header {
      position: pos(40, 24, 714, 36)
    }
    block cover_title {
      position: pos(40, 90, 714, 150)
    }
    block f_period {
      position: pos(40, 250, 714, 80)
    }
    block kpi_net_sales {
      position: pos(40, 350, 168, 120)
    }
    block kpi_cogs {
      position: pos(222, 350, 168, 120)
    }
    block kpi_gross_profit {
      position: pos(404, 350, 168, 120)
    }
    block kpi_gross_margin {
      position: pos(586, 350, 168, 120)
    }
    block toc {
      position: pos(40, 500, 714, 330)
    }
    block p1_footer {
      position: pos(40, 1063, 714, 36)
    }

    // Page 2 (y 1123 – 2246)
    block p2_header {
      position: pos(40, 1147, 714, 36)
    }
    block s1_title {
      position: pos(40, 1203, 714, 80)
    }
    block s1_dept_table {
      position: pos(40, 1293, 714, 200)
    }
    block s1_dept_chart {
      position: pos(40, 1513, 714, 420)
    }
    block s1_note {
      position: pos(40, 1953, 714, 110)
    }
    block p2_footer {
      position: pos(40, 2186, 714, 36)
    }

    // Page 3 (y 2246 – 3369)
    block p3_header {
      position: pos(40, 2270, 714, 36)
    }
    block s2_title {
      position: pos(40, 2326, 714, 80)
    }
    block s2_table {
      position: pos(40, 2416, 470, 850)
    }
    block s2_chart {
      position: pos(524, 2416, 230, 850)
    }
    block p3_footer {
      position: pos(40, 3309, 714, 36)
    }

    // Page 4 (y 3369 – 4492)
    block p4_header {
      position: pos(40, 3393, 714, 36)
    }
    block s3_title {
      position: pos(40, 3449, 714, 80)
    }
    block s3_table {
      position: pos(40, 3539, 470, 850)
    }
    block s3_chart {
      position: pos(524, 3539, 230, 850)
    }
    block p4_footer {
      position: pos(40, 4432, 714, 36)
    }

    // Page 5 (y 4492 – 5615)
    block p5_header {
      position: pos(40, 4516, 714, 36)
    }
    block s4_title {
      position: pos(40, 4572, 714, 80)
    }
    block s4_definitions {
      position: pos(40, 4662, 714, 560)
    }
    block p5_footer {
      position: pos(40, 5555, 714, 36)
    }

    mobile {
      mode: 'auto'
    }
  }

  theme: H.themes.vanilla
}
