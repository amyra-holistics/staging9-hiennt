        show_column_total: true
        pagination_size: 100
        row_limit: 1000
        sorts: [IndexBasedSortSetting { field_index: 1, direction: 'desc' }]
      }
    }
    settings { hide_controls: true }
  }
  block ftr_4: TextBlock {
    content: @md <div style="font-size:11px;color:#718096;border-top:1px solid #CBD5E0;padding-top:6px">TheLook eCommerce · Finance Report · Confidential · <b>Page 4 of 6</b></div> ;;
  }
  block per_f_4: VizBlock {
    label: 'Period'
    viz: DataTable {
      dataset: thelook
      calculation period {
        label: 'Period'
        formula: @aql concat(date_format(min(thelook_order_items.created_at), "%b %d, %Y"), " – ", date_format(max(thelook_order_items.created_at), "%b %d, %Y")) ;;
        calc_type: 'measure'
        data_type: 'text'
      }
