        value: 'Women'
      }
      rows: [
        VizFieldFull { ref: r(thelook_products.category), format { type: 'text' } }
      ]
      values: [
        VizFieldFull { ref: r(thelook.net_sales) },
        VizFieldFull { ref: r(thelook.cogs) },
        VizFieldFull { ref: r(thelook.gross_profit) },
        VizFieldFull { ref: r(thelook.gross_margin) }
      ]
      settings {
