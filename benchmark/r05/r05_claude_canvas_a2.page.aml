      }
    }
    settings { hide_controls: true }
  }
  block ftr_3: TextBlock {
    content: @md <div style="font-size:11px;color:#718096;border-top:1px solid #CBD5E0;padding-top:6px">TheLook eCommerce · Finance Report · Confidential · <b>Page 3 of 6</b></div> ;;
  }
