  // ---------------------------------------------------------------------------
  // Page 6: Metric definitions
  // ---------------------------------------------------------------------------
  block hdr_6: TextBlock {
    content: @md <div style="font-size:12px;color:#4A5568;line-height:1.4"><b style="color:#1A202C">TheLook eCommerce · Finance Report</b><br/>Section 5 · Metric Definitions</div> ;;
  }
  block per_h_6: VizBlock {
    label: 'Period'
    viz: DataTable {
      dataset: thelook
      calculation period {
        label: 'Period'
        formula: @aql concat(date_format(min(thelook_order_items.created_at), "%b %d, %Y"), " – ", date_format(max(thelook_order_items.created_at), "%b %d, %Y")) ;;
        calc_type: 'measure'
        data_type: 'text'
      }
      fields: [VizFieldFull { ref: 'period', label: 'Period' }]
      settings { single_cell_display: 'normal' }
    }
    settings { hide_label: true, hide_controls: true }
  }
  block sec_definitions: TextBlock {
    content: @md
## 5. Metric Definitions

| Metric | Definition | Calculation |
|--------|------------|-------------|
| **Net Sales** | Sale price of order items, excluding Cancelled and Returned items. | `sum(order_items.sale_price)` where status not in (Cancelled, Returned) |
| **COGS** | Cost of goods sold: product cost of the order items counted in Net Sales. | `sum(products.cost)` over order items where status not in (Cancelled, Returned) |
| **Gross Profit** | What is left of Net Sales after COGS. | Net Sales − COGS |
| **Gross Margin** | Gross Profit as a share of Net Sales. | Gross Profit ÷ Net Sales |

### Dimensions

| Field | Definition |
|-------|------------|
| **Department** | Product department (Women, Men), from the product sold. |
| **Category** | Product category (for example Jeans, Outerwear & Coats), from the product sold. |

### Reporting basis

- **Period:** order items are assigned to the period by their created date (`order_items.created_at`). The period shown in the header and footer is the first to the last order item date within the selected **Reporting Period** filter. The default is the last full calendar year.
- **Status:** Processing, Shipped and Complete items count toward Net Sales and COGS. Cancelled and Returned items are excluded.
- **Currency:** USD. Amounts are rounded to whole dollars. Totals are calculated from the underlying data, not by adding up rounded rows.
- **Source:** TheLook eCommerce dataset (`thelook`).
    ;;
  }
  block ftr_6: TextBlock {
    content: @md <div style="font-size:11px;color:#718096;border-top:1px solid #CBD5E0;padding-top:6px">TheLook eCommerce · Finance Report · Confidential · <b>Page 6 of 6</b></div> ;;
  }
  block per_f_6: VizBlock {
    label: 'Period'
    viz: DataTable {
      dataset: thelook
      calculation period {
        label: 'Period'
        formula: @aql concat(date_format(min(thelook_order_items.created_at), "%b %d, %Y"), " – ", date_format(max(thelook_order_items.created_at), "%b %d, %Y")) ;;
        calc_type: 'measure'
        data_type: 'text'
      }
      fields: [VizFieldFull { ref: 'period', label: 'Period' }]
      settings { single_cell_display: 'normal' }
    }
    settings { hide_label: true, hide_controls: true }
  }

  // ---------------------------------------------------------------------------
  // Layout: 6 stacked A4 portrait pages, 795 x 1125 px each (1 : 1.415).
  // Page n starts at y = 1125 * (n - 1). Header at +30, body +100..+1035, footer at +1055.
  // ---------------------------------------------------------------------------
  view: CanvasLayout {
    label: 'A4 Report'
    width: 795
    height: 6750
    grid_size: 5
    default_zoom: 'fit_to_width'

    // Page 1 (y 0)
    block hdr_1 { position: pos(40, 30, 455, 50) }
    block per_h_1 { position: pos(505, 30, 250, 50) }
    block cover_title { position: pos(40, 110, 715, 150) }
    block f_period { position: pos(40, 280, 360, 80) }
    block kpi_net_sales { position: pos(40, 385, 166, 120) }
    block kpi_cogs { position: pos(223, 385, 166, 120) }
    block kpi_gross_profit { position: pos(406, 385, 166, 120) }
    block kpi_gross_margin { position: pos(589, 385, 166, 120) }
    block toc { position: pos(40, 535, 715, 420) }
    block ftr_1 { position: pos(40, 1055, 455, 40) }
    block per_f_1 { position: pos(505, 1055, 250, 40) }

    // Page 2 (y 1125)
    block hdr_2 { position: pos(40, 1155, 455, 50) }
    block per_h_2 { position: pos(505, 1155, 250, 50) }
    block sec_department { position: pos(40, 1225, 715, 90) }
    block dept_chart { position: pos(40, 1330, 715, 420) }
    block dept_table { position: pos(40, 1770, 715, 200) }
    block ftr_2 { position: pos(40, 2180, 455, 40) }
    block per_f_2 { position: pos(505, 2180, 250, 40) }

    // Page 3 (y 2250)
    block hdr_3 { position: pos(40, 2280, 455, 50) }
    block per_h_3 { position: pos(505, 2280, 250, 50) }
    block sec_category { position: pos(40, 2350, 715, 80) }
    block cat_table { position: pos(40, 2440, 715, 845) }
    block ftr_3 { position: pos(40, 3305, 455, 40) }
    block per_f_3 { position: pos(505, 3305, 250, 40) }

    // Page 4 (y 3375)
    block hdr_4 { position: pos(40, 3405, 455, 50) }
    block per_h_4 { position: pos(505, 3405, 250, 50) }
    block sec_women { position: pos(40, 3475, 715, 80) }
    block women_table { position: pos(40, 3565, 715, 720) }
    block ftr_4 { position: pos(40, 4430, 455, 40) }
    block per_f_4 { position: pos(505, 4430, 250, 40) }

    // Page 5 (y 4500)
    block hdr_5 { position: pos(40, 4530, 455, 50) }
    block per_h_5 { position: pos(505, 4530, 250, 50) }
    block sec_men { position: pos(40, 4600, 715, 80) }
    block men_table { position: pos(40, 4690, 715, 720) }
    block ftr_5 { position: pos(40, 5555, 455, 40) }
    block per_f_5 { position: pos(505, 5555, 250, 40) }

    // Page 6 (y 5625)
    block hdr_6 { position: pos(40, 5655, 455, 50) }
    block per_h_6 { position: pos(505, 5655, 250, 50) }
    block sec_definitions { position: pos(40, 5725, 715, 760) }
    block ftr_6 { position: pos(40, 6680, 455, 40) }
    block per_f_6 { position: pos(505, 6680, 250, 40) }

    mobile {
      mode: 'auto'
    }
  }

  theme: H.themes.vanilla
}
