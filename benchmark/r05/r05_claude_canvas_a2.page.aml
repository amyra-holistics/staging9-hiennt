Dashboard r05_claude_canvas_a2 {
  title: 'Finance Report: Net Sales, COGS & Gross Profit'
  description: '''
Printable finance report built on six A4 pages (795 x 1125 px each, portrait).
Every page has a header and footer showing the selected period.
Export: Export > PDF.
'''
  owner: 'thinh.nt@holistics.io'

  // ---------------------------------------------------------------------------
  // Period filter (drives every block, including the header/footer period)
  // ---------------------------------------------------------------------------
  block f_period: FilterBlock {
    label: 'Reporting Period (order item date)'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
    default {
      operator: 'matches'
      value: 'last 1 year'
    }
  }

  // ---------------------------------------------------------------------------
  // Page 1: Cover, KPIs and table of contents
  // ---------------------------------------------------------------------------
  block hdr_1: TextBlock {
    content: @md <div style="font-size:12px;color:#4A5568;line-height:1.4"><b style="color:#1A202C">TheLook eCommerce · Finance Report</b><br/>Cover & Summary</div> ;;
  }
  block per_h_1: VizBlock {
    label: 'Period'
    viz: DataTable {
      dataset: thelook
      calculation period {
        label: 'Period'
        formula: @aql concat(date_format(min(thelook_order_items.created_at), "%b %d, %Y"), " – ", date_format(max(thelook_order_items.created_at), "%b %d, %Y")) ;;
        calc_type: 'measure'
        data_type: 'text'
      }
      fields: [VizFieldFull { ref: 'period', label: 'Period' }]
      settings { single_cell_display: 'normal' }
    }
    settings { hide_label: true, hide_controls: true }
  }

  block cover_title: TextBlock {
    content: @md
<div style="border-left:6px solid #255DD4;padding-left:16px">
<div style="font-size:30px;font-weight:700;color:#1A202C;line-height:1.2">Finance Report</div>
<div style="font-size:18px;color:#2D3748;margin-top:4px">Net Sales, COGS and Gross Profit by Department and Category</div>
<div style="font-size:13px;color:#718096;margin-top:8px">TheLook eCommerce · Figures exclude Cancelled and Returned order items · Choose the period below, then use <b>Export → PDF</b> to print.</div>
</div>
    ;;
  }

  block kpi_net_sales: VizBlock {
    label: 'Net Sales'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull { ref: r(thelook.net_sales), label: 'Net Sales' }
      settings { display_mode: 'single', alignment: 'center' }
    }
    settings { hide_label: true, hide_controls: true }
  }
  block kpi_cogs: VizBlock {
    label: 'COGS'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull { ref: r(thelook.cogs), label: 'COGS' }
      settings { display_mode: 'single', alignment: 'center' }
    }
    settings { hide_label: true, hide_controls: true }
  }
  block kpi_gross_profit: VizBlock {
    label: 'Gross Profit'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull { ref: r(thelook.gross_profit), label: 'Gross Profit' }
      settings { display_mode: 'single', alignment: 'center' }
    }
    settings { hide_label: true, hide_controls: true }
  }
  block kpi_gross_margin: VizBlock {
    label: 'Gross Margin'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull { ref: r(thelook.gross_margin), label: 'Gross Margin' }
      settings { display_mode: 'single', alignment: 'center' }
    }
    settings { hide_label: true, hide_controls: true }
  }

  block toc: TextBlock {
    content: @md
## Table of Contents

| # | Section | Page |
|---|---------|------|
| 1 | [Summary by Department](#block-sec_department) | 2 |
| 2 | [Summary by Category](#block-sec_category) | 3 |
| 3 | [Women: Category Detail](#block-sec_women) | 4 |
| 4 | [Men: Category Detail](#block-sec_men) | 5 |
| 5 | [Metric Definitions](#block-sec_definitions) | 6 |

Every section starts on a new A4 page. The period in each page header and footer follows the **Reporting Period** filter above.
    ;;
  }
  block ftr_1: TextBlock {
    content: @md <div style="font-size:11px;color:#718096;border-top:1px solid #CBD5E0;padding-top:6px">TheLook eCommerce · Finance Report · Confidential · <b>Page 1 of 6</b></div> ;;
  }
  block per_f_1: VizBlock {
    label: 'Period'
    viz: DataTable {
      dataset: thelook
      calculation period {
        label: 'Period'
        formula: @aql concat(date_format(min(thelook_order_items.created_at), "%b %d, %Y"), " – ", date_format(max(thelook_order_items.created_at), "%b %d, %Y")) ;;
        calc_type: 'measure'
        data_type: 'text'
      }
      fields: [VizFieldFull { ref: 'period', label: 'Period' }]
      settings { single_cell_display: 'normal' }
    }
    settings { hide_label: true, hide_controls: true }
  }

  // ---------------------------------------------------------------------------
  // Page 2: By Department
  // ---------------------------------------------------------------------------
  block hdr_2: TextBlock {
    content: @md <div style="font-size:12px;color:#4A5568;line-height:1.4"><b style="color:#1A202C">TheLook eCommerce · Finance Report</b><br/>Section 1 · Summary by Department</div> ;;
  }
  block per_h_2: VizBlock {
    label: 'Period'
    viz: DataTable {
      dataset: thelook
      calculation period {
        label: 'Period'
        formula: @aql concat(date_format(min(thelook_order_items.created_at), "%b %d, %Y"), " – ", date_format(max(thelook_order_items.created_at), "%b %d, %Y")) ;;
        calc_type: 'measure'
        data_type: 'text'
      }
      fields: [VizFieldFull { ref: 'period', label: 'Period' }]
      settings { single_cell_display: 'normal' }
    }
    settings { hide_label: true, hide_controls: true }
  }
  block sec_department: TextBlock {
    content: @md
## 1. Summary by Department
Net Sales, COGS and Gross Profit for each product department. Gross Margin is Gross Profit as a share of Net Sales.
    ;;
  }
  block dept_chart: VizBlock {
    label: 'Net Sales, COGS and Gross Profit by Department'
    viz: ColumnChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.department)
        format { type: 'text' }
      }
      y_axis {
        series {
          field: VizFieldFull { ref: r(thelook.net_sales) }
          settings { color: '#255DD4' }
        }
        series {
          field: VizFieldFull { ref: r(thelook.cogs) }
          settings { color: '#A0AEC0' }
        }
        series {
          field: VizFieldFull { ref: r(thelook.gross_profit) }
          settings { color: '#18A59E' }
        }
        settings { show_data_label_by: 'value' }
      }
      settings {
        legend_label: 'bottom'
        row_limit: 100
      }
    }
    settings { hide_controls: true }
  }
  block dept_table: VizBlock {
    label: 'Department P&L'
    viz: PivotTable {
      dataset: thelook
      rows: [
        VizFieldFull { ref: r(thelook_products.department), format { type: 'text' } }
      ]
      values: [
        VizFieldFull { ref: r(thelook.net_sales) },
        VizFieldFull { ref: r(thelook.cogs) },
        VizFieldFull { ref: r(thelook.gross_profit) },
        VizFieldFull { ref: r(thelook.gross_margin) }
      ]
      settings {
        show_row_total: true
        show_column_total: true
        pagination_size: 100
        row_limit: 1000
        sorts: [IndexBasedSortSetting { field_index: 1, direction: 'desc' }]
      }
    }
    settings { hide_controls: true }
  }
  block ftr_2: TextBlock {
    content: @md <div style="font-size:11px;color:#718096;border-top:1px solid #CBD5E0;padding-top:6px">TheLook eCommerce · Finance Report · Confidential · <b>Page 2 of 6</b></div> ;;
  }
  block per_f_2: VizBlock {
    label: 'Period'
    viz: DataTable {
      dataset: thelook
      calculation period {
        label: 'Period'
        formula: @aql concat(date_format(min(thelook_order_items.created_at), "%b %d, %Y"), " – ", date_format(max(thelook_order_items.created_at), "%b %d, %Y")) ;;
        calc_type: 'measure'
        data_type: 'text'
      }
      fields: [VizFieldFull { ref: 'period', label: 'Period' }]
