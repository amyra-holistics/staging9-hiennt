      ]
      content: @md
<div style="display:flex;justify-content:space-between;border-top:1px solid #CBD5E1;padding-top:6px;font-size:11px;color:#64748B;"><span>Finance Report · Period {{ rows[0].values.`First Day` }} – {{ rows[0].values.`Last Day` }} · Net sales exclude Cancelled and Returned items</span><span>Page 6 of 6</span></div>
      ;;
    }
  }

  // ---------- Page 1: cover, KPIs, table of contents ----------
  block cover: TextBlock {
    content: @md
<div style="color:#1F2A44;">
<div style="font-size:12px;letter-spacing:2px;text-transform:uppercase;color:#0F766E;font-weight:600;">TheLook eCommerce · Finance</div>
<div style="font-size:34px;font-weight:700;line-height:1.15;margin-top:10px;">Net Sales, COGS &amp; Gross Profit</div>
<div style="font-size:16px;color:#475569;margin-top:10px;">Profitability by department and product category for the reporting period shown in the header. Change the period with the filter below, then use <b>Export › PDF</b> to print one A4 page per sheet.</div>
</div>
    ;;
  }

  block kpi_net_sales: VizBlock {
    label: 'Net Sales'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull { ref: r(thelook.net_sales), format { type: 'number', pattern: '[$$]#,###0' } }
      settings { display_mode: 'single', alignment: 'left', metric_value { font_size: 26, font_color: '#1F4E79' } }
    }
  }
  block kpi_cogs: VizBlock {
    label: 'COGS'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull { ref: r(thelook.cogs), format { type: 'number', pattern: '[$$]#,###0' } }
      settings { display_mode: 'single', alignment: 'left', metric_value { font_size: 26, font_color: '#64748B' } }
    }
  }
  block kpi_gross_profit: VizBlock {
    label: 'Gross Profit'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull { ref: r(thelook.gross_profit), format { type: 'number', pattern: '[$$]#,###0' } }
      settings { display_mode: 'single', alignment: 'left', metric_value { font_size: 26, font_color: '#0F766E' } }
    }
  }
  block kpi_gross_margin: VizBlock {
    label: 'Gross Margin'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull { ref: r(thelook.gross_margin), format { type: 'number', pattern: '#,###0.0%' } }
      settings { display_mode: 'single', alignment: 'left', metric_value { font_size: 26, font_color: '#1F2A44' } }
    }
  }

  block toc: TextBlock {
    content: @md
## Contents

| Section | Page |
|:--|--:|
| [1. Summary by Department](#block-s1_title): Net Sales, COGS and Gross Profit for Men and Women, plus the monthly trend | 2 |
| [2. Men: Category P&L](#block-s2_title): Net Sales, COGS, Gross Profit and Gross Margin for each Men's category | 3 |
| [3. Women: Category P&L](#block-s3_title): Net Sales, COGS, Gross Profit and Gross Margin for each Women's category | 4 |
| [4. Gross Profit Ranking](#block-s4_title): every category ranked by Gross Profit, split by department | 5 |
| [5. Metric Definitions](#block-s5_title): how each figure in this report is calculated | 6 |

<div style="font-size:12px;color:#64748B;margin-top:12px;">Section titles are links. All figures use the order date of each order item and exclude Cancelled and Returned items.</div>
    ;;
  }

  // ---------- Page 2: summary by department ----------
  block s1_title: TextBlock {
    content: @md
<div style="color:#1F2A44;"><div style="font-size:12px;letter-spacing:2px;text-transform:uppercase;color:#0F766E;font-weight:600;">Section 1</div><div style="font-size:24px;font-weight:700;margin-top:4px;">Summary by Department</div><div style="font-size:13px;color:#475569;margin-top:4px;">Net Sales, COGS and Gross Profit for each department, with the total for the period.</div></div>
    ;;
  }

  block dept_table: VizBlock {
    label: 'Department P&L'
    viz: PivotTable {
      dataset: thelook
      rows: [
        VizFieldFull { ref: r(thelook_products.department), label: 'Department', format { type: 'text' } }
      ]
      values: [
        VizFieldFull { ref: r(thelook.net_sales), format { type: 'number', pattern: '[$$]#,###0' } },
        VizFieldFull { ref: r(thelook.cogs), format { type: 'number', pattern: '[$$]#,###0' } },
        VizFieldFull { ref: r(thelook.gross_profit), format { type: 'number', pattern: '[$$]#,###0' } },
        VizFieldFull { ref: r(thelook.gross_margin), format { type: 'number', pattern: '#,###0.0%' } }
      ]
      settings {
        show_row_total: true
        show_column_total: true
        wrap_header_text: true
        pagination_size: 50
      }
    }
  }

  block dept_chart: VizBlock {
    label: 'Net Sales, COGS and Gross Profit by Department'
    viz: ColumnChart {
      dataset: thelook
      x_axis: VizFieldFull { ref: r(thelook_products.department), label: 'Department', format { type: 'text' } }
      y_axis {
        label: 'Amount'
        series {
          field: VizFieldFull { ref: r(thelook.net_sales), format { type: 'number', pattern: '[$$]#,###0' } }
          settings { color: '#1F4E79' }
        }
        series {
          field: VizFieldFull { ref: r(thelook.cogs), format { type: 'number', pattern: '[$$]#,###0' } }
          settings { color: '#A7B4C6' }
        }
        series {
          field: VizFieldFull { ref: r(thelook.gross_profit), format { type: 'number', pattern: '[$$]#,###0' } }
          settings { color: '#0F766E' }
        }
        settings { show_data_label_by: 'value' }
      }
      settings { legend_label: 'top', row_limit: 100 }
    }
  }

  block monthly_chart: VizBlock {
    label: 'Monthly Net Sales and Gross Profit'
    viz: ColumnChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        label: 'Month'
        transformation: 'datetrunc month'
        format { type: 'date', pattern: 'LLL yyyy' }
      }
      y_axis {
        label: 'Amount'
        series {
          field: VizFieldFull { ref: r(thelook.net_sales), format { type: 'number', pattern: '[$$]#,###0' } }
          settings { color: '#1F4E79' }
        }
        series {
          field: VizFieldFull { ref: r(thelook.gross_profit), format { type: 'number', pattern: '[$$]#,###0' } }
          settings { color: '#0F766E' }
        }
      }
      settings {
        legend_label: 'top'
        row_limit: 100
        sort: LineFamilySort { type: 'xaxis', direction: 'asc' }
      }
    }
  }

  // ---------- Page 3: Men category P&L ----------
  block s2_title: TextBlock {
    content: @md
<div style="color:#1F2A44;"><div style="font-size:12px;letter-spacing:2px;text-transform:uppercase;color:#0F766E;font-weight:600;">Section 2</div><div style="font-size:24px;font-weight:700;margin-top:4px;">Men: Category P&amp;L</div><div style="font-size:13px;color:#475569;margin-top:4px;">Categories in the Men department, sorted by Net Sales. The last row is the department total.</div></div>
    ;;
  }

  block men_table: VizBlock {
    label: 'Men: Net Sales, COGS and Gross Profit by Category'
    viz: PivotTable {
      dataset: thelook
      rows: [
        VizFieldFull { ref: r(thelook_products.category), label: 'Category', format { type: 'text' } }
      ]
      values: [
        VizFieldFull { ref: r(thelook.net_sales), format { type: 'number', pattern: '[$$]#,###0' } },
        VizFieldFull { ref: r(thelook.cogs), format { type: 'number', pattern: '[$$]#,###0' } },
        VizFieldFull { ref: r(thelook.gross_profit), format { type: 'number', pattern: '[$$]#,###0' } },
        VizFieldFull { ref: r(thelook.gross_margin), format { type: 'number', pattern: '#,###0.0%' } }
      ]
      filter {
        field: r(thelook_products.department)
        operator: 'is'
        value: 'Men'
      }
      settings {
        show_row_total: true
        show_column_total: true
        wrap_header_text: true
        pagination_size: 50
        sorts: [
          IndexBasedSortSetting { field_index: 1, direction: 'desc' }
        ]
      }
    }
  }

  // ---------- Page 4: Women category P&L ----------
  block s3_title: TextBlock {
    content: @md
<div style="color:#1F2A44;"><div style="font-size:12px;letter-spacing:2px;text-transform:uppercase;color:#0F766E;font-weight:600;">Section 3</div><div style="font-size:24px;font-weight:700;margin-top:4px;">Women: Category P&amp;L</div><div style="font-size:13px;color:#475569;margin-top:4px;">Categories in the Women department, sorted by Net Sales. The last row is the department total.</div></div>
    ;;
  }

  block women_table: VizBlock {
    label: 'Women: Net Sales, COGS and Gross Profit by Category'
    viz: PivotTable {
      dataset: thelook
      rows: [
        VizFieldFull { ref: r(thelook_products.category), label: 'Category', format { type: 'text' } }
      ]
      values: [
        VizFieldFull { ref: r(thelook.net_sales), format { type: 'number', pattern: '[$$]#,###0' } },
        VizFieldFull { ref: r(thelook.cogs), format { type: 'number', pattern: '[$$]#,###0' } },
        VizFieldFull { ref: r(thelook.gross_profit), format { type: 'number', pattern: '[$$]#,###0' } },
        VizFieldFull { ref: r(thelook.gross_margin), format { type: 'number', pattern: '#,###0.0%' } }
      ]
      filter {
        field: r(thelook_products.department)
        operator: 'is'
        value: 'Women'
      }
      settings {
        show_row_total: true
        show_column_total: true
        wrap_header_text: true
        pagination_size: 50
        sorts: [
          IndexBasedSortSetting { field_index: 1, direction: 'desc' }
        ]
      }
    }
  }

  // ---------- Page 5: gross profit ranking ----------
  block s4_title: TextBlock {
    content: @md
<div style="color:#1F2A44;"><div style="font-size:12px;letter-spacing:2px;text-transform:uppercase;color:#0F766E;font-weight:600;">Section 4</div><div style="font-size:24px;font-weight:700;margin-top:4px;">Gross Profit Ranking</div><div style="font-size:13px;color:#475569;margin-top:4px;">Every category ranked by Gross Profit, colored by department.</div></div>
    ;;
  }

  block gp_ranking: VizBlock {
    label: 'Gross Profit by Category and Department'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull { ref: r(thelook_products.category), label: 'Category', format { type: 'text' } }
      legend: VizFieldFull { ref: r(thelook_products.department), label: 'Department', format { type: 'text' } }
      y_axis {
        label: 'Gross Profit'
        series {
          field: VizFieldFull { ref: r(thelook.gross_profit), format { type: 'number', pattern: '[$$]#,###0' } }
          settings {
            point { value: 'Men', color: '#1F4E79' }
            point { value: 'Women', color: '#0F766E' }
          }
        }
        settings { stack_series_by: 'value', show_stack_total: true }
      }
      settings {
        legend_label: 'top'
        row_limit: 200
        sort: LineFamilySort { type: 'yaxis', direction: 'desc' }
      }
    }
  }

  // ---------- Page 6: metric definitions ----------
  block s5_title: TextBlock {
    content: @md
<div style="color:#1F2A44;"><div style="font-size:12px;letter-spacing:2px;text-transform:uppercase;color:#0F766E;font-weight:600;">Section 5</div><div style="font-size:24px;font-weight:700;margin-top:4px;">Metric Definitions</div><div style="font-size:13px;color:#475569;margin-top:4px;">How each figure in this report is calculated in the TheLook eCommerce dataset.</div></div>
    ;;
  }

  block definitions: TextBlock {
    content: @md
| Metric | Definition | Calculation |
|:--|:--|:--|
| **Net Sales** | Sale price of order items, excluding Cancelled and Returned items. | Sum of `sale_price` where item status is not Cancelled or Returned |
| **COGS** | Product cost of the order items counted in Net Sales. | Sum of product `cost` for the same items as Net Sales |
| **Gross Profit** | What is left from Net Sales after product cost. | Net Sales − COGS |
| **Gross Margin** | Gross Profit as a share of Net Sales. | Gross Profit ÷ Net Sales |

### Dimensions and scope

- **Department**: product department (Men, Women) from the Products table.
- **Category**: product category from the Products table. Each category belongs to one department.
- **Reporting period**: the order date (`created_at`) of each order item. The header and footer show the first and last order date in the selected period.
- **Status filter**: items with status Cancelled or Returned are excluded from Net Sales, COGS and Gross Profit. Processing, Shipped and Complete items are included.
- **Totals**: department and report totals are calculated from the underlying items, not by adding up rounded rows. Gross Margin totals are recalculated, not averaged.
- **Currency**: amounts are in US dollars and rounded to the nearest dollar.
    ;;
  }

  // ---------- Layout: six A4 sheets, 840 x 1188 each ----------
  view: CanvasLayout {
    label: 'A4 Report'
    width: 840
    height: 7128
    grid_size: 10
    default_zoom: 'fit_to_width'

    // Page 1 (y 0 - 1188)
    block hdr_p1 { position: pos(40, 20, 760, 50) }
    block cover { position: pos(40, 110, 760, 200) }
    block f_period { position: pos(40, 320, 370, 80) }
    block kpi_net_sales { position: pos(40, 420, 175, 120) }
    block kpi_cogs { position: pos(235, 420, 175, 120) }
    block kpi_gross_profit { position: pos(430, 420, 175, 120) }
    block kpi_gross_margin { position: pos(625, 420, 175, 120) }
    block toc { position: pos(40, 580, 760, 440) }
    block ftr_p1 { position: pos(40, 1128, 760, 40) }

    // Page 2 (y 1188 - 2376)
    block hdr_p2 { position: pos(40, 1208, 760, 50) }
    block s1_title { position: pos(40, 1278, 760, 90) }
    block dept_table { position: pos(40, 1378, 760, 170) }
    block dept_chart { position: pos(40, 1568, 760, 380) }
    block monthly_chart { position: pos(40, 1968, 760, 330) }
    block ftr_p2 { position: pos(40, 2316, 760, 40) }

    // Page 3 (y 2376 - 3564)
    block hdr_p3 { position: pos(40, 2396, 760, 50) }
    block s2_title { position: pos(40, 2466, 760, 90) }
    block men_table { position: pos(40, 2566, 760, 920) }
    block ftr_p3 { position: pos(40, 3504, 760, 40) }

    // Page 4 (y 3564 - 4752)
    block hdr_p4 { position: pos(40, 3584, 760, 50) }
    block s3_title { position: pos(40, 3654, 760, 90) }
    block women_table { position: pos(40, 3754, 760, 920) }
    block ftr_p4 { position: pos(40, 4692, 760, 40) }

    // Page 5 (y 4752 - 5940)
    block hdr_p5 { position: pos(40, 4772, 760, 50) }
    block s4_title { position: pos(40, 4842, 760, 90) }
    block gp_ranking { position: pos(40, 4942, 760, 920) }
    block ftr_p5 { position: pos(40, 5880, 760, 40) }

    // Page 6 (y 5940 - 7128)
    block hdr_p6 { position: pos(40, 5960, 760, 50) }
    block s5_title { position: pos(40, 6030, 760, 90) }
    block definitions { position: pos(40, 6130, 760, 700) }
    block ftr_p6 { position: pos(40, 7068, 760, 40) }

    mobile {
      mode: 'auto'
    }
  }

  theme: PageTheme {
    title: 'A4 Finance Report'
    background { bg_color: '#E2E8F0' }
    canvas {
      background { bg_color: '#FFFFFF' }
      border { border_width: 0 }
      shadow: 'none'
    }
    block {
      label { font_size: 13, font_color: '#1F2A44', font_weight: 'semibold' }
      text { font_size: 13, font_color: '#1F2A44' }
      border { border_width: 0 }
      background { bg_color: '#FFFFFF' }
      padding: 6
      shadow: 'none'
    }
    viz {
      table {
        general { font_size: 12, banding_color: '#F8FAFC', border_color: '#CBD5E1' }
        header { bg_color: '#1F2A44', font_color: '#FFFFFF', font_weight: 'semibold', font_size: 12 }
      }
    }
    custom_css: @css
@page { size: A4 portrait; margin: 0; }
@media print {
  body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
}
    ;;
  }
}
