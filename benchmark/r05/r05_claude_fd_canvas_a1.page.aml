      calculation last_day { label: 'Last Day', formula: @aql max(thelook_order_items.created_at);;, calc_type: 'measure', data_type: 'datetime' }
      values: [
        VizFieldFull { ref: 'first_day', label: 'First Day', format { type: 'date', pattern: 'LLL dd, yyyy' } },
        VizFieldFull { ref: 'last_day', label: 'Last Day', format { type: 'date', pattern: 'LLL dd, yyyy' } }
      ]
      content: @md
<div style="display:flex;justify-content:space-between;align-items:flex-end;border-bottom:2px solid #1F2A44;padding-bottom:6px;font-size:12px;color:#1F2A44;"><span><b>TheLook eCommerce · Finance Report</b> · 4. Gross Profit Ranking</span><span>Period: <b>{{ rows[0].values.`First Day` }} – {{ rows[0].values.`Last Day` }}</b></span></div>
      ;;
    }
  }
  block hdr_p6: VizBlock {
    label: 'Header'
    settings { hide_label: true, hide_controls: true }
    viz: MarkdownViz {
      dataset: thelook
      calculation first_day { label: 'First Day', formula: @aql min(thelook_order_items.created_at);;, calc_type: 'measure', data_type: 'datetime' }
      calculation last_day { label: 'Last Day', formula: @aql max(thelook_order_items.created_at);;, calc_type: 'measure', data_type: 'datetime' }
      values: [
        VizFieldFull { ref: 'first_day', label: 'First Day', format { type: 'date', pattern: 'LLL dd, yyyy' } },
        VizFieldFull { ref: 'last_day', label: 'Last Day', format { type: 'date', pattern: 'LLL dd, yyyy' } }
      ]
      content: @md
<div style="display:flex;justify-content:space-between;align-items:flex-end;border-bottom:2px solid #1F2A44;padding-bottom:6px;font-size:12px;color:#1F2A44;"><span><b>TheLook eCommerce · Finance Report</b> · 5. Metric Definitions</span><span>Period: <b>{{ rows[0].values.`First Day` }} – {{ rows[0].values.`Last Day` }}</b></span></div>
      ;;
    }
  }

  // ---------- Page footers (show the period and page number) ----------
  block ftr_p1: VizBlock {
    label: 'Footer'
    settings { hide_label: true, hide_controls: true }
    viz: MarkdownViz {
      dataset: thelook
      calculation first_day { label: 'First Day', formula: @aql min(thelook_order_items.created_at);;, calc_type: 'measure', data_type: 'datetime' }
      calculation last_day { label: 'Last Day', formula: @aql max(thelook_order_items.created_at);;, calc_type: 'measure', data_type: 'datetime' }
      values: [
        VizFieldFull { ref: 'first_day', label: 'First Day', format { type: 'date', pattern: 'LLL dd, yyyy' } },
        VizFieldFull { ref: 'last_day', label: 'Last Day', format { type: 'date', pattern: 'LLL dd, yyyy' } }
      ]
      content: @md
<div style="display:flex;justify-content:space-between;border-top:1px solid #CBD5E1;padding-top:6px;font-size:11px;color:#64748B;"><span>Finance Report · Period {{ rows[0].values.`First Day` }} – {{ rows[0].values.`Last Day` }} · Net sales exclude Cancelled and Returned items</span><span>Page 1 of 6</span></div>
      ;;
    }
  }
  block ftr_p2: VizBlock {
    label: 'Footer'
    settings { hide_label: true, hide_controls: true }
    viz: MarkdownViz {
      dataset: thelook
      calculation first_day { label: 'First Day', formula: @aql min(thelook_order_items.created_at);;, calc_type: 'measure', data_type: 'datetime' }
      calculation last_day { label: 'Last Day', formula: @aql max(thelook_order_items.created_at);;, calc_type: 'measure', data_type: 'datetime' }
      values: [
        VizFieldFull { ref: 'first_day', label: 'First Day', format { type: 'date', pattern: 'LLL dd, yyyy' } },
        VizFieldFull { ref: 'last_day', label: 'Last Day', format { type: 'date', pattern: 'LLL dd, yyyy' } }
      ]
      content: @md
<div style="display:flex;justify-content:space-between;border-top:1px solid #CBD5E1;padding-top:6px;font-size:11px;color:#64748B;"><span>Finance Report · Period {{ rows[0].values.`First Day` }} – {{ rows[0].values.`Last Day` }} · Net sales exclude Cancelled and Returned items</span><span>Page 2 of 6</span></div>
