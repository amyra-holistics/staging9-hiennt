// Printable finance report on a Canvas layout.
// The canvas is 840px wide and split into six 840 x 1188px sheets (A4 portrait ratio, 1 : 1.414),
// so every sheet maps to one A4 page when exported to PDF. No block crosses a sheet boundary.
// Sheet N starts at y = (N - 1) * 1188; header at +20, content from +90, footer at +1128.

Dashboard r05_claude_fd_canvas_a1 {
  title: 'TheLook Finance Report: Net Sales, COGS & Gross Profit'
  description: 'Printable A4 finance report. Net Sales, COGS and Gross Profit by department and category for the selected order period. Export via Export > PDF.'

  // ---------- Filter ----------
  block f_period: FilterBlock {
    label: 'Reporting period (order date)'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
    default {
      operator: 'matches'
      value: 'this year'
    }
  }

  // ---------- Page headers (show the period) ----------
  block hdr_p1: VizBlock {
    label: 'Header'
    settings { hide_label: true, hide_controls: true }
    viz: MarkdownViz {
      dataset: thelook
      calculation first_day { label: 'First Day', formula: @aql min(thelook_order_items.created_at);;, calc_type: 'measure', data_type: 'datetime' }
      calculation last_day { label: 'Last Day', formula: @aql max(thelook_order_items.created_at);;, calc_type: 'measure', data_type: 'datetime' }
      values: [
        VizFieldFull { ref: 'first_day', label: 'First Day', format { type: 'date', pattern: 'LLL dd, yyyy' } },
        VizFieldFull { ref: 'last_day', label: 'Last Day', format { type: 'date', pattern: 'LLL dd, yyyy' } }
      ]
      content: @md
<div style="display:flex;justify-content:space-between;align-items:flex-end;border-bottom:2px solid #1F2A44;padding-bottom:6px;font-size:12px;color:#1F2A44;"><span><b>TheLook eCommerce · Finance Report</b> · Cover &amp; Contents</span><span>Period: <b>{{ rows[0].values.`First Day` }} – {{ rows[0].values.`Last Day` }}</b></span></div>
      ;;
    }
  }
  block hdr_p2: VizBlock {
    label: 'Header'
    settings { hide_label: true, hide_controls: true }
    viz: MarkdownViz {
      dataset: thelook
      calculation first_day { label: 'First Day', formula: @aql min(thelook_order_items.created_at);;, calc_type: 'measure', data_type: 'datetime' }
      calculation last_day { label: 'Last Day', formula: @aql max(thelook_order_items.created_at);;, calc_type: 'measure', data_type: 'datetime' }
      values: [
        VizFieldFull { ref: 'first_day', label: 'First Day', format { type: 'date', pattern: 'LLL dd, yyyy' } },
        VizFieldFull { ref: 'last_day', label: 'Last Day', format { type: 'date', pattern: 'LLL dd, yyyy' } }
      ]
      content: @md
<div style="display:flex;justify-content:space-between;align-items:flex-end;border-bottom:2px solid #1F2A44;padding-bottom:6px;font-size:12px;color:#1F2A44;"><span><b>TheLook eCommerce · Finance Report</b> · 1. Summary by Department</span><span>Period: <b>{{ rows[0].values.`First Day` }} – {{ rows[0].values.`Last Day` }}</b></span></div>
      ;;
    }
  }
  block hdr_p3: VizBlock {
    label: 'Header'
    settings { hide_label: true, hide_controls: true }
    viz: MarkdownViz {
      dataset: thelook
      calculation first_day { label: 'First Day', formula: @aql min(thelook_order_items.created_at);;, calc_type: 'measure', data_type: 'datetime' }
      calculation last_day { label: 'Last Day', formula: @aql max(thelook_order_items.created_at);;, calc_type: 'measure', data_type: 'datetime' }
      values: [
        VizFieldFull { ref: 'first_day', label: 'First Day', format { type: 'date', pattern: 'LLL dd, yyyy' } },
        VizFieldFull { ref: 'last_day', label: 'Last Day', format { type: 'date', pattern: 'LLL dd, yyyy' } }
      ]
      content: @md
<div style="display:flex;justify-content:space-between;align-items:flex-end;border-bottom:2px solid #1F2A44;padding-bottom:6px;font-size:12px;color:#1F2A44;"><span><b>TheLook eCommerce · Finance Report</b> · 2. Men: Category P&amp;L</span><span>Period: <b>{{ rows[0].values.`First Day` }} – {{ rows[0].values.`Last Day` }}</b></span></div>
      ;;
    }
  }
  block hdr_p4: VizBlock {
    label: 'Header'
    settings { hide_label: true, hide_controls: true }
    viz: MarkdownViz {
      dataset: thelook
      calculation first_day { label: 'First Day', formula: @aql min(thelook_order_items.created_at);;, calc_type: 'measure', data_type: 'datetime' }
      calculation last_day { label: 'Last Day', formula: @aql max(thelook_order_items.created_at);;, calc_type: 'measure', data_type: 'datetime' }
      values: [
        VizFieldFull { ref: 'first_day', label: 'First Day', format { type: 'date', pattern: 'LLL dd, yyyy' } },
        VizFieldFull { ref: 'last_day', label: 'Last Day', format { type: 'date', pattern: 'LLL dd, yyyy' } }
      ]
      content: @md
<div style="display:flex;justify-content:space-between;align-items:flex-end;border-bottom:2px solid #1F2A44;padding-bottom:6px;font-size:12px;color:#1F2A44;"><span><b>TheLook eCommerce · Finance Report</b> · 3. Women: Category P&amp;L</span><span>Period: <b>{{ rows[0].values.`First Day` }} – {{ rows[0].values.`Last Day` }}</b></span></div>
      ;;
