<div style="display:flex;justify-content:space-between;align-items:flex-end;border-bottom:1.5px solid #1F2A44;padding-bottom:6px;font-size:11px;color:#1F2A44;letter-spacing:0.02em"><span><b>TheLook eCommerce</b> &nbsp;·&nbsp; Finance Report</span><span>Period: <b>{{ rows[0].values.`Period Start`.formatted }} – {{ rows[0].values.`Period End`.formatted }}</b></span></div>
      ;;
