  theme: PageTheme {
    background { bg_color: '#E9ECEF' }
    canvas {
      background { bg_color: '#FFFFFF' }
      border { border_width: 0 }
      shadow: 'none'
    }
    block {
      border { border_width: 0 }
      background { bg_color: 'transparent' }
      padding: 4
      label { font_size: 13, font_weight: 'semibold', font_color: '#1F2A44' }
    }
    viz {
      table {
        general { font_size: 12, font_color: '#212529', banding_color: '#F5F7FA', border_color: '#DEE2E6' }
        header { bg_color: '#1F2A44', font_color: '#FFFFFF', font_weight: 'semibold', font_size: 12 }
      }
    }
  }
}
