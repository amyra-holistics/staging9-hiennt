// Printable finance report on a Canvas layout.
// Each page is one A4 portrait sheet at 96 dpi (794 x 1123 px), stacked vertically.
// Page N starts at y = (N - 1) * 1123; every block sits 30+ px inside its page edges,
// so a PDF export that slices the canvas at A4 height never cuts through a block.

Dashboard r05_claude_fd_canvas_a2 {
  title: 'Finance Report: Net Sales, COGS & Gross Profit'
  description: 'Printable A4 finance report by department and category. Set the period with the Order Date filter, then use Export > PDF.'

  // ---------- Period filter (applies to every block) ----------
  block f_period: FilterBlock {
    label: 'Reporting period (order date)'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: ref('thelook_order_items', 'created_at')
    }
    default {
      operator: 'last'
      value: 1
      modifier: 'year'
      options {
        include_current_period: false
      }
    }
  }

  // ---------- Page headers (report name + period) ----------
  block hdr_p1: VizBlock {
    label: 'Header'
    settings { hide_label: true, hide_controls: true }
    viz: MarkdownViz {
      dataset: thelook
      calculation period_start {
        label: 'Period Start'
        formula: @aql min(thelook_order_items.created_at) ;;
        calc_type: 'measure'
        data_type: 'datetime'
      }
      calculation period_end {
        label: 'Period End'
        formula: @aql max(thelook_order_items.created_at) ;;
        calc_type: 'measure'
        data_type: 'datetime'
      }
      values: [
        VizFieldFull { ref: 'period_start', label: 'Period Start', format { type: 'datetime', pattern: 'dd LLL yyyy' } },
        VizFieldFull { ref: 'period_end', label: 'Period End', format { type: 'datetime', pattern: 'dd LLL yyyy' } }
      ]
      content: @md
<div style="display:flex;justify-content:space-between;align-items:flex-end;border-bottom:1.5px solid #1F2A44;padding-bottom:6px;font-size:11px;color:#1F2A44;letter-spacing:0.02em"><span><b>TheLook eCommerce</b> &nbsp;·&nbsp; Finance Report</span><span>Period: <b>{{ rows[0].values.`Period Start`.formatted }} – {{ rows[0].values.`Period End`.formatted }}</b></span></div>
      ;;
    }
  }
  block hdr_p2: VizBlock {
    label: 'Header'
    settings { hide_label: true, hide_controls: true }
    viz: MarkdownViz {
      dataset: thelook
      calculation period_start {
        label: 'Period Start'
        formula: @aql min(thelook_order_items.created_at) ;;
        calc_type: 'measure'
        data_type: 'datetime'
      }
      calculation period_end {
        label: 'Period End'
        formula: @aql max(thelook_order_items.created_at) ;;
        calc_type: 'measure'
        data_type: 'datetime'
      }
      values: [
        VizFieldFull { ref: 'period_start', label: 'Period Start', format { type: 'datetime', pattern: 'dd LLL yyyy' } },
        VizFieldFull { ref: 'period_end', label: 'Period End', format { type: 'datetime', pattern: 'dd LLL yyyy' } }
      ]
      content: @md
<div style="display:flex;justify-content:space-between;align-items:flex-end;border-bottom:1.5px solid #1F2A44;padding-bottom:6px;font-size:11px;color:#1F2A44;letter-spacing:0.02em"><span><b>TheLook eCommerce</b> &nbsp;·&nbsp; Finance Report</span><span>Period: <b>{{ rows[0].values.`Period Start`.formatted }} – {{ rows[0].values.`Period End`.formatted }}</b></span></div>
      ;;
    }
  }
