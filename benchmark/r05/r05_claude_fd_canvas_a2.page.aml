  // ---------- Page 1: cover, KPIs, table of contents ----------
  block cover_title: TextBlock {
    content: @md
<div style="color:#1F2A44">
<div style="font-size:12px;letter-spacing:0.14em;text-transform:uppercase;color:#6C757D">Finance Report</div>
<div style="font-size:30px;font-weight:700;line-height:1.2;margin-top:6px">Net Sales, COGS &amp; Gross Profit</div>
<div style="font-size:14px;margin-top:8px;color:#495057">By department and product category. All figures exclude Cancelled and Returned order items.</div>
</div>
    ;;
  }

  block kpi_net_sales: VizBlock {
    label: 'Net Sales'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        format { type: 'number', pattern: 'inherited' }
      }
      settings { display_mode: 'single', alignment: 'left', metric_value { font_size: 26 } }
    }
  }
  block kpi_cogs: VizBlock {
    label: 'COGS'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.cogs)
        format { type: 'number', pattern: 'inherited' }
      }
      settings { display_mode: 'single', alignment: 'left', metric_value { font_size: 26 } }
    }
  }
  block kpi_gross_profit: VizBlock {
    label: 'Gross Profit'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_profit)
        format { type: 'number', pattern: 'inherited' }
      }
      settings { display_mode: 'single', alignment: 'left', metric_value { font_size: 26 } }
    }
  }
  block kpi_gross_margin: VizBlock {
    label: 'Gross Margin'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        format { type: 'number', pattern: 'inherited' }
      }
      settings { display_mode: 'single', alignment: 'left', metric_value { font_size: 26 } }
    }
  }

  block toc: TextBlock {
    content: @md
<div style="color:#1F2A44">
<div style="font-size:18px;font-weight:700;border-bottom:1.5px solid #1F2A44;padding-bottom:6px;margin-bottom:10px">Contents</div>

| # | Section | Page |
|---|---|---|
| 1 | [Summary by department](#block-sec_department) | 2 |
| 2 | [Women: results by category](#block-sec_women) | 3 |
| 3 | [Men: results by category](#block-sec_men) | 4 |
| 4 | [Metric definitions](#block-sec_definitions) | 5 |

</div>
    ;;
  }

  // ---------- Page 2: summary by department ----------
  block sec_department: TextBlock {
    content: @md
<div style="color:#1F2A44"><div style="font-size:12px;letter-spacing:0.14em;text-transform:uppercase;color:#6C757D">Section 1</div><div style="font-size:22px;font-weight:700">Summary by department</div></div>
    ;;
  }

  block t_department: VizBlock {
    label: 'Net Sales, COGS and Gross Profit by Department'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull { label: 'Department', ref: r(thelook_products.department), format { type: 'text' } },
        VizFieldFull { label: 'Net Sales', ref: r(thelook.net_sales), format { type: 'number', pattern: 'inherited' } },
        VizFieldFull { label: 'COGS', ref: r(thelook.cogs), format { type: 'number', pattern: 'inherited' } },
        VizFieldFull { label: 'Gross Profit', ref: r(thelook.gross_profit), format { type: 'number', pattern: 'inherited' } },
        VizFieldFull { label: 'Gross Margin', ref: r(thelook.gross_margin), format { type: 'number', pattern: 'inherited' } }
      ]
      settings {
        pagination_size: 25
        show_row_number: false
        show_sum_row: true
        sorts: [
          IndexBasedSortSetting { field_index: 1, direction: 'desc' }
        ]
      }
    }
  }

  block c_department: VizBlock {
    label: 'Net Sales vs COGS vs Gross Profit by Department'
    viz: ColumnChart {
      dataset: thelook
      x_axis: VizFieldFull {
        label: 'Department'
        ref: r(thelook_products.department)
        format { type: 'text' }
      }
      y_axis {
        label: 'Amount'
        series {
          field: VizFieldFull { label: 'Net Sales', ref: r(thelook.net_sales), format { type: 'number', pattern: 'inherited' } }
          settings { color: '#1F3A5F' }
        }
        series {
          field: VizFieldFull { label: 'COGS', ref: r(thelook.cogs), format { type: 'number', pattern: 'inherited' } }
          settings { color: '#A7B1BF' }
        }
        series {
          field: VizFieldFull { label: 'Gross Profit', ref: r(thelook.gross_profit), format { type: 'number', pattern: 'inherited' } }
          settings { color: '#2A9D8F' }
        }
        settings { show_data_label_by: 'value' }
      }
      settings {
        row_limit: 50
      }
    }
  }

  // ---------- Page 3: Women by category ----------
  block sec_women: TextBlock {
    content: @md
<div style="color:#1F2A44"><div style="font-size:12px;letter-spacing:0.14em;text-transform:uppercase;color:#6C757D">Section 2</div><div style="font-size:22px;font-weight:700">Women: results by category</div></div>
    ;;
  }

  block t_women: VizBlock {
    label: 'Women: Net Sales, COGS and Gross Profit by Category'
    viz: DataTable {
      dataset: thelook
      filter {
        field: r(thelook_products.department)
        operator: 'is'
        value: 'Women'
      }
      fields: [
        VizFieldFull { label: 'Category', ref: r(thelook_products.category), format { type: 'text' } },
        VizFieldFull { label: 'Net Sales', ref: r(thelook.net_sales), format { type: 'number', pattern: 'inherited' } },
        VizFieldFull { label: 'COGS', ref: r(thelook.cogs), format { type: 'number', pattern: 'inherited' } },
        VizFieldFull { label: 'Gross Profit', ref: r(thelook.gross_profit), format { type: 'number', pattern: 'inherited' } },
        VizFieldFull { label: 'Gross Margin', ref: r(thelook.gross_margin), format { type: 'number', pattern: 'inherited' } }
      ]
      settings {
        pagination_size: 50
        show_row_number: false
        show_sum_row: true
        sorts: [
          IndexBasedSortSetting { field_index: 1, direction: 'desc' }
        ]
      }
    }
  }

  // ---------- Page 4: Men by category ----------
  block sec_men: TextBlock {
    content: @md
<div style="color:#1F2A44"><div style="font-size:12px;letter-spacing:0.14em;text-transform:uppercase;color:#6C757D">Section 3</div><div style="font-size:22px;font-weight:700">Men: results by category</div></div>
    ;;
  }

  block t_men: VizBlock {
    label: 'Men: Net Sales, COGS and Gross Profit by Category'
    viz: DataTable {
      dataset: thelook
      filter {
        field: r(thelook_products.department)
        operator: 'is'
        value: 'Men'
      }
      fields: [
        VizFieldFull { label: 'Category', ref: r(thelook_products.category), format { type: 'text' } },
        VizFieldFull { label: 'Net Sales', ref: r(thelook.net_sales), format { type: 'number', pattern: 'inherited' } },
        VizFieldFull { label: 'COGS', ref: r(thelook.cogs), format { type: 'number', pattern: 'inherited' } },
        VizFieldFull { label: 'Gross Profit', ref: r(thelook.gross_profit), format { type: 'number', pattern: 'inherited' } },
        VizFieldFull { label: 'Gross Margin', ref: r(thelook.gross_margin), format { type: 'number', pattern: 'inherited' } }
      ]
      settings {
        pagination_size: 50
        show_row_number: false
        show_sum_row: true
        sorts: [
          IndexBasedSortSetting { field_index: 1, direction: 'desc' }
        ]
      }
    }
  }

  // ---------- Page 5: metric definitions ----------
  block sec_definitions: TextBlock {
    content: @md
<div style="color:#1F2A44"><div style="font-size:12px;letter-spacing:0.14em;text-transform:uppercase;color:#6C757D">Section 4</div><div style="font-size:22px;font-weight:700">Metric definitions</div></div>
    ;;
  }

  block definitions: TextBlock {
    content: @md
<div style="color:#212529;font-size:13px;line-height:1.55">

| Metric | Definition | Calculation |
|---|---|---|
| **Net Sales** | Sale price of order items, excluding Cancelled and Returned items. | `sum(sale_price)` where item status is not Cancelled or Returned |
| **COGS** | Cost of goods sold: the product cost of the order items counted in Net Sales. | `sum(product cost)` over the same items as Net Sales |
| **Gross Profit** | What is left of Net Sales after product costs. | Net Sales − COGS |
| **Gross Margin** | Gross Profit as a share of Net Sales. | Gross Profit ÷ Net Sales |

**Dimensions**

- **Department**: the product's department (Men or Women).
- **Category**: the product's category within its department, e.g. Jeans or Outerwear &amp; Coats.

**Reporting period**

- Items are assigned to the period by the order item's **created date** (Order Date filter on page 1).
- The header and footer show the first and last order date found in the selected period.
- By default the report covers the last full calendar year.

**Notes**

- Items with status Processing, Shipped and Complete are included. Cancelled and Returned items are excluded from every figure.
- Headline figures on page 1 cover both departments; section tables break the same figures down by department and category.
- Source: TheLook eCommerce dataset (`thelook`).

</div>
    ;;
  }

  // ---------- Layout: 5 stacked A4 portrait pages (794 x 1123 px each) ----------
  view: CanvasLayout {
    label: 'A4 Report'
    width: 794
    height: 5615
    grid_size: 5
    default_zoom: 'fit_to_width'

    // Page 1 (y 0 - 1123)
    block hdr_p1 { position: pos(40, 30, 714, 40) }
    block cover_title { position: pos(40, 95, 714, 150) }
    block f_period { position: pos(40, 260, 350, 80) }
    block kpi_net_sales { position: pos(40, 365, 168, 115) }
    block kpi_cogs { position: pos(222, 365, 168, 115) }
    block kpi_gross_profit { position: pos(404, 365, 168, 115) }
    block kpi_gross_margin { position: pos(586, 365, 168, 115) }
    block toc { position: pos(40, 520, 714, 300) }
    block ftr_p1 { position: pos(40, 1053, 714, 40) }

    // Page 2 (y 1123 - 2246)
    block hdr_p2 { position: pos(40, 1153, 714, 40) }
    block sec_department { position: pos(40, 1213, 714, 75) }
    block t_department { position: pos(40, 1300, 714, 190) }
    block c_department { position: pos(40, 1515, 714, 420) }
