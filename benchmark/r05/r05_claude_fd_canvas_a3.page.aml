          }
        },
        VizFieldFull {
          ref: 'period_end'
          label: 'Period End'
          format {
            type: 'datetime'
            pattern: 'dd LLL yyyy'
          }
        }
      ]
      content: @md
<div style="display:flex;justify-content:space-between;align-items:flex-end;border-bottom:2px solid #1E3A5F;padding-bottom:6px;font-size:11px;color:#374151;">
  <span><b style="color:#1E3A5F;letter-spacing:0.08em;">THELOOK ECOMMERCE</b> &nbsp;·&nbsp; Finance Report</span>
  <span>Period: <b>{{ rows[0].values.`Period Start` }} – {{ rows[0].values.`Period End` }}</b></span>
</div>
      ;;
    }
    settings {
      hide_label: true
      hide_controls: true
    }
    theme {
      padding: 0
    }
  }

  block sec_men: TextBlock {
    content: @md
<div style="font-size:22px;font-weight:700;color:#111827;">2. Men: by category</div>
<div style="font-size:12px;color:#4B5563;margin-top:4px;">Net Sales, COGS and Gross Profit for each Men's category, largest Net Sales first. The Total row is the department total.</div>
    ;;
    settings {
      hide_controls: true
    }
  }

  block men_table: VizBlock {
    label: 'Men: Net Sales, COGS and Gross Profit by category'
    viz: PivotTable {
      dataset: thelook
      rows: [
        VizFieldFull {
          ref: r(thelook_products.category)
          label: 'Category'
          format {
            type: 'text'
          }
        }
      ]
      values: [
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.cogs)
          label: 'COGS'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.gross_profit)
          label: 'Gross Profit'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.gross_margin)
          label: 'Gross Margin'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      conditions: [
        "thelook_products.department == 'Men'"
      ]
      settings {
        pagination_size: 50
        show_row_total: false
        show_column_total: true
        show_sub_total: false
        value_labels_position {
          placement: 'columns'
          order: 'last'
        }
        sorts: [
          IndexBasedSortSetting {
            field_index: 1
            direction: 'desc'
          }
        ]
      }
    }
    settings {
      hide_label: true
      hide_controls: true
    }
  }

  block p3_footer: VizBlock {
    label: 'Footer'
    viz: MarkdownViz {
      dataset: thelook
      calculation period_start {
        label: 'Period Start'
        formula: @aql thelook_order_items | min(thelook_order_items.created_at);;
        calc_type: 'measure'
        data_type: 'datetime'
      }
      calculation period_end {
        label: 'Period End'
        formula: @aql thelook_order_items | max(thelook_order_items.created_at);;
        calc_type: 'measure'
        data_type: 'datetime'
      }
      values: [
        VizFieldFull {
          ref: 'period_start'
          label: 'Period Start'
          format {
            type: 'datetime'
            pattern: 'dd LLL yyyy'
          }
        },
        VizFieldFull {
          ref: 'period_end'
          label: 'Period End'
