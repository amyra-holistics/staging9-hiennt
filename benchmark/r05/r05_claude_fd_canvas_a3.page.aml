  block sec_women: TextBlock {
    content: @md
<div style="font-size:22px;font-weight:700;color:#111827;">3. Women: by category</div>
<div style="font-size:12px;color:#4B5563;margin-top:4px;">Net Sales, COGS and Gross Profit for each Women's category, largest Net Sales first. The Total row is the department total.</div>
    ;;
    settings {
