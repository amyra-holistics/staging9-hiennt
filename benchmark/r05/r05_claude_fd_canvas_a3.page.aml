    viz: MarkdownViz {
      dataset: thelook
      calculation period_start {
        label: 'Period Start'
        formula: @aql thelook_order_items | min(thelook_order_items.created_at);;
        calc_type: 'measure'
        data_type: 'datetime'
      }
      calculation period_end {
        label: 'Period End'
        formula: @aql thelook_order_items | max(thelook_order_items.created_at);;
        calc_type: 'measure'
        data_type: 'datetime'
      }
      values: [
        VizFieldFull {
          ref: 'period_start'
          label: 'Period Start'
          format {
            type: 'datetime'
            pattern: 'dd LLL yyyy'
          }
        },
        VizFieldFull {
          ref: 'period_end'
          label: 'Period End'
          format {
            type: 'datetime'
            pattern: 'dd LLL yyyy'
          }
        }
      ]
      content: @md
<div style="display:flex;justify-content:space-between;border-top:1px solid #D1D5DB;padding-top:6px;font-size:10px;color:#6B7280;">
  <span>Finance Report · Period {{ rows[0].values.`Period Start` }} – {{ rows[0].values.`Period End` }}</span>
  <span>Page 4 of 5</span>
</div>
      ;;
    }
    settings {
      hide_label: true
      hide_controls: true
    }
    theme {
      padding: 0
    }
  }

  // ---------------------------------------------------------------- Page 5: metric definitions
  block p5_header: VizBlock {
    label: 'Header'
    viz: MarkdownViz {
      dataset: thelook
      calculation period_start {
        label: 'Period Start'
        formula: @aql thelook_order_items | min(thelook_order_items.created_at);;
        calc_type: 'measure'
        data_type: 'datetime'
      }
      calculation period_end {
        label: 'Period End'
        formula: @aql thelook_order_items | max(thelook_order_items.created_at);;
        calc_type: 'measure'
        data_type: 'datetime'
      }
      values: [
        VizFieldFull {
          ref: 'period_start'
          label: 'Period Start'
          format {
            type: 'datetime'
            pattern: 'dd LLL yyyy'
          }
        },
        VizFieldFull {
          ref: 'period_end'
          label: 'Period End'
          format {
            type: 'datetime'
            pattern: 'dd LLL yyyy'
          }
        }
      ]
      content: @md
<div style="display:flex;justify-content:space-between;align-items:flex-end;border-bottom:2px solid #1E3A5F;padding-bottom:6px;font-size:11px;color:#374151;">
  <span><b style="color:#1E3A5F;letter-spacing:0.08em;">THELOOK ECOMMERCE</b> &nbsp;·&nbsp; Finance Report</span>
  <span>Period: <b>{{ rows[0].values.`Period Start` }} – {{ rows[0].values.`Period End` }}</b></span>
</div>
      ;;
    }
    settings {
      hide_label: true
      hide_controls: true
    }
    theme {
      padding: 0
    }
  }

  block definitions: TextBlock {
    content: @md
<div style="font-size:22px;font-weight:700;color:#111827;margin-bottom:14px;">4. Metric definitions</div>

| Metric | Definition | Calculation |
|:--|:--|:--|
| **Net Sales** | Sale price of order items, excluding Cancelled and Returned items. | Sum of order item sale price where status is not Cancelled or Returned |
| **COGS** | Cost of goods sold: product cost of the order items counted in Net Sales. | Sum of product cost where status is not Cancelled or Returned |
| **Gross Profit** | What remains of Net Sales after COGS. | Net Sales − COGS |
| **Gross Margin** | Gross Profit as a share of Net Sales. | Gross Profit ÷ Net Sales (blank when Net Sales is 0) |

<div style="font-size:15px;font-weight:700;color:#111827;margin-top:22px;margin-bottom:8px;">Dimensions and conventions</div>

| Term | Meaning |
|:--|:--|
| **Reporting period** | Order item created date within the period selected on page 1. The header and footer show the first and last order dates found in that period. |
| **Department** | Product department (Men, Women). |
| **Category** | Product category within a department. |
| **Total row** | Metric recalculated over all rows in the table (margins are recalculated, not summed). |
| **Currency** | USD, rounded to the nearest dollar. |

<div style="font-size:11px;color:#6B7280;margin-top:18px;">Source: TheLook eCommerce dataset. Metric definitions come from the dataset's governed metrics, so figures match other reports built on it.</div>
    ;;
    settings {
      hide_controls: true
    }
  }

  block p5_footer: VizBlock {
    label: 'Footer'
    viz: MarkdownViz {
      dataset: thelook
      calculation period_start {
        label: 'Period Start'
        formula: @aql thelook_order_items | min(thelook_order_items.created_at);;
        calc_type: 'measure'
        data_type: 'datetime'
      }
      calculation period_end {
        label: 'Period End'
        formula: @aql thelook_order_items | max(thelook_order_items.created_at);;
        calc_type: 'measure'
        data_type: 'datetime'
      }
      values: [
        VizFieldFull {
          ref: 'period_start'
          label: 'Period Start'
          format {
            type: 'datetime'
            pattern: 'dd LLL yyyy'
          }
        },
        VizFieldFull {
          ref: 'period_end'
          label: 'Period End'
          format {
            type: 'datetime'
            pattern: 'dd LLL yyyy'
          }
        }
      ]
      content: @md
<div style="display:flex;justify-content:space-between;border-top:1px solid #D1D5DB;padding-top:6px;font-size:10px;color:#6B7280;">
  <span>Finance Report · Period {{ rows[0].values.`Period Start` }} – {{ rows[0].values.`Period End` }}</span>
  <span>Page 5 of 5</span>
</div>
      ;;
    }
    settings {
      hide_label: true
      hide_controls: true
    }
    theme {
      padding: 0
    }
  }

  // ---------------------------------------------------------------- Layout: 5 x A4 portrait (794 x 1123 px)
  view: CanvasLayout {
    label: 'A4 report'
    width: 794
    height: 5615
    grid_size: 5
    auto_expand_vertically: false
    default_zoom: 'fit_to_width'

    // Page 1 (y 0 - 1123)
    block p1_header {
      position: pos(40, 30, 714, 40)
    }
    block p1_title {
      position: pos(40, 90, 714, 180)
    }
    block f_period {
      position: pos(40, 290, 360, 80)
    }
    block p1_scope {
      position: pos(420, 295, 334, 70)
    }
    block kpi_net_sales {
      position: pos(40, 390, 168, 110)
    }
    block kpi_cogs {
      position: pos(222, 390, 168, 110)
    }
    block kpi_gross_profit {
      position: pos(404, 390, 168, 110)
    }
    block kpi_gross_margin {
      position: pos(586, 390, 168, 110)
    }
    block toc {
      position: pos(40, 530, 714, 440)
    }
    block p1_footer {
      position: pos(40, 1063, 714, 36)
    }

    // Page 2 (y 1123 - 2246)
    block p2_header {
      position: pos(40, 1153, 714, 40)
    }
    block sec_department {
      position: pos(40, 1213, 714, 70)
    }
    block dept_table {
      position: pos(40, 1293, 714, 170)
    }
    block dept_composition {
      position: pos(40, 1478, 714, 250)
    }
    block dept_trend {
      position: pos(40, 1743, 714, 420)
    }
    block p2_footer {
      position: pos(40, 2186, 714, 36)
    }

    // Page 3 (y 2246 - 3369)
    block p3_header {
      position: pos(40, 2276, 714, 40)
    }
    block sec_men {
      position: pos(40, 2336, 714, 70)
    }
    block men_table {
      position: pos(40, 2416, 714, 620)
    }
    block p3_footer {
      position: pos(40, 3309, 714, 36)
    }

    // Page 4 (y 3369 - 4492)
    block p4_header {
      position: pos(40, 3399, 714, 40)
    }
    block sec_women {
      position: pos(40, 3459, 714, 70)
    }
    block women_table {
      position: pos(40, 3539, 714, 880)
    }
    block p4_footer {
      position: pos(40, 4432, 714, 36)
    }

    // Page 5 (y 4492 - 5615)
    block p5_header {
      position: pos(40, 4522, 714, 40)
    }
    block definitions {
      position: pos(40, 4582, 714, 800)
    }
    block p5_footer {
      position: pos(40, 5555, 714, 36)
    }

    mobile {
      mode: 'auto'
    }
  }

  theme: PageTheme {
    background {
      bg_color: '#FFFFFF'
    }
    canvas {
      background {
        bg_color: '#FFFFFF'
      }
      border {
        border_width: 0
      }
      shadow: 'none'
    }
    block {
      border {
        border_width: 0
      }
      background {
        bg_color: '#FFFFFF'
      }
      label {
        font_size: 12
        font_weight: 'semibold'
        font_color: '#1E3A5F'
      }
      text {
        font_color: '#111827'
      }
      padding: 8
      shadow: 'none'
    }
    viz {
      table {
        general {
          font_size: 12
          banding_color: '#F9FAFB'
          border_color: '#E5E7EB'
        }
        header {
          bg_color: '#1E3A5F'
          font_color: '#FFFFFF'
          font_weight: 'semibold'
        }
      }
    }
    custom_css: @css
      @page { size: A4 portrait; margin: 0; }
      @media print {
        * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      }
    ;;
  }
}
