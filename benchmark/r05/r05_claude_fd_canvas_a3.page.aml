// Printable finance report (A4 portrait).
// Each A4 page is 794 x 1123 px (210 x 297 mm at 96 dpi). Pages are stacked vertically on the
// canvas; no block crosses a page boundary (y = 1123, 2246, 3369, 4492), so pages break cleanly on export.
//   Page 1  Cover, period filter, headline KPIs, table of contents
//   Page 2  1. Department summary
//   Page 3  2. Men - categories
//   Page 4  3. Women - categories
//   Page 5  Metric definitions
Dashboard r05_claude_fd_canvas_a3 {
  title: 'Finance Report: Net Sales, COGS & Gross Profit'
  description: 'Printable A4 finance report of Net Sales, COGS and Gross Profit by department and category. Use Export > PDF.'

  // ---------------------------------------------------------------- Filter
  block f_period: FilterBlock {
    label: 'Reporting period (order item date)'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
    default {
      operator: 'last'
      value: '12'
      modifier: 'month'
    }
  }

  // ---------------------------------------------------------------- Page 1: cover
  block p1_header: VizBlock {
    label: 'Header'
    viz: MarkdownViz {
      dataset: thelook
      calculation period_start {
        label: 'Period Start'
        formula: @aql thelook_order_items | min(thelook_order_items.created_at);;
        calc_type: 'measure'
        data_type: 'datetime'
      }
      calculation period_end {
        label: 'Period End'
        formula: @aql thelook_order_items | max(thelook_order_items.created_at);;
        calc_type: 'measure'
        data_type: 'datetime'
      }
      values: [
        VizFieldFull {
          ref: 'period_start'
          label: 'Period Start'
          format {
            type: 'datetime'
            pattern: 'dd LLL yyyy'
          }
        },
        VizFieldFull {
          ref: 'period_end'
          label: 'Period End'
          format {
            type: 'datetime'
            pattern: 'dd LLL yyyy'
          }
        }
      ]
      content: @md
<div style="display:flex;justify-content:space-between;align-items:flex-end;border-bottom:2px solid #1E3A5F;padding-bottom:6px;font-size:11px;color:#374151;">
  <span><b style="color:#1E3A5F;letter-spacing:0.08em;">THELOOK ECOMMERCE</b> &nbsp;·&nbsp; Finance Report</span>
  <span>Period: <b>{{ rows[0].values.`Period Start` }} – {{ rows[0].values.`Period End` }}</b></span>
</div>
      ;;
    }
    settings {
      hide_label: true
      hide_controls: true
    }
    theme {
      padding: 0
    }
  }

  block p1_title: TextBlock {
    content: @md
<div style="padding-top:24px;">
<div style="font-size:12px;letter-spacing:0.14em;color:#0F766E;font-weight:600;">FINANCE REPORT</div>
<div style="font-size:34px;font-weight:700;color:#111827;line-height:1.15;margin-top:6px;">Net Sales, COGS &amp; Gross Profit</div>
<div style="font-size:14px;color:#4B5563;margin-top:10px;">By department and product category. Figures follow the reporting period selected below and shown in every page header and footer.</div>
</div>
    ;;
    settings {
      hide_controls: true
    }
  }

  block p1_scope: TextBlock {
    content: @md
<div style="font-size:11px;color:#4B5563;line-height:1.5;border-left:3px solid #0F766E;padding-left:10px;">
<b>Scope.</b> Order items dated within the reporting period. Cancelled and Returned items are excluded from Net Sales, COGS and Gross Profit. Amounts in USD.
</div>
    ;;
    settings {
      hide_controls: true
    }
  }

  block kpi_net_sales: VizBlock {
    label: 'Net Sales'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
        metric_value {
          font_size: 26
          font_color: '#111827'
        }
      }
    }
    settings {
      hide_controls: true
    }
  }

  block kpi_cogs: VizBlock {
    label: 'COGS'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.cogs)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
        metric_value {
          font_size: 26
          font_color: '#6B7280'
        }
      }
    }
    settings {
      hide_controls: true
    }
  }

  block kpi_gross_profit: VizBlock {
    label: 'Gross Profit'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_profit)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
        metric_value {
          font_size: 26
          font_color: '#0F766E'
        }
      }
    }
    settings {
      hide_controls: true
    }
  }

  block kpi_gross_margin: VizBlock {
    label: 'Gross Margin'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
        metric_value {
          font_size: 26
          font_color: '#0F766E'
        }
      }
    }
    settings {
      hide_controls: true
    }
  }

  block toc: TextBlock {
    content: @md
<div style="font-size:12px;letter-spacing:0.14em;color:#0F766E;font-weight:600;margin-bottom:10px;">CONTENTS</div>

| Section | | Page |
|:--|:--|--:|
| **1** | [Department summary](#block-sec_department) | 2 |
| **2** | [Men: Net Sales, COGS and Gross Profit by category](#block-sec_men) | 3 |
| **3** | [Women: Net Sales, COGS and Gross Profit by category](#block-sec_women) | 4 |
| **4** | [Metric definitions](#block-definitions) | 5 |

<div style="font-size:11px;color:#6B7280;margin-top:14px;">To print or save this report, use <b>Export → PDF</b> on the dashboard. Each section starts on a new A4 page.</div>
    ;;
    settings {
      hide_controls: true
    }
  }

  block p1_footer: VizBlock {
    label: 'Footer'
    viz: MarkdownViz {
      dataset: thelook
      calculation period_start {
        label: 'Period Start'
        formula: @aql thelook_order_items | min(thelook_order_items.created_at);;
        calc_type: 'measure'
        data_type: 'datetime'
      }
      calculation period_end {
        label: 'Period End'
        formula: @aql thelook_order_items | max(thelook_order_items.created_at);;
        calc_type: 'measure'
        data_type: 'datetime'
      }
      values: [
        VizFieldFull {
          ref: 'period_start'
          label: 'Period Start'
          format {
            type: 'datetime'
            pattern: 'dd LLL yyyy'
          }
        },
        VizFieldFull {
          ref: 'period_end'
          label: 'Period End'
          format {
            type: 'datetime'
            pattern: 'dd LLL yyyy'
          }
        }
      ]
      content: @md
<div style="display:flex;justify-content:space-between;border-top:1px solid #D1D5DB;padding-top:6px;font-size:10px;color:#6B7280;">
  <span>Finance Report · Period {{ rows[0].values.`Period Start` }} – {{ rows[0].values.`Period End` }}</span>
  <span>Page 1 of 5</span>
</div>
      ;;
    }
    settings {
      hide_label: true
      hide_controls: true
    }
    theme {
      padding: 0
    }
  }

  // ---------------------------------------------------------------- Page 2: department summary
  block p2_header: VizBlock {
    label: 'Header'
    viz: MarkdownViz {
      dataset: thelook
      calculation period_start {
        label: 'Period Start'
        formula: @aql thelook_order_items | min(thelook_order_items.created_at);;
        calc_type: 'measure'
        data_type: 'datetime'
      }
      calculation period_end {
        label: 'Period End'
        formula: @aql thelook_order_items | max(thelook_order_items.created_at);;
        calc_type: 'measure'
        data_type: 'datetime'
      }
      values: [
        VizFieldFull {
          ref: 'period_start'
          label: 'Period Start'
          format {
            type: 'datetime'
            pattern: 'dd LLL yyyy'
          }
        },
        VizFieldFull {
          ref: 'period_end'
          label: 'Period End'
          format {
            type: 'datetime'
            pattern: 'dd LLL yyyy'
          }
        }
      ]
      content: @md
<div style="display:flex;justify-content:space-between;align-items:flex-end;border-bottom:2px solid #1E3A5F;padding-bottom:6px;font-size:11px;color:#374151;">
  <span><b style="color:#1E3A5F;letter-spacing:0.08em;">THELOOK ECOMMERCE</b> &nbsp;·&nbsp; Finance Report</span>
  <span>Period: <b>{{ rows[0].values.`Period Start` }} – {{ rows[0].values.`Period End` }}</b></span>
</div>
      ;;
    }
    settings {
      hide_label: true
      hide_controls: true
    }
    theme {
      padding: 0
    }
  }

  block sec_department: TextBlock {
    content: @md
<div style="font-size:22px;font-weight:700;color:#111827;">1. Department summary</div>
<div style="font-size:12px;color:#4B5563;margin-top:4px;">Net Sales split into COGS and Gross Profit for each department, with the monthly Gross Profit trend.</div>
    ;;
    settings {
      hide_controls: true
    }
  }

  block dept_table: VizBlock {
    label: 'Net Sales, COGS and Gross Profit by department'
    viz: PivotTable {
      dataset: thelook
      rows: [
        VizFieldFull {
          ref: r(thelook_products.department)
          label: 'Department'
          format {
            type: 'text'
          }
        }
      ]
      values: [
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.cogs)
          label: 'COGS'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.gross_profit)
          label: 'Gross Profit'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.gross_margin)
          label: 'Gross Margin'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        pagination_size: 50
        show_row_total: false
        show_column_total: true
        show_sub_total: false
        value_labels_position {
          placement: 'columns'
          order: 'last'
        }
        sorts: [
          IndexBasedSortSetting {
            field_index: 1
            direction: 'desc'
          }
        ]
      }
    }
    settings {
      hide_controls: true
    }
  }

  block dept_composition: VizBlock {
    label: 'Net Sales composition: COGS + Gross Profit'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.department)
        label: 'Department'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.cogs)
            label: 'COGS'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#9CA3AF'
          }
        }
        series {
          field: VizFieldFull {
            ref: r(thelook.gross_profit)
            label: 'Gross Profit'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#0F766E'
          }
        }
        settings {
          stack_series_by: 'value'
          show_data_label_by: 'value'
          show_stack_total: true
        }
      }
      settings {
        legend_label: 'top'
      }
    }
    settings {
      hide_controls: true
    }
  }

  block dept_trend: VizBlock {
    label: 'Monthly Gross Profit by department'
    viz: ColumnChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        label: 'Month'
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      legend: VizFieldFull {
        ref: r(thelook_products.department)
        label: 'Department'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.gross_profit)
            label: 'Gross Profit'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            point {
              value: 'Men'
              color: '#1E3A5F'
            }
            point {
              value: 'Women'
              color: '#C2410C'
            }
          }
        }
        settings {
          stack_series_by: 'value'
        }
      }
      settings {
        legend_label: 'top'
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
    settings {
      hide_controls: true
    }
  }

  block p2_footer: VizBlock {
    label: 'Footer'
    viz: MarkdownViz {
      dataset: thelook
      calculation period_start {
        label: 'Period Start'
        formula: @aql thelook_order_items | min(thelook_order_items.created_at);;
        calc_type: 'measure'
        data_type: 'datetime'
      }
      calculation period_end {
        label: 'Period End'
        formula: @aql thelook_order_items | max(thelook_order_items.created_at);;
        calc_type: 'measure'
        data_type: 'datetime'
      }
      values: [
        VizFieldFull {
          ref: 'period_start'
          label: 'Period Start'
          format {
            type: 'datetime'
            pattern: 'dd LLL yyyy'
          }
        },
        VizFieldFull {
          ref: 'period_end'
          label: 'Period End'
          format {
            type: 'datetime'
            pattern: 'dd LLL yyyy'
          }
        }
      ]
      content: @md
<div style="display:flex;justify-content:space-between;border-top:1px solid #D1D5DB;padding-top:6px;font-size:10px;color:#6B7280;">
  <span>Finance Report · Period {{ rows[0].values.`Period Start` }} – {{ rows[0].values.`Period End` }}</span>
  <span>Page 2 of 5</span>
</div>
      ;;
    }
    settings {
      hide_label: true
      hide_controls: true
    }
    theme {
      padding: 0
    }
  }

  // ---------------------------------------------------------------- Page 3: Men categories
  block p3_header: VizBlock {
    label: 'Header'
    viz: MarkdownViz {
      dataset: thelook
      calculation period_start {
        label: 'Period Start'
        formula: @aql thelook_order_items | min(thelook_order_items.created_at);;
