// benchmark/r05/r05_hai_canvas_a3.page.aml
Dashboard r05_hai_canvas_a3 {
  title: 'Printable Finance Report'
  description: '''
Printable A4-oriented finance report for TheLook eCommerce. Use the Report Period
control before exporting the dashboard as a PDF.
'''
  theme: H.themes.classic

  settings {
    timezone: 'Etc/UTC'
    autorun_on_open: true
    autorun_on_changes: true
    cache_duration: 60
  }

  // ---------------------------------------------------------------------------
  // PAGE 1 — COVER, REPORT PERIOD, EXECUTIVE FINANCIAL SUMMARY, CONTENTS
  // ---------------------------------------------------------------------------

  block p1_header: TextBlock {
    content: @md
      <div id="cover" style="display:flex;justify-content:space-between;align-items:center;border-bottom:2px solid #1F3A5F;padding-bottom:8px;">
        <strong style="color:#1F3A5F;">THELOOK ECOMMERCE</strong>
        <span style="color:#52616B;">Finance Report · Reporting period selected below</span>
      </div>
    ;;
  }

  block report_period: FilterBlock {
    label: 'Report Period'
    type: 'date'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block p1_title: TextBlock {
    content: @md
      # Finance Report

      ## Net Sales, COGS & Gross Profit

      This printable report summarizes recognized sales performance for the selected
      reporting period. Net Sales and COGS exclude cancelled and returned order items.
    ;;
  }

  block kpi_net_sales: VizBlock {
    label: 'Net Sales'
    settings {
      hide_label: true
      hide_controls: true
    }
    viz: MetricKpi {
      dataset: thelook
      fields: [
        VizFieldFull {
          label: 'Net Sales'
          ref: r(thelook.net_sales)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
    }
  }

  block kpi_cogs: VizBlock {
    label: 'COGS'
    settings {
      hide_label: true
      hide_controls: true
    }
    viz: MetricKpi {
      dataset: thelook
      fields: [
        VizFieldFull {
          label: 'COGS'
          ref: r(thelook.cogs)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
    }
  }

  block kpi_gross_profit: VizBlock {
    label: 'Gross Profit'
    settings {
      hide_label: true
      hide_controls: true
    }
    viz: MetricKpi {
      dataset: thelook
      fields: [
        VizFieldFull {
          label: 'Gross Profit'
          ref: r(thelook.gross_profit)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
    }
  }

  block kpi_gross_margin: VizBlock {
    label: 'Gross Margin'
    settings {
      hide_label: true
      hide_controls: true
    }
    viz: MetricKpi {
      dataset: thelook
      fields: [
        VizFieldFull {
          label: 'Gross Margin'
          ref: r(thelook.gross_margin)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
    }
  }

  block table_of_contents: TextBlock {
    content: @md
      ## Table of Contents

      1. [Executive Financial Summary](#cover)  
      2. [Department Financial Performance](#department-financial-performance)3. [Category Financial Performance](#category-financial-performance)  
      4. [Metric Definitions](#metric-definitions)  

      ---

      **Export guidance:** Select the reporting period, allow the dashboard to refresh,
      then use **Export → PDF**. The layout is arranged in A4-sized report sections.
    ;;
  }

  block p1_footer: TextBlock {
    content: @md
      <div style="border-top:1px solid #CBD5E1;padding-top:8px;display:flex;justify-content:space-between;color:#64748B;font-size:12px;">
        <span>Confidential finance report</span>
        <span>Reporting period: selected in the Report Period control</span>
        <span>Page 1</span>
      </div>
    ;;
  }

  // ---------------------------------------------------------------------------
  // PAGE 2 — DEPARTMENT FINANCIAL PERFORMANCE
  // ---------------------------------------------------------------------------

  block p2_header: TextBlock {
    content: @md
      <div style="display:flex;justify-content:space-between;align-items:center;border-bottom:2px solid #1F3A5F;padding-bottom:8px;">
        <strong style="color:#1F3A5F;">THELOOK ECOMMERCE · FINANCE REPORT</strong>
        <span style="color:#52616B;">Reporting period: selected in the Report Period control</span>
      </div>
    ;;
  }

  block department_section: TextBlock {
    content: @md
      <div id="department-financial-performance"></div>

      # Department Financial Performance

      Net Sales, Cost of Goods Sold, Gross Profit, and Gross Margin by product department.
      The total row represents the selected report period.
    ;;
  }

  block finance_by_department: VizBlock {
    label: 'Finance by Department'
    settings {
      hide_controls: true
    }
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          label: 'Product Department'
          ref: r(thelook_products.department)
          format {
            type: 'text'
          }
          uname: 'product_department'
        }
        VizFieldFull {
          label: 'Net Sales'
          ref: r(thelook.net_sales)
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'net_sales'
        }
        VizFieldFull {
          label: 'COGS'
          ref: r(thelook.cogs)
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'cogs'
        }
        VizFieldFull {
          label: 'Gross Profit'
          ref: r(thelook.gross_profit)
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'gross_profit'
        }
        VizFieldFull {
          label: 'Gross Margin'
          ref: r(thelook.gross_margin)
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'gross_margin'
        }
      ]
      settings {
        pagination_size: 100
        show_row_number: true
        show_row_with_no_data: true
        show_sum_row: true
        wrap_header_text: true
        wrap_cell_text: false
        frozen_columns: 1
        sorts: [
          KeyBasedSortSetting {
            key: 'gross_profit'
            direction: 'desc'
          }
          KeyBasedSortSetting {
            key: 'product_department'
            direction: 'asc'
          }
        ]
      }
    }
  }

  block p2_footer: TextBlock {
    content: @md
      <div style="border-top:1px solid #CBD5E1;padding-top:8px;display:flex;justify-content:space-between;color:#64748B;font-size:12px;">
        <span>Confidential finance report</span>
        <span>Reporting period: selected in the Report Period control</span>
        <span>Page 2</span>
      </div>
    ;;
  }

  // ---------------------------------------------------------------------------
  // PAGE 3 — CATEGORY FINANCIAL PERFORMANCE
  // ---------------------------------------------------------------------------

  block p3_header: TextBlock {
    content: @md
      <div style="display:flex;justify-content:space-between;align-items:center;border-bottom:2px solid #1F3A5F;padding-bottom:8px;">
        <strong style="color:#1F3A5F;">THELOOK ECOMMERCE · FINANCE REPORT</strong>
        <span style="color:#52616B;">Reporting period: selected in the Report Period control</span>
      </div>
    ;;
  }

  block category_section: TextBlock {
    content: @md
      <div id="category-financial-performance"></div>

      # Category Financial Performance

      Detailed financial performance by department and product category.
    ;;
  }

  block finance_by_category: VizBlock {
    label: 'Finance by Product Category'
    settings {
      hide_controls: true
    }
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          label: 'Product Department'
          ref: r(thelook_products.department)
          format {
            type: 'text'
          }
          uname: 'product_department'
        }
        VizFieldFull {
          label: 'Product Category'
          ref: r(thelook_products.category)
          format {
            type: 'text'
          }
          uname: 'product_category'
        }
        VizFieldFull {
          label: 'Net Sales'
          ref: r(thelook.net_sales)
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'net_sales'
        }
        VizFieldFull {
          label: 'COGS'
          ref: r(thelook.cogs)
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'cogs'
        }
        VizFieldFull {
          label: 'Gross Profit'
          ref: r(thelook.gross_profit)
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'gross_profit'
        }
        VizFieldFull {
          label: 'Gross Margin'
          ref: r(thelook.gross_margin)
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'gross_margin'
        }
      ]
      settings {
        pagination_size: 100
        show_row_number: true
        show_row_with_no_data: true
        show_sum_row: true
        frozen_columns: 2
        wrap_header_text: true
        wrap_cell_text: false
        sorts: [
          KeyBasedSortSetting {
            key: 'product_department'
            direction: 'asc'
          }
          KeyBasedSortSetting {
            key: 'gross_profit'
            direction: 'desc'
          }
        ]
      }
    }
  }

  block p3_footer: TextBlock {
    content: @md
      <div style="border-top:1px solid #CBD5E1;padding-top:8px;display:flex;justify-content:space-between;color:#64748B;font-size:12px;">
        <span>Confidential finance report</span>
        <span>Reporting period: selected in the Report Period control</span>
        <span>Page 3</span>
      </div>
    ;;
  }

  // ---------------------------------------------------------------------------
  // PAGE 4 — METRIC DEFINITIONS
  // ---------------------------------------------------------------------------

  block p4_header: TextBlock {
    content: @md
      <div style="display:flex;justify-content:space-between;align-items:center;border-bottom:2px solid #1F3A5F;padding-bottom:8px;">
        <strong style="color:#1F3A5F;">THELOOK ECOMMERCE · FINANCE REPORT</strong>
        <span style="color:#52616B;">Reporting period: selected in the Report Period control</span>
      </div>
    ;;
  }

  block metric_definitions: TextBlock {
    content: @md
      <div id="metric-definitions"></div>

      # Metric Definitions

      ## Net Sales
      Sum of order-item sale prices, excluding items whose status is **Cancelled** or
      **Returned**.

      ## Cost of Goods Sold (COGS)
      Sum of product costs for the same fulfilled order items included in Net Sales.
      Cancelled and returned items are excluded.

      ## Gross Profit
      **Net Sales − COGS**.

      ## Gross Margin
      **Gross Profit ÷ Net Sales**, expressed as a percentage. The metric is null
      when Net Sales is zero.

      ## Reporting Period
      All report tables and KPI cards use the **Order Item Created At** timestamp.
      Set the required period using the Report Period control on page 1 before PDF export.

      ---

      ### Source and grain
      - **Dataset:** TheLook eCommerce (`thelook`)
      - **Sales grain:** order item
      - **Department and category:** product attributes associated with each order item
      - **Currency:** values use the dataset's configured dollar currency format
    ;;
  }

  block p4_footer: TextBlock {
    content: @md
      <div style="border-top:1px solid #CBD5E1;padding-top:8px;display:flex;justify-content:space-between;color:#64748B;font-size:12px;">
        <span>Confidential finance report</span>
        <span>Reporting period: selected in the Report Period control</span>
        <span>Page 4</span>
      </div>
    ;;
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'report_period'
      to: [
        'kpi_net_sales',
        'kpi_cogs',
        'kpi_gross_profit',
        'kpi_gross_margin',
        'finance_by_department',
        'finance_by_category'
      ]
      field: r(thelook_order_items.created_at)
    }
  ]

  // The canvas uses four 794 × 1,123px A4-oriented sections at 96 DPI.
  // Each report section begins after a clean page boundary for PDF export.
  view: CanvasLayout {
    label: 'Finance Report'
    width: 794
    height: 4492
    margin: 0
    grid_size: 2
    auto_expand_vertically: false

    // Page 1
    block p1_header {
      position: pos(36, 28, 722, 42)
      layer: 1
    }
    block report_period {
      position: pos(496, 90, 262, 76)
      layer: 1
    }
    block p1_title {
      position: pos(36, 98, 430, 180)
      layer: 1
    }
    block kpi_net_sales {
      position: pos(36, 300, 170, 140)
      layer: 1
    }
    block kpi_cogs {
      position: pos(216, 300, 170, 140)
      layer: 1
    }
    block kpi_gross_profit {
      position: pos(396, 300, 170, 140)
      layer: 1
    }
    block kpi_gross_margin {
      position: pos(576, 300, 182, 140)
      layer: 1
    }
    block table_of_contents {
      position: pos(36, 488, 722, 410)
      layer: 1
    }
    block p1_footer {
      position: pos(36, 1050, 722, 42)
      layer: 1
    }

    // Page 2
    block p2_header {
      position: pos(36, 1151, 722, 42)
      layer: 1
    }
    block department_section {
      position: pos(36, 1216, 722, 110)
      layer: 1
    }
    block finance_by_department {
      position: pos(36, 1348, 722, 610)
      layer: 1
    }
    block p2_footer {
      position: pos(36, 2173, 722, 42)
      layer: 1
    }

    // Page 3
    block p3_header {
      position: pos(36, 2274, 722, 42)
      layer: 1
    }
    block category_section {
      position: pos(36, 2339, 722, 90)
      layer: 1
    }
    block finance_by_category {
      position: pos(36, 2450, 722, 730)
      layer: 1
    }
    block p3_footer {
      position: pos(36, 3296, 722, 42)
      layer: 1
    }

    // Page 4
    block p4_header {
      position: pos(36, 3397, 722, 42)
      layer: 1
    }
    block metric_definitions {
      position: pos(36, 3470, 722, 720)
      layer: 1
    }
    block p4_footer {
      position: pos(36, 4419, 722, 42)
      layer: 1
    }

    mobile {
      mode: 'none'
    }
  }
}
