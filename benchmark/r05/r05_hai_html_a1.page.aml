// @File:benchmark/r05/r05_hai_html_a1.page.aml

Dashboard r05_hai_html_a1 {
  title: 'Finance Report'
  description: 'Printable A4 finance report for Net Sales, COGS, Gross Profit, and Gross Margin by product department and category.'

  settings {
    timezone: 'UTC'
    autorun_on_open: true
  }

  block f_report_period: FilterBlock {
    label: 'Reporting Period'
    type: 'date'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block v_headline_metrics: VizBlock {
    label: 'Finance Summary'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.cogs)
          label: 'COGS'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.gross_profit)
          label: 'Gross Profit'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.gross_margin)
          label: 'Gross Margin'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
      ]
      settings {
        show_row_number: false
        single_cell_display: 'large'
        wrap_header_text: true
        wrap_cell_text: false
      }
    }
  }

  block v_department_finance: VizBlock {
    label: 'Finance by Department'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          label: 'Product Department'
          ref: r(thelook_products.department)
          format {
            type: 'text'
          }
          uname: 'thelook_products_department_1'
        },
        VizFieldFull {
          label: 'Net Sales'
          ref: r(thelook.net_sales)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'COGS'
          ref: r(thelook.cogs)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'Gross Profit'
          ref: r(thelook.gross_profit)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'Gross Margin'
          ref: r(thelook.gross_margin)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        pagination_size: 100
        show_row_number: false
        wrap_header_text: true
        wrap_cell_text: false
        frozen_columns: 1
        sorts: [
          KeyBasedSortSetting {
            key: 'thelook_products_department_1'
            direction: 'asc'
          }
        ]
        column_styles: [
          ColumnStyle {
            key: 'thelook_products_department_1'
            width: 220
          }
        ]
      }
    }
  }

  block v_category_finance: VizBlock {
    label: 'Finance by Category'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          label: 'Product Category'
          ref: r(thelook_products.category)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'Net Sales'
          ref: r(thelook.net_sales)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'COGS'
          ref: r(thelook.cogs)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'Gross Profit'
          ref: r(thelook.gross_profit)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'Gross Margin'
          ref: r(thelook.gross_margin)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        pagination_size: 100
        show_row_number: false
        wrap_header_text: true
        wrap_cell_text: false
        frozen_columns: 1
        sorts: [
          KeyBasedSortSetting {
            key: 'thelook_products.category'
            direction: 'asc'
          }
        ]
      }
    }
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'f_report_period'
      to: [
        'v_headline_metrics',
        'v_department_finance',
        'v_category_finance'
      ]
      field: r(thelook_order_items.created_at)
    }
  ]

  view: HTMLLayout {
    content: @html
      <style>
        :root {
          --ink: #17202a;
          --muted: #667085;
          --navy: #163c5a;
          --blue: #246b98;
          --paper: #ffffff;
          --soft: #f4f7f9;
          --rule: #d7dee5;
          --page-w: 210mm;
          --page-h: 297mm;
          --margin-x: 15mm;
          --margin-top: 14mm;
          --margin-bottom: 16mm;
        }

        * {
          box-sizing: border-box;
        }

        html,
        body {
          margin: 0;
          padding: 0;
          background: #e8edf1;
          color: var(--ink);
          font-family: Inter, Arial, Helvetica, sans-serif;
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }

        .page {
          width: var(--page-w);
          min-height: var(--page-h);
          margin: 0 auto 10mm;
          padding: var(--margin-top) var(--margin-x) var(--margin-bottom);
          background: var(--paper);
          box-shadow: 0 4px 22px rgba(22, 60, 90, 0.16);
          position: relative;
          display: flex;
          flex-direction: column;
          overflow: hidden;
          break-after: page;
          page-break-after: always;
        }

        .page:last-child {
          break-after: auto;
          page-break-after: auto;
        }

        .page-header {
          display: grid;
          grid-template-columns: 1fr 66mm;
          gap: 8mm;
          align-items: start;
          border-bottom: 2px solid var(--navy);
          padding-bottom: 5mm;
          margin-bottom: 8mm;
        }

        .brand {
          color: var(--navy);
          font-size: 8pt;
          font-weight: 800;
          letter-spacing: 0.16em;
          text-transform: uppercase;
          margin-bottom: 2mm;
        }

        .report-title {
          color: var(--ink);
          font-size: 25pt;
          font-weight: 760;
          letter-spacing: -0.045em;
          line-height: 1;
          margin: 0;
        }

        .report-subtitle {
          color: var(--muted);
          font-size: 9pt;
          line-height: 1.4;
          margin: 2.5mm 0 0;
        }

        .period-control {
          min-width: 0;
          padding-top: 1mm;
        }

        .period-control h-block {
          display: block;
        }

        .section-kicker {
          color: var(--blue);
          font-size: 7.5pt;
          font-weight: 800;
          letter-spacing: 0.14em;
          text-transform: uppercase;
          margin: 0 0 2mm;
        }

        .section-title {
          color: var(--navy);
          font-size: 19pt;
          font-weight: 750;
          letter-spacing: -0.03em;
          line-height: 1.08;
          margin: 0 0 3mm;
        }

        .section-description {
          color: var(--muted);
          font-size: 9pt;
          line-height: 1.45;
          margin: 0 0 6mm;
          max-width: 140mm;
        }

        .summary-panel {
          background: var(--soft);
          border: 1px solid var(--rule);
          border-top: 4px solid var(--navy);
          padding: 6mm;
          margin-top: 2mm;
        }

        .summary-panel h-block {
          display: block;
        }

        .toc-list {
          border-top: 1px solid var(--rule);
          margin-top: 8mm;
        }

        .toc-item {
          align-items: baseline;
          border-bottom: 1px solid var(--rule);
          color: var(--ink);
          display: grid;
          grid-template-columns: 12mm 1fr auto;
          gap: 4mm;
          padding: 5mm 0;
          text-decoration: none;
        }

        .toc-item:hover {
          background: var(--soft);
        }

        .toc-number {
          color: var(--blue);
          font-size: 9pt;
          font-weight: 800;
        }

        .toc-label {
          color: var(--navy);
          font-size: 12pt;
          font-weight: 700;
        }

        .toc-page {
          color: var(--muted);
          font-size: 8.5pt;
          font-variant-numeric: tabular-nums;
        }

        .toc-note {
          color: var(--muted);
          font-size: 8.5pt;
          line-height: 1.45;
          margin: 1mm 0 0 16mm;
        }

        .table-panel {
          border: 1px solid var(--rule);
          padding: 4mm;
          background: #fff;
          flex: 1;
          min-height: 0;
        }

        .table-panel h-block {
          display: block;
          width: 100%;
        }

        .definition-list {
          border-top: 1px solid var(--rule);
          margin-top: 5mm;
        }

        .definition {
          border-bottom: 1px solid var(--rule);
          display: grid;
          grid-template-columns: 42mm 1fr;
          gap: 8mm;
          padding: 4.5mm 0;
        }

        .definition-name {
          color: var(--navy);
          font-size: 10pt;
          font-weight: 750;
        }

        .definition-text {
          color: var(--ink);
          font-size: 9pt;
          line-height: 1.45;
        }

        .definition-text strong {
          color: var(--navy);
        }

        .method-note {
          background: var(--soft);
          border-left: 3px solid var(--blue);
          color: var(--muted);
          font-size: 8.5pt;
          line-height: 1.5;
          margin-top: 7mm;
          padding: 4mm 5mm;
        }

        .page-footer {
          align-items: center;
          border-top: 1px solid var(--rule);
          color: var(--muted);
          display: flex;
          font-size: 7.5pt;
          justify-content: space-between;
          line-height: 1.2;
          margin-top: auto;
          padding-top: 4mm;
        }

        .footer-period {
          color: var(--navy);
          font-weight: 700;
        }

        .footer-page {
          font-variant-numeric: tabular-nums;
        }

        @media print {
          html,
          body {
            background: #fff;
          }

          .page {
            box-shadow: none;
            margin: 0;
            width: 210mm;
            min-height: 297mm;
          }

          @page {
            size: A4 portrait;
            margin: 0;
          }
        }
      </style>

      <main aria-label="Finance report">

        <section class="page" id="cover">
          <header class="page-header">
            <div>
              <div class="brand">TheLook eCommerce</div>
              <h1 class="report-title">Finance Report</h1>
              <p class="report-subtitle">
                Sales, cost of goods sold, and gross profit performance for the selected reporting period.
              </p>
            </div>
            <div class="period-control">
              <h-block name="f_report_period" />
            </div>
          </header>

          <p class="section-kicker">01 / Financial Summary</p>
          <h2 class="section-title">Headline performance</h2>
          <p class="section-description">
            Summary of realized sales and direct product costs. Net Sales, COGS, and Gross Profit
            exclude cancelled and returned order items.
          </p>

          <div class="summary-panel">
            <h-block name="v_headline_metrics" />
          </div>

          <div class="method-note">
            <strong>Print-ready report.</strong> Use the dashboard <strong>Export</strong> action to
            download this A4 layout as a PDF. The selected reporting period is applied consistently to
            every financial table in this report.
          </div>

          <footer class="page-footer">
            <span class="footer-period">Reporting period: selected above</span>
            <span class="footer-page">Finance Report · Page 1</span>
          </footer>
        </section>

        <section class="page" id="contents">
          <header class="page-header">
            <div>
              <div class="brand">TheLook eCommerce</div>
              <h1 class="report-title">Contents</h1>
              <p class="report-subtitle">Navigate directly to a report section before exporting.</p>
            </div>
            <div class="period-control">
              <h-block name="f_report_period" />
            </div>
          </header>

          <nav class="toc-list" aria-label="Table of contents">
            <a class="toc-item" href="#cover">
              <span class="toc-number">01</span>
              <span class="toc-label">Financial Summary</span>
              <span class="toc-page">Page 1</span>
            </a>
            <p class="toc-note">Headline Net Sales, COGS, Gross Profit, and Gross Margin.</p>

            <a class="toc-item" href="#department">
              <span class="toc-number">02</span>
              <span class="toc-label">Department Performance</span>
              <span class="toc-page">Page 3</span>
            </a>
            <p class="toc-note">Financial performance summarized by product department.</p>

            <a class="toc-item" href="#category">
              <span class="toc-number">03</span>
              <span class="toc-label">Category Performance</span>
              <span class="toc-page">Page 4</span>
            </a>
            <p class="toc-note">Financial performance summarized by product category.</p>

            <a class="toc-item" href="#definitions">
              <span class="toc-number">04</span>
              <span class="toc-label">Metric Definitions</span>
              <span class="toc-page">Page 5</span>
            </a>
            <p class="toc-note">Definitions and scope used throughout this finance report.</p>
          </nav>

          <footer class="page-footer">
            <span class="footer-period">Reporting period: selected above</span>
            <span class="footer-page">Finance Report · Page 2</span>
          </footer>
        </section>

        <section class="page" id="department">
          <header class="page-header">
            <div>
              <div class="brand">TheLook eCommerce</div>
              <h1 class="report-title">Department Performance</h1>
              <p class="report-subtitle">Financial results aggregated at product department level.</p>
            </div>
            <div class="period-control">
              <h-block name="f_report_period" />
            </div>
          </header>

          <p class="section-kicker">02 / Department Detail</p>
          <h2 class="section-title">Net Sales, COGS, and Gross Profit by department</h2>
          <p class="section-description">
            Use this table to compare commercial scale and margin contribution across each product department.
          </p>

          <div class="table-panel">
            <h-block name="v_department_finance" />
          </div>

          <footer class="page-footer">
            <span class="footer-period">Reporting period: selected above</span>
            <span class="footer-page">Finance Report · Page 3</span>
          </footer>
        </section>

        <section class="page" id="category">
          <header class="page-header">
            <div>
              <div class="brand">TheLook eCommerce</div>
              <h1 class="report-title">Category Performance</h1>
              <p class="report-subtitle">Financial results aggregated at product category level.</p>
            </div>
            <div class="period-control">
              <h-block name="f_report_period" />
            </div>
          </header>

          <p class="section-kicker">03 / Category Detail</p>
          <h2 class="section-title">Net Sales, COGS, and Gross Profit by category</h2>
          <p class="section-description">
            Category-level detail provides a more granular view of revenue quality and direct cost performance.
          </p>

          <div class="table-panel">
            <h-block name="v_category_finance" />
          </div>

          <footer class="page-footer">
            <span class="footer-period">Reporting period: selected above</span>
            <span class="footer-page">Finance Report · Page 4</span>
          </footer>
        </section>

        <section class="page" id="definitions">
          <header class="page-header">
            <div>
              <div class="brand">TheLook eCommerce</div>
              <h1 class="report-title">Metric Definitions</h1>
              <p class="report-subtitle">Finance-report definitions and inclusion rules.</p>
            </div>
            <div class="period-control">
              <h-block name="f_report_period" />
            </div>
          </header>

          <p class="section-kicker">04 / Definitions</p>
          <h2 class="section-title">Financial metric scope</h2>
          <p class="section-description">
            All results use the selected reporting period based on order-item creation date.
          </p>

          <div class="definition-list">
            <div class="definition">
              <div class="definition-name">Net Sales</div>
              <div class="definition-text">
                Sum of <strong>order-item sale price</strong>, excluding order items with
                <strong>Cancelled</strong> or <strong>Returned</strong> status.
              </div>
            </div>

            <div class="definition">
              <div class="definition-name">COGS</div>
              <div class="definition-text">
                Sum of the related product <strong>cost</strong> for the order items included in Net Sales.
                Cancelled and returned items are excluded.
              </div>
            </div>

            <div class="definition">
              <div class="definition-name">Gross Profit</div>
              <div class="definition-text">
                <strong>Net Sales − COGS.</strong> This represents profit after direct product cost,
                before operating expenses, marketing, fulfillment, and other indirect costs.
              </div>
            </div>

            <div class="definition">
              <div class="definition-name">Gross Margin</div>
              <div class="definition-text">
                <strong>Gross Profit ÷ Net Sales.</strong> Displayed as a percentage; returns no value
                where Net Sales is zero.
              </div>
            </div>

            <div class="definition">
              <div class="definition-name">Department / Category</div>
              <div class="definition-text">
                Product attributes attached to each order item through the product relationship.
                Each financial metric is summarized at the selected product hierarchy.
              </div>
            </div>
          </div>

          <div class="method-note">
            <strong>Source grain:</strong> order items. An order with multiple products can contribute to
            multiple departments or categories. This report intentionally uses the governed metrics in the
            TheLook eCommerce dataset without changing the dataset or its underlying models.
          </div>

          <footer class="page-footer">
            <span class="footer-period">Reporting period: selected above</span>
            <span class="footer-page">Finance Report · Page 5</span>
          </footer>
        </section>

      </main>
    ;;
  }
}
