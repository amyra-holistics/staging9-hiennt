Dashboard r05_hai_html_a2 {
  title: 'Finance Report'
  description: 'Printable A4 finance report with department and category profitability detail.'
  theme: H.themes.classic

  settings {
    autorun: true
    cache_duration: 3600
  }

  block report_period: FilterBlock {
    label: 'Reporting Period'
    type: 'date'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block kpi_net_sales: VizBlock {
    label: 'Net Sales'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: '[$$]#,###0'
        }
      }
      settings {
        display_mode: 'single'
      }
    }
  }

  block kpi_cogs: VizBlock {
    label: 'COGS'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.cogs)
        label: 'COGS'
        format {
          type: 'number'
          pattern: '[$$]#,###0'
        }
      }
      settings {
        display_mode: 'single'
      }
    }
  }

  block kpi_gross_profit: VizBlock {
    label: 'Gross Profit'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_profit)
        label: 'Gross Profit'
        format {
          type: 'number'
          pattern: '[$$]#,###0'
        }
      }
      settings {
        display_mode: 'single'
      }
    }
  }

  block kpi_gross_margin: VizBlock {
    label: 'Gross Margin'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: '#,###0.0%'
        }
      }
      settings {
        display_mode: 'single'
      }
    }
  }

  block finance_detail: VizBlock {
    label: 'Profitability by Department and Category'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          ref: r(thelook_order_items.created_at)
          label: 'Report Period'
          hidden: true
          format {
            type: 'datetime'
          }
        },
        VizFieldFull {
          ref: r(thelook_products.department)
          label: 'Department'
          uname: 'department'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(thelook_products.category)
          label: 'Category'
          uname: 'category'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
        },
        VizFieldFull {
          ref: r(thelook.cogs)
          label: 'COGS'
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
        },
        VizFieldFull {
          ref: r(thelook.gross_profit)
          label: 'Gross Profit'
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
        },
        VizFieldFull {
          ref: r(thelook.gross_margin)
          label: 'Gross Margin'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        }
      ]
      settings {
        pagination_size: 100
        row_limit: 10000
        show_row_number: false
        wrap_header_text: false
        wrap_cell_text: false
        sorts: [
          KeyBasedSortSetting {
            key: 'department'
            direction: 'asc'
          },
          KeyBasedSortSetting {
            key: 'category'
            direction: 'asc'
          }
        ]
      }
    }
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'report_period'
      to: [
        'kpi_net_sales',
        'kpi_cogs',
        'kpi_gross_profit',
        'kpi_gross_margin',
        'finance_detail'
      ]
      field: r(thelook_order_items.created_at)
    }
  ]

  view: HTMLLayout {
    content: @html
      <style>
        :root {
          --page-width: 210mm;
          --page-height: 297mm;
          --page-padding: 15mm;
          --ink: #17212b;
          --navy: #19344d;
          --blue: #2b648a;
          --green: #1f6c57;
          --paper: #ffffff;
          --paper-warm: #f7f5f1;
          --line: #ccd4d9;
          --muted: #5b6872;
          --soft-blue: #eaf2f6;
        }

        * {
          box-sizing: border-box;
        }

        body {
          margin: 0;
          color: var(--ink);
          background: #e5e9eb;
          font-family: Arial, Helvetica, sans-serif;
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }

        .finance-report {
          padding: 12mm 0;
        }

        .page {
          width: var(--page-width);
          min-height: var(--page-height);
          margin: 0 auto 12mm;
          padding: var(--page-padding);
          position: relative;
          overflow: hidden;
          background: var(--paper);
          box-shadow: 0 8px 30px rgba(23, 33, 43, 0.14);
          page-break-after: always;
          break-after: page;
        }

        .page:last-child {
          page-break-after: auto;
          break-after: auto;
        }

        .page-header {
          min-height: 18mm;
          display: flex;
          align-items: flex-start;
          justify-content: space-between;
          gap: 8mm;
          padding-bottom: 5mm;
          border-bottom: 2px solid var(--navy);
        }

        .brand {
          color: var(--navy);
          font-size: 9pt;
          font-weight: 700;
          letter-spacing: 0.16em;
          text-transform: uppercase;
        }

        .period-label {
          max-width: 72mm;
          color: var(--muted);
          font-size: 8pt;
          line-height: 1.35;
          text-align: right;
        }

        .period-label strong {
          display: block;
          color: var(--ink);
          font-size: 8.5pt;
        }

        .page-footer {
          position: absolute;
          right: var(--page-padding);
          bottom: 10mm;
          left: var(--page-padding);
          display: flex;
          justify-content: space-between;
          gap: 6mm;
          padding-top: 3mm;
          border-top: 1px solid var(--line);
          color: var(--muted);
          font-size: 7.5pt;
        }

        .cover {
          display: flex;
          flex-direction: column;
          justify-content: space-between;
        }

        .cover-main {
          padding-top: 25mm;
        }

        .report-kicker,
        .section-kicker {
          color: var(--blue);
          font-size: 8pt;
          font-weight: 700;
          letter-spacing: 0.17em;
          text-transform: uppercase;
        }

        .report-title {
          max-width: 140mm;
          margin: 7mm 0 6mm;
          color: var(--navy);
          font-size: 38pt;
          font-weight: 700;
          letter-spacing: -0.04em;
          line-height: 0.98;
        }

        .report-subtitle {
          max-width: 132mm;
          margin: 0;
          color: var(--muted);
          font-size: 12pt;
          line-height: 1.55;
        }

        .control-panel {
          max-width: 100mm;
          margin-top: 15mm;
          padding: 6mm;
          border: 1px solid var(--line);
          background: var(--paper-warm);
        }

        .control-panel h2 {
          margin: 0 0 3mm;
          color: var(--navy);
          font-size: 10pt;
        }

        .control-panel p {
          margin: 0 0 4mm;
          color: var(--muted);
          font-size: 8.5pt;
          line-height: 1.45;
        }

        .toc {
          margin-top: 16mm;
          padding-top: 7mm;
          border-top: 1px solid var(--line);
        }

        .toc h2 {
          margin: 0 0 5mm;
          color: var(--navy);
          font-size: 14pt;
        }

        .toc a {
          display: flex;
          justify-content: space-between;
          margin: 3.5mm 0;
          padding-bottom: 2mm;
          border-bottom: 1px dotted var(--line);
          color: var(--ink);
          font-size: 10pt;
          text-decoration: none;
        }

        .toc a span:last-child {
          color: var(--blue);
          font-weight: 700;
        }

        .section-title {
          margin: 2mm 0 2mm;
          color: var(--navy);
          font-size: 24pt;
          letter-spacing: -0.025em;
          line-height: 1.05;
        }

        .section-description {
          max-width: 140mm;
          margin: 0 0 7mm;
          color: var(--muted);
          font-size: 9.5pt;
          line-height: 1.5;
        }

        .summary-grid {
          display: grid;
          grid-template-columns: repeat(4, minmax(0, 1fr));
          gap: 0;
          margin-top: 8mm;
          border-top: 1px solid var(--line);
          border-bottom: 1px solid var(--line);
        }

        .summary-card {
          min-height: 34mm;
          padding: 5mm;
          border-right: 1px solid var(--line);
        }

        .summary-card:last-child {
          border-right: 0;
        }

        .summary-card h3 {
          margin: 0 0 3mm;
          color: var(--muted);
          font-size: 7.5pt;
          font-weight: 700;
          letter-spacing: 0.12em;
          text-transform: uppercase;
        }

        .summary-card h-block {
          display: block;
          min-height: 12mm;
        }

        .summary-note {
          margin-top: 10mm;
          padding: 5mm 6mm;
          border-left: 4px solid var(--green);
          background: #eef6f3;
          color: #29453b;
          font-size: 9pt;
          line-height: 1.5;
        }

        .table-wrap {
          margin-top: 7mm;
          padding: 4mm;
          border: 1px solid var(--line);
          background: #fff;
        }

        .table-wrap h-block {
          display: block;
        }

        .definitions {
          display: grid;
          grid-template-columns: 40mm 1fr;
          margin-top: 8mm;
          border-top: 1px solid var(--line);
        }

        .definition-term,
        .definition-description {
          min-height: 17mm;
          padding: 4mm 3mm;
          border-bottom: 1px solid var(--line);
        }

        .definition-term {
          color: var(--navy);
          font-size: 10pt;
          font-weight: 700;
        }

        .definition-description {
          color: var(--muted);
          font-size: 9pt;
          line-height: 1.45;
        }

        .methodology {
          margin-top: 9mm;
          padding: 5mm 6mm;
          background: var(--soft-blue);
          color: #29475b;
          font-size: 8.5pt;
          line-height: 1.55;
        }

        .export-note {
          margin-top: 7mm;
          color: var(--muted);
          font-size: 8pt;
          line-height: 1.45;
        }

        @media print {
          body {
            background: #ffffff;
          }

          .finance-report {
            padding: 0;
          }

          .page {
            margin: 0;
            box-shadow: none;
          }
        }
      </style>

      <main class="finance-report">
        <!-- PAGE 1: COVER AND CONTENTS -->
        <section class="page cover" id="cover">
          <header class="page-header">
            <div class="brand">TheLook eCommerce</div>
            <div class="period-label">
              <strong>Reporting period</strong>
              Selected using the report control below
            </div>
          </header>

          <div class="cover-main">
            <div class="report-kicker">Printable Finance Report</div>
            <h1 class="report-title">Sales &amp; Gross Profit Review</h1>
            <p class="report-subtitle">
              A period-based financial report covering Net Sales, Cost of Goods Sold,
              Gross Profit, and Gross Margin across product departments and categories.
            </p>

            <div class="control-panel">
              <h2>Report controls</h2>
              <p>
                Select the reporting period before exporting. The selected period applies
                to every financial metric and the department/category detail table.
              </p>
              <h-block name="report_period" />
            </div>

            <nav class="toc" aria-label="Table of contents">
              <h2>Contents</h2>
              <a href="#financial-summary">
                <span>01 — Financial summary</span>
                <span>02</span>
              </a>
              <a href="#profitability-detail">
                <span>02 — Department &amp; category profitability</span>
                <span>03</span>
              </a>
              <a href="#metric-definitions">
                <span>03 — Metric definitions &amp; methodology</span>
                <span>04</span>
              </a>
            </nav>
          </div>

          <footer class="page-footer">
            <span>TheLook eCommerce · Finance</span>
            <span>Page 01 / 04</span>
          </footer>
        </section>

        <!-- PAGE 2: FINANCIAL SUMMARY -->
        <section class="page" id="financial-summary">
          <header class="page-header">
            <div class="brand">TheLook eCommerce · Finance Report</div>
            <div class="period-label">
              <strong>Reporting period</strong>
              Selected in report controls
            </div>
          </header>

          <div class="section-kicker">01 — Financial Summary</div>
          <h2 class="section-title">Period performance</h2>
          <p class="section-description">
            Core profitability measures for the selected reporting period. Net Sales,
            COGS, and Gross Profit exclude cancelled and returned order items.
          </p>

          <div class="summary-grid">
            <section class="summary-card">
              <h3>Net Sales</h3>
              <h-block name="kpi_net_sales" />
            </section>

            <section class="summary-card">
              <h3>COGS</h3>
              <h-block name="kpi_cogs" />
            </section>

            <section class="summary-card">
              <h3>Gross Profit</h3>
              <h-block name="kpi_gross_profit" />
            </section>

            <section class="summary-card">
              <h3>Gross Margin</h3>
              <h-block name="kpi_gross_margin" />
            </section>
          </div>

          <div class="summary-note">
            <strong>Reading this report:</strong> Gross Profit is Net Sales less COGS.
            Gross Margin expresses Gross Profit as a percentage of Net Sales.
          </div>

          <footer class="page-footer">
            <span>TheLook eCommerce · Finance</span>
            <span>Page 02 / 04</span>
          </footer>
        </section>

        <!-- PAGE 3: PROFITABILITY DETAIL -->
        <section class="page" id="profitability-detail">
          <header class="page-header">
            <div class="brand">TheLook eCommerce · Finance Report</div>
            <div class="period-label">
              <strong>Reporting period</strong>
              Selected in report controls
            </div>
          </header>

          <div class="section-kicker">02 — Profitability Detail</div>
          <h2 class="section-title">By department and category</h2>
          <p class="section-description">
            Financial contribution by product department and category. The table is
            sorted alphabetically to support reconciliation and print review.
          </p>

          <div class="table-wrap">
            <h-block name="finance_detail" />
          </div>

          <p class="export-note">
            For PDF output, use the dashboard <strong>Export</strong> action and select
            <strong>PDF</strong>. The selected reporting period and all filtered financial
            results are included in the export.
          </p>

          <footer class="page-footer">
            <span>TheLook eCommerce · Finance</span>
            <span>Page 03 / 04</span>
          </footer>
        </section>

        <!-- PAGE 4: DEFINITIONS -->
        <section class="page" id="metric-definitions">
          <header class="page-header">
            <div class="brand">TheLook eCommerce · Finance Report</div>
            <div class="period-label">
              <strong>Reporting period</strong>
              Selected in report controls
            </div>
          </header>

          <div class="section-kicker">03 — Metric Definitions</div>
          <h2 class="section-title">Financial methodology</h2>
          <p class="section-description">
            Definitions used consistently throughout this report.
          </p>

          <div class="definitions">
            <div class="definition-term">Net Sales</div>
            <div class="definition-description">
              Sum of order-item sale price, excluding items with a status of
              <strong>Cancelled</strong> or <strong>Returned</strong>.
            </div>

            <div class="definition-term">COGS</div>
            <div class="definition-description">
              Product cost for the order items included in Net Sales. Cancelled and
              returned items are excluded using the same status rule.
            </div>

            <div class="definition-term">Gross Profit</div>
            <div class="definition-description">
              Net Sales less COGS.
            </div>

            <div class="definition-term">Gross Margin</div>
            <div class="definition-description">
              Gross Profit divided by Net Sales. The metric is displayed as a percentage.
            </div>

            <div class="definition-term">Department</div>
            <div class="definition-description">
              Product-level department classification from the TheLook product catalog.
            </div>

            <div class="definition-term">Category</div>
            <div class="definition-description">
              Product-level category classification from the TheLook product catalog.
            </div>

            <div class="definition-term">Reporting Period</div>
            <div class="definition-description">
              Applied using the Order Item Created At field. Select the period on the
              cover page before reviewing or exporting the report.
            </div>
          </div>

          <div class="methodology">
            <strong>Scope note:</strong> The report uses the TheLook eCommerce dataset
            at the order-item sales grain. Product department and category are joined
            from the product catalog, while financial metrics are governed by the
            dataset's predefined Net Sales, COGS, Gross Profit, and Gross Margin logic.
          </div>

          <footer class="page-footer">
            <span>TheLook eCommerce · Finance</span>
            <span>Page 04 / 04</span>
          </footer>
        </section>
      </main>
    ;;
  }
}
