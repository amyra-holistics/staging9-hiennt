Dashboard r05_haid_canvas_a3 {
  title: 'Financial Performance Report'
  description: @md
    A print-ready financial performance report with a reporting-period filter, department and category detail, and metric definitions.
  ;;
  theme: H.themes.classic

  block date_range: FilterBlock {
    label: 'Reporting Period'
    description: 'Select the order-item creation date range to apply to all financial tables in this report.'
    type: 'date'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block department_performance: VizBlock {
    label: 'Department Performance'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          label: 'Product Department'
          ref: r(thelook_products.department)
          format {
            type: 'text'
          }
          uname: 'product_department'
        },
        VizFieldFull {
          label: 'Net Sales'
          ref: r(thelook.net_sales)
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
        },
        VizFieldFull {
          label: 'COGS'
          ref: r(thelook.cogs)
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
        },
        VizFieldFull {
          label: 'Gross Profit'
          ref: r(thelook.gross_profit)
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
        },
      ]
      settings {
        pagination_size: 100
        show_row_number: false
        wrap_header_text: false
        wrap_cell_text: false
        sorts: [
          KeyBasedSortSetting {
            key: 'product_department'
            direction: 'asc'
          },
        ]
      }
    }
  }

  block category_detail: VizBlock {
    label: 'Category Detail'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          ref: r(thelook_products.department)
          label: 'Product Department'
          uname: 'product_department'
        },
        VizFieldFull {
          ref: r(thelook_products.category)
          label: 'Product Category'
          uname: 'product_category'
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.cogs)
          label: 'COGS'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.gross_profit)
          label: 'Gross Profit'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        pagination_size: 100
        show_row_number: false
        show_sum_row: true
        wrap_header_text: false
        wrap_cell_text: false
        sorts: [
          KeyBasedSortSetting {
            key: 'product_department'
            direction: 'asc'
          },
          KeyBasedSortSetting {
            key: 'product_category'
            direction: 'asc'
          }
        ]
      }
    }
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'date_range'
      to: ['department_performance', 'category_detail']
      field: r(thelook_order_items.created_at)
    }
  ]

  view: HTMLLayout {
    content: @html
      <style>
        :root {
          --ink: #172033;
          --muted: #596579;
          --rule: #d7dde6;
          --navy: #123b5d;
          --paper: #ffffff;
          --wash: #f3f6f9;
        }
        * { box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        body { background: #edf1f5; color: var(--ink); font-family: Arial, Helvetica, sans-serif; }
        .report-page {
          background: var(--paper);
          margin: 20px auto;
          max-width: 210mm;
          min-height: 297mm;
          padding: 16mm 16mm 18mm;
          position: relative;
          page-break-after: always;
          break-after: page;
        }
        .report-page:last-of-type { page-break-after: auto; break-after: auto; }
        .report-header {
          align-items: flex-end;
          border-bottom: 2px solid var(--navy);
          display: flex;
          justify-content: space-between;
          margin-bottom: 8mm;
          padding-bottom: 4mm;
        }
        .report-header h1, .report-header h2 { color: var(--navy); margin: 0; }
        .report-header h1 { font-size: 21pt; letter-spacing: .02em; }
        .report-header h2 { font-size: 14pt; }
        .period-note { color: var(--muted); font-size: 8.5pt; line-height: 1.4; text-align: right; }
        .report-footer {
          border-top: 1px solid var(--rule);
          bottom: 7mm;
          color: var(--muted);
          display: flex;
          font-size: 8pt;
          justify-content: space-between;
          left: 16mm;
          position: absolute;
          right: 16mm;
          padding-top: 3mm;
        }
        .eyebrow { color: var(--navy); font-size: 8pt; font-weight: bold; letter-spacing: .12em; margin: 0 0 4mm; text-transform: uppercase; }
        .lede { color: var(--muted); font-size: 11pt; line-height: 1.55; margin: 0 0 8mm; max-width: 150mm; }
        .control-panel { background: var(--wash); border: 1px solid var(--rule); margin: 7mm 0; padding: 4mm; }
        .control-panel h3 { color: var(--navy); font-size: 10pt; margin: 0 0 2mm; }
        .control-panel p { color: var(--muted); font-size: 8.5pt; margin: 0 0 3mm; }
        .toc { border-top: 1px solid var(--rule); list-style: none; margin: 8mm 0 0; padding: 0; }
        .toc li { border-bottom: 1px solid var(--rule); }
        .toc a { color: var(--ink); display: flex; font-size: 11pt; justify-content: space-between; padding: 4mm 1mm; text-decoration: none; }
        .toc a:hover { color: var(--navy); background: var(--wash); }
        .section-intro { color: var(--muted); font-size: 9.5pt; line-height: 1.45; margin: 0 0 5mm; }
        .table-frame { border: 1px solid var(--rule); padding: 2mm; }
        .definition-grid { display: grid; gap: 4mm; grid-template-columns: 1fr 1fr; }
        .definition { border: 1px solid var(--rule); padding: 4mm; break-inside: avoid; }
        .definition h3 { color: var(--navy); font-size: 11pt; margin: 0 0 2mm; }
        .definition p { color: var(--muted); font-size: 9pt; line-height: 1.45; margin: 0; }
        .method-note { background: var(--wash); border-left: 3px solid var(--navy); color: var(--ink); font-size: 9pt; line-height: 1.45; margin-top: 7mm; padding: 4mm; }
        @page { size: A4 portrait; margin: 0; }
        @media print {
          body { background: var(--paper); }
          .report-page { box-shadow: none; margin: 0; width: 210mm; }
          .report-header { break-after: avoid; }
          .table-frame, .definition { break-inside: avoid; }
          h1, h2, h3 { break-after: avoid; }
          .report-footer { position: fixed; }
        }
      </style>

      <section class="report-page" id="overview">
        <header class="report-header">
          <div>
            <p class="eyebrow">TheLook eCommerce</p>
            <h1>Financial Performance Report</h1>
          </div>
          <div class="period-note">Reporting period: use the Reporting Period control below.<br />All financial tables update when the date range is applied.</div>
        </header>
        <p class="lede">A paginated report for reviewing product profitability. Navigate with the contents links or select a reporting period before printing or exporting.</p>
        <div class="control-panel">
          <h3>Reporting period</h3>
          <p>Select the order-item creation date range. This filter is explicitly mapped to both financial tables.</p>
          <h-block name="date_range" />
        </div>
        <nav aria-label="Report contents">
          <p class="eyebrow">Contents</p>
          <ul class="toc">
            <li><a href="#overview"><span>Overview</span><span>01</span></a></li>
            <li><a href="#department-performance"><span>Department performance</span><span>02</span></a></li>
            <li><a href="#category-detail"><span>Category detail</span><span>03</span></a></li>
            <li><a href="#metric-definitions"><span>Metric definitions</span><span>04</span></a></li>
          </ul>
        </nav>
        <footer class="report-footer"><span>Financial Performance Report</span><span>Reporting period determined by dashboard date filter</span></footer>
      </section>

      <section class="report-page" id="department-performance">
        <header class="report-header">
          <div><p class="eyebrow">Financial tables</p><h2>Department Performance</h2></div>
          <div class="period-note">Reporting period: selected in the Reporting Period control.<br />Date field: Order Items Created At.</div>
        </header>
        <p class="section-intro">Compare Net Sales, Cost of Goods Sold, and Gross Profit across product departments. Net Sales and related profit measures exclude Cancelled and Returned order items.</p>
        <div class="table-frame"><h-block name="department_performance" /></div>
        <footer class="report-footer"><span>Financial Performance Report</span><span>Department Performance</span></footer>
      </section>

      <section class="report-page" id="category-detail">
        <header class="report-header">
          <div><p class="eyebrow">Financial tables</p><h2>Category Detail</h2></div>
          <div class="period-note">Reporting period: selected in the Reporting Period control.<br />Date field: Order Items Created At.</div>
        </header>
        <p class="section-intro">Detailed profitability by product department and category. The sum row provides an at-a-glance total for the filtered reporting period.</p>
        <div class="table-frame"><h-block name="category_detail" /></div>
        <footer class="report-footer"><span>Financial Performance Report</span><span>Category Detail</span></footer>
      </section>

      <section class="report-page" id="metric-definitions">
        <header class="report-header">
          <div><p class="eyebrow">Reference</p><h2>Metric Definitions</h2></div>
          <div class="period-note">Definitions apply to every selected reporting period.<br />Date field: Order Items Created At.</div>
        </header>
        <p class="section-intro">Use these definitions when interpreting the financial tables or sharing the report externally.</p>
        <div class="definition-grid">
          <article class="definition"><h3>Net Sales</h3><p>Sale price of order items, excluding items with Cancelled or Returned status.</p></article>
          <article class="definition"><h3>COGS</h3><p>Product cost for the order items included in Net Sales; Cancelled and Returned items are excluded.</p></article>
          <article class="definition"><h3>Gross Profit</h3><p>Net Sales minus COGS.</p></article>
          <article class="definition"><h3>Product Department</h3><p>The top-level department assigned to a product, used to organize the first financial table.</p></article>
          <article class="definition"><h3>Product Category</h3><p>The product category within a department, used for the detailed financial breakdown.</p></article>
          <article class="definition"><h3>Reporting Period</h3><p>A viewer-selected filter applied using the Order Items Created At timestamp. It updates both financial tables together.</p></article>
        </div>
        <div class="method-note"><strong>Method note.</strong> The date filter is mapped to <em>thelook_order_items.created_at</em> for Department Performance and Category Detail. Rows and totals therefore reflect the same reporting-period selection.</div>
        <footer class="report-footer"><span>Financial Performance Report</span><span>Metric Definitions</span></footer>
      </section>
    ;;
  }
}
