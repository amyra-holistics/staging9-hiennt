Dashboard r05_haid_html_a1 {
  title: 'Finance Report'
  description: @md
    A print-ready finance report for the selected order-item reporting period.
  ;;

  block f_order_items_created_at: FilterBlock {
    label: 'Reporting period'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block v_monthly_finance: VizBlock {
    label: 'Monthly finance summary'
    viz: MetricSheet {
      dataset: thelook
      date_field: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        label: 'Order Items Created Month'
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      rows: [
        MetricSeries {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        },
        MetricSeries {
          field: VizFieldFull {
            ref: r(thelook.cogs)
            label: 'COGS'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        },
        MetricSeries {
          field: VizFieldFull {
            ref: r(thelook.gross_profit)
            label: 'Gross Profit'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      ]
    }
  }

  block v_finance_by_department: VizBlock {
    label: 'Finance by product department'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          label: 'Product Department'
          ref: r(thelook_products.department)
          format {
            type: 'text'
          }
          uname: 'thelook_products_department_1'
        },
        VizFieldFull {
          label: 'Net Sales'
          ref: r(thelook.net_sales)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'COGS'
          ref: r(thelook.cogs)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'Gross Profit'
          ref: r(thelook.gross_profit)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        pagination_size: 100
        show_row_number: false
        wrap_header_text: true
        wrap_cell_text: false
        sorts: [
          KeyBasedSortSetting {
            key: 'thelook_products_department_1'
            direction: 'asc'
          }
        ]
      }
    }
  }

  block v_finance_by_category: VizBlock {
    label: 'Finance by product category'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          label: 'Product Category'
          ref: r(thelook_products.category)
          format {
            type: 'text'
          }
          uname: 'product_category'
        },
        VizFieldFull {
          label: 'Net Sales'
          ref: r(thelook.net_sales)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'COGS'
          ref: r(thelook.cogs)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'Gross Profit'
          ref: r(thelook.gross_profit)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        pagination_size: 100
        show_row_number: false
        show_sum_row: true
        wrap_header_text: true
        wrap_cell_text: false
        sorts: [
          KeyBasedSortSetting {
            key: 'product_category'
            direction: 'asc'
          }
        ]
      }
    }
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'f_order_items_created_at'
      to: [
        'v_monthly_finance',
        'v_finance_by_department',
        'v_finance_by_category'
      ]
      field: r(thelook_order_items.created_at)
    }
  ]

  view: HTMLLayout {
    content: @html
      <style>
        :root {
          --ink: #172033;
          --muted: #5f6b7a;
          --rule: #d8dee8;
          --navy: #17365d;
          --accent: #2d6a9f;
          --paper: #ffffff;
          --wash: #f4f7fa;
        }

        * { box-sizing: border-box; }
        html { background: #e9edf2; }
        body {
          margin: 0;
          color: var(--ink);
          background: #e9edf2;
          font-family: Arial, Helvetica, sans-serif;
          font-size: 10pt;
          line-height: 1.45;
        }
        .report-page {
          position: relative;
          width: 210mm;
          min-height: 297mm;
          margin: 0 auto 8mm;
          padding: 21mm 16mm 18mm;
          overflow: hidden;
          background: var(--paper);
          box-shadow: 0 2mm 7mm rgba(23, 32, 51, .12);
          page-break-after: always;
          break-after: page;
        }
        .report-page:last-child {
          page-break-after: auto;
          break-after: auto;
        }
        .report-header, .report-footer {
          position: absolute;
          left: 16mm;
          right: 16mm;
          display: flex;
          align-items: center;
          justify-content: space-between;
          color: var(--muted);
          font-size: 8pt;
          letter-spacing: .04em;
          text-transform: uppercase;
        }
        .report-header {
          top: 8mm;
          padding-bottom: 3mm;
          border-bottom: 0.3mm solid var(--rule);
        }
        .report-footer {
          bottom: 7mm;
          padding-top: 3mm;
          border-top: 0.3mm solid var(--rule);
        }
        .report-name { color: var(--navy); font-weight: 700; }
        .period-label { font-weight: 700; }
        .page-number { font-variant-numeric: tabular-nums; }
        .eyebrow {
          margin: 4mm 0 2mm;
          color: var(--accent);
          font-size: 9pt;
          font-weight: 700;
          letter-spacing: .12em;
          text-transform: uppercase;
        }
        h1, h2, h3 { color: var(--navy); margin: 0; }
        h1 { font-size: 30pt; line-height: 1.1; letter-spacing: -.03em; }
        h2 { font-size: 18pt; line-height: 1.2; }
        h3 { font-size: 11pt; }
        .lede { max-width: 126mm; margin: 6mm 0 7mm; color: var(--muted); font-size: 12pt; }
        .control-panel {
          margin-top: 9mm;
          padding: 5mm;
          border: 0.3mm solid var(--rule);
          border-left: 1.5mm solid var(--accent);
          background: var(--wash);
        }
        .control-panel p { margin: 0 0 3mm; font-size: 9pt; font-weight: 700; color: var(--navy); }
        .toc { margin-top: 14mm; }
        .toc ol { margin: 5mm 0 0; padding: 0; list-style: none; counter-reset: toc; }
        .toc li {
          display: flex;
          gap: 3mm;
          align-items: baseline;
          padding: 3.2mm 0;
          border-bottom: 0.3mm solid var(--rule);
          counter-increment: toc;
        }
        .toc li::before { content: counter(toc, decimal-leading-zero); color: var(--accent); font-weight: 700; }
        .toc a { color: var(--ink); text-decoration: none; font-weight: 700; }
        .toc a:hover { color: var(--accent); text-decoration: underline; }
        .section-intro { margin: 3mm 0 6mm; color: var(--muted); }
        .table-shell {
          border: 0.3mm solid var(--rule);
          border-radius: 1.5mm;
          overflow: hidden;
          background: #fff;
        }
        .definition-list { margin: 7mm 0 0; border-top: 0.3mm solid var(--rule); }
        .definition {
          padding: 5mm 0;
          border-bottom: 0.3mm solid var(--rule);
          break-inside: avoid;
        }
        .definition p { margin: 1.5mm 0 0; color: var(--muted); }
        .method-note {
          margin-top: 8mm;
          padding: 5mm;
          background: var(--wash);
          border-left: 1.5mm solid var(--accent);
          color: var(--muted);
        }
        @media print {
          html, body { background: #fff; }
          .report-page {
            width: 210mm;
            min-height: 297mm;
            margin: 0;
            box-shadow: none;
          }
          @page { size: A4 portrait; margin: 0; }
        }
      </style>

      <main aria-label="Finance report">
        <section class="report-page" id="cover">
          <header class="report-header">
            <span class="report-name">Finance report</span>
            <span class="period-label">Reporting period: selected order-item date range</span>
          </header>

          <div class="eyebrow">Management reporting</div>
          <h1>Finance Report</h1>
          <p class="lede">A print-ready view of net sales, cost of goods sold, and gross profit for the reporting period selected below.</p>

          <div class="control-panel">
            <p>Set the reporting period</p>
            <h-block name="f_order_items_created_at" />
          </div>

          <nav class="toc" aria-label="Table of contents">
            <h2>Contents</h2>
            <ol>
              <li><a href="#monthly-summary">Monthly finance summary</a></li>
              <li><a href="#department-finance">Finance by product department</a></li>
              <li><a href="#category-finance">Finance by product category</a></li>
              <li><a href="#metric-definitions">Metric definitions</a></li>
            </ol>
          </nav>

          <footer class="report-footer">
            <span>Finance report</span>
            <span class="period-label">Reporting period: selected order-item date range</span>
            <span class="page-number">Page 1</span>
          </footer>
        </section>

        <section class="report-page" id="monthly-summary">
          <header class="report-header">
            <span class="report-name">Finance report</span>
            <span class="period-label">Reporting period: selected order-item date range</span>
          </header>
          <div class="eyebrow">01 / Monthly summary</div>
          <h2>Monthly finance summary</h2>
          <p class="section-intro">Trend view for Net Sales, COGS, and Gross Profit, grouped by order-item created month.</p>
          <div class="table-shell">
            <h-block name="v_monthly_finance" />
          </div>
          <footer class="report-footer">
            <span>Finance report</span>
            <span class="period-label">Reporting period: selected order-item date range</span>
            <span class="page-number">Page 2</span>
          </footer>
        </section>

        <section class="report-page" id="department-finance">
          <header class="report-header">
            <span class="report-name">Finance report</span>
            <span class="period-label">Reporting period: selected order-item date range</span>
          </header>
          <div class="eyebrow">02 / Department detail</div>
          <h2>Finance by product department</h2>
          <p class="section-intro">Department-level comparison of Net Sales, COGS, and Gross Profit.</p>
          <div class="table-shell">
            <h-block name="v_finance_by_department" />
          </div>
          <footer class="report-footer">
            <span>Finance report</span>
            <span class="period-label">Reporting period: selected order-item date range</span>
            <span class="page-number">Page 3</span>
          </footer>
        </section>

        <section class="report-page" id="category-finance">
          <header class="report-header">
            <span class="report-name">Finance report</span>
            <span class="period-label">Reporting period: selected order-item date range</span>
          </header>
          <div class="eyebrow">03 / Category detail</div>
          <h2>Finance by product category</h2>
          <p class="section-intro">Category-level comparison of Net Sales, COGS, and Gross Profit, including a total row.</p>
          <div class="table-shell">
            <h-block name="v_finance_by_category" />
          </div>
          <footer class="report-footer">
            <span>Finance report</span>
            <span class="period-label">Reporting period: selected order-item date range</span>
            <span class="page-number">Page 4</span>
          </footer>
        </section>

        <section class="report-page" id="metric-definitions">
          <header class="report-header">
            <span class="report-name">Finance report</span>
            <span class="period-label">Reporting period: selected order-item date range</span>
          </header>
          <div class="eyebrow">04 / Reference</div>
          <h2>Metric definitions</h2>
          <p class="section-intro">Definitions apply consistently to each finance table in this report.</p>
          <div class="definition-list">
            <article class="definition">
              <h3>Net Sales</h3>
              <p>Sale price of order items, excluding items with Cancelled or Returned status.</p>
            </article>
            <article class="definition">
              <h3>COGS</h3>
              <p>Product cost of order items included in Net Sales; Cancelled and Returned items are excluded.</p>
            </article>
            <article class="definition">
              <h3>Gross Profit</h3>
              <p>Net Sales minus COGS.</p>
            </article>
          </div>
          <aside class="method-note">
            <strong>Reporting basis.</strong> The reporting-period control filters all data blocks using Order Items Created At. Amounts inherit the dataset currency formatting.
          </aside>
          <footer class="report-footer">
            <span>Finance report</span>
            <span class="period-label">Reporting period: selected order-item date range</span>
            <span class="page-number">Page 5</span>
          </footer>
        </section>
      </main>
    ;;
  }
}
