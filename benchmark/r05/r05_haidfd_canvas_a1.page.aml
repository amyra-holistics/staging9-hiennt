Dashboard r05_haidfd_canvas_a1 {
  title: 'TheLook Finance Report'
  description: @md
A print-ready finance report for reviewing Net Sales, COGS, and Gross Profit by product department and category. Use the Reporting Period and segmentation controls on the Metrics tab to set the report context before exporting.
;;

  settings {
    autorun_on_open: true
    autorun_on_changes: true
    cache_duration: 360
  }

  // Report page 1: contents
  block b_contents_header: TextBlock {
    content: @md
<div style="background:#102A43;color:#FFFFFF;padding:24px 28px;border-left:8px solid #D6A94A;font-family:Georgia,serif;">
  <div style="font-family:Arial,sans-serif;font-size:12px;letter-spacing:1px;">THELOOK · FINANCE</div>
  <h1 style="margin:8px 0 0;font-size:30px;font-weight:600;">Finance Report</h1>
  <p style="margin:8px 0 0;font-family:Arial,sans-serif;font-size:14px;">A focused review of realized merchandise performance.</p>
</div>
;;
  }

  block b_contents: TextBlock {
    content: @md
## Contents

1. **Metrics** — select the reporting period, department, and category; then review Net Sales, COGS, and Gross Profit.
2. **Metric definitions** — scope and calculation notes for the measures shown in this report.

### Reporting context
The **Metrics** tab contains the report controls. The selected Reporting Period and optional Department and Product Category filters apply to every finance metric and table on that tab. The Period Comparison control adds a previous-period comparison using the same reporting date.

[Go to Metrics](#block-b_metrics_header) · [Go to Metric definitions](#block-b_definitions_header)
;;
  }

  block b_contents_footer: TextBlock {
    content: @md
<div style="border-top:1px solid #C9D4DE;padding-top:10px;color:#486581;font-family:Arial,sans-serif;font-size:11px;">THELOOK FINANCE REPORT · INTERNAL MANAGEMENT USE · CONTENTS</div>
;;
  }

  // Report page 2: metrics and controls
  block b_metrics_header: TextBlock {
    content: @md
<div style="background:#102A43;color:#FFFFFF;padding:20px 28px;border-left:8px solid #D6A94A;font-family:Georgia,serif;">
  <h1 style="margin:0;font-size:28px;font-weight:600;">Financial performance</h1>
  <p style="margin:7px 0 0;font-family:Arial,sans-serif;font-size:13px;">Reporting period, departmental contribution, and category detail.</p>
</div>
;;
  }

  block b_metrics_context: TextBlock {
    content: @md
### Report controls
Choose a **Reporting Period** to define the report window. Department and Product Category filters narrow all results. **Period Comparison** evaluates the same measures against the selected prior period.
;;
  }

  block f_reporting_period: FilterBlock {
    label: 'Reporting Period'
    description: 'Filters all finance results by order-item created date.'
    type: 'date'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block f_department: FilterBlock {
    label: 'Department'
    description: 'Optional product department filter.'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.department)
    }
  }

  block f_category: FilterBlock {
    label: 'Product Category'
    description: 'Optional product category filter.'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.category)
    }
  }

  block p_period_comparison: PopBlock {
    label: 'Period Comparison'
    description: 'Compare the selected reporting period with a previous period.'
  }

  block v_net_sales: VizBlock {
    label: 'Net Sales'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
      }
    }
  }

  block v_cogs: VizBlock {
    label: 'COGS'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.cogs)
        label: 'COGS'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block v_gross_profit: VizBlock {
    label: 'Gross Profit'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_profit)
        label: 'Gross Profit'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block b_department_heading: TextBlock {
    content: @md
## Performance by department
Compare realized sales, product cost, and gross profit across the two product departments.
;;
  }

  block v_department_finance: VizBlock {
    label: 'Finance by Department'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          label: 'Department'
          ref: r(thelook_products.department)
          format {
            type: 'text'
          }
          uname: 'thelook_products_department_1'
        },
        VizFieldFull {
          label: 'Net Sales'
          ref: r(thelook.net_sales)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'COGS'
          ref: r(thelook.cogs)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'Gross Profit'
          ref: r(thelook.gross_profit)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
      ]
      settings {
        pagination_size: 100
        show_row_number: true
        wrap_header_text: true
        wrap_cell_text: false
        sorts: [
          KeyBasedSortSetting {
            key: 'thelook_products_department_1'
            direction: 'asc'
          }
        ]
      }
    }
  }

  block b_category_heading: TextBlock {
    content: @md
## Performance by product category
Use this detailed statement to identify categories that contribute the most sales and gross profit.
;;
  }

  block v_category_finance: VizBlock {
    label: 'Finance by Product Category'
    viz: PivotTable {
      dataset: thelook
      rows: [
        VizFieldFull {
          ref: r(thelook_products.category)
          label: 'Product Category'
          format {
            type: 'text'
          }
        },
      ]
      values: [
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.cogs)
          label: 'COGS'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.gross_profit)
          label: 'Gross Profit'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
      ]
      settings {
        pagination_size: 100
        show_row_total: false
        show_column_total: false
        show_sub_total: false
        wrap_header_text: true
        wrap_cell_text: false
        sorts: [
          IndexBasedSortSetting {
            field_index: 0
            direction: 'asc'
          },
        ]
      }
    }
  }

  block b_metrics_footer: TextBlock {
    content: @md
<div style="border-top:1px solid #C9D4DE;padding-top:10px;color:#486581;font-family:Arial,sans-serif;font-size:11px;">THELOOK FINANCE REPORT · RESULTS REFLECT THE ACTIVE REPORTING PERIOD AND FILTERS · METRICS</div>
;;
  }

  // Report page 3: definitions
  block b_definitions_header: TextBlock {
    content: @md
<div style="background:#102A43;color:#FFFFFF;padding:20px 28px;border-left:8px solid #D6A94A;font-family:Georgia,serif;">
  <h1 style="margin:0;font-size:28px;font-weight:600;">Metric definitions</h1>
  <p style="margin:7px 0 0;font-family:Arial,sans-serif;font-size:13px;">Calculation scope and reporting conventions.</p>
</div>
;;
  }

  block b_definitions: TextBlock {
    content: @md
## Financial metrics

| Metric | Definition | Scope |
|---|---|---|
| **Net Sales** | Sum of order-item sale price. | Excludes order items with **Cancelled** or **Returned** status. |
| **COGS** | Sum of associated product cost for qualifying order items. | Uses the same qualifying order items as Net Sales; excludes **Cancelled** and **Returned**. |
| **Gross Profit** | Net Sales less COGS. | Calculated after the same status exclusions. |

## Reporting conventions

- **Reporting date:** Order Item Created at. The Reporting Period control filters this field for each KPI and both finance tables.
- **Department:** Product Department. It is available as both a report filter and the grouping in the departmental statement.
- **Product Category:** Product Category. It is available as both a report filter and the grouping in the category statement.
- **Period Comparison:** Applies the selected comparison period to Net Sales, COGS, Gross Profit, and both statements using Order Item Created at.
- **Sales grain:** Order item. One order can include multiple items.

These definitions are displayed so exported reports retain their calculation context.
;;
  }

  block b_definitions_footer: TextBlock {
    content: @md
<div style="border-top:1px solid #C9D4DE;padding-top:10px;color:#486581;font-family:Arial,sans-serif;font-size:11px;">THELOOK FINANCE REPORT · INTERNAL MANAGEMENT USE · METRIC DEFINITIONS</div>
;;
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'f_reporting_period'
      to: ['v_net_sales', 'v_cogs', 'v_gross_profit', 'v_department_finance', 'v_category_finance']
      field: r(thelook_order_items.created_at)
    },
    FilterInteraction {
      from: 'f_department'
      to: ['v_net_sales', 'v_cogs', 'v_gross_profit', 'v_department_finance', 'v_category_finance']
      field: r(thelook_products.department)
    },
    FilterInteraction {
      from: 'f_category'
      to: ['v_net_sales', 'v_cogs', 'v_gross_profit', 'v_department_finance', 'v_category_finance']
      field: r(thelook_products.category)
    },
    PopInteraction {
      from: 'p_period_comparison'
      to: ['v_net_sales', 'v_cogs', 'v_gross_profit', 'v_department_finance', 'v_category_finance']
      field: r(thelook_order_items.created_at)
    },
  ]

  view: TabLayout {
    tab contents: CanvasLayout {
      label: 'Contents'
      width: 1220
      height: 900
      grid_size: 20
      block b_contents_header { position: pos(20, 20, 1180, 160) }
      block b_contents { position: pos(20, 220, 1180, 520) }
      block b_contents_footer { position: pos(20, 780, 1180, 60) }
      mobile { mode: 'auto' }
    }

    tab metrics: CanvasLayout {
      label: 'Metrics'
      width: 1220
      height: 1880
      grid_size: 20
      block b_metrics_header { position: pos(20, 20, 1180, 140) }
      block b_metrics_context { position: pos(20, 180, 1180, 100) }
      block f_reporting_period { position: pos(20, 300, 280, 100) }
      block f_department { position: pos(320, 300, 280, 100) }
      block f_category { position: pos(620, 300, 280, 100) }
      block p_period_comparison { position: pos(920, 300, 280, 100) }
      block v_net_sales { position: pos(20, 440, 380, 160) }
      block v_cogs { position: pos(420, 440, 380, 160) }
      block v_gross_profit { position: pos(820, 440, 380, 160) }
      block b_department_heading { position: pos(20, 640, 1180, 100) }
      block v_department_finance { position: pos(20, 760, 1180, 340) }
      block b_category_heading { position: pos(20, 1140, 1180, 100) }
      block v_category_finance { position: pos(20, 1260, 1180, 500) }
      block b_metrics_footer { position: pos(20, 1780, 1180, 60) }
      mobile { mode: 'auto' }
    }

    tab definitions: CanvasLayout {
      label: 'Metric Definitions'
      width: 1220
      height: 1120
      grid_size: 20
      block b_definitions_header { position: pos(20, 20, 1180, 140) }
      block b_definitions { position: pos(20, 200, 1180, 780) }
      block b_definitions_footer { position: pos(20, 1020, 1180, 60) }
      mobile { mode: 'auto' }
    }
  }
}
