Dashboard r05_haidfd_canvas_a3 {
  title: 'Finance Closebook'
  description: @md
A six-page PDF-ready monthly management closebook for sales, gross profit, margins, product profitability, and return-rate exceptions.
;;

  block rpt_cover: TextBlock {
    content: @md
# Finance Closebook

**Monthly management closebook**

Use the **Reporting period** control to set the close range. The KPI comparison is the immediately preceding month; Page 3 supplies monthly context. Export only after all pages have loaded.
;;
  }

  block period_selector: FilterBlock {
    label: 'Reporting period'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
    default {
      operator: 'matches'
      value: '$H_NIL$'
    }
  }

  block kpi_net_sales: VizBlock {
    label: 'Net Sales'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.net_sales)
    label: 'Net Sales'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
  compare_value: VizPopSettings {
    field: r(thelook_order_items.created_at)
    show_growth_rate: true
    value: RelativePopValue {
      duration: 1
      granularity: 'month'
    }
  }
  settings {
    display_mode: 'compare_by_percent'
  }
}
  }

  block kpi_gross_profit: VizBlock {
    label: 'Gross Profit'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.gross_profit)
    label: 'Gross Profit'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
  compare_value: VizPopSettings {
    field: r(thelook_order_items.created_at)
    show_growth_rate: true
    value {
      duration: 1
      granularity: 'month'
    }
  }
  settings {
    display_mode: 'compare_by_percent'
  }
}
  }

  block kpi_gross_margin: VizBlock {
    label: 'Gross Margin'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.gross_margin)
    label: 'Gross Margin'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
  compare_value: VizPopSettings {
    field: r(thelook_order_items.created_at)
    value {
      duration: 1
      granularity: 'month'
    }
  }
  settings {
    display_mode: 'compare_by_percent'
  }
}
  }

  block kpi_fulfilled_orders: VizBlock {
    label: 'Fulfilled Orders'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.fulfilled_orders)
    label: 'Fulfilled Orders'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
  compare_value: VizPopSettings {
    field: r(thelook_order_items.created_at)
    show_growth_rate: true
    value {
      duration: 1
      granularity: 'month'
    }
  }
  settings {
    display_mode: 'compare_by_percent'
  }
}
  }

  block kpi_aov: VizBlock {
    label: 'Average Order Value'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.aov)
    label: 'Average Order Value'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
  compare_value: VizPopSettings {
    field: r(thelook_order_items.created_at)
    value {
      duration: 1
      granularity: 'month'
    }
  }
  settings {
    display_mode: 'compare_by_percent'
  }
}
  }

  block kpi_return_rate: VizBlock {
    label: 'Return Rate'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.return_rate)
    label: 'Return Rate'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
  compare_value: VizPopSettings {
    field: r(thelook_order_items.created_at)
    value: RelativePopValue {
      duration: 1
      granularity: 'month'
    }
  }
  settings {
    display_mode: 'compare_by_percent'
  }
}
