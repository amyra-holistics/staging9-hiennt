Dashboard r05_haidfd_html_a1 {
  title: 'Finance Report'
  description: @md
A print-ready finance report with an optional reporting-period filter, financial summary, department and category statements, and governed metric definitions.
  ;;

  theme {
    block {
      background {
        bg_color: 'transparent'
      }
      border {
        border_width: 0
      }
    }
  }

  block finance_period: FilterBlock {
    label: 'Reporting period'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block net_sales_kpi: VizBlock {
    label: 'Net Sales'
    settings {
      hide_controls: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block cogs_kpi: VizBlock {
    label: 'COGS'
    settings {
      hide_controls: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.cogs)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block gross_profit_kpi: VizBlock {
    label: 'Gross Profit'
    settings {
      hide_controls: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_profit)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
      }
    }
  }

  block department_finance_table: VizBlock {
    label: 'Finance by Department'
    settings {
      hide_controls: true
    }
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          label: 'Department'
          ref: r(thelook_products.department)
          format {
            type: 'text'
          }
          uname: 'department'
        },
        VizFieldFull {
          label: 'Net Sales'
          ref: r(thelook.net_sales)
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'net_sales'
        },
        VizFieldFull {
          label: 'COGS'
          ref: r(thelook.cogs)
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'cogs'
        },
        VizFieldFull {
          label: 'Gross Profit'
          ref: r(thelook.gross_profit)
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'gross_profit'
        }
      ]
      settings {
        pagination_size: 100
        show_row_number: false
        wrap_header_text: false
        wrap_cell_text: false
        sorts: [
          KeyBasedSortSetting {
            key: 'net_sales'
            direction: 'desc'
          },
          KeyBasedSortSetting {
            key: 'department'
            direction: 'asc'
          }
        ]
        single_cell_display: 'normal'
      }
    }
  }

  block category_finance_table: VizBlock {
    label: 'Finance by Category'
    settings {
      hide_controls: true
    }
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          ref: r(thelook_products.category)
          label: 'Category'
          format {
            type: 'text'
          }
          uname: 'category'
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'net_sales'
        },
        VizFieldFull {
          ref: r(thelook.cogs)
          label: 'COGS'
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'cogs'
        },
        VizFieldFull {
          ref: r(thelook.gross_profit)
          label: 'Gross Profit'
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'gross_profit'
        }
      ]
      settings {
        pagination_size: 25
        show_row_number: false
        wrap_header_text: false
        wrap_cell_text: false
        sorts: [
          KeyBasedSortSetting {
            key: 'net_sales'
            direction: 'desc'
          }
        ]
        column_styles: [
          ColumnStyle {
            key: 'category'
            width: 220
          },
          ColumnStyle {
            key: 'net_sales'
            width: 120
          },
          ColumnStyle {
            key: 'cogs'
            width: 120
          },
          ColumnStyle {
            key: 'gross_profit'
            width: 130
          }
        ]
      }
    }
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'finance_period'
      to: ['net_sales_kpi', 'cogs_kpi', 'gross_profit_kpi', 'department_finance_table', 'category_finance_table']
      field: r(thelook_order_items.created_at)
    }
  ]

  view: HTMLLayout {
    content: @html
      <style>
        :root {
          --paper: #f7f8f6;
          --ink: #16302b;
          --green: #1f5a4d;
          --green-pale: #dce9df;
          --ochre: #bb7f31;
          --rule: #b9c5bd;
          --muted: #5d716a;
          --page-w: 210mm;
          --page-h: 297mm;
          --edge: 16mm;
        }

        * { box-sizing: border-box; }
        html { background: #dce1dc; scroll-behavior: smooth; }
        body {
          margin: 0;
          color: var(--ink);
          background: #dce1dc;
          font-family: Georgia, 'Times New Roman', serif;
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }
        .finance-report { padding: 10mm 0; }
        .page {
          width: var(--page-w);
          min-height: var(--page-h);
          margin: 0 auto 10mm;
          padding: var(--edge) var(--edge) 18mm;
          position: relative;
          overflow: hidden;
          background: var(--paper);
          box-shadow: 0 8px 30px rgba(22, 48, 43, .18);
          break-after: page;
          page-break-after: always;
        }
        .page:last-child { break-after: auto; page-break-after: auto; }
        .page::before {
          content: '';
          position: absolute;
          inset: 0;
          border-top: 4mm solid var(--green);
          pointer-events: none;
        }
        .page-header, .page-footer {
          display: flex;
          justify-content: space-between;
          align-items: baseline;
          color: var(--muted);
          font-family: Arial, Helvetica, sans-serif;
          font-size: 7.5pt;
          letter-spacing: .06em;
        }
        .page-header {
          padding: 3mm 0 4mm;
          border-bottom: 1px solid var(--rule);
        }
        .page-footer {
          position: absolute;
          right: var(--edge);
          bottom: 7mm;
          left: var(--edge);
          padding-top: 3mm;
          border-top: 1px solid var(--rule);
        }
        .folio { color: var(--green); font-weight: 700; }
        .cover { display: flex; flex-direction: column; }
        .cover-main { padding-top: 25mm; }
        .kicker, .section-tag {
          margin: 0 0 4mm;
          color: var(--ochre);
          font-family: Arial, Helvetica, sans-serif;
          font-size: 8pt;
          font-weight: 700;
          letter-spacing: .12em;
          text-transform: uppercase;
        }
        h1, h2, h3, p { margin-top: 0; }
        h1 {
          max-width: 130mm;
          margin-bottom: 7mm;
          color: var(--ink);
          font-size: 37pt;
          font-weight: 400;
          letter-spacing: -.035em;
          line-height: .97;
        }
        .deck { max-width: 118mm; color: var(--muted); font-size: 13pt; line-height: 1.45; }
        .filter-panel {
          max-width: 114mm;
          margin-top: 15mm;
          padding: 5mm 6mm;
          border-left: 3px solid var(--ochre);
          background: var(--green-pale);
        }
        .filter-panel h2 { margin-bottom: 2mm; font-size: 12pt; font-weight: 400; }
        .filter-panel p { margin-bottom: 3mm; color: var(--muted); font-size: 9pt; line-height: 1.4; }
        .contents { margin-top: 18mm; }
        .contents h2 { margin-bottom: 5mm; font-size: 15pt; font-weight: 400; }
        .contents ol { margin: 0; padding: 0; list-style: none; counter-reset: contents; }
        .contents li { counter-increment: contents; border-top: 1px solid var(--rule); }
        .contents li:last-child { border-bottom: 1px solid var(--rule); }
        .contents a {
          display: grid;
          grid-template-columns: 12mm 1fr auto;
          gap: 4mm;
          padding: 4mm 0;
          color: var(--ink);
          font-family: Arial, Helvetica, sans-serif;
          font-size: 10pt;
          text-decoration: none;
        }
        .contents a::before { content: counter(contents, decimal-leading-zero); color: var(--ochre); font-weight: 700; }
        .contents a:focus-visible { outline: 2px solid var(--ochre); outline-offset: 3px; }
        .contents .page-no { color: var(--muted); }
        .report-page h1 { margin-bottom: 5mm; font-size: 27pt; }
        .intro { max-width: 132mm; margin-bottom: 8mm; color: var(--muted); font-size: 10.5pt; line-height: 1.5; }
        .metric-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 2px solid var(--green); border-bottom: 1px solid var(--rule); }
        .metric-card { min-width: 0; padding: 5mm; border-right: 1px solid var(--rule); }
        .metric-card:last-child { border-right: 0; }
        .metric-card h2 { margin: 0 0 3mm; color: var(--muted); font-family: Arial, Helvetica, sans-serif; font-size: 8pt; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
        .statement { margin-top: 11mm; }
        .statement h2 { margin-bottom: 2mm; font-size: 17pt; font-weight: 400; }
        .statement-note { margin-bottom: 5mm; color: var(--muted); font-size: 9pt; line-height: 1.45; }
        .table-wrap { border-top: 2px solid var(--green); }
        .definitions { margin: 3mm 0 0; }
        .definition { padding: 5mm 0; border-top: 1px solid var(--rule); }
        .definition:last-child { border-bottom: 1px solid var(--rule); }
        .definition h2 { margin-bottom: 2mm; color: var(--green); font-size: 15pt; font-weight: 400; }
        .definition p { max-width: 150mm; margin: 0; color: #314942; font-size: 10pt; line-height: 1.5; }
        .method-note { margin-top: 9mm; padding: 5mm 6mm; border-left: 3px solid var(--ochre); background: var(--green-pale); color: #314942; font-size: 9pt; line-height: 1.45; }
        h-block { display: block; }
        .metric-card h-block { min-height: 28mm; }
        .table-wrap h-block { min-height: 130mm; }

        @media screen and (max-width: 760px) {
          .finance-report { padding: 0; }
          .page { width: 100%; min-height: 0; margin: 0; padding: 10mm 7vw 18mm; box-shadow: none; }
          .page-footer { right: 7vw; left: 7vw; }
          h1 { font-size: 30pt; }
          .metric-grid { grid-template-columns: 1fr; }
          .metric-card { border-right: 0; border-bottom: 1px solid var(--rule); }
          .metric-card:last-child { border-bottom: 0; }
        }
        @media print {
          @page { size: A4 portrait; margin: 0; }
          html, body { background: var(--paper); }
          .finance-report { padding: 0; }
          .page { width: 210mm; height: 297mm; min-height: 297mm; margin: 0; box-shadow: none; overflow: hidden; }
          a { color: inherit; text-decoration: none; }
        }
      </style>

      <main class="finance-report" aria-label="Finance report">
        <section class="page cover" id="cover" aria-labelledby="report-title">
          <header class="page-header"><span>Finance report</span><span>Period-controlled statement</span></header>
          <div class="cover-main">
            <p class="kicker">A4 print edition</p>
            <h1 id="report-title">Finance<br>report</h1>
            <p class="deck">A concise financial statement for reviewing governed Net Sales, COGS and Gross Profit by product department and category.</p>
            <div class="filter-panel" aria-label="Reporting period control">
              <h2>Choose a reporting period</h2>
              <p>This optional control applies the selected period to every financial metric and statement in this report. No period is preselected.</p>
              <h-block name="finance_period" />
            </div>
            <nav class="contents" aria-label="Report contents">
              <h2>Contents</h2>
              <ol>
                <li><a href="#summary"><span>Financial summary</span><span class="page-no">02</span></a></li>
                <li><a href="#department"><span>Statement by department</span><span class="page-no">03</span></a></li>
                <li><a href="#category"><span>Statement by category</span><span class="page-no">04</span></a></li>
                <li><a href="#definitions"><span>Metric definitions</span><span class="page-no">05</span></a></li>
              </ol>
            </nav>
          </div>
          <footer class="page-footer"><span>Finance report</span><span class="folio">01 / 05</span></footer>
        </section>

        <section class="page report-page" id="summary" aria-labelledby="summary-title">
          <header class="page-header"><span>Finance report</span><span>Reporting period selected in report controls</span></header>
          <p class="section-tag">Financial summary</p>
          <h1 id="summary-title">The period at a glance</h1>
          <p class="intro">The primary financial measures are shown together so the relationship from sales to product cost to gross profit remains visible.</p>
          <div class="metric-grid">
            <article class="metric-card"><h2>Net Sales</h2><h-block name="net_sales_kpi" /></article>
            <article class="metric-card"><h2>COGS</h2><h-block name="cogs_kpi" /></article>
            <article class="metric-card"><h2>Gross Profit</h2><h-block name="gross_profit_kpi" /></article>
          </div>
          <div class="statement">
            <p class="section-tag">Reading this page</p>
            <h2>Governed measures, one period</h2>
            <p class="statement-note">Use the reporting-period control on the cover before printing. All three KPIs and both following statements use the same selected order-item creation period.</p>
          </div>
          <footer class="page-footer"><span>Finance report · Financial summary</span><span class="folio">02 / 05</span></footer>
        </section>

        <section class="page report-page" id="department" aria-labelledby="department-title">
          <header class="page-header"><span>Finance report</span><span>Reporting period selected in report controls</span></header>
          <p class="section-tag">Statement detail</p>
          <h1 id="department-title">By department</h1>
          <p class="intro">Department results are ordered by Net Sales, with COGS and Gross Profit kept alongside for direct comparison.</p>
          <div class="table-wrap"><h-block name="department_finance_table" /></div>
          <footer class="page-footer"><span>Finance report · Department statement</span><span class="folio">03 / 05</span></footer>
        </section>

        <section class="page report-page" id="category" aria-labelledby="category-title">
          <header class="page-header"><span>Finance report</span><span>Reporting period selected in report controls</span></header>
          <p class="section-tag">Statement detail</p>
          <h1 id="category-title">By category</h1>
          <p class="intro">Category results are ordered by Net Sales to make the leading product groups immediately scannable in a printed statement.</p>
          <div class="table-wrap"><h-block name="category_finance_table" /></div>
          <footer class="page-footer"><span>Finance report · Category statement</span><span class="folio">04 / 05</span></footer>
        </section>

        <section class="page report-page" id="definitions" aria-labelledby="definitions-title">
          <header class="page-header"><span>Finance report</span><span>Reporting period selected in report controls</span></header>
          <p class="section-tag">Reference</p>
          <h1 id="definitions-title">Metric definitions</h1>
          <p class="intro">These definitions are governed in the dataset and apply consistently to the summary and both statements.</p>
          <div class="definitions">
            <article class="definition"><h2>Net Sales</h2><p>Sum of order-item sale price, excluding order items with a Cancelled or Returned status. Display format is inherited currency: [$]#,###0.</p></article>
            <article class="definition"><h2>COGS</h2><p>Sum of product cost for the same order items included in Net Sales, excluding Cancelled and Returned statuses. Display format is inherited currency: [$]#,###0.</p></article>
            <article class="definition"><h2>Gross Profit</h2><p>Governed Net Sales less governed COGS. Display format is inherited currency: [$]#,###0.</p></article>
          </div>
          <aside class="method-note"><strong>Period application.</strong> The reporting-period filter is intentionally blank by default and is mapped to all five data blocks through the order-item created-at field.</aside>
          <footer class="page-footer"><span>Finance report · Definitions</span><span class="folio">05 / 05</span></footer>
        </section>
      </main>
    ;;
  }
}
