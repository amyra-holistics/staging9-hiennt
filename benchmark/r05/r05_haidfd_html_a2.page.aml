Dashboard r05_haidfd_html_a2 {
  title: 'Finance Report'
  description: @md
A print-ready financial statement pack for the selected reporting period. Use the Report Period control before printing.
;;

  settings {
    autorun_on_open: true
    autorun_on_changes: true
    cache_duration: 360
  }

  block f_reporting_period: FilterBlock {
    label: 'Report Period'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block v_net_sales: VizBlock {
    label: 'Net Sales'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block v_cogs: VizBlock {
    label: 'COGS'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.cogs)
        label: 'COGS'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block v_gross_profit: VizBlock {
    label: 'Gross Profit'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_profit)
        label: 'Gross Profit'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block v_finance_department: VizBlock {
    label: 'Financial Statement by Department'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          ref: r(thelook_products.department)
          label: 'Product Department'
          format { type: 'text' }
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.cogs)
          label: 'COGS'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.gross_profit)
          label: 'Gross Profit'
          uname: 'gross_profit'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
      ]
      settings {
        show_row_number: false
        wrap_header_text: true
        wrap_cell_text: false
        sorts: [
          KeyBasedSortSetting {
            key: 'gross_profit'
            direction: 'desc'
          }
        ]
      }
    }
  }

  block v_finance_category: VizBlock {
    label: 'Financial Statement by Category'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          label: 'Product Category'
          ref: r(thelook_products.category)
          format { type: 'text' }
        },
        VizFieldFull {
          label: 'Net Sales'
          ref: r(thelook.net_sales)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'COGS'
          ref: r(thelook.cogs)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'Gross Profit'
          ref: r(thelook.gross_profit)
          uname: 'gross_profit'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
      ]
      settings {
        pagination_size: 100
        show_row_number: false
        wrap_header_text: true
        wrap_cell_text: false
        sorts: [
          KeyBasedSortSetting {
            key: 'gross_profit'
            direction: 'desc'
          }
        ]
      }
    }
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'f_reporting_period'
      to: ['v_net_sales', 'v_cogs', 'v_gross_profit', 'v_finance_department', 'v_finance_category']
      field: r(thelook_order_items.created_at)
    }
  ]

  view: HTMLLayout {
    content: @html
<style>
  .finance-report, .finance-report * { box-sizing: border-box; }
  .finance-report {
    --ink: #17202a;
    --navy: #17365d;
    --blue: #2d6a9f;
    --paper: #ffffff;
    --wash: #eef3f8;
    --rule: #afbdca;
    --muted: #5e6d7d;
    --page-w: 210mm;
    --page-h: 297mm;
    --margin-x: 16mm;
    --margin-y: 15mm;
    color: var(--ink);
    font-family: Georgia, 'Times New Roman', serif;
    background: #d9e1e8;
    padding: 10mm 0;
  }
  .finance-report .page {
    width: var(--page-w);
    min-height: var(--page-h);
    margin: 0 auto 10mm;
    padding: var(--margin-y) var(--margin-x) 20mm;
    background: var(--paper);
    position: relative;
    overflow: hidden;
    box-shadow: 0 5px 22px rgba(23, 54, 93, .18);
    page-break-after: always;
    break-after: page;
  }
  .finance-report .page:last-child { page-break-after: auto; break-after: auto; }
  .finance-report .page-header {
    display: flex;
    justify-content: space-between;
    align-items: end;
    border-bottom: 1.5px solid var(--navy);
    padding-bottom: 3.5mm;
    margin-bottom: 8mm;
    color: var(--navy);
  }
  .finance-report .brand { font-size: 10pt; font-weight: 700; letter-spacing: .03em; }
  .finance-report .period-label { font-family: Arial, sans-serif; font-size: 8pt; color: var(--muted); }
  .finance-report .page-footer {
    position: absolute;
    left: var(--margin-x); right: var(--margin-x); bottom: 7mm;
    display: flex; justify-content: space-between;
    border-top: 1px solid var(--rule);
    padding-top: 2.5mm;
    font-family: Arial, sans-serif;
    font-size: 7.5pt;
    color: var(--muted);
  }
  .finance-report h1 { margin: 0; color: var(--navy); font-size: 33pt; line-height: 1.05; font-weight: 700; }
  .finance-report h2 { margin: 0 0 2mm; color: var(--navy); font-size: 19pt; }
  .finance-report h3 { margin: 0 0 4mm; color: var(--navy); font: 700 9pt/1.2 Arial, sans-serif; letter-spacing: .08em; text-transform: uppercase; }
  .finance-report p { margin: 0 0 4mm; font-size: 10.5pt; line-height: 1.5; }
  .finance-report .deck { max-width: 120mm; margin-top: 8mm; color: var(--muted); font-size: 13pt; line-height: 1.45; }
  .finance-report .rule { height: 8px; width: 54mm; margin: 9mm 0; background: var(--blue); }
  .finance-report .control-wrap { margin-top: 14mm; max-width: 78mm; }
  .finance-report .fine-print { margin-top: 7mm; color: var(--muted); font: 8.5pt/1.45 Arial, sans-serif; }
  .finance-report .toc { margin: 12mm 0 0; padding: 0; list-style: none; border-top: 1px solid var(--rule); }
  .finance-report .toc li { border-bottom: 1px solid var(--rule); }
  .finance-report .toc a { display: flex; justify-content: space-between; padding: 5mm 0; color: var(--ink); text-decoration: none; font-size: 13pt; }
  .finance-report .toc a:hover { color: var(--blue); }
  .finance-report .toc .toc-no { color: var(--blue); font: 700 9pt Arial, sans-serif; }
  .finance-report .kpi-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 2px solid var(--navy); border-bottom: 1px solid var(--rule); margin: 5mm 0 8mm; }
  .finance-report .kpi { min-height: 36mm; padding: 5mm; border-right: 1px solid var(--rule); }
  .finance-report .kpi:last-child { border-right: 0; }
  .finance-report .kpi-label { margin-top: 3mm; color: var(--muted); font: 700 8pt Arial, sans-serif; letter-spacing: .06em; text-transform: uppercase; }
  .finance-report .statement { border: 1px solid var(--rule); padding: 5mm; background: #fff; }
  .finance-report .statement h-block { display: block; }
  .finance-report .definition-list { margin: 7mm 0 0; border-top: 2px solid var(--navy); }
  .finance-report .definition { display: grid; grid-template-columns: 42mm 1fr; gap: 6mm; padding: 4.5mm 0; border-bottom: 1px solid var(--rule); }
  .finance-report .definition dt { color: var(--navy); font-weight: 700; font-size: 11pt; }
  .finance-report .definition dd { margin: 0; font-size: 10pt; line-height: 1.45; }
  .finance-report .report-note { padding: 4mm 5mm; margin-bottom: 5mm; background: var(--wash); border-left: 3px solid var(--blue); color: #405366; font: 9pt/1.45 Arial, sans-serif; }
  @media screen and (max-width: 215mm) {
    .finance-report { padding: 0; background: var(--paper); }
    .finance-report .page { width: 100%; min-height: auto; margin: 0; box-shadow: none; }
  }
  @media print {
    @page { size: A4 portrait; margin: 0; }
    .finance-report { background: var(--paper); padding: 0; }
    .finance-report .page { width: 210mm; height: 297mm; min-height: 297mm; margin: 0; box-shadow: none; page-break-after: always; break-after: page; }
    .finance-report .page:last-child { page-break-after: auto; break-after: auto; }
    .finance-report a { color: inherit; text-decoration: none; }
    .finance-report, .finance-report * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  }
</style>

<div class="finance-report">
  <!-- PAGE 1: COVER AND TABLE OF CONTENTS -->
  <section class="page" id="cover">
    <header class="page-header">
      <div class="brand">Finance statement pack</div>
      <div class="period-label">Selected reporting period is controlled below</div>
    </header>
    <h1>Financial<br>Performance Report</h1>
    <div class="rule"></div>
    <p class="deck">A concise statement pack for net sales, cost of goods sold, and gross profit. Select the reporting period before reviewing or printing the report.</p>
    <div class="control-wrap"><h-block name="f_reporting_period" /></div>
    <p class="fine-print">All financial statements in this report use the selected Report Period based on order-item created date.</p>
    <h3 style="margin-top: 17mm;">Contents</h3>
    <ol class="toc">
      <li><a href="#summary"><span><span class="toc-no">01</span> Executive financial summary</span><span>→</span></a></li>
      <li><a href="#department"><span><span class="toc-no">02</span> Financial statement by department</span><span>→</span></a></li>
      <li><a href="#category"><span><span class="toc-no">03</span> Financial statement by category</span><span>→</span></a></li>
      <li><a href="#definitions"><span><span class="toc-no">04</span> Metric definitions</span><span>→</span></a></li>
    </ol>
    <footer class="page-footer"><span>Finance Report</span><span>Selected reporting period</span><span>Page 1 of 5</span></footer>
  </section>

  <!-- PAGE 2: SUMMARY -->
  <section class="page" id="summary">
    <header class="page-header"><div class="brand">Finance statement pack</div><div class="period-label">Selected reporting period · Report Period filter</div></header>
    <h2>Executive financial summary</h2>
    <p>Headline financial results for the selected reporting period.</p>
    <div class="kpi-grid">
      <div class="kpi"><h-block name="v_net_sales" /><div class="kpi-label">Net Sales</div></div>
      <div class="kpi"><h-block name="v_cogs" /><div class="kpi-label">Cost of Goods Sold</div></div>
      <div class="kpi"><h-block name="v_gross_profit" /><div class="kpi-label">Gross Profit</div></div>
    </div>
    <div class="report-note"><strong>Reading this report.</strong> Net Sales and COGS include order items excluding Cancelled and Returned statuses. Gross Profit is Net Sales less COGS.</div>
    <h3>Statement scope</h3>
    <p>The department and category statements that follow use the same selected reporting period and the same metric definitions as this summary.</p>
    <footer class="page-footer"><span>Finance Report</span><span>Selected reporting period · Report Period filter</span><span>Page 2 of 5</span></footer>
  </section>

  <!-- PAGE 3: DEPARTMENT STATEMENT -->
  <section class="page" id="department">
    <header class="page-header"><div class="brand">Finance statement pack</div><div class="period-label">Selected reporting period · Report Period filter</div></header>
    <h2>Financial statement by department</h2>
    <p>Departments are ranked by gross profit, descending.</p>
    <div class="statement"><h-block name="v_finance_department" /></div>
    <footer class="page-footer"><span>Finance Report</span><span>Selected reporting period · Report Period filter</span><span>Page 3 of 5</span></footer>
  </section>

  <!-- PAGE 4: CATEGORY STATEMENT -->
  <section class="page" id="category">
    <header class="page-header"><div class="brand">Finance statement pack</div><div class="period-label">Selected reporting period · Report Period filter</div></header>
    <h2>Financial statement by category</h2>
    <p>Categories are ranked by gross profit, descending.</p>
    <div class="statement"><h-block name="v_finance_category" /></div>
    <footer class="page-footer"><span>Finance Report</span><span>Selected reporting period · Report Period filter</span><span>Page 4 of 5</span></footer>
  </section>

  <!-- PAGE 5: DEFINITIONS -->
  <section class="page" id="definitions">
    <header class="page-header"><div class="brand">Finance statement pack</div><div class="period-label">Selected reporting period · Report Period filter</div></header>
    <h2>Metric definitions</h2>
    <p>Use these definitions when interpreting all statements in this report.</p>
    <dl class="definition-list">
      <div class="definition"><dt>Report Period</dt><dd>The date range selected in the Report Period control, applied using <em>Order Items · Created at</em>.</dd></div>
      <div class="definition"><dt>Net Sales</dt><dd>Sale price of order items, excluding items with Cancelled and Returned statuses.</dd></div>
      <div class="definition"><dt>COGS</dt><dd>Product cost for order items included in Net Sales; it excludes Cancelled and Returned items.</dd></div>
      <div class="definition"><dt>Gross Profit</dt><dd>Net Sales less COGS.</dd></div>
      <div class="definition"><dt>Department</dt><dd>Product department associated with each order item.</dd></div>
      <div class="definition"><dt>Category</dt><dd>Product category associated with each order item.</dd></div>
    </dl>
    <footer class="page-footer"><span>Finance Report</span><span>Selected reporting period · Report Period filter</span><span>Page 5 of 5</span></footer>
  </section>
</div>
;;
  }

  theme {
    block {
      background { bg_color: 'transparent' }
      border { border_width: 0 }
    }
  }
}
