Dashboard r05_haidfd_html_a3 {
  title: 'Profitability Review — Jan to Sep 2026'
  description: @md
    Printable finance report covering Net Sales, COGS, Gross Profit, and Gross Margin for 01 Jan–30 Sep 2026.
  ;;

  block kpi_net_sales: VizBlock {
    label: 'Net Sales'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format { type: 'number' pattern: 'inherited' }
      }
      filter {
        field: r(thelook_order_items.created_at)
        operator: 'matches'
        value: '@2026-01-01 - @2026-09-30'
      }
    }
    settings { hide_label: true }
  }

  block kpi_cogs: VizBlock {
    label: 'COGS'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.cogs)
        label: 'COGS'
        format { type: 'number' pattern: 'inherited' }
      }
      filter {
        field: r(thelook_order_items.created_at)
        operator: 'matches'
        value: '@2026-01-01 - @2026-09-30'
      }
    }
    settings { hide_label: true }
  }

  block kpi_gross_profit: VizBlock {
    label: 'Gross Profit'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_profit)
        label: 'Gross Profit'
        format { type: 'number' pattern: 'inherited' }
      }
      filter {
        field: r(thelook_order_items.created_at)
        operator: 'matches'
        value: '@2026-01-01 - @2026-09-30'
      }
    }
    settings { hide_label: true }
  }

  block tbl_department_profitability: VizBlock {
    label: 'Profitability by Department'
    viz: DataTable {
  dataset: thelook
  fields: [
    VizFieldFull {
      ref: r(thelook_products.department)
      label: 'Product Department'
      format {
        type: 'text'
      }
      uname: 'product_department'
    },
    VizFieldFull {
      ref: r(thelook.net_sales)
      label: 'Net Sales'
      format {
        type: 'number'
        pattern: 'inherited'
      }
    },
    VizFieldFull {
      ref: r(thelook.cogs)
      label: 'COGS'
      format {
        type: 'number'
        pattern: 'inherited'
      }
    },
    VizFieldFull {
      ref: r(thelook.gross_profit)
      label: 'Gross Profit'
      format {
        type: 'number'
        pattern: 'inherited'
      }
      uname: 'gross_profit'
    },
    VizFieldFull {
      ref: r(thelook.gross_margin)
      label: 'Gross Margin'
      format {
        type: 'number'
        pattern: 'inherited'
      }
    },
  ]
  conditions: [
    "thelook_order_items.created_at is @(2026-01-01 to 2026-09-30)",
  ]
  settings {
    pagination_size: 100
    show_row_number: false
    wrap_header_text: false
    wrap_cell_text: false
    sorts: [
      KeyBasedSortSetting {
        key: 'gross_profit'
        direction: 'desc'
      },
    ]
    column_styles: [
      ColumnStyle {
        key: 'product_department'
        width: 170
      },
    ]
  }
}
  }

  block tbl_category_profitability: VizBlock {
    label: 'Profitability by Category'
    viz: DataTable {
  dataset: thelook
  conditions: [
    "thelook_order_items.created_at matches @(2026-01-01 - 2026-09-30)",
  ]
  fields: [
    VizFieldFull {
      label: 'Product Category'
      ref: r(thelook_products.category)
      format {
        type: 'text'
      }
    },
    VizFieldFull {
      label: 'Net Sales'
      ref: r(thelook.net_sales)
      format {
        type: 'number'
        pattern: 'inherited'
      }
    },
    VizFieldFull {
      label: 'COGS'
      ref: r(thelook.cogs)
      format {
        type: 'number'
        pattern: 'inherited'
      }
    },
    VizFieldFull {
      label: 'Gross Profit'
      ref: r(thelook.gross_profit)
      uname: 'custom_gross_profit_1'
      format {
        type: 'number'
        pattern: 'inherited'
      }
    },
    VizFieldFull {
      label: 'Gross Margin'
      ref: r(thelook.gross_margin)
      format {
        type: 'number'
        pattern: 'inherited'
      }
    },
  ]
  settings {
    pagination_size: 100
    show_row_number: false
    wrap_header_text: false
    wrap_cell_text: false
    sorts: [
      KeyBasedSortSetting {
        key: 'custom_gross_profit_1'
        direction: 'desc'
      }
    ]
    single_cell_display: 'normal'
  }
}
  }

  explicit_interactions: []

  view: HTMLLayout {
    content: @html
      <style>
        :root {
          --ink:#17212B; --navy:#254E70; --teal:#2F7F7B;
          --muted:#5F6B76; --rule:#D7DEE4; --soft:#F4F7F9;
          --paper:#FFFFFF; --page-w:210mm; --page-h:297mm; --edge:14mm;
        }
        * { box-sizing:border-box; }
        html { scroll-behavior:smooth; }
        body {
          margin:0; color:var(--ink); background:#E9EEF2;
          font-family:Arial, Helvetica, sans-serif;
          -webkit-print-color-adjust:exact; print-color-adjust:exact;
        }
        .page {
          width:var(--page-w); min-height:var(--page-h); margin:0 auto 8mm;
          padding:var(--edge) var(--edge) 18mm; position:relative;
          background:var(--paper); box-shadow:0 5px 22px rgba(23,33,43,.15);
        }
        .page-header {
          display:flex; justify-content:space-between; align-items:flex-end;
          border-bottom:2px solid var(--navy); padding-bottom:4mm; margin-bottom:7mm;
        }
        .brand { font-size:9pt; font-weight:700; color:var(--navy); }
        .period { font-size:8pt; color:var(--muted); text-align:right; }
        .period strong { color:var(--ink); }
        .report-title { font-size:29pt; line-height:1; letter-spacing:-.04em; margin:0 0 2mm; }
        .subtitle { margin:0; color:var(--muted); font-size:10pt; }
        .kpi-grid { display:grid; grid-template-columns:repeat(3,1fr); border:1px solid var(--rule); margin:7mm 0; }
        .kpi { min-height:29mm; padding:5mm; border-right:1px solid var(--rule); }
        .kpi:last-child { border-right:0; }
        .kpi-label, .section-kicker { color:var(--teal); font-size:8pt; font-weight:700; letter-spacing:.05em; }
        .kpi-label { margin-top:2mm; }
        .section { margin:0 0 7mm; break-inside:avoid; page-break-inside:avoid; }
        .section h2 { margin:0 0 2mm; font-size:17pt; letter-spacing:-.02em; }
        .section-intro { margin:0 0 4mm; color:var(--muted); font-size:9pt; }
        .toc { display:grid; grid-template-columns:1fr 1fr; gap:3mm 8mm; margin-top:5mm; }
        .toc a { color:var(--navy); text-decoration:none; border-bottom:1px solid var(--rule); padding:2.5mm 0; font-size:10pt; }
        .toc a:hover { color:var(--teal); }
        .basis { margin-top:7mm; padding:4mm; background:var(--soft); border-left:3px solid var(--teal); font-size:8.5pt; line-height:1.45; }
        .definitions { width:100%; border-collapse:collapse; font-size:8.5pt; }
        .definitions th { color:var(--navy); background:var(--soft); text-align:left; }
        .definitions th, .definitions td { padding:2.2mm; border:1px solid var(--rule); vertical-align:top; }
        .table-shell { border:1px solid var(--rule); padding:2mm; }
        .category-page .table-shell { font-size:7.5pt; }
        .page-footer {
          position:absolute; left:var(--edge); right:var(--edge); bottom:6mm;
          display:flex; justify-content:space-between; border-top:1px solid var(--rule);
          padding-top:2.5mm; color:var(--muted); font-size:7.5pt;
        }
        @media print {
          @page { size:A4 portrait; margin:0; }
          body { background:var(--paper); }
          .page { margin:0; box-shadow:none; break-after:page; page-break-after:always; }
          .page:last-child { break-after:auto; page-break-after:auto; }
          a { color:inherit; text-decoration:none; }
          .toc a { display:none; }
        }
      </style>

      <!-- Page 1: executive summary and linked contents -->
      <section class="page" id="summary">
        <header class="page-header">
          <div>
            <div class="brand">FINANCE REPORT</div>
            <h1 class="report-title">Profitability review</h1>
            <p class="subtitle">Net Sales, COGS and Gross Profit</p>
          </div>
          <div class="period">Selected period<br><strong>01 Jan–30 Sep 2026</strong></div>
        </header>
        <div class="kpi-grid">
          <div class="kpi"><h-block name="kpi_net_sales" /><div class="kpi-label">Net Sales</div></div>
          <div class="kpi"><h-block name="kpi_cogs" /><div class="kpi-label">COGS</div></div>
          <div class="kpi"><h-block name="kpi_gross_profit" /><div class="kpi-label">Gross Profit</div></div>
        </div>
        <div class="section">
          <div class="section-kicker">Navigation</div>
          <h2>Contents</h2>
          <nav class="toc" aria-label="Report contents">
            <a href="#summary">Executive summary</a>
            <a href="#department">Department profitability</a>
            <a href="#category">Category profitability</a>
            <a href="#definitions">Metric definitions</a>
          </nav>
        </div>
        <aside class="basis"><strong>Reporting basis.</strong> Calendar period is fixed to 01 Jan–30 Sep 2026 using Order Items Created at. Net Sales and COGS exclude Cancelled and Returned order items. Values are in dollars.</aside>
        <footer class="page-footer"><span>Finance report</span><span>Selected period: 01 Jan–30 Sep 2026</span><span>Page 1 of 3</span></footer>
      </section>

      <!-- Page 2: department analysis -->
      <section class="page" id="department">
        <header class="page-header"><div class="brand">FINANCE REPORT</div><div class="period">Selected period<br><strong>01 Jan–30 Sep 2026</strong></div></header>
        <div class="section">
          <div class="section-kicker">Section 1</div>
          <h2>Profitability by department</h2>
          <p class="section-intro">Net Sales, COGS, Gross Profit and Gross Margin, ranked by Gross Profit.</p>
          <div class="table-shell"><h-block name="tbl_department_profitability" /></div>
        </div>
        <footer class="page-footer"><span>Finance report</span><span>Selected period: 01 Jan–30 Sep 2026</span><span>Page 2 of 3</span></footer>
      </section>

      <!-- Page 3: category analysis and definitions -->
      <section class="page category-page" id="category">
        <header class="page-header"><div class="brand">FINANCE REPORT</div><div class="period">Selected period<br><strong>01 Jan–30 Sep 2026</strong></div></header>
        <div class="section">
          <div class="section-kicker">Section 2</div>
          <h2>Profitability by category</h2>
          <p class="section-intro">Net Sales, COGS, Gross Profit and Gross Margin, ranked by Gross Profit.</p>
          <div class="table-shell"><h-block name="tbl_category_profitability" /></div>
        </div>
        <div class="section" id="definitions">
          <div class="section-kicker">Reference</div>
          <h2>Metric definitions</h2>
          <table class="definitions">
            <thead><tr><th>Metric</th><th>Definition</th></tr></thead>
            <tbody>
              <tr><td>Net Sales</td><td>Sale price of order items excluding Cancelled and Returned items.</td></tr>
              <tr><td>COGS</td><td>Product cost of the same order items included in Net Sales.</td></tr>
              <tr><td>Gross Profit</td><td>Net Sales minus COGS.</td></tr>
              <tr><td>Gross Margin</td><td>Gross Profit divided by Net Sales.</td></tr>
            </tbody>
          </table>
        </div>
        <footer class="page-footer"><span>Finance report</span><span>Selected period: 01 Jan–30 Sep 2026</span><span>Page 3 of 3</span></footer>
      </section>
    ;;
  }
}
