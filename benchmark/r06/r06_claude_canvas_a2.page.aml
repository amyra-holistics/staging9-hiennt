Dashboard r06_claude_canvas_a2 {
  title: 'Marketing Funnel: Traffic Sources'
  description: 'Where website sessions come from and how well each traffic source converts to a purchase.'

  block title: TextBlock {
    content: @md
      # Marketing Funnel: Traffic Sources
      Website sessions and purchase conversion by traffic source, all time.
    ;;
  }

  block headline: VizBlock {
    label: 'Headline'
    settings {
      hide_label: true
      hide_controls: true
    }
    viz: MarkdownViz {
      dataset: thelook
      values: [
        VizFieldFull {
          ref: r(thelook.sessions)
          label: 'Sessions'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.purchase_conversion_rate)
          label: 'Purchase Conversion Rate'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
      ]
      content: @md
        <h2 style="font-size: 1.75rem; line-height: 1.3; font-weight: 600; color: #111827; margin: 0;">
          <span style="color: #255DD4;">{{ rows[0].values.`Sessions` }}</span> website sessions converted to a purchase
          <span style="color: #255DD4;">{{ rows[0].values.`Purchase Conversion Rate` }}</span> of the time.
        </h2>
      ;;
    }
  }

  block v_sessions_by_source: VizBlock {
    label: 'Sessions by Traffic Source'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_events.traffic_source)
        label: 'Traffic Source'
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.sessions)
            label: 'Sessions'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block t_sessions_commentary: TextBlock {
    content: @md
      ### Email and Adwords bring most of the traffic

      - **Email** is the largest source, with about **45%** of sessions.
      - **Adwords** is second, with about **30%**.
      - **Facebook**, **YouTube** and **Organic** together make up the last quarter. Organic is the smallest, at about 5%.

      Traffic depends heavily on two paid or owned channels. A drop in email sends or ad spend would show up quickly in total sessions.
    ;;
  }

  block v_conversion_by_source: VizBlock {
    label: 'Purchase Conversion Rate by Traffic Source'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_events.traffic_source)
        label: 'Traffic Source'
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.purchase_conversion_rate)
            label: 'Purchase Conversion Rate'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block t_conversion_commentary: TextBlock {
    content: @md
      ### Conversion is almost the same everywhere

      - Every source converts at roughly **26.5% to 27%** of sessions.
      - **Organic** is marginally the best, but on the smallest volume, so the gap is within noise.

      Sources differ in **how many** visitors they bring, not in **how well** those visitors buy. To grow purchases, grow volume in the big channels rather than shifting budget toward a "better converting" one.
    ;;
  }

  view: CanvasLayout {
    label: 'View 1'
    width: 1200
    height: 900
    grid_size: 20
    auto_expand_vertically: true
    block title {
      position: pos(20, 20, 1160, 80)
    }
    block headline {
      position: pos(20, 100, 1160, 80)
    }
    block v_sessions_by_source {
      position: pos(20, 200, 740, 320)
    }
    block t_sessions_commentary {
      position: pos(780, 200, 400, 320)
    }
    block v_conversion_by_source {
      position: pos(20, 540, 740, 320)
    }
    block t_conversion_commentary {
      position: pos(780, 540, 400, 320)
    }
    mobile {
      mode: 'auto'
    }
  }

  theme: H.themes.vanilla
}
