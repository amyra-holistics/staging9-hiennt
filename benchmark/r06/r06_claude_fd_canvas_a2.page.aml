Dashboard r06_claude_fd_canvas_a2 {
  title: 'Marketing Funnel: Traffic Sources'
  description: 'Where website sessions come from, and how well each traffic source converts to a purchase.'

  block title: TextBlock {
    content: @md
      # Marketing Funnel: Traffic Sources
      Website sessions and purchase conversion by acquisition channel · TheLook eCommerce
    ;;
  }

  block headline: VizBlock {
    label: 'Headline'
    viz: MarkdownViz {
      dataset: thelook
      values: [
        VizFieldFull {
          ref: r(thelook.sessions)
          label: 'Sessions'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.purchase_conversion_rate)
          label: 'Purchase Conversion Rate'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      content: @md
        <h2>{{ rows[0].values.`Sessions`.formatted }} sessions reached the site, and {{ rows[0].values.`Purchase Conversion Rate`.formatted }} of them ended in a purchase. Traffic source changes how many visitors arrive, not how well they convert.</h2>
      ;;
    }
    settings {
      hide_label: true
    }
  }

  block v_sessions_by_source: VizBlock {
    label: 'Sessions by Traffic Source'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_events.traffic_source)
        label: 'Traffic Source'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.sessions)
            label: 'Sessions'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#2F5BEA'
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      settings {
        legend_label: 'hidden'
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block t_sessions_commentary: TextBlock {
    content: @md
      ### Volume is concentrated in two channels
      **Email** and **Adwords** bring in about three quarters of all sessions. Email alone accounts for close to half.

      **Facebook** and **YouTube** are about the same size, each roughly a third of Adwords. **Organic** is the smallest source.

      *Takeaway:* top-of-funnel reach depends heavily on paid search and email. A drop in either would show up right away in total sessions.
    ;;
  }

  block v_conversion_by_source: VizBlock {
    label: 'Purchase Conversion Rate by Traffic Source'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_events.traffic_source)
        label: 'Traffic Source'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.purchase_conversion_rate)
            label: 'Purchase Conversion Rate'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#E07A1F'
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      settings {
        legend_label: 'hidden'
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block t_conversion_commentary: TextBlock {
    content: @md
      ### Conversion is flat across channels
      Every source converts within about half a point of the others. **Organic** and **Facebook** sit slightly ahead, and the two biggest channels, **Email** and **Adwords**, sit slightly behind.

      Once a visitor lands, the channel that brought them barely matters.

      *Takeaway:* growth comes from **more sessions**, not from shifting the channel mix. Budget should follow cost per session, and conversion work belongs on-site, not in channel targeting.
    ;;
  }

  view: CanvasLayout {
    label: 'View 1'
    width: 1200
    height: 900
    grid_size: 20
    auto_expand_vertically: true
    block title {
      position: pos(20, 20, 1160, 80)
    }
    block headline {
      position: pos(20, 100, 1160, 100)
    }
    block v_sessions_by_source {
      position: pos(20, 220, 760, 320)
    }
    block t_sessions_commentary {
      position: pos(800, 220, 380, 320)
    }
    block v_conversion_by_source {
      position: pos(20, 560, 760, 320)
    }
    block t_conversion_commentary {
      position: pos(800, 560, 380, 320)
    }
    mobile {
      mode: 'auto'
    }
  }

  theme: H.themes.vanilla
}
