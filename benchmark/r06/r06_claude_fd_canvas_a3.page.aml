Dashboard r06_claude_fd_canvas_a3 {
  title: 'Marketing Funnel: Traffic Sources'
  description: 'Where website sessions come from and how well each traffic source converts to a purchase.'

  block title: TextBlock {
    content: @md
      <div style="font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: #6B7280;">TheLook eCommerce · Marketing funnel</div>
      <div style="font-size: 26px; font-weight: 600; color: #111827;">Traffic sources: volume vs. quality</div>
    ;;
  }

  block headline: VizBlock {
    label: 'Headline'
    settings {
      hide_label: true
    }
    viz: MarkdownViz {
      dataset: thelook
      values: [
        VizFieldFull {
          ref: r(thelook.sessions)
          label: 'Sessions'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.purchase_conversion_rate)
          label: 'Purchase Conversion Rate'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      content: @md
        <div style="font-size: 20px; line-height: 1.5; color: #1F2937;">
          The site has logged <strong style="color: #2563EB;">{{ rows[0].values.`Sessions` }}</strong> sessions, and <strong style="color: #2563EB;">{{ rows[0].values.`Purchase Conversion Rate` }}</strong> of them ended in a purchase.
        </div>
      ;;
    }
  }

  block sessions_by_source: VizBlock {
    label: 'Sessions by traffic source'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_events.traffic_source)
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.sessions)
            label: 'Sessions'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#2563EB'
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          direction: 'desc'
        }
        row_limit: 100
      }
    }
  }

  block sessions_commentary: TextBlock {
    content: @md
      ### Volume: two channels carry the site

      **Email** and **Adwords** bring in about **three quarters** of all sessions. Email alone is roughly 45%.

      Facebook and YouTube are about the same size, around 10% each. **Organic** is the smallest source at about 5%.

      *Takeaway:* traffic depends heavily on owned email and paid search. A drop in either one would show up right away in total sessions.
    ;;
  }

  block cvr_by_source: VizBlock {
    label: 'Purchase conversion rate by traffic source'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_events.traffic_source)
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.purchase_conversion_rate)
            label: 'Purchase Conversion Rate'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#0F766E'
          }
        }
        settings {
          axis_min: 0
          show_data_label_by: 'value'
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          direction: 'desc'
        }
        row_limit: 100
      }
    }
  }

  block cvr_commentary: TextBlock {
    content: @md
      ### Quality: every source converts about the same

      Conversion falls in a narrow **26.5%–27%** band across all five sources. **Organic** and **Facebook** are slightly ahead, and **Email** and **Adwords** are slightly behind.

      The gap is less than half a percentage point, so the channel doesn't really change how likely a visitor is to buy.

      *Takeaway:* growth will come from **more sessions**, not from moving budget to a "better-converting" channel. Scaling a cheaper source should grow orders about in proportion.
    ;;
  }

  view: CanvasLayout {
    label: 'View 1'
    width: 1200
    height: 900
    grid_size: 20
    auto_expand_vertically: true
    block title {
      position: pos(20, 20, 1160, 80)
    }
    block headline {
      position: pos(20, 100, 1160, 80)
    }
    block sessions_by_source {
      position: pos(20, 200, 740, 320)
    }
    block sessions_commentary {
      position: pos(780, 200, 400, 320)
    }
    block cvr_by_source {
      position: pos(20, 540, 740, 320)
    }
    block cvr_commentary {
      position: pos(780, 540, 400, 320)
    }
    mobile {
      mode: 'auto'
    }
  }

  theme: H.themes.vanilla
}
