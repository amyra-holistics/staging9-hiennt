Dashboard r06_claude_fd_html_a3 {
  title: 'Marketing Funnel: Where Sessions Come From'
  description: 'Sessions and purchase conversion rate by traffic source, with commentary.'

  block headline: VizBlock {
    label: 'Headline'
    viz: MarkdownViz {
      dataset: thelook

      calculation share {
        label: 'Share of Sessions'
        formula: @aql safe_divide(sessions, sessions | of_all(thelook_events.traffic_source));;
        calc_type: 'measure'
        data_type: 'number'
      }

      calculation total_sessions {
        label: 'Total Sessions'
        formula: @aql sessions | of_all(thelook_events.traffic_source);;
        calc_type: 'measure'
        data_type: 'number'
      }

      calculation total_cvr {
        label: 'Overall Conversion'
        formula: @aql purchase_conversion_rate | of_all(thelook_events.traffic_source);;
        calc_type: 'measure'
        data_type: 'number'
      }

      rows: [
        VizFieldFull {
          ref: r(thelook_events.traffic_source)
          label: 'Source'
        },
      ]
      values: [
        VizFieldFull {
          ref: r(thelook.sessions)
          label: 'Sessions'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: 'share'
          label: 'Share of Sessions'
          format {
            type: 'number'
            pattern: '#,###0%'
          }
        },
        VizFieldFull {
          ref: 'total_sessions'
          label: 'Total Sessions'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: 'total_cvr'
          label: 'Overall Conversion'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        },
      ]

      content: @md
        <div style="font-family: Georgia, 'Times New Roman', serif; color: #1f1d1a; font-size: 30px; line-height: 1.3; font-weight: 400; letter-spacing: -0.01em;">
          <span style="background: #f3d9c4; padding: 0 6px;">{{ rows[0].values.`Total Sessions`.formatted }}</span> sessions converted to a purchase at
          <span style="background: #f3d9c4; padding: 0 6px;">{{ rows[0].values.`Overall Conversion`.formatted }}</span>,
          and {{ rows[0].`Source`.formatted }} alone brought
          <span style="background: #f3d9c4; padding: 0 6px;">{{ rows[0].values.`Share of Sessions`.formatted }}</span> of them.
        </div>
      ;;

      settings {
        sorts: [
          IndexBasedSortSetting {
            field_index: 1
            direction: 'desc'
          },
        ]
      }
    }
    settings {
      hide_label: true
      hide_controls: true
    }
  }

  block sessions_chart: VizBlock {
    label: 'Sessions by Traffic Source'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_events.traffic_source)
        label: 'Traffic Source'
      }
      y_axis {
        label: 'Sessions'
        series {
          field: VizFieldFull {
            ref: r(thelook.sessions)
            label: 'Sessions'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#c2562b'
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      settings {
        legend_label: 'hidden'
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block sessions_commentary: VizBlock {
    label: 'Sessions Commentary'
    viz: MarkdownViz {
      dataset: thelook

      calculation share {
        label: 'Share of Sessions'
        formula: @aql safe_divide(sessions, sessions | of_all(thelook_events.traffic_source));;
        calc_type: 'measure'
        data_type: 'number'
      }

      rows: [
        VizFieldFull {
          ref: r(thelook_events.traffic_source)
          label: 'Source'
        },
      ]
      values: [
        VizFieldFull {
          ref: r(thelook.sessions)
          label: 'Sessions'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: 'share'
          label: 'Share'
          format {
            type: 'number'
            pattern: '#,###0%'
          }
        },
      ]

      content: @md
        <div style="font-family: -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif; color: #3a3631; font-size: 14px; line-height: 1.6;">
          <div style="font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: #c2562b; font-weight: 600; margin-bottom: 8px;">Volume is concentrated</div>
          <p style="margin: 0 0 12px;"><strong>{{ rows[0].`Source`.formatted }}</strong> is the biggest door into the store with {{ rows[0].values.`Sessions`.formatted }} sessions ({{ rows[0].values.`Share`.formatted }}), followed by <strong>{{ rows[1].`Source`.formatted }}</strong> at {{ rows[1].values.`Share`.formatted }}. The remaining sources are a long tail.</p>
          <table style="width: 100%; border-collapse: collapse; font-size: 13px;">
          {% map(rows) %}
            <tr style="border-top: 1px solid #e7e1d8;">
              <td style="padding: 5px 0;">{{ `Source`.formatted }}</td>
              <td style="padding: 5px 0; text-align: right; font-variant-numeric: tabular-nums;">{{ values.`Sessions`.formatted }}</td>
              <td style="padding: 5px 0; text-align: right; font-variant-numeric: tabular-nums; color: #8a8178; width: 52px;">{{ values.`Share`.formatted }}</td>
            </tr>
          {% end %}
          </table>
        </div>
      ;;

      settings {
        sorts: [
          IndexBasedSortSetting {
            field_index: 1
            direction: 'desc'
          },
        ]
      }
    }
    settings {
      hide_label: true
      hide_controls: true
    }
  }

  block conversion_chart: VizBlock {
    label: 'Purchase Conversion Rate by Traffic Source'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_events.traffic_source)
        label: 'Traffic Source'
      }
      y_axis {
        label: 'Purchase Conversion Rate'
        series {
          field: VizFieldFull {
            ref: r(thelook.purchase_conversion_rate)
            label: 'Purchase Conversion Rate'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#2f5d62'
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      settings {
        legend_label: 'hidden'
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block conversion_commentary: VizBlock {
    label: 'Conversion Commentary'
    viz: MarkdownViz {
      dataset: thelook
      rows: [
        VizFieldFull {
          ref: r(thelook_events.traffic_source)
          label: 'Source'
        },
      ]
      values: [
        VizFieldFull {
          ref: r(thelook.purchase_conversion_rate)
          label: 'Conversion'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
      ]

      content: @md
        <div style="font-family: -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif; color: #3a3631; font-size: 14px; line-height: 1.6;">
          <div style="font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: #2f5d62; font-weight: 600; margin-bottom: 8px;">Quality is flat</div>
          <p style="margin: 0 0 12px;"><strong>{{ rows[0].`Source`.formatted }}</strong> converts best at {{ rows[0].values.`Conversion`.formatted }}, but every source lands within a point of each other. Sessions differ several-fold between sources; conversion barely moves.</p>
          <p style="margin: 0 0 12px;">So the lever is <em>reach</em>, not channel quality: growing a small source converts about as well as growing a big one.</p>
          <table style="width: 100%; border-collapse: collapse; font-size: 13px;">
          {% map(rows) %}
            <tr style="border-top: 1px solid #e7e1d8;">
              <td style="padding: 5px 0;">{{ `Source`.formatted }}</td>
              <td style="padding: 5px 0; text-align: right; font-variant-numeric: tabular-nums;">{{ values.`Conversion`.formatted }}</td>
            </tr>
          {% end %}
          </table>
        </div>
      ;;

      settings {
        sorts: [
          IndexBasedSortSetting {
            field_index: 1
            direction: 'desc'
          },
        ]
      }
    }
    settings {
      hide_label: true
      hide_controls: true
    }
  }

  view: HTMLLayout {
    content: @html
      <style>
        .mf-page {
          background: #faf7f2;
          padding: 40px 48px 56px;
          min-height: 100%;
          box-sizing: border-box;
          color: #1f1d1a;
        }
        .mf-kicker {
          font-family: -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif;
          font-size: 12px;
          letter-spacing: 0.14em;
          text-transform: uppercase;
          color: #8a8178;
          margin-bottom: 12px;
        }
        .mf-headline {
          max-width: 920px;
          min-height: 130px;
          margin-bottom: 12px;
        }
        .mf-rule {
          border: 0;
          border-top: 2px solid #1f1d1a;
          margin: 20px 0 32px;
        }
        .mf-row {
          display: grid;
          grid-template-columns: minmax(0, 2fr) minmax(260px, 1fr);
          gap: 32px;
          margin-bottom: 40px;
        }
        .mf-step {
          font-family: Georgia, 'Times New Roman', serif;
          font-size: 20px;
          margin: 0 0 12px;
        }
        .mf-step span {
          color: #8a8178;
          font-style: italic;
          margin-right: 8px;
        }
        .mf-chart {
          height: 360px;
          background: #ffffff;
          border: 1px solid #e7e1d8;
        }
        .mf-note {
          border-left: 3px solid #e7e1d8;
          padding-left: 20px;
          min-height: 360px;
        }
        @media (max-width: 800px) {
          .mf-page { padding: 24px 16px; }
          .mf-row { grid-template-columns: 1fr; }
          .mf-note { min-height: 280px; }
        }
      </style>

      <main class="mf-page">
        <div class="mf-kicker">TheLook &middot; Marketing funnel &middot; all time</div>
        <div class="mf-headline">
          <h-block name="headline" />
        </div>
        <hr class="mf-rule" />

        <section class="mf-row">
          <div>
            <h2 class="mf-step"><span>01</span>How many sessions each source brings</h2>
            <div class="mf-chart">
              <h-block name="sessions_chart" />
            </div>
          </div>
          <aside class="mf-note">
            <h-block name="sessions_commentary" />
          </aside>
        </section>

        <section class="mf-row">
          <div>
            <h2 class="mf-step"><span>02</span>How well those sessions convert</h2>
            <div class="mf-chart">
              <h-block name="conversion_chart" />
            </div>
          </div>
          <aside class="mf-note">
            <h-block name="conversion_commentary" />
          </aside>
        </section>
      </main>
    ;;
  }
}
