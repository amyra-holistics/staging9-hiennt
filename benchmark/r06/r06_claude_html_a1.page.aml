Dashboard r06_claude_html_a1 {
  title: 'Marketing Funnel: Traffic Sources'
  description: 'Where website sessions come from and how well each traffic source converts to a purchase.'

  block headline: VizBlock {
    label: 'Headline'
    viz: MarkdownViz {
      dataset: thelook
      calculation total_sessions {
        label: 'Total Sessions'
        formula: @aql sessions | of_all(thelook_events.traffic_source);;
        calc_type: 'measure'
        data_type: 'number'
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      calculation share {
        label: 'Session Share'
        formula: @aql safe_divide(sessions * 1.0, sessions | of_all(thelook_events.traffic_source));;
        calc_type: 'measure'
        data_type: 'number'
        format {
          type: 'number'
          pattern: '#,###0.0%'
        }
      }
      calculation overall_cr {
        label: 'Overall Conversion Rate'
        formula: @aql purchase_conversion_rate | of_all(thelook_events.traffic_source);;
        calc_type: 'measure'
        data_type: 'number'
        format {
          type: 'number'
          pattern: '#,###0.0%'
        }
      }
      rows: [
        VizFieldFull {
          ref: r(thelook_events.traffic_source)
          label: 'Traffic Source'
        },
      ]
      values: [
        VizFieldFull {
          ref: r(thelook.sessions)
          label: 'Sessions'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: 'total_sessions'
          label: 'Total Sessions'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: 'share'
          label: 'Session Share'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        },
        VizFieldFull {
          ref: 'overall_cr'
          label: 'Overall Conversion Rate'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        },
      ]
      content: @md
        <p style="font-size:22px; line-height:1.4; margin:0;">Visitors started <b>{{ rows[0].values.`Total Sessions`.formatted }}</b> sessions and <b>{{ rows[0].values.`Overall Conversion Rate`.formatted }}</b> of them ended in a purchase. <b>{{ rows[0].`Traffic Source`.formatted }}</b> is the largest source, bringing in <b>{{ rows[0].values.`Session Share`.formatted }}</b> of all sessions.</p>
      ;;
      settings {
        sorts: [
          IndexBasedSortSetting {
            field_index: 1
            direction: 'desc'
          },
        ]
        row_limit: 1
      }
    }
    settings {
      hide_label: true
    }
  }

  block sessions_by_source: VizBlock {
    label: 'Sessions by Traffic Source'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_events.traffic_source)
        label: 'Traffic Source'
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.sessions)
            label: 'Sessions'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block sessions_commentary: TextBlock {
    content: @md
      ### Volume is concentrated

      **Email** and **Adwords** together bring in about three of every four sessions.
      Email alone accounts for close to half of all traffic.

      **Facebook**, **YouTube** and **Organic** are much smaller. Organic search is the
      smallest source by a wide margin.

      *So what:* the funnel depends heavily on two channels. A drop in email sends or
      paid search budget would hit total traffic hard.
    ;;
  }

  block conversion_by_source: VizBlock {
    label: 'Purchase Conversion Rate by Traffic Source'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_events.traffic_source)
        label: 'Traffic Source'
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.purchase_conversion_rate)
            label: 'Purchase Conversion Rate'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block conversion_commentary: TextBlock {
    content: @md
      ### Quality is flat

      Every source converts at roughly the same rate, around **one in four sessions**
      ends in a purchase. The gap between the best and worst source is under
      one percentage point.

      Organic converts slightly best but is the smallest source, so it adds little
      to total purchases.

      *So what:* no channel brings noticeably better visitors. Growth in purchases
      will come from more sessions, not from shifting the mix between sources.
    ;;
  }

  view: HTMLLayout {
    content: @html
      <style>
        .page { display: flex; flex-direction: column; gap: 20px; padding: 24px; max-width: 1280px; margin: 0 auto; }
        .page h1 { font-size: 28px; margin: 0; }
        .kicker { font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #6b7280; margin: 0 0 4px; }
        .headline { background: #f3f4f6; border-left: 4px solid #2563eb; border-radius: 8px; padding: 16px 20px; min-height: 90px; }
        .row { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 20px; align-items: stretch; }
        .chart { height: 380px; }
        .note { border-left: 1px solid #e5e7eb; padding-left: 20px; }
        .step { font-size: 12px; font-weight: 600; color: #2563eb; margin: 0 0 4px; }
        @media (max-width: 900px) {
          .row { grid-template-columns: 1fr; }
          .note { border-left: none; padding-left: 0; }
        }
      </style>

      <div class="page">
        <header>
          <p class="kicker">Marketing funnel</p>
          <h1>Where our sessions come from, and how they convert</h1>
        </header>

        <section class="headline">
          <h-block name="headline" />
        </section>

        <section>
          <p class="step">1 · Top of funnel</p>
          <div class="row">
            <div class="chart"><h-block name="sessions_by_source" /></div>
            <aside class="note"><h-block name="sessions_commentary" /></aside>
          </div>
        </section>

        <section>
          <p class="step">2 · Conversion</p>
          <div class="row">
            <div class="chart"><h-block name="conversion_by_source" /></div>
            <aside class="note"><h-block name="conversion_commentary" /></aside>
          </div>
        </section>
      </div>
    ;;
  }
}
