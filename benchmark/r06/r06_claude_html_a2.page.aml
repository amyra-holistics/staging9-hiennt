Dashboard r06_claude_html_a2 {
  title: 'Marketing Funnel: Traffic Sources'
  description: 'Where sessions come from and how well each traffic source converts to a purchase.'

  block headline: VizBlock {
    label: 'Headline'
    viz: MarkdownViz {
      dataset: thelook
      values: [
        VizFieldFull {
          ref: r(thelook.sessions)
          label: 'Sessions'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.purchase_conversion_rate)
          label: 'Purchase Conversion Rate'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      content: @md
        <div style="font-size: 26px; line-height: 1.35; font-weight: 600; color: #1f2937;">
          The site drew <span style="color: #2563eb;">{{ rows[0].values.`Sessions` }}</span> sessions,
          and <span style="color: #2563eb;">{{ rows[0].values.`Purchase Conversion Rate` }}</span> of them ended in a purchase.
        </div>
        <div style="margin-top: 6px; font-size: 14px; color: #6b7280;">
          Traffic volume differs a lot by source; conversion quality barely does.
        </div>
      ;;
    }
    settings {
      hide_label: true
      hide_controls: true
    }
  }

  block sessions_by_source: VizBlock {
    label: 'Sessions by Traffic Source'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_events.traffic_source)
        label: 'Traffic Source'
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.sessions)
            label: 'Sessions'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block sessions_commentary: TextBlock {
    content: @md
      ### Volume: two channels carry the site

      **Email** and **Adwords** together bring roughly three in four sessions
      (about 45% and 30%). Facebook and YouTube each add about 10%, and
      Organic is the smallest source at around 5%.

      **So what:** any disruption to email sends or paid search budgets would
      hit traffic hard. Organic is the most under-developed channel.
    ;;
  }

  block conversion_by_source: VizBlock {
    label: 'Purchase Conversion Rate by Traffic Source'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_events.traffic_source)
        label: 'Traffic Source'
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.purchase_conversion_rate)
            label: 'Purchase Conversion Rate'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block conversion_commentary: TextBlock {
    content: @md
      ### Quality: every source converts about the same

      Conversion sits in a narrow band of about **26.5% to 27%** for every
      source. Organic and Facebook are a hair ahead; Email and Adwords are a
      hair behind, but the gap is less than half a point.

      **So what:** a session is worth about the same wherever it comes from.
      Growth depends on **adding sessions** (especially cheap Organic ones),
      not on moving budget toward a "better-converting" channel.
    ;;
  }

  view: HTMLLayout {
    content: @html
      <style>
        .funnel-page {
          display: flex;
          flex-direction: column;
          gap: 20px;
          padding: 20px;
        }
        .funnel-row {
          display: grid;
          grid-template-columns: minmax(0, 2fr) minmax(260px, 1fr);
          gap: 16px;
          align-items: stretch;
        }
        .funnel-chart {
          height: 360px;
        }
        .funnel-note {
          border-left: 4px solid #2563eb;
          padding-left: 12px;
        }
        .funnel-headline {
          height: 120px;
        }
        @media (max-width: 800px) {
          .funnel-row {
            grid-template-columns: minmax(0, 1fr);
          }
        }
      </style>

      <main class="funnel-page">
        <header class="funnel-headline">
          <h-block name="headline" />
        </header>

        <section class="funnel-row">
          <div class="funnel-chart">
            <h-block name="sessions_by_source" />
          </div>
          <div class="funnel-note">
            <h-block name="sessions_commentary" />
          </div>
        </section>

        <section class="funnel-row">
          <div class="funnel-chart">
            <h-block name="conversion_by_source" />
          </div>
          <div class="funnel-note">
            <h-block name="conversion_commentary" />
          </div>
        </section>
      </main>
    ;;
  }
}
