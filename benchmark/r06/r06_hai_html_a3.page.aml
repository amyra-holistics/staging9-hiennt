Dashboard r06_hai_html_a3 {
  title: 'Marketing Funnel by Traffic Source'
  description: 'Sessions and purchase conversion performance by traffic source.'
  theme: H.themes.classic

  block title: TextBlock {
    content: @md
      # Marketing Funnel Performance
      See which traffic sources generate the most sessions—and which convert those visits into purchases most effectively.
    ;;
  }

  block headline: VizBlock {
    label: 'Marketing Funnel Headline'
    viz: MarkdownViz {
      dataset: thelook
      values: [
        VizFieldFull {
          ref: r(thelook.sessions)
          label: 'Sessions'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.purchase_conversion_rate)
          label: 'Purchase Conversion Rate'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      content: @md
        <style>
          .marketing-funnel-headline {
            margin: 0;
            padding: 20px 24px;
            color: #172033;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            font-size: clamp(1.3rem, 2.5vw, 2rem);
            font-weight: 500;
            letter-spacing: -0.02em;
            line-height: 1.35;
          }

          .marketing-funnel-headline strong {
            color: #111827;
            font-weight: 700;
          }
        </style>

        <p class="marketing-funnel-headline">
          <strong>{{ rows[0].values.`Sessions` }}</strong> website sessions converted at <strong>{{ rows[0].values.`Purchase Conversion Rate` }}</strong>.
        </p>
      ;;
    }
  }

  block sessions_by_source: VizBlock {
    label: 'Sessions by Traffic Source'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_events.traffic_source)
        label: 'Traffic Source'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.sessions)
            label: 'Sessions'
            format {
              type: 'number'
              pattern: '#,###0'
            }
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block sessions_commentary: TextBlock {
    content: @md
      ## What this shows

      Use this view to understand **where the funnel starts**. Prioritize channel investment based on the sources that consistently generate meaningful session volume, then compare that volume with conversion efficiency below.
    ;;
  }

  block conversion_by_source: VizBlock {
    label: 'Purchase Conversion Rate by Traffic Source'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_events.traffic_source)
        label: 'Traffic Source'
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.purchase_conversion_rate)
            label: 'Purchase Conversion Rate'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block conversion_commentary: TextBlock {
    content: @md
      ## What this shows

      This is the **quality check** for traffic. A channel can bring fewer sessions yet be highly valuable when it converts efficiently. Look for opportunities to scale high-converting sources and improve the landing experience for lower-converting ones.
    ;;
  }

  explicit_interactions: []

  view: HTMLLayout {
    content: @html
      <style>
        .marketing-funnel-dashboard {
          max-width: 1440px;
          margin: 0 auto;
          padding: 24px;
          color: #172033;
        }

        .hero {
          margin-bottom: 20px;
        }

        .headline {
          margin-bottom: 32px;
          border: 1px solid #e6eaf0;
          border-radius: 12px;
          background: #f8fafc;
        }

        .section {
          display: grid;
          grid-template-columns: minmax(0, 2.2fr) minmax(280px, 0.8fr);
          gap: 24px;
          align-items: stretch;
          margin-bottom: 28px;
        }

        .chart-card,
        .commentary-card {
          border: 1px solid #e6eaf0;
          border-radius: 12px;
          background: #ffffff;
          overflow: hidden;
        }

        .commentary-card {
          display: flex;
          align-items: center;
          padding: 8px 20px;
          background: #f8fafc;
        }

        @media (max-width: 860px) {
          .marketing-funnel-dashboard {
            padding: 16px;
          }

          .section {
            grid-template-columns: 1fr;
            gap: 16px;
          }
        }
      </style>

      <main class="marketing-funnel-dashboard">
        <header class="hero">
          <h-block name="title" />
        </header>

        <section class="headline">
          <h-block name="headline" />
        </section>

        <section class="section">
          <div class="chart-card">
            <h-block name="sessions_by_source" />
          </div>
          <aside class="commentary-card">
            <h-block name="sessions_commentary" />
          </aside>
        </section>

        <section class="section">
          <div class="chart-card">
            <h-block name="conversion_by_source" />
          </div>
          <aside class="commentary-card">
            <h-block name="conversion_commentary" />
          </aside>
        </section>
      </main>
    ;;
  }
}
