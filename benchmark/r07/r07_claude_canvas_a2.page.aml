Dashboard r07_claude_canvas_a2 {
  title: 'Operations: Stock & Returns'
  description: 'Units in stock and return rate by distribution center and category, with return rate flagged against a 10% threshold.'

  block title: TextBlock {
    content: @md
# Operations: Stock & Returns
Click a distribution center bar to filter the dashboard. Right-click a bar and choose **Drill down** to expand a distribution center into its categories, or a category into its products. The red dashed line and red cells mark return rates above **10%**.
    ;;
  }

  block f_dc: FilterBlock {
    label: 'Distribution Center'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_distribution_centers.name)
    }
  }

  block kpi_units: VizBlock {
    label: 'Units in Stock'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.units_in_stock)
        label: 'Units in Stock'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block kpi_return: VizBlock {
    label: 'Return Rate (threshold 10%)'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.return_rate)
        label: 'Return Rate'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block v_stock_by_dc: VizBlock {
    label: 'Units in Stock by Distribution Center'
    description: 'Click a bar to filter the dashboard. Right-click > Drill down to see its categories.'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_distribution_centers.name)
        label: 'Distribution Center'
      }
      y_axis {
        label: 'Units in Stock'
        series {
          field: VizFieldFull {
            ref: r(thelook.units_in_stock)
            label: 'Units in Stock'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#255DD4'
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      settings {
        legend_label: 'hidden'
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
      context {
        analysis {
          breakdown {
            group dc_category {
              label: 'Distribution Center > Category'
              fields: [
                r(thelook_distribution_centers.name),
                r(thelook_products.category),
              ]
            }
          }
        }
      }
    }
  }

  block v_return_by_dc: VizBlock {
    label: 'Return Rate by Distribution Center vs 10% Threshold'
    description: 'Click a column to filter the dashboard. Right-click > Drill down to see its categories.'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_distribution_centers.name)
        label: 'Distribution Center'
      }
      y_axis {
        label: 'Return Rate'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(thelook.return_rate)
            label: 'Return Rate'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#F2B602'
          }
        }
        series {
          mark_type: 'line'
          field: ConstantVizField {
            value: 0.1
            label: '10% threshold'
            format {
              type: 'number'
              pattern: '#,###0.0%'
            }
          }
          settings {
            color: '#F1434B'
            line_style: 'dashed'
          }
        }
      }
      settings {
        legend_label: 'top'
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
      context {
        analysis {
          breakdown {
            group dc_category {
              label: 'Distribution Center > Category'
              fields: [
                r(thelook_distribution_centers.name),
                r(thelook_products.category),
              ]
            }
          }
        }
      }
    }
  }

  block v_stock_by_category: VizBlock {
    label: 'Units in Stock by Category'
    description: 'Right-click a bar > Drill down to see its products.'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Category'
      }
      y_axis {
        label: 'Units in Stock'
        series {
          field: VizFieldFull {
            ref: r(thelook.units_in_stock)
            label: 'Units in Stock'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#18A59E'
          }
        }
      }
      settings {
        legend_label: 'hidden'
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
      context {
        analysis {
          breakdown {
            group category_product {
              label: 'Category > Product'
              fields: [
                r(thelook_products.category),
                r(thelook_products.name),
              ]
            }
          }
        }
      }
    }
  }

  block v_return_by_category: VizBlock {
    label: 'Return Rate by Category vs 10% Threshold'
    description: 'Right-click a column > Drill down to see its products.'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Category'
      }
      y_axis {
        label: 'Return Rate'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(thelook.return_rate)
            label: 'Return Rate'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#F2B602'
          }
        }
        series {
          mark_type: 'line'
          field: ConstantVizField {
            value: 0.1
            label: '10% threshold'
            format {
              type: 'number'
              pattern: '#,###0.0%'
            }
          }
          settings {
            color: '#F1434B'
            line_style: 'dashed'
          }
        }
      }
      settings {
        legend_label: 'top'
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
      context {
        analysis {
          breakdown {
            group category_product {
              label: 'Category > Product'
              fields: [
                r(thelook_products.category),
                r(thelook_products.name),
              ]
            }
          }
        }
      }
    }
  }

  block v_dc_category_matrix: VizBlock {
    label: 'Distribution Center > Category Detail'
    description: 'Return rates above 10% are highlighted in red.'
    viz: PivotTable {
      dataset: thelook
      rows: [
        VizFieldFull {
          ref: r(thelook_distribution_centers.name)
          label: 'Distribution Center'
        },
        VizFieldFull {
          ref: r(thelook_products.category)
          label: 'Category'
        }
      ]
      values: [
        VizFieldFull {
          ref: r(thelook.units_in_stock)
          label: 'Units in Stock'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.return_rate)
          label: 'Return Rate'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        show_row_total: true
        show_sub_total: true
        frozen_columns: 2
        conditional_formats: [
          ConditionalFormat {
            ref: r(thelook.return_rate)
            format: SingleFormat {
              condition {
                operator: 'greater_than'
                value: 0.1
              }
              text_color: '#A50E43'
              background_color: '#FDE2E4'
            }
          }
        ]
      }
    }
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'f_dc'
      to: ['kpi_units', 'kpi_return', 'v_stock_by_dc', 'v_return_by_dc', 'v_stock_by_category', 'v_return_by_category', 'v_dc_category_matrix']
      field: r(thelook_distribution_centers.name)
    },
    FilterInteraction {
      from: 'v_stock_by_dc'
      to: ['kpi_units', 'kpi_return', 'v_return_by_dc', 'v_stock_by_category', 'v_return_by_category', 'v_dc_category_matrix']
    },
    FilterInteraction {
      from: 'v_return_by_dc'
      to: ['kpi_units', 'kpi_return', 'v_stock_by_dc', 'v_stock_by_category', 'v_return_by_category', 'v_dc_category_matrix']
    }
  ]

  view: CanvasLayout {
    label: 'View 1'
    width: 1300
    height: 1560
    grid_size: 20
    auto_expand_vertically: true
    block title {
      position: pos(20, 20, 1260, 100)
    }
    block f_dc {
      position: pos(20, 140, 400, 100)
    }
    block kpi_units {
      position: pos(440, 140, 410, 100)
    }
    block kpi_return {
      position: pos(870, 140, 410, 100)
    }
    block v_stock_by_dc {
      position: pos(20, 260, 620, 380)
    }
    block v_return_by_dc {
      position: pos(660, 260, 620, 380)
    }
    block v_stock_by_category {
      position: pos(20, 660, 620, 440)
    }
    block v_return_by_category {
      position: pos(660, 660, 620, 440)
    }
    block v_dc_category_matrix {
      position: pos(20, 1120, 1260, 420)
    }
    mobile {
      mode: 'auto'
    }
  }

  theme: H.themes.vanilla
}
