Dashboard r07_claude_fd_canvas_a2 {
  title: 'Operations: Stock & Returns'
  description: 'Units in stock and return rate by distribution center and category, with return rate flagged against a 10% threshold.'

  block t_header: TextBlock {
    content: @md
      # Operations: Stock & Returns
      Units in stock and return rate by distribution center and product category. Return rates above **10%** are flagged in red.
    ;;
  }

  block t_guide: TextBlock {
    content: @md
      **How to use**
      - **Click a distribution center** bar to filter every other block.
      - **Click a category** bar to list its products in *Products*; right-click → *Drill down* to open product level.
      - **Right-click a distribution center** → *Drill down* to expand it into its categories.
      - Dashed line = **10% return-rate threshold**.
    ;;
  }

  block v_kpi_units: VizBlock {
    label: 'Units in Stock'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.units_in_stock)
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block v_kpi_return_rate: VizBlock {
    label: 'Return Rate (threshold 10%)'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.return_rate)
        format {
          type: 'number'
          pattern: '#,###0.0%'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block v_by_dc: VizBlock {
    label: 'Stock & Return Rate by Distribution Center'
    description: 'Click a distribution center to filter the dashboard. Right-click → Drill down to expand it into categories.'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_distribution_centers.name)
        label: 'Distribution Center'
        format {
          type: 'text'
        }
      }
      y_axis {
        label: 'Units in Stock'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(thelook.units_in_stock)
            label: 'Units in Stock'
            format {
              type: 'number'
              pattern: '#,###0'
            }
          }
          settings {
            color: '#3B6FD4'
          }
        }
        settings {
          alignment: 'left'
        }
      }
      y_axis {
        label: 'Return Rate'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.return_rate)
            label: 'Return Rate'
            format {
              type: 'number'
              pattern: '#,###0.0%'
            }
          }
          settings {
            color: '#E0782B'
          }
        }
        series {
          mark_type: 'line'
          field: ConstantVizField {
            value: 0.1
            label: '10% Threshold'
            format {
              type: 'number'
              pattern: '#,###0%'
            }
          }
          settings {
            color: '#D1333F'
            line_style: 'dashed'
          }
        }
        settings {
          alignment: 'right'
          axis_min: 0
        }
      }
      settings {
        legend_label: 'bottom'
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
        row_limit: 5000
      }
      context {
        analysis {
          breakdown {
            group dc_hierarchy {
              label: 'Distribution Center → Category → Product'
              fields: [
                r(thelook_distribution_centers.name),
                r(thelook_products.category),
                r(thelook_products.name)
              ]
            }
          }
        }
      }
    }
  }

  block v_by_category: VizBlock {
    label: 'Stock & Return Rate by Category'
    description: 'Click a category to list its products. Right-click → Drill down to product level.'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Category'
        format {
          type: 'text'
        }
      }
      y_axis {
        label: 'Units in Stock'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(thelook.units_in_stock)
            label: 'Units in Stock'
            format {
              type: 'number'
              pattern: '#,###0'
            }
          }
          settings {
            color: '#3B6FD4'
          }
        }
        settings {
          alignment: 'left'
        }
      }
      y_axis {
        label: 'Return Rate'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.return_rate)
            label: 'Return Rate'
            format {
              type: 'number'
              pattern: '#,###0.0%'
            }
          }
          settings {
            color: '#E0782B'
          }
        }
        series {
          mark_type: 'line'
          field: ConstantVizField {
            value: 0.1
            label: '10% Threshold'
            format {
              type: 'number'
              pattern: '#,###0%'
            }
          }
          settings {
            color: '#D1333F'
            line_style: 'dashed'
          }
        }
        settings {
          alignment: 'right'
          axis_min: 0
        }
      }
      settings {
        legend_label: 'bottom'
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
        row_limit: 5000
      }
      context {
        analysis {
          breakdown {
            group category_hierarchy {
              label: 'Category → Product'
              fields: [
                r(thelook_products.category),
                r(thelook_products.name)
              ]
            }
          }
        }
      }
    }
  }

  block v_dc_category: VizBlock {
    label: 'Distribution Center → Category'
    description: 'Each distribution center with its categories and a subtotal. Return rate above 10% is flagged red.'
    viz: PivotTable {
      dataset: thelook
      rows: [
        VizFieldFull {
          ref: r(thelook_distribution_centers.name)
          label: 'Distribution Center'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(thelook_products.category)
          label: 'Category'
          format {
            type: 'text'
          }
        }
      ]
      values: [
        VizFieldFull {
          ref: r(thelook.units_in_stock)
          label: 'Units in Stock'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: r(thelook.return_rate)
          label: 'Return Rate'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        }
      ]
      settings {
        show_row_total: true
        show_sub_total: true
        frozen_columns: 2
        row_limit: 5000
        conditional_formats: [
          ConditionalFormat {
            ref: r(thelook.units_in_stock)
            format: ScaleFormat {
              min {
                type: 'value'
                value: 0
                color: '#FFFFFF'
              }
              max {
                type: 'percentage'
                value: 100
                color: '#9DB8EC'
              }
            }
          },
          ConditionalFormat {
            ref: r(thelook.return_rate)
            format: SingleFormat {
              condition {
                operator: 'greater_than'
                value: 0.1
              }
              text_color: '#B42318'
              background_color: '#FDE4E1'
            }
          }
        ]
      }
    }
  }

  block v_products: VizBlock {
    label: 'Products'
    description: 'Products in the selected distribution center / category. Return rate above 10% is flagged red.'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          ref: r(thelook_products.name)
          label: 'Product'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(thelook_products.category)
          label: 'Category'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(thelook_distribution_centers.name)
          label: 'Distribution Center'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(thelook.units_in_stock)
          label: 'Units in Stock'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: r(thelook.return_rate)
          label: 'Return Rate'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        }
      ]
      settings {
        pagination_size: 25
        row_limit: 5000
        sorts: [
          IndexBasedSortSetting {
            field_index: 3
            direction: 'desc'
          }
        ]
        conditional_formats: [
          ConditionalFormat {
            ref: r(thelook.units_in_stock)
            format: ScaleFormat {
              min {
                type: 'value'
                value: 0
                color: '#FFFFFF'
              }
              max {
                type: 'percentage'
                value: 100
                color: '#9DB8EC'
              }
            }
          },
          ConditionalFormat {
            ref: r(thelook.return_rate)
            format: SingleFormat {
              condition {
                operator: 'greater_than'
                value: 0.1
              }
              text_color: '#B42318'
              background_color: '#FDE4E1'
            }
          }
        ]
      }
    }
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'v_by_dc'
      to: ['v_kpi_units', 'v_kpi_return_rate', 'v_by_category', 'v_dc_category', 'v_products']
    },
    FilterInteraction {
      from: 'v_by_category'
      to: ['v_kpi_units', 'v_kpi_return_rate', 'v_dc_category', 'v_products']
    }
  ]

  view: CanvasLayout {
    label: 'Operations'
    width: 1320
    height: 1220
    grid_size: 20
    auto_expand_vertically: true
    block t_header {
      position: pos(20, 20, 1280, 80)
    }
    block v_kpi_units {
      position: pos(20, 120, 300, 140)
    }
    block v_kpi_return_rate {
      position: pos(340, 120, 300, 140)
    }
    block t_guide {
      position: pos(660, 120, 640, 140)
    }
    block v_by_dc {
      position: pos(20, 280, 620, 400)
    }
    block v_by_category {
      position: pos(660, 280, 640, 400)
    }
    block v_dc_category {
      position: pos(20, 700, 620, 500)
    }
    block v_products {
      position: pos(660, 700, 640, 500)
    }
    mobile {
      mode: 'auto'
    }
  }

  theme: H.themes.vanilla
}
