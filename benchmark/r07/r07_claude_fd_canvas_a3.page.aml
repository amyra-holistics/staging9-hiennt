Dashboard r07_claude_fd_canvas_a3 {
  title: 'Operations: Inventory & Returns'
  description: 'Units in stock and return rate by distribution center and product category. Return rate is flagged against a 10% threshold.'

  block title: TextBlock {
    content: @md
# Operations: Inventory & Returns
Units in stock and return rate by distribution center and category. Return rates above **10%** are flagged in red.
;;
  }

  block guide: TextBlock {
    content: @md
**How to use**
- Click a **distribution center** bar to filter the whole dashboard.
- Click a **category** column to drill into its products.
- Expand a distribution center in the table to see its categories.
;;
  }

  block kpi_stock: VizBlock {
    label: 'Units in Stock'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.units_in_stock)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block kpi_return: VizBlock {
    label: 'Return Rate (threshold 10%)'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.return_rate)
        format {
          type: 'number'
          pattern: '#,###0.0%'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block v_stock_by_dc: VizBlock {
    label: 'Stock Level by Distribution Center'
    description: 'Click a distribution center to filter the rest of the dashboard.'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_distribution_centers.name)
        label: 'Distribution Center'
        format {
          type: 'text'
        }
      }
      y_axis {
        label: 'Units in Stock'
        series {
          field: VizFieldFull {
            ref: r(thelook.units_in_stock)
            label: 'Units in Stock'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#3B6FD4'
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      settings {
        legend_label: 'hidden'
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block v_return_by_category: VizBlock {
    label: 'Return Rate by Category vs 10% Threshold'
    description: 'Click a category to drill into its products.'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Category'
        format {
          type: 'text'
        }
      }
      y_axis {
        label: 'Return Rate'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(thelook.return_rate)
            label: 'Return Rate'
            format {
              type: 'number'
              pattern: '#,###0.0%'
            }
          }
          settings {
            color: '#3B6FD4'
          }
        }
        series {
          mark_type: 'line'
          field: ConstantVizField {
            value: 0.1
            label: '10% Threshold'
            format {
              type: 'number'
              pattern: '#,###0.0%'
            }
          }
          settings {
            color: '#D92D20'
            line_style: 'dashed'
          }
        }
      }
      settings {
        legend_label: 'top'
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block v_dc_category: VizBlock {
    label: 'Distribution Center › Category'
    description: 'Expand a distribution center to see its categories. Return rate above 10% is flagged in red.'
    viz: PivotTable {
      dataset: thelook
      rows: [
        VizFieldFull {
          ref: r(thelook_distribution_centers.name)
          label: 'Distribution Center'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(thelook_products.category)
          label: 'Category'
          format {
            type: 'text'
          }
        }
      ]
      values: [
        VizFieldFull {
          ref: r(thelook.units_in_stock)
          label: 'Units in Stock'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.return_rate)
          label: 'Return Rate'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        }
      ]
      settings {
        show_sub_total: true
        show_row_total: true
        pagination_size: 100
        wrap_header_text: true
        conditional_formats: [
          ConditionalFormat {
            ref: r(thelook.units_in_stock)
            format: ScaleFormat {
              min {
                type: 'percentage'
                value: 0
                color: '#FFFFFF'
              }
              max {
                type: 'percentage'
                value: 100
                color: '#B7C9F2'
              }
            }
          },
          ConditionalFormat {
            ref: r(thelook.return_rate)
            format: SingleFormat {
              condition {
                operator: 'greater_than'
                value: 0.1
              }
              text_color: '#B42318'
              background_color: '#FDE2E1'
            }
          }
        ]
      }
    }
  }

  block v_products: VizBlock {
    label: 'Products'
    description: 'Filtered by the selected distribution center and category.'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          ref: r(thelook_products.name)
          label: 'Product'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(thelook_products.category)
          label: 'Category'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(thelook_products.brand)
          label: 'Brand'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(thelook.units_in_stock)
          label: 'Units in Stock'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.return_rate)
          label: 'Return Rate'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        }
      ]
      settings {
        pagination_size: 25
        row_limit: 5000
        sorts: [
          IndexBasedSortSetting {
            field_index: 3
            direction: 'desc'
          }
        ]
        conditional_formats: [
          ConditionalFormat {
            ref: r(thelook.return_rate)
            format: SingleFormat {
              condition {
                operator: 'greater_than'
                value: 0.1
              }
              text_color: '#B42318'
              background_color: '#FDE2E1'
            }
          }
        ]
      }
    }
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'v_stock_by_dc'
      to: ['kpi_stock', 'kpi_return', 'v_return_by_category', 'v_dc_category', 'v_products']
    },
    FilterInteraction {
      from: 'v_return_by_category'
      to: ['v_products']
    },
    FilterInteraction {
      from: 'v_dc_category'
      to: ['v_products']
    }
  ]

  view: CanvasLayout {
    label: 'Operations'
    width: 1280
    height: 1160
    grid_size: 20
    auto_expand_vertically: true
    block title {
      position: pos(20, 20, 1240, 80)
    }
    block kpi_stock {
      position: pos(20, 120, 300, 120)
    }
    block kpi_return {
      position: pos(340, 120, 300, 120)
    }
    block guide {
      position: pos(660, 120, 600, 120)
    }
    block v_stock_by_dc {
      position: pos(20, 260, 620, 400)
    }
    block v_return_by_category {
      position: pos(660, 260, 600, 400)
    }
    block v_dc_category {
      position: pos(20, 680, 620, 460)
    }
    block v_products {
      position: pos(660, 680, 600, 460)
    }
    mobile {
      mode: 'auto'
    }
  }

  theme: H.themes.vanilla
}
