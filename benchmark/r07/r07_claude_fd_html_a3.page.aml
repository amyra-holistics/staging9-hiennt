Dashboard r07_claude_fd_html_a3 {
  title: 'Inventory & Returns Operations'
  description: 'Units in stock and return rate by distribution center, category and product. Return rate is flagged above a 10% threshold.'

  // ---- Controls ----

  block dc_filter: FilterBlock {
    label: 'Distribution Center'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_distribution_centers.name)
    }
    settings {
      input_type: 'multiple'
    }
  }

  // ---- Distribution center level ----

  block dc_stock: VizBlock {
    label: 'Units in Stock by Distribution Center'
    description: 'Click a bar to filter the dashboard. Right-click > Drill down to expand a center into its categories.'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_distribution_centers.name)
        label: 'Distribution Center'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.units_in_stock)
            label: 'Units in Stock'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#2563EB'
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      tooltips: [
        VizTooltip {
          field: VizFieldFull {
            ref: r(thelook.return_rate)
            label: 'Return Rate'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      ]
      settings {
        legend_label: 'hidden'
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
      context {
        analysis {
          breakdown {
            group dc_hierarchy {
              label: 'Distribution center hierarchy'
              fields: [
                r(thelook_distribution_centers.name),
                r(thelook_products.category),
                r(thelook_products.name),
              ]
            }
          }
        }
      }
    }
  }

  block dc_return: VizBlock {
    label: 'Return Rate by Distribution Center'
    description: 'Dashed line marks the 10% return-rate threshold.'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_distribution_centers.name)
        label: 'Distribution Center'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(thelook.return_rate)
            label: 'Return Rate'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#F59E0B'
          }
        }
        series {
          mark_type: 'line'
          field: ConstantVizField {
            value: 0.1
            label: '10% Threshold'
            format {
              type: 'number'
              pattern: '#,###0%'
            }
          }
          settings {
            color: '#DC2626'
            line_style: 'dashed'
          }
        }
        settings {
          axis_min: 0
        }
      }
      settings {
        legend_label: 'top'
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  // ---- Category level ----

  block category_stock: VizBlock {
    label: 'Units in Stock by Category'
    description: 'Click a category to drill into its products below.'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Category'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.units_in_stock)
            label: 'Units in Stock'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#2563EB'
          }
        }
      }
      tooltips: [
        VizTooltip {
          field: VizFieldFull {
            ref: r(thelook.return_rate)
            label: 'Return Rate'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      ]
      settings {
        legend_label: 'hidden'
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
      context {
        analysis {
          breakdown {
            group product_hierarchy {
              label: 'Product hierarchy'
              fields: [
                r(thelook_products.category),
                r(thelook_products.name),
              ]
            }
          }
        }
      }
    }
  }

  block category_return: VizBlock {
    label: 'Return Rate by Category'
    description: 'Dashed line marks the 10% return-rate threshold.'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Category'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(thelook.return_rate)
            label: 'Return Rate'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#F59E0B'
          }
        }
        series {
          mark_type: 'line'
          field: ConstantVizField {
            value: 0.1
            label: '10% Threshold'
            format {
              type: 'number'
              pattern: '#,###0%'
            }
          }
          settings {
            color: '#DC2626'
            line_style: 'dashed'
          }
        }
        settings {
          axis_min: 0
        }
      }
      settings {
        legend_label: 'top'
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  // ---- Detail ----

  block dc_category_pivot: VizBlock {
    label: 'Distribution Center > Category'
    description: 'Return rates above 10% are highlighted in red.'
    viz: PivotTable {
      dataset: thelook
      rows: [
        VizFieldFull {
          ref: r(thelook_distribution_centers.name)
          label: 'Distribution Center'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(thelook_products.category)
          label: 'Category'
          format {
            type: 'text'
          }
        }
      ]
      values: [
        VizFieldFull {
          ref: r(thelook.units_in_stock)
          label: 'Units in Stock'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.return_rate)
          label: 'Return Rate'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        pagination_size: 100
        show_sub_total: true
        show_row_total: false
        show_column_total: true
        conditional_formats: [
          ConditionalFormat {
            ref: r(thelook.return_rate)
            format: SingleFormat {
              condition {
                operator: 'greater_than'
                value: 0.1
              }
              text_color: '#991B1B'
              background_color: '#FEE2E2'
            }
          },
          ConditionalFormat {
            ref: r(thelook.units_in_stock)
            format: ScaleFormat {
              min {
                type: 'percentage'
                value: 0
                color: '#EFF6FF'
              }
              max {
                type: 'percentage'
                value: 100
                color: '#60A5FA'
              }
            }
          }
        ]
      }
    }
  }

  block product_table: VizBlock {
    label: 'Products'
    description: 'Filtered by the selected distribution center and category. Return rates above 10% are highlighted in red.'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          ref: r(thelook_products.category)
          label: 'Category'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(thelook_products.name)
          label: 'Product'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(thelook_products.brand)
          label: 'Brand'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(thelook.units_in_stock)
          label: 'Units in Stock'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.return_rate)
          label: 'Return Rate'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        pagination_size: 25
        sorts: [
          IndexBasedSortSetting {
            field_index: 3
            direction: 'desc'
          }
        ]
        conditional_formats: [
          ConditionalFormat {
            ref: r(thelook.return_rate)
            format: SingleFormat {
              condition {
                operator: 'greater_than'
                value: 0.1
              }
              text_color: '#991B1B'
              background_color: '#FEE2E2'
            }
          },
          ConditionalFormat {
            ref: r(thelook.units_in_stock)
            format: ScaleFormat {
              min {
                type: 'percentage'
                value: 0
                color: '#EFF6FF'
              }
              max {
                type: 'percentage'
                value: 100
                color: '#60A5FA'
              }
            }
          }
        ]
      }
    }
  }

  // ---- Interactions ----

  explicit_interactions: [
    FilterInteraction {
      from: 'dc_filter'
      to: ['dc_stock', 'dc_return', 'category_stock', 'category_return', 'dc_category_pivot', 'product_table']
      field: r(thelook_distribution_centers.name)
    },
    // Click a distribution center to filter the rest
    FilterInteraction {
      from: 'dc_stock'
      to: ['dc_return', 'category_stock', 'category_return', 'dc_category_pivot', 'product_table']
    },
    FilterInteraction {
      from: 'dc_return'
      to: ['dc_stock', 'category_stock', 'category_return', 'dc_category_pivot', 'product_table']
    },
    // Click a category to drill into its products
    FilterInteraction {
      from: 'category_stock'
      to: ['product_table']
    },
    FilterInteraction {
      from: 'category_return'
      to: ['product_table']
    }
  ]

  settings {
    autorun_on_open: true
    autorun_on_changes: true
    cache_duration: 360
  }

  view: HTMLLayout {
    content: @html
      <style>
        .ops {
          display: grid;
          gap: 16px;
          padding: 24px;
          background: #F8FAFC;
          font-family: Inter, system-ui, sans-serif;
          color: #0F172A;
        }
        .ops-header {
          display: flex;
          align-items: flex-end;
          justify-content: space-between;
          gap: 24px;
          flex-wrap: wrap;
        }
        .ops-header h1 {
          margin: 0;
          font-size: 22px;
          font-weight: 600;
        }
        .ops-header p {
          margin: 4px 0 0;
          font-size: 13px;
          color: #475569;
        }
        .legend {
          display: flex;
          gap: 16px;
          font-size: 12px;
          color: #475569;
        }
        .legend span::before {
          content: '';
          display: inline-block;
          width: 10px;
          height: 10px;
          margin-right: 6px;
          border-radius: 2px;
          vertical-align: -1px;
        }
        .legend .stock::before { background: #2563EB; }
        .legend .ret::before { background: #F59E0B; }
        .legend .flag::before { background: #DC2626; height: 2px; vertical-align: 3px; }
        .filter { width: 320px; max-width: 100%; }
        .section-title {
          margin: 8px 0 0;
          font-size: 12px;
          font-weight: 600;
          letter-spacing: 0.06em;
          text-transform: uppercase;
          color: #64748B;
        }
        .row {
          display: grid;
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 16px;
        }
        .card {
          background: #FFFFFF;
          border: 1px solid #E2E8F0;
          border-radius: 8px;
          overflow: hidden;
        }
        .chart { height: 360px; }
        .table { height: 480px; }
        details.card > summary {
          cursor: pointer;
          padding: 12px 16px;
          font-size: 14px;
          font-weight: 600;
          list-style: none;
          border-bottom: 1px solid #E2E8F0;
        }
        details.card > summary::before {
          content: '\25B8';
          display: inline-block;
          margin-right: 8px;
          transition: transform 0.15s;
        }
        details.card[open] > summary::before { transform: rotate(90deg); }
        details.card > summary small {
          font-weight: 400;
          color: #64748B;
          margin-left: 8px;
        }
        @media (max-width: 900px) {
          .row { grid-template-columns: 1fr; }
        }
      </style>

      <main class="ops">
        <header class="ops-header">
          <div>
            <h1>Inventory &amp; Returns Operations</h1>
            <p>Click a distribution center to filter everything. Click a category to drill into its products.</p>
          </div>
          <div class="legend">
            <span class="stock">Units in stock</span>
            <span class="ret">Return rate</span>
            <span class="flag">10% return threshold</span>
          </div>
        </header>

        <div class="filter"><h-block name="dc_filter" /></div>

        <h2 class="section-title">Distribution centers</h2>
        <section class="row">
          <div class="card chart"><h-block name="dc_stock" /></div>
          <div class="card chart"><h-block name="dc_return" /></div>
        </section>

        <details class="card" open>
          <summary>Expand distribution centers into categories<small>Units in stock and return rate, with subtotals per center</small></summary>
          <div class="table"><h-block name="dc_category_pivot" /></div>
        </details>

        <h2 class="section-title">Categories</h2>
        <section class="row">
          <div class="card chart"><h-block name="category_stock" /></div>
          <div class="card chart"><h-block name="category_return" /></div>
        </section>

        <h2 class="section-title">Products in selected category</h2>
        <div class="card table"><h-block name="product_table" /></div>
      </main>
    ;;
  }
}
