Dashboard r07_claude_html_a2 {
  title: 'Operations: Stock & Returns'
  description: 'Units in stock and return rate by distribution center and category. Return rate is flagged above a 10% threshold.'

  // ---------- Filters ----------
  block f_dc: FilterBlock {
    label: 'Distribution Center'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_distribution_centers.name)
    }
  }

  // ---------- KPIs ----------
  block kpi_stock: VizBlock {
    label: 'Units in Stock'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.units_in_stock)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
  }

  block kpi_return: VizBlock {
    label: 'Return Rate'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.return_rate)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
  }

  block kpi_items: VizBlock {
    label: 'Items Sold'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.items_sold)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'left'
      }
    }
  }

  // ---------- Distribution centers ----------
  block dc_stock: VizBlock {
    label: 'Stock Level by Distribution Center'
    description: 'Click a bar to filter the rest of the dashboard to that distribution center.'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_distribution_centers.name)
        label: 'Distribution Center'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.units_in_stock)
            label: 'Units in Stock'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#2F6FDB'
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      tooltips: [
        VizTooltip {
          field: VizFieldFull {
            ref: r(thelook.return_rate)
            label: 'Return Rate'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      ]
      settings {
        legend_label: 'hidden'
        sort {
          field_index: 1
          direction: 'desc'
          type: 'yaxis'
        }
      }
    }
  }

  block dc_return: VizBlock {
    label: 'Return Rate by Distribution Center vs 10% Threshold'
    description: 'Columns above the red dashed line exceed the 10% return-rate threshold. Click a column to filter.'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_distribution_centers.name)
        label: 'Distribution Center'
        format {
          type: 'text'
        }
      }
      y_axis {
        label: 'Return Rate'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(thelook.return_rate)
            label: 'Return Rate'
            format {
              type: 'number'
              pattern: '#,###0.0%'
            }
          }
          settings {
            color: '#8A94A6'
          }
        }
        series {
          mark_type: 'line'
          field: ConstantVizField {
            value: 0.1
            label: '10% Threshold'
            format {
              type: 'number'
              pattern: '#,###0%'
            }
          }
          settings {
            color: '#D14343'
            line_style: 'dashed'
          }
        }
        settings {
          axis_min: 0
        }
      }
      settings {
        legend_label: 'top'
        show_data_points: false
      }
    }
  }

  // ---------- Categories & products ----------
  block cat_stock: VizBlock {
    label: 'Stock Level by Category'
    description: 'Click a category to show its products in the table on the right. Right-click > Drill down to break it down by product.'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Category'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.units_in_stock)
            label: 'Units in Stock'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#2F6FDB'
          }
        }
      }
      tooltips: [
        VizTooltip {
          field: VizFieldFull {
            ref: r(thelook.return_rate)
            label: 'Return Rate'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      ]
      settings {
        legend_label: 'hidden'
        sort {
          field_index: 1
          direction: 'desc'
          type: 'yaxis'
        }
      }
      context {
        analysis {
          breakdown {
            group product_hierarchy {
              label: 'Category > Product'
              fields: [
                r(thelook_products.category),
                r(thelook_products.name),
              ]
            }
          }
        }
      }
    }
  }

  block products: VizBlock {
    label: 'Products'
    description: 'Filtered by the selected distribution center and category. Return rates above 10% are flagged red.'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          ref: r(thelook_products.name)
          label: 'Product'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(thelook_products.category)
          label: 'Category'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(thelook.units_in_stock)
          label: 'Units in Stock'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.return_rate)
          label: 'Return Rate'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        pagination_size: 25
        sorts: [
          IndexBasedSortSetting {
            field_index: 2
            direction: 'desc'
          }
        ]
        conditional_formats: [
          ConditionalFormat {
            ref: r(thelook.return_rate)
            format: SingleFormat {
              condition {
                operator: 'greater_than'
                value: 0.1
              }
              text_color: '#B42318'
              background_color: '#FDECEA'
            }
          }
        ]
      }
    }
  }

  // ---------- DC > Category breakdown ----------
  block dc_cat_pivot: VizBlock {
    label: 'Distribution Center > Category'
    description: 'Expand a distribution center to see its categories. Return rates above 10% are flagged red.'
    viz: PivotTable {
      dataset: thelook
      rows: [
        VizFieldFull {
          ref: r(thelook_distribution_centers.name)
          label: 'Distribution Center'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(thelook_products.category)
          label: 'Category'
          format {
            type: 'text'
          }
        }
      ]
      values: [
        VizFieldFull {
          ref: r(thelook.units_in_stock)
          label: 'Units in Stock'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.return_rate)
          label: 'Return Rate'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        show_row_total: false
        show_column_total: true
        show_sub_total: true
        pagination_size: 50
        conditional_formats: [
          ConditionalFormat {
            ref: r(thelook.return_rate)
            format: SingleFormat {
              condition {
                operator: 'greater_than'
                value: 0.1
              }
              text_color: '#B42318'
              background_color: '#FDECEA'
            }
          }
        ]
      }
    }
  }

  // ---------- Interactions ----------
  explicit_interactions: [
    FilterInteraction {
      from: 'f_dc'
      to: ['kpi_stock', 'kpi_return', 'kpi_items', 'dc_stock', 'dc_return', 'cat_stock', 'products', 'dc_cat_pivot']
      field: r(thelook_distribution_centers.name)
    },
    FilterInteraction {
      from: 'dc_stock'
      to: ['kpi_stock', 'kpi_return', 'kpi_items', 'dc_return', 'cat_stock', 'products', 'dc_cat_pivot']
    },
    FilterInteraction {
      from: 'dc_return'
      to: ['kpi_stock', 'kpi_return', 'kpi_items', 'dc_stock', 'cat_stock', 'products', 'dc_cat_pivot']
    },
    FilterInteraction {
      from: 'cat_stock'
      to: ['products']
    }
  ]

  // ---------- Layout ----------
  view: HTMLLayout {
    content: @html
      <style>
        .ops {
          font-family: Inter, system-ui, -apple-system, 'Segoe UI', sans-serif;
          color: #1F2937;
          background: #F6F7F9;
          padding: 24px;
          display: flex;
          flex-direction: column;
          gap: 16px;
        }
        .ops-header {
          display: flex;
          justify-content: space-between;
          align-items: flex-end;
          gap: 24px;
          flex-wrap: wrap;
        }
        .ops-title h1 {
          font-size: 22px;
          font-weight: 600;
          margin: 0 0 4px 0;
        }
        .ops-title p {
          font-size: 13px;
          color: #6B7280;
          margin: 0;
        }
        .ops-filter {
          width: 320px;
          height: 72px;
        }
        .legend {
          display: flex;
          gap: 16px;
          font-size: 12px;
          color: #4B5563;
          align-items: center;
          flex-wrap: wrap;
        }
        .legend .swatch {
          display: inline-block;
          width: 10px;
          height: 10px;
          border-radius: 2px;
          margin-right: 6px;
          vertical-align: middle;
        }
        .legend .flag {
          background: #FDECEA;
          color: #B42318;
          font-weight: 600;
          padding: 2px 8px;
          border-radius: 10px;
        }
        .kpis {
          display: grid;
          grid-template-columns: repeat(3, minmax(0, 1fr));
          gap: 16px;
        }
        .card {
          background: #FFFFFF;
          border: 1px solid #E5E7EB;
          border-radius: 10px;
          overflow: hidden;
        }
        .kpi { height: 120px; }
        .section-label {
          font-size: 12px;
          font-weight: 600;
          letter-spacing: 0.06em;
          text-transform: uppercase;
          color: #6B7280;
          margin: 8px 0 -4px 2px;
        }
        .row-2 {
          display: grid;
          grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
          gap: 16px;
        }
        .chart { height: 420px; }
        .tall { height: 560px; }
        .pivot { height: 640px; }
        @media (max-width: 900px) {
          .kpis, .row-2 { grid-template-columns: 1fr; }
          .ops-filter { width: 100%; }
        }
      </style>

      <div class="ops">
        <div class="ops-header">
          <div class="ops-title">
            <h1>Operations: Stock &amp; Returns</h1>
            <p>Inventory on hand and return performance across distribution centers and product categories.</p>
          </div>
          <div class="ops-filter"><h-block name="f_dc" /></div>
        </div>

        <div class="legend">
          <span><span class="swatch" style="background:#2F6FDB"></span>Units in stock</span>
          <span><span class="swatch" style="background:#D14343"></span>10% return-rate threshold</span>
          <span class="flag">&gt; 10% = flagged</span>
          <span>Click a distribution center to filter the dashboard. Click a category to see its products.</span>
        </div>

        <div class="kpis">
          <div class="card kpi"><h-block name="kpi_stock" /></div>
          <div class="card kpi"><h-block name="kpi_return" /></div>
          <div class="card kpi"><h-block name="kpi_items" /></div>
        </div>

        <div class="section-label">Distribution centers</div>
        <div class="row-2">
          <div class="card chart"><h-block name="dc_stock" /></div>
          <div class="card chart"><h-block name="dc_return" /></div>
        </div>

        <div class="section-label">Categories &amp; products</div>
        <div class="row-2">
          <div class="card tall"><h-block name="cat_stock" /></div>
          <div class="card tall"><h-block name="products" /></div>
        </div>

        <div class="section-label">Distribution center &gt; category</div>
        <div class="card pivot"><h-block name="dc_cat_pivot" /></div>
      </div>
    ;;
  }
}
