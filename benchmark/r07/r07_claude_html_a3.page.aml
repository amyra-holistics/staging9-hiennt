Dashboard r07_claude_html_a3 {
  title: 'Operations: Stock & Returns'
  description: 'Units in stock and return rate by distribution center and category, with return rate flagged against a 10% threshold.'
  owner: 'thinh.nt@holistics.io'

  block kpi_units_in_stock: VizBlock {
    label: 'Units in Stock'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.units_in_stock)
        label: 'Units in Stock'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block kpi_return_rate: VizBlock {
    label: 'Return Rate'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.return_rate)
        label: 'Return Rate'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block dc_stock: VizBlock {
    label: 'Stock & Return Rate by Distribution Center'
    description: 'Click a distribution center to filter the rest of the dashboard.'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_distribution_centers.name)
        label: 'Distribution Center'
      }
      y_axis {
        label: 'Units in Stock'
        series {
          mark_type: 'bar'
          field: VizFieldFull {
            ref: r(thelook.units_in_stock)
            label: 'Units in Stock'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#2563EB'
          }
        }
      }
      y_axis {
        label: 'Return Rate'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.return_rate)
            label: 'Return Rate'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#D97706'
          }
        }
        series {
          mark_type: 'line'
          field: ConstantVizField {
            value: 0.1
            label: '10% threshold'
            format {
              type: 'number'
              pattern: '#,###0.0%'
            }
          }
          settings {
            color: '#DC2626'
            line_style: 'dashed'
          }
        }
        settings {
          alignment: 'right'
        }
      }
      settings {
        legend_label: 'bottom'
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block category_stock: VizBlock {
    label: 'Stock & Return Rate by Category'
    description: 'Click a category to list its products below, or right-click → Drill down to break it into products.'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Category'
      }
      y_axis {
        label: 'Units in Stock'
        series {
          mark_type: 'bar'
          field: VizFieldFull {
            ref: r(thelook.units_in_stock)
            label: 'Units in Stock'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#2563EB'
          }
        }
      }
      y_axis {
        label: 'Return Rate'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.return_rate)
            label: 'Return Rate'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#D97706'
          }
        }
        series {
          mark_type: 'line'
          field: ConstantVizField {
            value: 0.1
            label: '10% threshold'
            format {
              type: 'number'
              pattern: '#,###0.0%'
            }
          }
          settings {
            color: '#DC2626'
            line_style: 'dashed'
          }
        }
        settings {
          alignment: 'right'
        }
      }
      settings {
        legend_label: 'bottom'
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
      context {
        analysis {
          breakdown {
            group product_hierarchy {
              label: 'Category → Product'
              fields: [
                r(thelook_products.category),
                r(thelook_products.name),
              ]
            }
          }
        }
      }
    }
  }

  block dc_category_pivot: VizBlock {
    label: 'Distribution Center → Category'
    description: 'Expand a distribution center to see its categories. Return rates above 10% are flagged red.'
    viz: PivotTable {
      dataset: thelook
      rows: [
        VizFieldFull {
          ref: r(thelook_distribution_centers.name)
          label: 'Distribution Center'
        },
        VizFieldFull {
          ref: r(thelook_products.category)
          label: 'Category'
        },
      ]
      values: [
        VizFieldFull {
          ref: r(thelook.units_in_stock)
          label: 'Units in Stock'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.return_rate)
          label: 'Return Rate'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
      ]
      settings {
        show_sub_total: true
        show_column_total: true
        show_row_total: false
        conditional_formats: [
          ConditionalFormat {
            ref: r(thelook.return_rate)
            format: SingleFormat {
              condition {
                operator: 'greater_than'
                value: 0.1
              }
              text_color: '#B42318'
              background_color: '#FEE4E2'
            }
          },
          ConditionalFormat {
            ref: r(thelook.units_in_stock)
            format: ScaleFormat {
              min {
                type: 'percentage'
                value: 0
                color: '#FFFFFF'
              }
              max {
                type: 'percentage'
                value: 100
                color: '#93C5FD'
              }
            }
          },
        ]
        wrap_header_text: true
      }
    }
  }

  block product_detail: VizBlock {
    label: 'Products'
    description: 'Filtered by the selected distribution center and category.'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          ref: r(thelook_products.name)
          label: 'Product'
        },
        VizFieldFull {
          ref: r(thelook_products.category)
          label: 'Category'
        },
        VizFieldFull {
          ref: r(thelook_products.brand)
          label: 'Brand'
        },
        VizFieldFull {
          ref: r(thelook.units_in_stock)
          label: 'Units in Stock'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.return_rate)
          label: 'Return Rate'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
      ]
      settings {
        pagination_size: 15
        sorts: [
          IndexBasedSortSetting {
            field_index: 3
            direction: 'desc'
          }
        ]
        conditional_formats: [
          ConditionalFormat {
            ref: r(thelook.return_rate)
            format: SingleFormat {
              condition {
                operator: 'greater_than'
                value: 0.1
              }
              text_color: '#B42318'
              background_color: '#FEE4E2'
            }
          },
          ConditionalFormat {
            ref: r(thelook.units_in_stock)
            format: ScaleFormat {
              min {
                type: 'percentage'
                value: 0
                color: '#FFFFFF'
              }
              max {
                type: 'percentage'
                value: 100
                color: '#93C5FD'
              }
            }
          },
        ]
      }
    }
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'dc_stock'
      to: ['kpi_units_in_stock', 'kpi_return_rate', 'category_stock', 'dc_category_pivot', 'product_detail']
    },
    FilterInteraction {
      from: 'category_stock'
      to: ['product_detail']
    }
  ]

  view: HTMLLayout {
    content: @html
      <style>
        .ops, .ops * { box-sizing: border-box; }
        .ops {
          font-family: Inter, system-ui, sans-serif;
          color: #1F2937;
          background: #F5F6F8;
          padding: 24px;
          display: flex;
          flex-direction: column;
          gap: 16px;
        }
        .ops-header {
          display: grid;
          grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr);
          gap: 16px;
          align-items: stretch;
        }
        .ops-title h1 { margin: 0 0 6px; font-size: 24px; font-weight: 600; }
        .ops-title p { margin: 0; font-size: 13px; line-height: 1.5; color: #6B7280; }
        .ops-legend { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 10px; font-size: 12px; color: #4B5563; }
        .ops-legend span { display: inline-flex; align-items: center; gap: 6px; }
        .sw { display: inline-block; width: 12px; height: 12px; border-radius: 2px; }
        .sw-stock { background: #2563EB; }
        .sw-rate { background: #D97706; height: 3px; }
        .sw-flag { background: #FEE4E2; border: 1px solid #B42318; }
        .sw-line { width: 14px; height: 0; border-top: 2px dashed #DC2626; border-radius: 0; }
        .card {
          min-width: 0;
          background: #FFFFFF;
          border: 1px solid #E5E7EB;
          border-radius: 10px;
          overflow: hidden;
        }
        .kpi { height: 120px; }
        .section-label {
          margin: 8px 0 -4px;
          font-size: 12px;
          font-weight: 600;
          letter-spacing: 0.06em;
          text-transform: uppercase;
          color: #6B7280;
        }
        .row {
          display: grid;
          grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
          gap: 16px;
        }
        .chart { height: 400px; }
        .table { height: 520px; }
        @media (max-width: 1000px) {
          .ops-header, .row { grid-template-columns: 1fr; }
        }
      </style>

      <div class="ops">
        <div class="ops-header">
          <div class="ops-title">
            <h1>Operations: Stock &amp; Returns</h1>
            <p>Click a distribution center bar to filter everything below. Click a category to list its products, or right-click it to drill down.</p>
            <div class="ops-legend">
              <span><i class="sw sw-stock"></i>Units in stock</span>
              <span><i class="sw sw-rate"></i>Return rate</span>
              <span><i class="sw sw-line"></i>10% threshold</span>
              <span><i class="sw sw-flag"></i>Above 10%</span>
            </div>
          </div>
          <div class="card kpi"><h-block name="kpi_units_in_stock" /></div>
          <div class="card kpi"><h-block name="kpi_return_rate" /></div>
        </div>

        <div class="section-label">Stock levels vs. return rate</div>
        <div class="row">
          <div class="card chart"><h-block name="dc_stock" /></div>
          <div class="card chart"><h-block name="category_stock" /></div>
        </div>

        <div class="section-label">Detail</div>
        <div class="row">
          <div class="card table"><h-block name="dc_category_pivot" /></div>
          <div class="card table"><h-block name="product_detail" /></div>
        </div>
      </div>
    ;;
  }

  theme {
    block {
      border { border_width: 0 }
    }
  }
}
