Dashboard r07_hai_canvas_a1 {
  title: 'Operations Dashboard'
  description: 'Monitor inventory levels and return rates by distribution center, category, and product.'
  theme: H.themes.classic

  settings {
    timezone: 'UTC'
    cache_duration: 3600
    autorun: true
  }

  block title: TextBlock {
    content: @md
# Operations Dashboard

Monitor stock availability and return-risk hotspots. Click a **distribution center** in the stock chart to filter the dashboard; click a **category** in the return-rate table to inspect its products. Expand distribution centers in the matrix to view category detail.
;;
  }

  block stock_by_distribution_center: VizBlock {
    label: 'Stock Level by Distribution Center'
    viz: CombinationChart {
      dataset: thelook

      x_axis: VizFieldFull {
        ref: r(thelook_distribution_centers.name)
        label: 'Distribution Center'
      }

      y_axis {
        label: 'Units in Stock'

        series {
          mark_type: 'bar'

          field: VizFieldFull {
            ref: r(thelook.units_in_stock)
            label: 'Units in Stock'

            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }

      settings {
        legend_label: 'hidden'

        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block inventory_return_matrix: VizBlock {
    label: 'Inventory and Return Rate by Distribution Center and Category'
    viz: PivotTable {
      dataset: thelook

      rows: [
        VizFieldFull {
          ref: r(thelook_distribution_centers.name)
          label: 'Distribution Center'

          format {
            type: 'text'
          }

          uname: 'distribution_center_name'
        },
        VizFieldFull {
          ref: r(thelook_products.category)
          label: 'Product Category'

          format {
            type: 'text'
          }

          uname: 'product_category'
        },
      ]

      values: [
        VizFieldFull {
          ref: r(thelook.units_in_stock)
          label: 'Units in Stock'

          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.return_rate)
          label: 'Return Rate'

          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        },
      ]

      settings {
        pagination_size: 100
        show_row_total: true
        show_column_total: false
        show_sub_total: true
        wrap_header_text: true
        wrap_cell_text: false

        sorts: [
          KeyBasedSortSetting {
            key: 'distribution_center_name'
            direction: 'asc'
          },
          KeyBasedSortSetting {
            key: 'product_category'
            direction: 'asc'
          },
        ]
      }
    }
  }

  block return_rate_by_category: VizBlock {
    label: 'Return Rate by Category — 10% Threshold'
    viz: DataTable {
      dataset: thelook

      fields: [
        VizFieldFull {
          label: 'Product Category'
          ref: r(thelook_products.category)

          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'Return Rate'
          ref: r(thelook.return_rate)

          format {
            type: 'number'
            pattern: '#,###0.0%'
          }

          uname: 'return_rate'
        },
      ]

      settings {
        pagination_size: 100
        show_row_number: true
        single_cell_display: 'normal'

        conditional_formats: [
          ConditionalFormat {
            ref: r(thelook.return_rate)

            format: SingleFormat {
              condition {
                operator: 'greater_than_equal'
                value: 0.1
              }

              text_color: '#B91C1C'
              background_color: '#FEE2E2'
            }
          },
          ConditionalFormat {
            ref: r(thelook.return_rate)

            format: SingleFormat {
              condition {
                operator: 'less_than'
                value: 0.1
              }

              text_color: '#15803D'
              background_color: '#DCFCE7'
            }
          },
        ]

        sorts: [
          KeyBasedSortSetting {
            key: 'return_rate'
            direction: 'desc'
          },
        ]
      }
    }
  }

  block product_operations_detail: VizBlock {
    label: 'Product Inventory Detail'
    viz: DataTable {
      dataset: thelook

      fields: [
        VizFieldFull {
          label: 'Product Category'
          ref: r(thelook_products.category)

          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'Product Name'
          ref: r(thelook_products.name)

          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'Product Brand'
          ref: r(thelook_products.brand)

          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'Units in Stock'
          ref: r(thelook.units_in_stock)

          format {
            type: 'number'
            pattern: 'inherited'
          }

          uname: 'units_in_stock'
        },
        VizFieldFull {
          label: 'Return Rate'
          ref: r(thelook.return_rate)

          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        },
      ]

      settings {
        pagination_size: 100
        show_row_number: true
        wrap_header_text: true

        sorts: [
          KeyBasedSortSetting {
            key: 'units_in_stock'
            direction: 'desc'
          },
        ]
      }
    }
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'stock_by_distribution_center'
      to: [
        'inventory_return_matrix',
        'return_rate_by_category',
        'product_operations_detail',
      ]
      field: r(thelook_distribution_centers.name)
    },
    FilterInteraction {
      from: 'return_rate_by_category'
      to: ['product_operations_detail']
      field: r(thelook_products.category)
    },
  ]

  view: CanvasLayout {
    label: 'Operations Overview'
    width: 1440
    height: 1400
    grid_size: 20
    auto_expand_vertically: true

    block title {
      position: pos(40, 30, 1360, 130)
      layer: 1
    }

    block stock_by_distribution_center {
      position: pos(40, 190, 660, 440)
      layer: 1
    }

    block return_rate_by_category {
      position: pos(740, 190, 660, 440)
      layer: 1
    }

    block inventory_return_matrix {
      position: pos(40, 670, 840, 620)
      layer: 1
    }

    block product_operations_detail {
      position: pos(920, 670, 480, 620)
      layer: 1
    }

    mobile {
      mode: 'auto'
    }
  }
}
