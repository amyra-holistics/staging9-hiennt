Dashboard r07_hai_canvas_a3 {
  title: 'Operations Dashboard'
  description: '''
Monitor inventory availability and product-return risk by distribution center and category.

- Click a distribution center in the stock-level chart to filter the detail views.
- Expand a distribution center in the pivot table to inspect its categories.
- Click a category in the pivot table to filter the product-level inventory detail.
- Return rates at or above 10% are flagged in red.
'''
  theme: H.themes.classic

  settings {
    timezone: 'UTC'
    autorun: true
    cache_duration: 3600
  }

  block title: TextBlock {
    content: @md
# Operations Dashboard

Monitor available inventory and return-rate risk across distribution centers and product categories.
;;
  }

  block instructions: TextBlock {
    content: @md
**How to explore:** Click a distribution center in the stock chart to filter the other views. Expand a distribution center in the table to inspect categories, then click a category to see its products. **Return rates ≥10%** are highlighted.
;;
  }

  block v_stock_by_distribution_center: VizBlock {
    label: 'Units in Stock by Distribution Center'
    description: 'Click a bar to filter the category and product detail views.'
    viz: BarChart {
      dataset: thelook

      x_axis: VizFieldFull {
        ref: r(thelook_distribution_centers.name)
        label: 'Distribution Center'
        format {
          type: 'text'
        }
      }

      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.units_in_stock)
            label: 'Units in Stock'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }

      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block v_distribution_center_category: VizBlock {
    label: 'Inventory and Return Rate by Distribution Center and Category'
    description: 'Expand each distribution center to view category-level stock and return rates. Return rates at or above 10% are flagged.'
    viz: PivotTable {
      dataset: thelook

      calculation return_rate_variance_to_threshold {
        label: 'Return Rate Variance to 10% Threshold'
        formula: @aql return_rate - 0.10;;
        calc_type: 'measure'
        data_type: 'number'
      }

      rows: [
        VizFieldFull {
          ref: r(thelook_distribution_centers.name)
          label: 'Distribution Center'
          uname: 'distribution_center'
        },
        VizFieldFull {
          ref: r(thelook_products.category)
          label: 'Product Category'
          uname: 'product_category'
        }
      ]

      values: [
        VizFieldFull {
          ref: r(thelook.units_in_stock)
          label: 'Units in Stock'
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'units_in_stock'
        },
        VizFieldFull {
          ref: r(thelook.return_rate)
          label: 'Return Rate'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
          uname: 'return_rate'
        },
        VizFieldFull {
          ref: 'return_rate_variance_to_threshold'
          label: 'Variance to 10% Threshold'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
          uname: 'return_rate_variance_to_threshold'
        }
      ]

      settings {
        pagination_size: 100
        show_row_total: false
        show_column_total: false
        show_sub_total: false
        wrap_header_text: true

        conditional_formats: [
          ConditionalFormat {
            ref: r(thelook.return_rate)
            format: SingleFormat {
              condition {
                operator: 'greater_than_equal'
                value: 0.10
              }
              text_color: '#991B1B'
              background_color: '#FEE2E2'
            }
          }
        ]

        sorts: [
          KeyBasedSortSetting {
            key: 'return_rate_variance_to_threshold'
            direction: 'desc'
          },
          KeyBasedSortSetting {
            key: 'units_in_stock'
            direction: 'desc'
          },
          KeyBasedSortSetting {
            key: 'distribution_center'
            direction: 'asc'
          },
          KeyBasedSortSetting {
            key: 'product_category'
            direction: 'asc'
          }
        ]
      }
    }
  }

  block v_product_inventory_detail: VizBlock {
    label: 'Product Inventory Drill-Down'
    description: 'Click a category in the distribution-center table to filter this product-level inventory detail.'
    viz: DataTable {
      dataset: thelook

      fields: [
        VizFieldFull {
          label: 'Product Category'
          ref: r(thelook_products.category)
          format {
            type: 'text'
          }
          uname: 'product_category'
        },
        VizFieldFull {
          label: 'Product Name'
          ref: r(thelook_products.name)
          format {
            type: 'text'
          }
          uname: 'product_name'
        },
        VizFieldFull {
          label: 'Distribution Center'
          ref: r(thelook_distribution_centers.name)
          format {
            type: 'text'
          }
          uname: 'distribution_center'
        },
        VizFieldFull {
          label: 'Units in Stock'
          ref: r(thelook.units_in_stock)
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'units_in_stock'
        }
      ]

      settings {
        pagination_size: 100
        show_row_number: true
        wrap_header_text: true

        sorts: [
          KeyBasedSortSetting {
            key: 'product_category'
            direction: 'asc'
          },
          KeyBasedSortSetting {
            key: 'product_name'
            direction: 'asc'
          }
        ]
      }
    }
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'v_stock_by_distribution_center'
      to: [
        'v_distribution_center_category',
        'v_product_inventory_detail'
      ]
    },
    FilterInteraction {
      from: 'v_distribution_center_category'
      to: [
        'v_product_inventory_detail'
      ]
    }
  ]

  view: CanvasLayout {
    label: 'Operations Overview'
    width: 1220
    height: 1280
    grid_size: 20
    auto_expand_vertically: true

    block title {
      position: pos(20, 20, 1180, 80)
      layer: 1
    }

    block instructions {
      position: pos(20, 110, 1180, 70)
      layer: 1
    }

    block v_stock_by_distribution_center {
      position: pos(20, 200, 580, 400)
      layer: 1
    }

    block v_distribution_center_category {
      position: pos(620, 200, 580, 400)
      layer: 1
    }

    block v_product_inventory_detail {
      position: pos(20, 620, 1180, 580)
      layer: 1
    }

    mobile {
      mode: 'auto'
    }
  }
}
