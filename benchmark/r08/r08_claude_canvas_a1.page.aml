Dashboard r08_claude_canvas_a1 {
  title: 'CEO Monthly Sales Review'
  description: 'Monthly sales review for the CEO: headline KPIs vs. the previous month, 13-month trend, and where sales came from.'

  block t_header: TextBlock {
    content: @md
      # CEO Monthly Sales Review
      Defaults to the **last complete month**. KPIs compare against the month before. Net Sales exclude Cancelled and Returned items.
    ;;
  }

  block f_month: FilterBlock {
    label: 'Review Month'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
    default {
      operator: 'last'
      value: 1
      modifier: 'month'
    }
  }

  block f_department: FilterBlock {
    label: 'Department'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.department)
    }
  }

  block kpi_net_sales: VizBlock {
    label: 'Net Sales'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
      }
    }
  }

  block kpi_gross_profit: VizBlock {
    label: 'Gross Profit'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_profit)
        label: 'Gross Profit'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
      }
    }
  }

  block kpi_gross_margin: VizBlock {
    label: 'Gross Margin'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: false
        value {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_number'
        alignment: 'left'
      }
    }
  }

  block kpi_orders: VizBlock {
    label: 'Fulfilled Orders'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        label: 'Fulfilled Orders'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
      }
    }
  }

  block kpi_aov: VizBlock {
    label: 'Average Order Value'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
      }
    }
  }

  block kpi_return_rate: VizBlock {
    label: 'Return Rate'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.return_rate)
        label: 'Return Rate'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: false
        value {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_number'
        alignment: 'left'
        compare_value {
          reverse_color: true
        }
      }
    }
  }

  block v_trend: VizBlock {
    label: 'Net Sales & Gross Margin — Last 13 Complete Months'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        label: 'Net Sales'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#255DD4'
          }
        }
        settings {
          alignment: 'left'
        }
      }
      y_axis {
        label: 'Gross Margin'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.gross_margin)
            label: 'Gross Margin'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#E27712'
          }
        }
        settings {
          alignment: 'right'
        }
      }
      filter {
        field: r(thelook_order_items.created_at)
        operator: 'last'
        value: 13
        modifier: 'month'
      }
      settings {
        legend_label: 'top'
        show_data_points: true
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block v_category: VizBlock {
    label: 'Top 10 Categories by Net Sales'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#255DD4'
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      settings {
        legend_label: 'hidden'
        row_limit: 10
        sort: LineFamilySort {
          type: 'yaxis'
          direction: 'desc'
        }
      }
    }
  }

  block v_country: VizBlock {
    label: 'Top 10 Countries by Net Sales'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.country)
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#18A59E'
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      settings {
        legend_label: 'hidden'
        row_limit: 10
        sort: LineFamilySort {
          type: 'yaxis'
          direction: 'desc'
        }
      }
    }
  }

  block v_brands: VizBlock {
    label: 'Top 10 Brands'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          label: 'Brand'
          ref: r(thelook_products.brand)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'Net Sales'
          ref: r(thelook.net_sales)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'Gross Profit'
          ref: r(thelook.gross_profit)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'Gross Margin'
          ref: r(thelook.gross_margin)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'Items Sold'
          ref: r(thelook.items_sold)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'Return Rate'
          ref: r(thelook.return_rate)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
      ]
      filter {
        field: r(thelook.net_sales)
        operator: 'greater_than'
        value: 0
      }
      settings {
        pagination_size: 10
        row_limit: 10
        show_row_number: true
        sorts: [
          IndexBasedSortSetting {
            field_index: 1
            direction: 'desc'
          }
        ]
      }
    }
  }

  interactions: [
    FilterInteraction {
      from: 'f_month'
      to: [
        CustomMapping {
          block: 'v_trend'
          disabled: true
        }
      ]
    }
  ]

  view: CanvasLayout {
    label: 'Monthly Review'
    width: 1300
    height: 1440
    grid_size: 20
    auto_expand_vertically: true
    block t_header {
      position: pos(20, 20, 780, 80)
    }
    block f_month {
      position: pos(820, 20, 220, 80)
    }
    block f_department {
      position: pos(1060, 20, 220, 80)
    }
    block kpi_net_sales {
      position: pos(20, 120, 200, 120)
    }
    block kpi_gross_profit {
      position: pos(232, 120, 200, 120)
    }
    block kpi_gross_margin {
      position: pos(444, 120, 200, 120)
    }
    block kpi_orders {
      position: pos(656, 120, 200, 120)
    }
    block kpi_aov {
      position: pos(868, 120, 200, 120)
    }
    block kpi_return_rate {
      position: pos(1080, 120, 200, 120)
    }
    block v_trend {
      position: pos(20, 260, 1260, 360)
    }
    block v_category {
      position: pos(20, 640, 620, 380)
    }
    block v_country {
      position: pos(660, 640, 620, 380)
    }
    block v_brands {
      position: pos(20, 1040, 1260, 380)
    }
    mobile {
      mode: 'auto'
    }
  }

  theme: H.themes.vanilla
}
