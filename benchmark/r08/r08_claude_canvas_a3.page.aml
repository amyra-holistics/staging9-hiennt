Dashboard r08_claude_canvas_a3 {
  title: 'CEO Monthly Sales Review'
  description: 'Monthly sales performance for TheLook: headline KPIs vs the previous month, 13-month trend, and where sales came from.'

  block title: TextBlock {
    content: @md
# CEO Monthly Sales Review
Review month defaults to **last complete month**. KPI changes are vs the previous month. Net Sales exclude Cancelled and Returned items.
    ;;
  }

  block f_month: FilterBlock {
    label: 'Review Month'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
    default {
      operator: 'matches'
      value: 'last month'
    }
  }

  block f_department: FilterBlock {
    label: 'Department'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.department)
    }
    default {
      operator: 'is'
      value: []
    }
  }

  block f_country: FilterBlock {
    label: 'Customer Country'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.country)
    }
    default {
      operator: 'is'
      value: []
    }
  }

  block kpi_net_sales: VizBlock {
    label: 'Net Sales'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'center'
      }
    }
    settings {
      hide_label: true
    }
  }

  block kpi_gross_profit: VizBlock {
    label: 'Gross Profit'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_profit)
        label: 'Gross Profit'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'center'
      }
    }
    settings {
      hide_label: true
    }
  }

  block kpi_gross_margin: VizBlock {
    label: 'Gross Margin'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'center'
      }
    }
    settings {
      hide_label: true
    }
  }

  block kpi_orders: VizBlock {
    label: 'Fulfilled Orders'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        label: 'Fulfilled Orders'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'center'
      }
    }
    settings {
      hide_label: true
    }
  }

  block kpi_aov: VizBlock {
    label: 'Average Order Value'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'center'
      }
    }
    settings {
      hide_label: true
    }
  }

  block kpi_return_rate: VizBlock {
    label: 'Return Rate'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.return_rate)
        label: 'Return Rate'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'center'
      }
    }
    settings {
      hide_label: true
    }
  }

  block v_trend: VizBlock {
    label: 'Net Sales, Gross Profit & Margin — Last 13 Months'
    description: 'Trailing 13 complete months. Not affected by the Review Month filter.'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        label: 'Month'
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        label: 'Sales and Profit'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            label: 'Net Sales'
            ref: r(thelook.net_sales)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        series {
          mark_type: 'column'
          field: VizFieldFull {
            label: 'Gross Profit'
            ref: r(thelook.gross_profit)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        settings {
          alignment: 'left'
        }
      }
      y_axis {
        label: 'Gross Margin'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            label: 'Gross Margin'
            ref: r(thelook.gross_margin)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        settings {
          alignment: 'right'
        }
      }
      filter {
        field: r(thelook_order_items.created_at)
        operator: 'matches'
        value: 'last 13 months'
      }
      settings {
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
        legend_label: 'bottom'
        show_data_points: true
      }
    }
  }

  block v_category: VizBlock {
    label: 'Top 10 Categories by Net Sales'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Category'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      settings {
        row_limit: 10
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block v_country: VizBlock {
    label: 'Top 10 Customer Countries by Net Sales'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.country)
        label: 'Country'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      settings {
        row_limit: 10
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block v_brands: VizBlock {
    label: 'Top 10 Brands'
    description: 'Return Rate is shaded green (low) to red (high).'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          ref: r(thelook_products.brand)
          label: 'Brand'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.gross_profit)
          label: 'Gross Profit'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.gross_margin)
          label: 'Gross Margin'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.items_sold)
          label: 'Items Sold'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.return_rate)
          label: 'Return Rate'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
      ]
      filter {
        field: r(thelook.net_sales)
        operator: 'greater_than'
        value: 0
      }
      settings {
        pagination_size: 10
        row_limit: 10
        show_row_number: true
        single_cell_display: 'normal'
        sorts: [
          IndexBasedSortSetting {
            field_index: 1
            direction: 'desc'
          },
        ]
        conditional_formats: [
          ConditionalFormat {
            ref: r(thelook.return_rate)
            format: ScaleFormat {
              min {
                type: 'value'
                value: 0
                color: '#DCFCE7'
              }
              mid {
                type: 'value'
                value: 0.1
                color: '#FEF3C7'
              }
              max {
                type: 'value'
                value: 0.2
                color: '#FECACA'
              }
            }
          },
        ]
      }
    }
  }

  interactions: [
    FilterInteraction {
      from: 'f_month'
      to: [
        CustomMapping {
          block: 'v_trend'
          disabled: true
        }
      ]
    }
  ]

  view: CanvasLayout {
    label: 'View 1'
    width: 1300
    height: 1440
    grid_size: 20
    auto_expand_vertically: true
    block title {
      position: pos(20, 20, 620, 80)
    }
    block f_month {
      position: pos(660, 20, 200, 80)
    }
    block f_department {
      position: pos(880, 20, 190, 80)
    }
    block f_country {
      position: pos(1090, 20, 190, 80)
    }
    block kpi_net_sales {
      position: pos(20, 120, 200, 120)
    }
    block kpi_gross_profit {
      position: pos(232, 120, 200, 120)
    }
    block kpi_gross_margin {
      position: pos(444, 120, 200, 120)
    }
    block kpi_orders {
      position: pos(656, 120, 200, 120)
    }
    block kpi_aov {
      position: pos(868, 120, 200, 120)
    }
    block kpi_return_rate {
      position: pos(1080, 120, 200, 120)
    }
    block v_trend {
      position: pos(20, 260, 1260, 360)
    }
    block v_category {
      position: pos(20, 640, 620, 380)
    }
    block v_country {
      position: pos(660, 640, 620, 380)
    }
    block v_brands {
      position: pos(20, 1040, 1260, 380)
    }
    mobile {
      mode: 'auto'
    }
  }

  theme: H.themes.vanilla
}
