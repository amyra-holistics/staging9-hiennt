Dashboard r08_claude_fd_canvas_a1 {
  title: 'CEO Monthly Sales Review'
  description: 'Monthly sales review for the CEO: headline KPIs vs the prior month, 13-month trend vs prior year, and where sales came from.'

  // ---------- Header ----------
  block t_header: TextBlock {
    content: @md
# CEO Monthly Sales Review
Headline results for the selected month, compared with the month before. Net figures exclude Cancelled and Returned items.
    ;;
  }

  block t_notes: TextBlock {
    content: @md
**How to read.** KPI arrows compare the selected month with the prior month. The trend chart always shows the last 13 complete months and ignores the Month filter.
    ;;
  }

  // ---------- Filters ----------
  block f_month: FilterBlock {
    label: 'Review Month'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
    default {
      operator: 'last'
      value: 1
      modifier: 'month'
      options {
        include_current_period: false
      }
    }
  }

  block f_department: FilterBlock {
    label: 'Department'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.department)
    }
  }

  block f_country: FilterBlock {
    label: 'Customer Country'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.country)
    }
  }

  // ---------- KPIs ----------
  block k_net_sales: VizBlock {
    label: 'Net Sales'
    viz: MetricKpi {
      dataset: thelook
      calculation prior_month {
        label: 'vs prior month'
        formula: @aql relative_period(net_sales, thelook_order_items.created_at, interval(-1 month)) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: '[$$]#,###0'
        }
      }
      compare_value: VizFieldFull {
        ref: 'prior_month'
        label: 'vs prior month'
        format {
          type: 'number'
          pattern: '[$$]#,###0'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
      }
    }
  }

  block k_gross_profit: VizBlock {
    label: 'Gross Profit'
    viz: MetricKpi {
      dataset: thelook
      calculation prior_month {
        label: 'vs prior month'
        formula: @aql relative_period(gross_profit, thelook_order_items.created_at, interval(-1 month)) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: r(thelook.gross_profit)
        label: 'Gross Profit'
        format {
          type: 'number'
          pattern: '[$$]#,###0'
        }
      }
      compare_value: VizFieldFull {
        ref: 'prior_month'
        label: 'vs prior month'
        format {
          type: 'number'
          pattern: '[$$]#,###0'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
      }
    }
  }

  block k_gross_margin: VizBlock {
    label: 'Gross Margin'
    viz: MetricKpi {
      dataset: thelook
      calculation prior_month {
        label: 'vs prior month'
        formula: @aql relative_period(gross_margin, thelook_order_items.created_at, interval(-1 month)) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: '#,###0.0%'
        }
      }
      compare_value: VizFieldFull {
        ref: 'prior_month'
        label: 'pts vs prior month'
        format {
          type: 'number'
          pattern: '#,###0.0%'
        }
      }
      settings {
        display_mode: 'compare_by_number'
        alignment: 'left'
      }
    }
  }

  block k_orders: VizBlock {
    label: 'Fulfilled Orders'
    viz: MetricKpi {
      dataset: thelook
      calculation prior_month {
        label: 'vs prior month'
        formula: @aql relative_period(fulfilled_orders, thelook_order_items.created_at, interval(-1 month)) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        label: 'Fulfilled Orders'
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      compare_value: VizFieldFull {
        ref: 'prior_month'
        label: 'vs prior month'
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
      }
    }
  }

  block k_aov: VizBlock {
    label: 'Average Order Value'
    viz: MetricKpi {
      dataset: thelook
      calculation prior_month {
        label: 'vs prior month'
        formula: @aql relative_period(aov, thelook_order_items.created_at, interval(-1 month)) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'
        format {
          type: 'number'
          pattern: '[$$]#,###0.00'
        }
      }
      compare_value: VizFieldFull {
        ref: 'prior_month'
        label: 'vs prior month'
        format {
          type: 'number'
          pattern: '[$$]#,###0.00'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
      }
    }
  }

  block k_return_rate: VizBlock {
    label: 'Return Rate'
    viz: MetricKpi {
      dataset: thelook
      calculation prior_month {
        label: 'vs prior month'
        formula: @aql relative_period(return_rate, thelook_order_items.created_at, interval(-1 month)) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: r(thelook.return_rate)
        label: 'Return Rate'
        format {
          type: 'number'
          pattern: '#,###0.0%'
        }
      }
      compare_value: VizFieldFull {
        ref: 'prior_month'
        label: 'pts vs prior month'
        format {
          type: 'number'
          pattern: '#,###0.0%'
        }
      }
      settings {
        display_mode: 'compare_by_number'
        alignment: 'left'
        compare_value {
          reverse_color: true
        }
      }
    }
  }

  // ---------- Trend ----------
  block v_trend: VizBlock {
    label: 'Net Sales: Last 13 Complete Months vs Prior Year'
    description: 'Columns show monthly Net Sales. The line shows the same month one year earlier. Ignores the Review Month filter.'
    viz: CombinationChart {
      dataset: thelook
      calculation net_sales_prior_year {
        label: 'Net Sales (prior year)'
        formula: @aql relative_period(net_sales, thelook_order_items.created_at, interval(-1 year)) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      filter {
        field: r(thelook_order_items.created_at)
        operator: 'last'
        value: 13
        modifier: 'month'
        options {
          include_current_period: false
        }
      }
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        label: 'Month'
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        label: 'Net Sales'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
          settings {
            color: '#1F4E79'
          }
        }
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: 'net_sales_prior_year'
            label: 'Net Sales (prior year)'
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
          settings {
            color: '#9AA5B1'
            line_style: 'dashed'
          }
        }
      }
      settings {
        legend_label: 'top'
        show_data_points: true
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  // ---------- Breakdown ----------
  block v_category: VizBlock {
    label: 'Category Performance (Selected Month)'
    description: 'Net Sales by product category, with change vs prior month and gross margin.'
    viz: DataTable {
      dataset: thelook
      calculation prior_month_sales {
        label: 'Prior Month'
        formula: @aql relative_period(net_sales, thelook_order_items.created_at, interval(-1 month)) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation mom_change {
        label: 'MoM %'
        formula: @aql safe_divide(net_sales - relative_period(net_sales, thelook_order_items.created_at, interval(-1 month)), relative_period(net_sales, thelook_order_items.created_at, interval(-1 month))) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      fields: [
        VizFieldFull {
          ref: r(thelook_products.category)
          label: 'Category'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
        },
        VizFieldFull {
          ref: 'prior_month_sales'
          label: 'Prior Month'
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
        },
        VizFieldFull {
          ref: 'mom_change'
          label: 'MoM %'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        },
        VizFieldFull {
          ref: r(thelook.gross_margin)
          label: 'Gross Margin'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        },
        VizFieldFull {
          ref: r(thelook.items_sold)
          label: 'Items Sold'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        }
      ]
      settings {
        show_row_number: false
        show_sum_row: true
        pagination_size: 30
        sorts: [
          IndexBasedSortSetting {
            field_index: 1
            direction: 'desc'
          }
        ]
        conditional_formats: [
          ConditionalFormat {
            ref: 'mom_change'
            format: SingleFormat {
              condition {
                operator: 'less_than'
                value: 0
              }
              text_color: '#B42318'
              background_color: '#FFFFFF'
            }
          },
          ConditionalFormat {
            ref: 'mom_change'
            format: SingleFormat {
              condition {
                operator: 'greater_than_equal'
                value: 0
              }
              text_color: '#067647'
              background_color: '#FFFFFF'
            }
          }
        ]
      }
    }
  }

  block v_channel: VizBlock {
    label: 'Net Sales by Acquisition Channel'
    description: 'Customer traffic source at sign-up.'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.traffic_source)
        label: 'Channel'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
          settings {
            color: '#1F4E79'
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      settings {
        legend_label: 'hidden'
        sort: LineFamilySort {
          type: 'yaxis'
          direction: 'desc'
        }
      }
    }
  }

  block v_country: VizBlock {
    label: 'Top 10 Countries by Net Sales'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.country)
        label: 'Country'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
          settings {
            color: '#2E7D9A'
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      settings {
        legend_label: 'hidden'
        row_limit: 10
        sort: LineFamilySort {
          type: 'yaxis'
          direction: 'desc'
        }
      }
    }
  }

  // The trend has its own 13-month window, so the Review Month filter must not reach it.
  interactions: [
    FilterInteraction {
      from: 'f_month'
      to: [
        CustomMapping {
          block: 'v_trend'
          disabled: true
        }
      ]
    }
  ]

  view: CanvasLayout {
    label: 'Monthly Review'
    width: 1280
    height: 1200
    grid_size: 20
    auto_expand_vertically: true

    block t_header {
      position: pos(20, 20, 820, 80)
    }
    block t_notes {
      position: pos(860, 20, 400, 80)
    }

    block f_month {
      position: pos(20, 120, 300, 80)
    }
    block f_department {
      position: pos(340, 120, 240, 80)
    }
    block f_country {
      position: pos(600, 120, 240, 80)
    }

    block k_net_sales {
      position: pos(20, 220, 200, 130)
    }
    block k_gross_profit {
      position: pos(228, 220, 200, 130)
    }
    block k_gross_margin {
      position: pos(436, 220, 200, 130)
    }
    block k_orders {
      position: pos(644, 220, 200, 130)
    }
    block k_aov {
      position: pos(852, 220, 200, 130)
    }
    block k_return_rate {
      position: pos(1060, 220, 200, 130)
    }

    block v_trend {
      position: pos(20, 370, 1240, 360)
    }

    block v_category {
      position: pos(20, 750, 740, 430)
    }
    block v_channel {
      position: pos(780, 750, 480, 200)
    }
    block v_country {
      position: pos(780, 970, 480, 210)
    }

    mobile {
      mode: 'auto'
    }
  }

  theme: H.themes.vanilla
}
