Dashboard r08_claude_fd_canvas_a3 {
  title: 'CEO Monthly Sales Review'
  description: 'Monthly sales review for the CEO: headline KPIs vs. prior month, 24-month trend, and where the month came from.'

  // ---------- Header ----------
  block header: TextBlock {
    content: @md
## CEO Monthly Sales Review
<span style="color:#5B6B7F">TheLook eCommerce · Net figures exclude cancelled and returned items · KPI deltas compare the selected month with the month before</span>
;;
  }

  // ---------- Filters ----------
  block f_month: FilterBlock {
    label: 'Review Month'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
    default {
      operator: 'last'
      value: 1
      modifier: 'month'
      options {
        include_current_period: false
      }
    }
  }

  block f_category: FilterBlock {
    label: 'Product Category'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.category)
    }
  }

  block f_country: FilterBlock {
    label: 'Customer Country'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.country)
    }
  }

  // ---------- KPIs (selected month vs. previous month) ----------
  block k_net_sales: VizBlock {
    label: 'Net Sales'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'vs. previous month'
        analytic: PeriodOverPeriodComparison {
          time_dimension: r(thelook_order_items.created_at)
          display: 'value'
          comparison_period: '1 month'
        }
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
      }
    }
    settings {
      hide_label: true
    }
  }

  block k_gross_profit: VizBlock {
    label: 'Gross Profit'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_profit)
        label: 'Gross Profit'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizFieldFull {
        ref: r(thelook.gross_profit)
        label: 'vs. previous month'
        analytic: PeriodOverPeriodComparison {
          time_dimension: r(thelook_order_items.created_at)
          display: 'value'
          comparison_period: '1 month'
        }
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
      }
    }
    settings {
      hide_label: true
    }
  }

  block k_gross_margin: VizBlock {
    label: 'Gross Margin'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'vs. previous month'
        analytic: PeriodOverPeriodComparison {
          time_dimension: r(thelook_order_items.created_at)
          display: 'value'
          comparison_period: '1 month'
        }
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'compare_by_number'
        alignment: 'left'
      }
    }
    settings {
      hide_label: true
    }
  }

  block k_orders: VizBlock {
    label: 'Fulfilled Orders'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        label: 'Fulfilled Orders'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        label: 'vs. previous month'
        analytic: PeriodOverPeriodComparison {
          time_dimension: r(thelook_order_items.created_at)
          display: 'value'
          comparison_period: '1 month'
        }
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
      }
    }
    settings {
      hide_label: true
    }
  }

  block k_aov: VizBlock {
    label: 'Average Order Value'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Avg. Order Value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'vs. previous month'
        analytic: PeriodOverPeriodComparison {
          time_dimension: r(thelook_order_items.created_at)
          display: 'value'
          comparison_period: '1 month'
        }
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
      }
    }
    settings {
      hide_label: true
    }
  }

  block k_return_rate: VizBlock {
    label: 'Return Rate'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.return_rate)
        label: 'Return Rate'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizFieldFull {
        ref: r(thelook.return_rate)
        label: 'vs. previous month'
        analytic: PeriodOverPeriodComparison {
          time_dimension: r(thelook_order_items.created_at)
          display: 'value'
          comparison_period: '1 month'
        }
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'compare_by_number'
        alignment: 'left'
        compare_value {
          reverse_color: true
        }
      }
    }
    settings {
      hide_label: true
    }
  }

  // ---------- Trend (ignores the month filter: always the last 24 complete months) ----------
  block v_trend: VizBlock {
    label: 'Net Sales & Gross Margin — Last 24 Complete Months'
    viz: CombinationChart {
      dataset: thelook
      filter {
        field: r(thelook_order_items.created_at)
        operator: 'last'
        value: 24
        modifier: 'month'
        options {
          include_current_period: false
        }
      }
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        label: 'Month'
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        label: 'Net Sales'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#2F5D8A'
          }
        }
      }
      y_axis {
        label: 'Gross Margin'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.gross_margin)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#E07A2E'
          }
        }
        settings {
          alignment: 'right'
          axis_min: 0
          axis_max: 1
        }
      }
      settings {
        legend_label: 'top'
        show_data_points: true
        row_limit: 100
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  // ---------- Where the month came from ----------
  block v_category: VizBlock {
    label: 'Net Sales by Category'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Category'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#2F5D8A'
          }
        }
      }
      settings {
        legend_label: 'hidden'
        row_limit: 12
        sort: LineFamilySort {
          type: 'yaxis'
          direction: 'desc'
        }
      }
    }
  }

  block v_country: VizBlock {
    label: 'Net Sales by Country (Top 10)'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.country)
        label: 'Country'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#2F5D8A'
          }
        }
      }
      settings {
        legend_label: 'hidden'
        row_limit: 10
        sort: LineFamilySort {
          type: 'yaxis'
          direction: 'desc'
        }
      }
    }
  }

  block v_channel: VizBlock {
    label: 'Net Sales by Acquisition Channel'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.traffic_source)
        label: 'Traffic Source'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#2F5D8A'
          }
        }
      }
      settings {
        legend_label: 'hidden'
        row_limit: 10
        sort: LineFamilySort {
          type: 'yaxis'
          direction: 'desc'
        }
      }
    }
  }

  block v_top_products: VizBlock {
    label: 'Top 10 Products by Net Sales'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          ref: r(thelook_products.name)
          label: 'Product'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.items_sold)
          label: 'Units'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.gross_margin)
          label: 'Margin'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        show_row_number: true
        row_limit: 10
        pagination_size: 10
        sorts: [
          IndexBasedSortSetting {
            field_index: 1
            direction: 'desc'
          }
        ]
      }
    }
  }

  interactions: [
    FilterInteraction {
      from: 'f_month'
      to: [
        CustomMapping {
          block: 'v_trend'
          disabled: true
        }
      ]
    }
  ]

  view: CanvasLayout {
    label: 'Monthly Review'
    width: 1280
    height: 1140
    grid_size: 20
    auto_expand_vertically: true
    block header {
      position: pos(20, 20, 1240, 80)
    }
    block f_month {
      position: pos(20, 110, 300, 80)
    }
    block f_category {
      position: pos(340, 110, 300, 80)
    }
    block f_country {
      position: pos(660, 110, 300, 80)
    }
    block k_net_sales {
      position: pos(20, 210, 190, 130)
    }
    block k_gross_profit {
      position: pos(230, 210, 190, 130)
    }
    block k_gross_margin {
      position: pos(440, 210, 190, 130)
    }
    block k_orders {
      position: pos(650, 210, 190, 130)
    }
    block k_aov {
      position: pos(860, 210, 190, 130)
    }
    block k_return_rate {
      position: pos(1070, 210, 190, 130)
    }
    block v_trend {
      position: pos(20, 360, 800, 380)
    }
    block v_category {
      position: pos(840, 360, 420, 380)
    }
    block v_country {
      position: pos(20, 760, 400, 360)
    }
    block v_channel {
      position: pos(440, 760, 360, 360)
    }
    block v_top_products {
      position: pos(820, 760, 440, 360)
    }
    mobile {
      mode: 'auto'
    }
  }

  theme: H.themes.vanilla
}
