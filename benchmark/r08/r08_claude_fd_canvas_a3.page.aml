Dashboard r08_claude_fd_canvas_a3 {
  title: 'CEO Monthly Sales Review'
  description: 'Monthly sales review for the CEO: headline KPIs vs the prior month, 13-month trend, and where sales came from.'

  block t_header: TextBlock {
    content: @md
# CEO Monthly Sales Review
Net sales exclude Cancelled and Returned items. KPI changes compare the selected month with the month before.
;;
  }

  block f_month: FilterBlock {
    label: 'Review Month'
    type: 'field'
    source: FieldFilterSource {
      dataset: 'thelook'
      field: r(thelook_order_items.created_at)
    }
    default {
      operator: 'matches'
      value: 'last month'
    }
  }

  block k_net_sales: VizBlock {
    label: 'Net Sales'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: '[$$]#,###0'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        value {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
      }
    }
    settings {
      hide_label: true
    }
  }

  block k_gross_profit: VizBlock {
    label: 'Gross Profit'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_profit)
        label: 'Gross Profit'
        format {
          type: 'number'
          pattern: '[$$]#,###0'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        value {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
      }
    }
    settings {
      hide_label: true
    }
  }

  block k_gross_margin: VizBlock {
    label: 'Gross Margin'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: '#,###0.0%'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        value {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_number'
        alignment: 'left'
      }
    }
    settings {
      hide_label: true
    }
  }

  block k_orders: VizBlock {
    label: 'Fulfilled Orders'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        label: 'Fulfilled Orders'
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        value {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
      }
    }
    settings {
      hide_label: true
    }
  }

  block k_aov: VizBlock {
    label: 'Average Order Value'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'
        format {
          type: 'number'
          pattern: '[$$]#,###0.00'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        value {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
      }
    }
    settings {
      hide_label: true
    }
  }

  block k_return_rate: VizBlock {
    label: 'Return Rate'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.return_rate)
        label: 'Return Rate'
        format {
          type: 'number'
          pattern: '#,###0.0%'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        value {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_number'
        alignment: 'left'
        compare_value {
          reverse_color: true
        }
      }
    }
    settings {
      hide_label: true
    }
  }

  block v_trend: VizBlock {
    label: 'Net Sales & Gross Margin, Last 13 Complete Months'
    description: 'Not affected by the Review Month filter.'
    viz: CombinationChart {
      dataset: thelook
      filter {
        field: r(thelook_order_items.created_at)
        operator: 'last'
        value: 13
        modifier: 'month'
        options {
          include_current_period: false
        }
      }
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        label: 'Net Sales'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
          settings {
            color: '#255DD4'
          }
        }
      }
      y_axis {
        label: 'Gross Margin'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.gross_margin)
            label: 'Gross Margin'
            format {
              type: 'number'
              pattern: '#,###0.0%'
            }
          }
          settings {
            color: '#E27712'
          }
        }
        settings {
          alignment: 'right'
          axis_min: 0
          axis_max: 1
        }
      }
      settings {
        legend_label: 'top'
        show_data_points: true
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block v_department: VizBlock {
    label: 'Net Sales by Department'
    viz: PieChart {
      dataset: thelook
      legend: VizFieldFull {
        ref: r(thelook_products.department)
        format {
          type: 'text'
        }
      }
      series {
        field: VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
        }
        settings {
          point {
            value: 'Women'
            color: '#255DD4'
          }
          point {
            value: 'Men'
            color: '#18A59E'
          }
        }
      }
      settings {
        display_as_donut: true
        show_total: true
        show_percentage: true
        legend_label: 'bottom'
      }
    }
  }

  block v_category: VizBlock {
    label: 'Category Performance'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          ref: r(thelook_products.category)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'vs Prior Month'
          uname: 'net_sales_mom'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
          analytic: PeriodOverPeriodComparison {
            time_dimension: r(thelook_order_items.created_at)
            display: 'percent_change'
            comparison_period: '1 month'
          }
        },
        VizFieldFull {
          ref: r(thelook.gross_margin)
          label: 'Gross Margin'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        },
        VizFieldFull {
          ref: r(thelook.items_sold)
          label: 'Items Sold'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: r(thelook.return_rate)
          label: 'Return Rate'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        }
      ]
      settings {
        sorts: [
          IndexBasedSortSetting {
            field_index: 1
            direction: 'desc'
          }
        ]
        pagination_size: 30
        show_sum_row: false
        row_limit: 100
      }
    }
  }

  block v_country: VizBlock {
    label: 'Top 10 Countries by Net Sales'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.country)
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
          settings {
            color: '#255DD4'
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      settings {
        legend_label: 'hidden'
        row_limit: 10
        sort: LineFamilySort {
          type: 'yaxis'
          direction: 'desc'
        }
      }
    }
  }

  interactions: [
    FilterInteraction {
      from: 'f_month'
      to: [
        CustomMapping {
          block: 'v_trend'
          disabled: true
        }
      ]
    }
  ]

  view: CanvasLayout {
    label: 'Monthly Review'
    width: 1400
    height: 1100
    grid_size: 20
    auto_expand_vertically: true
    block t_header {
      position: pos(20, 20, 1020, 80)
    }
    block f_month {
      position: pos(1060, 20, 320, 80)
    }
    block k_net_sales {
      position: pos(20, 120, 210, 130)
    }
    block k_gross_profit {
      position: pos(250, 120, 210, 130)
    }
    block k_gross_margin {
      position: pos(480, 120, 210, 130)
    }
    block k_orders {
      position: pos(710, 120, 210, 130)
    }
    block k_aov {
      position: pos(940, 120, 210, 130)
    }
    block k_return_rate {
      position: pos(1170, 120, 210, 130)
    }
    block v_trend {
      position: pos(20, 270, 900, 380)
    }
    block v_department {
      position: pos(940, 270, 440, 380)
    }
    block v_category {
      position: pos(20, 670, 800, 420)
    }
    block v_country {
      position: pos(840, 670, 540, 420)
    }
    mobile {
      mode: 'auto'
    }
  }

  theme: H.themes.vanilla
}
