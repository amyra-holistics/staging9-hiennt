Dashboard r08_claude_fd_html_a1 {
  title: 'CEO Monthly Sales Review'
  description: 'Monthly sales review for the CEO: headline results for the reporting month, the 13-month trajectory, and where sales came from.'
  owner: 'thinh.nt@holistics.io'

  // ---------- Controls ----------
  block f_month: FilterBlock {
    label: 'Reporting month'
    description: 'Order item created date. Defaults to the last complete month.'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
    default {
      operator: 'last'
      value: '1'
      modifier: 'month'
    }
  }

  // ---------- Headline KPIs ----------
  block k_net_sales: VizBlock {
    label: 'Net Sales vs Prior Month'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales · vs prior month'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        metric_value {
          font_size: 52
        }
        label {
          font_size: 14
        }
        compare_value {
          font_size: 16
        }
      }
    }
    settings {
      hide_label: true
    }
  }

  block k_net_sales_yoy: VizBlock {
    label: 'Net Sales vs Same Month Last Year'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales · vs last year'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value {
          duration: 1
          granularity: 'year'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        metric_value {
          font_size: 26
        }
        label {
          font_size: 13
        }
      }
    }
    settings {
      hide_label: true
    }
  }

  block k_gross_profit: VizBlock {
    label: 'Gross Profit'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_profit)
        label: 'Gross Profit'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        metric_value {
          font_size: 26
        }
        label {
          font_size: 13
        }
      }
    }
    settings {
      hide_label: true
    }
  }

  block k_gross_margin: VizBlock {
    label: 'Gross Margin'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        metric_value {
          font_size: 26
        }
        label {
          font_size: 13
        }
      }
    }
    settings {
      hide_label: true
    }
  }

  block k_orders: VizBlock {
    label: 'Fulfilled Orders'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        label: 'Fulfilled Orders'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        metric_value {
          font_size: 26
        }
        label {
          font_size: 13
        }
      }
    }
    settings {
      hide_label: true
    }
  }

  block k_aov: VizBlock {
    label: 'Average Order Value'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        metric_value {
          font_size: 26
        }
        label {
          font_size: 13
        }
      }
    }
    settings {
      hide_label: true
    }
  }

  block k_return_rate: VizBlock {
    label: 'Return Rate'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.return_rate)
        label: 'Return Rate'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        metric_value {
          font_size: 26
        }
        label {
          font_size: 13
        }
        compare_value {
          reverse_color: true
        }
      }
    }
    settings {
      hide_label: true
    }
  }

  // ---------- Trajectory ----------
  block c_trend: VizBlock {
    label: 'Net Sales & Gross Margin · trailing 13 complete months'
    description: 'Fixed window; not affected by the Reporting month filter.'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        label: 'Net Sales'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#1F3A5F'
          }
        }
        settings {
          alignment: 'left'
        }
      }
      y_axis {
        label: 'Gross Margin'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.gross_margin)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#C0703A'
          }
        }
        settings {
          alignment: 'right'
        }
      }
      filter {
        field: r(thelook_order_items.created_at)
        operator: 'matches'
        value: 'last 13 months'
      }
      settings {
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  // ---------- Mix ----------
  block c_category: VizBlock {
    label: 'Net Sales by Category · top 10'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Category'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#1F3A5F'
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      settings {
        row_limit: 10
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block c_country: VizBlock {
    label: 'Net Sales by Customer Country · top 10'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.country)
        label: 'Country'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#5B7A99'
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      settings {
        row_limit: 10
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block t_brands: VizBlock {
    label: 'Top 10 Brands'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          label: 'Brand'
          ref: r(thelook_products.brand)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'Net Sales'
          ref: r(thelook.net_sales)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'Gross Margin'
          ref: r(thelook.gross_margin)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'Items Sold'
          ref: r(thelook.items_sold)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        row_limit: 10
        show_row_number: true
        sorts: [
          IndexBasedSortSetting {
            field_index: 1
            direction: 'desc'
          }
        ]
      }
    }
  }

  // The trend chart keeps its own fixed 13-month window
  interactions: [
    FilterInteraction {
      from: 'f_month'
      to: [
        CustomMapping {
          block: 'c_trend'
          disabled: true
        }
      ]
    }
  ]

  settings {
    timezone: 'Etc/UTC'
  }

  view: HTMLLayout {
    content: @html
      <style>
        .cr {
          --ink: #14213D;
          --ink-soft: #4A5568;
          --rule: #D9D3C7;
          --paper: #F6F3EE;
          --card: #FFFFFF;
          --accent: #C0703A;
          background: var(--paper);
          color: var(--ink);
          font-family: "Inter", "Segoe UI", system-ui, sans-serif;
          padding: 36px 40px 28px;
          min-height: 100%;
          box-sizing: border-box;
        }
        .cr * { box-sizing: border-box; }

        /* Masthead */
        .cr-mast {
          display: grid;
          grid-template-columns: 1fr 300px;
          gap: 32px;
          align-items: end;
          padding-bottom: 20px;
          border-bottom: 3px double var(--ink);
        }
        .cr-eyebrow {
          font-size: 11px;
          letter-spacing: 0.18em;
          text-transform: uppercase;
          color: var(--accent);
          font-weight: 600;
          margin: 0 0 8px;
        }
        .cr-title {
          font-family: "Iowan Old Style", "Palatino Linotype", Georgia, serif;
          font-size: 40px;
          line-height: 1.05;
          font-weight: 600;
          margin: 0;
        }
        .cr-dek {
          margin: 10px 0 0;
          max-width: 640px;
          font-size: 14px;
          line-height: 1.5;
          color: var(--ink-soft);
        }
        .cr-control {
          background: var(--card);
          border: 1px solid var(--rule);
          border-top: 3px solid var(--accent);
          padding: 6px 8px;
          height: 84px;
        }

        /* Section headings */
        .cr-section { margin-top: 28px; }
        .cr-head {
          display: flex;
          align-items: baseline;
          gap: 14px;
          margin-bottom: 14px;
        }
        .cr-num {
          font-family: "Iowan Old Style", "Palatino Linotype", Georgia, serif;
          font-size: 13px;
          color: var(--accent);
          font-weight: 600;
        }
        .cr-h2 {
          font-family: "Iowan Old Style", "Palatino Linotype", Georgia, serif;
          font-size: 22px;
          font-weight: 600;
          margin: 0;
        }
        .cr-rule { flex: 1; border-top: 1px solid var(--rule); }
        .cr-note { font-size: 12px; color: var(--ink-soft); }

        /* Cards */
        .cr-card {
          background: var(--card);
          border: 1px solid var(--rule);
          border-radius: 4px;
          padding: 8px;
        }

        /* KPI grid: hero spans two rows */
        .cr-kpis {
          display: grid;
          grid-template-columns: 1.6fr 1fr 1fr 1fr;
          grid-template-rows: 124px 124px;
          grid-template-areas:
            "hero yoy gp gm"
            "hero ord aov ret";
          gap: 12px;
        }
        .cr-hero {
          grid-area: hero;
          background: var(--ink);
          border-color: var(--ink);
          position: relative;
          padding: 18px 16px 12px;
        }
        .cr-hero-inner {
          background: var(--card);
          height: 100%;
          border-radius: 2px;
        }
        .a-yoy { grid-area: yoy; border-top: 3px solid var(--accent); }
        .a-gp  { grid-area: gp; }
        .a-gm  { grid-area: gm; }
        .a-ord { grid-area: ord; }
        .a-aov { grid-area: aov; }
        .a-ret { grid-area: ret; }
        .cr-hero-tag {
          position: absolute;
          top: 4px;
          left: 16px;
          font-size: 10px;
          letter-spacing: 0.16em;
          text-transform: uppercase;
          color: #E9D9C8;
        }

        .cr-trend { height: 360px; }

        .cr-mix {
          display: grid;
          grid-template-columns: 1fr 1fr 1.25fr;
          gap: 12px;
        }
        .cr-mix .cr-card { height: 400px; }

        .cr-foot {
          margin-top: 28px;
          padding-top: 12px;
          border-top: 1px solid var(--rule);
          font-size: 11.5px;
          line-height: 1.6;
          color: var(--ink-soft);
          display: flex;
          flex-wrap: wrap;
          gap: 6px 28px;
        }
        .cr-foot b { color: var(--ink); font-weight: 600; }

        @media (max-width: 1100px) {
          .cr-kpis {
            grid-template-columns: 1fr 1fr;
            grid-template-rows: 200px repeat(3, 124px);
            grid-template-areas:
              "hero hero"
              "yoy gp"
              "gm ord"
              "aov ret";
          }
          .cr-mix { grid-template-columns: 1fr; }
        }
        @media (max-width: 700px) {
          .cr { padding: 20px 16px; }
          .cr-mast { grid-template-columns: 1fr; gap: 16px; }
          .cr-title { font-size: 30px; }
        }
      </style>

      <div class="cr">
        <header class="cr-mast">
          <div>
            <p class="cr-eyebrow">TheLook eCommerce · Office of the CEO</p>
            <h1 class="cr-title">Monthly Sales Review</h1>
            <p class="cr-dek">
              Headline results for the reporting month compared with the month before,
              the 13-month trajectory, and where the month's sales came from.
            </p>
          </div>
          <div class="cr-control">
            <h-block name="f_month" />
          </div>
        </header>

        <section class="cr-section">
          <div class="cr-head">
            <span class="cr-num">01</span>
            <h2 class="cr-h2">The month at a glance</h2>
            <span class="cr-rule"></span>
            <span class="cr-note">Change vs prior month unless noted</span>
          </div>
          <div class="cr-kpis">
            <div class="cr-card cr-hero">
              <span class="cr-hero-tag">Headline</span>
              <div class="cr-hero-inner"><h-block name="k_net_sales" /></div>
            </div>
            <div class="cr-card a-yoy"><h-block name="k_net_sales_yoy" /></div>
            <div class="cr-card a-gp"><h-block name="k_gross_profit" /></div>
            <div class="cr-card a-gm"><h-block name="k_gross_margin" /></div>
            <div class="cr-card a-ord"><h-block name="k_orders" /></div>
            <div class="cr-card a-aov"><h-block name="k_aov" /></div>
            <div class="cr-card a-ret"><h-block name="k_return_rate" /></div>
          </div>
        </section>

        <section class="cr-section">
          <div class="cr-head">
            <span class="cr-num">02</span>
            <h2 class="cr-h2">Trajectory</h2>
            <span class="cr-rule"></span>
            <span class="cr-note">Trailing 13 complete months · fixed window</span>
          </div>
          <div class="cr-card cr-trend"><h-block name="c_trend" /></div>
        </section>

        <section class="cr-section">
          <div class="cr-head">
            <span class="cr-num">03</span>
            <h2 class="cr-h2">Where the sales came from</h2>
            <span class="cr-rule"></span>
            <span class="cr-note">Reporting month</span>
          </div>
          <div class="cr-mix">
            <div class="cr-card"><h-block name="c_category" /></div>
            <div class="cr-card"><h-block name="c_country" /></div>
            <div class="cr-card"><h-block name="t_brands" /></div>
          </div>
        </section>

        <footer class="cr-foot">
          <span><b>Net Sales</b> excludes Cancelled and Returned items.</span>
          <span><b>Gross Margin</b> = (Net Sales − COGS) ÷ Net Sales.</span>
          <span><b>AOV</b> = Net Sales ÷ fulfilled orders.</span>
          <span><b>Return Rate</b> = returned items ÷ all items; a decrease shows green.</span>
          <span>Dates are order item created dates (UTC). The in-progress month is excluded by default.</span>
        </footer>
      </div>
    ;;
  }

  theme {
    background {
      bg_color: '#F6F3EE'
    }
    block {
      background {
        bg_color: 'transparent'
      }
      border {
        border_width: 0
      }
    }
  }
}
