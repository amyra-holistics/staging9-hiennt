Dashboard r08_claude_fd_html_a2 {
  title: 'CEO Monthly Sales Review'
  description: 'Monthly sales review for the CEO: headline KPIs vs. prior month, 13-month trend, and where sales came from.'

  // ---------- Controls ----------
  block f_month: FilterBlock {
    label: 'Review Month'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
    default {
      operator: 'last'
      value: '1'
      modifier: 'month'
    }
  }

  block f_department: FilterBlock {
    label: 'Department'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.department)
    }
  }

  // ---------- KPIs (vs. previous month) ----------
  block k_net_sales: VizBlock {
    label: 'Net Sales'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
      }
    }
  }

  block k_gross_profit: VizBlock {
    label: 'Gross Profit'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_profit)
        label: 'Gross Profit'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
      }
    }
  }

  block k_gross_margin: VizBlock {
    label: 'Gross Margin'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
      }
    }
  }

  block k_orders: VizBlock {
    label: 'Fulfilled Orders'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        label: 'Fulfilled Orders'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
      }
    }
  }

  block k_aov: VizBlock {
    label: 'Average Order Value'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
      }
    }
  }

  block k_return_rate: VizBlock {
    label: 'Return Rate'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.return_rate)
        label: 'Return Rate'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
      }
    }
  }

  // ---------- Trend (fixed 13-month window, not tied to Review Month) ----------
  block v_trend: VizBlock {
    label: 'Net Sales & Gross Margin — Last 13 Months'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        label: 'Month'
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        label: 'Net Sales'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        settings {
          alignment: 'left'
        }
      }
      y_axis {
        label: 'Gross Margin'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.gross_margin)
            label: 'Gross Margin'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        settings {
          alignment: 'right'
        }
      }
      filter {
        field: r(thelook_order_items.created_at)
        operator: 'matches'
        value: 'last 13 months'
      }
      settings {
        x_axis_label: 'Month'
        legend_label: 'top'
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  // ---------- Sales mix for the review month ----------
  block v_category: VizBlock {
    label: 'Top 10 Categories by Net Sales'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Category'
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      settings {
        row_limit: 10
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block v_country: VizBlock {
    label: 'Top 8 Countries by Net Sales'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.country)
        label: 'Country'
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      settings {
        row_limit: 8
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block v_traffic: VizBlock {
    label: 'Net Sales by Traffic Source'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.traffic_source)
        label: 'Traffic Source'
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block v_brands: VizBlock {
    label: 'Top 10 Brands'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          ref: r(thelook_products.brand)
          label: 'Brand'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.gross_profit)
          label: 'Gross Profit'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.gross_margin)
          label: 'Gross Margin'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.items_sold)
          label: 'Items Sold'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        pagination_size: 10
        show_row_number: true
        row_limit: 10
        sorts: [
          IndexBasedSortSetting {
            field_index: 1
            direction: 'desc'
          }
        ]
      }
    }
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'f_month'
      to: ['k_net_sales', 'k_gross_profit', 'k_gross_margin', 'k_orders', 'k_aov', 'k_return_rate', 'v_category', 'v_country', 'v_traffic', 'v_brands']
    },
    FilterInteraction {
      from: 'f_department'
      to: ['k_net_sales', 'k_gross_profit', 'k_gross_margin', 'k_orders', 'k_aov', 'k_return_rate', 'v_trend', 'v_category', 'v_country', 'v_traffic', 'v_brands']
    }
  ]

  view: HTMLLayout {
    content: @html
      <style>
        .ceo {
          --ink: #1b2430;
          --muted: #6b7280;
          --paper: #f6f4ef;
          --card: #ffffff;
          --rule: #e4e0d6;
          --accent: #9a3b26;
          background: var(--paper);
          color: var(--ink);
          padding: 32px 40px 48px;
          font-family: "Inter", "Segoe UI", system-ui, sans-serif;
          min-height: 100%;
          box-sizing: border-box;
        }
        .ceo * { box-sizing: border-box; }

        .ceo .masthead {
          display: flex;
          justify-content: space-between;
          align-items: flex-end;
          gap: 24px;
          flex-wrap: wrap;
          padding-bottom: 20px;
          border-bottom: 2px solid var(--ink);
        }
        .ceo .eyebrow {
          font-size: 11px;
          letter-spacing: 0.18em;
          text-transform: uppercase;
          color: var(--accent);
          font-weight: 600;
          margin: 0 0 6px;
        }
        .ceo h1 {
          font-family: Georgia, "Times New Roman", serif;
          font-size: 34px;
          font-weight: 400;
          margin: 0;
          line-height: 1.1;
        }
        .ceo .sub {
          margin: 8px 0 0;
          color: var(--muted);
          font-size: 13px;
          max-width: 560px;
        }
        .ceo .controls {
          display: flex;
          gap: 12px;
          flex-wrap: wrap;
        }
        .ceo .control {
          width: 240px;
          min-height: 64px;
        }

        .ceo .section {
          margin-top: 28px;
        }
        .ceo .section-head {
          display: flex;
          align-items: baseline;
          gap: 12px;
          margin-bottom: 12px;
        }
        .ceo .section-head .num {
          font-family: Georgia, serif;
          color: var(--accent);
          font-size: 15px;
        }
        .ceo .section-head h2 {
          font-family: Georgia, "Times New Roman", serif;
          font-weight: 400;
          font-size: 20px;
          margin: 0;
        }
        .ceo .section-head .note {
          color: var(--muted);
          font-size: 12px;
          margin-left: auto;
        }

        .ceo .kpis {
          display: grid;
          grid-template-columns: repeat(6, minmax(0, 1fr));
          gap: 12px;
        }
        .ceo .kpi {
          background: var(--card);
          border: 1px solid var(--rule);
          border-top: 3px solid var(--ink);
          height: 132px;
        }
        .ceo .kpi.lead { border-top-color: var(--accent); }

        .ceo .card {
          background: var(--card);
          border: 1px solid var(--rule);
        }
        .ceo .trend { height: 380px; }

        .ceo .mix {
          display: grid;
          grid-template-columns: 1.3fr 1fr 1fr;
          gap: 12px;
        }
        .ceo .mix .card { height: 380px; }

        .ceo .brands { height: 440px; }

        .ceo .footnote {
          margin-top: 24px;
          padding-top: 12px;
          border-top: 1px solid var(--rule);
          color: var(--muted);
          font-size: 11px;
          line-height: 1.6;
        }

        @media (max-width: 1200px) {
          .ceo .kpis { grid-template-columns: repeat(3, minmax(0, 1fr)); }
          .ceo .mix { grid-template-columns: 1fr; }
        }
        @media (max-width: 640px) {
          .ceo { padding: 20px 16px 32px; }
          .ceo .kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
          .ceo .control { width: 100%; }
        }
      </style>

      <div class="ceo">
        <header class="masthead">
          <div>
            <p class="eyebrow">TheLook eCommerce · Executive Brief</p>
            <h1>Monthly Sales Review</h1>
            <p class="sub">Headline performance for the review month compared with the month before, the 13-month trajectory, and where the month's sales came from.</p>
          </div>
          <div class="controls">
            <div class="control"><h-block name="f_month" /></div>
            <div class="control"><h-block name="f_department" /></div>
          </div>
        </header>

        <section class="section">
          <div class="section-head">
            <span class="num">01</span>
            <h2>The month at a glance</h2>
            <span class="note">Change vs. previous month</span>
          </div>
          <div class="kpis">
            <div class="kpi lead"><h-block name="k_net_sales" /></div>
            <div class="kpi"><h-block name="k_gross_profit" /></div>
            <div class="kpi"><h-block name="k_gross_margin" /></div>
            <div class="kpi"><h-block name="k_orders" /></div>
            <div class="kpi"><h-block name="k_aov" /></div>
            <div class="kpi"><h-block name="k_return_rate" /></div>
          </div>
        </section>

        <section class="section">
          <div class="section-head">
            <span class="num">02</span>
            <h2>Trajectory</h2>
            <span class="note">Rolling 13 complete months · not tied to Review Month</span>
          </div>
          <div class="card trend"><h-block name="v_trend" /></div>
        </section>

        <section class="section">
          <div class="section-head">
            <span class="num">03</span>
            <h2>Where the sales came from</h2>
            <span class="note">Review month</span>
          </div>
          <div class="mix">
            <div class="card"><h-block name="v_category" /></div>
            <div class="card"><h-block name="v_country" /></div>
            <div class="card"><h-block name="v_traffic" /></div>
          </div>
        </section>

        <section class="section">
          <div class="section-head">
            <span class="num">04</span>
            <h2>Brand leaderboard</h2>
            <span class="note">Review month · ranked by Net Sales</span>
          </div>
          <div class="card brands"><h-block name="v_brands" /></div>
        </section>

        <p class="footnote">
          Net Sales excludes Cancelled and Returned items. Gross Profit = Net Sales − product cost (COGS). Average Order Value = Net Sales per fulfilled order.
          Return Rate is the share of all order items returned — lower is better. Dates are based on order item creation date.
        </p>
      </div>
    ;;
  }

  theme: H.themes.vanilla
}
