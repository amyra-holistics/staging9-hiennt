Dashboard r08_claude_fd_html_a3 {
  title: 'CEO Monthly Sales Review'
  description: 'Monthly sales review for the CEO: headline results vs prior month, 13-month trend, and where sales came from.'

  // ---------- Filters ----------
  block f_month: FilterBlock {
    label: 'Review Month'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
    default {
      operator: 'matches'
      value: 'last month'
    }
  }

  block f_department: FilterBlock {
    label: 'Department'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.department)
    }
  }

  block f_country: FilterBlock {
    label: 'Country'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.country)
    }
  }

  // ---------- Headline KPIs (vs previous month) ----------
  block k_net_sales: VizBlock {
    label: 'Net Sales'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value: RelativePopValue {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
      }
    }
    settings {
      hide_label: true
    }
  }

  block k_gross_profit: VizBlock {
    label: 'Gross Profit'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_profit)
        label: 'Gross Profit'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value: RelativePopValue {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
      }
    }
    settings {
      hide_label: true
    }
  }

  block k_gross_margin: VizBlock {
    label: 'Gross Margin'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value: RelativePopValue {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
      }
    }
    settings {
      hide_label: true
    }
  }

  block k_orders: VizBlock {
    label: 'Fulfilled Orders'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        label: 'Fulfilled Orders'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value: RelativePopValue {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
      }
    }
    settings {
      hide_label: true
    }
  }

  block k_aov: VizBlock {
    label: 'Average Order Value'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Avg Order Value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value: RelativePopValue {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
      }
    }
    settings {
      hide_label: true
    }
  }

  block k_return_rate: VizBlock {
    label: 'Return Rate'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.return_rate)
        label: 'Return Rate'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value: RelativePopValue {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        compare_value {
          reverse_color: true
        }
      }
    }
    settings {
      hide_label: true
    }
  }

  // ---------- Trend (fixed trailing 13 months; ignores Review Month) ----------
  block v_trend: VizBlock {
    label: 'Net Sales by Month (last 13 months)'
    viz: ColumnChart {
      dataset: thelook
      filter {
        field: r(thelook_order_items.created_at)
        operator: 'matches'
        value: 'last 13 months'
      }
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#2a78d6'
          }
        }
      }
      settings {
        x_axis_label: ''
        legend_label: 'hidden'
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
        row_limit: 100
      }
    }
  }

  block v_margin_trend: VizBlock {
    label: 'Gross Margin by Month (last 13 months)'
    viz: LineChart {
      dataset: thelook
      filter {
        field: r(thelook_order_items.created_at)
        operator: 'matches'
        value: 'last 13 months'
      }
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yy'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.gross_margin)
            label: 'Gross Margin'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#1baf7a'
          }
        }
      }
      settings {
        x_axis_label: ''
        legend_label: 'hidden'
        show_data_points: true
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
        row_limit: 100
      }
    }
  }

  // ---------- Sales mix for the review month ----------
  block v_category: VizBlock {
    label: 'Net Sales by Category (top 10)'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#2a78d6'
          }
        }
      }
      settings {
        x_axis_label: ''
        legend_label: 'hidden'
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
        row_limit: 10
      }
    }
  }

  block v_country: VizBlock {
    label: 'Net Sales by Country (top 8)'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.country)
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#2a78d6'
          }
        }
      }
      settings {
        x_axis_label: ''
        legend_label: 'hidden'
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
        row_limit: 8
      }
    }
  }

  block v_channel: VizBlock {
    label: 'Net Sales by Acquisition Channel'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.traffic_source)
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#2a78d6'
          }
        }
      }
      settings {
        x_axis_label: ''
        legend_label: 'hidden'
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
        row_limit: 10
      }
    }
  }

  block v_category_table: VizBlock {
    label: 'Category Scorecard'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          ref: r(thelook_products.category)
          label: 'Category'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.gross_profit)
          label: 'Gross Profit'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.gross_margin)
          label: 'Gross Margin'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.items_sold)
          label: 'Items Sold'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.return_rate)
          label: 'Return Rate'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        show_row_number: false
        show_sum_row: false
        pagination_size: 30
        row_limit: 100
        sorts: [
          IndexBasedSortSetting {
            field_index: 1
            direction: 'desc'
          }
        ]
      }
    }
  }

  block t_notes: TextBlock {
    content: @md
**Definitions.** *Net Sales* = sale price of order items excluding Cancelled and Returned items. *Gross Profit* = Net Sales − product cost (COGS). *Gross Margin* = Gross Profit ÷ Net Sales. *Fulfilled Orders* = orders with at least one item counted in Net Sales. *Avg Order Value* = Net Sales ÷ Fulfilled Orders. *Return Rate* = returned items ÷ all items. All dates use the order item's created date. KPI deltas compare the Review Month with the month before it; trend charts always show the last 13 complete months.
    ;;
  }

  interactions: [
    FilterInteraction {
      from: 'f_month'
      to: [
        CustomMapping {
          block: ['v_trend', 'v_margin_trend']
          disabled: true
        }
      ]
    }
  ]

  view: HTMLLayout {
    content: @html
<style>
  .rv {
    --paper: #f6f4ef;
    --card: #ffffff;
    --ink: #14161a;
    --ink-2: #4d4f55;
    --ink-3: #8a8c91;
    --rule: #dcd8ce;
    --accent: #2a78d6;
    background: var(--paper);
    color: var(--ink);
    font-family: "Inter", "Segoe UI", system-ui, -apple-system, sans-serif;
    padding: 36px 40px 48px;
    min-height: 100%;
    box-sizing: border-box;
  }
  .rv * { box-sizing: border-box; }

  /* Masthead */
  .rv-mast {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 24px;
    padding-bottom: 18px;
    border-bottom: 2px solid var(--ink);
  }
  .rv-kicker {
    font-size: 11px;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin: 0 0 8px;
  }
  .rv-title {
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 400;
    font-size: 40px;
    line-height: 1.05;
    letter-spacing: -.01em;
    margin: 0;
  }
  .rv-title em { font-style: italic; color: var(--accent); }
  .rv-sub {
    margin: 8px 0 0;
    font-size: 14px;
    color: var(--ink-2);
    max-width: 640px;
  }
  .rv-filters {
    display: grid;
    grid-template-columns: 220px 170px 170px;
    gap: 10px;
  }
  .rv-filters > div { height: 64px; }

  /* Section headers */
  .rv-sec {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin: 30px 0 12px;
  }
  .rv-num {
    font-family: Georgia, serif;
    font-size: 13px;
    color: var(--accent);
    font-weight: 700;
  }
  .rv-sec h2 {
    font-family: Georgia, serif;
    font-weight: 400;
    font-size: 21px;
    margin: 0;
  }
  .rv-sec p {
    margin: 0 0 0 auto;
    font-size: 12px;
    color: var(--ink-3);
  }

  /* KPI band */
  .rv-kpis {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    background: var(--card);
    border: 1px solid var(--rule);
    border-radius: 6px;
  }
  .rv-kpi {
    height: 128px;
    border-left: 1px solid var(--rule);
  }
  .rv-kpi:first-child { border-left: 0; }
  .rv-kpi.hero { background: #eef4fc; border-radius: 6px 0 0 6px; }

  /* Grids */
  .rv-trend {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 16px;
  }
  .rv-mix {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr;
    gap: 16px;
  }
  .rv-card {
    background: var(--card);
    border: 1px solid var(--rule);
    border-radius: 6px;
    overflow: hidden;
  }
  .h-trend { height: 340px; }
  .h-mix { height: 380px; }
  .h-table { height: 460px; }

  .rv-foot {
    margin-top: 24px;
    padding-top: 12px;
    border-top: 1px solid var(--rule);
    min-height: 96px;
  }

  @media (max-width: 1100px) {
    .rv { padding: 24px 20px; }
    .rv-mast { grid-template-columns: 1fr; }
    .rv-filters { grid-template-columns: repeat(3, 1fr); }
    .rv-kpis { grid-template-columns: repeat(3, 1fr); }
    .rv-kpi:nth-child(4) { border-left: 0; }
    .rv-kpi:nth-child(n+4) { border-top: 1px solid var(--rule); }
    .rv-trend, .rv-mix { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .rv-filters, .rv-kpis { grid-template-columns: 1fr; }
    .rv-kpi { border-left: 0; border-top: 1px solid var(--rule); }
    .rv-kpi:first-child { border-top: 0; }
  }
</style>

<div class="rv">
  <header class="rv-mast">
    <div>
      <p class="rv-kicker">TheLook eCommerce &middot; Executive Office</p>
      <h1 class="rv-title">Monthly Sales <em>Review</em></h1>
      <p class="rv-sub">How did we sell this month, was it profitable, and where did it come from? Figures default to the last complete month and compare against the month before.</p>
    </div>
    <div class="rv-filters">
      <div><h-block name="f_month" /></div>
      <div><h-block name="f_department" /></div>
      <div><h-block name="f_country" /></div>
    </div>
  </header>

  <div class="rv-sec">
    <span class="rv-num">01</span>
    <h2>Headline results</h2>
    <p>Change vs previous month</p>
  </div>
  <section class="rv-kpis">
    <div class="rv-kpi hero"><h-block name="k_net_sales" /></div>
    <div class="rv-kpi"><h-block name="k_gross_profit" /></div>
    <div class="rv-kpi"><h-block name="k_gross_margin" /></div>
    <div class="rv-kpi"><h-block name="k_orders" /></div>
    <div class="rv-kpi"><h-block name="k_aov" /></div>
    <div class="rv-kpi"><h-block name="k_return_rate" /></div>
  </section>

  <div class="rv-sec">
    <span class="rv-num">02</span>
    <h2>Momentum</h2>
    <p>Last 13 complete months &middot; not affected by Review Month</p>
  </div>
  <section class="rv-trend">
    <div class="rv-card h-trend"><h-block name="v_trend" /></div>
    <div class="rv-card h-trend"><h-block name="v_margin_trend" /></div>
  </section>

  <div class="rv-sec">
    <span class="rv-num">03</span>
    <h2>Where the sales came from</h2>
    <p>Review month</p>
  </div>
  <section class="rv-mix">
    <div class="rv-card h-mix"><h-block name="v_category" /></div>
    <div class="rv-card h-mix"><h-block name="v_country" /></div>
    <div class="rv-card h-mix"><h-block name="v_channel" /></div>
  </section>

  <div class="rv-sec">
    <span class="rv-num">04</span>
    <h2>Category scorecard</h2>
    <p>Review month &middot; sorted by Net Sales</p>
  </div>
  <section class="rv-card h-table"><h-block name="v_category_table" /></section>

  <footer class="rv-foot"><h-block name="t_notes" /></footer>
</div>
    ;;
  }
}
