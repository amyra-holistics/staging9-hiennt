Dashboard r08_claude_html_a2 {
  title: 'CEO Monthly Sales Review'
  description: 'Monthly sales review for the CEO: headline KPIs vs the prior month, 13-month trend, and where the sales in the month came from.'

  // ---------- Controls ----------
  block f_month: FilterBlock {
    label: 'Review Month'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
    default {
      operator: 'last'
      value: '1'
      modifier: 'month'
      options {
        include_current_period: false
      }
    }
  }

  // ---------- KPIs (review month vs prior month) ----------
  block k_net_sales: VizBlock {
    label: 'Net Sales'
    description: 'Sale price of items, excluding Cancelled and Returned. Change vs prior month.'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value: RelativePopValue {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
      }
    }
  }

  block k_gross_profit: VizBlock {
    label: 'Gross Profit'
    description: 'Net Sales minus COGS. Change vs prior month.'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_profit)
        label: 'Gross Profit'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value: RelativePopValue {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
      }
    }
  }

  block k_gross_margin: VizBlock {
    label: 'Gross Margin'
    description: 'Gross Profit as a share of Net Sales. Change vs prior month.'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value: RelativePopValue {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_number'
      }
    }
  }

  block k_orders: VizBlock {
    label: 'Fulfilled Orders'
    description: 'Orders with at least one item counted in Net Sales. Change vs prior month.'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        label: 'Fulfilled Orders'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value: RelativePopValue {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
      }
    }
  }

  block k_aov: VizBlock {
    label: 'Average Order Value'
    description: 'Net Sales per fulfilled order. Change vs prior month.'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value: RelativePopValue {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
      }
    }
  }

  block k_return_rate: VizBlock {
    label: 'Return Rate'
    description: 'Share of order items returned. Lower is better. Change vs prior month.'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.return_rate)
        label: 'Return Rate'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value: RelativePopValue {
          duration: 1
          granularity: 'month'
        }
      }
      settings {
        display_mode: 'compare_by_number'
        compare_value {
          reverse_color: true
        }
      }
    }
  }

  // ---------- Trend (not affected by the Review Month filter) ----------
  block c_trend: VizBlock {
    label: 'Net Sales & Gross Margin, Last 13 Months'
    description: 'Always shows the last 13 months for context; not affected by the Review Month filter.'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        label: 'Net Sales'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        settings {
          alignment: 'left'
        }
      }
      y_axis {
        label: 'Gross Margin'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.gross_margin)
            label: 'Gross Margin'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        settings {
          alignment: 'right'
        }
      }
      filter {
        field: r(thelook_order_items.created_at)
        operator: 'matches'
        value: 'last 13 months'
      }
      settings {
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
        show_data_points: true
      }
    }
  }

  // ---------- Sales mix for the review month ----------
  block c_category: VizBlock {
    label: 'Top Categories by Net Sales'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Category'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      settings {
        row_limit: 10
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block c_channel: VizBlock {
    label: 'Net Sales by Traffic Source'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.traffic_source)
        label: 'Traffic Source'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      settings {
        row_limit: 10
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block c_country: VizBlock {
    label: 'Top Countries by Net Sales'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.country)
        label: 'Country'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      settings {
        row_limit: 8
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block t_products: VizBlock {
    label: 'Top 10 Products by Net Sales'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          label: 'Product'
          ref: r(thelook_products.name)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'Brand'
          ref: r(thelook_products.brand)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'Category'
          ref: r(thelook_products.category)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'Net Sales'
          ref: r(thelook.net_sales)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'Items Sold'
          ref: r(thelook.items_sold)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'Gross Margin'
          ref: r(thelook.gross_margin)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        pagination_size: 10
        row_limit: 10
        show_row_number: true
        single_cell_display: 'normal'
        sorts: [
          IndexBasedSortSetting {
            field_index: 3
            direction: 'desc'
          }
        ]
      }
    }
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'f_month'
      to: [
        'k_net_sales', 'k_gross_profit', 'k_gross_margin', 'k_orders', 'k_aov', 'k_return_rate',
        'c_category', 'c_channel', 'c_country', 't_products'
      ]
      field: r(thelook_order_items.created_at)
    },
    FilterInteraction {
      from: 'f_month'
      to: ['c_trend']
      disabled: true
    }
  ]

  view: HTMLLayout {
    content: @html
      <style>
        .page {
          max-width: 1320px;
          margin: 0 auto;
          padding: 24px;
          display: flex;
          flex-direction: column;
          gap: 20px;
          font-family: inherit;
          color: #1f2937;
        }
        .header {
          display: flex;
          justify-content: space-between;
          align-items: flex-end;
          gap: 24px;
          padding-bottom: 16px;
          border-bottom: 1px solid #e5e7eb;
        }
        .header h1 {
          margin: 0;
          font-size: 26px;
          font-weight: 700;
        }
        .header p {
          margin: 6px 0 0;
          font-size: 14px;
          color: #6b7280;
        }
        .filter {
          width: 280px;
          flex-shrink: 0;
        }
        .section-title {
          margin: 8px 0 0;
          font-size: 13px;
          font-weight: 600;
          letter-spacing: 0.06em;
          text-transform: uppercase;
          color: #6b7280;
        }
        .kpis {
          display: grid;
          grid-template-columns: repeat(6, 1fr);
          gap: 16px;
        }
        .kpi {
          height: 140px;
        }
        .trend {
          height: 380px;
        }
        .mix {
          display: grid;
          grid-template-columns: repeat(3, 1fr);
          gap: 16px;
        }
        .mix > div {
          height: 360px;
        }
        .table {
          height: 440px;
        }
        @media (max-width: 1100px) {
          .kpis { grid-template-columns: repeat(3, 1fr); }
          .mix { grid-template-columns: 1fr; }
        }
        @media (max-width: 640px) {
          .header { flex-direction: column; align-items: stretch; }
          .filter { width: 100%; }
          .kpis { grid-template-columns: repeat(2, 1fr); }
        }
      </style>

      <div class="page">
        <div class="header">
          <div>
            <h1>CEO Monthly Sales Review</h1>
            <p>Headline results for the review month vs the prior month. Defaults to the last complete month. Net figures exclude cancelled and returned items.</p>
          </div>
          <div class="filter"><h-block name="f_month"></h-block></div>
        </div>

        <div class="section-title">Month at a glance</div>
        <div class="kpis">
          <div class="kpi"><h-block name="k_net_sales"></h-block></div>
          <div class="kpi"><h-block name="k_gross_profit"></h-block></div>
          <div class="kpi"><h-block name="k_gross_margin"></h-block></div>
          <div class="kpi"><h-block name="k_orders"></h-block></div>
          <div class="kpi"><h-block name="k_aov"></h-block></div>
          <div class="kpi"><h-block name="k_return_rate"></h-block></div>
        </div>

        <div class="section-title">Trend</div>
        <div class="trend"><h-block name="c_trend"></h-block></div>

        <div class="section-title">Where the month's sales came from</div>
        <div class="mix">
          <div><h-block name="c_category"></h-block></div>
          <div><h-block name="c_channel"></h-block></div>
          <div><h-block name="c_country"></h-block></div>
        </div>

        <div class="section-title">Top products this month</div>
        <div class="table"><h-block name="t_products"></h-block></div>
      </div>
    ;;
  }
}
