Dashboard r08_hai_canvas_a1 {
  title: 'CEO Monthly Sales Review'
  description: @md
Monthly executive view of sales growth, profitability, demand quality, category performance, market concentration, and top products.
  ;;
  theme: H.themes.classic

  settings {
    timezone: 'Etc/UTC'
    autorun_on_open: true
    autorun_on_changes: true
    cache_duration: 360
  }

  // ---- HEADER & CONTROLS ----

  block title: TextBlock {
    content: @md
# CEO Monthly Sales Review

Monitor monthly commercial performance across revenue, profitability, orders, returns, products, and markets.
    ;;
  }

  block note: TextBlock {
    content: @md
**Net Sales** exclude cancelled and returned order items. Use the controls to focus the review on a reporting period, customer market, or product category.
    ;;
  }

  block date_range: FilterBlock {
    label: 'Order Item Created At'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
    default {
      operator: 'matches'
      value: '$H_NIL$'
    }
  }

  block country_filter: FilterBlock {
    label: 'Customer Country'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.country)
    }
    default {
      operator: 'matches'
      value: '$H_NIL$'
    }
  }

  block category_filter: FilterBlock {
    label: 'Product Category'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.category)
    }
    default {
      operator: 'matches'
      value: '$H_NIL$'
    }
  }

  block period_comparison: PopBlock {
    label: 'Compare To'
    default {
      type: 'relative'
      duration: []
    }
  }

  // ---- MONTHLY SCORECARD ----

  block h_scorecard: TextBlock {
    content: @md
## Monthly Scorecard
    ;;
  }

  block net_sales_kpi: VizBlock {
    label: 'Net Sales'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'center'
      }
    }
  }

  block gross_profit_kpi: VizBlock {
    label: 'Gross Profit'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_profit)
        label: 'Gross Profit'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'center'
      }
    }
  }

  block gross_margin_kpi: VizBlock {
    label: 'Gross Margin'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'center'
        label {
          font_size: 16
        }
        metric_value {
          font_size: 32
        }
      }
    }
  }

  block fulfilled_orders_kpi: VizBlock {
    label: 'Fulfilled Orders'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        label: 'Fulfilled Orders'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'center'
      }
    }
  }

  block aov_kpi: VizBlock {
    label: 'Average Order Value'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'center'
        metric_value {
          font_size: 28
        }
        compare_value {
          font_size: 14
        }
      }
    }
  }

  block return_rate_kpi: VizBlock {
    label: 'Return Rate'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.return_rate)
        label: 'Return Rate'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'center'
        label {
          font_size: 14
        }
        metric_value {
          font_size: 32
        }
        compare_value {
          font_size: 14
        }
      }
    }
  }

  // ---- TREND ----

  block h_trend: TextBlock {
    content: @md
## Sales & Profit Trend

How are monthly sales and gross profit moving over the selected reporting period?
    ;;
  }

  block monthly_sales_profit: VizBlock {
    label: 'Monthly Net Sales and Gross Profit'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        label: 'Month'
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        label: 'Sales and Profit'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.gross_profit)
            label: 'Gross Profit'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        x_axis_label: 'Month'
        legend_label: 'bottom'
        show_rows_with_no_data: true
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  // ---- PERFORMANCE DRIVERS ----

  block h_drivers: TextBlock {
    content: @md
## Performance Drivers

Which product categories and customer markets contribute the most to sales and gross profit?
    ;;
  }

  block category_sales: VizBlock {
    label: 'Top Product Categories by Net Sales'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Product Category'
      }
      y_axis {
        label: 'Net Sales'
        series {
          mark_type: 'bar'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      tooltips: [
        VizTooltip {
          field: VizFieldFull {
            ref: r(thelook.gross_margin)
            label: 'Gross Margin'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      ]
      settings {
        row_limit: 10
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
        legend_label: 'hidden'
      }
    }
  }

  block country_sales: VizBlock {
    label: 'Top Customer Countries by Net Sales'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.country)
        label: 'Customer Country'
      }
      y_axis {
        series {
          mark_type: 'bar'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        series {
          mark_type: 'bar'
          field: VizFieldFull {
            ref: r(thelook.gross_profit)
            label: 'Gross Profit'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        legend_label: 'top'
        row_limit: 10
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  // ---- PRODUCT DETAIL ----

  block h_products: TextBlock {
    content: @md
## Top Product Detail

Review the leading products and their associated profitability, order value, and return rate.
    ;;
  }

  block top_products: VizBlock {
    label: 'Top 10 Products by Net Sales'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          ref: r(thelook_products.name)
          label: 'Product Name'
          format {
            type: 'text'
          }
          uname: 'product_name'
        },
        VizFieldFull {
          ref: r(thelook_products.category)
          label: 'Product Category'
          format {
            type: 'text'
          }
          uname: 'product_category'
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'net_sales'
        },
        VizFieldFull {
          ref: r(thelook.gross_profit)
          label: 'Gross Profit'
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'gross_profit'
        },
        VizFieldFull {
          ref: r(thelook.fulfilled_orders)
          label: 'Fulfilled Orders'
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'fulfilled_orders'
        },
        VizFieldFull {
          ref: r(thelook.aov)
          label: 'Average Order Value'
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'average_order_value'
        },
        VizFieldFull {
          ref: r(thelook.return_rate)
          label: 'Return Rate'
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'return_rate'
        },
      ]
      settings {
        row_limit: 10
        pagination_size: 10
        show_row_number: true
        wrap_header_text: true
        sorts: [
          KeyBasedSortSetting {
            key: 'net_sales'
            direction: 'desc'
          },
          KeyBasedSortSetting {
            key: 'product_name'
            direction: 'asc'
          },
          KeyBasedSortSetting {
            key: 'product_category'
            direction: 'asc'
          },
        ]
      }
    }
  }

  // ---- INTERACTIONS ----

  explicit_interactions: [
    FilterInteraction {
      from: 'date_range'
      to: [
        'net_sales_kpi',
        'gross_profit_kpi',
        'gross_margin_kpi',
        'fulfilled_orders_kpi',
        'aov_kpi',
        'return_rate_kpi',
        'monthly_sales_profit',
        'category_sales',
        'country_sales',
        'top_products',
      ]
      field: r(thelook_order_items.created_at)
    },
    FilterInteraction {
      from: 'country_filter'
      to: [
        'net_sales_kpi',
        'gross_profit_kpi',
        'gross_margin_kpi',
        'fulfilled_orders_kpi',
        'aov_kpi',
        'return_rate_kpi',
        'monthly_sales_profit',
        'category_sales',
        'country_sales',
        'top_products',
      ]
      field: r(thelook_users.country)
    },
    FilterInteraction {
      from: 'category_filter'
      to: [
        'net_sales_kpi',
        'gross_profit_kpi',
        'gross_margin_kpi',
        'fulfilled_orders_kpi',
        'aov_kpi',
        'return_rate_kpi',
        'monthly_sales_profit',
        'category_sales',
        'country_sales',
        'top_products',
      ]
      field: r(thelook_products.category)
    },
    PopInteraction {
      from: 'period_comparison'
      to: [
        'net_sales_kpi',
        'gross_profit_kpi',
        'gross_margin_kpi',
        'fulfilled_orders_kpi',
        'aov_kpi',
        'return_rate_kpi',
        'monthly_sales_profit',
      ]
      field: r(thelook_order_items.created_at)
    },
  ]

  // ---- CANVAS LAYOUT ----

  view: CanvasLayout {
    label: 'Monthly Review'
    width: 1220
    height: 1940
    grid_size: 20

    block title {
      position: pos(20, 20, 1180, 80)
      layer: 1
    }

    block note {
      position: pos(20, 100, 1180, 60)
      layer: 1
    }

    block date_range {
      position: pos(20, 180, 280, 80)
      layer: 1
    }

    block country_filter {
      position: pos(320, 180, 280, 80)
      layer: 1
    }

    block category_filter {
      position: pos(620, 180, 280, 80)
      layer: 1
    }

    block period_comparison {
      position: pos(920, 180, 280, 80)
      layer: 1
    }

    block h_scorecard {
      position: pos(20, 280, 1180, 50)
      layer: 1
    }

    block net_sales_kpi {
      position: pos(20, 340, 180, 140)
      layer: 1
    }

    block gross_profit_kpi {
      position: pos(220, 340, 180, 140)
      layer: 1
    }

    block gross_margin_kpi {
      position: pos(420, 340, 180, 140)
      layer: 1
    }

    block fulfilled_orders_kpi {
      position: pos(620, 340, 180, 140)
      layer: 1
    }

    block aov_kpi {
      position: pos(820, 340, 180, 140)
      layer: 1
    }

    block return_rate_kpi {
      position: pos(1020, 340, 180, 140)
      layer: 1
    }

    block h_trend {
      position: pos(20, 510, 1180, 60)
      layer: 1
    }

    block monthly_sales_profit {
      position: pos(20, 580, 1180, 380)
      layer: 1
    }

    block h_drivers {
      position: pos(20, 990, 1180, 60)
      layer: 1
    }

    block category_sales {
      position: pos(20, 1060, 580, 360)
      layer: 1
    }

    block country_sales {
      position: pos(620, 1060, 580, 360)
      layer: 1
    }

    block h_products {
      position: pos(20, 1450, 1180, 60)
      layer: 1
    }

    block top_products {
      position: pos(20, 1520, 1180, 380)
      layer: 1
    }

    mobile {
      mode: 'auto'
    }
  }
}
