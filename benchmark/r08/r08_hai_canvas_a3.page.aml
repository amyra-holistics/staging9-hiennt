Dashboard r08_hai_canvas_a3 {
  title: 'CEO Monthly Sales Review'
  description: @md
    Executive monthly view of sales performance, profitability, product mix, market contribution, and fulfillment health.
  ;;
  theme: H.themes.classic

  settings {
    timezone: 'Etc/UTC'
    autorun_on_open: true
    autorun_on_changes: true
    cache_duration: 360
  }

  // ── Title and controls ─────────────────────────────────────────────────────

  block title: TextBlock {
    content: @md
      # CEO Monthly Sales Review

      Review monthly sales momentum, profitability, demand mix, and fulfillment performance.
    ;;
  }

  block f_date: FilterBlock {
    label: 'Order Item Created Date'
    type: 'date'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block f_country: FilterBlock {
    label: 'Customer Country'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.country)
    }
  }

  block f_category: FilterBlock {
    label: 'Product Category'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.category)
    }
  }

  // ── Executive scorecard ────────────────────────────────────────────────────

  block h_scorecard: TextBlock {
    content: @md
      ## Executive Scorecard
    ;;
  }

  block kpi_net_sales: VizBlock {
    label: 'Net Sales'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
      }
    }
  }

  block kpi_gross_profit: VizBlock {
    label: 'Gross Profit'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_profit)
        label: 'Gross Profit'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block kpi_gross_margin: VizBlock {
    label: 'Gross Margin'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block kpi_aov: VizBlock {
    label: 'Average Order Value'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block kpi_fulfilled_orders: VizBlock {
    label: 'Fulfilled Orders'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        label: 'Fulfilled Orders'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block kpi_return_rate: VizBlock {
    label: 'Return Rate'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.return_rate)
        label: 'Return Rate'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  // ── Sales momentum ─────────────────────────────────────────────────────────

  block h_sales_momentum: TextBlock {
    content: @md
      ## Sales & Profit Momentum
    ;;
  }

  block v_monthly_sales: VizBlock {
    label: 'Monthly Net Sales and Gross Profit'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        label: 'Order Item Month'
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.gross_profit)
            label: 'Gross Profit'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        legend_label: 'top'
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  // ── Sales drivers ──────────────────────────────────────────────────────────

  block h_sales_drivers: TextBlock {
    content: @md
      ## Sales Drivers
    ;;
  }

  block v_category_sales: VizBlock {
    label: 'Top 10 Product Categories by Net Sales'
    viz: CombinationChart {
      dataset: thelook
      calculation category_sales_rank {
        label: 'Category Sales Rank'
        formula: @aql rank(
          order: net_sales | desc(),
          order: gross_profit | desc(),
          order: gross_margin | desc()
        );;
        calc_type: 'measure'
        data_type: 'number'
      }
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Product Category'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          mark_type: 'bar'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      tooltips: [
        VizTooltip {
          field: VizFieldFull {
            ref: r(thelook.gross_profit)
            label: 'Gross Profit'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      ]
      settings {
        row_limit: 10
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block v_country_sales: VizBlock {
    label: 'Top 10 Customer Countries by Net Sales'
    viz: CombinationChart {
      dataset: thelook
      calculation country_rank_by_net_sales {
        label: 'Country Rank by Net Sales'
        formula: @aql rank(order: net_sales | desc());;
        calc_type: 'measure'
        data_type: 'number'
      }
      x_axis: VizFieldFull {
        ref: r(thelook_users.country)
        label: 'Customer Country'
      }
      y_axis {
        label: 'Net Sales'
        series {
          mark_type: 'bar'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      tooltips: [
        VizTooltip {
          field: VizFieldFull {
            ref: 'country_rank_by_net_sales'
            label: 'Rank'
            format {
              type: 'number'
              pattern: '#,###'
            }
          }
        }
      ]
      conditions: [
        "country_rank_by_net_sales <= 10"
      ]
      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  // ── Operating health ───────────────────────────────────────────────────────

  block h_operating_health: TextBlock {
    content: @md
      ## Fulfillment & Returns Health
    ;;
  }

  block v_status_performance: VizBlock {
    label: 'Order Item Status Performance'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          ref: r(thelook_order_items.status)
          label: 'Order Item Status'
          format {
            type: 'text'
          }
          uname: 'order_item_status'
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'net_sales'
        },
        VizFieldFull {
          ref: r(thelook.gross_sales)
          label: 'Gross Sales'
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'gross_sales'
        },
        VizFieldFull {
          ref: r(thelook.items_sold)
          label: 'Items Sold'
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'items_sold'
        },
        VizFieldFull {
          ref: r(thelook.return_rate)
          label: 'Return Rate'
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'return_rate'
        }
      ]
      settings {
        pagination_size: 100
        show_row_number: true
        wrap_header_text: true
        sorts: [
          KeyBasedSortSetting {
            key: 'net_sales'
            direction: 'desc'
          },
          KeyBasedSortSetting {
            key: 'order_item_status'
            direction: 'asc'
          }
        ]
      }
    }
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'f_date'
      to: [
        'kpi_net_sales',
        'kpi_gross_profit',
        'kpi_gross_margin',
        'kpi_aov',
        'kpi_fulfilled_orders',
        'kpi_return_rate',
        'v_monthly_sales',
        'v_category_sales',
        'v_country_sales',
        'v_status_performance'
      ]
      field: r(thelook_order_items.created_at)
    },
    FilterInteraction {
      from: 'f_country'
      to: [
        'kpi_net_sales',
        'kpi_gross_profit',
        'kpi_gross_margin',
        'kpi_aov',
        'kpi_fulfilled_orders',
        'kpi_return_rate',
        'v_monthly_sales',
        'v_category_sales',
        'v_country_sales',
        'v_status_performance'
      ]
      field: r(thelook_users.country)
    },
    FilterInteraction {
      from: 'f_category'
      to: [
        'kpi_net_sales',
        'kpi_gross_profit',
        'kpi_gross_margin',
        'kpi_aov',
        'kpi_fulfilled_orders',
        'kpi_return_rate',
        'v_monthly_sales',
        'v_category_sales',
        'v_country_sales',
        'v_status_performance'
      ]
      field: r(thelook_products.category)
    }
  ]

  view: CanvasLayout {
    label: 'Monthly Sales Review'
    width: 1440
    height: 1760
    grid_size: 20
    auto_expand_vertically: true

    block title {
      position: pos(30, 30, 1380, 90)
      layer: 1
    }

    block f_date {
      position: pos(30, 140, 400, 80)
      layer: 1
    }

    block f_country {
      position: pos(450, 140, 400, 80)
      layer: 1
    }

    block f_category {
      position: pos(870, 140, 400, 80)
      layer: 1
    }

    block h_scorecard {
      position: pos(30, 250, 1380, 50)
      layer: 1
    }

    block kpi_net_sales {
      position: pos(30, 320, 210, 140)
      layer: 1
    }

    block kpi_gross_profit {
      position: pos(260, 320, 210, 140)
      layer: 1
    }

    block kpi_gross_margin {
      position: pos(490, 320, 210, 140)
      layer: 1
    }

    block kpi_aov {
      position: pos(720, 320, 210, 140)
      layer: 1
    }

    block kpi_fulfilled_orders {
      position: pos(950, 320, 210, 140)
      layer: 1
    }

    block kpi_return_rate {
      position: pos(1180, 320, 230, 140)
      layer: 1
    }

    block h_sales_momentum {
      position: pos(30, 500, 1380, 50)
      layer: 1
    }

    block v_monthly_sales {
      position: pos(30, 570, 1380, 390)
      layer: 1
    }

    block h_sales_drivers {
      position: pos(30, 1000, 1380, 50)
      layer: 1
    }

    block v_category_sales {
      position: pos(30, 1070, 675, 400)
      layer: 1
    }

    block v_country_sales {
      position: pos(735, 1070, 675, 400)
      layer: 1
    }

    block h_operating_health {
      position: pos(30, 1510, 1380, 50)
      layer: 1
    }

    block v_status_performance {
      position: pos(30, 1580, 1380, 300)
      layer: 1
    }

    mobile {
      mode: 'auto'
    }
  }
}
