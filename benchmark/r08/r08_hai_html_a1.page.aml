Dashboard r08_hai_html_a1 {
  title: 'CEO Monthly Sales Review'
  description: '''
A monthly executive view of sales performance, profitability, product mix, geographic concentration, and returns.
'''
  theme: H.themes.classic

  settings {
    timezone: 'Etc/UTC'
    autorun_on_open: true
    autorun_on_changes: true
    cache_duration: 360
  }

  // ────────────────────────────────────────────────────────────────────────────
  // Header and controls
  // ────────────────────────────────────────────────────────────────────────────

  block b_title: TextBlock {
    content: @md
# CEO Monthly Sales Review

Monitor sales growth, profitability, customer-market concentration, and product performance.
;;
  }

  block f_order_item_date: FilterBlock {
    label: 'Sales Period'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block f_customer_country: FilterBlock {
    label: 'Customer Country'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.country)
    }
    settings {
      input_type: 'multiple'
    }
  }

  block f_product_department: FilterBlock {
    label: 'Product Department'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.department)
    }
    settings {
      input_type: 'multiple'
    }
  }

  block d_date_grain: DateDrillBlock {
    label: 'Trend Grain'
    default: 'month'
  }

  block p_period_comparison: PopBlock {
    label: 'Compare Period'
    default {
      type: 'relative'
      duration: 1
      granularity: 'month'
      show_growth_rate: true
    }
  }

  // ────────────────────────────────────────────────────────────────────────────
  // Executive KPIs
  // ────────────────────────────────────────────────────────────────────────────

  block v_net_sales: VizBlock {
    label: 'Net Sales'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block v_gross_profit: VizBlock {
    label: 'Gross Profit'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_profit)
        label: 'Gross Profit'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block v_fulfilled_orders: VizBlock {
    label: 'Fulfilled Orders'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        label: 'Fulfilled Orders'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block v_gross_margin: VizBlock {
    label: 'Gross Margin'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  // ────────────────────────────────────────────────────────────────────────────
  // Sales performance and profitability
  // ────────────────────────────────────────────────────────────────────────────

  block v_sales_profit_trend: VizBlock {
    label: 'Monthly Net Sales and Gross Profit'
    description: 'Net sales and gross profit over the selected period.'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        label: 'Month'
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        label: 'Sales and Profit'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.gross_profit)
            label: 'Gross Profit'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        x_axis_label: 'Month'
        legend_label: 'bottom'
        show_data_points: false
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block v_department_mix: VizBlock {
    label: 'Net Sales Mix by Department'
    description: 'Distribution of net sales between product departments.'
    viz: PieChart {
      dataset: thelook
      legend: VizFieldFull {
        ref: r(thelook_products.department)
        label: 'Product Department'
      }
      series {
        field: VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      }
      settings {
        display_as_donut: true
        legend_label: 'right'
        show_data_label: false
        show_percentage: true
        show_total: true
        sort: PieFamilySort {
          type: 'pie'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  // ────────────────────────────────────────────────────────────────────────────
  // Commercial drivers and risk indicators
  // ────────────────────────────────────────────────────────────────────────────

  block v_category_sales: VizBlock {
    label: 'Top 10 Product Categories by Net Sales'
    description: 'The highest-revenue product categories in the selected period.'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Product Category'
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        row_limit: 10
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block v_return_rate_trend: VizBlock {
    label: 'Monthly Return Rate'
    description: 'Returned items as a share of all order items.'
    viz: LineChart {
      dataset: thelook
      x_axis: VizFieldFull {
        label: 'Order Item Created Month'
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            label: 'Return Rate'
            ref: r(thelook.return_rate)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        legend_label: 'hidden'
        show_data_points: false
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block v_country_sales: VizBlock {
    label: 'Top 10 Customer Countries'
    description: 'Largest customer markets ranked by net sales and gross margin.'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          ref: r(thelook_users.country)
          label: 'Customer Country'
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.gross_margin)
          label: 'Gross Margin'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
      ]
      settings {
        row_limit: 10
        show_row_number: true
        show_sum_row: true
        wrap_header_text: true
        sorts: [
          IndexBasedSortSetting {
            field_index: 1
            direction: 'desc'
          },
        ]
        column_styles: [
          ColumnStyle {
            key: 'thelook_users.country'
            width: 220
          },
          ColumnStyle {
            key: 'thelook.net_sales'
            width: 150
          },
          ColumnStyle {
            key: 'thelook.gross_margin'
            width: 130
          },
        ]
      }
    }
  }

  block v_brand_sales: VizBlock {
    label: 'Top 10 Brands by Net Sales'
    description: 'Brands contributing the most net sales in the selected period.'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.brand)
        label: 'Brand'
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        row_limit: 10
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  // ────────────────────────────────────────────────────────────────────────────
  // Interactions
  // ────────────────────────────────────────────────────────────────────────────

  explicit_interactions: [
    FilterInteraction {
      from: 'f_order_item_date'
      to: [
        'v_net_sales',
        'v_gross_profit',
        'v_fulfilled_orders',
        'v_gross_margin',
        'v_sales_profit_trend',
        'v_department_mix',
        'v_category_sales',
        'v_return_rate_trend',
        'v_country_sales',
        'v_brand_sales',
      ]
      field: r(thelook_order_items.created_at)
    },
    FilterInteraction {
      from: 'f_customer_country'
      to: [
        'v_net_sales',
        'v_gross_profit',
        'v_fulfilled_orders',
        'v_gross_margin',
        'v_sales_profit_trend',
        'v_department_mix',
        'v_category_sales',
        'v_return_rate_trend',
        'v_brand_sales',
      ]
      field: r(thelook_users.country)
    },
    FilterInteraction {
      from: 'f_product_department'
      to: [
        'v_net_sales',
        'v_gross_profit',
        'v_fulfilled_orders',
        'v_gross_margin',
        'v_sales_profit_trend',
        'v_category_sales',
        'v_return_rate_trend',
        'v_country_sales',
        'v_brand_sales',
      ]
      field: r(thelook_products.department)
    },
    DateDrillInteraction {
      from: 'd_date_grain'
      to: [
        'v_sales_profit_trend',
        'v_return_rate_trend',
      ]
      field: r(thelook_order_items.created_at)
    },
    PopInteraction {
      from: 'p_period_comparison'
      to: [
        'v_net_sales',
        'v_gross_profit',
        'v_fulfilled_orders',
        'v_gross_margin',
      ]
      field: r(thelook_order_items.created_at)
    },
  ]

  // ────────────────────────────────────────────────────────────────────────────
  // HTML layout
  // ────────────────────────────────────────────────────────────────────────────

  view: HTMLLayout {
    content: @html
<style>
  .ceo-dashboard {
    --ink: #18212f;
    --muted: #64748b;
    --border: #e2e8f0;
    --surface: #ffffff;
    --canvas: #f6f8fb;
    --navy: #1e3a5f;
    --blue: #2563eb;
    --green: #059669;
    --amber: #d97706;
    --red: #dc2626;
    max-width: 1480px;
    margin: 0 auto;
    padding: 28px;
    color: var(--ink);
    background: var(--canvas);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  .ceo-dashboard * {
    box-sizing: border-box;
  }

  .ceo-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    padding: 28px 32px;
    margin-bottom: 20px;
    border-radius: 18px;
    color: #ffffff;
    background: linear-gradient(125deg, #13263f 0%, #1e3a5f 55%, #2563eb 150%);
  }

  .ceo-header h1 {
    margin: 0 0 8px;
    color: #ffffff;
    font-size: 30px;
    line-height: 1.15;
    letter-spacing: -0.03em;
  }

  .ceo-header p {
    margin: 0;
    color: #cbd5e1;
    font-size: 14px;
  }

  .review-label {
    margin-bottom: 8px;
    color: #93c5fd;
    font-size: 11px;
    font-weight: 750;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .controls {
    display: grid;
    grid-template-columns: minmax(200px, 1.35fr) repeat(4, minmax(160px, 1fr));
    gap: 12px;
    margin-bottom: 28px;
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
  }

  .control {
    min-width: 0;
  }

  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 32px;
  }

  .kpi-card {
    min-width: 0;
    padding: 18px 20px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
  }

  .kpi-card.net-sales {
    border-top: 4px solid var(--blue);
  }

  .kpi-card.profit {
    border-top: 4px solid var(--green);
  }

  .kpi-card.orders {
    border-top: 4px solid var(--amber);
  }

  .kpi-card.margin {
    border-top: 4px solid #7c3aed;
  }

  .kpi-label {
    margin-bottom: 8px;
    color: var(--muted);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin: 32px 0 14px;
  }

  .section-heading h2 {
    margin: 0;
    color: var(--ink);
    font-size: 18px;
    letter-spacing: -0.01em;
  }

  .section-heading span {
    color: var(--muted);
    font-size: 13px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 16px;
  }

  .card {
    min-width: 0;
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
  }

  .card-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 6px;
  }

  .card-title {
    margin: 0;
    color: var(--ink);
    font-size: 15px;
    font-weight: 750;
  }

  .card-note {
    color: var(--muted);
    font-size: 12px;
  }

  .span-8 {
    grid-column: span 8;
  }

  .span-7 {
    grid-column: span 7;
  }

  .span-6 {
    grid-column: span 6;
  }

  .span-5 {
    grid-column: span 5;
  }

  .span-4 {
    grid-column: span 4;
  }

  .chart-large {
    min-height: 390px;
  }

  .chart-medium {
    min-height: 340px;
  }

  .chart-small {
    min-height: 300px;
  }

  @media (max-width: 1100px) {
    .controls {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .kpi-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .span-8,
    .span-7,
    .span-6,
    .span-5,
    .span-4 {
      grid-column: span 6;
    }
  }

  @media (max-width: 720px) {
    .ceo-dashboard {
      padding: 16px;
    }

    .ceo-header {
      display: block;
      padding: 22px;
    }

    .controls,
    .kpi-grid {
      grid-template-columns: 1fr;
    }

    .span-8,
    .span-7,
    .span-6,
    .span-5,
    .span-4 {
      grid-column: span 12;
    }
  }
</style>

<div class="ceo-dashboard">
  <header class="ceo-header">
    <div>
      <div class="review-label">Executive Performance Dashboard</div>
      <h-block name="b_title"></h-block>
    </div>
    <div class="review-label">Monthly operating review</div>
  </header>

  <section class="controls">
    <div class="control"><h-block name="f_order_item_date"></h-block></div>
    <div class="control"><h-block name="f_customer_country"></h-block></div>
    <div class="control"><h-block name="f_product_department"></h-block></div>
    <div class="control"><h-block name="d_date_grain"></h-block></div>
    <div class="control"><h-block name="p_period_comparison"></h-block></div>
  </section>

  <section class="kpi-grid">
    <div class="kpi-card net-sales">
      <div class="kpi-label">Net Sales</div>
      <h-block name="v_net_sales"></h-block>
    </div>
    <div class="kpi-card profit">
      <div class="kpi-label">Gross Profit</div>
      <h-block name="v_gross_profit"></h-block>
    </div>
    <div class="kpi-card orders">
      <div class="kpi-label">Fulfilled Orders</div>
      <h-block name="v_fulfilled_orders"></h-block>
    </div>
    <div class="kpi-card margin">
      <div class="kpi-label">Gross Margin</div>
      <h-block name="v_gross_margin"></h-block>
    </div>
  </section>

  <div class="section-heading">
    <h2>Sales and profitability trend</h2>
    <span>Are sales and gross profit moving in the right direction?</span>
  </div>

  <section class="grid">
    <div class="card span-8 chart-large">
      <div class="card-header">
        <h3 class="card-title">Net Sales and Gross Profit</h3>
        <span class="card-note">Trend by selected grain</span>
      </div>
      <h-block name="v_sales_profit_trend"></h-block>
    </div>

    <div class="card span-4 chart-large">
      <div class="card-header">
        <h3 class="card-title">Sales Mix</h3>
        <span class="card-note">By department</span>
      </div>
      <h-block name="v_department_mix"></h-block>
    </div>
  </section>

  <div class="section-heading">
    <h2>Commercial drivers and risk signals</h2>
    <span>Which products, markets, and quality indicators need leadership attention?</span>
  </div>

  <section class="grid">
    <div class="card span-6 chart-medium">
      <div class="card-header">
        <h3 class="card-title">Top Product Categories</h3>
        <span class="card-note">Ranked by net sales</span>
      </div>
      <h-block name="v_category_sales"></h-block>
    </div>

    <div class="card span-6 chart-medium">
      <div class="card-header">
        <h3 class="card-title">Return Rate</h3>
        <span class="card-note">Monthly product-quality signal</span>
      </div>
      <h-block name="v_return_rate_trend"></h-block>
    </div>

    <div class="card span-5 chart-small">
      <div class="card-header">
        <h3 class="card-title">Top Customer Markets</h3>
        <span class="card-note">Sales and margin concentration</span>
      </div>
      <h-block name="v_country_sales"></h-block>
    </div>

    <div class="card span-7 chart-small">
      <div class="card-header">
        <h3 class="card-title">Top Brands</h3>
        <span class="card-note">Ranked by net sales</span>
      </div>
      <h-block name="v_brand_sales"></h-block>
    </div>
  </section>
</div>
;;
  }
}
