Dashboard r08_hai_html_a3 {
  title: 'CEO Monthly Sales Review'
  description: 'Monthly executive review of sales, profitability, customer geography, and product category performance.'
  theme: H.themes.classic

  settings {
    timezone: 'UTC'
    cache_duration: 3600
  }

  block dashboard_title: TextBlock {
    content: @md
# CEO Monthly Sales Review

Monitor commercial performance, profitability, and the mix of sales by market and product category.
    ;;
  }

  block f_order_date: FilterBlock {
    label: 'Order Item Created Date'
    type: 'date'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block f_country: FilterBlock {
    label: 'Customer Country'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.country)
    }
    settings {
      input_type: 'multiple'
    }
  }

  block f_department: FilterBlock {
    label: 'Product Department'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.department)
    }
    settings {
      input_type: 'multiple'
    }
  }

  block kpi_net_sales: VizBlock {
    label: 'Net Sales'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
      }
    }
  }

  block kpi_gross_profit: VizBlock {
    label: 'Gross Profit'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_profit)
        label: 'Gross Profit'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
      }
    }
  }

  block kpi_gross_margin: VizBlock {
    label: 'Gross Margin'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: '#,###0.0%'
        }
      }
      settings {
        display_mode: 'single'
      }
    }
  }

  block kpi_aov: VizBlock {
    label: 'Average Order Value'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
      }
    }
  }

  block kpi_return_rate: VizBlock {
    label: 'Return Rate'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.return_rate)
        label: 'Return Rate'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
      }
    }
  }

  block monthly_sales_profit: VizBlock {
    label: 'Monthly Net Sales and Gross Profit'
    viz: CombinationChart {
      dataset: thelook

      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        label: 'Month'
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }

      y_axis {
        label: 'Sales and Profit'

        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }

        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.gross_profit)
            label: 'Gross Profit'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }

      settings {
        legend_label: 'top'
        show_data_points: false
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block sales_by_country: VizBlock {
    label: 'Net Sales by Customer Country'
    viz: BarChart {
      dataset: thelook

      x_axis: VizFieldFull {
        ref: r(thelook_users.country)
        label: 'Customer Country'
        format {
          type: 'text'
        }
      }

      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }

      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block category_performance: VizBlock {
    label: 'Category Performance'
    viz: DataTable {
      dataset: thelook

      fields: [
        VizFieldFull {
          ref: r(thelook_products.category)
          label: 'Product Category'
          format {
            type: 'text'
          }
        }

        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          uname: 'net_sales'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }

        VizFieldFull {
          ref: r(thelook.gross_profit)
          label: 'Gross Profit'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }

        VizFieldFull {
          ref: r(thelook.gross_margin)
          label: 'Gross Margin'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }

        VizFieldFull {
          ref: r(thelook.items_sold)
          label: 'Items Sold'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]

      settings {
        pagination_size: 100
        show_row_number: true
        wrap_header_text: true
        sorts: [
          KeyBasedSortSetting {
            key: 'net_sales'
            direction: 'desc'
          }
        ]
      }
    }
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'f_order_date'
      to: [
        'kpi_net_sales',
        'kpi_gross_profit',
        'kpi_gross_margin',
        'kpi_aov',
        'kpi_return_rate',
        'monthly_sales_profit',
        'sales_by_country',
        'category_performance'
      ]
      field: r(thelook_order_items.created_at)
    }

    FilterInteraction {
      from: 'f_country'
      to: [
        'kpi_net_sales',
        'kpi_gross_profit',
        'kpi_gross_margin',
        'kpi_aov',
        'kpi_return_rate',
        'monthly_sales_profit',
        'sales_by_country',
        'category_performance'
      ]
      field: r(thelook_users.country)
    }

    FilterInteraction {
      from: 'f_department'
      to: [
        'kpi_net_sales',
        'kpi_gross_profit',
        'kpi_gross_margin',
        'kpi_aov',
        'kpi_return_rate',
        'monthly_sales_profit',
        'sales_by_country',
        'category_performance'
      ]
      field: r(thelook_products.department)
    }
  ]

  view: HTMLLayout {
    content: @html
<style>
  .ceo-dashboard {
    box-sizing: border-box;
    max-width: 1440px;
    margin: 0 auto;
    padding: 24px;
    color: #172033;
  }

  .ceo-dashboard * {
    box-sizing: border-box;
  }

  .hero {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    padding: 8px 0 24px;
    border-bottom: 1px solid #e5e7eb;
  }

  .filters {
    display: grid;
    grid-template-columns: repeat(3, minmax(180px, 1fr));
    gap: 16px;
    width: min(100%, 800px);
  }

  .section {
    margin-top: 32px;
  }

  .section-heading {
    margin: 0 0 4px;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .section-description {
    margin: 0 0 16px;
    color: #64748b;
    font-size: 14px;
  }

  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 16px;
  }

  .chart-card,
  .table-card,
  .kpi-grid > div {
    min-width: 0;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
  }

  .chart-card {
    min-height: 390px;
    padding: 8px;
  }

  .bottom-grid {
    display: grid;
    grid-template-columns: minmax(320px, 0.85fr) minmax(560px, 1.5fr);
    gap: 20px;
  }

  .table-card {
    min-height: 400px;
    padding: 8px;
  }

  @media (max-width: 1100px) {
    .hero {
      flex-direction: column;
    }

    .filters {
      width: 100%;
    }

    .kpi-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .bottom-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 680px) {
    .ceo-dashboard {
      padding: 16px;
    }

    .filters,
    .kpi-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="ceo-dashboard">
  <header class="hero">
    <div>
      <h-block name="dashboard_title" />
    </div>

    <div class="filters">
      <h-block name="f_order_date" />
      <h-block name="f_country" />
      <h-block name="f_department" />
    </div>
  </header>

  <section class="section">
    <h2 class="section-heading">Executive scorecard</h2>
    <p class="section-description">
      Review the commercial outcome, profitability, order value, and product-return exposure for the selected period.
    </p>

    <div class="kpi-grid">
      <div><h-block name="kpi_net_sales" /></div>
      <div><h-block name="kpi_gross_profit" /></div>
      <div><h-block name="kpi_gross_margin" /></div>
      <div><h-block name="kpi_aov" /></div>
      <div><h-block name="kpi_return_rate" /></div>
    </div>
  </section>

  <section class="section">
    <h2 class="section-heading">Sales and profit trend</h2>
    <p class="section-description">
      Track whether sales growth is translating into gross profit over time.
    </p>

    <div class="chart-card">
      <h-block name="monthly_sales_profit" />
    </div>
  </section>

  <section class="section">
    <h2 class="section-heading">Market and category performance</h2>
    <p class="section-description">
      Identify the customer markets and product categories that contribute most to revenue and profit.
    </p>

    <div class="bottom-grid">
      <div class="chart-card">
        <h-block name="sales_by_country" />
      </div>

      <div class="table-card">
        <h-block name="category_performance" />
      </div>
    </div>
  </section>
</div>
    ;;
  }
}
