Dashboard r08_haid_canvas_a1 {
  title: 'CEO Monthly Sales Review'
  description: @md
A monthly CEO review of net sales, gross profit, margin, and order value. Use the controls to focus the review by sales date, product department, or customer country; use Compare To for prior-year context.
  ;;
  owner: 'thinh.nt@holistics.io'
  theme: H.themes.classic

  block t_title: TextBlock {
    content: @md
# CEO Monthly Sales Review
**Decision guide:** review sales scale, profitability, and order quality together. Net Sales excludes cancelled and returned items; Gross Profit is Net Sales less COGS; AOV is Net Sales per fulfilled order.

Use the filters to scope the period, department, and customer country. The comparison control applies a prior-year comparison to the headline KPIs and sales trend.
    ;;
  }

  block f_order_item_created_at: FilterBlock {
    label: 'Sales Date'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block f_department: FilterBlock {
    label: 'Product Department'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.department)
    }
  }

  block f_country: FilterBlock {
    label: 'Customer Country'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.country)
    }
  }

  block p_compare: PopBlock {
    label: 'Compare To'
    default {
      type: 'relative'
      duration: 1
      granularity: 'year'
      show_growth_rate: true
    }
  }

  block v_net_sales: VizBlock {
    label: 'Net Sales'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.net_sales)
    label: 'Net Sales'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
}
  }

  block v_gross_profit: VizBlock {
    label: 'Gross Profit'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.gross_profit)
    label: 'Gross Profit'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
}
  }

  block v_gross_margin: VizBlock {
    label: 'Gross Margin'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.gross_margin)
    label: 'Gross Margin'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
}
  }

  block v_aov: VizBlock {
    label: 'Average Order Value'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.aov)
    label: 'Average Order Value'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
}
  }

  block v_sales_trend: VizBlock {
    label: 'Monthly Net Sales Trend'
    viz: CombinationChart {
  dataset: thelook
  x_axis: VizFieldFull {
    ref: r(thelook_order_items.created_at)
    label: 'Month'
    transformation: 'datetrunc month'
    format {
      type: 'date'
      pattern: 'LLL yyyy'
    }
  }
  y_axis {
    series {
      mark_type: 'line'
      field: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }
  settings {
    x_axis_label: 'Month'
    show_data_points: true
    sort: LineFamilySort {
      type: 'xaxis'
      direction: 'asc'
    }
  }
}
  }

  block v_sales_by_department: VizBlock {
    label: 'Sales Mix by Product Department'
    viz: CombinationChart {
  dataset: thelook
  x_axis: VizFieldFull {
    ref: r(thelook_products.department)
    label: 'Product Department'
  }
  y_axis {
    series {
      mark_type: 'bar'
      field: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }
  settings {
    sort: LineFamilySort {
      type: 'yaxis'
      field_index: 0
      direction: 'desc'
    }
  }
}
  }

  block v_product_profitability: VizBlock {
    label: 'Department Profitability Decision Table'
    viz: DataTable {
  dataset: thelook
  fields: [
    VizFieldFull {
      label: 'Department'
      ref: r(thelook_products.department)
      format {
        type: 'text'
      }
    },
    VizFieldFull {
      label: 'Net Sales'
      ref: r(thelook.net_sales)
      format {
        type: 'number'
        pattern: 'inherited'
      }
    },
    VizFieldFull {
      label: 'Gross Profit'
      ref: r(thelook.gross_profit)
      uname: 'custom_gross_profit_1'
      format {
        type: 'number'
        pattern: 'inherited'
      }
    },
    VizFieldFull {
      label: 'Gross Margin'
      ref: r(thelook.gross_margin)
      format {
        type: 'number'
        pattern: 'inherited'
      }
    },
    VizFieldFull {
      label: 'Items Sold'
      ref: r(thelook.items_sold)
      format {
        type: 'number'
        pattern: 'inherited'
      }
    }
  ]
  settings {
    pagination_size: 100
    show_row_number: true
    wrap_header_text: true
    sorts: [
      KeyBasedSortSetting {
        key: 'custom_gross_profit_1'
        direction: 'desc'
      }
    ]
    single_cell_display: 'normal'
  }
}
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'f_order_item_created_at'
      to: [
        'v_net_sales',
        'v_gross_profit',
        'v_gross_margin',
        'v_aov',
        'v_sales_trend',
        'v_sales_by_department',
        'v_product_profitability',
      ]
      field: r(thelook_order_items.created_at)
    },
    FilterInteraction {
      from: 'f_department'
      to: [
        'v_net_sales',
        'v_gross_profit',
        'v_gross_margin',
        'v_aov',
        'v_sales_trend',
        'v_sales_by_department',
        'v_product_profitability',
      ]
      field: r(thelook_products.department)
    },
    FilterInteraction {
      from: 'f_country'
      to: [
        'v_net_sales',
        'v_gross_profit',
        'v_gross_margin',
        'v_aov',
        'v_sales_trend',
        'v_sales_by_department',
        'v_product_profitability',
      ]
      field: r(thelook_users.country)
    },
    PopInteraction {
      from: 'p_compare'
      to: [
        'v_net_sales',
        'v_gross_profit',
        'v_gross_margin',
        'v_aov',
        'v_sales_trend',
      ]
      field: r(thelook_order_items.created_at)
    },
  ]

  view: TabLayout {
    tab ceo_review: CanvasLayout {
      label: 'CEO Review'
      width: 1220
      height: 1180
      grid_size: 20
      auto_expand_vertically: true

      block t_title { position: pos(20, 20, 1180, 100) layer: 1 }
      block f_order_item_created_at { position: pos(20, 140, 280, 100) layer: 1 }
      block f_department { position: pos(320, 140, 280, 100) layer: 1 }
      block f_country { position: pos(620, 140, 280, 100) layer: 1 }
      block p_compare { position: pos(920, 140, 280, 100) layer: 1 }

      block v_net_sales { position: pos(20, 260, 280, 120) layer: 1 }
      block v_gross_profit { position: pos(320, 260, 280, 120) layer: 1 }
      block v_gross_margin { position: pos(620, 260, 280, 120) layer: 1 }
      block v_aov { position: pos(920, 260, 280, 120) layer: 1 }

      block v_sales_trend { position: pos(20, 400, 1180, 340) layer: 1 }
      block v_sales_by_department { position: pos(20, 760, 480, 380) layer: 1 }
      block v_product_profitability { position: pos(520, 760, 680, 380) layer: 1 }

      mobile { mode: 'auto' }
    }
  }

  settings {
    autorun_on_open: true
    autorun_on_changes: true
    cache_duration: 60
  }
}
