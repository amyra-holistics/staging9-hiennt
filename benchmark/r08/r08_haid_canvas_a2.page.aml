Dashboard r08_haid_canvas_a2 {
  title: 'CEO Monthly Sales Review'
  description: @md Monitor monthly sales performance, profitability, geographic concentration, and returns. Use the controls to focus the review on a date range, department, country, or comparison period. ;;
  theme: H.themes.classic

  block b_title: TextBlock {
    content: @md # CEO Monthly Sales Review
Track sales growth, margin health, fulfillment, and return performance across the business. ;;
  }

  block f_date_range: FilterBlock {
    label: 'Date Range'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block f_department: FilterBlock {
    label: 'Department'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.department)
    }
  }

  block f_country: FilterBlock {
    label: 'Country'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.country)
    }
  }

  block p_compare_to: PopBlock {
    label: 'Compare To'
  }

  block v_net_sales: VizBlock {
    label: 'Net Sales'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.net_sales)
    label: 'Net Sales'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
}
  }

  block v_gross_profit: VizBlock {
    label: 'Gross Profit'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.gross_profit)
    label: 'Gross Profit'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
}
  }

  block v_gross_margin: VizBlock {
    label: 'Gross Margin'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.gross_margin)
    label: 'Gross Margin'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
}
  }

  block v_fulfilled_orders: VizBlock {
    label: 'Fulfilled Orders'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.fulfilled_orders)
    label: 'Fulfilled Orders'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
}
  }

  block v_aov: VizBlock {
    label: 'Average Order Value'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.aov)
    label: 'Average Order Value'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
}
  }

  block b_sales_trends: TextBlock {
    content: @md ## Sales and profitability trends
Review growth in sales volume alongside gross profit and gross margin. ;;
  }

  block v_monthly_net_sales: VizBlock {
    label: 'Monthly Net Sales'
    viz: CombinationChart {
  dataset: thelook
  x_axis: VizFieldFull {
    ref: r(thelook_order_items.created_at)
    label: 'Created Month'
    transformation: 'datetrunc month'
    format {
      type: 'date'
      pattern: 'LLL yyyy'
    }
  }
  y_axis {
    series {
      mark_type: 'line'
      field: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }
  settings {
    x_axis_label: 'Month'
    sort: LineFamilySort {
      type: 'xaxis'
      direction: 'asc'
    }
  }
}
  }

  block v_profitability_trend: VizBlock {
    label: 'Profitability Trend'
    viz: CombinationChart {
  dataset: thelook
  x_axis: VizFieldFull {
    ref: r(thelook_order_items.created_at)
    label: 'Created Month'
    transformation: 'datetrunc month'
    format {
      type: 'date'
      pattern: 'LLL yyyy'
    }
  }
  y_axis {
    label: 'Gross Profit'
    series {
      mark_type: 'line'
      field: VizFieldFull {
        ref: r(thelook.gross_profit)
        label: 'Gross Profit'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
    settings {
      alignment: 'left'
    }
  }
  y_axis {
    label: 'Gross Margin'
    series {
      mark_type: 'line'
      field: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
    settings {
      alignment: 'right'
    }
  }
  settings {
    legend_label: 'bottom'
    show_data_points: true
    sort: LineFamilySort {
      type: 'xaxis'
      direction: 'asc'
    }
  }
}
  }

  block b_drivers_returns: TextBlock {
    content: @md ## Revenue drivers and returns
Identify the categories and countries contributing to sales, then monitor return risk. ;;
  }

  block v_net_sales_by_category: VizBlock {
    label: 'Net Sales by Category'
    viz: CombinationChart {
  dataset: thelook
  x_axis: VizFieldFull {
    ref: r(thelook_products.category)
    label: 'Product Category'
  }
  y_axis {
    series {
      mark_type: 'bar'
      field: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }
  settings {
    sort: LineFamilySort {
      type: 'yaxis'
      field_index: 0
      direction: 'desc'
    }
  }
}
  }

  block v_net_sales_by_country: VizBlock {
    label: 'Net Sales by Country'
    viz: CombinationChart {
  dataset: thelook
  x_axis: VizFieldFull {
    ref: r(thelook_users.country)
    label: 'Customer Country'
  }
  y_axis {
    label: 'Net Sales'
    series {
      mark_type: 'bar'
      field: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }
  settings {
    legend_label: 'hidden'
    sort: LineFamilySort {
      type: 'yaxis'
      field_index: 0
      direction: 'desc'
    }
  }
}
  }

  block v_return_rate_by_category: VizBlock {
    label: 'Return Rate by Category'
    viz: CombinationChart {
  dataset: thelook
  x_axis: VizFieldFull {
    ref: r(thelook_products.category)
    label: 'Product Category'
  }
  y_axis {
    label: 'Return Rate'
    series {
      mark_type: 'bar'
      field: VizFieldFull {
        ref: r(thelook.return_rate)
        label: 'Return Rate'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }
  settings {
    legend_label: 'hidden'
    sort: LineFamilySort {
      type: 'yaxis'
      field_index: 0
      direction: 'desc'
    }
  }
}
  }

  block v_returns_by_month: VizBlock {
    label: 'Returns by Month'
    viz: CombinationChart {
  dataset: thelook

  calculation returned_order_items {
    label: 'Returned Order Items'
    formula: @aql thelook_order_items | count(thelook_order_items.id) | where(thelook_order_items.status == 'Returned');;
    calc_type: 'measure'
    data_type: 'number'
  }

  x_axis: VizFieldFull {
    ref: r(thelook_order_items.returned_at)
    label: 'Return Month'
    transformation: 'datetrunc month'
    format {
      type: 'date'
      pattern: 'LLL yyyy'
    }
  }

  y_axis {
    series {
      mark_type: 'column'
      field: VizFieldFull {
        ref: 'returned_order_items'
        label: 'Returned Order Items'
        format {
          type: 'number'
          pattern: '#,###0.00'
        }
      }
    }
  }

  settings {
    x_axis_label: 'Return Month'
    sort: LineFamilySort {
      type: 'xaxis'
      direction: 'asc'
    }
  }
}
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'f_date_range'
      to: ['v_net_sales', 'v_gross_profit', 'v_gross_margin', 'v_fulfilled_orders', 'v_aov', 'v_monthly_net_sales', 'v_profitability_trend', 'v_net_sales_by_category', 'v_net_sales_by_country', 'v_return_rate_by_category']
      field: r(thelook_order_items.created_at)
    },
    FilterInteraction {
      from: 'f_date_range'
      to: ['v_returns_by_month']
      field: r(thelook_order_items.returned_at)
    },
    FilterInteraction {
      from: 'f_date_range'
      to: ['f_department', 'f_country']
      disabled: true
    },
    FilterInteraction {
      from: 'f_department'
      to: ['v_net_sales', 'v_gross_profit', 'v_gross_margin', 'v_fulfilled_orders', 'v_aov', 'v_monthly_net_sales', 'v_profitability_trend', 'v_net_sales_by_category', 'v_net_sales_by_country', 'v_return_rate_by_category', 'v_returns_by_month']
      field: r(thelook_products.department)
    },
    FilterInteraction {
      from: 'f_department'
      to: ['f_date_range', 'f_country']
      disabled: true
    },
    FilterInteraction {
      from: 'f_country'
      to: ['v_net_sales', 'v_gross_profit', 'v_gross_margin', 'v_fulfilled_orders', 'v_aov', 'v_monthly_net_sales', 'v_profitability_trend', 'v_net_sales_by_category', 'v_net_sales_by_country', 'v_return_rate_by_category', 'v_returns_by_month']
      field: r(thelook_users.country)
    },
    FilterInteraction {
      from: 'f_country'
      to: ['f_date_range', 'f_department']
      disabled: true
    },
    PopInteraction {
      from: 'p_compare_to'
      to: ['v_net_sales', 'v_gross_profit', 'v_gross_margin', 'v_fulfilled_orders', 'v_aov', 'v_monthly_net_sales', 'v_profitability_trend', 'v_net_sales_by_category', 'v_net_sales_by_country', 'v_return_rate_by_category']
      field: r(thelook_order_items.created_at)
    },
    PopInteraction {
      from: 'p_compare_to'
      to: ['v_returns_by_month']
      field: r(thelook_order_items.returned_at)
    }
  ]

  view: TabLayout {
    tab monthly_review: CanvasLayout {
      label: 'Monthly Review'
      width: 1220
      height: 1780
      grid_size: 20
      auto_expand_vertically: true

      block b_title { position: pos(20, 20, 1180, 100) layer: 1 }
      block f_date_range { position: pos(20, 140, 280, 100) layer: 1 }
      block f_department { position: pos(320, 140, 280, 100) layer: 1 }
      block f_country { position: pos(620, 140, 280, 100) layer: 1 }
      block p_compare_to { position: pos(920, 140, 280, 100) layer: 1 }

      block v_net_sales { position: pos(20, 260, 220, 120) layer: 1 }
      block v_gross_profit { position: pos(260, 260, 220, 120) layer: 1 }
      block v_gross_margin { position: pos(500, 260, 220, 120) layer: 1 }
      block v_fulfilled_orders { position: pos(740, 260, 220, 120) layer: 1 }
      block v_aov { position: pos(980, 260, 220, 120) layer: 1 }

      block b_sales_trends { position: pos(20, 400, 1180, 80) layer: 1 }
      block v_monthly_net_sales { position: pos(20, 500, 580, 360) layer: 1 }
      block v_profitability_trend { position: pos(620, 500, 580, 360) layer: 1 }

      block b_drivers_returns { position: pos(20, 880, 1180, 80) layer: 1 }
      block v_net_sales_by_category { position: pos(20, 980, 580, 360) layer: 1 }
      block v_net_sales_by_country { position: pos(620, 980, 580, 360) layer: 1 }
      block v_return_rate_by_category { position: pos(20, 1360, 580, 360) layer: 1 }
      block v_returns_by_month { position: pos(620, 1360, 580, 360) layer: 1 }

      mobile { mode: 'auto' }
    }
  }
}
