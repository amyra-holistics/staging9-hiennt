Dashboard r08_haid_html_a1 {
  title: 'CEO Monthly Sales Review'
  description: @md
A monthly executive review of sales performance, profitability, orders, and product drivers.
  ;;
  theme: H.themes.classic

  block b_title: TextBlock {
    content: @md
# CEO Monthly Sales Review
Use the controls to focus the review by time period, customer country, and product department. Period comparison is applied to the executive KPIs and monthly sales trend.
    ;;
  }

  block f_date: FilterBlock {
    label: 'Order Item Date'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
    default {
      operator: 'matches'
      value: '$H_NIL$'
    }
  }

  block f_country: FilterBlock {
    label: 'Customer Country'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.country)
    }
    default {
      operator: 'matches'
      value: '$H_NIL$'
    }
  }

  block f_department: FilterBlock {
    label: 'Product Department'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.department)
    }
    default {
      operator: 'matches'
      value: '$H_NIL$'
    }
  }

  block p_period_comparison: PopBlock {
    label: 'Period Comparison'
    default {
      type: 'relative'
      duration: []
    }
  }

  block v_net_sales: VizBlock {
    label: 'Net Sales'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.net_sales)
    label: 'Net Sales'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
}
  }

  block v_gross_profit: VizBlock {
    label: 'Gross Profit'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.gross_profit)
    label: 'Gross Profit'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
}
  }

  block v_orders: VizBlock {
    label: 'Orders'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.total_orders)
    label: 'Orders'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
}
  }

  block v_aov: VizBlock {
    label: 'Average Order Value'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    label: 'Average Order Value'
    ref: r(thelook.aov)
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
}
  }

  block v_monthly_net_sales: VizBlock {
    label: 'Monthly Net Sales Trend'
    viz: CombinationChart {
  dataset: thelook
  x_axis: VizFieldFull {
    ref: r(thelook_order_items.created_at)
    label: 'Order Item Created Month'
    transformation: 'datetrunc month'
    format {
      type: 'date'
      pattern: 'LLL yyyy'
    }
  }
  y_axis {
    series {
      mark_type: 'line'
      field: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }
  settings {
    x_axis_label: 'Order Item Created Month'
    legend_label: 'hidden'
    show_data_points: true
    sort: LineFamilySort {
      type: 'xaxis'
      direction: 'asc'
    }
  }
}
  }

  block v_department_performance: VizBlock {
    label: 'Department Performance'
    viz: CombinationChart {
  dataset: thelook
  x_axis: VizFieldFull {
    ref: r(thelook_products.department)
    label: 'Product Department'
  }
  y_axis {
    label: 'Sales and Profit'
    series {
      mark_type: 'column'
      field: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
    series {
      mark_type: 'column'
      field: VizFieldFull {
        ref: r(thelook.gross_profit)
        label: 'Gross Profit'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }
  settings {
    legend_label: 'top'
    sort: LineFamilySort {
      type: 'yaxis'
      field_index: 0
      direction: 'desc'
    }
  }
}
  }

  block v_top_products: VizBlock {
    label: 'Top Products'
    viz: DataTable {
  dataset: thelook
  fields: [
    VizFieldFull {
      label: 'Product Name'
      ref: r(thelook_products.name)
      format {
        type: 'text'
      }
      uname: 'product_name'
    },
    VizFieldFull {
      label: 'Net Sales'
      ref: r(thelook.net_sales)
      format {
        type: 'number'
        pattern: 'inherited'
      }
      uname: 'net_sales'
    },
    VizFieldFull {
      label: 'Gross Profit'
      ref: r(thelook.gross_profit)
      format {
        type: 'number'
        pattern: 'inherited'
      }
    },
    VizFieldFull {
      label: 'Fulfilled Orders'
      ref: r(thelook.fulfilled_orders)
      format {
        type: 'number'
        pattern: 'inherited'
      }
    }
  ]
  settings {
    pagination_size: 10
    show_row_number: true
    row_limit: 10
    sorts: [
      KeyBasedSortSetting {
        key: 'net_sales'
        direction: 'desc'
      },
      KeyBasedSortSetting {
        key: 'product_name'
        direction: 'asc'
      }
    ]
  }
}
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'f_date'
      to: ['v_net_sales', 'v_gross_profit', 'v_aov', 'v_monthly_net_sales', 'v_department_performance', 'v_top_products']
      field: r(thelook_order_items.created_at)
    },
    FilterInteraction {
      from: 'f_date'
      to: ['v_orders']
      field: r(thelook_orders.created_at)
    },
    FilterInteraction {
      from: 'f_country'
      to: ['v_net_sales', 'v_gross_profit', 'v_orders', 'v_aov', 'v_monthly_net_sales', 'v_department_performance', 'v_top_products']
      field: r(thelook_users.country)
    },
    FilterInteraction {
      from: 'f_department'
      to: ['v_net_sales', 'v_gross_profit', 'v_orders', 'v_aov', 'v_monthly_net_sales', 'v_department_performance', 'v_top_products']
      field: r(thelook_products.department)
    },
    PopInteraction {
      from: 'p_period_comparison'
      to: ['v_net_sales', 'v_gross_profit', 'v_aov', 'v_monthly_net_sales']
      field: r(thelook_order_items.created_at)
    },
    PopInteraction {
      from: 'p_period_comparison'
      to: ['v_orders']
      field: r(thelook_orders.created_at)
    }
  ]

  view: HTMLLayout {
    content: @html
<style>
  .review { max-width: 1440px; margin: 0 auto; padding: 24px; }
  .controls, .kpis, .analysis { display: grid; gap: 16px; }
  .controls { grid-template-columns: repeat(4, minmax(0, 1fr)); margin: 16px 0 24px; }
  .kpis { grid-template-columns: repeat(4, minmax(0, 1fr)); margin-bottom: 24px; }
  .analysis { grid-template-columns: 1.1fr 0.9fr; margin-bottom: 24px; }
  .section-title { margin: 28px 0 12px; font-size: 20px; font-weight: 700; }
  @media (max-width: 900px) {
    .controls, .kpis, .analysis { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .controls, .kpis, .analysis { grid-template-columns: 1fr; }
  }
</style>
<div class="review">
  <h-block name="b_title" />
  <div class="controls">
    <h-block name="f_date" />
    <h-block name="f_country" />
    <h-block name="f_department" />
    <h-block name="p_period_comparison" />
  </div>
  <div class="kpis">
    <h-block name="v_net_sales" />
    <h-block name="v_gross_profit" />
    <h-block name="v_orders" />
    <h-block name="v_aov" />
  </div>
  <div class="section-title">Monthly Sales Trend</div>
  <h-block name="v_monthly_net_sales" />
  <div class="section-title">Department and Product Performance</div>
  <div class="analysis">
    <h-block name="v_department_performance" />
    <h-block name="v_top_products" />
  </div>
</div>
    ;;
  }
}
