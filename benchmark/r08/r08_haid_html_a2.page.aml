Dashboard r08_haid_html_a2 {
  title: 'CEO Monthly Sales Review'
  description: @md
A monthly executive review of sales performance, momentum, commercial drivers, and return quality. Use the controls to focus the review on a period, department, or customer country.
;;
  theme: H.themes.classic

  block b_header: TextBlock {
    content: @md
# CEO Monthly Sales Review
Review sales performance, profitability, order value, and return quality. Use the controls below to focus the review.
;;
  }

  block h_overview: TextBlock {
    content: @md
## Executive overview
Key commercial outcomes for the selected period and segment.
;;
  }

  block h_momentum: TextBlock {
    content: @md
## Momentum
Track monthly net sales and gross profit, then review the monthly scorecard for the full picture.
;;
  }

  block h_drivers: TextBlock {
    content: @md
## Commercial drivers
Identify the departments and customer countries contributing most to net sales.
;;
  }

  block h_quality: TextBlock {
    content: @md
## Return quality and product detail
Review categories with the highest return rates and the leading products by net sales.
;;
  }

  block f_sales_date: FilterBlock {
    label: 'Sales Date'
    type: 'date'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block c_compare_to: PopBlock {
    label: 'Compare To'
  }

  block f_department: FilterBlock {
    label: 'Product Department'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.department)
    }
  }

  block f_customer_country: FilterBlock {
    label: 'Customer Country'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.country)
    }
  }

  block k_net_sales: VizBlock {
    label: 'Net Sales'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format { type: 'number' pattern: 'inherited' }
      }
    }
  }

  block k_gross_profit: VizBlock {
    label: 'Gross Profit'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_profit)
        label: 'Gross Profit'
        format { type: 'number' pattern: 'inherited' }
      }
    }
  }

  block k_gross_margin: VizBlock {
    label: 'Gross Margin'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format { type: 'number' pattern: 'inherited' }
      }
      settings { display_mode: 'single' alignment: 'center' }
    }
  }

  block k_fulfilled_orders: VizBlock {
    label: 'Fulfilled Orders'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        label: 'Fulfilled Orders'
        format { type: 'number' pattern: 'inherited' }
      }
      settings { display_mode: 'single' }
    }
  }

  block k_aov: VizBlock {
    label: 'Average Order Value'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'
        format { type: 'number' pattern: 'inherited' }
      }
    }
  }

  block k_return_rate: VizBlock {
    label: 'Return Rate'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.return_rate)
        label: 'Return Rate'
        format { type: 'number' pattern: 'inherited' }
      }
    }
  }

  block v_monthly_sales_profit: VizBlock {
    label: 'Monthly Sales and Profit'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        label: 'Order Item Month'
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format { type: 'date' pattern: 'LLL yyyy' }
      }
      y_axis {
        label: 'Sales and Profit'
        series { mark_type: 'line' field: VizFieldFull { label: 'Net Sales' ref: r(thelook.net_sales) format { type: 'number' pattern: 'inherited' } } }
        series { mark_type: 'line' field: VizFieldFull { label: 'Gross Profit' ref: r(thelook.gross_profit) format { type: 'number' pattern: 'inherited' } } }
      }
      settings { legend_label: 'bottom' show_data_points: true sort: LineFamilySort { type: 'xaxis' direction: 'asc' } }
    }
  }

  block v_monthly_scorecard: VizBlock {
    label: 'Monthly Scorecard'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull { label: 'Order Item Month' ref: r(thelook_order_items.created_at) transformation: 'datetrunc month' format { type: 'date' pattern: 'LLL yyyy' } uname: 'datetrunc_month_created_at_1' },
        VizFieldFull { label: 'Net Sales' ref: r(thelook.net_sales) format { type: 'number' pattern: 'inherited' } },
        VizFieldFull { label: 'Gross Profit' ref: r(thelook.gross_profit) format { type: 'number' pattern: 'inherited' } },
        VizFieldFull { label: 'Gross Margin' ref: r(thelook.gross_margin) format { type: 'number' pattern: 'inherited' } },
        VizFieldFull { label: 'Fulfilled Orders' ref: r(thelook.fulfilled_orders) format { type: 'number' pattern: 'inherited' } },
        VizFieldFull { label: 'Average Order Value' ref: r(thelook.aov) format { type: 'number' pattern: 'inherited' } },
        VizFieldFull { label: 'Return Rate' ref: r(thelook.return_rate) format { type: 'number' pattern: 'inherited' } }
      ]
      settings { pagination_size: 100 show_row_number: true sorts: [ KeyBasedSortSetting { key: 'datetrunc_month_created_at_1' direction: 'asc' } ] wrap_header_text: true single_cell_display: 'normal' }
    }
  }

  block v_sales_by_department: VizBlock {
    label: 'Net Sales by Department'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull { ref: r(thelook_products.department) label: 'Product Department' }
      y_axis { series { mark_type: 'bar' field: VizFieldFull { ref: r(thelook.net_sales) label: 'Net Sales' format { type: 'number' pattern: 'inherited' } } } }
      settings { sort: LineFamilySort { type: 'yaxis' field_index: 0 direction: 'desc' } }
    }
  }

  block v_sales_by_country: VizBlock {
    label: 'Net Sales by Customer Country'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull { ref: r(thelook_users.country) label: 'Country' }
      y_axis { series { mark_type: 'bar' field: VizFieldFull { ref: r(thelook.net_sales) label: 'Net Sales' format { type: 'number' pattern: 'inherited' } } } }
      settings { sort: LineFamilySort { type: 'yaxis' field_index: 0 direction: 'desc' } }
    }
  }

  block v_returns_by_category: VizBlock {
    label: 'Return Rate by Category'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull { ref: r(thelook_products.category) label: 'Product Category' }
      y_axis { series { mark_type: 'bar' field: VizFieldFull { ref: r(thelook.return_rate) label: 'Return Rate' format { type: 'number' pattern: 'inherited' } } } }
      settings { sort: LineFamilySort { type: 'yaxis' field_index: 0 direction: 'desc' } }
    }
  }

  block v_top_products: VizBlock {
    label: 'Top Products by Net Sales'
    viz: DataTable {
      dataset: thelook
      filter { field: r(thelook.net_sales) operator: 'not_null' value: [] }
      fields: [
        VizFieldFull { label: 'Product Name' ref: r(thelook_products.name) format { type: 'text' } uname: 'thelook_products_name_1' },
        VizFieldFull { label: 'Product Brand' ref: r(thelook_products.brand) format { type: 'text' } },
        VizFieldFull { label: 'Product Category' ref: r(thelook_products.category) format { type: 'text' } },
        VizFieldFull { label: 'Net Sales' ref: r(thelook.net_sales) format { type: 'number' pattern: 'inherited' } uname: 'custom_net_sales_1' },
        VizFieldFull { label: 'Gross Profit' ref: r(thelook.gross_profit) format { type: 'number' pattern: 'inherited' } },
        VizFieldFull { label: 'Gross Margin' ref: r(thelook.gross_margin) format { type: 'number' pattern: 'inherited' } },
        VizFieldFull { label: 'Return Rate' ref: r(thelook.return_rate) format { type: 'number' pattern: 'inherited' } }
      ]
      settings { pagination_size: 10 show_row_number: true row_limit: 10 sorts: [ KeyBasedSortSetting { key: 'custom_net_sales_1' direction: 'desc' }, KeyBasedSortSetting { key: 'thelook_products_name_1' direction: 'asc' } ] wrap_header_text: true }
    }
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'f_sales_date'
      to: ['k_net_sales', 'k_gross_profit', 'k_gross_margin', 'k_fulfilled_orders', 'k_aov', 'k_return_rate', 'v_monthly_sales_profit', 'v_monthly_scorecard', 'v_sales_by_department', 'v_sales_by_country', 'v_returns_by_category', 'v_top_products']
      field: r(thelook_order_items.created_at)
    },
    FilterInteraction {
      from: 'f_department'
      to: ['k_net_sales', 'k_gross_profit', 'k_gross_margin', 'k_fulfilled_orders', 'k_aov', 'k_return_rate', 'v_monthly_sales_profit', 'v_monthly_scorecard', 'v_sales_by_department', 'v_sales_by_country', 'v_returns_by_category', 'v_top_products']
      field: r(thelook_products.department)
    },
    FilterInteraction {
      from: 'f_customer_country'
      to: ['k_net_sales', 'k_gross_profit', 'k_gross_margin', 'k_fulfilled_orders', 'k_aov', 'k_return_rate', 'v_monthly_sales_profit', 'v_monthly_scorecard', 'v_sales_by_department', 'v_sales_by_country', 'v_returns_by_category', 'v_top_products']
      field: r(thelook_users.country)
    },
    FilterInteraction { from: 'f_sales_date' to: ['f_department', 'f_customer_country'] disabled: true },
    FilterInteraction { from: 'f_department' to: ['f_sales_date', 'f_customer_country'] disabled: true },
    FilterInteraction { from: 'f_customer_country' to: ['f_sales_date', 'f_department'] disabled: true },
    PopInteraction {
      from: 'c_compare_to'
      to: ['k_net_sales', 'k_gross_profit', 'k_gross_margin', 'k_fulfilled_orders', 'k_aov', 'k_return_rate', 'v_monthly_sales_profit', 'v_monthly_scorecard']
      field: r(thelook_order_items.created_at)
    }
  ]

  view: HTMLLayout {
    content: @html
<style>
  .sales-review {
    max-width: 1440px;
    margin: 0 auto;
    padding: 1rem;
    color: #172033;
  }
  .sales-review h1, .sales-review h2 { line-height: 1.2; }
  .controls, .kpis, .two-column { display: grid; gap: 1rem; }
  .controls { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .kpis { grid-template-columns: repeat(6, minmax(0, 1fr)); }
  .two-column { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .section { margin-top: 1.5rem; }
  .card { min-width: 0; }
  .wide { min-width: 0; }
  @media (max-width: 1100px) {
    .kpis { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .controls { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 700px) {
    .controls, .kpis, .two-column { grid-template-columns: 1fr; }
    .sales-review { padding: 0.5rem; }
  }
</style>
<main class="sales-review" aria-label="CEO Monthly Sales Review">
  <header>
    <h-block name="b_header" />
  </header>
  <section class="controls" aria-label="Review controls">
    <div class="card"><h-block name="f_sales_date" /></div>
    <div class="card"><h-block name="c_compare_to" /></div>
    <div class="card"><h-block name="f_department" /></div>
    <div class="card"><h-block name="f_customer_country" /></div>
  </section>
  <section class="section" aria-label="Executive overview">
    <h-block name="h_overview" />
    <div class="kpis">
      <div class="card"><h-block name="k_net_sales" /></div>
      <div class="card"><h-block name="k_gross_profit" /></div>
      <div class="card"><h-block name="k_gross_margin" /></div>
      <div class="card"><h-block name="k_fulfilled_orders" /></div>
      <div class="card"><h-block name="k_aov" /></div>
      <div class="card"><h-block name="k_return_rate" /></div>
    </div>
  </section>
  <section class="section" aria-label="Sales momentum">
    <h-block name="h_momentum" />
    <div class="wide"><h-block name="v_monthly_sales_profit" /></div>
    <div class="wide"><h-block name="v_monthly_scorecard" /></div>
  </section>
  <section class="section" aria-label="Commercial drivers">
    <h-block name="h_drivers" />
    <div class="two-column">
      <div class="card"><h-block name="v_sales_by_department" /></div>
      <div class="card"><h-block name="v_sales_by_country" /></div>
    </div>
  </section>
  <section class="section" aria-label="Return quality and product detail">
    <h-block name="h_quality" />
    <div class="two-column">
      <div class="card"><h-block name="v_returns_by_category" /></div>
      <div class="card"><h-block name="v_top_products" /></div>
    </div>
  </section>
</main>
;;
  }
}
