Dashboard r08_haid_html_a3 {
  title: 'CEO Sales Dashboard'
  description: @md
A CEO-ready sales overview for monitoring performance, comparing periods, and identifying sales and returns drivers.
;;
  theme: H.themes.classic

  block title: TextBlock {
    content: @md
# CEO Sales Dashboard
Use the controls to focus the sales view by date, product category, or customer country. Period comparison applies to the headline KPIs and the monthly trend.
;;
  }

  block filter_sales_date: FilterBlock {
    label: 'Sales Date'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block filter_product_category: FilterBlock {
    label: 'Product Category'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.category)
    }
  }

  block filter_customer_country: FilterBlock {
    label: 'Customer Country'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.country)
    }
  }

  block pop_compare: PopBlock {
    label: 'Compare Period'
  }

  block kpi_net_sales: VizBlock {
    label: 'Net Sales'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        alignment: 'center'
      }
    }
  }

  block kpi_gross_profit: VizBlock {
    label: 'Gross Profit'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_profit)
        label: 'Gross Profit'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        label {
          font_size: 14
        }
      }
    }
  }

  block kpi_gross_margin: VizBlock {
    label: 'Gross Margin'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        alignment: 'center'
      }
    }
  }

  block kpi_fulfilled_orders: VizBlock {
    label: 'Fulfilled Orders'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        label: 'Fulfilled Orders'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block monthly_trend: VizBlock {
    label: 'Monthly Net Sales and Gross Profit Trend'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.gross_profit)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block sales_by_category: VizBlock {
    label: 'Net Sales by Product Category'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Product Category'
      }
      y_axis {
        label: 'Net Sales'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        x_axis_label: 'Product Category'
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block sales_by_country: VizBlock {
    label: 'Net Sales by Customer Country'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.country)
        label: 'Country'
      }
      y_axis {
        label: 'Net Sales'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        x_axis_label: 'Country'
        legend_label: 'hidden'
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block product_returns_quality: VizBlock {
    label: 'Product Returns Quality'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          label: 'Product Name'
          ref: r(thelook_products.name)
          format {
            type: 'text'
          }
          uname: 'product_name'
        },
        VizFieldFull {
          label: 'Net Sales'
          ref: r(thelook.net_sales)
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'net_sales'
        },
        VizFieldFull {
          label: 'Return Rate'
          ref: r(thelook.return_rate)
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'return_rate'
        }
      ]
      settings {
        pagination_size: 100
        show_row_number: true
        sorts: [
          KeyBasedSortSetting {
            key: 'return_rate'
            direction: 'desc'
          },
          KeyBasedSortSetting {
            key: 'net_sales'
            direction: 'desc'
          }
        ]
        single_cell_display: 'normal'
      }
    }
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'filter_sales_date'
      to: [
        'kpi_net_sales',
        'kpi_gross_profit',
        'kpi_gross_margin',
        'kpi_fulfilled_orders',
        'monthly_trend',
        'sales_by_category',
        'sales_by_country',
        'product_returns_quality'
      ]
      field: r(thelook_order_items.created_at)
    },
    FilterInteraction {
      from: 'filter_sales_date'
      to: ['filter_product_category', 'filter_customer_country']
      disabled: true
    },
    FilterInteraction {
      from: 'filter_product_category'
      to: [
        'kpi_net_sales',
        'kpi_gross_profit',
        'kpi_gross_margin',
        'kpi_fulfilled_orders',
        'monthly_trend',
        'sales_by_category',
        'sales_by_country',
        'product_returns_quality'
      ]
      field: r(thelook_products.category)
    },
    FilterInteraction {
      from: 'filter_product_category'
      to: ['filter_sales_date', 'filter_customer_country']
      disabled: true
    },
    FilterInteraction {
      from: 'filter_customer_country'
      to: [
        'kpi_net_sales',
        'kpi_gross_profit',
        'kpi_gross_margin',
        'kpi_fulfilled_orders',
        'monthly_trend',
        'sales_by_category',
        'sales_by_country',
        'product_returns_quality'
      ]
      field: r(thelook_users.country)
    },
    FilterInteraction {
      from: 'filter_customer_country'
      to: ['filter_sales_date', 'filter_product_category']
      disabled: true
    },
    PopInteraction {
      from: 'pop_compare'
      to: [
        'kpi_net_sales',
        'kpi_gross_profit',
        'kpi_gross_margin',
        'kpi_fulfilled_orders',
        'monthly_trend'
      ]
      field: r(thelook_order_items.created_at)
    }
  ]

  view: HTMLLayout {
    content: @html
<style>
  .ceo-dashboard {
    display: grid;
    gap: 20px;
    max-width: 1440px;
    margin: 0 auto;
    padding: 8px;
  }
  .controls, .kpis, .drivers {
    display: grid;
    gap: 16px;
  }
  .controls { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .kpis { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .drivers { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .hero, .quality { min-width: 0; }
  @media (max-width: 960px) {
    .controls, .kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .controls, .kpis, .drivers { grid-template-columns: 1fr; }
    .ceo-dashboard { gap: 14px; padding: 0; }
  }
</style>
<div class="ceo-dashboard">
  <section class="heading"><h-block name="title" /></section>
  <section class="controls">
    <h-block name="filter_sales_date" />
    <h-block name="filter_product_category" />
    <h-block name="filter_customer_country" />
    <h-block name="pop_compare" />
  </section>
  <section class="kpis">
    <h-block name="kpi_net_sales" />
    <h-block name="kpi_gross_profit" />
    <h-block name="kpi_gross_margin" />
    <h-block name="kpi_fulfilled_orders" />
  </section>
  <section class="hero"><h-block name="monthly_trend" /></section>
  <section class="drivers">
    <h-block name="sales_by_category" />
    <h-block name="sales_by_country" />
  </section>
  <section class="quality"><h-block name="product_returns_quality" /></section>
</div>
;;
  }
}
