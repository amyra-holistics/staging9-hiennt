Dashboard r08_haidfd_canvas_a2 {
  title: 'Retail Ledger — Executive Overview'
  description: @md
    Executive retail performance overview for monitoring sales, profit, order quality, and the monthly trajectory.
  ;;
  theme: H.themes.classic

  block t_overview: TextBlock {
    content: @md
      # Retail Ledger
      **Executive overview** — a clear operating read on sales, profit, fulfilment, and returns. Use the controls to set the reporting slice; the ledger-style KPI row is the period’s snapshot, while the trajectory below shows its monthly movement.
    ;;
  }

  block f_created_at: FilterBlock {
    label: 'Order Item Date'
    type: 'date'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block f_country: FilterBlock {
    label: 'Customer Country'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.country)
    }
  }

  block f_department: FilterBlock {
    label: 'Product Department'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.department)
    }
  }

  block p_period_comparison: PopBlock {
    label: 'Compare Period'
  }

  block v_net_sales: VizBlock {
    label: 'Net Sales'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.net_sales)
    label: 'Net Sales'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
}
  }

  block v_gross_profit: VizBlock {
    label: 'Gross Profit'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.gross_profit)
    label: 'Gross Profit'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
}
  }

  block v_gross_margin: VizBlock {
    label: 'Gross Margin'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block v_fulfilled_orders: VizBlock {
    label: 'Fulfilled Orders'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.fulfilled_orders)
    label: 'Fulfilled Orders'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
}
  }

  block v_average_order_value: VizBlock {
    label: 'Average Order Value'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.aov)
    label: 'Average Order Value'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
}
  }

  block v_return_rate: VizBlock {
    label: 'Return Rate'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.return_rate)
        label: 'Return Rate'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block t_trajectory: TextBlock {
    content: @md
      ## Monthly sales and profit trajectory
      Read the two lines together: net sales shows realised trading value, while gross profit shows the value remaining after product cost.
    ;;
  }

  block v_monthly_sales_profit: VizBlock {
    label: 'Monthly Sales and Profit Trajectory'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        label: 'Order Item Month'
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        series {
          mark_type: 'line'
          field: VizFieldFull {
            label: 'Net Sales'
            ref: r(thelook.net_sales)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        series {
          mark_type: 'line'
          field: VizFieldFull {
            label: 'Gross Profit'
            ref: r(thelook.gross_profit)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        legend_label: 'bottom'
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block t_drivers: TextBlock {
    content: @md
      ## What is driving the result?
      Compare the department and country sales rankings to isolate where the period’s trading value is concentrated. Use the reporting controls and period comparison to test whether a leading segment is expanding or contracting.
    ;;
  }

  block v_department_sales: VizBlock {
    label: 'Net Sales by Department'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.department)
        label: 'Product Department'
      }
      y_axis {
        series {
          mark_type: 'bar'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        x_axis_label: 'Product Department'
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block v_country_sales: VizBlock {
    label: 'Net Sales by Country'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_users.country)
        label: 'Country'
      }
      y_axis {
        series {
          mark_type: 'bar'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        row_limit: 15
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block t_commercial_watchlist: TextBlock {
    content: @md
      ## Commercial watchlist
      Prioritise departments where strong sales are not translating into gross profit or margin, and where return rate is elevated. Review the ranked table after each filter or comparison change to focus commercial follow-up.
    ;;
  }

  block v_department_performance: VizBlock {
    label: 'Department Performance Watchlist'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          ref: r(thelook_products.department)
          label: 'Department'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          uname: 'net_sales_sort'
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
        },
        VizFieldFull {
          ref: r(thelook.gross_profit)
          label: 'Gross Profit'
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
        },
        VizFieldFull {
          ref: r(thelook.gross_margin)
          label: 'Gross Margin'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        },
        VizFieldFull {
          ref: r(thelook.return_rate)
          label: 'Return Rate'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        },
      ]
      settings {
        pagination_size: 100
        show_row_number: true
        wrap_header_text: true
        sorts: [
          KeyBasedSortSetting {
            key: 'net_sales_sort'
            direction: 'desc'
          }
        ]
      }
    }
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'f_created_at'
      to: ['v_net_sales', 'v_gross_profit', 'v_gross_margin', 'v_fulfilled_orders', 'v_average_order_value', 'v_return_rate', 'v_monthly_sales_profit', 'v_department_sales', 'v_country_sales', 'v_department_performance']
      field: r(thelook_order_items.created_at)
    },
    FilterInteraction {
      from: 'f_country'
      to: ['v_net_sales', 'v_gross_profit', 'v_gross_margin', 'v_fulfilled_orders', 'v_average_order_value', 'v_return_rate', 'v_monthly_sales_profit', 'v_department_sales', 'v_country_sales', 'v_department_performance']
      field: r(thelook_users.country)
    },
    FilterInteraction {
      from: 'f_department'
      to: ['v_net_sales', 'v_gross_profit', 'v_gross_margin', 'v_fulfilled_orders', 'v_average_order_value', 'v_return_rate', 'v_monthly_sales_profit', 'v_department_sales', 'v_country_sales', 'v_department_performance']
      field: r(thelook_products.department)
    },
    FilterInteraction {
      from: 'f_created_at'
      to: ['f_country', 'f_department']
      disabled: true
    },
    FilterInteraction {
      from: 'f_country'
      to: ['f_created_at', 'f_department']
      disabled: true
    },
    FilterInteraction {
      from: 'f_department'
      to: ['f_created_at', 'f_country']
      disabled: true
    },
    PopInteraction {
      from: 'p_period_comparison'
      to: ['v_net_sales', 'v_gross_profit', 'v_gross_margin', 'v_fulfilled_orders', 'v_average_order_value', 'v_return_rate', 'v_monthly_sales_profit', 'v_department_sales', 'v_country_sales', 'v_department_performance']
      field: r(thelook_order_items.created_at)
    }
  ]

  view: TabLayout {
    tab overview: CanvasLayout {
      label: 'Overview'
      width: 1220
      height: 2220
      grid_size: 20
      auto_expand_vertically: true

      block t_overview { position: pos(20, 20, 1180, 120) layer: 1 }
      block f_created_at { position: pos(20, 160, 280, 100) layer: 1 }
      block f_country { position: pos(320, 160, 280, 100) layer: 1 }
      block f_department { position: pos(620, 160, 280, 100) layer: 1 }
      block p_period_comparison { position: pos(920, 160, 280, 100) layer: 1 }

      block v_net_sales { position: pos(20, 280, 380, 140) layer: 1 }
      block v_gross_profit { position: pos(420, 280, 380, 140) layer: 1 }
      block v_gross_margin { position: pos(820, 280, 380, 140) layer: 1 }
      block v_fulfilled_orders { position: pos(20, 440, 380, 140) layer: 1 }
      block v_average_order_value { position: pos(420, 440, 380, 140) layer: 1 }
      block v_return_rate { position: pos(820, 440, 380, 140) layer: 1 }

      block t_trajectory { position: pos(20, 600, 1180, 100) layer: 1 }
      block v_monthly_sales_profit { position: pos(20, 720, 1180, 480) layer: 1 }

      block t_drivers { position: pos(20, 1220, 1180, 100) layer: 1 }
      block v_department_sales { position: pos(20, 1340, 580, 360) layer: 1 }
      block v_country_sales { position: pos(620, 1340, 580, 360) layer: 1 }

      block t_commercial_watchlist { position: pos(20, 1720, 1180, 100) layer: 1 }
      block v_department_performance { position: pos(20, 1840, 1180, 360) layer: 1 }

      mobile { mode: 'auto' }
    }
  }
}
