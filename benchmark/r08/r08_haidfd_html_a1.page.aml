Dashboard r08_haidfd_html_a1 {
  title: 'Monthly Sales Review'
  description: @md
    CEO review of sales, profitability, fulfilment, and category return risk. Net Sales excludes Cancelled and Returned order items; the reporting period uses order-item creation date.
  ;;
  theme: H.themes.classic

  settings {
    autorun_on_open: true
    autorun_on_changes: true
    cache_duration: 60
  }

  block title: TextBlock {
    content: @md
      <div class="review-title">
        <p class="review-kicker">Executive financial review</p>
        <h1>Monthly Sales Review</h1>
        <p class="review-deck">A concise view of net sales, profitability, fulfilment, and return exposure. Sales are recognised on order-item creation and exclude Cancelled and Returned items.</p>
      </div>
    ;;
  }

  block date_filter: FilterBlock {
    label: 'Reporting period'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block kpi_net_sales: VizBlock {
    label: 'Net Sales'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.net_sales)
    label: 'Net Sales'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
  settings {
    display_mode: 'single'
    alignment: 'left'
  }
}
  }

  block kpi_gross_profit: VizBlock {
    label: 'Gross Profit'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.gross_profit)
    label: 'Gross Profit'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
  settings {
    alignment: 'center'
  }
}
  }

  block kpi_gross_margin: VizBlock {
    label: 'Gross Margin'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.gross_margin)
    label: 'Gross Margin'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
  settings {
    display_mode: 'single'
    alignment: 'center'
  }
}
  }

  block kpi_fulfilled_orders: VizBlock {
    label: 'Fulfilled Orders'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.fulfilled_orders)
    label: 'Fulfilled Orders'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
  settings {
    alignment: 'center'
  }
}
  }

  block kpi_aov: VizBlock {
    label: 'Average Order Value'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.aov)
    label: 'Average Order Value'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
  settings {
    alignment: 'center'
  }
}
  }

  block kpi_return_rate: VizBlock {
    label: 'Return Rate'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.return_rate)
    label: 'Return Rate'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
  settings {
    alignment: 'center'
    metric_value {
      font_color: '#F1434B'
    }
  }
}
  }

  block sales_trend: VizBlock {
    label: 'Monthly Net Sales'
    description: 'Net Sales excludes Cancelled and Returned order items.'
    viz: CombinationChart {
  dataset: thelook
  x_axis: VizFieldFull {
    label: 'Order Item Created Month'
    ref: r(thelook_order_items.created_at)
    transformation: 'datetrunc month'
    format {
      type: 'date'
      pattern: 'LLL yyyy'
    }
  }
  y_axis {
    label: 'Net Sales'
    series {
      mark_type: 'line'
      field: VizFieldFull {
        label: 'Net Sales'
        ref: r(thelook.net_sales)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }
  settings {
    x_axis_label: 'Month'
    legend_label: 'hidden'
    show_data_points: false
    sort: LineFamilySort {
      type: 'xaxis'
      direction: 'asc'
    }
  }
}
  }

  block profitability_trend: VizBlock {
    label: 'Profitability Trend'
    description: 'Gross Profit in dollars and Gross Margin as a share of Net Sales.'
    viz: CombinationChart {
  dataset: thelook
  x_axis: VizFieldFull {
    ref: r(thelook_order_items.created_at)
    transformation: 'datetrunc month'
    label: 'Order Item Month'
    format {
      type: 'date'
      pattern: 'LLL yyyy'
    }
  }
  y_axis {
    label: 'Gross Profit'
    series {
      mark_type: 'column'
      field: VizFieldFull {
        ref: r(thelook.gross_profit)
        label: 'Gross Profit'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
    settings {
      alignment: 'left'
    }
  }
  y_axis {
    label: 'Gross Margin'
    series {
      mark_type: 'line'
      field: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
    settings {
      alignment: 'right'
    }
  }
  settings {
    legend_label: 'top'
    show_data_points: true
    sort: LineFamilySort {
      type: 'xaxis'
      direction: 'asc'
    }
  }
}
  }

  block category_sales: VizBlock {
    label: 'Category Net Sales'
    description: 'Ranked category contribution to Net Sales.'
    viz: CombinationChart {
  dataset: thelook
  x_axis: VizFieldFull {
    ref: r(thelook_products.category)
    label: 'Product Category'
  }
  y_axis {
    series {
      mark_type: 'bar'
      field: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }
  settings {
    sort: LineFamilySort {
      type: 'yaxis'
      field_index: 0
      direction: 'desc'
    }
  }
}
  }

  block return_rate_by_category: VizBlock {
    label: 'Return Risk by Category'
    description: 'Returned items as a share of all order items, ranked from highest to lowest.'
    viz: CombinationChart {
  dataset: thelook
  x_axis: VizFieldFull {
    ref: r(thelook_products.category)
    label: 'Product Category'
  }
  y_axis {
    label: 'Return Rate'
    series {
      mark_type: 'bar'
      field: VizFieldFull {
        ref: r(thelook.return_rate)
        label: 'Return Rate'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        color: '#B85C5C'
      }
    }
  }
  settings {
    legend_label: 'hidden'
    sort: LineFamilySort {
      type: 'yaxis'
      field_index: 0
      direction: 'desc'
    }
  }
}
  }

  block category_detail: VizBlock {
    label: 'Category Detail'
    description: 'Net Sales, profitability, volume, and return-rate detail by product category.'
    viz: DataTable {
  dataset: thelook
  fields: [
    VizFieldFull {
      label: 'Product Category'
      ref: r(thelook_products.category)
      format {
        type: 'text'
      }
    },
    VizFieldFull {
      label: 'Net Sales'
      ref: r(thelook.net_sales)
      format {
        type: 'number'
        pattern: 'inherited'
      }
      uname: 'net_sales'
    },
    VizFieldFull {
      label: 'Gross Profit'
      ref: r(thelook.gross_profit)
      format {
        type: 'number'
        pattern: 'inherited'
      }
    },
    VizFieldFull {
      label: 'Gross Margin'
      ref: r(thelook.gross_margin)
      format {
        type: 'number'
        pattern: 'inherited'
      }
    },
    VizFieldFull {
      label: 'Items Sold'
      ref: r(thelook.items_sold)
      format {
        type: 'number'
        pattern: 'inherited'
      }
    },
    VizFieldFull {
      label: 'Return Rate'
      ref: r(thelook.return_rate)
      format {
        type: 'number'
        pattern: 'inherited'
      }
    }
  ]
  settings {
    pagination_size: 100
    show_row_number: true
    sorts: [
      KeyBasedSortSetting {
        key: 'net_sales'
        direction: 'desc'
      }
    ]
    wrap_header_text: true
    single_cell_display: 'normal'
  }
}
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'date_filter'
      to: [
        'kpi_net_sales',
        'kpi_gross_profit',
        'kpi_gross_margin',
        'kpi_fulfilled_orders',
        'kpi_aov',
        'kpi_return_rate',
        'sales_trend',
        'profitability_trend',
        'category_sales',
        'return_rate_by_category',
        'category_detail'
      ]
      field: r(thelook_order_items.created_at)
    }
  ]

  view: HTMLLayout {
    content: @html
      <style>
        :root {
          --ink: #14212b;
          --slate: #5a6973;
          --paper: #f6f7f4;
          --surface: #ffffff;
          --rule: #d8dedb;
          --sales: #176b70;
          --sales-pale: #e7f1ef;
          --risk: #b85c5c;
          --risk-pale: #f8eded;
        }

        .ceo-review {
          box-sizing: border-box;
          max-width: 1560px;
          margin: 0 auto;
          padding: 28px;
          color: var(--ink);
          background: var(--paper);
          font-family: Georgia, 'Times New Roman', serif;
        }

        .review-header {
          display: grid;
          grid-template-columns: minmax(0, 1fr) minmax(250px, 360px);
          gap: 28px;
          align-items: end;
          padding: 30px 0 25px;
          border-top: 7px solid var(--sales);
          border-bottom: 1px solid var(--ink);
        }

        .review-title h1 {
          margin: 0;
          font-size: clamp(2rem, 4vw, 3.8rem);
          line-height: .98;
          letter-spacing: -.045em;
          font-weight: 600;
        }

        .review-kicker, .section-label {
          margin: 0 0 10px;
          color: var(--sales);
          font-family: Arial, Helvetica, sans-serif;
          font-size: .72rem;
          font-weight: 700;
          letter-spacing: .12em;
          text-transform: uppercase;
        }

        .review-deck {
          max-width: 700px;
          margin: 16px 0 0;
          color: var(--slate);
          font-size: 1.04rem;
          line-height: 1.5;
        }

        .period-control {
          padding: 14px 16px 6px;
          background: var(--sales-pale);
          border-left: 3px solid var(--sales);
          font-family: Arial, Helvetica, sans-serif;
        }

        .scorecard {
          display: grid;
          grid-template-columns: repeat(6, minmax(150px, 1fr));
          gap: 1px;
          margin: 28px 0 42px;
          border: 1px solid var(--rule);
          background: var(--rule);
        }

        .scorecard-item {
          min-width: 0;
          padding: 18px 16px 12px;
          background: var(--surface);
        }

        .scorecard-item:first-child { border-top: 4px solid var(--sales); }
        .scorecard-item.risk { border-top: 4px solid var(--risk); background: var(--risk-pale); }

        .section-heading {
          display: flex;
          justify-content: space-between;
          align-items: baseline;
          gap: 16px;
          margin: 0 0 14px;
          padding-bottom: 10px;
          border-bottom: 1px solid var(--rule);
        }

        .section-heading h2 {
          margin: 0;
          font-size: 1.35rem;
          letter-spacing: -.02em;
          font-weight: 600;
        }

        .section-heading p { margin: 0; color: var(--slate); font-size: .92rem; }

        .trend-grid, .drivers-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
        .trend-grid { margin-bottom: 44px; }
        .drivers-grid { margin-bottom: 44px; }

        .chart-panel, .detail-panel {
          min-width: 0;
          padding: 4px 0 0;
          background: var(--surface);
        }

        .risk-panel { border-top: 3px solid var(--risk); }
        .detail-section { margin-top: 4px; }

        @media (max-width: 1180px) {
          .scorecard { grid-template-columns: repeat(3, minmax(180px, 1fr)); }
        }

        @media (max-width: 760px) {
          .ceo-review { padding: 16px; }
          .review-header, .trend-grid, .drivers-grid { grid-template-columns: 1fr; }
          .review-header { gap: 20px; padding-top: 22px; }
          .scorecard { grid-template-columns: repeat(2, minmax(0, 1fr)); }
          .section-heading { display: block; }
          .section-heading p { margin-top: 5px; }
        }

        @media (max-width: 420px) {
          .scorecard { grid-template-columns: 1fr; }
        }
      </style>

      <main class="ceo-review">
        <header class="review-header">
          <div><h-block name="title" /></div>
          <aside class="period-control"><h-block name="date_filter" /></aside>
        </header>

        <section class="scorecard" aria-label="Executive scorecard">
          <div class="scorecard-item"><h-block name="kpi_net_sales" /></div>
          <div class="scorecard-item"><h-block name="kpi_gross_profit" /></div>
          <div class="scorecard-item"><h-block name="kpi_gross_margin" /></div>
          <div class="scorecard-item"><h-block name="kpi_fulfilled_orders" /></div>
          <div class="scorecard-item"><h-block name="kpi_aov" /></div>
          <div class="scorecard-item risk"><h-block name="kpi_return_rate" /></div>
        </section>

        <section>
          <div class="section-heading">
            <div><p class="section-label">Performance over time</p><h2>Is growth translating into profit?</h2></div>
            <p>Monthly trend by order-item creation date</p>
          </div>
          <div class="trend-grid">
            <div class="chart-panel"><h-block name="sales_trend" /></div>
            <div class="chart-panel"><h-block name="profitability_trend" /></div>
          </div>
        </section>

        <section>
          <div class="section-heading">
            <div><p class="section-label">Category portfolio</p><h2>Where are value and return risk concentrated?</h2></div>
            <p>Ranked from highest to lowest</p>
          </div>
          <div class="drivers-grid">
            <div class="chart-panel"><h-block name="category_sales" /></div>
            <div class="chart-panel risk-panel"><h-block name="return_rate_by_category" /></div>
          </div>
        </section>

        <section class="detail-section">
          <div class="section-heading">
            <div><p class="section-label">Decision detail</p><h2>Category financial and risk ledger</h2></div>
            <p>Use the reporting-period control to focus the review</p>
          </div>
          <div class="detail-panel"><h-block name="category_detail" /></div>
        </section>
      </main>
    ;;
  }
}
