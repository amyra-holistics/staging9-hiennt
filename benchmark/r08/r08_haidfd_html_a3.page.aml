Dashboard r08_haidfd_html_a3 {
  title: 'CEO Monthly Sales Review'
  description: @md
A monthly trading-desk review for CEO decisions. Net Sales, Gross Profit, Gross Margin, Fulfilled Orders, and AOV exclude Cancelled and Returned order items; Return Rate is calculated across all items.
  ;;

  block title: TextBlock {
    content: @md
<div class="masthead">
  <div>
    <p class="kicker">CEO trading desk</p>
    <h1>Monthly sales review</h1>
    <p class="dek">Read the run-rate, isolate portfolio mix, and move from headline value to category and brand detail.</p>
  </div>
  <div class="method-note"><strong>Metric note</strong><br />Net Sales, Gross Profit, Gross Margin, Fulfilled Orders, and AOV exclude Cancelled and Returned items.</div>
</div>
    ;;
  }

  block f_sales_date: FilterBlock {
    label: 'Sales date'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block f_market: FilterBlock {
    label: 'Market'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.country)
    }
    settings { input_type: 'multiple' }
  }

  block f_department: FilterBlock {
    label: 'Department'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.department)
    }
    settings { input_type: 'multiple' }
  }

  block p_month_comparison: PopBlock {
    label: 'Compare to'
    default {
      type: 'relative'
      duration: 1
      granularity: 'month'
      show_growth_rate: true
    }
  }

  block f_category: FilterBlock {
    label: 'Category'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.category)
    }
    settings { input_type: 'multiple' }
  }

  block f_brand: FilterBlock {
    label: 'Brand'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.brand)
    }
    settings { input_type: 'multiple' }
  }

  block f_status: FilterBlock {
    label: 'Status'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.status)
    }
    settings { input_type: 'multiple' }
  }

  block d_time_grain: DateDrillBlock {
    label: 'Time grain'
    default: 'month'
  }

  block kpi_net_sales: VizBlock {
    label: 'Net Sales'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.net_sales)
    label: 'Net Sales'
    format {
      type: 'number'
      pattern: 'inherited'
    }
    uname: 'custom_net_sales_1'
  }
  settings {
    display_mode: 'single'
  }
}
  }

  block kpi_gross_profit: VizBlock {
    label: 'Gross Profit'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.gross_profit)
    label: 'Gross Profit'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
}
  }

  block kpi_gross_margin: VizBlock {
    label: 'Gross Margin'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.gross_margin)
    label: 'Gross Margin'
    format {
      type: 'number'
      pattern: '#,###0.0%'
    }
  }
  settings {
    display_mode: 'single'
  }
}
  }

  block kpi_fulfilled_orders: VizBlock {
    label: 'Fulfilled Orders'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.fulfilled_orders)
    label: 'Fulfilled Orders'
    format {
      type: 'number'
      pattern: '#,###0'
    }
  }
  settings {
    display_mode: 'single'
  }
}
  }

  block kpi_aov: VizBlock {
    label: 'AOV'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.aov)
    label: 'AOV'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
}
  }

  block kpi_return_rate: VizBlock {
    label: 'Return Rate'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.return_rate)
    label: 'Return Rate'
    format {
      type: 'number'
      pattern: '#,###0.0%'
    }
  }
  settings {
    display_mode: 'single'
    alignment: 'center'
  }
}
  }

  block v_sales_trend: VizBlock {
    label: 'Monthly Net Sales and Gross Profit'
    viz: CombinationChart {
  dataset: thelook
  x_axis: VizFieldFull {
    ref: r(thelook_order_items.created_at)
    transformation: 'datetrunc month'
    format {
      type: 'date'
      pattern: 'LLL yyyy'
    }
  }
  y_axis {
    series {
      mark_type: 'line'
      field: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
    series {
      mark_type: 'line'
      field: VizFieldFull {
        ref: r(thelook.gross_profit)
        label: 'Gross Profit'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }
  settings {
    legend_label: 'top'
    sort: LineFamilySort {
      type: 'xaxis'
      direction: 'asc'
    }
  }
}
  }

  block v_department_sales: VizBlock {
    label: 'Net Sales by Department'
    viz: CombinationChart {
  dataset: thelook
  x_axis: VizFieldFull {
    ref: r(thelook_products.department)
    label: 'Product Department'
  }
  y_axis {
    series {
      mark_type: 'bar'
      field: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }
  settings {
    sort: LineFamilySort {
      type: 'yaxis'
      field_index: 0
      direction: 'desc'
    }
  }
}
  }

  block v_category_brand_detail: VizBlock {
    label: 'Category and Brand Detail'
    viz: DataTable {
  dataset: thelook
  fields: [
    VizFieldFull {
      ref: r(thelook_products.category)
      label: 'Category'
      format {
        type: 'text'
      }
    },
    VizFieldFull {
      ref: r(thelook_products.brand)
      label: 'Brand'
      format {
        type: 'text'
      }
    },
    VizFieldFull {
      ref: r(thelook.net_sales)
      label: 'Net Sales'
      format {
        type: 'number'
        pattern: 'inherited'
      }
    },
    VizFieldFull {
      ref: r(thelook.gross_profit)
      label: 'Gross Profit'
      format {
        type: 'number'
        pattern: 'inherited'
      }
    },
    VizFieldFull {
      ref: r(thelook.gross_margin)
      label: 'Gross Margin'
      format {
        type: 'number'
        pattern: 'inherited'
      }
    },
    VizFieldFull {
      ref: r(thelook.fulfilled_orders)
      label: 'Fulfilled Orders'
      format {
        type: 'number'
        pattern: 'inherited'
      }
    },
    VizFieldFull {
      ref: r(thelook.aov)
      label: 'AOV'
      format {
        type: 'number'
        pattern: 'inherited'
      }
    },
    VizFieldFull {
      ref: r(thelook.items_sold)
      label: 'Items Sold'
      format {
        type: 'number'
        pattern: 'inherited'
      }
    },
    VizFieldFull {
      ref: r(thelook.return_rate)
      label: 'Return Rate'
      format {
        type: 'number'
        pattern: 'inherited'
      }
    },
  ]
  settings {
    pagination_size: 100
    show_row_number: true
    wrap_header_text: true
    sorts: [
      IndexBasedSortSetting {
        field_index: 2
        direction: 'desc'
      },
      IndexBasedSortSetting {
        field_index: 0
        direction: 'asc'
      },
      IndexBasedSortSetting {
        field_index: 1
        direction: 'asc'
      },
    ]
  }
}
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'f_sales_date'
      to: ['kpi_net_sales', 'kpi_gross_profit', 'kpi_gross_margin', 'kpi_fulfilled_orders', 'kpi_aov', 'kpi_return_rate', 'v_sales_trend', 'v_department_sales', 'v_category_brand_detail']
      field: r(thelook_order_items.created_at)
    },
    FilterInteraction {
      from: 'f_market'
      to: ['kpi_net_sales', 'kpi_gross_profit', 'kpi_gross_margin', 'kpi_fulfilled_orders', 'kpi_aov', 'kpi_return_rate', 'v_sales_trend', 'v_department_sales', 'v_category_brand_detail']
      field: r(thelook_users.country)
    },
    FilterInteraction {
      from: 'f_department'
      to: ['kpi_net_sales', 'kpi_gross_profit', 'kpi_gross_margin', 'kpi_fulfilled_orders', 'kpi_aov', 'kpi_return_rate', 'v_sales_trend', 'v_department_sales', 'v_category_brand_detail']
      field: r(thelook_products.department)
    },
    FilterInteraction {
      from: 'f_category'
      to: ['kpi_net_sales', 'kpi_gross_profit', 'kpi_gross_margin', 'kpi_fulfilled_orders', 'kpi_aov', 'kpi_return_rate', 'v_sales_trend', 'v_department_sales', 'v_category_brand_detail']
      field: r(thelook_products.category)
    },
    FilterInteraction {
      from: 'f_brand'
      to: ['kpi_net_sales', 'kpi_gross_profit', 'kpi_gross_margin', 'kpi_fulfilled_orders', 'kpi_aov', 'kpi_return_rate', 'v_sales_trend', 'v_department_sales', 'v_category_brand_detail']
      field: r(thelook_products.brand)
    },
    FilterInteraction {
      from: 'f_status'
      to: ['kpi_net_sales', 'kpi_gross_profit', 'kpi_gross_margin', 'kpi_fulfilled_orders', 'kpi_aov', 'kpi_return_rate', 'v_sales_trend', 'v_department_sales', 'v_category_brand_detail']
      field: r(thelook_order_items.status)
    },
    DateDrillInteraction {
      from: 'd_time_grain'
      to: ['v_sales_trend']
      field: r(thelook_order_items.created_at)
    },
    PopInteraction {
      from: 'p_month_comparison'
      to: ['kpi_net_sales', 'kpi_gross_profit', 'kpi_gross_margin', 'kpi_fulfilled_orders', 'kpi_aov', 'kpi_return_rate', 'v_sales_trend']
      field: r(thelook_order_items.created_at)
    }
  ]

  view: HTMLLayout {
    content: @html
<style>
  :root {
    --ink: #10231f;
    --paper: #f5f3eb;
    --panel: #fffefa;
    --line: #cad0c4;
    --fern: #2f6656;
    --signal: #ef6c39;
    --brass: #a8863d;
    --mist: #dfe8df;
  }
  .trading-desk {
    box-sizing: border-box;
    max-width: 1600px;
    margin: 0 auto;
    padding: 18px;
    color: var(--ink);
    background: var(--paper);
    font-family: Georgia, 'Times New Roman', serif;
  }
  .trading-desk * { box-sizing: border-box; }
  .masthead {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 32px;
    padding: 28px 0 24px;
    border-top: 8px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }
  .kicker { margin: 0 0 10px; color: var(--fern); font: 700 11px/1.2 Arial, sans-serif; letter-spacing: .16em; text-transform: uppercase; }
  .masthead h1 { margin: 0; font-size: clamp(34px, 5vw, 62px); font-weight: 500; letter-spacing: -.045em; line-height: .92; }
  .dek { max-width: 660px; margin: 14px 0 0; font-size: 17px; line-height: 1.35; }
  .method-note { max-width: 290px; padding: 12px 0 0 16px; border-left: 4px solid var(--signal); font: 13px/1.45 Arial, sans-serif; }
  .method-note strong { color: var(--signal); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; }
  .control-ribbon { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; padding: 16px 0; border-bottom: 1px solid var(--line); }
  .control { min-width: 0; padding: 8px; background: var(--panel); border: 1px solid var(--line); }
  .control:nth-child(4) { border-color: var(--brass); background: #fff9e9; }
  .desk-section { margin-top: 30px; }
  .section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin-bottom: 12px; border-bottom: 2px solid var(--ink); }
  .section-head h2 { margin: 0; padding-bottom: 7px; font-size: 22px; font-weight: 500; letter-spacing: -.02em; }
  .section-head span { color: var(--fern); font: 700 10px/1 Arial, sans-serif; letter-spacing: .13em; text-transform: uppercase; white-space: nowrap; }
  .scorecard { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 10px; }
  .scorecard .tile { min-width: 0; min-height: 152px; padding: 4px; background: var(--panel); border-top: 4px solid var(--fern); border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); border-left: 1px solid var(--line); }
  .scorecard .tile:nth-child(3), .scorecard .tile:nth-child(6) { border-top-color: var(--signal); }
  .analysis-grid { display: grid; grid-template-columns: minmax(0, 1.72fr) minmax(300px, .88fr); gap: 16px; }
  .analysis-card, .detail-card { min-width: 0; padding: 12px; background: var(--panel); border: 1px solid var(--line); box-shadow: 5px 5px 0 var(--mist); }
  .detail-card { overflow-x: auto; }
  @media (max-width: 1150px) { .control-ribbon { grid-template-columns: repeat(3, minmax(0, 1fr)); } .scorecard { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 760px) { .trading-desk { padding: 12px; } .masthead { align-items: start; flex-direction: column; gap: 16px; } .control-ribbon, .scorecard, .analysis-grid { grid-template-columns: 1fr; } .method-note { max-width: none; } }
</style>
<main class="trading-desk">
  <h-block name="title" />

  <section class="control-ribbon" aria-label="Review controls">
    <div class="control"><h-block name="f_sales_date" /></div>
    <div class="control"><h-block name="f_market" /></div>
    <div class="control"><h-block name="f_department" /></div>
    <div class="control"><h-block name="p_month_comparison" /></div>
    <div class="control"><h-block name="f_category" /></div>
    <div class="control"><h-block name="f_brand" /></div>
    <div class="control"><h-block name="f_status" /></div>
    <div class="control"><h-block name="d_time_grain" /></div>
  </section>

  <section class="desk-section">
    <div class="section-head"><h2>Scorecard</h2><span>Value, volume and quality</span></div>
    <div class="scorecard">
      <div class="tile"><h-block name="kpi_net_sales" /></div>
      <div class="tile"><h-block name="kpi_gross_profit" /></div>
      <div class="tile"><h-block name="kpi_gross_margin" /></div>
      <div class="tile"><h-block name="kpi_fulfilled_orders" /></div>
      <div class="tile"><h-block name="kpi_aov" /></div>
      <div class="tile"><h-block name="kpi_return_rate" /></div>
    </div>
  </section>

  <section class="desk-section">
    <div class="section-head"><h2>Trading view</h2><span>Trend and department mix</span></div>
    <div class="analysis-grid">
      <div class="analysis-card"><h-block name="v_sales_trend" /></div>
      <div class="analysis-card"><h-block name="v_department_sales" /></div>
    </div>
  </section>

  <section class="desk-section">
    <div class="section-head"><h2>Portfolio detail</h2><span>Category and brand drill-down</span></div>
    <div class="detail-card"><h-block name="v_category_brand_detail" /></div>
  </section>
</main>
    ;;
  }
}
