Dashboard r11_claude_canvas_a1 {
  title: 'Sales Performance FY2026'
  description: 'Replica of the Power BI "Sales Performance FY2026" report, built on TheLook eCommerce. Revenue = Net Sales (excludes Cancelled and Returned items).'

  // ---------- Header & sidebar ----------
  block title: TextBlock {
    content: @md ## Sales Performance FY2026 ;;
    theme {
      background {
        bg_color: '#FFFFFF'
      }
      border {
        border_width: 0
      }
    }
  }

  block filters_header: TextBlock {
    content: @md **Filters** ;;
    theme {
      background {
        bg_color: 'transparent'
      }
      border {
        border_width: 0
      }
      shadow: 'none'
    }
  }

  block f_year: FilterBlock {
    label: 'Fiscal Year'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
    default {
      operator: 'matches'
      value: '2026'
    }
  }

  block f_region: FilterBlock {
    label: 'Region'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.country)
    }
    settings {
      input_type: 'multiple'
    }
  }

  block f_channel: FilterBlock {
    label: 'Channel'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.traffic_source)
    }
    settings {
      input_type: 'multiple'
    }
  }

  block f_segment: FilterBlock {
    label: 'Customer Segment'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.department)
    }
    settings {
      input_type: 'single'
    }
  }

  // ---------- KPI cards ----------
  block kpi_revenue: VizBlock {
    label: 'Total Revenue'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Total Revenue'
        format {
          type: 'number'
          pattern: '[$$]#,###0.00,,"M"'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        value: RelativePopValue {
          duration: 1
          granularity: 'year'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        metric_value {
          font_size: 32
        }
      }
    }
  }

  block kpi_orders: VizBlock {
    label: 'Orders'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        label: 'Orders'
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        value: RelativePopValue {
          duration: 1
          granularity: 'year'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        metric_value {
          font_size: 32
        }
      }
    }
  }

  block kpi_aov: VizBlock {
    label: 'Avg Order Value'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Avg Order Value'
        format {
          type: 'number'
          pattern: '[$$]#,###0'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        value: RelativePopValue {
          duration: 1
          granularity: 'year'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        metric_value {
          font_size: 32
        }
      }
    }
  }

  block kpi_margin: VizBlock {
    label: 'Gross Margin'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: '#,###0.0%'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        value: RelativePopValue {
          duration: 1
          granularity: 'year'
        }
      }
      settings {
        display_mode: 'compare_by_number'
        alignment: 'left'
        metric_value {
          font_size: 32
        }
      }
    }
  }

  // ---------- Charts ----------
  block revenue_margin_month: VizBlock {
    label: 'Revenue & Gross Margin % by Month'
    description: 'Revenue ($) • Margin %'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL'
        }
      }
      y_axis {
        label: 'Revenue'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Revenue'
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
          settings {
            color: '#118DFF'
          }
        }
        settings {
          alignment: 'left'
        }
      }
      y_axis {
        label: 'Gross Margin %'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.gross_margin)
            label: 'Gross Margin %'
            format {
              type: 'number'
              pattern: '#,###0.0%'
            }
          }
          settings {
            color: '#E66C37'
          }
        }
        settings {
          alignment: 'right'
        }
      }
      settings {
        legend_label: 'top'
        show_data_points: true
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
        row_limit: 5000
      }
    }
  }

  block revenue_by_category: VizBlock {
    label: 'Revenue by Product Category'
    viz: PieChart {
      dataset: thelook
      legend: VizFieldFull {
        ref: r(thelook_products.category)
        format {
          type: 'text'
        }
      }
      series {
        field: VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Revenue'
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
        }
      }
      settings {
        display_as_donut: true
        legend_label: 'right'
        show_data_label: false
        show_percentage: true
        data_label_position: 'inside'
        group_values_into: 6
        sort: 'desc'
        row_limit: 5000
      }
    }
  }

  block top_products: VizBlock {
    label: 'Top 8 Products by Revenue'
    description: 'Revenue ($)'
    viz: BarChart {
      dataset: thelook
      filter {
        field: r(thelook_products.name)
        operator: 'top'
        value: 8
        options {
          rank_by {
            field: r(thelook.net_sales)
          }
        }
      }
      x_axis: VizFieldFull {
        ref: r(thelook_products.name)
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Revenue'
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
          settings {
            color: '#118DFF'
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      settings {
        legend_label: 'hidden'
        sort: LineFamilySort {
          type: 'yaxis'
          direction: 'desc'
        }
        row_limit: 8
      }
    }
  }

  block regional_performance: VizBlock {
    label: 'Regional Performance'
    viz: DataTable {
      dataset: thelook
      calculation yoy_pct {
        label: 'YoY %'
        formula: @aql safe_divide(
          net_sales - (net_sales | relative_period(thelook_order_items.created_at, interval(-1 year))),
          net_sales | relative_period(thelook_order_items.created_at, interval(-1 year))
        ) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      fields: [
        VizFieldFull {
          ref: r(thelook_users.country)
          label: 'Region'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Revenue'
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
        },
        VizFieldFull {
          ref: r(thelook.fulfilled_orders)
          label: 'Orders'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: r(thelook.aov)
          label: 'AOV'
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
        },
        VizFieldFull {
          ref: 'yoy_pct'
          label: 'YoY %'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        }
      ]
      settings {
        show_row_number: false
        sorts: [
          IndexBasedSortSetting {
            field_index: 1
            direction: 'desc'
          }
        ]
        conditional_formats: [
          ConditionalFormat {
            ref: r(thelook.net_sales)
            format: ScaleFormat {
              min {
                type: 'percentage'
                value: 0
                color: '#FFFFFF'
              }
              max {
                type: 'percentage'
                value: 100
                color: '#C6E2FF'
              }
            }
          },
          ConditionalFormat {
            ref: 'yoy_pct'
            format: SingleFormat {
              condition {
                operator: 'greater_than_equal'
                value: 0
              }
              text_color: '#107C10'
              background_color: 'transparent'
            }
          },
          ConditionalFormat {
            ref: 'yoy_pct'
            format: SingleFormat {
              condition {
                operator: 'less_than'
                value: 0
              }
              text_color: '#D13438'
              background_color: 'transparent'
            }
          }
        ]
        row_limit: 5000
      }
      theme {
        table {
          general {
            banding_color: '#FAFAFA'
          }
          header {
            bg_color: '#F3F2F1'
            font_weight: 'semibold'
          }
        }
      }
    }
  }

  view: CanvasLayout {
    label: 'Sales Performance'
    width: 1600
    height: 1000
    grid_size: 10
    auto_expand_vertically: true

    // header bar
    block title {
      position: pos(0, 0, 1600, 50)
    }

    // left filter pane
    block filters_header {
      position: pos(10, 60, 180, 40)
    }
    block f_year {
      position: pos(10, 100, 180, 80)
    }
    block f_region {
      position: pos(10, 190, 180, 80)
    }
    block f_channel {
      position: pos(10, 280, 180, 80)
    }
    block f_segment {
      position: pos(10, 370, 180, 80)
    }

    // KPI row
    block kpi_revenue {
      position: pos(210, 60, 330, 110)
    }
    block kpi_orders {
      position: pos(555, 60, 330, 110)
    }
    block kpi_aov {
      position: pos(900, 60, 330, 110)
    }
    block kpi_margin {
      position: pos(1245, 60, 335, 110)
    }

    // middle row
    block revenue_margin_month {
      position: pos(210, 180, 850, 360)
    }
    block revenue_by_category {
      position: pos(1070, 180, 510, 360)
    }

    // bottom row
    block top_products {
      position: pos(210, 550, 630, 400)
    }
    block regional_performance {
      position: pos(850, 550, 730, 400)
    }

    mobile {
      mode: 'auto'
    }
  }

  theme: PageTheme {
    background {
      bg_color: '#F3F2F1'
    }
    canvas {
      background {
        bg_color: '#F3F2F1'
      }
    }
    block {
      background {
        bg_color: '#FFFFFF'
      }
      border {
        border_width: 1
        border_color: '#E1DFDD'
        border_radius: 2
      }
      padding: 12
      shadow: 'sm'
    }
  }
}
