Dashboard r11_claude_canvas_a2 {
  title: 'Sales Performance FY2026'
  description: 'Replica of the Power BI "Sales Performance FY2026" report, built on TheLook eCommerce. Region = customer country, Channel = traffic source, Customer Segment = customer gender. Revenue = Net Sales.'

  // ---------- Header & sidebar ----------
  block t_header: TextBlock {
    content: @md ## Sales Performance FY2026 ;;
    theme {
      background { bg_color: '#FFFFFF' }
      border { border_width: 0 }
    }
  }

  block t_sidebar: TextBlock {
    content: @md #### Filters ;;
    theme {
      background { bg_color: '#FFFFFF' }
      border {
        border_width: 0
        border_radius: 0
      }
    }
  }

  // ---------- Filters ----------
  block f_year: FilterBlock {
    label: 'Fiscal Year'
    type: 'date'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
    default {
      operator: 'matches'
      value: '2026'
    }
  }

  block f_region: FilterBlock {
    label: 'Region'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.country)
    }
    settings {
      input_type: 'multiple'
    }
  }

  block f_channel: FilterBlock {
    label: 'Channel'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.traffic_source)
    }
    settings {
      input_type: 'multiple'
    }
  }

  block f_segment: FilterBlock {
    label: 'Customer Segment'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.gender)
    }
    settings {
      input_type: 'nullable-single'
    }
  }

  // ---------- KPI cards ----------
  block v_kpi_revenue: VizBlock {
    label: 'Total Revenue'
    viz: MetricKpi {
      dataset: thelook
      calculation revenue_ly {
        label: 'Revenue LY'
        formula: @aql net_sales | relative_period(thelook_order_items.created_at, interval(-1 year)) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Total Revenue'
        format {
          type: 'number'
          pattern: '[$$]#,###0.00,,"M"'
        }
      }
      compare_value: VizFieldFull {
        ref: 'revenue_ly'
        label: 'vs LY'
        format {
          type: 'number'
          pattern: '[$$]#,###0'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        metric_value { font_size: 32 }
      }
    }
    settings { hide_label: true }
  }

  block v_kpi_orders: VizBlock {
    label: 'Orders'
    viz: MetricKpi {
      dataset: thelook
      calculation orders_ly {
        label: 'Orders LY'
        formula: @aql fulfilled_orders | relative_period(thelook_order_items.created_at, interval(-1 year)) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        label: 'Orders'
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      compare_value: VizFieldFull {
        ref: 'orders_ly'
        label: 'vs LY'
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        metric_value { font_size: 32 }
      }
    }
    settings { hide_label: true }
  }

  block v_kpi_aov: VizBlock {
    label: 'Avg Order Value'
    viz: MetricKpi {
      dataset: thelook
      calculation aov_ly {
        label: 'AOV LY'
        formula: @aql aov | relative_period(thelook_order_items.created_at, interval(-1 year)) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Avg Order Value'
        format {
          type: 'number'
          pattern: '[$$]#,###0'
        }
      }
      compare_value: VizFieldFull {
        ref: 'aov_ly'
        label: 'vs LY'
        format {
          type: 'number'
          pattern: '[$$]#,###0'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        metric_value { font_size: 32 }
      }
    }
    settings { hide_label: true }
  }

  block v_kpi_margin: VizBlock {
    label: 'Gross Margin'
    viz: MetricKpi {
      dataset: thelook
      calculation margin_ly {
        label: 'Gross Margin LY'
        formula: @aql gross_margin | relative_period(thelook_order_items.created_at, interval(-1 year)) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: '#,###0.0%'
        }
      }
      compare_value: VizFieldFull {
        ref: 'margin_ly'
        label: 'vs LY'
        format {
          type: 'number'
          pattern: '#,###0.0%'
        }
      }
      settings {
        display_mode: 'compare_by_number'
        alignment: 'left'
        metric_value { font_size: 32 }
      }
    }
    settings { hide_label: true }
  }

  // ---------- Charts ----------
  block v_monthly: VizBlock {
    label: 'Revenue & Gross Margin % by Month'
    description: 'Revenue ($) • Margin %'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        label: 'Month'
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL'
        }
      }
      y_axis {
        label: 'Revenue'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Revenue'
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
          settings {
            color: '#118DFF'
          }
        }
        settings {
          alignment: 'left'
        }
      }
      y_axis {
        label: 'Gross Margin %'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.gross_margin)
            label: 'Gross Margin %'
            format {
              type: 'number'
              pattern: '#,###0.0%'
            }
          }
          settings {
            color: '#E66C37'
          }
        }
        settings {
          alignment: 'right'
        }
      }
      settings {
        legend_label: 'top'
        show_data_points: true
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
        row_limit: 100
      }
    }
  }

  block v_category: VizBlock {
    label: 'Revenue by Product Category'
    viz: PieChart {
      dataset: thelook
      legend: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Category'
        format {
          type: 'text'
        }
      }
      series {
        field: VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Revenue'
          format {
            type: 'number'
            pattern: '[$$]#,###0.0,"K"'
          }
        }
      }
      settings {
        display_as_donut: true
        legend_label: 'right'
        show_data_label: true
        show_percentage: true
        data_label_position: 'inside'
        group_values_into: 5
        sort: 'desc'
      }
    }
  }

  block v_top_products: VizBlock {
    label: 'Top 8 Products by Revenue'
    description: 'Revenue ($)'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.name)
        label: 'Product'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Revenue'
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
          settings {
            color: '#118DFF'
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      filter {
        field: r(thelook_products.name)
        operator: 'top'
        value: 8
        options {
          rank_by {
            field: r(thelook.net_sales)
          }
        }
      }
      settings {
        legend_label: 'hidden'
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block v_regional: VizBlock {
    label: 'Regional Performance'
    viz: DataTable {
      dataset: thelook
      calculation yoy {
        label: 'YoY %'
        formula: @aql safe_divide(net_sales - (net_sales | relative_period(thelook_order_items.created_at, interval(-1 year))), net_sales | relative_period(thelook_order_items.created_at, interval(-1 year))) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      fields: [
        VizFieldFull {
          ref: r(thelook_users.country)
          label: 'Region'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Revenue'
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
        },
        VizFieldFull {
          ref: r(thelook.fulfilled_orders)
          label: 'Orders'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: r(thelook.aov)
          label: 'AOV'
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
        },
        VizFieldFull {
          ref: 'yoy'
          label: 'YoY %'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        }
      ]
      settings {
        show_row_number: false
        pagination_size: 25
        sorts: [
          IndexBasedSortSetting {
            field_index: 1
            direction: 'desc'
          }
        ]
        conditional_formats: [
          ConditionalFormat {
            ref: 'yoy'
            format: SingleFormat {
              condition {
                operator: 'greater_than_equal'
                value: 0
              }
              text_color: '#1A7F37'
              background_color: 'transparent'
            }
          },
          ConditionalFormat {
            ref: 'yoy'
            format: SingleFormat {
              condition {
                operator: 'less_than'
                value: 0
              }
              text_color: '#D13438'
              background_color: 'transparent'
            }
          },
          ConditionalFormat {
            ref: r(thelook.net_sales)
            format: ScaleFormat {
              min {
                type: 'percentage'
                value: 0
                color: '#FFFFFF'
              }
              max {
                type: 'percentage'
                value: 100
                color: '#BEDCFF'
              }
            }
          }
        ]
      }
      theme {
        table {
          header {
            bg_color: '#F3F2F1'
            font_weight: 'bold'
            font_color: '#252423'
          }
          general {
            banding_color: '#FAFAFA'
            font_size: 13
          }
        }
      }
    }
  }

  // ---------- Layout ----------
  view: CanvasLayout {
    label: 'Sales Performance'
    width: 1600
    height: 960
    grid_size: 5
    auto_expand_vertically: true

    block t_header {
      position: pos(0, 0, 1600, 50)
    }
    block t_sidebar {
      position: pos(0, 55, 200, 905)
      layer: 1
    }
    block f_year {
      position: pos(10, 105, 180, 75)
      layer: 2
    }
    block f_region {
      position: pos(10, 185, 180, 75)
      layer: 2
    }
    block f_channel {
      position: pos(10, 265, 180, 75)
      layer: 2
    }
    block f_segment {
      position: pos(10, 345, 180, 75)
      layer: 2
    }

    block v_kpi_revenue {
      position: pos(215, 65, 330, 105)
    }
    block v_kpi_orders {
      position: pos(560, 65, 330, 105)
    }
    block v_kpi_aov {
      position: pos(905, 65, 330, 105)
    }
    block v_kpi_margin {
      position: pos(1250, 65, 335, 105)
    }

    block v_monthly {
      position: pos(215, 185, 840, 355)
    }
    block v_category {
      position: pos(1070, 185, 515, 355)
    }

    block v_top_products {
      position: pos(215, 555, 620, 395)
    }
    block v_regional {
      position: pos(850, 555, 735, 395)
    }

    mobile {
      mode: 'auto'
    }
  }

  theme: PageTheme {
    background {
      bg_color: '#F3F2F1'
    }
    block {
      background { bg_color: '#FFFFFF' }
      border {
        border_width: 1
        border_color: '#E1DFDD'
        border_radius: 4
      }
      padding: 12
      label {
        font_size: 15
        font_weight: 'bold'
        font_color: '#252423'
      }
    }
  }
}
