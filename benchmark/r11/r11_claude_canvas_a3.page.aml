Dashboard r11_claude_canvas_a3 {
  title: 'Sales Performance FY2026'
  description: 'Replica of the Power BI "Sales Performance FY2026" report on TheLook eCommerce. Revenue = Net Sales; Region = customer country; Channel = traffic source; Customer Segment = customer gender.'

  // ---------- Header & filter panel ----------
  block t_header: TextBlock {
    content: @md ## **Sales Performance FY2026** ;;
    theme {
      background {
        bg_color: '#FFFFFF'
      }
      border {
        border_width: 0
        border_radius: 0
      }
    }
  }

  block t_filters: TextBlock {
    content: @md **Filters** ;;
    theme {
      background {
        bg_color: '#FFFFFF'
      }
      border {
        border_width: 0
        border_radius: 0
      }
    }
  }

  block f_year: FilterBlock {
    label: 'Fiscal Year'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
    default {
      operator: 'matches'
      value: '2026-01-01 - 2026-12-31'
    }
  }

  block f_region: FilterBlock {
    label: 'Region'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.country)
    }
    settings {
      input_type: 'multiple'
    }
  }

  block f_channel: FilterBlock {
    label: 'Channel'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.traffic_source)
    }
    settings {
      input_type: 'multiple'
    }
  }

  block f_segment: FilterBlock {
    label: 'Customer Segment'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.gender)
    }
    settings {
      input_type: 'single'
    }
  }

  // ---------- KPI cards (vs same period last year) ----------
  block kpi_revenue: VizBlock {
    label: 'Total Revenue'
    viz: MetricKpi {
      dataset: thelook
      calculation net_sales_ly {
        label: 'Revenue LY'
        formula: @aql net_sales | relative_period(thelook_order_items.created_at, interval(-1 year)) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        format {
          type: 'number'
          pattern: '[$$]#,###0.00,,"M"'
        }
      }
      compare_value: VizFieldFull {
        ref: 'net_sales_ly'
        format {
          type: 'number'
          pattern: '[$$]#,###0.00,,"M"'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        metric_value {
          font_size: 32
        }
      }
    }
  }

  block kpi_orders: VizBlock {
    label: 'Orders'
    viz: MetricKpi {
      dataset: thelook
      calculation orders_ly {
        label: 'Orders LY'
        formula: @aql fulfilled_orders | relative_period(thelook_order_items.created_at, interval(-1 year)) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      compare_value: VizFieldFull {
        ref: 'orders_ly'
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        metric_value {
          font_size: 32
        }
      }
    }
  }

  block kpi_aov: VizBlock {
    label: 'Avg Order Value'
    viz: MetricKpi {
      dataset: thelook
      calculation aov_ly {
        label: 'AOV LY'
        formula: @aql aov | relative_period(thelook_order_items.created_at, interval(-1 year)) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: r(thelook.aov)
        format {
          type: 'number'
          pattern: '[$$]#,###0'
        }
      }
      compare_value: VizFieldFull {
        ref: 'aov_ly'
        format {
          type: 'number'
          pattern: '[$$]#,###0'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        metric_value {
          font_size: 32
        }
      }
    }
  }

  block kpi_margin: VizBlock {
    label: 'Gross Margin'
    viz: MetricKpi {
      dataset: thelook
      calculation gross_margin_ly {
        label: 'Gross Margin LY'
        formula: @aql gross_margin | relative_period(thelook_order_items.created_at, interval(-1 year)) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        format {
          type: 'number'
          pattern: '#,###0.0%'
        }
      }
      compare_value: VizFieldFull {
        ref: 'gross_margin_ly'
        format {
          type: 'number'
          pattern: '#,###0.0%'
        }
      }
      settings {
        display_mode: 'compare_by_number'
        alignment: 'left'
        metric_value {
          font_size: 32
        }
      }
    }
  }

  // ---------- Revenue & Gross Margin % by Month ----------
  block v_monthly: VizBlock {
    label: 'Revenue & Gross Margin % by Month'
    description: 'Revenue ($) • Margin %'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL'
        }
      }
      y_axis {
        label: 'Revenue'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Revenue'
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
          settings {
            color: '#118DFF'
          }
        }
      }
      y_axis {
        label: 'Gross Margin %'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.gross_margin)
            label: 'Gross Margin %'
            format {
              type: 'number'
              pattern: '#,###0.0%'
            }
          }
          settings {
            color: '#E66C37'
          }
        }
        settings {
          alignment: 'right'
        }
      }
      settings {
        legend_label: 'top'
        show_data_points: true
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
        row_limit: 5000
      }
    }
  }

  // ---------- Revenue by Product Category ----------
  block v_category: VizBlock {
    label: 'Revenue by Product Category'
    viz: PieChart {
      dataset: thelook
      legend: VizFieldFull {
        ref: r(thelook_products.category)
        format {
          type: 'text'
        }
      }
      series {
        field: VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Revenue'
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
        }
      }
      settings {
        display_as_donut: true
        legend_label: 'right'
        show_data_label: true
        show_percentage: true
        data_label_position: 'inside'
        group_values_into: 5
        sort: 'desc'
        row_limit: 5000
      }
    }
  }

  // ---------- Top 8 Products by Revenue ----------
  block v_top_products: VizBlock {
    label: 'Top 8 Products by Revenue'
    description: 'Revenue ($)'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.name)
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Revenue'
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
          settings {
            color: '#118DFF'
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      settings {
        legend_label: 'hidden'
        sort: LineFamilySort {
          type: 'yaxis'
          direction: 'desc'
        }
        row_limit: 8
      }
    }
  }

  // ---------- Regional Performance ----------
  block v_regional: VizBlock {
    label: 'Regional Performance'
    viz: PivotTable {
      dataset: thelook
      calculation yoy_pct {
        label: 'YoY %'
        formula: @aql safe_divide(net_sales - (net_sales | relative_period(thelook_order_items.created_at, interval(-1 year))), net_sales | relative_period(thelook_order_items.created_at, interval(-1 year))) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      rows: [
        VizFieldFull {
          ref: r(thelook_users.country)
          label: 'Region'
          format {
            type: 'text'
          }
        }
      ]
      values: [
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Revenue'
          format {
            type: 'number'
            pattern: '[$$]#,###0.00,,"M"'
          }
        },
        VizFieldFull {
          ref: r(thelook.fulfilled_orders)
          label: 'Orders'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: r(thelook.aov)
          label: 'AOV'
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
        },
        VizFieldFull {
          ref: 'yoy_pct'
          label: 'YoY %'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        }
      ]
      settings {
        show_row_total: true
        show_column_total: true
        sorts: [
          IndexBasedSortSetting {
            field_index: 1
            direction: 'desc'
          }
        ]
        conditional_formats: [
          ConditionalFormat {
            ref: r(thelook.net_sales)
            format: ScaleFormat {
              min {
                type: 'percentage'
                value: 0
                color: '#FFFFFF'
              }
              max {
                type: 'percentage'
                value: 100
                color: '#BFE0FF'
              }
            }
          },
          ConditionalFormat {
            ref: 'yoy_pct'
            format: SingleFormat {
              condition {
                operator: 'greater_than_equal'
                value: 0
              }
              text_color: '#107C10'
              background_color: 'transparent'
            }
          },
          ConditionalFormat {
            ref: 'yoy_pct'
            format: SingleFormat {
              condition {
                operator: 'less_than'
                value: 0
              }
              text_color: '#D13438'
              background_color: 'transparent'
            }
          }
        ]
        row_limit: 5000
      }
    }
  }

  view: CanvasLayout {
    label: 'Sales Performance'
    width: 1610
    height: 970
    grid_size: 10
    auto_expand_vertically: true
    theme {
      background {
        bg_color: '#F3F2F1'
      }
    }

    block t_header {
      position: pos(0, 0, 1610, 50)
    }

    block t_filters {
      position: pos(0, 60, 200, 910)
      layer: 0
    }
    block f_year {
      position: pos(10, 110, 180, 80)
      layer: 1
    }
    block f_region {
      position: pos(10, 200, 180, 80)
      layer: 1
    }
    block f_channel {
      position: pos(10, 290, 180, 80)
      layer: 1
    }
    block f_segment {
      position: pos(10, 380, 180, 80)
      layer: 1
    }

    block kpi_revenue {
      position: pos(210, 60, 340, 110)
    }
    block kpi_orders {
      position: pos(560, 60, 340, 110)
    }
    block kpi_aov {
      position: pos(910, 60, 340, 110)
    }
    block kpi_margin {
      position: pos(1260, 60, 340, 110)
    }

    block v_monthly {
      position: pos(210, 180, 840, 370)
    }
    block v_category {
      position: pos(1060, 180, 540, 370)
    }

    block v_top_products {
      position: pos(210, 560, 630, 400)
    }
    block v_regional {
      position: pos(850, 560, 750, 400)
    }

    mobile {
      mode: 'auto'
    }
  }

  theme: H.themes.vanilla
}
