Dashboard r11_claude_fd_canvas_a1 {
  title: 'Sales Performance FY2026'
  description: 'Replica of the Power BI Sales Performance report, built on TheLook eCommerce. Region = customer country, Channel = traffic source, Customer Segment = gender, Revenue = Net Sales.'

  theme: PageTheme {
    background {
      bg_color: '#F3F2F1'
    }
    canvas {
      background {
        bg_color: '#F3F2F1'
      }
    }
    block {
      background {
        bg_color: '#FFFFFF'
      }
      border {
        border_radius: 2
        border_color: '#E1DFDD'
        border_style: 'solid'
        border_width: 1
      }
    }
  }

  // ---------- Header & filter pane ----------

  block header: TextBlock {
    content: @md ## Sales Performance FY2026 ;;
  }

  block filters_title: TextBlock {
    theme: BlockTheme {
      border {
        border_width: 0
      }
    }
    content: @md **Filters** ;;
  }

  block f_year: FilterBlock {
    label: 'Fiscal Year'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_orders.created_at)
    }
    default {
      operator: 'is'
      value: '2026'
    }
  }

  block f_region: FilterBlock {
    label: 'Region'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.country)
    }
  }

  block f_channel: FilterBlock {
    label: 'Channel'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.traffic_source)
    }
  }

  block f_segment: FilterBlock {
    label: 'Customer Segment'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.gender)
    }
  }

  // ---------- KPI cards ----------

  block kpi_revenue: VizBlock {
    label: 'Total Revenue'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Total Revenue'
        format {
          type: 'number'
          pattern: '[$$]#,###0.00,,"M"'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_orders.created_at)
        show_growth_rate: true
        value {
          duration: 1
          granularity: 'year'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        compare_value {
          reverse_color: false
        }
      }
    }
  }

  block kpi_orders: VizBlock {
    label: 'Orders'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.total_orders)
        label: 'Orders'
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_orders.created_at)
        show_growth_rate: true
        value {
          duration: 1
          granularity: 'year'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        compare_value {
          reverse_color: false
        }
      }
    }
  }

  block kpi_aov: VizBlock {
    label: 'Avg Order Value'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Avg Order Value'
        format {
          type: 'number'
          pattern: '[$$]#,###0'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_orders.created_at)
        show_growth_rate: true
        value {
          duration: 1
          granularity: 'year'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        compare_value {
          reverse_color: false
        }
      }
    }
  }

  block kpi_margin: VizBlock {
    label: 'Gross Margin'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: '#,###0.0%'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_orders.created_at)
        show_growth_rate: true
        value {
          duration: 1
          granularity: 'year'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        compare_value {
          reverse_color: false
        }
      }
    }
  }

  // ---------- Charts ----------

  block revenue_margin_month: VizBlock {
    label: 'Revenue & Gross Margin % by Month'
    description: 'Revenue ($K) • Margin %'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_orders.created_at)
        label: 'Month'
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL'
        }
      }
      y_axis {
        label: 'Revenue'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Revenue'
            format {
              type: 'number'
              pattern: '[$$]#,###,"K"'
            }
          }
          settings {
            color: '#118DFF'
          }
        }
        settings {
          alignment: 'left'
        }
      }
      y_axis {
        label: 'Gross Margin %'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.gross_margin)
            label: 'Gross Margin %'
            format {
              type: 'number'
              pattern: '#,###0.0%'
            }
          }
          settings {
            color: '#E66C37'
          }
        }
        settings {
          alignment: 'right'
        }
      }
      settings {
        legend_label: 'top'
        show_data_points: true
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block revenue_by_category: VizBlock {
    label: 'Revenue by Product Category'
    viz: PieChart {
      dataset: thelook
      legend: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Category'
        format {
          type: 'text'
        }
      }
      series {
        field: VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Revenue'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      }
      settings {
        display_as_donut: true
        legend_label: 'right'
        show_data_label: true
        show_percentage: true
        data_label_position: 'inside'
        group_values_into: 5
        sort: 'desc'
      }
    }
  }

  block top_products: VizBlock {
    label: 'Top 8 Products by Revenue'
    description: 'Revenue ($)'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.name)
        label: 'Product'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Revenue'
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
          settings {
            color: '#118DFF'
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      filter {
        field: r(thelook_products.name)
        operator: 'not_null'
        value: []
      }
      settings {
        legend_label: 'hidden'
        row_limit: 8
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block regional_performance: VizBlock {
    label: 'Regional Performance'
    viz: DataTable {
      dataset: thelook
      calculation net_sales_same_period_last_year {
        label: 'Revenue LY'
        formula: @aql net_sales | relative_period(thelook_orders.created_at, interval(-1 year));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation net_sales_yoy_growth_pct {
        label: 'YoY %'
        formula: @aql safe_divide(net_sales - net_sales_same_period_last_year, net_sales_same_period_last_year);;
        calc_type: 'measure'
        data_type: 'number'
      }
      fields: [
        VizFieldFull {
          ref: r(thelook_users.country)
          label: 'Region'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Revenue'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.total_orders)
          label: 'Orders'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.aov)
          label: 'AOV'
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
        },
        VizFieldFull {
          ref: 'net_sales_yoy_growth_pct'
          label: 'YoY %'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        }
      ]
      settings {
        pagination_size: 100
        show_row_number: false
        sorts: [
          IndexBasedSortSetting {
            field_index: 1
            direction: 'desc'
          }
        ]
        conditional_formats: [
          ConditionalFormat {
            ref: r(thelook.net_sales)
            format: ScaleFormat {
              min {
                type: 'percentage'
                value: 0
                color: '#FFFFFF'
              }
              max {
                type: 'percentage'
                value: 100
                color: '#C6E1FF'
              }
            }
          },
          ConditionalFormat {
            ref: 'net_sales_yoy_growth_pct'
            format: SingleFormat {
              condition {
                operator: 'greater_than'
                value: 0
              }
              text_color: '#1AAB40'
              background_color: '#FFFFFF'
            }
          },
          ConditionalFormat {
            ref: 'net_sales_yoy_growth_pct'
            format: SingleFormat {
              condition {
                operator: 'less_than'
                value: 0
              }
              text_color: '#D64554'
              background_color: '#FFFFFF'
            }
          }
        ]
      }
    }
  }

  // ---------- Layout ----------

  view: CanvasLayout {
    label: 'Sales Performance'
    width: 1600
    height: 960

    block header {
      position: pos(0, 0, 1600, 48)
    }

    block filters_title {
      position: pos(8, 60, 192, 36)
    }
    block f_year {
      position: pos(8, 100, 192, 72)
    }
    block f_region {
      position: pos(8, 180, 192, 72)
    }
    block f_channel {
      position: pos(8, 260, 192, 72)
    }
    block f_segment {
      position: pos(8, 340, 192, 72)
    }

    block kpi_revenue {
      position: pos(216, 60, 333, 108)
    }
    block kpi_orders {
      position: pos(561, 60, 333, 108)
    }
    block kpi_aov {
      position: pos(906, 60, 333, 108)
    }
    block kpi_margin {
      position: pos(1251, 60, 333, 108)
    }

    block revenue_margin_month {
      position: pos(216, 180, 840, 360)
    }
    block revenue_by_category {
      position: pos(1068, 180, 516, 360)
    }

    block top_products {
      position: pos(216, 552, 620, 396)
    }
    block regional_performance {
      position: pos(848, 552, 736, 396)
    }
  }
}
