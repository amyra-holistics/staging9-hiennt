Dashboard r11_claude_fd_html_a3 {
  title: 'Sales Performance'
  description: '''
Replica of the Power BI "Sales Performance FY2026" report on TheLook eCommerce.

Field mapping: Region -> customer country, Channel -> customer traffic source,
Customer Segment -> customer gender, Revenue -> Net Sales, Orders -> Fulfilled Orders.
'''

  // ---------- Filters ----------
  block f_year: FilterBlock {
    label: 'Fiscal Year'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
    default {
      operator: 'matches'
      value: 'this year'
    }
  }

  block f_region: FilterBlock {
    label: 'Region'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.country)
    }
    settings {
      input_type: 'multiple'
    }
  }

  block f_channel: FilterBlock {
    label: 'Channel'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.traffic_source)
    }
    settings {
      input_type: 'multiple'
    }
  }

  block f_segment: FilterBlock {
    label: 'Customer Segment'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.gender)
    }
    settings {
      input_type: 'single'
    }
  }

  // ---------- KPI cards ----------
  block kpi_revenue: VizBlock {
    label: 'Total Revenue'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Total Revenue'
        format {
          type: 'number'
          pattern: '[$$]#,###0'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value: RelativePopValue {
          duration: 1
          granularity: 'year'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        metric_value {
          font_size: 30
          font_color: '#1F1F1F'
        }
        label {
          font_size: 13
          font_color: '#605E5C'
        }
        compare_value {
          font_size: 12
        }
      }
    }
  }

  block kpi_orders: VizBlock {
    label: 'Orders'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        label: 'Orders'
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value: RelativePopValue {
          duration: 1
          granularity: 'year'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        metric_value {
          font_size: 30
          font_color: '#1F1F1F'
        }
        label {
          font_size: 13
          font_color: '#605E5C'
        }
        compare_value {
          font_size: 12
        }
      }
    }
  }

  block kpi_aov: VizBlock {
    label: 'Avg Order Value'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Avg Order Value'
        format {
          type: 'number'
          pattern: '[$$]#,###0'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: true
        value: RelativePopValue {
          duration: 1
          granularity: 'year'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        metric_value {
          font_size: 30
          font_color: '#1F1F1F'
        }
        label {
          font_size: 13
          font_color: '#605E5C'
        }
        compare_value {
          font_size: 12
        }
      }
    }
  }

  block kpi_margin: VizBlock {
    label: 'Gross Margin'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: '#,###0.0%'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        show_growth_rate: false
        value: RelativePopValue {
          duration: 1
          granularity: 'year'
        }
      }
      settings {
        display_mode: 'compare_by_number'
        alignment: 'left'
        metric_value {
          font_size: 30
          font_color: '#1F1F1F'
        }
        label {
          font_size: 13
          font_color: '#605E5C'
        }
        compare_value {
          font_size: 12
        }
      }
    }
  }

  // ---------- Charts ----------
  block v_trend: VizBlock {
    label: 'Revenue & Gross Margin % by Month'
    description: 'Revenue ($) • Margin %'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        label: 'Month'
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL'
        }
      }
      y_axis {
        label: 'Revenue'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Revenue'
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
          settings {
            color: '#118DFF'
          }
        }
      }
      y_axis {
        label: 'Gross Margin %'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.gross_margin)
            label: 'Gross Margin %'
            format {
              type: 'number'
              pattern: '#,###0.0%'
            }
          }
          settings {
            color: '#E66C37'
          }
        }
        settings {
          alignment: 'right'
        }
      }
      settings {
        legend_label: 'top'
        show_data_points: true
        x_axis_show_null_datetime: false
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block v_category: VizBlock {
    label: 'Revenue by Product Category'
    viz: PieChart {
      dataset: thelook
      legend: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Category'
      }
      series {
        field: VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Revenue'
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
        }
      }
      settings {
        display_as_donut: true
        legend_label: 'right'
        show_data_label: true
        show_percentage: true
        data_label_position: 'inside'
        group_values_into: 6
        sort: 'desc'
      }
    }
  }

  block v_top_products: VizBlock {
    label: 'Top 8 Products by Revenue'
    description: 'Revenue ($)'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.name)
        label: 'Product'
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Revenue'
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
          settings {
            color: '#118DFF'
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      filter {
        field: r(thelook_products.name)
        operator: 'top'
        value: 8
        options {
          rank_by {
            field: r(thelook.net_sales)
          }
        }
      }
      settings {
        legend_label: 'hidden'
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block v_regions: VizBlock {
    label: 'Regional Performance'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          ref: r(thelook_users.country)
          label: 'Region'
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Revenue'
          uname: 'net_sales'
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
        },
        VizFieldFull {
          ref: r(thelook.fulfilled_orders)
          label: 'Orders'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: r(thelook.aov)
          label: 'AOV'
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'YoY %'
          uname: 'net_sales_yoy'
          analytic: PeriodOverPeriodComparison {
            time_dimension: r(thelook_order_items.created_at)
            display: 'percent_change'
            comparison_period: '1 year'
          }
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        },
      ]
      settings {
        show_sum_row: true
        pagination_size: 25
        sorts: [
          IndexBasedSortSetting {
            field_index: 1
            direction: 'desc'
          },
        ]
        conditional_formats: [
          ConditionalFormat {
            key: 'net_sales'
            format: ScaleFormat {
              min {
                type: 'percentage'
                value: 0
                color: '#FFFFFF'
              }
              max {
                type: 'percentage'
                value: 100
                color: '#C6E2FF'
              }
            }
          },
          ConditionalFormat {
            key: 'net_sales_yoy'
            format: SingleFormat {
              condition {
                operator: 'greater_than'
                value: 0
              }
              text_color: '#107C10'
              background_color: '#FFFFFF'
            }
          },
          ConditionalFormat {
            key: 'net_sales_yoy'
            format: SingleFormat {
              condition {
                operator: 'less_than'
                value: 0
              }
              text_color: '#D13438'
              background_color: '#FFFFFF'
            }
          },
        ]
      }
    }
  }

  view: HTMLLayout {
    content: @html
      <style>
        .pbi {
          font-family: 'Segoe UI', 'Segoe UI Web', Helvetica, Arial, sans-serif;
          background: #F3F2F1;
          color: #252423;
          min-height: 100%;
        }
        .pbi-top {
          display: flex;
          align-items: center;
          gap: 48px;
          height: 44px;
          padding: 0 20px;
          background: #FFFFFF;
          border-bottom: 1px solid #E1DFDD;
        }
        .pbi-top h1 {
          margin: 0;
          font-size: 17px;
          font-weight: 700;
          color: #1F1F1F;
        }
        .pbi-top .menu {
          font-size: 13px;
          color: #605E5C;
          word-spacing: 4px;
        }
        .pbi-top .mode {
          margin-left: auto;
          font-size: 11px;
          color: #605E5C;
          background: #EDEBE9;
          padding: 3px 18px;
          border-radius: 2px;
        }
        .pbi-body {
          display: grid;
          grid-template-columns: 200px minmax(0, 1fr);
        }
        .pbi-side {
          background: #FFFFFF;
          border-right: 1px solid #E1DFDD;
          padding: 16px 14px;
          display: flex;
          flex-direction: column;
          gap: 12px;
        }
        .pbi-side h2 {
          margin: 0 0 4px;
          font-size: 13px;
          font-weight: 700;
          color: #1F1F1F;
        }
        .pbi-main {
          padding: 16px;
          display: grid;
          gap: 16px;
          grid-template-columns: repeat(4, minmax(0, 1fr));
        }
        .card {
          background: #FFFFFF;
          border: 1px solid #E1DFDD;
          box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
          min-width: 0;
        }
        .kpi { height: 104px; }
        .row2 { height: 360px; }
        .row3 { height: 400px; }
        .span-2 { grid-column: span 2; }
        .split-row {
          grid-column: 1 / -1;
          display: grid;
          gap: 16px;
        }
        .split-a { grid-template-columns: 62fr 38fr; }
        .split-b { grid-template-columns: 1fr 1fr; }
        .note {
          grid-column: 1 / -1;
          font-size: 11px;
          color: #8A8886;
          margin-top: -4px;
        }
      </style>

      <div class="pbi">
        <div class="pbi-top">
          <h1>Sales Performance FY2026</h1>
          <span class="menu">File Export Share Refresh</span>
          <span class="mode">Viewing</span>
        </div>

        <div class="pbi-body">
          <aside class="pbi-side">
            <h2>Filters</h2>
            <h-block name="f_year" />
            <h-block name="f_region" />
            <h-block name="f_channel" />
            <h-block name="f_segment" />
          </aside>

          <main class="pbi-main">
            <div class="card kpi"><h-block name="kpi_revenue" /></div>
            <div class="card kpi"><h-block name="kpi_orders" /></div>
            <div class="card kpi"><h-block name="kpi_aov" /></div>
            <div class="card kpi"><h-block name="kpi_margin" /></div>

            <div class="split-row split-a">
              <div class="card row2"><h-block name="v_trend" /></div>
              <div class="card row2"><h-block name="v_category" /></div>
            </div>

            <div class="split-row split-b">
              <div class="card row3"><h-block name="v_top_products" /></div>
              <div class="card row3"><h-block name="v_regions" /></div>
            </div>

            <div class="note">
              Revenue = Net Sales (excludes Cancelled and Returned items). Orders = fulfilled orders. Region = customer country, Channel = traffic source, Segment = gender. KPI deltas compare against the same period last year.
            </div>
          </main>
        </div>
      </div>
    ;;
  }

  theme: H.themes.vanilla
}
