Dashboard r11_claude_html_a2 {
  title: 'Sales Performance'
  description: '''
Replica of the Power BI "Sales Performance FY2026" report on TheLook eCommerce.
Revenue = Net Sales (excludes Cancelled and Returned items). Region = customer country, Channel = customer traffic source, Customer Segment = customer gender.
'''
  owner: 'thinh.nt@holistics.io'

  // ---- Filters ----
  block f_year: FilterBlock {
    label: 'Fiscal Year'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
    default {
      operator: 'matches'
      value: 'this year'
    }
  }

  block f_region: FilterBlock {
    label: 'Region'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.country)
    }
    settings {
      input_type: 'multiple'
    }
  }

  block f_channel: FilterBlock {
    label: 'Channel'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.traffic_source)
    }
    settings {
      input_type: 'multiple'
    }
  }

  block f_segment: FilterBlock {
    label: 'Customer Segment'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.gender)
    }
    settings {
      input_type: 'single'
    }
  }

  // ---- KPI cards ----
  block kpi_revenue: VizBlock {
    label: 'Total Revenue'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        format {
          type: 'number'
          pattern: '[$$]#,###0.00,,"M"'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        value: RelativePopValue {
          duration: 1
          granularity: 'year'
        }
        show_growth_rate: true
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        metric_value {
          font_size: 32
          font_color: '#252423'
        }
      }
    }
  }

  block kpi_orders: VizBlock {
    label: 'Orders'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        value: RelativePopValue {
          duration: 1
          granularity: 'year'
        }
        show_growth_rate: true
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        metric_value {
          font_size: 32
          font_color: '#252423'
        }
      }
    }
  }

  block kpi_aov: VizBlock {
    label: 'Avg Order Value'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        format {
          type: 'number'
          pattern: '[$$]#,###0'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        value: RelativePopValue {
          duration: 1
          granularity: 'year'
        }
        show_growth_rate: true
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        metric_value {
          font_size: 32
          font_color: '#252423'
        }
      }
    }
  }

  block kpi_margin: VizBlock {
    label: 'Gross Margin'
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        format {
          type: 'number'
          pattern: '#,###0.0%'
        }
      }
      compare_value: VizPopSettings {
        field: r(thelook_order_items.created_at)
        value: RelativePopValue {
          duration: 1
          granularity: 'year'
        }
        show_growth_rate: false
      }
      settings {
        display_mode: 'compare_by_number'
        alignment: 'left'
        metric_value {
          font_size: 32
          font_color: '#252423'
        }
      }
    }
  }

  // ---- Charts ----
  block revenue_margin_by_month: VizBlock {
    label: 'Revenue & Gross Margin % by Month'
    description: 'Revenue ($) • Margin %'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL'
        }
      }
      y_axis {
        label: 'Revenue'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Revenue'
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
          settings {
            color: '#118DFF'
          }
        }
        settings {
          alignment: 'left'
        }
      }
      y_axis {
        label: 'Gross Margin %'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.gross_margin)
            label: 'Gross Margin %'
            format {
              type: 'number'
              pattern: '#,###0.0%'
            }
          }
          settings {
            color: '#E66C37'
          }
        }
        settings {
          alignment: 'right'
        }
      }
      settings {
        legend_label: 'top'
        show_data_points: true
        row_limit: 5000
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block revenue_by_category: VizBlock {
    label: 'Revenue by Product Category'
    viz: PieChart {
      dataset: thelook
      legend: VizFieldFull {
        ref: r(thelook_products.category)
        format {
          type: 'text'
        }
      }
      series {
        field: VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Revenue'
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
        }
      }
      settings {
        display_as_donut: true
        legend_label: 'right'
        show_data_label: true
        show_percentage: true
        data_label_position: 'inside'
        group_values_into: 5
        sort: 'desc'
      }
    }
  }

  block top_products: VizBlock {
    label: 'Top 8 Products by Revenue'
    description: 'Revenue ($)'
    viz: BarChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.name)
        label: 'Product'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Revenue'
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
          settings {
            color: '#118DFF'
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      filter {
        field: r(thelook_products.name)
        operator: 'top'
        value: 8
        options {
          rank_by {
            field: r(thelook.net_sales)
          }
        }
      }
      settings {
        legend_label: 'hidden'
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block regional_performance: VizBlock {
    label: 'Regional Performance'
    viz: DataTable {
      dataset: thelook
      calculation yoy_pct {
        label: 'YoY %'
        formula: @aql safe_divide(
          net_sales - (net_sales | relative_period(thelook_order_items.created_at, interval(-1 year))),
          net_sales | relative_period(thelook_order_items.created_at, interval(-1 year))
        ) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      fields: [
        VizFieldFull {
          ref: r(thelook_users.country)
          label: 'Region'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Revenue'
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
        },
        VizFieldFull {
          ref: r(thelook.fulfilled_orders)
          label: 'Orders'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: r(thelook.aov)
          label: 'AOV'
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
        },
        VizFieldFull {
          ref: 'yoy_pct'
          label: 'YoY %'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        }
      ]
      settings {
        show_row_number: false
        show_sum_row: true
        pagination_size: 25
        row_limit: 5000
        sorts: [
          IndexBasedSortSetting {
            field_index: 1
            direction: 'desc'
          }
        ]
        conditional_formats: [
          ConditionalFormat {
            ref: r(thelook.net_sales)
            format: ScaleFormat {
              min {
                type: 'percentage'
                value: 0
                color: '#FFFFFF'
              }
              max {
                type: 'percentage'
                value: 100
                color: '#C6E2FF'
              }
            }
          },
          ConditionalFormat {
            ref: 'yoy_pct'
            format: SingleFormat {
              condition {
                operator: 'greater_than_equal'
                value: 0
              }
              text_color: '#107C10'
              background_color: 'transparent'
            }
          },
          ConditionalFormat {
            ref: 'yoy_pct'
            format: SingleFormat {
              condition {
                operator: 'less_than'
                value: 0
              }
              text_color: '#D13438'
              background_color: 'transparent'
            }
          }
        ]
      }
    }
  }

  // ---- Layout ----
  view: HTMLLayout {
    content: @html
      <style>
        .pbi {
          font-family: 'Segoe UI', -apple-system, Helvetica, Arial, sans-serif;
          background: #f3f2f1;
          color: #252423;
          min-height: 100%;
        }
        .pbi-header {
          display: flex;
          align-items: center;
          gap: 48px;
          height: 44px;
          padding: 0 20px;
          background: #ffffff;
          border-bottom: 1px solid #e1dfdd;
        }
        .pbi-header h1 {
          margin: 0;
          font-size: 17px;
          font-weight: 700;
        }
        .pbi-header .menu {
          font-size: 13px;
          color: #605e5c;
          word-spacing: 4px;
        }
        .pbi-body {
          display: grid;
          grid-template-columns: 200px minmax(0, 1fr);
        }
        .pbi-filters {
          background: #ffffff;
          border-right: 1px solid #e1dfdd;
          padding: 16px 12px;
          display: flex;
          flex-direction: column;
          gap: 8px;
        }
        .pbi-filters h2 {
          margin: 4px 4px 4px;
          font-size: 14px;
          font-weight: 700;
        }
        .pbi-filters .slot { min-height: 64px; }
        .pbi-main {
          padding: 16px;
          display: flex;
          flex-direction: column;
          gap: 16px;
          min-width: 0;
        }
        .row { display: grid; gap: 16px; }
        .kpis { grid-template-columns: repeat(4, minmax(0, 1fr)); }
        .row-2 { grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr); }
        .row-3 { grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); }
        .card {
          background: #ffffff;
          border: 1px solid #e1dfdd;
          box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
          min-width: 0;
        }
        .kpi { height: 112px; }
        .chart { height: 356px; }
        .tall { height: 392px; }
        .footnote {
          padding: 6px 14px 10px;
          font-size: 11px;
          color: #8a8886;
        }
        @media (max-width: 1100px) {
          .pbi-body { grid-template-columns: 1fr; }
          .kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
          .row-2, .row-3 { grid-template-columns: 1fr; }
        }
      </style>

      <div class="pbi">
        <div class="pbi-header">
          <h1>Sales Performance FY2026</h1>
          <span class="menu">TheLook eCommerce · Net Sales view</span>
        </div>

        <div class="pbi-body">
          <aside class="pbi-filters">
            <h2>Filters</h2>
            <div class="slot"><h-block name="f_year" /></div>
            <div class="slot"><h-block name="f_region" /></div>
            <div class="slot"><h-block name="f_channel" /></div>
            <div class="slot"><h-block name="f_segment" /></div>
          </aside>

          <main class="pbi-main">
            <section class="row kpis">
              <div class="card kpi"><h-block name="kpi_revenue" /></div>
              <div class="card kpi"><h-block name="kpi_orders" /></div>
              <div class="card kpi"><h-block name="kpi_aov" /></div>
              <div class="card kpi"><h-block name="kpi_margin" /></div>
            </section>

            <section class="row row-2">
              <div class="card chart"><h-block name="revenue_margin_by_month" /></div>
              <div class="card chart"><h-block name="revenue_by_category" /></div>
            </section>

            <section class="row row-3">
              <div class="card tall"><h-block name="top_products" /></div>
              <div class="card">
                <div class="tall"><h-block name="regional_performance" /></div>
                <div class="footnote">Revenue = Net Sales (excludes Cancelled and Returned items). Region = customer country.</div>
              </div>
            </section>
          </main>
        </div>
      </div>
    ;;
  }

  theme: H.themes.vanilla
}
