Dashboard r11_haid_canvas_a3 {
  title: 'Sales Performance FY2026'
  description: @md
Monitoring view for the completed, verified Jan–Sep 2026 sales period. Net Sales exclude Cancelled and Returned order items.
;;
  theme: H.themes.classic

  settings {
    autorun_on_open: true
    autorun_on_changes: true
    cache_duration: 60
  }

  block title: TextBlock {
    content: @md
# Sales Performance FY2026
Completed reporting window: **Jan–Sep 2026**. Use the filter rail to narrow the view and controls to compare periods or change the trend grain.
;;
  }

  block f_date: FilterBlock {
    label: 'Order Item Date'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
    default {
      operator: 'matches'
      value: 'between 2026-01-01 and 2026-09-30'
    }
  }

  block f_country: FilterBlock {
    label: 'Country'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.country)
    }
    default { operator: 'is' value: '$H_NIL$' }
  }

  block f_traffic_source: FilterBlock {
    label: 'Traffic Source'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.traffic_source)
    }
    default { operator: 'is' value: '$H_NIL$' }
  }

  block f_gender: FilterBlock {
    label: 'Customer segment (Gender proxy)'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.gender)
    }
    default { operator: 'is' value: '$H_NIL$' }
  }

  block c_pop: PopBlock {
    label: 'Compare To'
    default {
      type: 'relative'
      duration: 1
      granularity: 'year'
      show_growth_rate: true
    }
  }

  block c_date_drill: DateDrillBlock {
    label: 'Trend Grain'
    default: 'month'
  }

  block kpi_net_sales: VizBlock {
    label: 'Net Sales'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.net_sales)
    label: 'Governed Net Sales'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
}
  }

  block kpi_fulfilled_orders: VizBlock {
    label: 'Fulfilled Orders'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.fulfilled_orders)
    label: 'Fulfilled Orders'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
  settings {
    display_mode: 'single'
  }
}
  }

  block kpi_aov: VizBlock {
    label: 'Average Order Value'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.aov)
    label: 'Average Order Value'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
  settings {
    display_mode: 'single'
    alignment: 'center'
  }
}
  }

  block kpi_gross_margin: VizBlock {
    label: 'Gross Margin'
    settings { hide_label: true }
    viz: MetricKpi {
  dataset: thelook
  value: VizFieldFull {
    ref: r(thelook.gross_margin)
    label: 'Gross Margin'
    format {
      type: 'number'
      pattern: 'inherited'
    }
  }
}
  }

  block v_monthly_sales_margin: VizBlock {
    label: 'Revenue & Gross Margin % by Month'
    viz: CombinationChart {
  dataset: thelook
  x_axis: VizFieldFull {
    ref: r(thelook_order_items.created_at)
    label: 'Order Item Created Month'
    transformation: 'datetrunc month'
    format {
      type: 'date'
      pattern: 'LLL yyyy'
    }
  }
  y_axis {
    label: 'Net Sales'
    series {
      mark_type: 'column'
      field: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        color: '#2563EB'
      }
    }
    settings {
      alignment: 'left'
    }
  }
  y_axis {
    label: 'Gross Margin'
    series {
      mark_type: 'line'
      field: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: '#,###0.0%'
        }
      }
    }
    settings {
      alignment: 'right'
    }
  }
  settings {
    legend_label: 'bottom'
    show_data_points: true
    sort: LineFamilySort {
      type: 'xaxis'
      direction: 'asc'
    }
  }
}
  }

  block v_category_mix: VizBlock {
    label: 'Revenue by Product Category'
    viz: PieChart {
  dataset: thelook
  legend: VizFieldFull {
    ref: r(thelook_products.category)
    label: 'Product Category'
  }
  series {
    field: VizFieldFull {
      ref: r(thelook.net_sales)
      label: 'Net Sales'
      format {
        type: 'number'
        pattern: 'inherited'
      }
    }
  }
  settings {
    display_as_donut: true
    show_data_label: true
    show_percentage: true
    data_label_position: 'outside'
    show_total: true
    group_values_into: 5
    sort: 'desc'
  }
}
  }

  block v_top_products: VizBlock {
    label: 'Top 8 Products by Revenue'
    viz: CombinationChart {
  dataset: thelook
  calculation product_rank_by_net_sales {
    label: 'Product Rank By Net Sales'
    formula: @aql rank(order: net_sales | desc(), partition: []);;
    calc_type: 'measure'
    data_type: 'number'
  }
  x_axis: VizFieldFull {
    ref: r(thelook_products.name)
    label: 'Product Name'
  }
  y_axis {
    series {
      mark_type: 'bar'
      field: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }
  filter {
    field: 'product_rank_by_net_sales'
    operator: 'less_than'
    value: 9
  }
  settings {
    legend_label: 'hidden'
    row_limit: 8
    sort: LineFamilySort {
      type: 'yaxis'
      field_index: 0
      direction: 'desc'
    }
  }
}
  }

  block v_country_performance: VizBlock {
    label: 'Country Performance'
    viz: DataTable {
  dataset: thelook

  calculation net_sales_yoy_delta {
    label: 'Net Sales YoY Delta'
    formula: @aql net_sales - (net_sales | relative_period(thelook_order_items.created_at, interval(-1 year)));;
    calc_type: 'measure'
    data_type: 'number'
  }

  fields: [
    VizFieldFull {
      ref: r(thelook_users.country)
      label: 'Country'
      uname: 'thelook_users_country_1'
    },
    VizFieldFull {
      ref: r(thelook.net_sales)
      label: 'Net Sales'
      format {
        type: 'number'
        pattern: 'inherited'
      }
      uname: 'custom_net_sales_1'
    },
    VizFieldFull {
      ref: r(thelook.fulfilled_orders)
      label: 'Fulfilled Orders'
      format {
        type: 'number'
        pattern: 'inherited'
      }
    },
    VizFieldFull {
      ref: r(thelook.aov)
      label: 'Average Order Value'
      format {
        type: 'number'
        pattern: 'inherited'
      }
    },
    VizFieldFull {
      ref: 'net_sales_yoy_delta'
      label: 'Net Sales YoY Delta'
      format {
        type: 'number'
        pattern: '[$$]#,###0'
      }
    },
  ]

  settings {
    pagination_size: 100
    show_row_number: true
    wrap_header_text: true
    conditional_formats: [
      ConditionalFormat {
        ref: 'net_sales_yoy_delta'
        format: SingleFormat {
          condition {
            operator: 'greater_than'
            value: 0
          }
          text_color: '#15803D'
          background_color: '#DCFCE7'
        }
      },
      ConditionalFormat {
        ref: 'net_sales_yoy_delta'
        format: SingleFormat {
          condition {
            operator: 'less_than'
            value: 0
          }
          text_color: '#B91C1C'
          background_color: '#FEE2E2'
        }
      },
    ]
    sorts: [
      KeyBasedSortSetting {
        key: 'custom_net_sales_1'
        direction: 'desc'
      },
      KeyBasedSortSetting {
        key: 'thelook_users_country_1'
        direction: 'asc'
      },
    ]
  }
}
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'f_date'
      to: ['kpi_net_sales', 'kpi_fulfilled_orders', 'kpi_aov', 'kpi_gross_margin', 'v_monthly_sales_margin', 'v_category_mix', 'v_top_products', 'v_country_performance']
      field: r(thelook_order_items.created_at)
    },
    FilterInteraction {
      from: 'f_country'
      to: ['kpi_net_sales', 'kpi_fulfilled_orders', 'kpi_aov', 'kpi_gross_margin', 'v_monthly_sales_margin', 'v_category_mix', 'v_top_products', 'v_country_performance']
      field: r(thelook_users.country)
    },
    FilterInteraction {
      from: 'f_traffic_source'
      to: ['kpi_net_sales', 'kpi_fulfilled_orders', 'kpi_aov', 'kpi_gross_margin', 'v_monthly_sales_margin', 'v_category_mix', 'v_top_products', 'v_country_performance']
      field: r(thelook_users.traffic_source)
    },
    FilterInteraction {
      from: 'f_gender'
      to: ['kpi_net_sales', 'kpi_fulfilled_orders', 'kpi_aov', 'kpi_gross_margin', 'v_monthly_sales_margin', 'v_category_mix', 'v_top_products', 'v_country_performance']
      field: r(thelook_users.gender)
    },
    DateDrillInteraction {
      from: 'c_date_drill'
      to: ['v_monthly_sales_margin']
      field: r(thelook_order_items.created_at)
    },
    PopInteraction {
      from: 'c_pop'
      to: ['kpi_net_sales', 'kpi_fulfilled_orders', 'kpi_aov', 'kpi_gross_margin', 'v_monthly_sales_margin']
      field: r(thelook_order_items.created_at)
    }
  ]

  view: CanvasLayout {
    width: 1600
    height: 1120
    grid_size: 20
    auto_expand_vertically: true

    block title { position: pos(20, 20, 1560, 80) layer: 1 }

    block f_date { position: pos(20, 120, 240, 120) layer: 1 }
    block f_country { position: pos(20, 260, 240, 120) layer: 1 }
    block f_traffic_source { position: pos(20, 400, 240, 120) layer: 1 }
    block f_gender { position: pos(20, 540, 240, 120) layer: 1 }
    block c_pop { position: pos(20, 680, 240, 100) layer: 1 }
    block c_date_drill { position: pos(20, 800, 240, 100) layer: 1 }

    block kpi_net_sales { position: pos(300, 120, 290, 120) layer: 1 }
    block kpi_fulfilled_orders { position: pos(610, 120, 290, 120) layer: 1 }
    block kpi_aov { position: pos(920, 120, 290, 120) layer: 1 }
    block kpi_gross_margin { position: pos(1230, 120, 290, 120) layer: 1 }

    block v_monthly_sales_margin { position: pos(300, 270, 800, 370) layer: 1 }
    block v_category_mix { position: pos(1130, 270, 390, 370) layer: 1 }

    block v_top_products { position: pos(300, 680, 650, 380) layer: 1 }
    block v_country_performance { position: pos(970, 680, 550, 380) layer: 1 }

    mobile { mode: 'auto' }
  }
}
