Dashboard r11_haid_html_a1 {
  title: 'Sales Performance'
  description: 'Sales performance monitoring dashboard with interactive filters for order-item created date, customer state, product department, and customer gender.'
  theme: H.themes.classic

  settings {
    autorun_on_open: true
    autorun_on_changes: true
    cache_duration: 60
  }

  block b_title: TextBlock {
    content: @md
      # Sales Performance
    ;;
  }

  block f_created_at: FilterBlock {
    label: 'Created At'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
    settings {
      input_type: 'multiple'
    }
  }

  block f_customer_state: FilterBlock {
    label: 'Customer State'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.state)
    }
    settings {
      input_type: 'multiple'
    }
  }

  block f_product_department: FilterBlock {
    label: 'Product Department'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_products.department)
    }
    settings {
      input_type: 'multiple'
    }
  }

  block f_customer_gender: FilterBlock {
    label: 'Customer Gender'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.gender)
    }
    settings {
      input_type: 'multiple'
    }
  }

  block v_net_sales: VizBlock {
    label: 'Net Sales'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block v_orders: VizBlock {
    label: 'Orders'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.total_orders)
        label: 'Orders'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block v_aov: VizBlock {
    label: 'Average Order Value'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block v_gross_margin: VizBlock {
    label: 'Gross Margin'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block v_monthly_sales_margin: VizBlock {
    label: 'Monthly Net Sales and Gross Margin'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        label: 'Month'
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        label: 'Net Sales'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#2563EB'
          }
        }
        settings {
          alignment: 'left'
        }
      }
      y_axis {
        label: 'Gross Margin'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.gross_margin)
            label: 'Gross Margin'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#F97316'
          }
        }
        settings {
          alignment: 'right'
        }
      }
      settings {
        x_axis_label: 'Month'
        legend_label: 'top'
        show_data_points: true
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block v_sales_by_category: VizBlock {
    label: 'Net Sales by Product Category'
    viz: PieChart {
      dataset: thelook
      legend: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Product Category'
      }
      series {
        field: VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      }
      settings {
        display_as_donut: true
        sort: 'desc'
      }
    }
  }

  block v_top_products: VizBlock {
    label: 'Top 8 Products by Net Sales'
    viz: CombinationChart {
      dataset: thelook

      calculation trimmed_name {
        label: 'Trimmed Name'
        formula: @aql trim(thelook_products.name);;
        calc_type: 'dimension'
        data_type: 'text'
        model: thelook_products
      }

      x_axis: VizFieldFull {
        ref: ref('thelook_products', 'trimmed_name')
        label: 'Product Name'
        format {
          type: 'text'
        }
      }

      y_axis {
        series {
          mark_type: 'bar'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }

      conditions: [
        "thelook_products.name is not null",
        "thelook_products.trimmed_name is not ''",
      ]

      settings {
        row_limit: 8
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block v_state_performance: VizBlock {
    label: 'State Performance'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          ref: r(thelook_users.state)
          label: 'State'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          uname: 'net_sales'
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
        },
        VizFieldFull {
          ref: r(thelook.total_orders)
          label: 'Orders'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: r(thelook.aov)
          label: 'Average Order Value'
          format {
            type: 'number'
            pattern: '[$$]#,###0.00'
          }
        },
        VizFieldFull {
          ref: r(thelook.gross_margin)
          label: 'Gross Margin'
          format {
            type: 'number'
            pattern: '#,###0.0%'
          }
        },
      ]
      conditions: [
        "thelook_users.state is not null",
        "thelook_users.state != ''",
        "net_sales > 0",
      ]
      settings {
        pagination_size: 100
        show_row_number: true
        wrap_header_text: true
        sorts: [
          KeyBasedSortSetting {
            key: 'net_sales'
            direction: 'desc'
          },
        ]
      }
    }
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'f_created_at'
      to: ['v_net_sales', 'v_orders', 'v_aov', 'v_gross_margin', 'v_monthly_sales_margin', 'v_sales_by_category', 'v_top_products', 'v_state_performance']
      field: r(thelook_order_items.created_at)
    },
    FilterInteraction {
      from: 'f_customer_state'
      to: ['v_net_sales', 'v_orders', 'v_aov', 'v_gross_margin', 'v_monthly_sales_margin', 'v_sales_by_category', 'v_top_products', 'v_state_performance']
      field: r(thelook_users.state)
    },
    FilterInteraction {
      from: 'f_product_department'
      to: ['v_net_sales', 'v_orders', 'v_aov', 'v_gross_margin', 'v_monthly_sales_margin', 'v_sales_by_category', 'v_top_products', 'v_state_performance']
      field: r(thelook_products.department)
    },
    FilterInteraction {
      from: 'f_customer_gender'
      to: ['v_net_sales', 'v_orders', 'v_aov', 'v_gross_margin', 'v_monthly_sales_margin', 'v_sales_by_category', 'v_top_products', 'v_state_performance']
      field: r(thelook_users.gender)
    },
  ]

  view: HTMLLayout {
    content: @html
      <style>
        .sales-dashboard {
          display: grid;
          grid-template-columns: minmax(220px, 260px) minmax(0, 1fr);
          gap: 20px;
          align-items: start;
          padding: 8px;
        }
        .filter-rail {
          display: flex;
          flex-direction: column;
          gap: 12px;
          padding: 16px;
          background: #f8fafc;
          border: 1px solid #e2e8f0;
          border-radius: 8px;
        }
        .filter-rail h2 {
          margin: 0 0 4px;
          font-size: 16px;
        }
        .dashboard-main {
          display: flex;
          flex-direction: column;
          gap: 20px;
          min-width: 0;
        }
        .kpi-grid {
          display: grid;
          grid-template-columns: repeat(4, minmax(0, 1fr));
          gap: 16px;
        }
        .analysis-grid {
          display: grid;
          grid-template-columns: minmax(0, 2fr) minmax(320px, 1fr);
          gap: 20px;
        }
        .bottom-grid {
          display: grid;
          grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
          gap: 20px;
        }
        .panel {
          min-width: 0;
          min-height: 340px;
        }
        .table-panel {
          min-height: 440px;
        }
        @media (max-width: 1100px) {
          .sales-dashboard { grid-template-columns: 1fr; }
          .filter-rail { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
          .filter-rail h2 { grid-column: 1 / -1; }
          .analysis-grid, .bottom-grid { grid-template-columns: 1fr; }
        }
        @media (max-width: 720px) {
          .kpi-grid, .filter-rail { grid-template-columns: 1fr; }
          .filter-rail h2 { grid-column: auto; }
        }
      </style>

      <div class="sales-dashboard">
        <aside class="filter-rail">
          <h2>Filters</h2>
          <h-block name="f_created_at" />
          <h-block name="f_customer_state" />
          <h-block name="f_product_department" />
          <h-block name="f_customer_gender" />
        </aside>

        <main class="dashboard-main">
          <header>
            <h-block name="b_title" />
          </header>

          <section class="kpi-grid" aria-label="Key performance indicators">
            <h-block name="v_net_sales" />
            <h-block name="v_orders" />
            <h-block name="v_aov" />
            <h-block name="v_gross_margin" />
          </section>

          <section class="analysis-grid" aria-label="Sales trend and category mix">
            <div class="panel"><h-block name="v_monthly_sales_margin" /></div>
            <div class="panel"><h-block name="v_sales_by_category" /></div>
          </section>

          <section class="bottom-grid" aria-label="Product and state performance">
            <div class="panel"><h-block name="v_top_products" /></div>
            <div class="panel table-panel"><h-block name="v_state_performance" /></div>
          </section>
        </main>
      </div>
    ;;
  }
}
