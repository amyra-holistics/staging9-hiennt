Dashboard r11_haid_html_a2 {
  title: 'Sales Performance'
  theme: H.themes.classic

  block f_sales_date: FilterBlock {
    label: 'Sales Date'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block f_customer_country: FilterBlock {
    label: 'Customer Country'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.country)
    }
  }

  block f_traffic_source: FilterBlock {
    label: 'Customer Traffic Source'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.traffic_source)
    }
  }

  block f_customer_gender: FilterBlock {
    label: 'Customer Gender'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.gender)
    }
  }

  block c_period_compare: PopBlock {
    label: 'Compare To'
  }

  block kpi_net_sales: VizBlock {
    label: 'Net Sales'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block kpi_fulfilled_orders: VizBlock {
    label: 'Fulfilled Orders'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.fulfilled_orders)
        label: 'Fulfilled Orders'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block kpi_aov: VizBlock {
    label: 'Average Order Value'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block kpi_gross_margin: VizBlock {
    label: 'Gross Margin'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block monthly_sales_margin: VizBlock {
    label: 'Monthly Sales and Gross Margin'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        transformation: 'datetrunc month'
        label: 'Order Item Month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        label: 'Net Sales'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings { color: '#2563EB' }
        }
        settings { alignment: 'left' }
      }
      y_axis {
        label: 'Gross Margin'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.gross_margin)
            label: 'Gross Margin'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings { color: '#F97316' }
        }
        settings { alignment: 'right' }
      }
      settings {
        legend_label: 'top'
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block sales_by_category: VizBlock {
    label: 'Revenue by Product Category'
    viz: PieChart {
      dataset: thelook
      calculation category_net_sales {
        label: 'Category Net Sales'
        formula: @aql net_sales | dimensionalize(thelook_products.category);;
        calc_type: 'dimension'
        data_type: 'number'
        model: thelook_products
      }
      calculation category_rank {
        label: 'Category Rank'
        formula: @aql dense_rank(
          order: thelook_products.category_net_sales | desc(),
          partition: []
        );;
        calc_type: 'dimension'
        data_type: 'number'
        model: thelook_products
      }
      calculation category_or_other {
        label: 'Category'
        formula: @aql case(
          when: thelook_products.category_rank < 6,
          then: thelook_products.category,
          else: 'Other'
        );;
        calc_type: 'dimension'
        data_type: 'text'
        model: thelook_products
      }
      legend: VizFieldFull {
        ref: ref('thelook_products', 'category_or_other')
        label: 'Category'
      }
      series {
        field: VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      }
      settings {
        display_as_donut: true
        legend_label: 'right'
        show_data_label: true
        data_label_position: 'outside'
        sort: 'desc'
      }
    }
  }

  block top_8_products: VizBlock {
    label: 'Top 8 Products by Revenue'
    viz: CombinationChart {
      dataset: thelook
      calculation product_net_sales_rank {
        label: 'Product Net Sales Rank'
        formula: @aql rank(order: net_sales | desc(), partition: []);;
        calc_type: 'measure'
        data_type: 'number'
      }
      x_axis: VizFieldFull {
        ref: r(thelook_products.name)
        label: 'Product Name'
        format { type: 'text' }
      }
      y_axis {
        series {
          mark_type: 'bar'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      filter {
        field: 'product_net_sales_rank'
        operator: 'less_than'
        value: 9
      }
      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block regional_performance: VizBlock {
    label: 'Country Performance'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          label: 'Country'
          ref: r(thelook_users.country)
          format { type: 'text' }
        },
        VizFieldFull {
          label: 'Net Sales'
          ref: r(thelook.net_sales)
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'net_sales'
        },
        VizFieldFull {
          label: 'Fulfilled Orders'
          ref: r(thelook.fulfilled_orders)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'Average Order Value'
          ref: r(thelook.aov)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'Gross Margin'
          ref: r(thelook.gross_margin)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        pagination_size: 100
        show_row_number: true
        sorts: [
          KeyBasedSortSetting {
            key: 'net_sales'
            direction: 'desc'
          }
        ]
        single_cell_display: 'normal'
      }
    }
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'f_sales_date'
      to: ['kpi_net_sales', 'kpi_fulfilled_orders', 'kpi_aov', 'kpi_gross_margin', 'monthly_sales_margin', 'sales_by_category', 'top_8_products', 'regional_performance']
      field: r(thelook_order_items.created_at)
    },
    FilterInteraction {
      from: 'f_customer_country'
      to: ['kpi_net_sales', 'kpi_fulfilled_orders', 'kpi_aov', 'kpi_gross_margin', 'monthly_sales_margin', 'sales_by_category', 'top_8_products', 'regional_performance']
      field: r(thelook_users.country)
    },
    FilterInteraction {
      from: 'f_traffic_source'
      to: ['kpi_net_sales', 'kpi_fulfilled_orders', 'kpi_aov', 'kpi_gross_margin', 'monthly_sales_margin', 'sales_by_category', 'top_8_products', 'regional_performance']
      field: r(thelook_users.traffic_source)
    },
    FilterInteraction {
      from: 'f_customer_gender'
      to: ['kpi_net_sales', 'kpi_fulfilled_orders', 'kpi_aov', 'kpi_gross_margin', 'monthly_sales_margin', 'sales_by_category', 'top_8_products', 'regional_performance']
      field: r(thelook_users.gender)
    },
    PopInteraction {
      from: 'c_period_compare'
      to: ['kpi_net_sales', 'kpi_fulfilled_orders', 'kpi_aov', 'kpi_gross_margin', 'monthly_sales_margin']
      field: r(thelook_order_items.created_at)
    }
  ]

  view: HTMLLayout {
    content: @html
      <style>
        .sales-dashboard { display: grid; grid-template-columns: minmax(210px, 240px) minmax(0, 1fr); gap: 20px; align-items: start; }
        .filter-rail { position: sticky; top: 16px; display: grid; gap: 12px; padding: 16px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; }
        .filter-rail h2 { margin: 0 0 4px; font-size: 16px; }
        .main-content { display: grid; gap: 16px; min-width: 0; }
        .dashboard-header { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding-bottom: 10px; border-bottom: 1px solid #e2e8f0; }
        .dashboard-header h1 { margin: 0; font-size: 26px; line-height: 1.2; }
        .dashboard-header p { margin: 4px 0 0; color: #64748b; font-size: 13px; }
        .comparison-control { min-width: 190px; }
        .kpi-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
        .chart-grid { display: grid; grid-template-columns: minmax(0, 1.8fr) minmax(320px, 1fr); gap: 16px; }
        .bottom-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 16px; }
        .card { min-width: 0; min-height: 280px; padding: 4px; border: 1px solid #e2e8f0; border-radius: 8px; background: #ffffff; }
        .kpi-card { min-height: 126px; }
        .table-card { min-height: 340px; }
        h-block { display: block; height: 100%; }
        @media (max-width: 1050px) {
          .sales-dashboard { grid-template-columns: 1fr; }
          .filter-rail { position: static; grid-template-columns: repeat(2, minmax(0, 1fr)); }
          .filter-rail h2 { grid-column: 1 / -1; }
          .kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        }
        @media (max-width: 720px) {
          .dashboard-header, .chart-grid, .bottom-grid { display: grid; grid-template-columns: 1fr; }
          .filter-rail, .kpi-grid { grid-template-columns: 1fr; }
        }
      </style>
      <div class="sales-dashboard">
        <aside class="filter-rail">
          <h2>Filters</h2>
          <h-block name="f_sales_date" />
          <h-block name="f_customer_country" />
          <h-block name="f_traffic_source" />
          <h-block name="f_customer_gender" />
        </aside>
        <main class="main-content">
          <header class="dashboard-header">
            <div>
              <h1>Sales Performance</h1>
              <p>Net sales, fulfilled-order volume, and margin performance</p>
            </div>
            <div class="comparison-control">
              <h-block name="c_period_compare" />
            </div>
          </header>
          <section class="kpi-grid">
            <div class="card kpi-card"><h-block name="kpi_net_sales" /></div>
            <div class="card kpi-card"><h-block name="kpi_fulfilled_orders" /></div>
            <div class="card kpi-card"><h-block name="kpi_aov" /></div>
            <div class="card kpi-card"><h-block name="kpi_gross_margin" /></div>
          </section>
          <section class="chart-grid">
            <div class="card"><h-block name="monthly_sales_margin" /></div>
            <div class="card"><h-block name="sales_by_category" /></div>
          </section>
          <section class="bottom-grid">
            <div class="card table-card"><h-block name="top_8_products" /></div>
            <div class="card table-card"><h-block name="regional_performance" /></div>
          </section>
        </main>
      </div>
    ;;
  }
}
