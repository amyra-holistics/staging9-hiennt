Dashboard r11_haidfd_canvas_a3 {
  title: 'Sales Performance'
  description: 'Sales performance monitoring dashboard with interactive order-date, country, gender, and traffic-source controls.'
  theme: H.themes.classic

  settings {
    autorun_on_open: true
    autorun_on_changes: true
    cache_duration: 360
  }

  // Page heading
  block title: TextBlock {
    content: @md
# Sales Performance
Use the controls to focus the sales view by order date, customer location, gender, or acquisition source.
    ;;
  }

  // Global controls
  block f_order_date: FilterBlock {
    label: 'Order Date'
    type: 'date'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_order_items.created_at)
    }
  }

  block f_country: FilterBlock {
    label: 'Country'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.country)
    }
  }

  block f_gender: FilterBlock {
    label: 'Gender'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.gender)
    }
  }

  block f_traffic_source: FilterBlock {
    label: 'Traffic Source'
    type: 'field'
    source: FieldFilterSource {
      dataset: thelook
      field: r(thelook_users.traffic_source)
    }
  }

  // KPI row
  block net_sales_kpi: VizBlock {
    label: 'Net Sales'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.net_sales)
        label: 'Net Sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block orders_kpi: VizBlock {
    label: 'Orders'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.total_orders)
        label: 'Orders'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block average_order_value_kpi: VizBlock {
    label: 'Average Order Value'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.aov)
        label: 'Average Order Value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  block gross_margin_kpi: VizBlock {
    label: 'Gross Margin'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: thelook
      value: VizFieldFull {
        ref: r(thelook.gross_margin)
        label: 'Gross Margin'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
  }

  // Trend and category mix
  block monthly_net_sales_and_gross_margin: VizBlock {
    label: 'Net Sales & Gross Margin by Month'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_order_items.created_at)
        label: 'Order Item Month'
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        label: 'Net Sales'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        settings { alignment: 'left' }
      }
      y_axis {
        label: 'Gross Margin'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(thelook.gross_margin)
            label: 'Gross Margin'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        settings { alignment: 'right' }
      }
      settings {
        legend_label: 'top'
        show_data_points: false
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block net_sales_by_category_donut: VizBlock {
    label: 'Net Sales by Product Category'
    viz: PieChart {
      dataset: thelook
      legend: VizFieldFull {
        ref: r(thelook_products.category)
        label: 'Product Category'
      }
      series {
        field: VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      }
      settings {
        display_as_donut: true
        legend_label: 'right'
        show_data_label: true
        show_percentage: true
        data_label_position: 'outside'
        sort: PieFamilySort {
          type: 'pie'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  // Product ranking and country detail
  block top_8_products_by_net_sales: VizBlock {
    label: 'Top 8 Products by Net Sales'
    viz: CombinationChart {
      dataset: thelook
      x_axis: VizFieldFull {
        ref: r(thelook_products.name)
        label: 'Product Name'
      }
      y_axis {
        series {
          mark_type: 'bar'
          field: VizFieldFull {
            ref: r(thelook.net_sales)
            label: 'Net Sales'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        row_limit: 8
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block country_performance_table: VizBlock {
    label: 'Country Performance'
    viz: DataTable {
      dataset: thelook
      fields: [
        VizFieldFull {
          ref: r(thelook_users.country)
          label: 'Country'
          format { type: 'text' }
          uname: 'country'
        },
        VizFieldFull {
          ref: r(thelook.net_sales)
          label: 'Net Sales'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.total_orders)
          label: 'Orders'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.aov)
          label: 'Average Order Value'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(thelook.gross_margin)
          label: 'Gross Margin'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
      ]
      settings {
        pagination_size: 100
        show_row_number: true
        sorts: [
          KeyBasedSortSetting {
            key: 'country'
            direction: 'asc'
          }
        ]
        wrap_header_text: true
      }
    }
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'f_order_date'
      to: ['net_sales_kpi', 'orders_kpi', 'average_order_value_kpi', 'gross_margin_kpi', 'monthly_net_sales_and_gross_margin', 'net_sales_by_category_donut', 'top_8_products_by_net_sales', 'country_performance_table']
      field: r(thelook_order_items.created_at)
    },
    FilterInteraction {
      from: 'f_country'
      to: ['net_sales_kpi', 'orders_kpi', 'average_order_value_kpi', 'gross_margin_kpi', 'monthly_net_sales_and_gross_margin', 'net_sales_by_category_donut', 'top_8_products_by_net_sales', 'country_performance_table']
      field: r(thelook_users.country)
    },
    FilterInteraction {
      from: 'f_gender'
      to: ['net_sales_kpi', 'orders_kpi', 'average_order_value_kpi', 'gross_margin_kpi', 'monthly_net_sales_and_gross_margin', 'net_sales_by_category_donut', 'top_8_products_by_net_sales', 'country_performance_table']
      field: r(thelook_users.gender)
    },
    FilterInteraction {
      from: 'f_traffic_source'
      to: ['net_sales_kpi', 'orders_kpi', 'average_order_value_kpi', 'gross_margin_kpi', 'monthly_net_sales_and_gross_margin', 'net_sales_by_category_donut', 'top_8_products_by_net_sales', 'country_performance_table']
      field: r(thelook_users.traffic_source)
    }
  ]

  view: CanvasLayout {
    width: 1240
    height: 1240
    grid_size: 20
    auto_expand_vertically: true

    block title { position: pos(20, 20, 1200, 80) layer: 1 }

    // Four equal controls across the top.
    block f_order_date { position: pos(20, 120, 285, 80) layer: 1 }
    block f_country { position: pos(325, 120, 285, 80) layer: 1 }
    block f_gender { position: pos(630, 120, 285, 80) layer: 1 }
    block f_traffic_source { position: pos(935, 120, 285, 80) layer: 1 }

    // Four equal KPI cards.
    block net_sales_kpi { position: pos(20, 220, 285, 140) layer: 1 }
    block orders_kpi { position: pos(325, 220, 285, 140) layer: 1 }
    block average_order_value_kpi { position: pos(630, 220, 285, 140) layer: 1 }
    block gross_margin_kpi { position: pos(935, 220, 285, 140) layer: 1 }

    // 7:5 trend and category-mix row.
    block monthly_net_sales_and_gross_margin { position: pos(20, 380, 700, 360) layer: 1 }
    block net_sales_by_category_donut { position: pos(740, 380, 480, 360) layer: 1 }

    // Balanced 6:6 ranking and detail row.
    block top_8_products_by_net_sales { position: pos(20, 760, 590, 400) layer: 1 }
    block country_performance_table { position: pos(630, 760, 590, 400) layer: 1 }

    mobile { mode: 'auto' }
  }
}
