  block t_headline: TextBlock {
    content: @md 2025 ecommerce scale more than doubled — but order quality needs attention. ;;
  }
  block t_hero_note: TextBlock {
    content: @md Gross merchandise value reached $3,784,847 in 2025, up 124.4% from $1,686,827 in 2024. This is gross item value — it includes every order status, not only delivered orders. ;;
  }
  block t_sec_1: TextBlock {
    content: @md ### Growth accelerated through year end
2025 began at $322,770 in monthly gross merchandise value and ended at its $510,704 December peak. The period was complete across all 12 calendar months, making the full-year comparison dependable. ;;
  }
  block t_pull: TextBlock {
    content: @md Buyer-led scale lifted 2025 gross merchandise value 124.4%, while 3,266 of 10,934 orders (29.8%) were cancelled or refunded. ;;
  }
  block t_sec_3: TextBlock {
    content: @md ### Growth was broad, not concentrated in one market
Nineteen categories and 10 buyer countries generated 2025 activity. Body was the leading category at $357,609, while the United States led countries at $434,102. ;;
  }
  block t_close: TextBlock {
    content: @md ### Keep growth and execution quality together
Use gross merchandise value to monitor marketplace demand and scale, but do not treat it as realized revenue. Track the cancelled and refunded share alongside the headline until a status-excluding metric is available. ;;
  }

  block f_date: FilterBlock {
    label: 'Order date — 2025 default'
    type: 'field'
    source: FieldFilterSource {
      dataset: ecommerce_official
      field: r(orders.created_at)
    }
    default {
      operator: 'matches'
      value: '2025'
    }
  }
  block f_country: FilterBlock {
    label: 'Buyer country'
    type: 'field'
    source: FieldFilterSource {
      dataset: ecommerce_official
      field: r(countries.name)
    }
  }
  block c_pop: PopBlock {
    label: 'Period comparison'
  }

  block k_hero: VizBlock {
    label: 'Gross merchandise value'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: ecommerce_official
      value: r(ecommerce_official.revenue)
    }
  }
  block k_stat_1: VizBlock {
    label: 'Distinct orders'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: ecommerce_official
      calculation distinct_orders {
        label: 'Distinct Orders'
        formula: @aql count_distinct(order_items, order_items.order_id);;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'distinct_orders'
        label: 'Distinct Orders'
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }
  block k_stat_2: VizBlock {
    label: 'Distinct buying users'
    settings {
      hide_label: true
    }
    viz: MetricKpi {
      dataset: ecommerce_official
      calculation distinct_buying_users {
        label: 'Distinct Buying Users'
        formula: @aql count_distinct(order_items, orders.user_id);;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'distinct_buying_users'
        label: 'Distinct Buying Users'
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }
  block k_stat_3: TextBlock {
    content: @md
**29.8%**

Cancelled or refunded orders in 2025 (3,266 of 10,934).
    ;;
  }
  block v_sec_1: VizBlock {
    label: 'Monthly gross merchandise value'
    viz: CombinationChart {
      dataset: ecommerce_official
      x_axis: VizFieldFull {
        ref: r(orders.created_at)
        label: 'Order Month'
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(ecommerce_official.revenue)
            label: 'Revenue'
            format {
              type: 'number'
              pattern: '[$$]#,###0.00'
            }
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }
  block v_sec_2: VizBlock {
    label: 'Gross merchandise value by category'
    viz: CombinationChart {
      dataset: ecommerce_official
      x_axis: VizFieldFull {
        ref: r(categories.name)
        label: 'Category'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          mark_type: 'bar'
          field: VizFieldFull {
            ref: r(ecommerce_official.revenue)
            label: 'Gross merchandise value'
            format {
              type: 'number'
              pattern: '[$$]#,###0.00'
            }
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }
  block v_sec_3: VizBlock {
    label: 'Gross merchandise value by buyer country'
    viz: CombinationChart {
      dataset: ecommerce_official
      x_axis: r(countries.name)
      y_axis {
        series {
          field: r(ecommerce_official.revenue)
        }
      }
    }
  }
  block v_table: VizBlock {
    label: 'Category and merchant evidence'
    viz: DataTable {
      dataset: ecommerce_official
      fields: [
        VizFieldFull {
          ref: r(categories.name)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(merchants.name)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(ecommerce_official.revenue)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(order_items.quantity)
          aggregation: 'sum'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(order_items.order_id)
          aggregation: 'count distinct'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        show_row_number: true
      }
    }
  }

  interactions: [
    FilterInteraction {
      from: 'f_date'
      to: [
        CustomMapping {
          block: [
            'k_hero',
            'k_stat_1',
            'k_stat_2',
            'v_sec_1',
            'v_sec_2',
            'v_sec_3',
            'v_table'
          ]
          field: r(orders.created_at)
        },
        CustomMapping {
          block: [
            'f_country'
          ]
          disabled: true
        }
      ]
    },
    FilterInteraction {
      from: 'f_country'
      to: [
        CustomMapping {
          block: [
            'k_hero',
            'k_stat_1',
            'k_stat_2',
            'v_sec_1',
            'v_sec_2',
            'v_sec_3',
            'v_table'
          ]
          field: r(countries.name)
        },
        CustomMapping {
          block: [
            'f_date'
          ]
          disabled: true
        }
      ]
    },
    PopInteraction {
      from: 'c_pop'
      to: [
        CustomMapping {
          block: [
            'k_hero',
            'k_stat_1',
            'k_stat_2',
            'v_sec_1'
          ]
          field: r(orders.created_at)
        }
      ]
    }
  ]

  view: HTMLLayout {
    content: @html
<style>@import url('https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&family=Roboto+Mono:wght@400;500&display=swap');</style>
<div class="dst">
  <section class="dst-sec dst-masthead is-unnumbered">
    <p class="dst-eyebrow dst-eyebrow-logo"><img class="dst-google-logo" src="https://www.gstatic.com/images/branding/searchlogo/ico/favicon.ico" alt="Google" />Annual performance story · ecommerce</p>
    <div class="dst-display"><h-block name="t_headline" /></div>
    <p class="dst-standfirst">A complete 2025 view of demand, buyer and order growth, and the execution-quality guardrail that keeps gross merchandise value in context.</p>
    <div class="dst-controls"><h-block name="f_date" /><h-block name="f_country" /><h-block name="c_pop" /></div>
    <p class="dst-byline">Prepared 4 September 2026 · full-year 2025 comparison</p>
  </section>
  <div class="dst-band"><section class="dst-sec is-unnumbered"><p class="dst-eyebrow">The number</p><div class="dst-hero"><div class="dst-hero-num"><p class="dst-hero-label">2025 gross merchandise value · all order statuses</p><h-block name="k_hero" /><div class="dst-hero-rule"></div></div><div class="dst-hero-note dst-copy"><h-block name="t_hero_note" /></div></div></section></div>
  <section class="dst-sec"><p class="dst-eyebrow"><span class="dst-n"></span>Momentum</p><div class="dst-split"><div class="dst-copy"><h-block name="t_sec_1" /></div><div class="dst-figure"><h-block name="v_sec_1" /></div></div></section>
  <section class="dst-sec is-flush"><p class="dst-eyebrow"><span class="dst-n"></span>The shape of demand</p><div class="dst-figure is-wide"><h-block name="v_sec_2" /></div><p class="dst-caption">Body led 2025 category gross merchandise value at $357,609; compare category breadth with the active country filter.</p></section>
  <div class="dst-tint"><section class="dst-sec"><p class="dst-eyebrow"><span class="dst-n"></span>The claim</p><div class="dst-pull-wrap"><div class="dst-pull"><h-block name="t_pull" /></div></div></section></div>
  <section class="dst-sec"><p class="dst-eyebrow"><span class="dst-n"></span>Supporting evidence</p><div class="dst-stats"><div class="dst-stat"><h-block name="k_stat_1" /></div><div class="dst-stat"><h-block name="k_stat_2" /></div><div class="dst-stat"><h-block name="k_stat_3" /></div></div></section>
  <div class="dst-tint"><section class="dst-sec"><p class="dst-eyebrow"><span class="dst-n"></span>Market reach</p><div class="dst-split is-flip"><div class="dst-figure"><h-block name="v_sec_3" /></div><div class="dst-copy"><h-block name="t_sec_3" /></div></div></section></div>
  <section class="dst-sec"><p class="dst-eyebrow"><span class="dst-n"></span>The detail</p><div class="dst-figure is-table"><h-block name="v_table" /></div><p class="dst-caption">Gross merchandise value is SUM(quantity × product price), including delivered, cancelled, and refunded orders. It is not a realized-revenue measure.</p></section>
  <div class="dst-band"><section class="dst-sec is-unnumbered"><p class="dst-eyebrow">In short</p><div class="dst-copy"><h-block name="t_close" /></div><p class="dst-source">Source: @Dataset:ecommerce_official · validated full-year 2025 evidence</p></section></div>
</div>
    ;;
  }
}