@template(
  title='Claude Slides',
  description='Claude-styled presentation slide template',
  thumbnail=''
)
Dashboard claude_slides_2 {
  title: 'Claude slides'
  description: 'A reusable nine-slide executive presentation template in a warm editorial style: paired-metric cover, narrative cover, agenda, section divider, executive takeaway, performance trend, full-width analysis, comparative snapshot, and closing. Replace the placeholder copy and blocks before sharing.'
  // Local theme: transparent surfaces preserve the custom HTML slide backgrounds.
  theme: PageTheme {
    color {
      data: claude_slides_palette
    }
    background {
      bg_color: claude_slides_tokens("background")
    }
    canvas {
      background {
        bg_color: claude_slides_tokens("background")
      }
      border {
        border_width: 0
        border_radius: 18
        border_color: claude_slides_tokens("border")
        border_style: "none"
      }
      shadow: "none"
      opacity: 1
    }
    block {
      background {
        bg_color: claude_slides_tokens("background")
      }
      border {
        border_width: 0
        border_radius: 18
        border_color: claude_slides_tokens("border")
        border_style: "none"
      }
      shadow: "none"
      padding: 0
      opacity: 1
      label {
        font_family: claude_slides_tokens("font_display")
        font_size: 15
        font_color: claude_slides_tokens("text_primary")
        font_weight: "semibold"
        font_style: "normal"
        letter_spacing: "0"
      }
      text {
        font_family: claude_slides_tokens("font_body")
        font_size: 14
        font_color: claude_slides_tokens("text_muted")
        font_weight: "normal"
        font_style: "normal"
      }
    }
    viz {
      table {
        general {
          bg_color: "oklch(1 0 0)"
          font_color: claude_slides_tokens("text_muted")
          font_family: claude_slides_tokens("font_body")
          font_size: 14
          border_color: claude_slides_tokens("border")
          grid_color: claude_slides_tokens("border")
          border_width: 1
          hover_color: "oklch(0.985 0.006 85)"
          banding_color: "oklch(0.978 0.008 85)"
          cell_padding: DetailedSpacing {
            top: 14
            right: 20
            bottom: 14
            left: 20
          }
          borders {
            outer: true,
            vertical: false,
            horizontal: true,
            header: true,
            row_header: false
          }
        }
        header {
          bg_color: "oklch(0.966 0.012 85)"
          font_color: claude_slides_tokens("text_primary")
          font_size: 14
          font_weight: "semibold"
        }
        sub_header {
          bg_color: "oklch(0.978 0.008 85)"
          font_color: claude_slides_tokens("text_muted")
          font_size: 14
          font_weight: "medium"
        }
        sub_title {
          font_color: claude_slides_tokens("text_subtle")
          font_size: 13
          font_weight: "medium"
        }
        sparkline {
          line {
            color: claude_slides_tokens("primary")
          }
          column {
            color: claude_slides_tokens("primary")
          }
        }
      }
      metric_kpi {
        alignment: "left"
        label {
          font_family: claude_slides_tokens("font_body")
          font_size: 22
          font_color: claude_slides_tokens("text_muted")
        }
        value {
          font_family: claude_slides_tokens("font_display")
          font_size: 56
          font_color: claude_slides_tokens("text_primary")
        }
        progress {
          indicator {
            bg_color: claude_slides_tokens("primary")
          }
          track {
            bg_color: claude_slides_tokens("border")
          }
          text {
            font_color: claude_slides_tokens("text_muted")
          }
        }
        trend {
          positive {
            text {
              font_color: claude_slides_tokens("success")
              font_weight: "medium"
            }
            background {
              bg_color: "oklch(0.92 0.04 145)"
            }
          }
          negative {
            text {
              font_color: claude_slides_tokens("danger")
              font_weight: "medium"
            }
            background {
              bg_color: "oklch(0.92 0.04 25)"
            }
          }
          neutral {
            text {
              font_color: claude_slides_tokens("text_muted")
              font_weight: "normal"
            }
            background {
              bg_color: "oklch(0.94 0.01 85)"
            }
          }
        }
      }
    }
    custom_css: @css
      .terra .dac-text-block {
        font-family: Instrument Sans, Helvetica Neue, Helvetica, sans-serif;
        font-size: 14px;
        color: oklch(0.52 0.02 70);
        line-height: 1.6;
      }
      .terra .dac-text-block h1,
      .terra .dac-text-block h2,
      .terra .dac-text-block h3,
      .terra .dac-text-block h4,
      .terra .dac-text-block h5,
      .terra .dac-text-block h6 {
        font-family: Fraunces, Georgia, serif;
        color: oklch(0.27 0.01 70);
        line-height: 1.3;
        margin-top: 0;
        margin-bottom: 0.5em;
        font-weight: 600;
      }
    ;;
  }

  block k_cover_primary: TextBlock {
    content: @md First metric ;;
  }
  block k_cover_secondary: TextBlock {
    content: @md Second metric ;;
  }
  block k_takeaway: TextBlock {
    content: @md Takeaway metric ;;
  }
  block v_trend: TextBlock {
    content: @md Swap this block for a visualization. It will fill the frame around it. ;;
  }
  block v_full: TextBlock {
    content: @md Swap this block for a visualization that provides the supporting detail behind the trend. ;;
  }
  block v_compare_1: TextBlock {
    content: @md This is a smaller chart slot. ;;
  }
  block v_compare_2: TextBlock {
    content: @md This is a smaller chart slot. ;;
  }
  block v_compare_3: TextBlock {
    content: @md This is a smaller chart slot. ;;
  }
  block k_closing: TextBlock {
    content: @md Closing metric ;;
  }
  block t_cover: TextBlock {
    content: @md
      <div class="tr-eyebrow">This is an eyebrow</div>
      <h1 class="tr-headline">This is a title<br><span class="tr-accent">and a second line.</span></h1>
      <p class="tr-lede">Use the paired metrics to establish what matters most before the supporting story begins.</p>
    ;;
  }
  block t_narrative: TextBlock {
    content: @md
      <div class="tr-eyebrow">This is a narrative opener</div>
      <h2 class="tr-headline">This is a title<br><span class="tr-accent">and a second line.</span></h2>
      <p class="tr-lede">Use this opener when the story starts with a clear statement rather than a visual. Let the generous space do the work.</p>
    ;;
  }
  block t_agenda: TextBlock {
    content: @md
      <div class="tr-eyebrow">This is an agenda</div>
      <h2 class="tr-headline is-mid">This is a section title</h2>
      <ol class="tr-agenda">
        <li class="tr-agenda-item"><span class="tr-agenda-num">01</span><span class="tr-agenda-name">First title</span><span class="tr-agenda-note">This is a short note</span></li>
        <li class="tr-agenda-item"><span class="tr-agenda-num">02</span><span class="tr-agenda-name">Second title</span><span class="tr-agenda-note">Add or remove rows as you need</span></li>
        <li class="tr-agenda-item"><span class="tr-agenda-num">03</span><span class="tr-agenda-name">Third title</span><span class="tr-agenda-note">Three to six rows works best</span></li>
        <li class="tr-agenda-item"><span class="tr-agenda-num">04</span><span class="tr-agenda-name">Fourth title</span><span class="tr-agenda-note">The note is optional</span></li>
      </ol>
    ;;
  }
  block t_divider: TextBlock {
    content: @md
      <div class="tr-divider-inner">
        <div class="tr-divider-num" aria-hidden="true">01</div>
        <div>
          <h2 class="tr-headline">This is a section</h2>
          <p class="tr-lede">One line on what this section covers. Copy this slide between sections and change the numeral.</p>
        </div>
      </div>
    ;;
  }
  block t_takeaway: TextBlock {
    content: @md
      <div class="tr-eyebrow">This is a statement</div>
      <h2 class="tr-headline is-mid">This is the one sentence you want remembered.</h2>
      <p class="tr-lede">Keep this slide to one idea — the number carries it, and everything else is support.</p>
    ;;
  }
  block t_trend: TextBlock {
    content: @md
      <div class="tr-eyebrow">This is a chart slide</div>
      <h2 class="tr-headline is-mid">This is a title with a chart beside it</h2>
      <p class="tr-lede">The chart sits in a frame that fills the space next to it at any width.</p>
    ;;
  }
  block t_full: TextBlock {
    content: @md
      <div class="tr-eyebrow">Deep-dive analysis</div>
      <h2 class="tr-headline is-mid">See the full picture behind the trend</h2>
    ;;
  }
  block t_snapshot: TextBlock {
    content: @md <div class="tr-eyebrow">This is a card row</div>
<h2 class="tr-headline is-mid">This is a section title</h2>
<div class="tr-card-labels">
  <span>First title</span>
  <span>Second title</span>
  <span>Third title</span>
</div>;;
  }
  block t_closing: TextBlock {
    content: @md
      <div class="tr-eyebrow">This is the last slide</div>
      <h2 class="tr-headline">That's it.</h2>
      <div class="tr-meta">This is a caption. Change it or remove it.</div>
    ;;
  }

  view: HTMLLayout {
    content: @html

<div class="terra">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,900&family=Instrument+Sans:wght@400;500;600&display=swap');

    .terra,
    .terra *,
    .terra *::before,
    .terra *::after { box-sizing: border-box; }

    /* ---- THEME TOKENS — swap this block to reskin. Nothing below holds a hex. */
    .terra {
      --t-bg:        #F7F5F0;
      --t-ink:       #2A2724;
      --t-ink-dim:   rgba(42, 39, 36, 0.55);
      --t-card:      #FFFFFF;
      --t-accent:    #C96F4A;
      --t-accent-hi: #D97E58;
      --t-accent-lo: #B85C38;
      --t-sand:      #D9C9B4;
      --t-sand-hi:   #E3D5C2;
      --t-sand-lo:   #CDBBA1;
      --t-sage:      #8D9376;
      --t-on-dark:      #F7F5F0;
      --t-on-dark-dim:  rgba(247, 245, 240, 0.82);
      --t-border:       rgba(42, 39, 36, 0.18);
      --t-border-soft:  rgba(42, 39, 36, 0.14);
      --t-border-dark:  rgba(247, 245, 240, 0.28);
      --t-border-dark-soft: rgba(247, 245, 240, 0.22);
      --t-surface-dark: rgba(247, 245, 240, 0.08);
      --t-hover:        rgba(42, 39, 36, 0.08);
      --t-hover-dark:   rgba(247, 245, 240, 0.14);
      --t-shadow:       rgba(42, 39, 36, 0.10);
      --t-shadow-strong: rgba(42, 39, 36, 0.28);
      --t-shadow-medium: rgba(42, 39, 36, 0.22);
      --t-shadow-small: rgba(42, 39, 36, 0.3);
      --t-radius:      18px;
      --t-radius-sm:   12px;
      --t-pad:         clamp(28px, 6vw, 96px);
      --t-font-display: Fraunces, Georgia, serif;
      --t-font-sans:    'Instrument Sans', 'Helvetica Neue', Helvetica, sans-serif;
      --t-font-mono:    ui-monospace, 'SF Mono', Menlo, Consolas, monospace;

      font-family: var(--t-font-sans);
      color: var(--t-ink);
      background: var(--t-bg);
      border-radius: var(--t-radius);
      overflow: hidden;
      position: relative;
      height: 760px;
      display: flex;
      flex-direction: column;
    }

    /* ---- Slide visibility */
    .terra .tr-slide {
      display: none;
      flex: 1;
      flex-direction: column;
      padding: var(--t-pad);
      background: var(--t-bg);
      animation: tr-in 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .terra .tr-slide:target { display: flex; }
    .terra:not(:has(.tr-slide:target)) #tr-1 { display: flex; }

    @keyframes tr-in {
      from { opacity: 0; transform: translateY(10px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .terra .tr-slide.is-dark { background: var(--t-ink); color: var(--t-on-dark); }
    .terra .tr-slide.is-sand { background: var(--t-sand); }

    /* ---- Type scale */
    .terra .tr-eyebrow {
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.42em;
      text-transform: uppercase;
      color: var(--t-accent);
      margin-bottom: 22px;
    }
    .terra .tr-headline {
      font-family: var(--t-font-display);
      font-weight: 900;
      font-size: clamp(34px, 5.4vw, 78px);
      line-height: 1.02;
      margin: 0 0 26px 0;
    }
    .terra .tr-headline.is-mid { font-size: clamp(28px, 3.6vw, 52px); line-height: 1.14; }
    /* TextBlock defaults can override inherited color, so set dark-slide title colors explicitly. */
    .terra .is-dark .tr-headline,
    .terra .is-dark .tr-headline * { color: var(--t-on-dark) !important; }
    .terra .is-dark .tr-eyebrow,
    .terra .is-dark .tr-eyebrow * { color: var(--t-accent-hi) !important; }
    .terra .is-dark .tr-accent,
    .terra .is-dark .tr-accent * { color: var(--t-accent-hi) !important; }
    .terra .tr-accent { color: var(--t-accent); }
    .terra .tr-lede {
      font-size: 17px;
      line-height: 1.6;
      color: var(--t-ink-dim);
      max-width: 46ch;
      margin: 0;
    }
    .terra .is-dark .tr-lede { color: var(--t-on-dark-dim); }
    .terra .tr-meta {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.34em;
      text-transform: uppercase;
      color: var(--t-ink-dim);
    }
    .terra .is-dark .tr-meta { color: var(--t-on-dark-dim); }

    /* ---- Slide body */
    .terra .tr-body {
      flex: 1;
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      gap: clamp(24px, 4vw, 64px);
      align-items: center;
    }
    .terra .tr-body.is-single { grid-template-columns: minmax(0, 1fr); }
    .terra .tr-copy { display: flex; flex-direction: column; justify-content: center; }

    /* ---- Chart frames. Every one needs a min-height or the block collapses. */
    .terra .tr-frame {
      background: var(--t-card);
      border-radius: var(--t-radius);
      padding: 18px;
      min-height: 380px;
      display: flex;
      box-shadow: 0 16px 38px var(--t-shadow);
    }
    .terra .tr-frame > * { flex: 1; min-width: 0; }
    .terra .tr-frame.is-short { min-height: 220px; padding: 12px; }
    .terra .tr-frame .dac-viz-block { background: transparent; }
    .terra .is-dark .tr-frame {
      background: var(--t-surface-dark);
      box-shadow: none;
    }
    .terra .is-dark .tr-frame .dac-viz-block { color: var(--t-on-dark); }

    /* ---- Lozenge — the signature form. Cover KPIs only. */
    .terra .tr-lozenges {
      display: flex;
      gap: 22px;
      align-items: flex-end;
      justify-content: center;
    }
    .terra .tr-lozenge {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 10px;
      padding: 26px 20px;
      text-align: center;
    }
    .terra .tr-lozenge.is-tall {
      width: 190px;
      min-height: 280px;
      border-radius: 95px;
      background: linear-gradient(200deg, var(--t-accent-hi), var(--t-accent-lo));
      box-shadow: 0 24px 50px var(--t-shadow-strong);
    }
    .terra .tr-lozenge.is-short {
      width: 140px;
      min-height: 200px;
      border-radius: 70px;
      background: linear-gradient(180deg, var(--t-sand-hi), var(--t-sand-lo));
      box-shadow: 0 18px 40px var(--t-shadow-medium);
    }
    .terra .tr-lozenge-label {
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.3em;
      text-transform: uppercase;
    }
    .terra .tr-lozenge.is-tall .tr-lozenge-label { color: rgba(247, 245, 240, 0.8); }
    .terra .tr-lozenge.is-short .tr-lozenge-label { color: var(--t-ink-dim); }

    /* ---- Three-card slide */
    .terra .tr-cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 24px;
    }
    .terra .tr-card {
      background: var(--t-card);
      border-radius: var(--t-radius);
      padding: 20px;
      box-shadow: 0 16px 38px var(--t-shadow);
    }
    .terra .tr-card-chart {
      min-height: 200px;
      border-radius: var(--t-radius-sm);
      display: flex;
      margin-bottom: 16px;
    }
    .terra .tr-card-chart > * { flex: 1; min-width: 0; }
    .terra .tr-card-chart .dac-viz-block { background: transparent; }
    .terra .tr-card-foot {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .terra .tr-card-name { font-size: 20px; font-weight: 600; }
    .terra .tr-dot-mark {
      width: 22px;
      height: 22px;
      border-radius: 11px;
      margin-left: auto;
      flex-shrink: 0;
      box-shadow: 0 3px 8px var(--t-shadow-small);
    }
    .terra .tr-dot-mark.is-clay { background: linear-gradient(200deg, var(--t-accent-hi), var(--t-accent-lo)); }
    .terra .tr-dot-mark.is-sand { border-radius: 6px; background: linear-gradient(180deg, var(--t-sand-hi), var(--t-sand-lo)); }
    .terra .tr-dot-mark.is-sage { background: var(--t-sage); }
    .terra .tr-card-figure {
      font-family: var(--t-font-mono);
      font-size: 18px;
      font-weight: 600;
      color: var(--t-accent);
    }

    /* ---- Agenda, divider, and executive-takeaway slides */
    .terra .tr-agenda { list-style: none; padding: 0; margin: 28px 0 0; }
    .terra .tr-agenda-item {
      display: grid;
      grid-template-columns: 56px 1fr auto;
      gap: 20px;
      align-items: center;
      padding: 16px 0;
      border-top: 1px solid var(--t-border-soft);
    }
    .terra .tr-agenda-num { font-family: var(--t-font-mono); color: var(--t-accent); font-size: 14px; }
    .terra .tr-agenda-name { font-size: 20px; font-weight: 600; }
    .terra .tr-agenda-note { color: var(--t-ink-dim); font-size: 14px; }
    .terra .tr-divider { flex: 1; display: flex; align-items: center; }
    .terra .tr-divider .tr-divider-inner { display: grid; grid-template-columns: 0.45fr 1fr; gap: clamp(28px, 6vw, 96px); align-items: center; width: 100%; }
    .terra .tr-divider-num { font-family: var(--t-font-display); color: var(--t-accent); font-size: clamp(100px, 18vw, 240px); line-height: 0.8; }
    .terra .tr-card-labels { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin-top: 18px; font-size: 20px; font-weight: 600; }
    .terra .tr-takeaway { flex: 1; display: grid; grid-template-columns: 1fr auto; gap: clamp(28px, 6vw, 96px); align-items: center; }
    .terra .tr-takeaway-kpi { min-width: 210px; text-align: right; }
    .terra .tr-takeaway-kpi .h-kpi-metric-kpi, .terra .tr-takeaway-kpi .h-kpi-metric-kpi * { font-family: var(--t-font-display) !important; font-size: clamp(64px, 10vw, 120px) !important; font-weight: 900 !important; line-height: 1 !important; color: var(--t-on-dark) !important; background: transparent !important; }

    /* ---- Closing slide */
    .terra .tr-close {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      gap: 22px;
    }
    .terra .tr-rule {
      width: 72px;
      height: 6px;
      border-radius: 3px;
      background: var(--t-accent);
    }
    .terra .tr-close-kpi { min-height: 120px; display: flex; }
    .terra .tr-close-kpi > * { flex: 1; }
    .terra .tr-close-kpi .dac-viz-block { background: transparent; }

    /* ---- Navigation */
    .terra .tr-nav {
      display: flex;
      align-items: center;
      gap: 18px;
      margin-top: auto;
      padding-top: 22px;
      border-top: 1px solid var(--t-border-soft);
    }
    .terra .is-dark .tr-nav { border-top-color: var(--t-border-dark-soft); }
    .terra .tr-btn {
      display: inline-flex;
      align-items: center;
      padding: 11px 20px;
      border-radius: 999px;
      border: 1px solid var(--t-border);
      color: var(--t-ink);
      text-decoration: none;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      transition: background 0.2s ease, border-color 0.2s ease;
    }
    .terra .tr-btn:hover { background: var(--t-hover); }
    .terra .is-dark .tr-btn { color: var(--t-on-dark); border-color: var(--t-border-dark); }
    .terra .is-dark .tr-btn:hover { background: var(--t-hover-dark); }
    .terra .tr-btn.is-primary {
      background: var(--t-accent);
      border-color: var(--t-accent);
      color: var(--t-on-dark);
    }
    .terra .tr-btn.is-primary:hover { background: var(--t-accent-lo); }
    .terra .tr-btn.is-off { opacity: 0.5; pointer-events: none; }
    .terra .tr-btn:focus-visible,
    .terra .tr-dot:focus-visible {
      outline: 3px solid var(--t-accent-hi);
      outline-offset: 4px;
    }
    .terra .tr-count {
      font-family: var(--t-font-mono);
      font-size: 12px;
      color: var(--t-ink-dim);
      letter-spacing: 0.08em;
    }
    .terra .is-dark .tr-count { color: var(--t-on-dark-dim); }
    .terra .tr-dots { display: flex; gap: 8px; margin: 0 auto; }
    .terra .tr-dot {
      width: 26px;
      height: 4px;
      border-radius: 2px;
      background: var(--t-border);
      transition: width 0.25s ease, background 0.25s ease;
    }
    .terra .is-dark .tr-dot { background: var(--t-border-dark); }
    .terra .tr-dot.is-on { width: 40px; background: var(--t-accent); }

    /* ---- KPI blocks inherit the display face */
    .terra .tr-kpi-value .h-kpi-metric-kpi,
    .terra .tr-kpi-value .h-kpi-metric-kpi * {
      font-family: var(--t-font-display) !important;
      font-weight: 900 !important;
      font-size: 40px !important;
      line-height: 1 !important;
      background: transparent !important;
      border: none !important;
      padding: 0 !important;
      margin: 0 !important;
    }
    .terra .tr-lozenge.is-tall .tr-kpi-value * { color: var(--t-on-dark) !important; }
    .terra .tr-lozenge.is-short .tr-kpi-value * { color: var(--t-ink) !important; }
    .terra .tr-close-kpi .h-kpi-metric-kpi,
    .terra .tr-close-kpi .h-kpi-metric-kpi * {
      font-family: var(--t-font-display) !important;
      font-weight: 900 !important;
      font-size: 64px !important;
      color: var(--t-ink) !important;
      background: transparent !important;
    }

    /* ---- Narrow viewports */
    @media (max-width: 900px) {
      .terra { height: auto; overflow: visible; }
      .terra .tr-slide { flex: none; min-height: 760px; }
      .terra .tr-body,
      .terra .tr-takeaway,
      .terra .tr-divider .tr-divider-inner { grid-template-columns: minmax(0, 1fr); }
      .terra .tr-body { gap: 32px; }
      .terra .tr-frame { min-height: 300px; padding: 14px; }
      .terra .tr-card-chart { min-height: 180px; }
      .terra .tr-lozenges { justify-content: flex-start; }
      .terra .tr-takeaway-kpi { text-align: left; }
      .terra .tr-nav { flex-wrap: wrap; }
      .terra .tr-dots { margin: 0; order: 3; width: 100%; }
    }

    @media (max-width: 600px) {
      .terra { --t-pad: 24px; }
      .terra .tr-slide { min-height: 0; }
      .terra .tr-lozenges { flex-wrap: wrap; gap: 14px; }
      .terra .tr-lozenge.is-tall,
      .terra .tr-lozenge.is-short { width: min(100%, 220px); min-height: 170px; }
      .terra .tr-agenda-item { grid-template-columns: 44px 1fr; gap: 8px 12px; }
      .terra .tr-agenda-note { grid-column: 2; }
      .terra .tr-cards,
      .terra .tr-card-labels { grid-template-columns: minmax(0, 1fr); }
      .terra .tr-frame { min-height: 240px; }
      .terra .tr-nav { gap: 12px; }
      .terra .tr-btn { padding: 10px 14px; }
    }

    @media (prefers-reduced-motion: reduce) {
      .terra .tr-slide { animation: none; }
      .terra .tr-btn,
      .terra .tr-dot { transition: none; }
    }
  </style>

