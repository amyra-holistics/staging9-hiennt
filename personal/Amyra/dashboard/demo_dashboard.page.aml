Dashboard all_viz_test {
  theme: DynamicPageTheme {
    light: purple
    dark: purple
  }
  title: 'All viz test'
  description: ''
  owner: 'hien.nt@holistics.io'
  block v_wx22: VizBlock {
    label: 'Diverging Bar Chart'
    viz: CustomChart {
      dataset: superstore
      calculation target {
        label: 'Average Profit Across All Sub Categories'
        formula: @aql superstore_csv | sum(superstore_csv.discount);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation current {
        label: 'Profit'
        formula: @aql superstore_csv | sum(superstore_csv.quantity);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation value {
        label: 'Profit - Average Profit'
        formula: @aql current - target*30;;
        calc_type: 'measure'
        data_type: 'number'
      }
      custom_chart: diverging_bar_chart
      field dimension: VizFieldFull {
        ref: r(superstore_csv.sub_category)
        format {
          type: 'text'
        }
      }
      field value: VizFieldFull {
        ref: 'value'
        format {
          type: 'number'
          pattern: '#,###'
        }
      }
      setting positive_color: '#2cb67f'
      setting negative_color: '#e5484d'
      setting show_tooltip: false
      settings {
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_pareto_chart: VizBlock {
    label: 'Pareto Chart by Sub-Category'
    viz: CustomChart {
      dataset: superstore
      calculation sales_value {
        label: 'Sales Value'
        formula: @aql superstore_csv | sum(superstore_csv.sales);;
        calc_type: 'measure'
        data_type: 'number'
      }
      custom_chart: pareto_chart
      field dimension: VizFieldFull {
        ref: r(superstore_csv.sub_category)
        format {
          type: 'text'
        }
      }
      field value: VizFieldFull {
        ref: 'sales_value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      setting bar_color: '#255dd4'
      setting line_color: '#e5484d'
      setting show_threshold: true
      setting threshold: 0.8
      setting show_tooltip: false
      settings {
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
