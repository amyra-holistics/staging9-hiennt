  block v_ld9y: VizBlock {
    theme {
      padding {
        top: 56
        left: 16
        right: 16
        bottom: 16
      }
    }
    label: 'Total Revenue'
    viz: MetricKpi {
      dataset: superstore
      calculation sum_of_superstore_sales {
        label: 'Sum of Superstore Sales'
        formula: @aql sum(superstore_csv.sales);;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        label: 'Total Revenue'
        ref: 'sum_of_superstore_sales'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
    settings {
      hide_label: true
    }
  }
  block v_nrin: VizBlock {
    label: 'Total Sales copy'
    viz: MetricKpi {
      dataset: ecommerce_official
      value: VizFieldFull {
        label: 'Product listed'
        ref: r(products.name)
        aggregation: 'count distinct'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
    settings {
      hide_label: true
    }
    theme {
      padding {
        top: 56
        left: 16
        bottom: 16
        right: 16
      }
    }
  }
  block v_audi: VizBlock {
    label: 'Total Sales copy copy'
    viz: MetricKpi {
      dataset: ecommerce_official
      value: VizFieldFull {
        label: 'Merchant listed'
        ref: r(merchants.name)
        aggregation: 'count distinct'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
    settings {
      hide_label: true
    }
    theme {
      padding {
        top: 56
        left: 16
        bottom: 16
        right: 16
      }
    }
  }
  block v_acsc: VizBlock {
    theme {
      padding {
        top: 56
        left: 16
        right: 16
        bottom: 16
      }
    }
    label: 'Total Sales copy copy copy'
    viz: MetricKpi {
      dataset: superstore
      calculation sum_of_superstore_sales {
        label: 'Sum of Superstore Sales'
        formula: @aql sum(superstore_csv.sales);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation sum_of_superstore_profit {
        label: 'Sum of Superstore Profit'
        formula: @aql sum(superstore_csv.profit);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation count_of_superstore_order_id {
        label: 'Count of Superstore Order id'
        formula: @aql count(superstore_csv.order_id);;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        label: 'All-time Orders'
        ref: 'count_of_superstore_order_id'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
    settings {
      hide_label: true
    }
  }
