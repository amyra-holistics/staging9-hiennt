  block v_pgpo: VizBlock {
    label: 'Sunburst Chart'
    viz: CustomChart {
      dataset: superstore
      custom_chart: sunburst_chart
      field level_1: VizFieldFull {
        ref: r(superstore_csv.country)
        format {
          type: 'text'
