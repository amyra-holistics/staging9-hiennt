  block t_block_ha_page_header_bg: block_ha_page_header_bg()
  block t_block_ha_page_header: block_ha_page_header(
    'Sales and Orders',
    'Monitor overall sales performance, order trends, and fulfillment outcomes to understand revenue drivers and operational efficiency.'
  )
  block t_2pu8: TextBlock {
    theme: BlockTheme {
      background {
        bg_color: 'transparent'
      }
      border {
        border_width: 0
        border_style: 'none'
      }
      padding: 0
      shadow: 'none'
    }
    content: @md <img style="margin-left: -8px" src="https://cdn.holistics.io/logos/holistics-logo-white.svg" />;;
  }
  block v_fofr: VizBlock {
    label: 'Total Sales by Ship mode'
    viz: CombinationChart {
      dataset: superstore
      calculation sum_of_superstore_sales {
        label: 'Total Sales'
        formula: @aql sum(superstore_csv.sales);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation sum_of_superstore_profit {
        label: 'Total Profit'
        formula: @aql sum(superstore_csv.profit);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation sum_of_superstore_discount {
        label: 'Total Discount'
        formula: @aql sum(superstore_csv.discount);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation sum_of_superstore_sales_prev_1y {
        label: 'Sum Of Superstore Sales (prev. 1y)'
        formula: @aql sum_of_superstore_sales | relative_period(superstore_csv.order_date, interval(-1 year), strict: true);;
        calc_type: 'measure'
        data_type: 'number'
      }
      filter {
        field: r(superstore_csv.order_date)
        operator: 'matches'
        value: '2016-01-01 - 2017-12-31'
      }
      x_axis: VizFieldFull {
        ref: r(superstore_csv.order_date)
        transformation: 'datetrunc quarter'
        format {
          type: 'date'
          pattern: 'yyyy Qq'
        }
      }
      y_axis {
        settings {
          show_data_label_by: 'value'
        }
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: 'sum_of_superstore_sales'
            format {
              type: 'number'
              pattern: '#,###0.00"A"'
            }
          }
        }
      }
      y_axis {
        settings {
          alignment: 'right'
        }
        series {
          mark_type: 'line'
          field: VizFieldFull {
            label: 'Prev. 1 year'
            ref: 'sum_of_superstore_sales_prev_1y'
            format {
              type: 'number'
              pattern: '#,###0.00"A"'
            }
          }
        }
      }
      settings {
        row_limit: 10000
        x_axis_show_null_datetime: false
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_quxa: VizBlock {
    label: 'Sales by Segment'
    viz: PieChart {
      dataset: superstore
      calculation sum_of_superstore_sales {
        label: 'Total Sales'
        formula: @aql sum(superstore_csv.sales);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation sum_of_superstore_profit {
        label: 'Total Profit'
        formula: @aql sum(superstore_csv.profit);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation sum_of_superstore_discount {
        label: 'Total Discount'
        formula: @aql sum(superstore_csv.discount);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation sum_of_superstore_sales_prev_1y {
        label: 'Sum Of Superstore Sales (prev. 1y)'
        formula: @aql sum_of_superstore_sales | relative_period(superstore_csv.order_date, interval(-1 year), strict: true);;
        calc_type: 'measure'
        data_type: 'number'
      }
      filter {
        field: r(superstore_csv.order_date)
        operator: 'matches'
        value: '2016-01-01 - 2017-12-31'
      }
      legend: VizFieldFull {
        ref: r(superstore_csv.segment)
        format {
          type: 'text'
        }
      }
      series {
        field: VizFieldFull {
          label: ' '
          ref: 'sum_of_superstore_sales'
          format {
            type: 'number'
            pattern: '#,###0.00"A"'
          }
        }

      }
      settings {
        display_as_donut: true
        row_limit: 10000
        data_label_position: 'none'
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_ny30: VizBlock {
    label: 'User Signed Up'
    viz: MarkdownViz {
      dataset: ecommerce_dataset
      calculation users_users_signed_up_prev_1y {
        label: 'Users Users Signed Up (prev. 1y)'
        formula: @aql ecommerce_ga_users.users_signed_up_count | relative_period(ecommerce_users.sign_up_date, interval(-1 year), strict: true);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation users_users_signed_up_prev_1y_01 {
        label: 'Users Users Signed Up (prev. 1y) 01'
        formula: @aql ecommerce_users.users_signed_up_count | exact_period(ecommerce_users.sign_up_at, @(2026-03-01 - 2026-03-08));;
        calc_type: 'measure'
        data_type: 'number'
      }
      values: [
        VizFieldFull {
          label: 'PoP Comparison of Users Signed Up'
          ref: 'users_users_signed_up_prev_1y_01'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      content: @md <style>
.kpi-card {
  font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
  background: #3760D6;
  border-radius: 8px;
  padding: 8px;
  padding-top: 16px;
  color: white;
  width: 100%;
  height: 300px;
}

.kpi-title { font-size: 14px; font-weight: 400; letter-spacing: 0.05em; text-transform: uppercase; opacity: 0.9; }

.kpi-value {
  font-size: 56px;
  font-weight: 700;
  margin-top: 20px;
}

.kpi-change-row {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 40px;
}

.kpi-pill-blue {
  background: white;
  padding: 4px 12px;
  border-radius: 999px;
  color: #1A1A2E;
  font-size: 12px;
  font-weight: 500;
  align-items: center;
  gap: 6px;
}

.kpi-vs {
  opacity: 0.6;
  font-size: 14px;
}

</style>

<div class="kpi-card">

<!-- <div class="kpi-title">
Users Signed Up
</div> -->

<div class="kpi-value">
{{ rows[0].values.`Users Signed Up`.formatted }}
</div>

<div class="kpi-change-row">

<div class="kpi-pill-blue">
  <span style="vertical-align: middle;"> ▼  {{ rows[0].values.`PoP Comparison of Users Signed Up`.formatted }}</span>
</div>


</div>


</div>                     ;;
      settings {
        show_row_total: true
        show_column_total: true
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
