  block v_6dtp: VizBlock {
    label: 'Bump Chart by Category (Monthly, Top 5)'
    viz: CustomChart {
      dataset: superstore
      calculation order_month {
        label: 'Order Month'
        formula: @aql superstore_csv.order_date | month() ;;
        calc_type: 'dimension'
        data_type: 'date'
      }
      calculation sales_value {
        label: 'Sales Value'
        formula: @aql superstore_csv | sum(superstore_csv.sales);;
        calc_type: 'measure'
        data_type: 'number'
      }
      filter {
        field: r(superstore_bump_chart.category)
        operator: 'is'
        value: [
          'Art',
          'Phones',
          'Machines',
          'Labels',
          'Supplies',
          'Furnishings'
        ]
      }
      filter {
        field: r(superstore_bump_chart.period)
        operator: 'matches'
        value: '2017'
      }
      custom_chart: bump_chart
      field period: VizFieldFull {
        ref: r(superstore_bump_chart.month_name)
        format {
          type: 'text'
        }
      }
      field dimension: VizFieldFull {
        ref: r(superstore_bump_chart.category)
        format {
          type: 'text'
        }
      }
      field value: VizFieldFull {
        ref: r(superstore_bump_chart.value)
        aggregation: 'sum'
        format {
          type: 'number'
          pattern: 'none'
        }
      }
      setting line_interpolate: 'monotone'
      setting point_size: 500
      setting show_tooltip: false
      settings {
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
