        format {
          type: 'text'
        }
      }
      field series: VizFieldFull {
        ref: r(superstore_csv.region)
        format {
          type: 'text'
        }
      }
      field value: VizFieldFull {
        ref: 'sales_value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
