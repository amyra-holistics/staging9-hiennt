Dashboard all_viz {
  theme: DynamicPageTheme {
    light: brand_theme_light
    dark: brand_theme_dark
  }
  title: 'Demo dashboard'
  description: ''
  owner: 'hien.nt@holistics.io'
  block t_f8rx: block_ha_heading('All Metrics To Date')
  block t_block_ha_page_header_bg: block_ha_page_header_bg()
  block t_block_ha_page_header: block_ha_page_header('Sales', 'Monitor revenue, order volume, fulfillment mix, and customer markets.')
  block t_2pu8: TextBlock {
    theme: BlockTheme {
      background {
        bg_color: 'transparent'
      }
      border {
        border_width: 0
        border_style: 'none'
      }
      padding: 0
      shadow: 'none'
    }
    content: @md <img style="margin-left: -8px" src="https://cdn.holistics.io/logos/holistics-logo-white.svg" />;;
  }
  block v_fofr: VizBlock {
    label: 'Revenue by Order Month'
    viz: CombinationChart {
      dataset: ecommerce_official
      x_axis: VizFieldFull {
        ref: r(orders.created_at)
        label: 'Order Month'
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(ecommerce_official.revenue)
            label: 'Revenue'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }
  block v_quxa: VizBlock {
    label: 'Revenue by Order Status'
    viz: PieChart {
      dataset: ecommerce_official
      legend: VizFieldFull {
        ref: r(orders.status)
        label: 'Order Status'
        format {
          type: 'text'
        }
      }
      series {
        field: VizFieldFull {
          ref: r(ecommerce_official.revenue)
          label: 'Revenue'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      }
      settings {
        display_as_donut: true
        legend_label: 'bottom'
        show_data_label: true
        show_percentage: true
        data_label_position: 'outside'
        show_total: true
        sort: 'asc'
      }
    }
  }
  block v_ld9y: VizBlock {
    label: 'Revenue'
    viz: MetricKpi {
      dataset: ecommerce_official
      value: VizFieldFull {
        label: 'Revenue'
        ref: r(ecommerce_official.revenue)
        format {
          type: 'number'
          pattern: '#,###0.00"A"'
        }
      }
      settings {
        display_mode: 'single'
      }
    }
    settings {
      hide_label: true
    }
    theme {
      padding {
        top: 56
        left: 16
        bottom: 16
        right: 16
      }
    }
  }
  block v_nrin: VizBlock {
    label: 'Product Count'
    viz: MetricKpi {
      dataset: ecommerce_official
      theme {
        metric_kpi {
          label {
            font_size: 16
          }
          value {
            font_size: 44
          }
        }
      }
      value: VizFieldFull {
        label: 'Product listed'
        ref: r(products.name)
        aggregation: 'count distinct'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
    settings {
      hide_label: true
    }
    theme {
      padding {
        top: 56
        left: 16
        bottom: 16
        right: 16
      }
    }
  }
  block v_audi: VizBlock {
    label: 'Merchant Count'
    viz: MetricKpi {
      dataset: ecommerce_official
      theme {
        metric_kpi {
          label {
            font_size: 16
          }
          value {
            font_size: 44
          }
        }
      }
      value: VizFieldFull {
        label: 'Merchant listed'
        ref: r(merchants.name)
        aggregation: 'count distinct'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
    settings {
      hide_label: true
    }
    theme {
      padding {
        top: 56
        left: 16
        bottom: 16
        right: 16
      }
    }
  }
  block v_acsc: VizBlock {
    label: 'Distinct Orders'
    viz: MetricKpi {
      dataset: ecommerce_official
      calculation distinct_order_count {
        label: 'Distinct Orders'
        formula: @aql orders | count_distinct(orders.id);;
        calc_type: 'measure'
        data_type: 'number'
      }
      theme {
        metric_kpi {
          label {
            font_size: 16
          }
          value {
            font_size: 44
          }
        }
      }
      value: VizFieldFull {
        ref: 'distinct_order_count'
        label: 'Distinct Orders'
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
    }
    settings {
      hide_label: true
    }
    theme {
      padding {
        top: 56
        left: 16
        bottom: 16
        right: 16
      }
    }
  }
  block f_order_date: FilterBlock {
    label: 'Order date range'
    type: 'field'
    source: FieldFilterSource {
      dataset: ecommerce_official
      field: r(orders.created_at)
    }
    default {
      operator: 'matches'
      value: '$H_NIL$'
    }
  }
  block f_customer_country: FilterBlock {
    label: 'Customer country'
    type: 'field'
    source: FieldFilterSource {
      dataset: ecommerce_official
      field: r(countries.name)
    }
    default {
      operator: 'is'
      value: '$H_NIL$'
    }
    settings {
      input_type: 'multiple'
    }
  }
  block v_sales_country: VizBlock {
    label: 'Revenue by Customer Country'
    viz: BarChart {
      dataset: ecommerce_official
      x_axis: VizFieldFull {
        ref: r(countries.name)
        label: 'Customer Country'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(ecommerce_official.revenue)
            label: 'Revenue'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }
  block v_products_categories: VizBlock {
    label: 'Revenue by Product Category'
    viz: CombinationChart {
      dataset: ecommerce_official
      x_axis: VizFieldFull {
        ref: r(categories.name)
        label: 'Product Category'
      }
      y_axis {
        label: 'Revenue'
        series {
          mark_type: 'bar'
          field: VizFieldFull {
            ref: r(ecommerce_official.revenue)
            label: 'Revenue'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }
  block v_products_table: VizBlock {
    label: 'Top Products by Revenue'
    viz: DataTable {
      dataset: ecommerce_official
      calculation total_units_sold {
        label: 'Total Units Sold'
        formula: @aql order_items | sum(order_items.quantity);;
        calc_type: 'measure'
        data_type: 'number'
      }
      fields: [
        VizFieldFull {
          ref: r(products.name)
          label: 'Product Name'
          format {
            type: 'text'
          }
          uname: 'product_name'
        },
        VizFieldFull {
          ref: r(products.price)
          label: 'Product Price'
          format {
            type: 'number'
            pattern: '[$$]#,###0.00'
          }
        },
        VizFieldFull {
          ref: r(ecommerce_official.revenue)
          label: 'Revenue'
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'revenue'
        },
        VizFieldFull {
          ref: 'total_units_sold'
          label: 'Total Units Sold'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
      ]
      settings {
        pagination_size: 20
        show_row_number: true
        row_limit: 20
        sorts: [
          KeyBasedSortSetting {
            key: 'revenue'
            direction: 'desc'
          },
          KeyBasedSortSetting {
            key: 'product_name'
            direction: 'asc'
          },
        ]
        wrap_header_text: true
        wrap_cell_text: false
      }
    }
  }
  block v_products_bubble: VizBlock {
    label: 'Product Price, Units, and Revenue'
    viz: BubbleChart {
      dataset: ecommerce_official
      calculation total_units_sold {
        label: 'Total Units Sold'
        formula: @aql order_items | sum(order_items.quantity);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation top_100_product_ids {
        label: 'Top 100 Product Ids'
        formula: @aql top(100, products.id, by: revenue, logic: 'dense');;
        calc_type: 'measure'
        data_type: 'json'
      }
      x_col: VizFieldFull {
        ref: r(products.price)
        label: 'Product Price'
        format {
          type: 'number'
          pattern: '[$$]#,###0.00'
        }
      }
      y_col: VizFieldFull {
        ref: 'total_units_sold'
        label: 'Total Units Sold'
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      z_col: VizFieldFull {
        ref: r(ecommerce_official.revenue)
        label: 'Revenue'
        format {
          type: 'number'
          pattern: '[$$]#,###0.00'
        }
      }
      label_col: VizFieldFull {
        ref: r(products.name)
        label: 'Product Name'
      }
      conditions: [
        "products.id in top_100_product_ids",
      ]
      settings {
        row_limit: 100
      }
    }
  }
  block v_users_count: VizBlock {
    label: 'Registered Users'
    viz: MetricKpi {
      dataset: ecommerce_official
      calculation distinct_registered_user_count {
        label: 'Distinct Registered User Count'
        formula: @aql users | count_distinct(users.id);;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'distinct_registered_user_count'
        label: 'Distinct Registered User Count'
        format {
          type: 'number'
          pattern: '#,###'
        }
      }
      theme {
        metric_kpi {
          label {
            font_size: 16
          }
          value {
            font_size: 44
          }
        }
      }
    }
    settings {
      hide_label: true
    }
    theme {
      padding {
        top: 56
        left: 16
        bottom: 16
        right: 16
      }
    }
  }
  block v_users_signup: VizBlock {
    label: 'User Signups by Month'
    viz: CombinationChart {
      dataset: ecommerce_official
      calculation distinct_registered_users {
        label: 'Distinct Registered Users'
        formula: @aql users | count_distinct(users.id);;
        calc_type: 'measure'
        data_type: 'number'
      }
      x_axis: VizFieldFull {
        ref: r(users.sign_up_date)
        label: 'Sign Up Month'
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: 'distinct_registered_users'
            label: 'Distinct Registered Users'
            format {
              type: 'number'
              pattern: '#,###0'
            }
          }
        }
      }
      settings {
        x_axis_label: 'Sign Up Month'
        legend_label: 'hidden'
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }
  block v_users_gender: VizBlock {
    label: 'Revenue by User Gender'
    viz: PieChart {
      dataset: ecommerce_official
      legend: VizFieldFull {
        ref: r(users.gender)
        label: 'User Gender'
      }
      series {
        field: VizFieldFull {
          ref: r(ecommerce_official.revenue)
          label: 'Revenue'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      }
      settings {
        display_as_donut: true
        legend_label: 'bottom'
        show_data_label: true
        show_percentage: true
        data_label_position: 'outside'
        show_total: true
        sort: PieFamilySort {
          type: 'pie'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }
  block v_users_table: VizBlock {
    label: 'Top Customers by Revenue'
    viz: DataTable {
      dataset: ecommerce_official
      calculation distinct_order_count {
        label: 'Distinct Order Count'
        formula: @aql orders | count_distinct(orders.id);;
        calc_type: 'measure'
        data_type: 'number'
      }
      fields: [
        VizFieldFull {
          ref: r(users.full_name)
          label: 'Customer Full Name'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(countries.name)
          label: 'Customer Country'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(ecommerce_official.revenue)
          label: 'Revenue'
          uname: 'revenue'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: 'distinct_order_count'
          label: 'Distinct Order Count'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        }
      ]
      settings {
        pagination_size: 20
        show_row_number: true
        row_limit: 20
        sorts: [
          KeyBasedSortSetting {
            key: 'revenue'
            direction: 'desc'
          }
        ]
        wrap_header_text: true
      }
    }
  }
  block t_pour: TextBlock {
    theme: BlockTheme {
      background {
        bg_color: 'transparent'
      }
      border {
        border_width: 0
        border_style: 'none'
      }
      padding: 0
      shadow: 'none'
    }
    content: @md <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path fill="currentColor" fill-rule="evenodd" d="M22 12c0 5.523-4.477 10-10 10S2 17.523 2 12S6.477 2 12 2s10 4.477 10 10" clip-rule="evenodd" opacity="0.25"/><path fill="currentColor" d="M12.75 6a.75.75 0 0 0-1.5 0v.317c-1.63.292-3 1.517-3 3.183c0 1.917 1.813 3.25 3.75 3.25c1.377 0 2.25.906 2.25 1.75s-.873 1.75-2.25 1.75c-1.376 0-2.25-.906-2.25-1.75a.75.75 0 0 0-1.5 0c0 1.666 1.37 2.891 3 3.183V18a.75.75 0 0 0 1.5 0v-.317c1.63-.292 3-1.517 3-3.183c0-1.917-1.813-3.25-3.75-3.25c-1.376 0-2.25-.906-2.25-1.75s.874-1.75 2.25-1.75c1.377 0 2.25.906 2.25 1.75a.75.75 0 0 0 1.5 0c0-1.666-1.37-2.891-3-3.183z"/></svg>;;
  }
