  block v_l240: VizBlock {
    label: 'Waterfall Chart - Profit by Sub-Category'
    viz: CustomChart {
      dataset: superstore
      calculation profit_value {
        label: 'Profit'
        formula: @aql superstore_csv | sum(superstore_csv.profit);;
        calc_type: 'measure'
        data_type: 'number'
      }
      custom_chart: waterfall_chart
      field amount: VizFieldFull {
        ref: 'profit_value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      field label: VizFieldFull {
        ref: r(superstore_csv.sub_category)
        format {
          type: 'text'
        }
      }
      field sort_order: VizFieldFull {
        ref: r(superstore_csv.sales)
        aggregation: 'sum'
        format {
          type: 'number'
          pattern: 'none'
        }
      }
      setting end_label: 'Total'
      setting bar_padding: 0.3
      setting positive: '#58A65C'
      setting negative: '#D85140'
      setting value_format: '$,.0f'
      settings {
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_tlgf: VizBlock {
    label: 'Histogram of Sales'
    viz: CustomChart {
      dataset: superstore
      custom_chart: histogram
      field dimension: VizFieldFull {
        ref: r(superstore_csv.product_name)
        format {
          type: 'text'
        }
      }
      field value: VizFieldFull {
        ref: r(superstore_csv.quantity)
        format {
          type: 'number'
          pattern: 'none'
        }
      }
      setting max_bins: 0
      settings {
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_tswk: VizBlock {
    label: 'Bullet Chart by Category'
    viz: CustomChart {
      dataset: superstore
      calculation target {
        label: 'Target'
        formula: @aql (superstore_csv | sum(superstore_csv.sales)) * 0.2 + 30000;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation current {
        label: 'Current'
        formula: @aql superstore_csv | sum(superstore_csv.profit);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation pace {
        label: 'Pace'
        formula: @aql current * 1.25;;
        calc_type: 'measure'
        data_type: 'number'
      }
      custom_chart: bullet_chart
      field dimension: VizFieldFull {
        ref: r(superstore_csv.sub_category)
        format {
          type: 'text'
        }
      }
      field target: VizFieldFull {
        ref: 'target'
        format {
          type: 'number'
          pattern: 'none'
        }
      }
      field pace: VizFieldFull {
        ref: 'pace'
        format {
          type: 'number'
          pattern: 'none'
        }
      }
      field current: VizFieldFull {
        ref: 'current'
        format {
          type: 'number'
          pattern: 'none'
        }
      }
      setting show_tooltip: true
      setting current_bar_height: 7
      setting target_tick_thickness: 3
      settings {
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_6eft: VizBlock {
    label: 'Ridgeline Chart by Sub-Category'
    viz: CustomChart {
      dataset: superstore
      custom_chart: ridgeline_chart
      field dimension: VizFieldFull {
        ref: r(superstore_csv.sub_category)
        format {
          type: 'text'
        }
      }
      field value: VizFieldFull {
        ref: r(superstore_csv.profit)
        format {
          type: 'number'
          pattern: 'none'
        }
      }
      setting overlap: 2
      setting bandwidth: 0
      setting scale_by_count: false
      setting color_scheme: 'tableau10'
      settings {
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_4ulf: VizBlock {
    label: 'Radial Tree by Product Hierarchy'
    viz: CustomChart {
      dataset: superstore
      filter {
        field: r(superstore_csv.sub_category)
        operator: 'is'
        value: [
          'Appliances',
          'Chairs',
          'Supplies',
          'Tables',
          'Machines'
        ]
      }
      custom_chart: radial_tree
      field level_1: VizFieldFull {
        ref: r(superstore_csv.region)
        format {
          type: 'text'
        }
      }
      field level_2: VizFieldFull {
        ref: r(superstore_csv.state)
        format {
          type: 'text'
        }
      }
      field level_3: VizFieldFull {
        ref: r(superstore_csv.category)
        format {
          type: 'text'
        }
      }
      setting root_label: 'All'
      setting layout: 'cluster'
      setting link_shape: 'diagonal'
      setting spread: 360
      setting show_labels: true
      setting color_scheme: 'magma'
      settings {
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_gq1g: VizBlock {
    label: 'Sankey Chart - Region to Category Sales'
    viz: CustomChart {
      dataset: superstore
      calculation sales_value {
        label: 'Sales Value'
        formula: @aql superstore_csv | sum(superstore_csv.sales);;
        calc_type: 'measure'
        data_type: 'number'
      }
      custom_chart: sankey_chart
      field source: VizFieldFull {
        ref: r(superstore_csv.region)
        format {
          type: 'text'
        }
      }
      field target: VizFieldFull {
        ref: r(superstore_csv.category)
        format {
          type: 'text'
        }
      }
      field value: VizFieldFull {
        ref: 'sales_value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      setting node_align: 'justify'
      setting node_width: 15
      setting node_padding: 10
      settings {
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_wfvk: VizBlock {
    label: 'Table Heatmap - Daily Sales'
    viz: CustomChart {
      dataset: superstore
      calculation sales_value {
        label: 'Sales Value'
        formula: @aql superstore_csv | sum(superstore_csv.sales);;
        calc_type: 'measure'
        data_type: 'number'
      }
      custom_chart: table_heatmap
      field date: VizFieldFull {
        ref: r(superstore_csv.order_date)
        format {
          type: 'date'
          pattern: 'inherited'
        }
      }
      field value: VizFieldFull {
        ref: 'sales_value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_l07f: VizBlock {
    label: 'Treemap - Sales by Sub-Category'
    viz: CustomChart {
      dataset: superstore
      calculation sales_value {
        label: 'Sales Value'
        formula: @aql superstore_csv | sum(superstore_csv.sales);;
        calc_type: 'measure'
        data_type: 'number'
      }
      custom_chart: treemap
      field dimension: VizFieldFull {
        ref: r(superstore_csv.sub_category)
        format {
          type: 'text'
        }
      }
      field value: VizFieldFull {
        ref: 'sales_value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      setting fill_color: '#255DD4'
      setting text_color: 'white'
      setting layout_method: 'squarify'
      settings {
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
