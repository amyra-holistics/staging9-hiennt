Dashboard all_viz_test {
  theme: H.themes.midnight
  title: 'All viz test'
  description: ''
  owner: 'hien.nt@holistics.io'
  block v_faceted_sparkline: VizBlock {
    label: 'Sales Trend by Category'
    viz: CustomChart {
      dataset: superstore
      calculation sales_value {
        label: 'Sales Value'
        formula: @aql superstore_csv | sum(superstore_csv.sales);;
        calc_type: 'measure'
        data_type: 'number'
      }
      custom_chart: faceted_sparkline
      field date: VizFieldFull {
        ref: r(superstore_csv.order_date)
        format {
          type: 'date'
          pattern: 'inherited'
        }
      }
      field value: VizFieldFull {
        ref: 'sales_value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      field facet: VizFieldFull {
        ref: r(superstore_csv.sub_category)
        format {
          type: 'text'
        }
      }
      field series: VizFieldFull {
        ref: r(superstore_csv.sub_category)
        format {
          type: 'text'
        }
      }
      setting show_tooltip: true
      setting facet_columns: 3
      setting color_scheme: 'category10'
      settings {
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_wx22: VizBlock {
    label: 'Diverging Bar Chart'
    viz: CustomChart {
      dataset: superstore
      calculation target {
        label: 'Average Profit Across All Sub Categories'
        formula: @aql superstore_csv | sum(superstore_csv.discount);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation current {
        label: 'Profit'
        formula: @aql superstore_csv | sum(superstore_csv.quantity);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation value {
        label: 'Profit - Average Profit'
        formula: @aql current - target*30;;
        calc_type: 'measure'
        data_type: 'number'
      }
      filter {
        field: r(superstore_csv.sub_category)
        operator: 'is_not'
        value: 'Binders'
      }
      custom_chart: diverging_bar_chart
      field dimension: VizFieldFull {
        ref: r(superstore_csv.sub_category)
        format {
          type: 'text'
        }
      }
      field value: VizFieldFull {
        ref: 'value'
        format {
          type: 'number'
          pattern: 'none'
        }
      }
      setting positive_color: '#2cb67f'
      setting negative_color: '#e5484d'
      setting show_tooltip: true
      settings {
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_annotated_time_series: VizBlock {
    label: 'Annotated Sales Time Series'
    viz: CustomChart {
      dataset: superstore
      calculation event_label {
        label: 'Event Label'
        formula: @aql case(
          when: superstore_csv.order_date is @(2014-01-01), then: '2014 Start',
          when: superstore_csv.order_date is @(2014-11-28), then: '2014 Black Friday',
          when: superstore_csv.order_date is @(2014-12-25), then: '2014 Christmas',
          when: superstore_csv.order_date is @(2015-01-01), then: '2015 Start',
          when: superstore_csv.order_date is @(2015-11-27), then: '2015 Black Friday',
          when: superstore_csv.order_date is @(2015-12-25), then: '2015 Christmas',
          when: superstore_csv.order_date is @(2016-01-01), then: '2016 Start',
          when: superstore_csv.order_date is @(2016-11-25), then: '2016 Black Friday',
          when: superstore_csv.order_date is @(2016-12-25), then: '2016 Christmas',
          when: superstore_csv.order_date is @(2017-01-01), then: '2017 Start',
          when: superstore_csv.order_date is @(2017-11-24), then: '2017 Black Friday',
          when: superstore_csv.order_date is @(2017-12-25), then: '2017 Christmas',
          else: null
        ) ;;
        calc_type: 'dimension'
        data_type: 'text'
      }
      calculation total_sales {
        label: 'Total Sales'
        formula: @aql superstore_csv | sum(superstore_csv.sales);;
        calc_type: 'measure'
        data_type: 'number'
      }
      filter {
        field: r(superstore_csv.order_date)
        operator: 'after'
        value: '2016-01-01'
      }
      custom_chart: annotated_time_series
      field date: VizFieldFull {
        ref: r(superstore_csv.order_date)
        transformation: 'datetrunc day'
        format {
          type: 'date'
          pattern: 'LLL dd, yyyy'
        }
      }
      field value: VizFieldFull {
        ref: r(superstore_csv.sales)
        aggregation: 'sum'
        format {
          type: 'number'
          pattern: 'none'
        }
      }
      field event_label: VizFieldFull {
        ref: 'event_label'
        format {
          type: 'text'
        }
      }
      setting line_color: '#255DD4'
      setting event_color: '#e5484d'
      settings {
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_bump_chart: VizBlock {
    label: 'Bump Chart by Category (Monthly, Top 5)'
    viz: CustomChart {
      dataset: superstore
      calculation order_month {
        label: 'Order Month'
        formula: @aql superstore_csv.order_date | month() ;;
        calc_type: 'dimension'
        data_type: 'date'
      }
      calculation sales_value {
        label: 'Sales Value'
        formula: @aql superstore_csv | sum(superstore_csv.sales);;
        calc_type: 'measure'
        data_type: 'number'
      }
      filter {
        field: r(superstore_bump_chart.category)
        operator: 'is'
        value: [
          'Art',
          'Phones',
          'Machines',
          'Labels',
          'Supplies',
          'Furnishings'
        ]
      }
      filter {
        field: r(superstore_bump_chart.period)
        operator: 'matches'
        value: '2017'
      }
      custom_chart: bump_chart
      field period: VizFieldFull {
        ref: r(superstore_bump_chart.month_name)
        format {
          type: 'text'
        }
      }
      field dimension: VizFieldFull {
        ref: r(superstore_bump_chart.category)
        format {
          type: 'text'
        }
      }
      field value: VizFieldFull {
        ref: r(superstore_bump_chart.value)
        aggregation: 'sum'
        format {
          type: 'number'
          pattern: 'none'
        }
      }
      setting color_scheme: 'accent'
      setting line_interpolate: 'monotone'
      setting point_size: 100
      settings {
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_slope_chart: VizBlock {
    label: 'Sales Slope Chart by Category (2016 vs 2017)'
    viz: CustomChart {
      dataset: superstore
      custom_chart: slope_chart
      field period: VizFieldFull {
        ref: r(superstore_csv.order_date)
        transformation: 'datetrunc year'
