  }
  block t_zz87: TextBlock {
    theme: BlockTheme {
      background {
        bg_color: 'transparent'
      }
      border {
        border_width: 0
        border_style: 'none'
      }
      padding: 0
      shadow: 'none'
    }
    content: @md <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path fill="currentColor" d="M8.422 20.618C10.178 21.54 11.056 22 12 22V12L2.638 7.073l-.04.067C2 8.154 2 9.417 2 11.942v.117c0 2.524 0 3.787.597 4.801c.598 1.015 1.674 1.58 3.825 2.709z"/><path fill="currentColor" d="m17.577 4.432l-2-1.05C13.822 2.461 12.944 2 12 2c-.945 0-1.822.46-3.578 1.382l-2 1.05C4.318 5.536 3.242 6.1 2.638 7.072L12 12l9.362-4.927c-.606-.973-1.68-1.537-3.785-2.641" opacity="0.5"/><path fill="currentColor" d="m21.403 7.14l-.041-.067L12 12v10c.944 0 1.822-.46 3.578-1.382l2-1.05c2.151-1.129 3.227-1.693 3.825-2.708c.597-1.014.597-2.277.597-4.8v-.117c0-2.525 0-3.788-.597-4.802" opacity="0.25"/><path fill="currentColor" d="m6.323 4.484l.1-.052l1.493-.784l9.1 5.005l4.025-2.011q.205.232.362.498c.15.254.262.524.346.825L17.75 9.964V13a.75.75 0 0 1-1.5 0v-2.286l-3.5 1.75v9.44A3 3 0 0 1 12 22c-.248 0-.493-.032-.75-.096v-9.44l-8.998-4.5c.084-.3.196-.57.346-.824q.156-.266.362-.498l9.04 4.52l3.387-1.693z"/></svg>;;
  }
  block t_4o8m: TextBlock {
    theme: BlockTheme {
      background {
        bg_color: 'transparent'
      }
      border {
        border_width: 0
        border_style: 'none'
      }
      padding: 0
      shadow: 'none'
    }
    content: @md <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path fill="currentColor" d="M5.574 4.691c-.833.692-1.052 1.862-1.491 4.203l-.75 4c-.617 3.292-.926 4.938-.026 6.022S5.88 20 9.23 20h5.54c3.35 0 5.025 0 5.924-1.084c.9-1.084.591-2.73-.026-6.022l-.75-4c-.439-2.34-.658-3.511-1.491-4.203C17.593 4 16.403 4 14.02 4H9.98c-2.382 0-3.572 0-4.406.691" opacity="0.25"/><path fill="currentColor" d="M12 9.25a2.25 2.25 0 0 1-2.122-1.5a.75.75 0 1 0-1.414.5a3.751 3.751 0 0 0 7.073 0a.75.75 0 1 0-1.414-.5A2.25 2.25 0 0 1 12 9.25"/></svg>;;
  }
  block t_business_header_bg: block_ha_page_header_bg()
  block t_business_header: block_ha_page_header('Business', '''This page provides you a quick understanding of the current shape and scope of the business. <br /> If you have any questions, please don't hesitate to <a href="mailto:hi@holistics.io" style="text-decoration: underline; color: white ">contact us here</a>.''')
  block t_business_logo: TextBlock {
    theme: BlockTheme {
      background {
        bg_color: 'transparent'
      }
      border {
        border_width: 0
        border_style: 'none'
      }
      padding: 0
      shadow: 'none'
    }
    content: @md <img style="margin-left: -8px" src="https://cdn.holistics.io/logos/holistics-logo-white.svg" />;;
  }
  block t_products_header_bg: block_ha_page_header_bg()
  block t_products_header: block_ha_page_header('Products', 'Browse the live product catalog alongside category and product performance.')
  block t_products_logo: TextBlock {
    theme: BlockTheme {
      background {
        bg_color: 'transparent'
      }
      border {
        border_width: 0
        border_style: 'none'
      }
      padding: 0
      shadow: 'none'
    }
    content: @md <img style="margin-left: -8px" src="https://cdn.holistics.io/logos/holistics-logo-white.svg" />;;
  }
  block t_users_header_bg: block_ha_page_header_bg()
  block t_users_header: block_ha_page_header('Users', 'Follow acquisition, customer activity, value, and purchase cohort retention.')
  block t_users_logo: TextBlock {
    theme: BlockTheme {
      background {
        bg_color: 'transparent'
      }
      border {
        border_width: 0
        border_style: 'none'
      }
      padding: 0
      shadow: 'none'
    }
    content: @md <img style="margin-left: -8px" src="https://cdn.holistics.io/logos/holistics-logo-white.svg" />;;
  }
  block v_business_aov: VizBlock {
    label: 'Average Order Value'
    theme {
      padding {
        top: 56
        left: 16
        bottom: 16
        right: 16
      }
    }
    viz: MetricKpi {
      dataset: ecommerce_official
      theme {
        metric_kpi {
          label {
            font_size: 16
          }
          value {
            font_size: 44
          }
        }
      }
      calculation distinct_order_count {
        label: 'Distinct Order Count'
        formula: @aql orders | count_distinct(orders.id);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation average_order_value {
        label: 'Average Order Value'
        formula: @aql safe_divide(revenue, distinct_order_count);;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'average_order_value'
        label: 'Average Order Value'
        format {
          type: 'number'
          pattern: '[$$]#,###0.00'
        }
      }
      settings {
        display_mode: 'single'
      }
    }
    settings {
      hide_label: true
    }
  }
  block v_business_kpi_table: VizBlock {
    label: 'Monthly KPI Overview'
    viz: MetricSheet {
      dataset: ecommerce_official
      calculation distinct_order_count {
        label: 'Distinct Orders'
        formula: @aql orders | count_distinct(orders.id);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation average_order_value {
        label: 'Average Order Value'
        formula: @aql safe_divide(revenue, distinct_order_count);;
        calc_type: 'measure'
        data_type: 'number'
      }
      date_field: VizFieldFull {
        label: 'Order Month'
        ref: r(orders.created_at)
        transformation: 'datetrunc quarter'
        format {
          type: 'date'
          pattern: 'yyyy Qq'
        }
      }
      rows: [
        MetricSeries {
          field: VizFieldFull {
            label: 'Revenue'
            ref: r(ecommerce_official.revenue)
            format {
              type: 'number'
              pattern: '[$$]#,###0.00'
            }
          }
        },
        MetricSeries {
          field: VizFieldFull {
            label: 'Distinct Orders'
            ref: 'distinct_order_count'
            format {
              type: 'number'
              pattern: '#,###0'
            }
          }
        },
        MetricSeries {
          field: VizFieldFull {
            label: 'Average Order Value'
            ref: 'average_order_value'
            format {
              type: 'number'
              pattern: '[$$]#,###0.00'
            }
          }
        }
      ]
      settings {
        max_column: 7
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_business_map: VizBlock {
    label: 'Revenue Map by Country'
    viz: FilledMap {
      dataset: ecommerce_official
      location {
        field: VizFieldFull {
          label: 'Country Name'
          ref: r(countries.name)
        }
        location_type: 'country'
        primary_field: true
      }
      value: VizFieldFull {
        label: 'Revenue'
        ref: r(ecommerce_official.revenue)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      tooltips: [
        VizTooltip {
          field: VizFieldFull {
            label: 'Revenue'
            ref: r(ecommerce_official.revenue)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      ]
      settings {
        location_colors {
        }
      }
    }
  }
  block v_products_catalog: VizBlock {
    label: 'Product Catalog'
    viz: DataTable {
      dataset: ecommerce_official
      fields: [
        VizFieldFull {
          label: 'Product Image'
          ref: r(products.product_image)
          format {
            type: 'html'
          }
        },
        VizFieldFull {
          label: 'Product Name'
          ref: r(products.name)
          format {
            type: 'text'
          }
          uname: 'products_name_1'
        },
        VizFieldFull {
          label: 'Category'
          ref: r(categories.name)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'Product Price'
          ref: r(products.price)
          format {
            type: 'number'
            pattern: '[$$]#,###0.00'
          }
        },
        VizFieldFull {
          label: 'Revenue'
          ref: r(ecommerce_official.revenue)
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'custom_revenue_1'
        },
      ]
      settings {
        pagination_size: 100
        show_row_number: true
        wrap_header_text: true
        sorts: [
          KeyBasedSortSetting {
            key: 'custom_revenue_1'
            direction: 'desc'
          },
          KeyBasedSortSetting {
            key: 'products_name_1'
            direction: 'asc'
          },
        ]
      }
    }
  }
  block v_users_activity: VizBlock {
    label: 'Monthly Customer Activity'
    viz: CombinationChart {
      dataset: ecommerce_official
      calculation active_customer_count {
        label: 'Active Customer Count'
        formula: @aql orders | count_distinct(orders.user_id);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation repeat_customer_count {
        label: 'Repeat Customer Count'
        formula: @aql unique(orders.user_id)
      | select(order_count: orders | count_distinct(orders.id))
      | filter(order_count > 1)
      | count(orders.user_id);;
        calc_type: 'measure'
        data_type: 'number'
      }
      x_axis: VizFieldFull {
        ref: r(orders.created_at)
        label: 'Order Month'
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        label: 'Customers'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: 'active_customer_count'
            label: 'Active Customer Count'
            format {
              type: 'number'
              pattern: '#,###'
            }
          }
        }
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: 'repeat_customer_count'
            label: 'Repeat Customer Count'
            format {
              type: 'number'
              pattern: '#,###'
            }
          }
        }
      }
      settings {
        legend_label: 'top'
        x_axis_label: 'Order Month'
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }
  block v_users_retention: VizBlock {
    label: 'Purchase Cohort Retention'
    viz: PivotTable {
      dataset: ecommerce_official
      calculation first_purchase_month {
        label: 'First Purchase Month'
        formula: @aql orders | min(orders.created_at | month()) | dimensionalize(users.id);;
        calc_type: 'dimension'
        data_type: 'datetime'
        model: users
      }
      calculation months_since_first_purchase {
        label: 'Months Since First Purchase'
        formula: @aql date_diff('month', users.first_purchase_month, (orders.created_at | month()));;
        calc_type: 'dimension'
        data_type: 'number'
        model: orders
      }
      calculation purchasing_user_count {
        label: 'Purchasing User Count'
        formula: @aql orders | count_distinct(orders.user_id);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation cohort_size {
        label: 'Cohort Size'
        formula: @aql users | count_distinct(users.id);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation retention_rate {
        label: 'Retention Rate'
        formula: @aql purchasing_user_count * 100.0 / (cohort_size | exclude_grains(orders.months_since_first_purchase, keep_filters: true));;
        calc_type: 'measure'
        data_type: 'number'
      }
      rows: [
        VizFieldFull {
          ref: ref('users', 'first_purchase_month')
          label: 'Cohort Month'
          uname: 'cohort_month'
          format {
            type: 'date'
            pattern: 'LLL yyyy'
          }
        }
      ]
      columns: [
        VizFieldFull {
          ref: ref('orders', 'months_since_first_purchase')
          label: 'Months Since First Purchase'
          uname: 'months_since_first_purchase'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        }
      ]
      values: [
        VizFieldFull {
          ref: 'retention_rate'
          label: 'Retention Rate'
          format {
            type: 'number'
            pattern: '#,###0.0\\%'
          }
        }
      ]
      settings {
        show_row_total: false
        show_column_total: false
        show_sub_total: false
        empty_cell_as_zero: false
        pagination_size: 100
        wrap_header_text: true
        sorts: [
          KeyBasedSortSetting {
            key: 'cohort_month'
            direction: 'asc'
          },
          KeyBasedSortSetting {
            key: 'months_since_first_purchase'
            direction: 'asc'
          }
        ]
        conditional_formats: [
          ConditionalFormat {
            ref: 'retention_rate'
            format: ScaleFormat {
              min {
                value: 0
                color: '#FEE2E2'
              }
              mid {
                value: 50
                color: '#FEF3C7'
              }
              max {
                value: 100
                color: '#BBF7D0'
              }
            }
          }
        ]
      }
    }
  }
  block v_sales_comparison: VizBlock {
    label: 'Revenue vs Previous Month'
    viz: CombinationChart {
      dataset: ecommerce_official
      calculation previous_month_revenue {
        label: 'Previous Month Revenue'
        formula: @aql revenue | relative_period(orders.created_at, interval(-1 month));;
        calc_type: 'measure'
        data_type: 'number'
      }
      x_axis: VizFieldFull {
        label: 'Order Month'
        ref: r(orders.created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        label: 'Revenue'
        settings {
          hidden: true
        }
        series {
          mark_type: 'column'
          field: VizFieldFull {
            label: 'Current Revenue'
            ref: r(ecommerce_official.revenue)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        series {
          mark_type: 'line'
          field: VizFieldFull {
            label: 'Previous Month Revenue'
            ref: 'previous_month_revenue'
            format {
              type: 'number'
              pattern: '[$$]#,###0.00'
            }
          }
        }
      }
      settings {
        show_data_points: true
        sort {
          field_index: 0
          direction: 'asc'
          type: 'xaxis'
        }
        legend_label: 'hidden'
        x_axis_label: 'Order Month'
        x_axis_show_null_datetime: false
      }
    }
    settings {
      hide_label: true
    }
  }
  block v_sales_detail: VizBlock {
    label: 'Sales Detail'
    viz: DataTable {
      dataset: ecommerce_official
      calculation distinct_order_count {
        label: 'Distinct Orders'
        formula: @aql order_items | count_distinct(orders.id);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation total_units_sold {
        label: 'Units Sold'
        formula: @aql order_items | sum(order_items.quantity);;
        calc_type: 'measure'
        data_type: 'number'
      }
      fields: [
        VizFieldFull {
          ref: r(orders.status)
          label: 'Order Status'
          uname: 'order_status'
        },
        VizFieldFull {
          ref: r(countries.name)
          label: 'Customer Country'
          uname: 'customer_country'
        },
        VizFieldFull {
          ref: r(categories.name)
          label: 'Product Category'
          uname: 'product_category'
        },
        VizFieldFull {
          ref: 'distinct_order_count'
          label: 'Distinct Orders'
          format {
            type: 'number'
            pattern: '#,###0'
          }
          uname: 'distinct_orders'
        },
        VizFieldFull {
          ref: 'total_units_sold'
          label: 'Units Sold'
          format {
            type: 'number'
            pattern: '#,###0'
          }
          uname: 'units_sold'
        },
        VizFieldFull {
          ref: r(ecommerce_official.revenue)
          label: 'Revenue'
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'revenue'
        },
      ]
      settings {
        pagination_size: 50
        show_row_number: true
        row_limit: 50
        wrap_header_text: true
        wrap_cell_text: true
        sorts: [
          KeyBasedSortSetting {
            key: 'revenue'
            direction: 'desc'
          },
          KeyBasedSortSetting {
            key: 'order_status'
            direction: 'asc'
          },
          KeyBasedSortSetting {
            key: 'customer_country'
            direction: 'asc'
          },
          KeyBasedSortSetting {
            key: 'product_category'
            direction: 'asc'
          },
        ]
      }
    }
  }
  block f_sales_category: FilterBlock {
    label: 'Product category'
    type: 'field'
    source: FieldFilterSource {
      dataset: ecommerce_official
      field: r(categories.name)
    }
    default {
      operator: 'is'
      value: '$H_NIL$'
    }
    settings {
      input_type: 'multiple'
    }
  }
  block t_business_orders_icon: TextBlock {
    content: @md <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><circle cx="15" cy="6" r="3" fill="#05264c" opacity="0.4"/><ellipse cx="16" cy="17" fill="#05264c" opacity="0.4" rx="5" ry="3"/><circle cx="9.001" cy="6" r="4" fill="#05264c"/><ellipse cx="9.001" cy="17.001" fill="#05264c" rx="7" ry="4"/></svg>;;
  }
  block f_users_signup_date: FilterBlock {
    label: 'Signup date range'
    type: 'field'
    source: FieldFilterSource {
      dataset: ecommerce_official
      field: r(users.sign_up_date)
    }
    default {
      operator: 'matches'
      value: '$H_NIL$'
    }
  }
  block t_ihk0: TextBlock {
    theme: BlockTheme {
      background {
        bg_color: 'transparent'
      }
      border {
        border_width: 0
        border_style: 'none'
      }
      padding: 0
      shadow: 'none'
    }
    content: @md <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><circle cx="15" cy="6" r="3" fill="#05264c" opacity="0.4"/><ellipse cx="16" cy="17" fill="#05264c" opacity="0.4" rx="5" ry="3"/><circle cx="9.001" cy="6" r="4" fill="#05264c"/><ellipse cx="9.001" cy="17.001" fill="#05264c" rx="7" ry="4"/></svg>;;
  }
  block v_ueqh: VizBlock {
    label: 'GMV by Country Name and Month today'
    viz: MarkdownViz {
      dataset: ecommerce_official
      calculation today {
        label: 'today'
        formula: @aql @today;;
        calc_type: 'dimension'
        data_type: 'datetime'
        model: countries
      }
      rows: [
        VizFieldFull {
          label: 'Country Name'
          ref: r(countries.name)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: ref('countries', 'today')
          transformation: 'datetrunc month'
          format {
            type: 'date'
            pattern: 'LLL yyyy'
          }
        }
      ]
      values: [
        VizFieldFull {
          label: 'GMV'
          ref: r(ecommerce_official.revenue)
          format {
            type: 'number'
            pattern: '#,###0.00"A" [$$]'
            group_separator: ','
            decimal_separator: '.'
          }
        }
      ]
      content: @md <style>
    .annotation-minimal {
        position: relative;
        padding-left: 20px;
height: 100%
    }

    .annotation-minimal::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 3px;
        background: linear-gradient(180deg, #05264c, #00627a);
        border-radius: 2px;
    }

    .annotation-minimal .annotation-label {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #259b6c;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .annotation-minimal .content {
        font-size: 15px;
        line-height: 1.6;
        color: #374151;
    }

    .annotation-minimal .highlight {
        font-weight: 600;
        color: #05264c;
    }

    .annotation-minimal .meta {
        margin-top: 10px;
        font-size: 12px;
        color: #9ca3af;
    }
</style>

<div class="annotation-minimal">
    <div class="annotation-label">Key Insight</div>
    <div class="content">
        Our sales performance is anchored in developed Western markets, with the <span class="highlight">{{ rows[0].`Country Name` }}</span> ({{ rows[0].values.`GMV`}}), <span class="highlight">{{ rows[1].`Country Name` }}</span> ({{ rows[1].values.`GMV`}}), and <span  class="highlight">{{ rows[2].`Country Name` }}</span> ({{ rows[02].values.`GMV`}}), emerging as our top revenue contributors.
    </div>
    <div class="meta"><span>{{ rows[0].`today` }}</span> - Peter Parker</div>
</div>  ;;
      settings {
        show_row_total: true
        show_column_total: true
      }
    }
    settings {
      hide_label: true
    }
  }
