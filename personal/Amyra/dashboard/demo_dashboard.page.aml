  block v_i3qe: VizBlock {
    label: 'Bullet Chart by Category'
    viz: CustomChart {
      dataset: superstore
      calculation target {
        label: 'Target'
        formula: @aql (superstore_csv | sum(superstore_csv.sales)) * 0.2 + 30000;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation current {
        label: 'Current'
        formula: @aql superstore_csv | sum(superstore_csv.profit);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation pace {
        label: 'Pace'
        formula: @aql current * 1.25;;
        calc_type: 'measure'
        data_type: 'number'
      }
      custom_chart: bullet_chart
      field dimension: VizFieldFull {
        ref: r(superstore_csv.sub_category)
        format {
          type: 'text'
        }
      }
      field target: VizFieldFull {
        ref: 'target'
        format {
          type: 'number'
          pattern: 'none'
        }
      }
      field pace: VizFieldFull {
        ref: 'pace'
        format {
          type: 'number'
          pattern: 'none'
        }
      }
      field current: VizFieldFull {
        ref: 'current'
        format {
          type: 'number'
          pattern: 'none'
        }
      }
      setting show_tooltip: false
      setting current_bar_height: 7
      setting target_tick_thickness: 3
      settings {
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_1lc3: VizBlock {
    label: 'Ridgeline Chart by Sub-Category'
    viz: CustomChart {
      dataset: superstore
      custom_chart: ridgeline_chart
      field dimension: VizFieldFull {
        ref: r(superstore_csv.sub_category)
        format {
          type: 'text'
        }
      }
      field value: VizFieldFull {
        ref: r(superstore_csv.profit)
        format {
          type: 'number'
          pattern: 'none'
        }
      }
      setting overlap: 2
      setting bandwidth: 0
      setting scale_by_count: false
      setting color_scheme: 'tableau10'
      setting show_tooltip: false
      settings {
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_cak9: VizBlock {
    label: 'Radial Tree by Product Hierarchy'
    viz: CustomChart {
      dataset: superstore
      filter {
        field: r(superstore_csv.sub_category)
        operator: 'is'
        value: [
          'Appliances',
          'Chairs',
          'Supplies',
          'Tables',
          'Machines'
        ]
      }
      custom_chart: radial_tree
      field level_1: VizFieldFull {
        ref: r(superstore_csv.region)
        format {
          type: 'text'
        }
      }
      field level_2: VizFieldFull {
        ref: r(superstore_csv.state)
        format {
          type: 'text'
        }
      }
      field level_3: VizFieldFull {
        ref: r(superstore_csv.category)
        format {
          type: 'text'
        }
      }
      setting root_label: 'All'
      setting layout: 'cluster'
      setting link_shape: 'diagonal'
      setting spread: 360
      setting show_labels: true
      setting color_scheme: 'magma'
      setting show_tooltip: false
      settings {
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_oex3: VizBlock {
    label: 'Sankey Chart - Region to Category Sales'
    viz: CustomChart {
      dataset: superstore
      calculation sales_value {
        label: 'Sales Value'
        formula: @aql superstore_csv | sum(superstore_csv.sales);;
        calc_type: 'measure'
        data_type: 'number'
      }
      custom_chart: sankey_chart
      field source: VizFieldFull {
        ref: r(superstore_csv.region)
        format {
          type: 'text'
        }
      }
      field target: VizFieldFull {
        ref: r(superstore_csv.category)
        format {
          type: 'text'
        }
      }
      field value: VizFieldFull {
        ref: 'sales_value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      setting node_align: 'justify'
      setting node_width: 15
      setting node_padding: 10
      setting show_tooltip: false
      settings {
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_xgpv: VizBlock {
    label: 'Table Heatmap - Daily Sales'
    viz: CustomChart {
      dataset: superstore
      calculation sales_value {
        label: 'Sales Value'
        formula: @aql superstore_csv | sum(superstore_csv.sales);;
        calc_type: 'measure'
        data_type: 'number'
      }
      custom_chart: table_heatmap
      setting show_tooltip: false
      field date: VizFieldFull {
        ref: r(superstore_csv.order_date)
        format {
          type: 'date'
          pattern: 'inherited'
        }
      }
      field value: VizFieldFull {
        ref: 'sales_value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_f115: VizBlock {
    label: 'Treemap - Sales by Sub-Category'
    viz: CustomChart {
      dataset: superstore
      calculation sales_value {
        label: 'Sales Value'
        formula: @aql superstore_csv | sum(superstore_csv.sales);;
        calc_type: 'measure'
        data_type: 'number'
      }
      custom_chart: treemap
      field dimension: VizFieldFull {
        ref: r(superstore_csv.sub_category)
        format {
          type: 'text'
        }
      }
      field value: VizFieldFull {
        ref: 'sales_value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      setting fill_color: '#255DD4'
      setting text_color: 'white'
      setting layout_method: 'squarify'
      setting show_tooltip: false
      settings {
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_2nnb: VizBlock {
    label: 'Bubble Chart - Sales vs Profit sized by Quantity'
    viz: CustomChart {
      dataset: superstore
      custom_chart: bubble_chart
      setting show_tooltip: false
      field x_axis: VizFieldFull {
        ref: r(superstore_csv.sales)
        format {
          type: 'number'
          pattern: 'none'
        }
      }
      field y_axis: VizFieldFull {
        ref: r(superstore_csv.profit)
        format {
          type: 'number'
          pattern: 'none'
        }
      }
      field size: VizFieldFull {
        ref: r(superstore_csv.quantity)
        format {
          type: 'number'
          pattern: 'none'
        }
      }
      field category: VizFieldFull {
        ref: r(superstore_csv.sub_category)
        format {
          type: 'text'
        }
      }
      settings {
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block f_superstore_csv_city: FilterBlock {
    label: 'Superstore csv City'
    type: 'field'
    source: FieldFilterSource {
      dataset: superstore
      field: r(superstore_csv.city)
    }
    default {
      operator: 'is'
      value: [
        'Aberdeen',
        'Abilene',
        'Akron',
        'Albuquerque',
        'Alexandria',
        'Allentown'
      ]
    }
  }
