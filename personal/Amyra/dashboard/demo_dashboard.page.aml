  block v_llp5: VizBlock {
    label: 'Candlestick Chart - Monthly Sales OHLC'
    viz: CustomChart {
      dataset: superstore
      calculation daily_sales {
        label: 'Daily Sales'
        formula: @aql unique(superstore_csv.order_date)
          | select(
            order_date: superstore_csv.order_date,
            month_order_date: superstore_csv.order_date | month(),
            daily_sales_value: superstore_csv | sum(superstore_csv.sales),
          );;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation low_value {
        label: 'Low'
        formula: @aql daily_sales | min(daily_sales_value);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation high_value {
        label: 'High'
        formula: @aql daily_sales | max(daily_sales_value);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation open_value {
        label: 'Open'
        formula: @aql daily_sales
          | select(
            open_daily_sales_value: first_value(daily_sales_value, order: order_date | asc(), partition: month_order_date),
          )
          | max(open_daily_sales_value);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation close_value {
        label: 'Close'
        formula: @aql daily_sales
          | select(
            close_daily_sales_value: last_value(daily_sales_value, order: order_date | asc(), partition: month_order_date),
          )
          | max(close_daily_sales_value);;
        calc_type: 'measure'
        data_type: 'number'
      }
      custom_chart: candlestick_chart
      field date: VizFieldFull {
        ref: r(superstore_csv.order_date)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'inherited'
        }
      }
      field low: VizFieldFull {
        ref: 'low_value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      field high: VizFieldFull {
        ref: 'high_value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      field open: VizFieldFull {
        ref: 'open_value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      field close: VizFieldFull {
        ref: 'close_value'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      setting tooltip: true
      setting green_candle: 'green'
      setting red_candle: 'red'
      settings {
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
