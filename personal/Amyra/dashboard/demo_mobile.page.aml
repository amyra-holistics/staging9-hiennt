Dashboard demo_mobile {
  title: 'Ecommerce Performance (Mobile)'
  description: @md A fluid, screen-size-agnostic layout: no fixed page or slide height, sections reflow using CSS grid auto-fit and clamp() instead of fixed breakpoints.;;
  owner: 'hien.nt@holistics.io'
  // Local theme: transparent surfaces so the custom HTML backgrounds show through.
  // Colors, fonts and chart palette follow brand_theme_light, matching the report and slide decks.
  theme: PageTheme {
    color {
      data: brand_color_palette
    }
    background {
      bg_color: "transparent"
    }
    canvas {
      background {
        bg_color: "transparent"
      }
      border {
        border_width: 0
        border_radius: 12
        border_color: "#D1D5DB"
        border_style: "none"
      }
      shadow: "none"
      opacity: 1
    }
    block {
      background {
        bg_color: "transparent"
      }
      border {
        border_width: 0
        border_radius: 12
        border_color: "#D1D5DB"
        border_style: "none"
      }
      shadow: "none"
      padding: 0
      opacity: 1
      label {
        font_family: "Inter"
        font_size: 14
        font_color: "#05264C"
        font_weight: "semibold"
        font_style: "normal"
        letter_spacing: "0"
      }
      text {
        font_family: "Inter"
        font_size: 13
        font_color: "#374151"
        font_weight: "normal"
        font_style: "normal"
      }
    }
    viz {
      table {
        general {
          bg_color: "#FFFFFF"
          font_color: "#374151"
          font_family: "Inter"
          font_size: 13
          border_color: "#D1D5DB"
          grid_color: "#D1D5DB"
          border_width: 1
          hover_color: "#F5F8FA"
          banding_color: "#F9FAFB"
          cell_padding: DetailedSpacing {
            top: 10
            right: 16
            bottom: 10
            left: 16
          }
          borders {
            outer: true,
            vertical: false,
            horizontal: true,
            header: true,
            row_header: false
          }
        }
        header {
          bg_color: "#FFFFFF"
          font_color: "#05264C"
          font_size: 13
          font_weight: "semibold"
        }
        sub_header {
          bg_color: "#F9FAFB"
          font_color: "#374151"
          font_size: 13
          font_weight: "medium"
        }
        sub_title {
          font_color: "#6B7280"
          font_size: 12
          font_weight: "medium"
        }
        sparkline {
          line {
            color: "#55c5c9"
          }
          column {
            color: "#05264C"
          }
        }
      }
      metric_kpi {
        alignment: "left"
        label {
          font_family: "Inter"
          font_size: 18
          font_color: "#374151"
        }
        value {
          font_family: "Inter"
          font_size: 44
          font_color: "#05264C"
        }
        progress {
          indicator {
            bg_color: "#05264C"
          }
          track {
            bg_color: "#D1D5DB"
          }
          text {
            font_color: "#374151"
          }
        }
        trend {
          positive {
            text {
              font_color: "#23a672"
              font_weight: "medium"
            }
            background {
              bg_color: "#e9f8f0"
            }
          }
          negative {
            text {
              font_color: "#c53030"
              font_weight: "medium"
            }
            background {
              bg_color: "#fcebec"
            }
          }
          neutral {
            text {
              font_color: "#374151"
              font_weight: "normal"
            }
            background {
              bg_color: "#F5F8FA"
            }
          }
        }
      }
    }
    custom_css: @css
      .mdash .dac-text-block {
        font-family: Inter;
        font-size: 14px;
        color: #374151;
        line-height: 1.6;
      }
    ;;
  }

  block f_order_date: FilterBlock {
    label: 'Order date range'
    type: 'field'
    source: FieldFilterSource {
      dataset: ecommerce_official
      field: r(orders.created_at)
    }
    default {
      operator: 'matches'
      value: '$H_NIL$'
    }
  }
  block f_customer_country: FilterBlock {
    label: 'Customer country'
    type: 'field'
    source: FieldFilterSource {
      dataset: ecommerce_official
      field: r(countries.name)
    }
    default {
      operator: 'matches'
      value: '$H_NIL$'
    }
    settings {
      input_type: 'multiple'
    }
  }

  block v_ld9y: VizBlock {
    label: 'Revenue'
    viz: MetricKpi {
      dataset: ecommerce_official
      value: VizFieldFull {
        label: 'Revenue'
        ref: r(ecommerce_official.revenue)
        format {
          type: 'number'
          pattern: '#,###0.00"A"'
        }
      }
      settings {
        display_mode: 'single'
      }
    }
    settings {
      hide_label: true
    }
  }
  block v_acsc: VizBlock {
    label: 'Distinct Orders'
    viz: MetricKpi {
      dataset: ecommerce_official
      calculation distinct_order_count {
        label: 'Distinct Orders'
        formula: @aql orders | count_distinct(orders.id);;
        calc_type: 'measure'
        data_type: 'number'
      }
      theme {
        metric_kpi {
          label {
            font_size: 16
          }
          value {
            font_size: 44
          }
        }
      }
      value: VizFieldFull {
        ref: 'distinct_order_count'
        label: 'Distinct Orders'
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
    }
    settings {
      hide_label: true
    }
  }
  block v_business_aov: VizBlock {
    label: 'Average Order Value'
    viz: MetricKpi {
      dataset: ecommerce_official
      theme {
        metric_kpi {
          label {
            font_size: 16
          }
          value {
            font_size: 44
          }
        }
      }
      calculation distinct_order_count {
        label: 'Distinct Order Count'
        formula: @aql orders | count_distinct(orders.id);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation average_order_value {
        label: 'Average Order Value'
        formula: @aql safe_divide(revenue, distinct_order_count);;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'average_order_value'
        label: 'Average Order Value'
        format {
          type: 'number'
          pattern: '[$$]#,###0.00'
        }
      }
      settings {
        display_mode: 'single'
      }
    }
    settings {
      hide_label: true
    }
  }
  block v_nrin: VizBlock {
    label: 'Product Count'
    viz: MetricKpi {
      dataset: ecommerce_official
      theme {
        metric_kpi {
          label {
            font_size: 16
          }
          value {
            font_size: 44
          }
        }
      }
      value: VizFieldFull {
        label: 'Product listed'
        ref: r(products.name)
        aggregation: 'count distinct'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
    settings {
      hide_label: true
    }
  }
  block v_audi: VizBlock {
    label: 'Merchant Count'
    viz: MetricKpi {
      dataset: ecommerce_official
      theme {
        metric_kpi {
          label {
            font_size: 16
          }
          value {
            font_size: 44
          }
        }
      }
      value: VizFieldFull {
        label: 'Merchant listed'
        ref: r(merchants.name)
        aggregation: 'count distinct'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
    settings {
      hide_label: true
    }
  }
  block v_users_count: VizBlock {
    label: 'Registered Users'
    viz: MetricKpi {
      dataset: ecommerce_official
      calculation distinct_registered_user_count {
        label: 'Distinct Registered User Count'
        formula: @aql users | count_distinct(users.id);;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'distinct_registered_user_count'
        label: 'Distinct Registered User Count'
        format {
          type: 'number'
          pattern: '#,###'
        }
      }
      theme {
        metric_kpi {
          label {
            font_size: 16
          }
          value {
            font_size: 44
          }
        }
      }
    }
    settings {
      hide_label: true
    }
  }
  block v_fofr: VizBlock {
    label: 'Revenue by Order Month'
    viz: CombinationChart {
      dataset: ecommerce_official
      x_axis: VizFieldFull {
        ref: r(orders.created_at)
        label: 'Order Month'
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(ecommerce_official.revenue)
            label: 'Revenue'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }
  block v_quxa: VizBlock {
    label: 'Revenue by Order Status'
    viz: PieChart {
      dataset: ecommerce_official
      legend: VizFieldFull {
        ref: r(orders.status)
        label: 'Order Status'
        format {
          type: 'text'
        }
      }
      series {
        field: VizFieldFull {
          ref: r(ecommerce_official.revenue)
          label: 'Revenue'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      }
      settings {
        display_as_donut: true
        legend_label: 'bottom'
        show_data_label: true
        show_percentage: true
        data_label_position: 'outside'
        show_total: true
        sort: 'asc'
      }
    }
  }
  block v_business_map: VizBlock {
    label: 'Revenue Map by Country'
    viz: FilledMap {
      dataset: ecommerce_official
      location {
        field: VizFieldFull {
          label: 'Country Name'
          ref: r(countries.name)
        }
        location_type: 'country'
        primary_field: true
      }
      value: VizFieldFull {
        label: 'Revenue'
        ref: r(ecommerce_official.revenue)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      tooltips: [
        VizTooltip {
          field: VizFieldFull {
            label: 'Revenue'
            ref: r(ecommerce_official.revenue)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      ]
      settings {
        location_colors {

        }
      }
    }
  }
  block v_sales_country: VizBlock {
    label: 'Revenue by Customer Country'
    viz: BarChart {
      dataset: ecommerce_official
      x_axis: VizFieldFull {
        ref: r(countries.name)
        label: 'Customer Country'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(ecommerce_official.revenue)
            label: 'Revenue'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }
  block v_products_categories: VizBlock {
    label: 'Revenue by Product Category'
    viz: CombinationChart {
      dataset: ecommerce_official
      x_axis: VizFieldFull {
        ref: r(categories.name)
        label: 'Product Category'
      }
      y_axis {
        label: 'Revenue'
        series {
          mark_type: 'bar'
          field: VizFieldFull {
            ref: r(ecommerce_official.revenue)
            label: 'Revenue'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }
  block v_products_table: VizBlock {
    label: 'Top Products by Revenue'
    viz: DataTable {
      dataset: ecommerce_official
      calculation total_units_sold {
        label: 'Total Units Sold'
        formula: @aql order_items | sum(order_items.quantity);;
        calc_type: 'measure'
        data_type: 'number'
      }
      fields: [
        VizFieldFull {
          ref: r(products.name)
          label: 'Product Name'
          format {
            type: 'text'
          }
          uname: 'product_name'
        },
        VizFieldFull {
          ref: r(products.price)
          label: 'Product Price'
          format {
            type: 'number'
            pattern: '[$$]#,###0.00'
          }
        },
        VizFieldFull {
          ref: r(ecommerce_official.revenue)
          label: 'Revenue'
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'revenue'
        },
        VizFieldFull {
          ref: 'total_units_sold'
          label: 'Total Units Sold'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
      ]
      settings {
        pagination_size: 20
        show_row_number: true
        row_limit: 20
        sorts: [
          KeyBasedSortSetting {
            key: 'revenue'
            direction: 'desc'
          },
          KeyBasedSortSetting {
            key: 'product_name'
            direction: 'asc'
          },
        ]
        wrap_header_text: true
        wrap_cell_text: false
      }
    }
  }
  block v_users_signup: VizBlock {
    label: 'User Signups by Month'
    viz: CombinationChart {
      dataset: ecommerce_official
      calculation distinct_registered_users {
        label: 'Distinct Registered Users'
        formula: @aql users | count_distinct(users.id);;
        calc_type: 'measure'
        data_type: 'number'
      }
      x_axis: VizFieldFull {
        ref: r(users.sign_up_date)
        label: 'Sign Up Month'
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: 'distinct_registered_users'
            label: 'Distinct Registered Users'
            format {
              type: 'number'
              pattern: '#,###0'
            }
          }
        }
      }
      settings {
        x_axis_label: 'Sign Up Month'
        legend_label: 'hidden'
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }
  block v_users_gender: VizBlock {
    label: 'Revenue by User Gender'
    viz: PieChart {
      dataset: ecommerce_official
      legend: VizFieldFull {
        ref: r(users.gender)
        label: 'User Gender'
      }
      series {
        field: VizFieldFull {
          ref: r(ecommerce_official.revenue)
          label: 'Revenue'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      }
      settings {
        display_as_donut: true
        legend_label: 'bottom'
        show_data_label: true
        show_percentage: true
        data_label_position: 'outside'
        show_total: true
        sort: PieFamilySort {
          type: 'pie'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }
  block v_users_table: VizBlock {
    label: 'Top Customers by Revenue'
    viz: DataTable {
      dataset: ecommerce_official
      calculation distinct_order_count {
        label: 'Distinct Order Count'
        formula: @aql orders | count_distinct(orders.id);;
        calc_type: 'measure'
        data_type: 'number'
      }
      fields: [
        VizFieldFull {
          ref: r(users.full_name)
          label: 'Customer Full Name'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(countries.name)
          label: 'Customer Country'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(ecommerce_official.revenue)
          label: 'Revenue'
          uname: 'revenue'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: 'distinct_order_count'
          label: 'Distinct Order Count'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        }
      ]
      settings {
        pagination_size: 20
        show_row_number: true
        row_limit: 20
        sorts: [
          KeyBasedSortSetting {
            key: 'revenue'
            direction: 'desc'
          }
        ]
        wrap_header_text: true
      }
    }
  }

  view: HTMLLayout {
    content: @html

<div class="mwrap">
<div class="mdash">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

    /* The wrapper is the size container: every cqw/container-query below tracks the dashboard's
       own box, not the browser viewport, so it adapts the same way embedded in a narrow panel
       as it does full-screen on a phone. */
    .mwrap { container-type: inline-size; width: 100%; }

    .mdash,
    .mdash *,
    .mdash *::before,
    .mdash *::after { box-sizing: border-box; }

    /* ---- TOKENS: Holistics brand, same palette as the report and slide decks. */
    .mdash {
      --m-ink:          #05264C;
      --m-body:         #374151;
      --m-dim:          #6B7280;
      --m-accent:       #2C6A95;
      --m-teal:         #55C5C9;
      --m-bg:           #F5F8FA;
      --m-card:         #FFFFFF;
      --m-border:       #E1E7EE;
      --m-dark:         linear-gradient(71deg, #05264C 0%, #0B4963 62%, #013D7D 100%);
      --m-on-dark:      #FFFFFF;
      --m-on-dark-dim:  rgba(255, 255, 255, 0.82);
      --m-shadow:       rgba(5, 38, 76, 0.10);
      --m-radius:       14px;
      --m-pad:          clamp(14px, 4cqw, 32px);
      --m-gap:          clamp(12px, 2.5cqw, 22px);
      --m-sans:         Inter, -apple-system, 'Segoe UI', Roboto, sans-serif;

      font-family: var(--m-sans);
      color: var(--m-body);
      background: var(--m-bg);
      border-radius: 16px;
      padding: var(--m-pad);
      display: flex;
      flex-direction: column;
      gap: var(--m-gap);
      font-size: 13px;
      line-height: 1.55;
      /* No fixed height anywhere in this file: the page is free to grow and scroll. */
    }

    /* ---- Hero */
    .mdash .m-hero { background: var(--m-dark); color: var(--m-on-dark); border-radius: var(--m-radius); padding: clamp(18px, 4cqw, 34px); display: flex; flex-direction: column; gap: 8px; }
    .mdash .m-hero-top { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
    .mdash .m-hero-top img { height: 20px; display: block; }
    .mdash .m-eyebrow { font-size: 10.5px; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: var(--m-teal); }
    .mdash .m-title { font-size: clamp(20px, 4.2cqw, 32px); font-weight: 800; margin: 0; letter-spacing: -0.01em; line-height: 1.1; }
    .mdash .m-lede { font-size: clamp(12.5px, 2cqw, 14.5px); color: var(--m-on-dark-dim); margin: 0; max-width: 64ch; }

    /* ---- Filters: each stretches to fill, wraps to its own row on narrow screens */
    .mdash .m-filters { display: flex; flex-wrap: wrap; gap: var(--m-gap); }
    .mdash .m-filter { flex: 1 1 220px; min-width: 200px; min-height: 74px; background: var(--m-card); border: 1px solid var(--m-border); border-radius: var(--m-radius); padding: 4px; display: flex; box-shadow: 0 8px 20px var(--m-shadow); }
    .mdash .m-filter > * { flex: 1; min-width: 0; }

    /* ---- Section heading */
    .mdash .m-section { display: flex; flex-direction: column; gap: 10px; }
    .mdash .m-h { font-size: clamp(11px, 1.6cqw, 12px); font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--m-ink); margin: 0; display: flex; align-items: center; gap: 8px; }
    .mdash .m-h::before { content: ''; width: 4px; height: 13px; border-radius: 2px; background: var(--m-teal); flex-shrink: 0; }

    /* ---- KPI grid: auto-fit reflows the column count by available width, no breakpoints needed */
    .mdash .m-kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: var(--m-gap); }
    .mdash .m-kpi { background: var(--m-card); border: 1px solid var(--m-border); border-top: 3px solid var(--m-teal); border-radius: var(--m-radius); padding: 14px 16px; min-height: 104px; display: flex; box-shadow: 0 8px 20px var(--m-shadow); }
    .mdash .m-kpi > * { flex: 1; min-width: 0; }

    /* ---- Chart frame. Needs an explicit min-height or the block collapses to 0. */
    .mdash .m-frame { background: var(--m-card); border: 1px solid var(--m-border); border-radius: var(--m-radius); padding: 12px; display: flex; min-height: clamp(260px, 44cqw, 380px); box-shadow: 0 8px 20px var(--m-shadow); }
    .mdash .m-frame > * { flex: 1; min-width: 0; }
    .mdash .m-frame .dac-viz-block { background: transparent; }

    /* ---- Two-up chart row: 2 columns when there's room, 1 when there isn't */
    .mdash .m-duo { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--m-gap); }

    /* ---- Tables: data tables don't reflow, so let them scroll horizontally instead of squeezing */
    .mdash .m-table { background: var(--m-card); border: 1px solid var(--m-border); border-radius: var(--m-radius); padding: 8px; overflow-x: auto; box-shadow: 0 8px 20px var(--m-shadow); }
    .mdash .m-table-inner { min-width: 560px; display: flex; }
    .mdash .m-table-inner > * { flex: 1; min-width: 0; }

    .mdash .m-foot { font-size: 11px; color: var(--m-dim); text-align: center; padding-top: 2px; }

    /* ---- Fine-tuning at very narrow widths. The grids above already reflow on their own;
       this only adjusts spacing and stacks the hero header. */
    @container (max-width: 480px) {
      .mdash { --m-pad: 14px; }
      .mdash .m-hero-top { flex-direction: column; align-items: flex-start; gap: 10px; }
    }
  </style>

  <div class="m-hero">
    <div class="m-hero-top">
      <div><p class="m-eyebrow">Ecommerce performance</p><h1 class="m-title">Sales, products &amp; customers</h1></div>
      <img src="https://cdn.holistics.io/logos/holistics-logo-white.svg" alt="Holistics" />
    </div>
    <p class="m-lede">A fluid view of the business built to resize with the screen it's on, from a phone to a wide monitor.</p>
  </div>

  <div class="m-filters">
    <div class="m-filter"><h-block name="f_order_date" /></div>
    <div class="m-filter"><h-block name="f_customer_country" /></div>
  </div>

  <div class="m-section">
    <h2 class="m-h">At a glance</h2>
    <div class="m-kpis">
      <div class="m-kpi"><h-block name="v_ld9y" /></div>
      <div class="m-kpi"><h-block name="v_acsc" /></div>
      <div class="m-kpi"><h-block name="v_business_aov" /></div>
      <div class="m-kpi"><h-block name="v_nrin" /></div>
      <div class="m-kpi"><h-block name="v_audi" /></div>
      <div class="m-kpi"><h-block name="v_users_count" /></div>
    </div>
  </div>

  <div class="m-section">
    <h2 class="m-h">Revenue trend</h2>
    <div class="m-frame"><h-block name="v_fofr" /></div>
  </div>

  <div class="m-section">
    <h2 class="m-h">Where revenue comes from</h2>
    <div class="m-duo">
      <div class="m-frame"><h-block name="v_quxa" /></div>
      <div class="m-frame"><h-block name="v_sales_country" /></div>
    </div>
  </div>

  <div class="m-section">
    <h2 class="m-h">Markets</h2>
    <div class="m-frame"><h-block name="v_business_map" /></div>
  </div>

  <div class="m-section">
    <h2 class="m-h">Products</h2>
    <div class="m-frame"><h-block name="v_products_categories" /></div>
    <div class="m-table"><div class="m-table-inner"><h-block name="v_products_table" /></div></div>
  </div>

  <div class="m-section">
    <h2 class="m-h">Customers</h2>
    <div class="m-duo">
      <div class="m-frame"><h-block name="v_users_signup" /></div>
      <div class="m-frame"><h-block name="v_users_gender" /></div>
    </div>
    <div class="m-table"><div class="m-table-inner"><h-block name="v_users_table" /></div></div>
  </div>

  <p class="m-foot">Source: ecommerce_official dataset</p>
</div>
</div>

    ;;
  }
  settings {
    autorun_on_open: true
  }
  explicit_interactions: [
    FilterInteraction {
      from: 'f_order_date'
      to: ['v_ld9y', 'v_acsc', 'v_business_aov', 'v_fofr', 'v_quxa', 'v_products_categories']
      field: r(orders.created_at)
    },
    FilterInteraction {
      from: 'f_customer_country'
      to: ['v_users_count', 'v_users_signup', 'v_users_gender', 'v_users_table']
      field: r(countries.name)
    }
  ]
}
