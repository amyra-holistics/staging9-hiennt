    .rpt .rpt-foot-page::before { content: counter(rpt-page, decimal-leading-zero) " / " var(--t-total); }

    /* ---- Content zone */
    .rpt .rpt-body { flex: 1; display: flex; flex-direction: column; min-height: 0; }

    /* ---- Cover (dark brand variant) */
    .rpt .rpt-page.is-cover { background: var(--t-dark); color: var(--t-on-dark); border-color: transparent; }
    .rpt .is-cover .rpt-foot { border-top-color: rgba(255,255,255,0.28); color: var(--t-on-dark-dim); }
    .rpt .rpt-cover { flex: 1; display: flex; flex-direction: column; min-height: 0; }
    .rpt .rpt-cover-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 38mm; }
