Dashboard demo_report_paged {
  title: 'State of Ecommerce Performance 2026 (paginated)'
  description: @md A paginated A4 version of the ecommerce report, with page numbers and one page per sheet for PDF export.;;
  owner: 'hien.nt@holistics.io'
  // Local theme: transparent surfaces so the custom HTML slide backgrounds show through.
  // Colors, fonts and chart palette follow brand_theme_light.
  theme: PageTheme {
    color {
      data: brand_color_palette
    }
    background {
      bg_color: "transparent"
    }
    canvas {
      background {
        bg_color: "transparent"
      }
      border {
        border_width: 0
        border_radius: 12
        border_color: "#D1D5DB"
        border_style: "none"
      }
      shadow: "none"
      opacity: 1
    }
    block {
      background {
        bg_color: "transparent"
      }
      border {
        border_width: 0
        border_radius: 12
        border_color: "#D1D5DB"
        border_style: "none"
      }
      shadow: "none"
      padding: 0
      opacity: 1
      label {
        font_family: "Inter"
        font_size: 14
        font_color: "#05264C"
        font_weight: "semibold"
        font_style: "normal"
        letter_spacing: "0"
      }
      text {
        font_family: "Inter"
        font_size: 13
        font_color: "#374151"
        font_weight: "normal"
        font_style: "normal"
      }
    }
    viz {
      table {
        general {
          bg_color: "#FFFFFF"
          font_color: "#374151"
          font_family: "Inter"
          font_size: 13
          border_color: "#D1D5DB"
          grid_color: "#D1D5DB"
          border_width: 1
          hover_color: "#F5F8FA"
          banding_color: "#F9FAFB"
          cell_padding: DetailedSpacing {
            top: 10
            right: 16
            bottom: 10
            left: 16
          }
          borders {
            outer: true,
            vertical: false,
            horizontal: true,
            header: true,
            row_header: false
          }
        }
        header {
          bg_color: "#FFFFFF"
          font_color: "#05264C"
          font_size: 13
          font_weight: "semibold"
        }
        sub_header {
          bg_color: "#F9FAFB"
          font_color: "#374151"
          font_size: 13
          font_weight: "medium"
        }
        sub_title {
          font_color: "#6B7280"
          font_size: 12
          font_weight: "medium"
        }
        sparkline {
          line {
            color: "#55c5c9"
          }
          column {
            color: "#05264C"
          }
        }
      }
      metric_kpi {
        alignment: "left"
        label {
          font_family: "Inter"
          font_size: 18
          font_color: "#374151"
        }
        value {
          font_family: "Inter"
          font_size: 44
          font_color: "#05264C"
        }
        progress {
          indicator {
            bg_color: "#05264C"
          }
          track {
            bg_color: "#D1D5DB"
          }
          text {
            font_color: "#374151"
          }
        }
        trend {
          positive {
            text {
              font_color: "#23a672"
              font_weight: "medium"
            }
            background {
              bg_color: "#e9f8f0"
            }
          }
          negative {
            text {
              font_color: "#c53030"
              font_weight: "medium"
            }
            background {
              bg_color: "#fcebec"
            }
          }
          neutral {
            text {
              font_color: "#374151"
              font_weight: "normal"
            }
            background {
              bg_color: "#F5F8FA"
            }
          }
        }
      }
    }
    custom_css: @css
      .rpt .dac-text-block {
        font-family: Inter;
        font-size: 14px;
        color: #374151;
        line-height: 1.6;
      }
      .rpt .dac-text-block h1,
      .rpt .dac-text-block h2,
      .rpt .dac-text-block h3,
      .rpt .dac-text-block h4 {
        font-family: Inter;
        color: #05264C;
        line-height: 1.3;
        margin-top: 0;
        margin-bottom: 0.5em;
        font-weight: 700;
      }
    ;;
  }

  block v_ld9y: VizBlock {
    label: 'Revenue'
    viz: MetricKpi {
      dataset: ecommerce_official
      value: VizFieldFull {
        label: 'Revenue'
        ref: r(ecommerce_official.revenue)
        format {
          type: 'number'
          pattern: '#,###0.00"A"'
        }
      }
      settings {
        display_mode: 'single'
      }
    }
    settings {
      hide_label: true
    }
  }
  block v_acsc: VizBlock {
    label: 'Distinct Orders'
    viz: MetricKpi {
      dataset: ecommerce_official
      calculation distinct_order_count {
        label: 'Distinct Orders'
        formula: @aql orders | count_distinct(orders.id);;
        calc_type: 'measure'
        data_type: 'number'
      }
      theme {
        metric_kpi {
          label {
            font_size: 16
          }
          value {
            font_size: 44
          }
        }
      }
      value: VizFieldFull {
        ref: 'distinct_order_count'
        label: 'Distinct Orders'
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
    }
    settings {
      hide_label: true
    }
  }
  block v_business_aov: VizBlock {
    label: 'Average Order Value'
    viz: MetricKpi {
      dataset: ecommerce_official
      theme {
        metric_kpi {
          label {
            font_size: 16
          }
          value {
            font_size: 44
          }
        }
      }
      calculation distinct_order_count {
        label: 'Distinct Order Count'
        formula: @aql orders | count_distinct(orders.id);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation average_order_value {
        label: 'Average Order Value'
        formula: @aql safe_divide(revenue, distinct_order_count);;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'average_order_value'
        label: 'Average Order Value'
        format {
          type: 'number'
          pattern: '[$$]#,###0.00'
        }
      }
      settings {
        display_mode: 'single'
      }


    }
    settings {
      hide_label: true
    }
  }
  block v_nrin: VizBlock {
    label: 'Product Count'
    viz: MetricKpi {
      dataset: ecommerce_official
      theme {
        metric_kpi {
          label {
            font_size: 16
          }
          value {
            font_size: 44
          }
        }
      }
      value: VizFieldFull {
        label: 'Product listed'
        ref: r(products.name)
        aggregation: 'count distinct'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
    settings {
      hide_label: true
    }
  }
  block v_audi: VizBlock {
    label: 'Merchant Count'
    viz: MetricKpi {
      dataset: ecommerce_official
      theme {
        metric_kpi {
          label {
            font_size: 16
          }
          value {
            font_size: 44
          }
        }
      }
      value: VizFieldFull {
        label: 'Merchant listed'
        ref: r(merchants.name)
        aggregation: 'count distinct'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
    settings {
      hide_label: true
    }
  }
  block v_users_count: VizBlock {
    label: 'Registered Users'
    viz: MetricKpi {
      dataset: ecommerce_official
      calculation distinct_registered_user_count {
        label: 'Distinct Registered User Count'
        formula: @aql users | count_distinct(users.id);;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'distinct_registered_user_count'
        label: 'Distinct Registered User Count'
        format {
          type: 'number'
          pattern: '#,###'
        }
      }
      theme {
        metric_kpi {
          label {
            font_size: 16
          }
          value {
            font_size: 44
          }
        }
      }
    }
    settings {
      hide_label: true
    }
  }
  block v_fofr: VizBlock {
    label: 'Revenue by Order Month'
    viz: CombinationChart {
      dataset: ecommerce_official
      x_axis: VizFieldFull {
        ref: r(orders.created_at)
        label: 'Order Month'
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(ecommerce_official.revenue)
            label: 'Revenue'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }
  block v_business_kpi_table: VizBlock {
    label: 'Monthly KPI Overview'
    viz: MetricSheet {
      dataset: ecommerce_official
      calculation distinct_order_count {
        label: 'Distinct Orders'
        formula: @aql orders | count_distinct(orders.id);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation average_order_value {
        label: 'Average Order Value'
        formula: @aql safe_divide(revenue, distinct_order_count);;
        calc_type: 'measure'
        data_type: 'number'
      }
      date_field: VizFieldFull {
        label: 'Order Month'
        ref: r(orders.created_at)
        transformation: 'datetrunc quarter'
        format {
          type: 'date'
          pattern: 'yyyy Qq'
        }
      }
      rows: [
        MetricSeries {
          field: VizFieldFull {
            label: 'Revenue'
            ref: r(ecommerce_official.revenue)
            format {
              type: 'number'
              pattern: '[$$]#,###0.00'
            }
          }
        },
        MetricSeries {
          field: VizFieldFull {
            label: 'Distinct Orders'
            ref: 'distinct_order_count'
            format {
              type: 'number'
              pattern: '#,###0'
            }
          }
        },
        MetricSeries {
          field: VizFieldFull {
            label: 'Average Order Value'
            ref: 'average_order_value'
            format {
              type: 'number'
              pattern: '[$$]#,###0.00'
            }
          }
        }
      ]
      settings {
        max_column: 7
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_quxa: VizBlock {
    label: 'Revenue by Order Status'
    viz: PieChart {
      dataset: ecommerce_official
      legend: VizFieldFull {
        ref: r(orders.status)
        label: 'Order Status'
        format {
          type: 'text'
        }
      }
      series {
        field: VizFieldFull {
          ref: r(ecommerce_official.revenue)
          label: 'Revenue'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      }
      settings {
        display_as_donut: true
        legend_label: 'bottom'
        show_data_label: true
        show_percentage: true
        data_label_position: 'outside'
        show_total: true
        sort: 'asc'
      }
    }
  }
  block v_business_map: VizBlock {
    label: 'Revenue Map by Country'
    viz: FilledMap {
      dataset: ecommerce_official
      location {
        field: VizFieldFull {
          label: 'Country Name'
          ref: r(countries.name)
        }
        location_type: 'country'
        primary_field: true
      }
      value: VizFieldFull {
        label: 'Revenue'
        ref: r(ecommerce_official.revenue)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      tooltips: [
        VizTooltip {
          field: VizFieldFull {
            label: 'Revenue'
            ref: r(ecommerce_official.revenue)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      ]
      settings {
        location_colors {

        }
      }
    }
  }
  block v_sales_country: VizBlock {
    label: 'Revenue by Customer Country'
    viz: BarChart {
      dataset: ecommerce_official
      x_axis: VizFieldFull {
        ref: r(countries.name)
        label: 'Customer Country'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(ecommerce_official.revenue)
            label: 'Revenue'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }
  block v_products_categories: VizBlock {
    label: 'Revenue by Product Category'
    viz: CombinationChart {
      dataset: ecommerce_official
      x_axis: VizFieldFull {
        ref: r(categories.name)
        label: 'Product Category'
      }
      y_axis {
        label: 'Revenue'
        series {
          mark_type: 'bar'
          field: VizFieldFull {
            ref: r(ecommerce_official.revenue)
            label: 'Revenue'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }
  block v_products_table: VizBlock {
    label: 'Top Products by Revenue'
    viz: DataTable {
      dataset: ecommerce_official
      calculation total_units_sold {
        label: 'Total Units Sold'
        formula: @aql order_items | sum(order_items.quantity);;
        calc_type: 'measure'
        data_type: 'number'
      }
      fields: [
        VizFieldFull {
          ref: r(products.name)
          label: 'Product Name'
          format {
            type: 'text'
          }
          uname: 'product_name'
        },
        VizFieldFull {
          ref: r(products.price)
          label: 'Product Price'
          format {
            type: 'number'
            pattern: '[$$]#,###0.00'
          }
        },
        VizFieldFull {
          ref: r(ecommerce_official.revenue)
          label: 'Revenue'
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'revenue'
        },
        VizFieldFull {
          ref: 'total_units_sold'
          label: 'Total Units Sold'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
      ]
      settings {
        pagination_size: 20
        show_row_number: true
        row_limit: 20
        sorts: [
          KeyBasedSortSetting {
            key: 'revenue'
            direction: 'desc'
          },
          KeyBasedSortSetting {
            key: 'product_name'
            direction: 'asc'
          },
        ]
        wrap_header_text: true
        wrap_cell_text: false
      }
    }
  }
  block v_products_bubble: VizBlock {
    label: 'Product Price, Units, and Revenue'
    viz: BubbleChart {
      dataset: ecommerce_official

      calculation total_units_sold {
        label: 'Total Units Sold'
        formula: @aql order_items | sum(order_items.quantity);;
        calc_type: 'measure'
        data_type: 'number'
      }

      calculation top_100_product_ids {
        label: 'Top 100 Product Ids'
        formula: @aql top(100, products.id, by: revenue, logic: 'dense');;
        calc_type: 'measure'
        data_type: 'json'
      }

      x_col: VizFieldFull {
        ref: r(products.price)
        label: 'Product Price'
        format {
          type: 'number'
          pattern: '[$$]#,###0.00'
        }
      }

      y_col: VizFieldFull {
        ref: 'total_units_sold'
        label: 'Total Units Sold'
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }

      z_col: VizFieldFull {
        ref: r(ecommerce_official.revenue)
        label: 'Revenue'
        format {
          type: 'number'
          pattern: '[$$]#,###0.00'
        }
      }

      label_col: VizFieldFull {
        ref: r(products.name)
        label: 'Product Name'
      }

      conditions: [
        "products.id in top_100_product_ids",
      ]

      settings {
        row_limit: 100
      }
    }
  }
  block v_users_signup: VizBlock {
    label: 'User Signups by Month'
    viz: CombinationChart {
      dataset: ecommerce_official
      calculation distinct_registered_users {
        label: 'Distinct Registered Users'
        formula: @aql users | count_distinct(users.id);;
        calc_type: 'measure'
        data_type: 'number'
      }
      x_axis: VizFieldFull {
        ref: r(users.sign_up_date)
        label: 'Sign Up Month'
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: 'distinct_registered_users'
            label: 'Distinct Registered Users'
            format {
              type: 'number'
              pattern: '#,###0'
            }
          }
        }
      }
      settings {
        x_axis_label: 'Sign Up Month'
        legend_label: 'hidden'
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }
  block v_users_gender: VizBlock {
    label: 'Revenue by User Gender'
    viz: PieChart {
      dataset: ecommerce_official
      legend: VizFieldFull {
        ref: r(users.gender)
        label: 'User Gender'
      }
      series {
        field: VizFieldFull {
          ref: r(ecommerce_official.revenue)
          label: 'Revenue'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      }
      settings {
        display_as_donut: true
        legend_label: 'bottom'
        show_data_label: true
        show_percentage: true
        data_label_position: 'outside'
        show_total: true
        sort: PieFamilySort {
          type: 'pie'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }
  block v_users_table: VizBlock {
    label: 'Top Customers by Revenue'
    viz: DataTable {
      dataset: ecommerce_official
      calculation distinct_order_count {
        label: 'Distinct Order Count'
        formula: @aql orders | count_distinct(orders.id);;
        calc_type: 'measure'
        data_type: 'number'
      }
      fields: [
        VizFieldFull {
          ref: r(users.full_name)
          label: 'Customer Full Name'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(countries.name)
          label: 'Customer Country'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(ecommerce_official.revenue)
          label: 'Revenue'
          uname: 'revenue'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: 'distinct_order_count'
          label: 'Distinct Order Count'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        }
      ]
      settings {
        pagination_size: 20
        show_row_number: true
        row_limit: 20
        sorts: [
          KeyBasedSortSetting {
            key: 'revenue'
            direction: 'desc'
          }
        ]
        wrap_header_text: true
      }
    }
  }
  block f_order_date: FilterBlock {
    label: 'Order date range'
    type: 'field'
    source: FieldFilterSource {
      dataset: ecommerce_official
      field: r(orders.created_at)
    }
    default {
      operator: 'matches'
      value: '$H_NIL$'
    }
  }
  block f_customer_country: FilterBlock {
    label: 'Customer country'
    type: 'field'
    source: FieldFilterSource {
      dataset: ecommerce_official
      field: r(countries.name)
    }
    default {
      operator: 'matches'
      value: '$H_NIL$'
    }
    settings {
      input_type: 'multiple'
    }
  }

  view: HTMLLayout {
    content: @html

<div class="rpt">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400;1,8..60,500&display=swap');

    .rpt,
    .rpt *,
    .rpt *::before,
    .rpt *::after { box-sizing: border-box; }

    /* ---- TOKENS: Holistics brand. Swap this block to reskin. */
    .rpt {
      --t-ink:      #05264C;
      --t-body:     #374151;
      --t-dim:      #6B7280;
      --t-faint:    #8FA0B4;
      --t-accent:   #2C6A95;
      --t-teal:     #55C5C9;
      --t-teal-dk:  #00627A;
      --t-bg:       #FFFFFF;
      --t-desk:     #EDF1F5;
      --t-surface:  #F5F8FA;
      --t-border:   #E1E7EE;
      --t-rule:     #C9D3DE;
      --t-dark:     linear-gradient(71deg, #05264C 0%, #0B4963 62%, #013D7D 100%);
      --t-on-dark:     #FFFFFF;
      --t-on-dark-dim: rgba(255, 255, 255, 0.82);

      /* Running header/footer text. --t-total counts only non-cover sheets. */
      --t-report-title:  "State of ecommerce performance 2026";
      --t-report-period: "Aug 2023 to Oct 2026";
      --t-source:        "Source: ecommerce_official dataset";
      --t-confidential:  "Internal";
      --t-total:         "11";

      --t-page-w:    210mm;
      --t-page-h:    297mm;
      --t-page-pad:  16mm;
      --t-radius:    6px;
      --t-serif:     'Source Serif 4', Georgia, 'Times New Roman', serif;
      --t-sans:      Inter, -apple-system, 'Segoe UI', Roboto, sans-serif;
      --t-mono:      'JetBrains Mono', ui-monospace, Menlo, Consolas, monospace;

      font-family: var(--t-sans);
      color: var(--t-body);
      background: var(--t-desk);
      padding: 24px 16px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 24px;
      counter-reset: rpt-page;
      font-size: 12.5px;
      line-height: 1.6;
    }

    /* ---- The sheet. Pages do not reflow: content that does not fit is clipped. */
    .rpt .rpt-page {
      width: min(var(--t-page-w), 100%);
      height: var(--t-page-h);
      flex-shrink: 0;
      background: var(--t-bg);
      border: 1px solid var(--t-border);
      border-radius: 4px;
      box-shadow: 0 6px 22px rgba(5, 38, 76, 0.10);
      padding: var(--t-page-pad);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      position: relative;
    }
    /* The cover is not numbered, so it does not increment the counter. */
    .rpt .rpt-page:not(.is-cover) { counter-increment: rpt-page; }

    /* ---- Running header */
    .rpt .rpt-head { display: flex; align-items: baseline; gap: 12px; padding-bottom: 6px; margin-bottom: 8mm; border-bottom: 1px solid var(--t-rule); flex-shrink: 0; }
    .rpt .rpt-head-title { font-size: 10px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--t-ink); }
    .rpt .rpt-head-title::before { content: var(--t-report-title); }
    .rpt .rpt-head-section { font-size: 10px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--t-faint); }
    .rpt .rpt-head-period { margin-left: auto; font-family: var(--t-mono); font-size: 10px; color: var(--t-dim); }
    .rpt .rpt-head-period::before { content: var(--t-report-period); }

    /* ---- Running footer with page number */
    .rpt .rpt-foot { display: flex; align-items: baseline; gap: 12px; margin-top: auto; padding-top: 6px; border-top: 1px solid var(--t-rule); font-size: 9.5px; color: var(--t-faint); flex-shrink: 0; }
