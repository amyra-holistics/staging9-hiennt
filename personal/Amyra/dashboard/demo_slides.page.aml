      .hdeck .tr-cover-kpis { grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: none; gap: 12px; }
      .hdeck .tr-cover-kpis .tr-kpicard { min-height: 120px; overflow: visible; }
      .hdeck .tr-kpigrid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .hdeck .tr-divider-num { font-size: clamp(80px, 22cqw, 160px); }
      .hdeck .tr-nav { flex-wrap: wrap; }
      .hdeck .tr-dots { margin: 0; order: 3; width: 100%; flex-wrap: wrap; }
    }
    @container (max-width: 520px) {
