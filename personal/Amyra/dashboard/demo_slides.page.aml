      .hdeck .tr-divider-num { font-size: clamp(80px, 22cqw, 160px); }
      .hdeck .tr-nav { flex-wrap: wrap; }
      .hdeck .tr-dots { margin: 0; order: 3; width: 100%; flex-wrap: wrap; }
    }
