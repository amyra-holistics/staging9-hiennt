      .hdeck .tr-lede { font-size: 15px; }
      .hdeck .tr-points li { font-size: 14px; }
      .hdeck .tr-callout { font-size: 14px; padding: 12px 14px; }
      .hdeck .tr-agenda-item { grid-template-columns: 40px 1fr; gap: 6px 12px; padding: 12px 0; }
      .hdeck .tr-agenda-name { font-size: 17px; }
      .hdeck .tr-agenda-note { grid-column: 2; }
      .hdeck .tr-kpigrid { grid-template-columns: minmax(0, 1fr); }
      .hdeck .tr-cover-kpis { grid-template-columns: minmax(0, 1fr); }
      .hdeck .tr-cover-kpis .tr-kpicard { min-height: 100px; }
      .hdeck .tr-frame,
      .hdeck .tr-slide > .tr-frame,
      .hdeck .tr-duo .tr-frame,
      .hdeck .tr-sheet .tr-frame,
      .hdeck .tr-cover-grid > .tr-frame { min-height: 260px; }
      .hdeck .tr-card { padding: 20px 18px; }
      .hdeck .tr-take-title { font-size: 22px; }
      .hdeck .tr-nav { gap: 10px; }
      .hdeck .tr-btn { padding: 9px 14px; }
      .hdeck .tr-dot { width: 10px; }
      .hdeck .tr-dot.is-on { width: 22px; }
    }
    @container (max-width: 400px) {
      .hdeck { --t-pad: 14px; }
      .hdeck .tr-headline { font-size: 26px; }
      .hdeck .tr-headline.is-mid,
      .hdeck .tr-cover-head .tr-headline { font-size: 22px; }
      .hdeck .tr-eyebrow { letter-spacing: 0.2em; font-size: 11px; margin-bottom: 12px; }
      .hdeck .tr-lede { font-size: 14px; }
      .hdeck .tr-cover-kpis .h-kpi-metric { font-size: 24px !important; }
      .hdeck .tr-frame,
      .hdeck .tr-slide > .tr-frame,
      .hdeck .tr-duo .tr-frame,
      .hdeck .tr-sheet .tr-frame,
      .hdeck .tr-cover-grid > .tr-frame { min-height: 230px; padding: 10px; }
      .hdeck .tr-sheet { padding: 10px; border-radius: 14px; }
      .hdeck .tr-nav { justify-content: space-between; }
      .hdeck .tr-dots { display: none; }
      .hdeck .tr-count { font-size: 11px; }
      .hdeck .tr-logo-badge { padding: 8px 12px; }
      .hdeck .tr-cover-side img { height: 20px; }
      .hdeck .tr-divider-num { font-size: 72px; }
      .hdeck .tr-agenda-name { font-size: 16px; }
      .hdeck .tr-stat { font-size: 56px; }
    }
    /* ---- Window-width fallbacks: same rules keyed to the browser window, in case the pane is wider than the visible area
       or container queries are unavailable. */
    @media (max-width: 900px) {
      .hdeck { height: auto; overflow: visible; }
