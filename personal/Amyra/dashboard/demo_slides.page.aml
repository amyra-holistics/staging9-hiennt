      .hdeck .tr-divider .tr-divider-inner { grid-template-columns: minmax(0, 1fr); grid-template-rows: none; }
      .hdeck .tr-body { gap: 24px; }
      .hdeck .tr-slide > .tr-copy { margin-bottom: 20px; }
      .hdeck .tr-frame,
      .hdeck .tr-slide > .tr-frame,
      .hdeck .tr-duo .tr-frame,
      .hdeck .tr-sheet .tr-frame { min-height: 300px; padding: 14px; }
      .hdeck .tr-sheet { padding: 14px; }
      .hdeck .tr-sheet .tr-duo > .tr-frame + .tr-frame { border-left: none; padding-left: 0; margin-left: 0; border-top: 1px solid var(--t-border); padding-top: 14px; margin-top: 14px; }
      .hdeck .tr-slide.is-cover { padding-top: var(--t-pad); }
      .hdeck .tr-cover-head { flex-direction: column-reverse; align-items: flex-start; gap: 14px; }
