      .hdeck .tr-sheet .tr-duo > .tr-frame + .tr-frame { border-left: none; padding-left: 0; margin-left: 0; border-top: 1px solid var(--t-border); padding-top: 14px; margin-top: 14px; }
      .hdeck .tr-slide.is-cover { padding-top: var(--t-pad); }
      .hdeck .tr-cover-head { flex-direction: column-reverse; align-items: flex-start; gap: 14px; }
      .hdeck .tr-cover-side { align-items: flex-start; }
