Dashboard demo_slides {
  title: 'Ecommerce Performance Slides'
  description: @md An interactive slide deck with commentary for each chart. Use Prev and Next, or the dots, to move between slides.;;
  owner: 'hien.nt@holistics.io'
  block k_cover_rev: VizBlock {
    label: 'Revenue'
    viz: MetricKpi {
      dataset: ecommerce_official
      theme {
        metric_kpi {
          value {
            font_size: 40
          }
        }
      }
      value: VizFieldFull {
        label: 'Revenue'
        ref: r(ecommerce_official.revenue)
        format {
          type: 'number'
          pattern: '#,###0.00"A"'
        }
      }
      settings {
        display_mode: 'single'
      }
    }
    settings {
      hide_label: true
    }
  }
  block k_cover_ord: VizBlock {
    label: 'Distinct Orders'
    viz: MetricKpi {
      dataset: ecommerce_official
      calculation distinct_order_count {
        label: 'Distinct Orders'
        formula: @aql orders | count_distinct(orders.id);;
        calc_type: 'measure'
        data_type: 'number'
      }
      theme {
        metric_kpi {
          label {
            font_size: 16
          }
          value {
            font_size: 40
          }
        }
      }
      value: VizFieldFull {
        label: 'Distinct Orders'
        ref: 'distinct_order_count'
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
    }
    settings {
      hide_label: true
    }
  }
  block k_cover_aov: VizBlock {
    label: 'Average Order Value'
    viz: MetricKpi {
      dataset: ecommerce_official
      calculation distinct_order_count {
        label: 'Distinct Order Count'
        formula: @aql orders | count_distinct(orders.id);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation average_order_value {
        label: 'Average Order Value'
        formula: @aql safe_divide(revenue, distinct_order_count);;
        calc_type: 'measure'
        data_type: 'number'
      }
      theme {
        metric_kpi {
          label {
            font_size: 16
          }
          value {
            font_size: 40
          }
        }
      }
      value: VizFieldFull {
        label: 'Average Order Value'
        ref: 'average_order_value'
        format {
          type: 'number'
          pattern: '[$$]#,###'
        }
      }
      settings {
        display_mode: 'single'
      }
    }
    settings {
      hide_label: true
    }
  }
  block v_cover_bar: VizBlock {
    theme: BlockTheme {
      background {
        bg_color: 'transparent'
      }
      border {
        border_width: 0
        border_style: 'none'
        border_radius: 0
      }
      shadow: 'none'
      padding: 4
      label {
        font_family: 'Inter'
        font_size: 15
        font_color: '#05264C'
        font_weight: 'bold'
      }
      text {
        font_family: 'Inter'
        font_size: 13
        font_color: '#374151'
      }
    }
    label: 'Revenue by Asian country'
    viz: ColumnChart {
      dataset: ecommerce_official
      x_axis: VizFieldFull {
        ref: r(countries.name)
        label: 'Customer Country'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(ecommerce_official.revenue)
            label: 'Revenue'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#2C6A95'
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      conditions: [
        "countries.name in ['India', 'Singapore', 'Indonesia', 'Korea', 'Vietnam']",
      ]
      settings {
        legend_label: 'hidden'
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }
  block v_ld9y: VizBlock {
    label: 'Revenue'
    viz: MetricKpi {
      dataset: ecommerce_official
      theme {
        metric_kpi {
          value {
            font_size: 36
          }
        }
      }
      value: VizFieldFull {
        label: 'Revenue'
        ref: r(ecommerce_official.revenue)
        format {
          type: 'number'
          pattern: '#,###0.00"A"'
        }
      }
      settings {
        display_mode: 'single'
      }
    }
    settings {
      hide_label: true
    }
  }
  block v_acsc: VizBlock {
    label: 'Distinct Orders'
    viz: MetricKpi {
      dataset: ecommerce_official
      calculation distinct_order_count {
        label: 'Distinct Orders'
        formula: @aql orders | count_distinct(orders.id);;
        calc_type: 'measure'
        data_type: 'number'
      }
      theme {
        metric_kpi {
          label {
            font_size: 16
          }
          value {
            font_size: 36
          }
        }
      }
      value: VizFieldFull {
        label: 'Distinct Orders'
        ref: 'distinct_order_count'
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
    }
    settings {
      hide_label: true
    }
  }
  block v_business_aov: VizBlock {
    label: 'Average Order Value'
    viz: MetricKpi {
      dataset: ecommerce_official
      calculation distinct_order_count {
        label: 'Distinct Order Count'
        formula: @aql orders | count_distinct(orders.id);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation average_order_value {
        label: 'Average Order Value'
        formula: @aql safe_divide(revenue, distinct_order_count);;
        calc_type: 'measure'
        data_type: 'number'
      }
      theme {
        metric_kpi {
          label {
            font_size: 16
          }
          value {
            font_size: 36
          }
        }
      }
      value: VizFieldFull {
        label: 'Average Order Value'
        ref: 'average_order_value'
        format {
          type: 'number'
          pattern: '[$$]#,###0.00'
        }
      }
      settings {
        display_mode: 'single'
      }
    }
    settings {
      hide_label: true
    }
  }
  block v_nrin: VizBlock {
    label: 'Product Count'
    viz: MetricKpi {
      dataset: ecommerce_official
      theme {
        metric_kpi {
          label {
            font_size: 16
          }
          value {
            font_size: 36
          }
        }
      }
      value: VizFieldFull {
        label: 'Product listed'
        ref: r(products.name)
        aggregation: 'count distinct'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
    settings {
      hide_label: true
    }
  }
  block v_audi: VizBlock {
    label: 'Merchant Count'
    viz: MetricKpi {
      dataset: ecommerce_official
      theme {
        metric_kpi {
          label {
            font_size: 16
          }
          value {
            font_size: 36
          }
        }
      }
      value: VizFieldFull {
        label: 'Merchant listed'
        ref: r(merchants.name)
        aggregation: 'count distinct'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
    }
    settings {
      hide_label: true
    }
  }
  block v_users_count: VizBlock {
    label: 'Registered Users'
    viz: MetricKpi {
      dataset: ecommerce_official
      calculation distinct_registered_user_count {
        label: 'Distinct Registered User Count'
        formula: @aql users | count_distinct(users.id);;
        calc_type: 'measure'
        data_type: 'number'
      }
      theme {
        metric_kpi {
          label {
            font_size: 16
          }
          value {
            font_size: 36
          }
        }
      }
      value: VizFieldFull {
        label: 'Distinct Registered User Count'
        ref: 'distinct_registered_user_count'
        format {
          type: 'number'
          pattern: '#,###'
        }
      }
    }
    settings {
      hide_label: true
    }
  }
  block v_fofr: VizBlock {
    label: 'Revenue by Order Month'
    viz: CombinationChart {
      dataset: ecommerce_official
      x_axis: VizFieldFull {
        label: 'Order Month'
        ref: r(orders.created_at)
        transformation: 'datetrunc quarter'
        format {
          type: 'date'
          pattern: 'yyyy Qq'
        }
      }
      y_axis {
        settings {
          hidden: true
        }
        series {
          mark_type: 'line'
          field: VizFieldFull {
            label: 'Revenue'
            ref: r(ecommerce_official.revenue)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        sort {
          field_index: 0
          direction: 'asc'
          type: 'xaxis'
        }
        legend_label: 'hidden'
        x_axis_label: 'Order Month'
        x_axis_show_null_datetime: true
      }
    }
  }
  block v_quxa: VizBlock {
    label: 'Revenue by Order Status'
    viz: PieChart {
      dataset: ecommerce_official
      legend: VizFieldFull {
        label: 'Order Status'
        ref: r(orders.status)
        format {
          type: 'text'
        }
      }
      series {
        field: VizFieldFull {
          label: ' '
          ref: r(ecommerce_official.revenue)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      }
      settings {
        display_as_donut: true
        sort: 'asc'
        legend_label: 'left'
        data_label_position: 'outside'
      }
    }
    theme {
      label {
        font_family: 'Inter'
        font_color: '#05264C'
        font_size: 15
        font_weight: 'bold'
      }
      text {
        font_family: 'Inter'
        font_color: '#374151'
        font_size: 13
      }
      border {
        border_width: 0
        border_radius: 0
        border_style: 'none'
      }
      background {
        bg_color: 'transparent'
      }
      padding: 4
      shadow: 'none'
    }
  }
  block v_business_kpi_table: VizBlock {
    label: 'Monthly KPI Overview'
    viz: MetricSheet {
      dataset: ecommerce_official
      calculation distinct_order_count {
        label: 'Distinct Orders'
        formula: @aql orders | count_distinct(orders.id);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation average_order_value {
        label: 'Average Order Value'
        formula: @aql safe_divide(revenue, distinct_order_count);;
        calc_type: 'measure'
        data_type: 'number'
      }
      date_field: VizFieldFull {
        label: 'Order Month'
        ref: r(orders.created_at)
        transformation: 'datetrunc quarter'
        format {
          type: 'date'
          pattern: 'yyyy Qq'
        }
      }
      rows: [
        MetricSeries {
          field: VizFieldFull {
            label: 'Revenue'
            ref: r(ecommerce_official.revenue)
            format {
              type: 'number'
              pattern: '[$$]#,###0.00'
            }
          }
        },
        MetricSeries {
          field: VizFieldFull {
            label: 'Distinct Orders'
            ref: 'distinct_order_count'
            format {
              type: 'number'
              pattern: '#,###0'
            }
          }
        },
        MetricSeries {
          field: VizFieldFull {
            label: 'Average Order Value'
            ref: 'average_order_value'
            format {
              type: 'number'
              pattern: '[$$]#,###0.00'
            }
          }
        }
      ]
      settings {
        max_column: 7
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_business_map: VizBlock {
    label: 'Revenue Map by Country'
    viz: FilledMap {
      dataset: ecommerce_official
      location {
        field: VizFieldFull {
          label: 'Country Name'
          ref: r(countries.name)
        }
        location_type: 'country'
        primary_field: true
      }
      value: VizFieldFull {
        label: 'Revenue'
        ref: r(ecommerce_official.revenue)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      tooltips: [
        VizTooltip {
          field: VizFieldFull {
            label: 'Revenue'
            ref: r(ecommerce_official.revenue)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      ]
      settings {
        location_colors {
        }
      }
    }
  }
  block v_sales_country: VizBlock {
    theme: BlockTheme {
      background {
        bg_color: 'transparent'
      }
      border {
        border_width: 0
        border_style: 'none'
        border_radius: 0
      }
      shadow: 'none'
      padding: 4
      label {
        font_family: 'Inter'
        font_size: 15
        font_color: '#05264C'
        font_weight: 'bold'
      }
      text {
        font_family: 'Inter'
        font_size: 13
        font_color: '#374151'
      }
    }
    label: 'Revenue by Customer Country'
    viz: BarChart {
      dataset: ecommerce_official
      x_axis: VizFieldFull {
        ref: r(countries.name)
        label: 'Customer Country'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(ecommerce_official.revenue)
            label: 'Revenue'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }
  block v_products_categories: VizBlock {
    label: 'Revenue by Product Category'
    viz: CombinationChart {
      dataset: ecommerce_official
      x_axis: VizFieldFull {
        ref: r(categories.name)
        label: 'Product Category'
      }
      y_axis {
        label: 'Revenue'
        series {
          mark_type: 'bar'
          field: VizFieldFull {
            ref: r(ecommerce_official.revenue)
            label: 'Revenue'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }
  block v_products_table: VizBlock {
    label: 'Top Products by Revenue'
    viz: DataTable {
      dataset: ecommerce_official
      calculation total_units_sold {
        label: 'Total Units Sold'
        formula: @aql order_items | sum(order_items.quantity);;
        calc_type: 'measure'
        data_type: 'number'
      }
      fields: [
        VizFieldFull {
          ref: r(products.name)
          label: 'Product Name'
          format {
            type: 'text'
          }
          uname: 'product_name'
        },
        VizFieldFull {
          ref: r(products.price)
          label: 'Product Price'
          format {
            type: 'number'
            pattern: '[$$]#,###0.00'
          }
        },
        VizFieldFull {
          ref: r(ecommerce_official.revenue)
          label: 'Revenue'
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'revenue'
        },
        VizFieldFull {
          ref: 'total_units_sold'
          label: 'Total Units Sold'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
      ]
      settings {
        pagination_size: 20
        show_row_number: true
        row_limit: 20
        sorts: [
          KeyBasedSortSetting {
            key: 'revenue'
            direction: 'desc'
          },
          KeyBasedSortSetting {
            key: 'product_name'
            direction: 'asc'
          },
        ]
        wrap_header_text: true
        wrap_cell_text: false
      }
    }
  }
  block v_products_bubble: VizBlock {
    label: 'Product Price, Units, and Revenue'
    viz: BubbleChart {
      dataset: ecommerce_official
      calculation total_units_sold {
        label: 'Total Units Sold'
        formula: @aql order_items | sum(order_items.quantity);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation top_100_product_ids {
        label: 'Top 100 Product Ids'
        formula: @aql top(100, products.id, by: revenue, logic: 'dense');;
        calc_type: 'measure'
        data_type: 'json'
      }
      x_col: VizFieldFull {
        ref: r(products.price)
        label: 'Product Price'
        format {
          type: 'number'
          pattern: '[$$]#,###0.00'
        }
      }
      y_col: VizFieldFull {
        ref: 'total_units_sold'
        label: 'Total Units Sold'
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      z_col: VizFieldFull {
        ref: r(ecommerce_official.revenue)
        label: 'Revenue'
        format {
          type: 'number'
          pattern: '[$$]#,###0.00'
        }
      }
      label_col: VizFieldFull {
        ref: r(products.name)
        label: 'Product Name'
      }
      conditions: [
        "products.id in top_100_product_ids",
      ]
      settings {
        row_limit: 100
      }
    }
  }
  block v_users_signup: VizBlock {
    theme: BlockTheme {
      background {
        bg_color: 'transparent'
      }
      border {
        border_width: 0
        border_style: 'none'
        border_radius: 0
      }
      shadow: 'none'
      padding: 4
      label {
        font_family: 'Inter'
        font_size: 15
        font_color: '#05264C'
        font_weight: 'bold'
      }
      text {
        font_family: 'Inter'
        font_size: 13
        font_color: '#374151'
      }
    }
    label: 'User Signups by Month'
    viz: CombinationChart {
      dataset: ecommerce_official
      calculation distinct_registered_users {
        label: 'Distinct Registered Users'
        formula: @aql users | count_distinct(users.id);;
        calc_type: 'measure'
        data_type: 'number'
      }
      x_axis: VizFieldFull {
        ref: r(users.sign_up_date)
        label: 'Sign Up Month'
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: 'distinct_registered_users'
            label: 'Distinct Registered Users'
            format {
              type: 'number'
              pattern: '#,###0'
            }
          }
        }
      }
      settings {
        x_axis_label: 'Sign Up Month'
        legend_label: 'hidden'
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }
  block v_users_gender: VizBlock {
    theme: BlockTheme {
      background {
        bg_color: 'transparent'
      }
      border {
        border_width: 0
        border_style: 'none'
        border_radius: 0
      }
      shadow: 'none'
      padding: 4
      label {
        font_family: 'Inter'
        font_size: 15
        font_color: '#05264C'
        font_weight: 'bold'
      }
      text {
        font_family: 'Inter'
        font_size: 13
        font_color: '#374151'
      }
    }
    label: 'Revenue by User Gender'
    viz: PieChart {
      dataset: ecommerce_official
      legend: VizFieldFull {
        ref: r(users.gender)
        label: 'User Gender'
      }
      series {
        field: VizFieldFull {
          ref: r(ecommerce_official.revenue)
          label: 'Revenue'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      }
      settings {
        display_as_donut: true
        legend_label: 'bottom'
        show_data_label: true
        show_percentage: true
        data_label_position: 'outside'
        show_total: true
        sort: PieFamilySort {
          type: 'pie'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }
  block v_users_table: VizBlock {
    label: 'Top Customers by Revenue'
    viz: DataTable {
      dataset: ecommerce_official
      calculation distinct_order_count {
        label: 'Distinct Order Count'
        formula: @aql orders | count_distinct(orders.id);;
        calc_type: 'measure'
        data_type: 'number'
      }
      fields: [
        VizFieldFull {
          ref: r(users.full_name)
          label: 'Customer Full Name'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(countries.name)
          label: 'Customer Country'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(ecommerce_official.revenue)
          label: 'Revenue'
          uname: 'revenue'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: 'distinct_order_count'
          label: 'Distinct Order Count'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        }
      ]
      settings {
        pagination_size: 20
        show_row_number: true
        row_limit: 20
        sorts: [
          KeyBasedSortSetting {
            key: 'revenue'
            direction: 'desc'
          }
        ]
        wrap_header_text: true
      }
    }
  }
  block t_cover: TextBlock {
    content: @md
      <h1 class="tr-headline is-mid">Ecommerce performance review</h1>
      <p class="tr-lede">Aug 2023 to Oct 2026 · Asian markets</p>
    ;;
  }
  block t_agenda: TextBlock {
    content: @md
      <div class="tr-eyebrow">Agenda</div>
      <h2 class="tr-headline is-mid">What we will cover</h2>
      <ol class="tr-agenda"><li class="tr-agenda-item"><span class="tr-agenda-num">01</span><span class="tr-agenda-name">At a glance</span><span class="tr-agenda-note">The headline numbers</span></li><li class="tr-agenda-item"><span class="tr-agenda-num">02</span><span class="tr-agenda-name">Revenue and orders</span><span class="tr-agenda-note">Trend, order mix and monthly KPIs</span></li><li class="tr-agenda-item"><span class="tr-agenda-num">03</span><span class="tr-agenda-name">Where revenue comes from</span><span class="tr-agenda-note">Markets, categories and products</span></li><li class="tr-agenda-item"><span class="tr-agenda-num">04</span><span class="tr-agenda-name">Who our customers are</span><span class="tr-agenda-note">Growth, mix and top accounts</span></li><li class="tr-agenda-item"><span class="tr-agenda-num">05</span><span class="tr-agenda-name">Takeaways</span><span class="tr-agenda-note">What to remember and act on</span></li></ol>
    ;;
  }
  block t_glance: TextBlock {
    content: @md
      <div class="tr-eyebrow">01 · At a glance</div>
      <h2 class="tr-headline is-mid">$11.6M in revenue from 33,010 orders</h2>
      <p class="tr-lede">The average order is worth about $351. 759 merchants list 8,731 products for 10,264 registered users.</p>
      <ul class="tr-points"><li>Revenue, orders and users are all lifetime totals.</li><li>The latest month, Oct 2026, is partial.</li></ul>
      <div class="tr-callout"><span class="tr-callout-label">So what</span>The catalog is broad, and the business is already at scale.</div>
      <div class="tr-note">Commentary reflects all data (Aug 2023 to Oct 2026) (Aug 2023 to Oct 2026).</div>
    ;;
  }
  block t_trend: TextBlock {
    content: @md
      <div class="tr-eyebrow">02 · Revenue trend</div>
      <h2 class="tr-headline is-mid">Revenue has roughly tripled in a year</h2>
      <p class="tr-lede">Monthly revenue grew from $345K in Sep 2025 to $1.06M in Sep 2026.</p>
      <ul class="tr-points"><li>Growth has been steady since mid-2024, when monthly revenue was about $90K.</li><li>The one sharp dip was Apr 2025, down 38% from March. Revenue passed its March level again by August.</li><li>Oct 2026 is a partial month, so its short bar is not a decline.</li></ul>
      <div class="tr-callout"><span class="tr-callout-label">So what</span>Growth is sustained, not a one-off spike.</div>
      <div class="tr-note">Commentary reflects all data (Aug 2023 to Oct 2026) (Aug 2023 to Oct 2026).</div>
    ;;
  }
  block t_mix: TextBlock {
    content: @md
      <div class="tr-eyebrow">02 · Order mix</div>
      <h2 class="tr-headline is-mid">Seven in ten orders are delivered</h2>
      <p class="tr-lede">Of 33,010 orders, 23,174 (70%) were delivered, 8,153 (25%) cancelled and 1,683 (5%) refunded.</p>
      <ul class="tr-points"><li>Cancelled orders account for $2.85M, or 25% of reported revenue.</li><li>Refunds add another $0.59M (5%).</li></ul>
      <div class="tr-callout"><span class="tr-callout-label">So what</span>Every 10% fewer cancellations is worth about $285K.</div>
      <div class="tr-note">Commentary reflects all data (Aug 2023 to Oct 2026) (Aug 2023 to Oct 2026).</div>
    ;;
  }
  block t_kpis: TextBlock {
    content: @md
      <div class="tr-split"><div><div class="tr-eyebrow">02 · Monthly KPIs</div>
      <h2 class="tr-headline is-mid">Growth comes from volume, not bigger baskets</h2>
      <p class="tr-lede">Average order value has stayed close to $350 while monthly orders grew from 975 in Sep 2025 to over 1,900 by May 2026.</p></div><div><ul class="tr-points"><li>Revenue and orders move in step, month after month.</li><li>Order count is the lever to watch.</li></ul>
      <div class="tr-note">Commentary reflects all data (Aug 2023 to Oct 2026) (Aug 2023 to Oct 2026).</div></div></div>
    ;;
  }
  block t_div1: TextBlock {
    content: @md
      <div class="tr-divider-inner">
      <div class="tr-divider-num" aria-hidden="true">03</div>
      <div>
      <h2 class="tr-headline">Where revenue comes from</h2>
      <p class="tr-lede">Markets, categories and products.</p>
      </div>
      </div>
    ;;
  }
  block t_map: TextBlock {
    content: @md
      <div class="tr-eyebrow">03 · Markets</div>
      <h2 class="tr-headline is-mid">Ten markets, none dominant</h2>
      <p class="tr-lede">The United States is the largest market at $1.34M, only 12% of revenue.</p>
      <ul class="tr-points"><li>Nine of the ten countries each contribute between $1.1M and $1.3M.</li><li>Singapore is the outlier at $0.63M, about half of its peers.</li></ul>
      <div class="tr-callout"><span class="tr-callout-label">So what</span>Revenue is well diversified across regions.</div>
      <div class="tr-note">Commentary reflects all data (Aug 2023 to Oct 2026) (Aug 2023 to Oct 2026).</div>
    ;;
  }
  block t_country: TextBlock {
    content: @md
      <div class="tr-eyebrow">03 · Markets</div>
      <h2 class="tr-headline is-mid">Singapore is the gap to close</h2>
      <p class="tr-lede">Lifting Singapore to the peer average of about $1.2M would add roughly $0.6M.</p>
      <ul class="tr-points"><li>The United States, Vietnam, Australia and Germany lead.</li><li>The top market is only 18% ahead of the ninth.</li></ul>
      <div class="tr-callout"><span class="tr-callout-label">So what</span>Look at Singapore before investing in a new market.</div>
      <div class="tr-note">Commentary reflects all data (Aug 2023 to Oct 2026) (Aug 2023 to Oct 2026).</div>
    ;;
  }
  block t_cat: TextBlock {
    content: @md
      <div class="tr-eyebrow">03 · Categories</div>
      <h2 class="tr-headline is-mid">Three categories deliver a quarter of revenue</h2>
      <p class="tr-lede">Body, Living Room and Televisions together earn $3.0M, or 26% of revenue.</p>
      <ul class="tr-points"><li>Body leads at $1.13M. Bedroom trails at $0.14M.</li><li>Televisions ($0.91M), T-shirts ($0.89M), Mobiles ($0.87M) and Snacks ($0.84M) follow closely.</li></ul>
      <div class="tr-callout"><span class="tr-callout-label">So what</span>Strength spans electronics, fashion and food, not one vertical.</div>
      <div class="tr-note">Commentary reflects all data (Aug 2023 to Oct 2026) (Aug 2023 to Oct 2026).</div>
    ;;
  }
  block t_prod: TextBlock {
    content: @md
      <div class="tr-split"><div><div class="tr-eyebrow">03 · Products</div>
      <h2 class="tr-headline is-mid">A broad catalog with a long tail</h2>
      <p class="tr-lede">8,731 products from 759 merchants are listed. The table ranks the top 20; the bubble chart shows how price, units sold and revenue relate.</p></div><div><ul class="tr-points"><li>Look for high-price items that still sell in volume.</li><li>The ranking reflects all orders in the period.</li></ul>
      <div class="tr-note">Commentary reflects all data (Aug 2023 to Oct 2026) (Aug 2023 to Oct 2026).</div></div></div>
    ;;
  }
  block t_div2: TextBlock {
    content: @md
      <div class="tr-divider-inner">
      <div class="tr-divider-num" aria-hidden="true">04</div>
      <div>
      <h2 class="tr-headline">Who our customers are</h2>
      <p class="tr-lede">Growth, mix and top accounts.</p>
      </div>
      </div>
    ;;
  }
  block t_cust: TextBlock {
    content: @md
      <div class="tr-split"><div><div class="tr-eyebrow">04 · Customers</div>
      <h2 class="tr-headline is-mid">The customer base doubles every year</h2>
      <p class="tr-lede">Registered users grew from 478 in 2023 to 1,249 in 2024, 2,769 in 2025 and 5,767 so far in 2026.</p></div><div><ul class="tr-points"><li>2026 is a partial year and already 2.1 times all of 2025.</li><li>Women generate 68% of revenue ($7.8M versus $3.8M).</li></ul>
      <div class="tr-callout"><span class="tr-callout-label">So what</span>Acquisition is accelerating, and the audience skews female.</div>
      <div class="tr-note">Commentary reflects all data (Aug 2023 to Oct 2026) (Aug 2023 to Oct 2026).</div></div></div>
    ;;
  }
  block t_topc: TextBlock {
    content: @md
      <div class="tr-split"><div><div class="tr-eyebrow">04 · Top customers</div>
      <h2 class="tr-headline is-mid">Know your best customers by name</h2>
      <p class="tr-lede">The table lists the top 20 customers with their country, orders and revenue.</p></div><div><ul class="tr-points"><li>Use it to find accounts for personal outreach or loyalty offers.</li><li>The ranking reflects all orders in the period.</li></ul>
      <div class="tr-note">Commentary reflects all data (Aug 2023 to Oct 2026) (Aug 2023 to Oct 2026).</div></div></div>
    ;;
  }
  block t_wrap_head: TextBlock {
    content: @md
      <div class="tr-eyebrow">05 · Takeaways</div>
      <h2 class="tr-headline is-mid">Three things to remember</h2>
    ;;
  }
  block t_closing: TextBlock {
    content: @md
      <div class="tr-eyebrow">Thank you</div>
      <h2 class="tr-headline">Questions?</h2>
      <div class="tr-meta">Ecommerce performance review</div>
    ;;
  }
  block t_take1: TextBlock {
    content: @md
      <div class="tr-take-num">01</div>
      <h3 class="tr-take-title">Growth</h3>
      <p class="tr-take-text">Revenue tripled in a year to $1.06M a month. Average order value stays near $350, so growth is driven by order volume.</p>
    ;;
  }
  block t_take2: TextBlock {
    content: @md
      <div class="tr-take-num">02</div>
      <h3 class="tr-take-title">Leakage</h3>
      <p class="tr-take-text">Almost 30% of orders are cancelled or refunded, about $3.4M of reported revenue. This is the fastest win.</p>
    ;;
  }
  block t_take3: TextBlock {
    content: @md
      <div class="tr-take-num">03</div>
      <h3 class="tr-take-title">Opportunity</h3>
      <p class="tr-take-text">Singapore trails its peers by about $0.6M. The customer base is doubling every year, so retention matters more each quarter.</p>
    ;;
  }

  view: HTMLLayout {
    content: @html

<div class="hwrap">
<div class="hdeck">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

    /* The wrapper is the size container: every cqw below is relative to the deck's own width, not the window. */
    .hwrap { container-type: inline-size; width: 100%; max-width: min(880px, 100vw); margin: 0 auto; overflow-x: hidden; }

    .hdeck,
    .hdeck *,
    .hdeck *::before,
    .hdeck *::after { box-sizing: border-box; }

    /* ---- THEME TOKENS: Holistics brand. Swap this block to reskin. */
    .hdeck {
      --t-bg:        #F5F8FA;
      --t-tint:      #E4EFF3;
      --t-ink:       #05264C;
      --t-ink-dim:   #4B5B73;
      --t-card:      #FFFFFF;
      --t-accent:    #2C6A95;
      --t-accent-hi: #55C5C9;
      --t-accent-lo: #05264C;
      --t-success:   #23A672;
      --t-on-dark:      #FFFFFF;
      --t-on-dark-dim:  rgba(255, 255, 255, 0.82);
      --t-dark-bg:      linear-gradient(71deg, #05264C 0%, #0B4963 62%, #013D7D 100%);
      --t-border:       rgba(5, 38, 76, 0.18);
      --t-border-soft:  rgba(5, 38, 76, 0.12);
      --t-border-dark:  rgba(255, 255, 255, 0.30);
      --t-border-dark-soft: rgba(255, 255, 255, 0.22);
      --t-surface-dark: rgba(255, 255, 255, 0.10);
      --t-hover:        rgba(5, 38, 76, 0.07);
      --t-hover-dark:   rgba(255, 255, 255, 0.14);
      --t-shadow:       rgba(5, 38, 76, 0.10);
      --t-shadow-strong: rgba(0, 0, 0, 0.30);
      --t-radius:      12px;
      --t-radius-sm:   8px;
      --t-pad:         clamp(24px, 4.5cqw, 64px);
      --t-font-sans:    Inter, 'Helvetica Neue', Helvetica, sans-serif;
      --t-font-mono:    ui-monospace, 'SF Mono', Menlo, Consolas, monospace;

      font-family: var(--t-font-sans);
      color: var(--t-ink);
      background: var(--t-bg);
      border-radius: var(--t-radius);
      overflow: hidden;
      position: relative;
      height: clamp(640px, 58cqw, 820px);
      display: flex;
      flex-direction: column;
    }

    /* ---- Slide visibility (CSS :target, no JavaScript) */
    .hdeck .tr-slide {
      display: none;
      flex: 1;
      min-height: 0;
      flex-direction: column;
      padding: var(--t-pad);
      background: var(--t-bg);
      animation: tr-in 0.45s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .hdeck .tr-slide:target { display: flex; }
    .hdeck:not(:has(.tr-slide:target)) #tr-1 { display: flex; }

    @keyframes tr-in {
      from { opacity: 0; transform: translateY(10px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .hdeck .tr-slide.is-dark { background: var(--t-dark-bg); color: var(--t-on-dark); }
    .hdeck .tr-slide.is-tint { background: var(--t-tint); }

    /* ---- Type scale */
    .hdeck .tr-eyebrow {
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--t-accent);
      margin-bottom: 18px;
    }
    .hdeck .tr-headline {
      font-family: var(--t-font-sans);
      font-weight: 800;
      letter-spacing: -0.025em;
      font-size: clamp(34px, 4.6cqw, 62px);
      line-height: 1.06;
      margin: 0 0 20px 0;
      color: var(--t-ink);
    }
    .hdeck .tr-headline.is-mid { font-size: clamp(26px, 3cqw, 42px); line-height: 1.12; }
    /* TextBlock defaults can override inherited color, so set dark-slide colors explicitly. */
    .hdeck .is-dark .tr-headline,
    .hdeck .is-dark .tr-headline * { color: var(--t-on-dark) !important; }
    .hdeck .is-dark .tr-eyebrow,
    .hdeck .is-dark .tr-eyebrow * { color: var(--t-accent-hi) !important; }
    .hdeck .tr-accent { color: var(--t-accent); }
    .hdeck .is-dark .tr-accent,
    .hdeck .is-dark .tr-accent * { color: var(--t-accent-hi) !important; }
    .hdeck .tr-lede {
      font-size: 17px;
      line-height: 1.55;
      color: var(--t-ink-dim);
      max-width: 52ch;
      margin: 0;
    }
    .hdeck .is-dark .tr-lede { color: var(--t-on-dark-dim); }
    .hdeck .tr-meta {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--t-ink-dim);
    }
    .hdeck .is-dark .tr-meta { color: var(--t-on-dark-dim); }

    /* ---- Commentary: bullets, callout, scope note */
    .hdeck .tr-points { list-style: none; padding: 0; margin: 20px 0 0; max-width: 52ch; }
    .hdeck .tr-points li {
      position: relative;
      padding: 0 0 0 22px;
      margin: 0 0 10px;
      font-size: 15px;
      line-height: 1.5;
      color: var(--t-ink-dim);
    }
    .hdeck .tr-points li::before {
      content: '';
      position: absolute;
      left: 0;
      top: 8px;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--t-accent-hi);
    }
    .hdeck .is-dark .tr-points li { color: var(--t-on-dark-dim); }
    .hdeck .tr-callout {
      margin-top: 16px;
      max-width: 52ch;
      padding: 14px 18px;
      border-left: 4px solid var(--t-accent-hi);
      background: var(--t-card);
      border-radius: 0 var(--t-radius-sm) var(--t-radius-sm) 0;
      font-size: 15px;
      font-weight: 600;
      line-height: 1.45;
      color: var(--t-ink);
    }
    .hdeck .tr-callout-label {
      display: block;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--t-accent);
      margin-bottom: 4px;
    }
    .hdeck .is-dark .tr-callout { background: var(--t-surface-dark); color: var(--t-on-dark); }
    .hdeck .is-dark .tr-callout-label { color: var(--t-accent-hi); }
    .hdeck .tr-note {
      margin-top: 16px;
      font-size: 12px;
      color: var(--t-ink-dim);
      opacity: 0.8;
    }
    .hdeck .is-dark .tr-note { color: var(--t-on-dark-dim); }

    /* ---- Slide body */
    .hdeck .tr-body {
      flex: 1;
      min-height: 0;
      display: grid;
      grid-template-columns: 0.95fr 1.05fr;
      gap: clamp(24px, 3.5cqw, 56px);
      align-items: center;
    }
    .hdeck .tr-copy { display: flex; flex-direction: column; justify-content: center; }
    .hdeck .tr-slide > .tr-copy { margin-bottom: 16px; flex-shrink: 0; }
    .hdeck .tr-split { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: clamp(24px, 4cqw, 56px); align-items: start; }
    .hdeck .tr-split .tr-points { margin-top: 4px; }
    .hdeck .tr-split .tr-callout { margin-top: 12px; }
    .hdeck .tr-split .tr-note { margin-top: 12px; }

    /* ---- Chart frames. Every one needs a min-height or the block collapses. */
    .hdeck .tr-frame {
      background: var(--t-card);
      border-radius: var(--t-radius);
      padding: 18px;
      min-height: 420px;
      display: flex;
      box-shadow: 0 14px 34px var(--t-shadow);
    }
    .hdeck .tr-frame > * { flex: 1; min-width: 0; }
    .hdeck .tr-frame .dac-viz-block { background: transparent; }
    /* On dark slides the chart's own BlockTheme draws the card, so the frame is only a sized container. */
    .hdeck .is-dark .tr-frame { background: transparent; box-shadow: none; padding: 0; border-radius: 0; }
    .hdeck .tr-slide > .tr-frame { flex: 1; min-height: 240px; }
    /* Light sheet that carries charts on dark slides. The charts' own text is dark, so they need a light surface. */
    .hdeck .tr-sheet {
      background: linear-gradient(160deg, #C9DBEA 0%, #B4CCE0 100%);
      border: 1px solid rgba(255, 255, 255, 0.35);
      border-radius: 20px;
      padding: 22px;
      display: flex;
      min-height: 0;
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.30);
    }
    .hdeck .tr-sheet > * { flex: 1; min-width: 0; }
    .hdeck .tr-slide > .tr-sheet { flex: 1; }
    .hdeck .tr-sheet .tr-duo { gap: 0; }
    .hdeck .tr-sheet .tr-duo > .tr-frame + .tr-frame { border-left: 1px solid var(--t-border); padding-left: 22px; margin-left: 22px; }
    .hdeck .tr-sheet .tr-frame { min-height: 240px; }
    .hdeck .tr-duo {
      flex: 1;
      min-height: 0;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px;
      grid-template-rows: minmax(0, 1fr);
    }
    .hdeck .tr-duo.is-wide-left { grid-template-columns: 1.6fr 1fr; }
    .hdeck .tr-duo .tr-frame { min-height: 240px; }

    /* ---- Cover: lozenge KPIs */
    .hdeck .tr-lozenges {
      display: flex;
      gap: 22px;
      align-items: flex-end;
      justify-content: center;
    }
    .hdeck .tr-lozenge {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 10px;
      padding: 16px;
      text-align: center;
    }
    .hdeck .tr-lozenge.is-tall {
      width: 280px;
      height: 280px;
      border-radius: 50%;
      background: linear-gradient(200deg, #7FDADD, #2C8FA8);
      box-shadow: 0 24px 50px var(--t-shadow-strong);
    }
    .hdeck .tr-lozenge.is-short {
      width: 200px;
      height: 200px;
      border-radius: 50%;
      background: var(--t-surface-dark);
      border: 1px solid var(--t-border-dark);
    }
    .hdeck .tr-lozenge-label {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.26em;
      text-transform: uppercase;
    }
    .hdeck .tr-lozenge.is-tall .tr-lozenge-label { color: var(--t-ink); }
    .hdeck .tr-lozenge.is-short .tr-lozenge-label { color: var(--t-on-dark-dim); }

    .hdeck .tr-filters { display: flex; gap: 14px; margin-top: 28px; flex-wrap: wrap; }
    /* The filter's look comes from its own BlockTheme (glass), so this wrapper only sizes it. */
    .hdeck .tr-filter {
      width: 250px;
      min-height: 76px;
      display: flex;
    }
    .hdeck .tr-filter > * { flex: 1; min-width: 0; }

    /* ---- Cover: title and logo on top, chart left, three KPI cards right */
    .hdeck .tr-cover-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 24px; margin-bottom: 22px; flex-shrink: 0; }
    .hdeck .tr-cover-head .tr-headline { margin-bottom: 8px; }
    .hdeck .tr-cover-head .tr-eyebrow { margin-bottom: 12px; }
    .hdeck .tr-cover-side { display: flex; flex-direction: column; align-items: flex-end; gap: 14px; flex-shrink: 0; }
    .hdeck .tr-logo-badge { display: inline-flex; align-items: center; padding: 10px 16px; border-radius: 10px; background: var(--t-dark-bg); }
    .hdeck .tr-cover-side img { height: 24px; display: block; }
    /* Cover sits higher: less top padding, a compact header, and a gap above the footer line. */
    .hdeck .tr-slide.is-cover { padding-top: calc(var(--t-pad) * 0.55); }
    .hdeck .tr-cover-head { margin-bottom: 12px; }
    .hdeck .tr-cover-head .tr-headline { margin: 0 0 4px; font-size: clamp(24px, 2.8cqw, 36px); }
    .hdeck .tr-cover-head .tr-lede { font-size: 15px; }
    .hdeck .tr-cover-grid { margin-bottom: 18px; }
    .hdeck .tr-cover-grid > .tr-frame { overflow: hidden; }

    /* The grid is sized by the space left above the footer, so its children cannot push into the nav. */
    .hdeck .tr-cover-grid { flex: 1; min-height: 0; display: grid; grid-template-columns: minmax(0, 1fr) clamp(190px, 22cqw, 260px); grid-template-rows: minmax(0, 1fr); gap: 20px; }
    .hdeck .tr-cover-grid > .tr-frame { min-height: 0; padding: 14px; }
    .hdeck .tr-cover-kpis { display: grid; grid-template-rows: repeat(3, minmax(0, 1fr)); gap: 14px; min-height: 0; }
    .hdeck .tr-cover-kpis .tr-kpicard { min-height: 0; padding: 10px 18px; overflow: hidden; }
    .hdeck .tr-cover-kpis .h-kpi-metric { font-size: clamp(26px, 3cqw, 38px) !important; }

    /* ---- At a glance: KPI cards */
    .hdeck .tr-kpigrid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }
    .hdeck .tr-kpicard {
      background: var(--t-card);
      border-radius: var(--t-radius);
      padding: 18px 20px;
      min-height: 150px;
      display: flex;
      box-shadow: 0 14px 34px var(--t-shadow);
    }
    .hdeck .tr-kpicard > * { flex: 1; min-width: 0; }

    /* ---- Agenda, divider, takeaway cards, closing */
    .hdeck .tr-agenda { list-style: none; padding: 0; margin: 24px 0 0; }
    .hdeck .tr-agenda-item {
      display: grid;
      grid-template-columns: 56px 1fr auto;
      gap: 20px;
      align-items: center;
      padding: 18px 0;
      border-top: 1px solid var(--t-border);
    }
    .hdeck .tr-agenda-num { font-family: var(--t-font-mono); color: var(--t-accent); font-size: 14px; font-weight: 600; }
    .hdeck .tr-agenda-name { font-size: 22px; font-weight: 700; color: var(--t-ink); }
    .hdeck .tr-agenda-note { color: var(--t-ink-dim); font-size: 14px; }
    .hdeck .tr-divider { flex: 1; display: flex; align-items: center; }
    .hdeck .tr-divider .tr-divider-inner {
      display: grid;
      grid-template-columns: 0.45fr 1fr;
      gap: clamp(28px, 6cqw, 96px);
      align-items: center;
      width: 100%;
    }
    .hdeck .tr-divider-num {
      font-weight: 800;
      letter-spacing: -0.04em;
      color: var(--t-accent-hi);
      font-size: clamp(100px, 16cqw, 220px);
      line-height: 0.85;
    }
    .hdeck .tr-cards {
      flex: 1;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px;
      align-content: start;
    }
    .hdeck .tr-card {
      background: var(--t-card);
      border-radius: var(--t-radius);
      padding: 28px 26px;
      box-shadow: 0 14px 34px var(--t-shadow);
      border-top: 4px solid var(--t-accent-hi);
    }
    .hdeck .tr-take-num { font-family: var(--t-font-mono); font-size: 14px; font-weight: 600; color: var(--t-accent); margin-bottom: 10px; }
    .hdeck .tr-take-title { font-size: 26px; font-weight: 800; color: var(--t-ink); margin: 0 0 10px; }
    .hdeck .tr-take-text { font-size: 15px; line-height: 1.6; color: var(--t-ink-dim); margin: 0; }
    .hdeck .tr-close {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      gap: 22px;
    }
    .hdeck .tr-rule { width: 72px; height: 6px; border-radius: 3px; background: var(--t-accent-hi); }

    /* ---- KPI values: force the brand face and strip inner chrome */
    .hdeck .tr-kpi-value .h-kpi-metric-kpi,
    .hdeck .tr-kpi-value .h-kpi-metric-kpi * {
      font-family: var(--t-font-sans) !important;
      font-weight: 800 !important;
      line-height: 1.1 !important;
      background: transparent !important;
      border: none !important;
    }
    /* Cover lozenges carry their own caption, so hide the KPI's built-in label and size only the value. */
    .hdeck .tr-lozenge .tr-kpi-value { width: 100%; text-align: center; }
    .hdeck .tr-lozenge .h-kpi-metric-label { display: none !important; }
    .hdeck .tr-lozenge .h-kpi-metric-kpi,
    .hdeck .tr-lozenge .h-kpi-metric-kpi * { text-align: center !important; justify-content: center !important; align-items: center !important; }
    .hdeck .tr-lozenge.is-tall .tr-kpi-value * { color: var(--t-ink) !important; }
    .hdeck .tr-lozenge.is-short .tr-kpi-value * { color: var(--t-on-dark) !important; }
    .hdeck .tr-lozenge.is-tall .h-kpi-metric { font-size: 40px !important; }
    .hdeck .tr-lozenge.is-short .h-kpi-metric { font-size: 32px !important; }

    /* ---- Navigation */
    .hdeck .tr-nav {
      display: flex;
      align-items: center;
      gap: 18px;
      margin-top: auto;
      padding-top: 20px;
      border-top: 1px solid var(--t-border-soft);
    }
    .hdeck .is-dark .tr-nav { border-top-color: var(--t-border-dark-soft); }
    .hdeck .tr-btn {
      display: inline-flex;
      align-items: center;
      padding: 10px 20px;
      border-radius: 999px;
      border: 1px solid var(--t-border);
      color: var(--t-ink);
      text-decoration: none;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      transition: background 0.2s ease, border-color 0.2s ease;
    }
    .hdeck .tr-btn:hover { background: var(--t-hover); }
    .hdeck .is-dark .tr-btn { color: var(--t-on-dark); border-color: var(--t-border-dark); }
    .hdeck .is-dark .tr-btn:hover { background: var(--t-hover-dark); }
    .hdeck .tr-btn.is-primary { background: var(--t-ink); border-color: var(--t-ink); color: var(--t-on-dark); }
    .hdeck .tr-btn.is-primary:hover { background: var(--t-accent); border-color: var(--t-accent); }
    .hdeck .is-dark .tr-btn.is-primary { background: var(--t-accent-hi); border-color: var(--t-accent-hi); color: var(--t-ink); }
    .hdeck .is-dark .tr-btn.is-primary:hover { background: #7FDADD; border-color: #7FDADD; }
    .hdeck .tr-btn.is-off { opacity: 0.45; pointer-events: none; }
    .hdeck .tr-btn:focus-visible,
    .hdeck .tr-dot:focus-visible { outline: 3px solid var(--t-accent-hi); outline-offset: 4px; }
    .hdeck .tr-count { font-family: var(--t-font-mono); font-size: 12px; color: var(--t-ink-dim); letter-spacing: 0.08em; }
    .hdeck .is-dark .tr-count { color: var(--t-on-dark-dim); }
    .hdeck .tr-dots { display: flex; gap: 6px; margin: 0 auto; }
    .hdeck .tr-dot {
      width: 14px;
      height: 4px;
      border-radius: 2px;
      background: var(--t-border);
      transition: width 0.25s ease, background 0.25s ease;
    }
    .hdeck .is-dark .tr-dot { background: var(--t-border-dark); }
    .hdeck .tr-dot.is-on { width: 30px; background: var(--t-accent); }
    .hdeck .is-dark .tr-dot.is-on { background: var(--t-accent-hi); }

    /* ---- Shrink-safe: no row keeps a minimum width, so the deck can follow the container down to phone size. */
    .hdeck { min-width: 0; max-width: 100%; }
    .hdeck .tr-slide,
    .hdeck .tr-body,
    .hdeck .tr-copy,
    .hdeck .tr-split > *,
    .hdeck .tr-cover-head,
    .hdeck .tr-cover-head > *,
    .hdeck .tr-cover-grid,
    .hdeck .tr-cover-kpis,
    .hdeck .tr-sheet,
    .hdeck .tr-duo,
    .hdeck .tr-frame,
    .hdeck .tr-kpicard,
    .hdeck .tr-nav { min-width: 0; }
    .hdeck .tr-headline,
    .hdeck .tr-lede,
    .hdeck .tr-points li { overflow-wrap: anywhere; }
    .hdeck .tr-nav { flex-wrap: wrap; row-gap: 12px; }
    .hdeck .tr-dots { flex-wrap: wrap; min-width: 0; row-gap: 6px; }
    .hdeck .tr-cover-side img { max-width: 100%; }

    /* ---- Narrow viewports. Below 900px of deck width every slide stacks into one column and
       grows to its content, so nothing is clipped. Widths are the deck's own (container), not the window's. */
    @container (max-width: 700px) {
      .hdeck { height: auto; overflow: visible; }
      .hdeck .tr-slide { flex: none; min-height: 520px; height: auto; }
      .hdeck .tr-split,
      .hdeck .tr-body,
      .hdeck .tr-duo,
      .hdeck .tr-duo.is-wide-left,
      .hdeck .tr-cards,
