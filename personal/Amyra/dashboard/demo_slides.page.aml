      .hdeck .tr-cover-kpis { grid-template-columns: minmax(0, 1fr); }
      .hdeck .tr-cover-kpis .tr-kpicard { min-height: 100px; }
      .hdeck .tr-frame,
      .hdeck .tr-slide > .tr-frame,
      .hdeck .tr-duo .tr-frame,
      .hdeck .tr-sheet .tr-frame,
      .hdeck .tr-cover-grid > .tr-frame { min-height: 260px; }
