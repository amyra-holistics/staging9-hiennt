const _theme_tokens = {
  primary: '#FFC400'
  primary_light: '#FFE27A'
  primary_dark: '#D49A00'
  navy: '#0B0B0D'
  navy_light: '#151518'
  navy_line: '#36363B'
  background: '#0B0B0D'
  surface: '#151518'
  border: '#36363B'
  text_primary: '#FFF8E6'
  text_muted: '#B9B5AA'
  text_subtle: '#79766F'
  focus_ring: '#FFE27A'
  semantic_success: '#5ED39A'
  semantic_danger: '#FF6B6B'
  font_body: 'Inter, ui-sans-serif, system-ui, sans-serif'
  font_display: 'Arial Black, Inter, ui-sans-serif, system-ui, sans-serif'
}

ColorPalette sales_deck_categorical {
  title: 'Sales Deck Categorical'
  categorical {
    colors: [
      _theme_tokens('primary'),
      '#FF6B00',
      '#FFB000',
      '#FF8A3D',
      '#FFE27A',
      '#D84A05',
      '#F4D35E',
      '#C95A00',
    ]
  }
}

Dashboard ecommerce_2025_sales_performance {
  title: '2025 Sales Performance'
  description: 'A CSS-only three-slide company update for full-year 2025 sales performance: overview, regional performance, and gender performance.'

  theme: PageTheme {
    color { data: sales_deck_categorical }

    block {
      background { bg_color: 'transparent' }
      border {
        border_width: 0
        border_style: 'none'
        border_color: _theme_tokens('border')
      }
      shadow: 'none'
      padding: 0
      label {
        font_family: _theme_tokens('font_body')
        font_color: _theme_tokens('text_primary')
        font_weight: 'semibold'
      }
      text {
        font_family: _theme_tokens('font_body')
        font_color: _theme_tokens('text_muted')
      }
    }

    viz {
      metric_kpi {
        alignment: 'left'
        label {
          font_family: _theme_tokens('font_body')
          font_color: _theme_tokens('text_muted')
          font_size: 13
          font_weight: 'medium'
        }
        value {
          font_family: _theme_tokens('font_display')
          font_color: _theme_tokens('text_primary')
          font_size: 36
          font_weight: 'bold'
        }
        trend {
          positive {
            text { font_color: _theme_tokens('semantic_success') }
            background { bg_color: 'transparent' }
          }
          negative {
            text { font_color: _theme_tokens('semantic_danger') }
            background { bg_color: 'transparent' }
          }
        }
      }
    }
  }

  block k_revenue: VizBlock {
    label: '2025 Revenue'
    viz: MetricKpi {
      dataset: ecommerce_official
      value: VizFieldFull {
        ref: r(ecommerce_official.revenue)
        label: '2025 Total Revenue'
        format {
          type: 'number'
          pattern: '[$$]#,###0.00'
        }
      }
      conditions: [
        "orders.created_at matches @(2025-01-01 until 2026-01-01)",
      ]
      settings {
        display_mode: 'single'
        alignment: 'center'
        label {
          font_size: 16
        }
        metric_value {
          font_size: 32
        }
      }
    }
  }

  block k_orders: VizBlock {
    label: '2025 Orders'
    viz: MetricKpi {
      dataset: ecommerce_official
      calculation distinct_order_count {
        label: 'Distinct Order Count'
        formula: @aql orders | count_distinct(orders.id);;
        calc_type: 'measure'
        data_type: 'number'
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      value: VizFieldFull {
        ref: 'distinct_order_count'
        label: '2025 Distinct Orders'
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      filter {
        field: r(orders.created_at)
        operator: 'matches'
        value: '2025-01-01 until 2026-01-01'
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block k_revenue_per_order: VizBlock {
    label: '2025 Revenue per Order'
    viz: MetricKpi {
      dataset: ecommerce_official
      calculation distinct_order_count {
        label: 'Distinct Order Count'
        formula: @aql orders | count_distinct(orders.id);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation average_revenue_per_distinct_order {
        label: 'Average Revenue per Order'
        formula: @aql revenue / distinct_order_count;;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'average_revenue_per_distinct_order'
        label: '2025 Average Revenue per Order'
        format {
          type: 'number'
          pattern: '[$$]#,###0.00'
        }
      }
      conditions: [
        "orders.created_at matches @(2025-01-01 until 2026-01-01)",
      ]
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block v_monthly_revenue: VizBlock {
    label: 'Monthly Revenue Trend'
    viz: CombinationChart {
      dataset: ecommerce_official
      x_axis: VizFieldFull {
        ref: r(orders.created_at)
        label: 'Month'
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        label: 'Revenue'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(ecommerce_official.revenue)
            label: 'Revenue'
            format {
              type: 'number'
              pattern: '[$$]#,###0.00'
            }
          }
        }
      }
      conditions: [
        "orders.created_at matches @(2025-01-01 until 2026-01-01)",
      ]
      settings {
        x_axis_label: 'Month'
        show_data_points: true
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block v_regional_revenue: VizBlock {
    label: 'Revenue by Region'
    viz: CombinationChart {
      dataset: ecommerce_official
      x_axis: VizFieldFull {
        ref: r(countries.continent_name)
        label: 'Continent Name'
      }
      y_axis {
        series {
          mark_type: 'bar'
          field: VizFieldFull {
            ref: r(ecommerce_official.revenue)
            label: 'Revenue'
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
        }
      }
      tooltips: [
        VizTooltip {
          field: VizFieldFull {
            ref: r(ecommerce_official.revenue)
            label: 'Revenue'
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
        }
      ]
      conditions: [
        "orders.created_at matches @(2025-01-01 until 2026-01-01)",
      ]
      settings {
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  block v_gender_revenue: VizBlock {
    label: 'Revenue by Gender'
    viz: CombinationChart {
      dataset: ecommerce_official
      calculation human_readable_gender {
        label: 'Human Readable Gender'
        formula: @aql case(
          when: users.gender == 'f', then: 'Female',
          when: users.gender == 'm', then: 'Male'
        );;
        calc_type: 'dimension'
        data_type: 'text'
        model: users
      }
      x_axis: VizFieldFull {
        ref: ref('users', 'human_readable_gender')
        label: 'Gender'
      }
      y_axis {
        label: 'Revenue (USD)'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(ecommerce_official.revenue)
            label: 'Revenue'
            format {
              type: 'number'
              pattern: '[$$]#,###0.00'
            }
          }
        }
      }
      conditions: [
        "orders.created_at matches @(2025-01-01 until 2026-01-01)",
      ]
      settings {
        x_axis_label: 'Gender'
        legend_label: 'hidden'
        sort: LineFamilySort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }

  view: HTMLLayout {
    content: @html
      <style>
        .sales-deck,
        .sales-deck *,
        .sales-deck *::before,
        .sales-deck *::after { box-sizing: border-box; }

        .sales-deck {
          --sd-bg: ${_theme_tokens('background')};
          --sd-surface: ${_theme_tokens('surface')};
          --sd-border: ${_theme_tokens('border')};
          --sd-ink: ${_theme_tokens('text_primary')};
          --sd-ink-dim: ${_theme_tokens('text_muted')};
          --sd-navy: ${_theme_tokens('navy')};
          --sd-navy-light: ${_theme_tokens('navy_light')};
          --sd-navy-line: ${_theme_tokens('navy_line')};
          --sd-green: ${_theme_tokens('primary')};
          --sd-green-light: ${_theme_tokens('primary_light')};
          --sd-green-dark: ${_theme_tokens('primary_dark')};
          --sd-font: ${_theme_tokens('font_body')};
          background: var(--sd-bg);
          color: var(--sd-ink);
          font-family: var(--sd-font);
          margin: 0 auto;
          --sd-slide-height: 810px;
          height: var(--sd-slide-height);
          max-width: 1440px;
          overflow: hidden;
          position: relative;
        }

        .sales-deck .sales-deck__slide {
          display: none;
          height: var(--sd-slide-height);
          padding: clamp(24px, 3vw, 44px);
          position: relative;
        }

        .sales-deck:not(:has(.sales-deck__slide:target)) #slide-overview,
        .sales-deck .sales-deck__slide:target { display: flex; flex-direction: column; }

        .sales-deck .sales-deck__slide--dark {
          background: var(--sd-navy);
          color: var(--sd-ink);
        }

        .sales-deck .sales-deck__slide--dark::before {
          background: radial-gradient(circle, rgba(255, 196, 0, .16), transparent 70%);
          content: '';
          height: 620px;
          pointer-events: none;
          position: absolute;
          right: -180px;
          top: -220px;
          width: 620px;
        }

        .sales-deck .sales-deck__slide > * { position: relative; }

        .sales-deck .sales-deck__masthead {
          align-items: center;
          display: flex;
          justify-content: space-between;
          margin-bottom: clamp(20px, 3vh, 32px);
        }

        .sales-deck .sales-deck__brand {
          color: var(--sd-green-light);
          font-size: 12px;
          font-weight: 600;
          letter-spacing: .14em;
          margin: 0;
          text-transform: uppercase;
        }

        .sales-deck .sales-deck__brand::before {
          background: currentColor;
          border-radius: 2px;
          content: '';
          display: inline-block;
          height: 3px;
          margin: 0 10px 3px 0;
          width: 24px;
        }

        .sales-deck .sales-deck__section-number {
          color: rgba(255, 255, 255, .7);
          font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
          font-size: 12px;
          letter-spacing: .08em;
        }

        .sales-deck .sales-deck__hero {
          display: block;
          margin-bottom: 20px;
        }

        .sales-deck .sales-deck__hero > div {
          max-width: none;
        }

        .sales-deck .sales-deck__eyebrow {
          color: var(--sd-green-light);
          font-size: 12px;
          font-weight: 600;
          letter-spacing: .14em;
          margin: 0 0 18px;
          text-transform: uppercase;
        }

        .sales-deck .sales-deck__title {
          color: var(--sd-ink);
          font-size: clamp(34px, 3.7vw, 52px);
          font-weight: 700;
          letter-spacing: -.035em;
          line-height: 1.04;
          margin: 0 0 10px;
          white-space: nowrap;
        }

        .sales-deck .sales-deck__lede {
          color: var(--sd-ink-dim);
          font-size: 15px;
          line-height: 1.5;
          margin: 0;
          max-width: none;
          white-space: nowrap;
        }

        .sales-deck .sales-deck__overview-content {
          align-items: stretch;
          display: grid;
          flex: 1;
          gap: 18px;
          grid-template-columns: minmax(250px, .3fr) minmax(0, .7fr);
          min-height: 0;
        }

        .sales-deck .sales-deck__overview-content .sales-deck__kpis {
          grid-template-columns: minmax(0, 1fr);
          grid-template-rows: repeat(3, minmax(0, 1fr));
          margin: 0;
        }

        .sales-deck .sales-deck__overview-content .sales-deck__chart-frame {
          height: 100%;
          min-height: 0;
        }

        .sales-deck .sales-deck__kpis {
          display: grid;
          gap: 12px;
          grid-template-columns: repeat(3, minmax(0, 1fr));
          margin-top: 20px;
        }

        .sales-deck .sales-deck__card {
          background: var(--sd-surface);
          border: 1px solid var(--sd-navy-line);
          border-radius: 10px;
          min-height: 88px;
          padding: 10px 16px;
        }

        .sales-deck .sales-deck__header {
          align-items: end;
          border-bottom: 1px solid var(--sd-border);
          display: flex;
          justify-content: space-between;
          margin-bottom: 30px;
          padding-bottom: 20px;
        }

        .sales-deck .sales-deck__header-eyebrow {
          color: var(--sd-green);
          font-size: 12px;
          font-weight: 600;
          letter-spacing: .14em;
          margin: 0 0 10px;
          text-transform: uppercase;
        }

        .sales-deck .sales-deck__header-title {
          color: var(--sd-ink);
          font-size: clamp(32px, 4vw, 52px);
          font-weight: 700;
          letter-spacing: -.03em;
          line-height: 1.08;
          margin: 0;
        }

        .sales-deck .sales-deck__scope {
          color: var(--sd-ink-dim);
          font-size: 12px;
          font-weight: 500;
          letter-spacing: .1em;
          margin: 0;
          text-align: right;
          text-transform: uppercase;
        }

        .sales-deck .sales-deck__chart-frame {
          background: var(--sd-bg);
          border: 1px solid var(--sd-border);
          border-radius: 10px;
          display: flex;
          flex: 1;
          min-height: 260px;
          padding: 16px;
        }

        .sales-deck .sales-deck__chart-frame > * { flex: 1; min-width: 0; }
        .sales-deck .sales-deck__chart-frame * { background: transparent !important; }

        .sales-deck .sales-deck__nav {
          align-items: center;
          border-top: 1px solid var(--sd-border);
          display: flex;
          gap: 16px;
          margin-top: 26px;
          padding-top: 20px;
        }

        .sales-deck .sales-deck__slide--dark .sales-deck__nav { border-color: var(--sd-navy-line); }

        .sales-deck .sales-deck__nav-label {
          color: var(--sd-ink-dim);
          font-size: 12px;
          font-weight: 500;
          letter-spacing: .1em;
          margin-right: auto;
          text-transform: uppercase;
        }

        .sales-deck .sales-deck__slide--dark .sales-deck__nav-label { color: #D7E1EA; }

        .sales-deck .sales-deck__nav-link {
          border: 1px solid var(--sd-border);
          border-radius: 6px;
          color: var(--sd-ink);
          font-size: 12px;
          font-weight: 600;
          letter-spacing: .05em;
          padding: 10px 16px;
          text-decoration: none;
        }

        .sales-deck .sales-deck__nav-link:hover { background: var(--sd-surface); }
        .sales-deck .sales-deck__slide--dark .sales-deck__nav-link { border-color: var(--sd-navy-line); color: #FFFFFF; }
        .sales-deck .sales-deck__nav-link--primary { background: var(--sd-green); border-color: var(--sd-green); color: #FFFFFF; }
        .sales-deck .sales-deck__nav-link--primary:hover { background: var(--sd-green-dark); border-color: var(--sd-green-dark); }

        @media (max-width: 720px) {
          .sales-deck { height: auto; }
          .sales-deck .sales-deck__slide { height: auto; min-height: 0; padding: 28px 20px; }
          .sales-deck .sales-deck__title,
          .sales-deck .sales-deck__lede { white-space: normal; }
          .sales-deck .sales-deck__kpis,
          .sales-deck .sales-deck__overview-content { grid-template-columns: minmax(0, 1fr); }
          .sales-deck .sales-deck__overview-content .sales-deck__chart-frame { min-height: 380px; }
          .sales-deck .sales-deck__header { align-items: flex-start; flex-direction: column; gap: 14px; }
          .sales-deck .sales-deck__scope { text-align: left; }
          .sales-deck .sales-deck__chart-frame { min-height: 380px; }
          .sales-deck .sales-deck__nav { flex-wrap: wrap; }
          .sales-deck .sales-deck__nav-label { width: 100%; }
        }
      </style>

      <main class="sales-deck" aria-label="2025 sales performance presentation">
        <section class="sales-deck__slide sales-deck__slide--dark" id="slide-overview" aria-labelledby="overview-title">
          <header class="sales-deck__masthead">
            <p class="sales-deck__brand">Sales performance</p>
            <span class="sales-deck__section-number">01 / 03</span>
          </header>

          <div class="sales-deck__hero">
            <div>
              <p class="sales-deck__eyebrow">Full-year review · 2025</p>
              <h1 class="sales-deck__title" id="overview-title">A year of sustained sales momentum.</h1>
              <p class="sales-deck__lede">Revenue reporting for calendar year 2025, with a monthly view of performance and focused regional and customer-segment follow-up.</p>
            </div>
          </div>

          <div class="sales-deck__overview-content">
            <section class="sales-deck__kpis" aria-label="2025 key performance indicators">
              <div class="sales-deck__card"><h-block name="k_revenue" /></div>
              <div class="sales-deck__card"><h-block name="k_orders" /></div>
              <div class="sales-deck__card"><h-block name="k_revenue_per_order" /></div>
            </section>

            <section class="sales-deck__chart-frame" aria-label="Monthly revenue trend">
              <h-block name="v_monthly_revenue" />
            </section>
          </div>

          <footer class="sales-deck__nav">
            <span class="sales-deck__nav-label">Executive overview</span>
            <a class="sales-deck__nav-link sales-deck__nav-link--primary" href="#slide-regional">Next: regional performance</a>
          </footer>
        </section>

        <section class="sales-deck__slide" id="slide-regional" aria-labelledby="regional-title">
          <header class="sales-deck__header">
            <div>
              <p class="sales-deck__header-eyebrow">Regional performance · 02 / 03</p>
              <h2 class="sales-deck__header-title" id="regional-title">Where revenue was concentrated.</h2>
            </div>
            <p class="sales-deck__scope">Revenue by region<br>Calendar year 2025</p>
          </header>

          <section class="sales-deck__chart-frame" aria-label="Revenue by region">
            <h-block name="v_regional_revenue" />
          </section>

          <footer class="sales-deck__nav">
            <a class="sales-deck__nav-link" href="#slide-overview">Previous</a>
            <span class="sales-deck__nav-label">Regional performance</span>
            <a class="sales-deck__nav-link sales-deck__nav-link--primary" href="#slide-gender">Next: customer mix</a>
          </footer>
        </section>

        <section class="sales-deck__slide" id="slide-gender" aria-labelledby="gender-title">
          <header class="sales-deck__header">
            <div>
              <p class="sales-deck__header-eyebrow">Customer mix · 03 / 03</p>
              <h2 class="sales-deck__header-title" id="gender-title">Revenue by customer gender.</h2>
            </div>
            <p class="sales-deck__scope">Revenue by gender<br>Calendar year 2025</p>
          </header>

          <section class="sales-deck__chart-frame" aria-label="Revenue by gender">
            <h-block name="v_gender_revenue" />
          </section>

          <footer class="sales-deck__nav">
            <a class="sales-deck__nav-link" href="#slide-regional">Previous</a>
            <span class="sales-deck__nav-label">Customer mix</span>
            <a class="sales-deck__nav-link sales-deck__nav-link--primary" href="#slide-overview">Restart</a>
          </footer>
        </section>
      </main>
    ;;
  }
}
