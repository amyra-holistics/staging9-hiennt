  </section>

  <!-- ===== STORY 2 ====================================================== -->
  <section class="edt-page" id="edt-s2">
    <div class="edt-story-inner">
      <div class="edt-story-top">
        <a class="edt-back" href="#edt-front">&#8592; Front page</a>
        <span class="edt-count">02</span>
      </div>
      <h-block name="t_s2" />
      <figure class="edt-figure">
        <div class="edt-figure-slot"><h-block name="v_s2" /></div>
        <figcaption class="edt-source">
          <span class="edt-source-note"></span>
          <span class="edt-source-mark"></span>
        </figcaption>
      </figure>
      <h-block name="t_s2_note" />
    </div>
  </section>

  <!-- ===== STORY 3 ====================================================== -->
  <section class="edt-page" id="edt-s3">
    <div class="edt-story-inner">
      <div class="edt-story-top">
        <a class="edt-back" href="#edt-front">&#8592; Front page</a>
        <span class="edt-count">03</span>
      </div>
      <h-block name="t_s3" />
      <figure class="edt-figure">
        <div class="edt-figure-slot"><h-block name="v_s3" /></div>
        <figcaption class="edt-source">
          <span class="edt-source-note"></span>
          <span class="edt-source-mark"></span>
        </figcaption>
      </figure>
      <h-block name="t_s3_note" />
    </div>
  </section>

  <!-- ===== STORY 4 ====================================================== -->
  <section class="edt-page" id="edt-s4">
    <div class="edt-story-inner">
      <div class="edt-story-top">
        <a class="edt-back" href="#edt-front">&#8592; Front page</a>
        <span class="edt-count">04</span>
      </div>
      <h-block name="t_s4" />
      <figure class="edt-figure">
        <div class="edt-figure-slot"><h-block name="v_s4" /></div>
        <figcaption class="edt-source">
          <span class="edt-source-note"></span>
          <span class="edt-source-mark"></span>
        </figcaption>
      </figure>
      <h-block name="t_s4_note" />
