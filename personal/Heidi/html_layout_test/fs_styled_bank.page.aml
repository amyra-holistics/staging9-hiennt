    <a href="#edt-s3"><span class="edt-nav-num"></span>Nav label</a>
    <a href="#edt-s4"><span class="edt-nav-num"></span>Nav label</a>
  </nav>

  <!-- ===== FRONT PAGE =================================================== -->
  <section class="edt-page" id="edt-front">

    <div class="edt-kpis">
      <div class="edt-kpi-slot"><h-block name="k_kpi_1" /></div>
      <div class="edt-kpi-slot"><h-block name="k_kpi_2" /></div>
      <div class="edt-kpi-slot"><h-block name="k_kpi_3" /></div>
      <div class="edt-kpi-slot"><h-block name="k_kpi_4" /></div>
    </div>

    <div class="edt-lead">
      <div class="edt-lead-copy"><h-block name="t_lead" /></div>
      <div class="edt-lead-pane"><h-block name="v_lead" /></div>
    </div>

    <div class="edt-note-wrap"><h-block name="t_lead_note" /></div>

    <div class="edt-columns">
      <div class="edt-col"><h-block name="t_index_news" /></div>
      <div class="edt-rail"><h-block name="t_index_rail" /></div>
    </div>

  </section>

  <!-- ===== STORY 1 ====================================================== -->
  <section class="edt-page" id="edt-s1">
    <div class="edt-story-inner">
      <div class="edt-story-top">
        <a class="edt-back" href="#edt-front">&#8592; Front page</a>
        <span class="edt-count">01</span>
      </div>
      <h-block name="t_s1" />
      <figure class="edt-figure">
        <div class="edt-figure-slot"><h-block name="v_s1" /></div>
        <figcaption class="edt-source">
          <span class="edt-source-note"></span>
          <span class="edt-source-mark"></span>
        </figcaption>
      </figure>
      <h-block name="t_s1_note" />
