// ============================================================================
// TEMPLATE  slides / holistics
// ----------------------------------------------------------------------------
// A nine-slide deck with prev/next navigation, built with CSS :target only —
// no JavaScript.
//
// BRAND
//   Navy #06213F with elevated panels at #0D3562, green #259B6C. Inter for
//   everything, JetBrains Mono for figures and counters.
//
//   Two notes on the palette. Panels on dark slides use a solid lighter navy
//   rather than a translucent white wash, so they read as real surfaces. And
//   green splits into two roles: #259B6C stays the fill for buttons and chips,
//   while #3FBE88 is used for text and hairlines on navy, where the darker
//   green loses contrast at small sizes. On light slides #259B6C does both.
//
//   Each dark slide carries one soft radial wash from the top right. It is the
//   only decoration in the deck — it gives the navy a light direction. Delete
//   the .is-dark::before rule for a completely flat treatment.
//
//   The logo slot on the cover and closing slides is commented out until a
//   permanently hosted asset URL is available. Use the light lockup on the
//   navy slides and the dark lockup on light slides, always symbol plus
//   wordmark, never recolored, never with effects.
//
// SLIDES
//   01  visual story cover       dark    headline plus a block on the right
//   02  narrative cover          dark    alternate statement-led opener
//   03  presentation roadmap     tint    numbered list of sections
//   04  section transition       dark    numeral and section title
//   05  executive takeaway       dark    one number at display size
//   06  performance trend        light   chart beside copy
//   07  full-width analysis      light   chart edge to edge
//   08  comparative snapshot     tint    three cards
//   09  closing & call to action dark    closing metric and caption
//
// SLOT CONTRACT
//   v_cover       any block optional     visual cover, right side
//   v_trend       any viz   recommended  trend slide
//   k_statement   KPI       optional     big statement slide
//   v_full        any viz   recommended  full-bleed slide
//   v_seg_1..3    any viz   optional     three-card comparison slide
//   k_closing     KPI       optional     closing slide
//
// All copy below is generic placeholder text. Replace it, and swap the
// placeholder TextBlocks for data-backed VizBlocks, once the audience,
// decision, and available dataset are confirmed.
//
// NAVIGATION
//   At nine slides a per-slide dot rail means editing nine rails on every
//   change, so the nav is Prev, a section label and counter, then Next. To
//   restore jump-to-slide dots, add an <a> rail in each footer and mark the
//   current one — but expect to update every rail whenever a slide moves.
//
// ADDING OR REMOVING A SLIDE
//   1. Copy a <section class="hol-slide" id="hl-N">.
//   2. Update the href on its Prev and Next buttons.
//   3. Update the href on the neighbouring slides' buttons.
//   4. Renumber the counters.
//
// PREFLIGHT
//   [x] every declared block appears in exactly one <h-block>
//   [x] every chart frame has an explicit min-height
//   [x] no <script>, no inline JS
//   [x] all selectors scoped under .hol
//   [x] theme block sets transparent background and 0 border
//   [x] :not(:has(.hol-slide:target)) default rule present
//   [x] literal colors confined to the token block
// ============================================================================

ColorPalette holistics_slides_palette {
  title: 'Holistics Slides'
  categorical {
    colors: [
      '#259B6C',
      '#2D6FAD',
      '#D06545',
      '#B78320',
      '#278C9A',
      '#8A5AA5',
      '#5A9B58',
      '#C26778',
    ]
  }
}

Dashboard holistics_slides_demo {
  title: 'Executive Presentation Template'
  description: 'A reusable nine-slide executive presentation template in Holistics brand style: visual cover, text-only cover, agenda, section divider, executive takeaway, performance trend, full-width analysis, comparative snapshot, and closing. Replace the placeholder copy and blocks before sharing.'

  block t_visual_cover_copy: TextBlock {
    content: @md
      <div class="hol-eyebrow">This is an eyebrow</div>
      <h2 class="hol-headline">This is a title<br><span class="hol-accent">and a second line.</span></h2>
      <p class="hol-lede">Here's an example of body text. You can change the wording and the length, and the accent color is used for highlights, rules, and buttons.</p>
    ;;
  }
  block v_cover: TextBlock {
    content: @md
      ### This can be anything

      Use this space for an image, visualization, embedded content, or any other block that supports your opening story.
    ;;
  }
  block v_trend: VizBlock {
    label: 'Total Sales by Status'
    viz: ColumnChart {
      dataset: ecommerce_official
      x_axis: VizFieldFull {
        ref: r(orders.created_at)
        transformation: 'datetrunc year'
        format {
          type: 'date'
          pattern: 'yyyy'
        }
      }
      legend: VizFieldFull {
        ref: r(orders.status)
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            label: ' '
            ref: r(orders.id)
            aggregation: 'count'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        x_axis_show_null_datetime: false
      }
    }
  }
  block k_statement: TextBlock {
    content: @md Headline number ;;
  }
  block v_full: VizBlock {
    label: 'Slide 7 Sales Detail'
    viz: DataTable {
      dataset: vy_test
      calculation sales {
        label: 'Sales'
        formula: @aql vy_test_filter_dependency_sheet_1_csv | sum(vy_test_filter_dependency_sheet_1_csv.sales);;
        calc_type: 'measure'
        data_type: 'number'
      }
      fields: [
        VizFieldFull {
          label: 'Date'
          ref: r(vy_test_filter_dependency_sheet_1_csv.date)
          format {
            type: 'date'
            pattern: 'LLL dd, yyyy'
          }
          uname: 'vy_test_filter_dependency_sheet_1_csv_date_1'
        },
        VizFieldFull {
          label: 'Category'
          ref: r(vy_test_filter_dependency_sheet_1_csv.category)
          format {
            type: 'text'
          }
          uname: 'vy_test_filter_dependency_sheet_1_csv_category_1'
        },
        VizFieldFull {
          label: 'Sales'
          ref: 'sales'
          format {
            type: 'number'
            pattern: '#,###0.00'
          }
        }
      ]
      settings {
        sorts: [
          KeyBasedSortSetting {
            key: 'vy_test_filter_dependency_sheet_1_csv_date_1'
            direction: 'asc'
          },
          KeyBasedSortSetting {
            key: 'vy_test_filter_dependency_sheet_1_csv_category_1'
            direction: 'asc'
          }
        ]
      }
    }
  }
  block v_seg_1: VizBlock {
    label: 'Total Sales'
    viz: MetricKpi {
      dataset: vy_test
      calculation total_sales {
        label: 'Total Sales'
        formula: @aql vy_test_filter_dependency_sheet_1_csv | sum(vy_test_filter_dependency_sheet_1_csv.sales);;
        calc_type: 'measure'
        data_type: 'number'
        format {
          type: 'number'
          pattern: '#,###0.00'
        }
      }
      value: VizFieldFull {
        ref: 'total_sales'
        label: 'Total Sales'
        format {
          type: 'number'
          pattern: '#,###0.00'
        }
      }
    }
    settings {
      hide_label: true
    }
  }
  block v_seg_2: VizBlock {
    label: 'Average Sales'
    viz: MetricKpi {
      dataset: vy_test
      calculation average_sales {
        label: 'Average Sales'
        formula: @aql vy_test_filter_dependency_sheet_1_csv | avg(vy_test_filter_dependency_sheet_1_csv.sales);;
        calc_type: 'measure'
        data_type: 'number'
        format {
          type: 'number'
          pattern: '#,###0.00'
        }
      }
      value: VizFieldFull {
        ref: 'average_sales'
        label: 'Average Sales'
        format {
          type: 'number'
          pattern: '#,###0.00'
        }
      }
    }
    settings {
      hide_label: true
    }
  }
  block v_seg_3: VizBlock {
    label: 'Row Count'
    viz: MetricKpi {
      dataset: vy_test
      calculation row_count {
        label: 'Row Count'
        formula: @aql vy_test_filter_dependency_sheet_1_csv | count(vy_test_filter_dependency_sheet_1_csv.date);;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'row_count'
        label: 'Row Count'
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
    }
    settings {
      hide_label: true
    }
  }
  block k_closing: TextBlock {
    content: @md Closing metric ;;
  }
  block t_narrative_cover_copy: TextBlock {
    content: @md
      <div class="hol-eyebrow">This is an eyebrow</div>
      <h2 class="hol-headline is-lg">This is a title<br><span class="hol-accent">and a second line.</span></h2>
      <p class="hol-lede is-wide">This opener uses the whole slide for words. Use it when the story starts with a statement rather than a picture, and let the extra space do the work.</p>
    ;;
  }
  block t_roadmap_heading_copy: TextBlock {
    content: @md
      <div class="hol-eyebrow">This is an agenda</div>
      <h2 class="hol-headline is-mid">This is a section title</h2>
    ;;
  }
  block t_roadmap_item_1_copy: TextBlock {
    content: @md
      <div class="hol-agenda-copy">
        <span class="hol-agenda-name">First title</span>
        <span class="hol-agenda-note">This is a short note</span>
      </div>
    ;;
  }
  block t_roadmap_item_2_copy: TextBlock {
    content: @md
      <div class="hol-agenda-copy">
        <span class="hol-agenda-name">Second title</span>
        <span class="hol-agenda-note">Add or remove rows as you need</span>
      </div>
    ;;
  }
  block t_roadmap_item_3_copy: TextBlock {
    content: @md
      <div class="hol-agenda-copy">
        <span class="hol-agenda-name">Third title</span>
        <span class="hol-agenda-note">Three to six rows works best</span>
      </div>
    ;;
  }
  block t_roadmap_item_4_copy: TextBlock {
    content: @md
      <div class="hol-agenda-copy">
        <span class="hol-agenda-name">Fourth title</span>
        <span class="hol-agenda-note">The note is optional</span>
      </div>
    ;;
  }
  block t_section_transition_num_copy: TextBlock {
    content: @md 01 ;;
  }
  block t_section_transition_copy: TextBlock {
    content: @md
      <h2 class="hol-headline">This is a section</h2>
      <p class="hol-lede">One line on what this section covers. Copy this slide between sections and change the numeral.</p>
    ;;
  }
  block t_executive_takeaway_eyebrow: TextBlock {
    content: @md <div class="hol-eyebrow">This is a statement</div> ;;
  }
  block t_executive_takeaway_copy: TextBlock {
    content: @md
      <h2 class="hol-headline is-mid">This is the one sentence you want remembered.</h2>
      <p class="hol-lede">Here's an example of body text. Keep this slide to a single idea — the number carries it, and everything else is support.</p>
    ;;
  }
  block t_performance_trend_copy: TextBlock {
    content: @md
      <div class="hol-eyebrow">This is a chart slide</div>
      <h2 class="hol-headline is-mid">This is a title with a chart beside it</h2>
      <p class="hol-lede">Here's an example of body text. The chart sits in a frame that fills the space next to it, at any width.</p>
    ;;
  }
  block t_full_width_analysis_copy: TextBlock {
    content: @md
      <div class="hol-eyebrow">Deep-dive analysis</div>
      <h2 class="hol-headline is-mid">See the full picture behind the trend</h2>
    ;;
  }
  block t_comparative_snapshot_copy: TextBlock {
    content: @md
      <div class="hol-eyebrow">This is a card row</div>
      <h2 class="hol-headline is-mid">This is a section title</h2>
    ;;
  }
  block t_closing_heading_copy: TextBlock {
    content: @md
      <div class="hol-eyebrow">This is the last slide</div>
      <h2 class="hol-headline">That's it.</h2>
    ;;
  }
  block t_closing_caption_copy: TextBlock {
    content: @md <div class="hol-meta">This is a caption. Change it or remove it.</div> ;;
  }

  view: HTMLLayout {
    content: @html

<div class="hol">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap');

    .hol,
    .hol *,
    .hol *::before,
    .hol *::after { box-sizing: border-box; }

    /* ---- THEME TOKENS — swap this block to reskin. Nothing below holds a hex. */
    /* Shared brand values must stay aligned with the inline theme and palette: navy #05264C, muted #5C6E85, green #259B6C, border #E1E7EE, tint #F5F8FA. When changing one here, update its corresponding theme and palette value. */
    .hol {
      --t-navy:      #06213F;
      --t-navy-2:    #0D3562;
      --t-navy-line: #1A4A80;
      --t-green:     #259B6C;
      --t-green-lt:  #3FBE88;
      --t-green-dk:  #1B7A54;
      --t-bg:        #FFFFFF;
      --t-surface:   #F5F8FA;
      --t-border:    #E1E7EE;
      --t-ink:       #05264C;
      --t-ink-dim:   #5C6E85;
      --t-on-dark:     #FFFFFF;
      --t-on-dark-dim: #8FA9C7;
      --t-wash:      rgba(37, 155, 108, 0.16);
      --t-radius:    10px;
      --t-radius-sm: 6px;
      --t-pad:       clamp(28px, 5.4vw, 80px);
      --t-font-sans: Inter, -apple-system, 'Segoe UI', Roboto, sans-serif;
      --t-font-mono: 'JetBrains Mono', ui-monospace, Menlo, Consolas, monospace;

      font-family: var(--t-font-sans);
      color: var(--t-ink);
      background: var(--t-bg);
      border-radius: var(--t-radius);
      overflow: hidden;
      position: relative;
      height: 760px;
      display: flex;
      flex-direction: column;
    }

    /* ---- Slide visibility */
    .hol .hol-slide {
      display: none;
      flex: 1;
      flex-direction: column;
      padding: var(--t-pad);
      background: var(--t-bg);
      position: relative;
      overflow: hidden;
      animation: hol-in 0.4s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .hol .hol-slide:target { display: flex; }
    .hol:not(:has(.hol-slide:target)) #hl-1 { display: flex; }

    @keyframes hol-in {
      from { opacity: 0; transform: translateY(8px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .hol .hol-slide.is-dark { background: var(--t-navy); color: var(--t-on-dark); }
    .hol .hol-slide.is-tint { background: var(--t-surface); }

    /* One soft light source on dark slides. The only decoration in the deck. */
    .hol .hol-slide.is-dark::before {
      content: "";
      position: absolute;
      top: -220px;
      right: -180px;
      width: 620px;
      height: 620px;
      background: radial-gradient(circle, var(--t-wash), transparent 70%);
      pointer-events: none;
    }
    .hol .hol-slide > * { position: relative; }

    /* ---- Logo lockup. Symbol and wordmark together, never separated.
       Clear space is the cap height of the "o", roughly 0.55x the logo
       height, applied here as padding so nothing crowds it. */
    .hol .hol-logo {
      display: block;
      height: 28px;
      width: auto;
      padding: 15px 15px 15px 0;
      margin-bottom: 8px;
    }
    .hol .hol-close .hol-logo { padding-right: 0; margin: 0 auto 8px; }

    /* ---- Type scale. Four sizes only, per the brand guide. */
    .hol .hol-eyebrow {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--t-green);
      margin-bottom: 20px;
    }
    .hol .is-dark .hol-eyebrow { color: var(--t-green-lt); }
    .hol .hol-eyebrow::before {
      content: "";
      width: 24px;
      height: 3px;
      border-radius: 2px;
      background: currentColor;
      flex-shrink: 0;
    }
    .hol .hol-headline {
      font-size: clamp(32px, 4.4vw, 60px);
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.1;
      color: var(--t-ink);
      margin: 0 0 22px 0;
    }
    .hol .is-dark .hol-headline { color: var(--t-on-dark); }
    .hol .hol-headline.is-lg  { font-size: clamp(40px, 6vw, 76px); }
    .hol .hol-headline.is-mid { font-size: clamp(24px, 2.8vw, 36px); }
    .hol .hol-accent { color: var(--t-green); }
    .hol .is-dark .hol-accent { color: var(--t-green-lt); }
    .hol .hol-lede {
      font-size: 17px;
      line-height: 1.65;
      color: var(--t-ink-dim);
      max-width: 66ch;
      margin: 0;
    }
    .hol .hol-lede.is-wide { font-size: 19px; max-width: 72ch; }
    .hol .is-dark .hol-lede { color: var(--t-on-dark-dim); }
    .hol .hol-meta {
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--t-ink-dim);
    }
    .hol .is-dark .hol-meta { color: var(--t-on-dark-dim); }

    /* ---- Slide body */
    .hol .hol-body {
      flex: 1;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: clamp(24px, 4vw, 56px);
      align-items: center;
    }
    .hol .hol-body.is-single { grid-template-columns: minmax(0, 1fr); }
    .hol .hol-body.is-single .hol-copy { max-width: 880px; }
    .hol .hol-copy { display: flex; flex-direction: column; justify-content: center; }

    /* ---- Chart frames. Every one needs a min-height or the block collapses. */
    .hol .hol-frame {
      background: var(--t-bg);
      border: 1px solid var(--t-border);
      border-radius: var(--t-radius);
      padding: 18px;
      min-height: 380px;
      display: flex;
    }
    .hol .hol-frame > * { flex: 1; min-width: 0; }
    .hol .hol-frame * { background: transparent !important; }
    .hol .is-dark .hol-frame {
      background: var(--t-navy-2);
      border-color: var(--t-navy-line);
    }
    .hol .is-dark .hol-frame * { color: var(--t-on-dark) !important; }
    .hol .hol-frame.is-cover { border-top: 3px solid var(--t-green-lt); }

    /* Full-bleed: no card, the chart is the slide. */
    .hol .hol-frame.is-flush {
      flex: 1;
      border: none;
      border-radius: 0;
      padding: 0;
      min-height: 340px;
      margin-top: 8px;
    }

    /* ---- Section divider */
    .hol .hol-divider {
      flex: 1;
      display: grid;
      grid-template-columns: clamp(210px, 20vw, 280px) minmax(0, 1fr);
      align-items: center;
      column-gap: clamp(28px, 3vw, 48px);
      padding-left: 0;
    }
    .hol .hol-divider-num {
      min-width: 0;
      color: var(--t-green-lt);
    }
    /* TextBlocks set their own type rules, so target the rendered block directly. */
    .hol .hol-divider-num .dac-text-block,
    .hol .hol-divider-num .dac-text-block p {
      font-family: var(--t-font-mono) !important;
      font-size: clamp(96px, 13vw, 176px) !important;
      font-weight: 500 !important;
      line-height: 0.9 !important;
      letter-spacing: -0.08em;
      color: var(--t-green-lt) !important;
      margin: 0 !important;
    }
    .hol .hol-divider-body {
      min-width: 0;
      max-width: 820px;
    }
    .hol .hol-divider-body .hol-headline { margin-bottom: 14px; }

    /* ---- Big statement */
    .hol .hol-statement {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      max-width: 940px;
    }
    .hol .hol-statement-value { min-height: 120px; display: flex; margin-bottom: 8px; }
    .hol .hol-statement-value > * { flex: 1; }
    .hol .hol-statement-value * { background: transparent !important; }

    /* ---- Agenda */
    .hol .hol-agenda {
      flex: 1;
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
      max-width: 880px;
    }
    .hol .hol-agenda-item {
      display: flex;
      align-items: baseline;
      gap: 20px;
      padding: 18px 0;
      border-top: 1px solid var(--t-border);
    }
    .hol .hol-agenda-item:last-child { border-bottom: 1px solid var(--t-border); }
    .hol .hol-agenda-num {
      font-family: var(--t-font-mono);
      font-size: 14px;
      font-weight: 500;
      color: var(--t-green);
      flex-shrink: 0;
      width: 28px;
    }
    .hol .hol-agenda-name { font-size: 20px; font-weight: 600; flex-shrink: 0; }
    .hol .hol-agenda-item > h-block { flex: 1; min-width: 0; }
    .hol .hol-agenda-copy {
      display: flex;
      align-items: baseline;
      gap: 20px;
      width: 100%;
    }
    .hol .hol-agenda-note {
      font-size: 15px;
      color: var(--t-ink-dim);
      margin-left: auto;
      text-align: right;
    }

    /* ---- Three-card slide */
    .hol .hol-cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 20px;
    }
    .hol .hol-card {
      background: var(--t-bg);
      border: 1px solid var(--t-border);
      border-radius: var(--t-radius);
      padding: 20px;
    }
    .hol .hol-card-chart {
      min-height: 200px;
      display: flex;
      margin-bottom: 16px;
    }
    .hol .hol-card-chart > * { flex: 1; min-width: 0; }
    .hol .hol-card-chart * { background: transparent !important; }
    .hol .hol-card-foot {
      display: flex;
      align-items: center;
      gap: 10px;
      padding-top: 14px;
      border-top: 1px solid var(--t-border);
    }
    .hol .hol-card-name { font-size: 16px; font-weight: 600; }
    .hol .hol-card-figure {
      font-family: var(--t-font-mono);
      font-size: 16px;
      font-weight: 500;
      color: var(--t-ink);
      margin-left: auto;
    }
    .hol .hol-chip {
      width: 10px;
      height: 10px;
      border-radius: 3px;
      flex-shrink: 0;
    }
    .hol .hol-chip.is-green { background: var(--t-green); }
    .hol .hol-chip.is-navy  { background: var(--t-navy); }
    .hol .hol-chip.is-grey  { background: var(--t-border); }

    /* ---- Closing slide */
    .hol .hol-close {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      gap: 20px;
    }
    .hol .hol-rule {
      width: 56px;
      height: 3px;
      border-radius: 2px;
      background: var(--t-green-lt);
    }
    .hol .hol-close-kpi { min-height: 110px; display: flex; }
    .hol .hol-close-kpi > * { flex: 1; }
    .hol .hol-close-kpi * { background: transparent !important; }

    /* ---- Navigation */
    .hol .hol-nav {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-top: auto;
      padding-top: 22px;
      border-top: 1px solid var(--t-border);
    }
    .hol .is-dark .hol-nav { border-top-color: var(--t-navy-line); }
    .hol .hol-nav-mid {
      margin: 0 auto;
      display: flex;
      align-items: baseline;
      gap: 12px;
    }
    .hol .hol-nav-label {
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--t-ink-dim);
    }
    .hol .is-dark .hol-nav-label { color: var(--t-on-dark-dim); }
    .hol .hol-btn {
      display: inline-flex;
      align-items: center;
      padding: 10px 18px;
      border-radius: var(--t-radius-sm);
      border: 1px solid var(--t-border);
      color: var(--t-ink);
      text-decoration: none;
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 0.06em;
      transition: background 0.2s ease, border-color 0.2s ease;
    }
    .hol .hol-btn:hover { background: var(--t-surface); }
    .hol .is-dark .hol-btn { color: var(--t-on-dark); border-color: var(--t-navy-line); }
    .hol .is-dark .hol-btn:hover { background: var(--t-navy-2); }
    .hol .hol-btn.is-primary {
      background: var(--t-green);
      border-color: var(--t-green);
      color: var(--t-on-dark);
    }
    .hol .hol-btn.is-primary:hover { background: var(--t-green-dk); border-color: var(--t-green-dk); }
    .hol .hol-btn.is-off { opacity: 0.35; pointer-events: none; }
    .hol .hol-count {
      font-family: var(--t-font-mono);
      font-size: 12px;
      color: var(--t-ink-dim);
    }
    .hol .is-dark .hol-count { color: var(--t-on-dark-dim); }

    /* ---- KPI block internals */
    .hol .hol-statement-value .h-kpi-metric-kpi,
    .hol .hol-statement-value .h-kpi-metric-kpi * {
      font-family: var(--t-font-sans) !important;
      font-weight: 700 !important;
      font-size: 84px !important;
      letter-spacing: -0.03em !important;
      line-height: 1 !important;
      color: var(--t-on-dark) !important;
      background: transparent !important;
      border: none !important;
      padding: 0 !important;
      margin: 0 !important;
    }
    .hol .hol-close-kpi .h-kpi-metric-kpi,
    .hol .hol-close-kpi .h-kpi-metric-kpi * {
      font-family: var(--t-font-sans) !important;
      font-weight: 700 !important;
      font-size: 56px !important;
      letter-spacing: -0.02em !important;
      color: var(--t-on-dark) !important;
      background: transparent !important;
    }

    /* ---- Narrow viewports */
    @media (max-width: 900px) {
      .hol .hol-body { grid-template-columns: minmax(0, 1fr); }
      .hol .hol-divider {
        grid-template-columns: minmax(0, 1fr);
        row-gap: 12px;
        padding-left: 0;
      }
      .hol .hol-agenda-item { flex-wrap: wrap; gap: 8px 20px; }
      .hol .hol-agenda-note { margin-left: 48px; text-align: left; }
      .hol .hol-nav { flex-wrap: wrap; }
      .hol .hol-nav-mid { order: 3; width: 100%; margin: 0; }
    }
  </style>

  <!-- ============ SLIDE 1 — visual story cover ============ -->
