  // Shared brand values must stay aligned with the HTMLLayout CSS tokens and palette: navy #05264C, muted #5C6E85, green #259B6C, border #E1E7EE, tint #F5F8FA. When changing one here, update its corresponding CSS and palette value.
  theme {
    color {
      data: holistics_slides_palette
    }

    block {
      background {
        bg_color: 'transparent'
      }
      border {
        border_width: 0
        border_style: 'none'
        border_radius: 10
        border_color: '#E1E7EE'
      }
      shadow: 'none'
      padding: 0
      opacity: 1
      label {
        font_family: 'Inter'
        font_size: 15
        font_color: '#05264C'
        font_weight: 'semibold'
      }
      text {
        font_family: 'Inter'
        font_size: 14
        font_color: '#5C6E85'
        font_weight: 'normal'
      }
    }

    viz {
      table {
        general {
          bg_color: '#FFFFFF'
          hover_color: '#F5F8FA'
          banding_color: '#FAFBFC'
          font_size: 14
          font_color: '#5C6E85'
          font_family: 'Inter'
          border_color: '#E1E7EE'
          border_width: 1
          grid_color: '#E1E7EE'
        }
        header {
          bg_color: '#F5F8FA'
          font_size: 15
          font_color: '#05264C'
          font_weight: 'semibold'
        }
        sub_header {
          bg_color: '#F5F8FA'
          font_size: 14
          font_color: '#5C6E85'
          font_weight: 'medium'
        }
        sub_title {
          font_size: 13
          font_color: '#5C6E85'
          font_weight: 'medium'
        }
        sparkline {
          line {
            color: '#259B6C'
          }
          column {
            color: '#259B6C'
          }
        }
      }
      metric_kpi {
        alignment: 'left'
        label {
          font_family: 'Inter'
          font_size: 22
          font_color: '#5C6E85'
        }
        value {
          font_family: 'Inter'
          font_size: 56
          font_color: '#05264C'
        }
        progress {
          indicator {
            bg_color: '#259B6C'
          }
          track {
            bg_color: '#E1E7EE'
          }
          text {
            font_color: '#5C6E85'
          }
        }
        trend {
          positive {
            text {
              font_color: '#259B6C'
            }
            background {
              bg_color: '#E1F4EB'
            }
          }
          negative {
            text {
              font_color: '#B42318'
            }
            background {
              bg_color: '#FDECEA'
            }
          }
          neutral {
            text {
              font_color: '#5C6E85'
            }
            background {
              bg_color: '#F5F8FA'
            }
          }
        }
      }
    }

    custom_css: @css
      .dac-text-block {
        font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        font-size: 14px;
        color: #5C6E85;
        line-height: 1.6;
      }
      .dac-text-block h1, .dac-text-block h2, .dac-text-block h3, .dac-text-block h4, .dac-text-block h5, .dac-text-block h6 {
        font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        color: #05264C;
        line-height: 1.3;
        margin-top: 0;
        margin-bottom: 0.5em;
        font-weight: 600;
      }
    ;;
  }
}