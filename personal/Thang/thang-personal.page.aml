Dashboard thang_personal {
  title: 'Ecommerce Overview'
  owner: 'thang.lk@holistics.io'
  block v1: VizBlock {
    label: 'Name and Parent'
    viz: DataTable {
      dataset: ecommerce_dataset
      theme {
      }
      fields: [
        VizFieldFull {
          ref: r(ecommerce_categories_2.name)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(ecommerce_categories_2.parent_id)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        show_row_number: true
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v2: VizBlock {
    label: 'Sum of Cost and Sum of Sales by Month'
    viz: LineChart {
      dataset: ecommerce_dataset
      x_axis: VizFieldFull {
        ref: r(ecommerce_financial.month_)
        format {
          type: 'date'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(ecommerce_financial.cost)
            aggregation: 'sum'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#E27712'
            color_palette: 'seq-magma'
          }
        }
        series {
          field: VizFieldFull {
            ref: r(ecommerce_financial.sales)
            aggregation: 'sum'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#18A59E'
            color_palette: 'seq-magma'
          }
        }
      }
    }
  }
  block v3: VizBlock {
    label: 'Untitled Report'
    viz: DataTable {
      dataset: vinhhh_test_activities
      theme {
      }
      fields: [
        VizFieldFull {
          ref: r(public_activities.trackable_type)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(public_activities.owner_type)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(public_activities.key)
          format {
            type: 'text'
          }
        }
      ]
      settings {
        show_row_number: true
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v4: VizBlock {
    label: 'Name and Parent'
    viz: DataTable {
      dataset: ecommerce_dataset
      fields: [
        VizFieldFull {
          ref: r(ecommerce_categories_2.name)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(ecommerce_categories_2.parent_id)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        show_row_number: true
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v5: VizBlock {
    label: 'Sum of Cost and Sum of Sales by Month'
    viz: LineChart {
      dataset: ecommerce_dataset
      x_axis: VizFieldFull {
        ref: r(ecommerce_financial.month_)
        format {
          type: 'date'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(ecommerce_financial.cost)
            aggregation: 'sum'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#E27712'
            color_palette: 'seq-magma'
          }
        }
        series {
          field: VizFieldFull {
            ref: r(ecommerce_financial.sales)
            aggregation: 'sum'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#18A59E'
            color_palette: 'seq-magma'
          }
        }
      }
    }
  }
  block v6: VizBlock {
    label: 'Untitled Report'
    viz: DataTable {
      dataset: vinhhh_test_activities
      theme {
      }
      fields: [
        VizFieldFull {
          ref: r(public_activities.trackable_type)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(public_activities.owner_type)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(public_activities.key)
          format {
            type: 'text'
          }
        }
      ]
      settings {
        show_row_number: true
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_top_products: VizBlock {
    label: 'Top Products by Revenue'
    viz: DataTable {
      dataset: ecommerce_official
      fields: [
        VizFieldFull {
          label: 'Product Name'
          ref: r(products.name)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'Revenue'
          ref: r(ecommerce_official.revenue)
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'revenue'
        }
      ]
      settings {
        pagination_size: 10
        wrap_header_text: true
        show_row_number: true
        sorts: [
          SortSetting {
            key: 'revenue'
            direction: 'desc'
          }
        ]
        row_limit: 10
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
        single_cell_display: 'normal'
      }
    }
  }
  interactions: []
  view: TabLayout {
    label: 'Overview'
    tab overview: CanvasLayout {
      label: 'Overview'
      width: 1220
      height: 980
      grid_size: 20
      auto_expand_vertically: true
      block v_top_products {
        position: pos(620, 560, 580, 320)
        layer: 1
      }
      mobile {
        mode: 'auto'
      }
    }
  }
  theme: H.themes.classic
}