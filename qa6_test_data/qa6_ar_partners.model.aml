Model qa6_ar_partners {
  type: 'query'
  label: 'QA6 AR Partners'
  description: 'QA6 test data for AI Delivery QA round 6 (per-row recipients). Fictional. Safe to delete.'
  data_source_name: 'demodb'
  query: @sql
    select * from (values
      ('Partner A', 'nhi.ty+partnera@holistics.io', 3),
      ('Partner B', 'nhi.ty+partnerb@holistics.io', 1),
      ('Partner C', 'nhi.ty+partnerc@holistics.io', 0)
    ) as t(ar_partner, contact_email, policies_approaching_cancellation);;

  dimension ar_partner {
    label: 'AR Partner'
    type: 'text'
    definition: @sql {{ #SOURCE.ar_partner }};;
    primary_key: true
  }
  dimension contact_email {
    label: 'Contact email'
    type: 'text'
    definition: @sql {{ #SOURCE.contact_email }};;
  }
  dimension policies_approaching_cancellation {
    label: 'Policies approaching cancellation'
    type: 'number'
    definition: @sql {{ #SOURCE.policies_approaching_cancellation }};;
  }
}
