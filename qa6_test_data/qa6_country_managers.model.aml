Model qa6_country_managers {
  type: 'query'
  label: 'QA6 Country Managers'
  description: 'QA6 test data for AI Delivery QA round 6 (per-row recipients). Fictional. Safe to delete.'
  data_source_name: 'demodb'
  query: @sql
    select * from (values
      ('VN', 'Vietnam country manager', 'nhi.ty+mgr.vn@holistics.io'),
      ('DE', 'Germany country manager', 'nhi.ty+mgr.de@holistics.io'),
      ('US', 'United States country manager', 'nhi.ty+mgr.us@holistics.io'),
      ('FR', 'France country manager', 'nhi.ty+mgr.fr@holistics.io'),
      ('AU', 'Australia country manager', 'nhi.ty+mgr.au@holistics.io'),
      ('IN', 'India country manager', 'nhi.ty+mgr.in@holistics.io'),
      ('ID', 'Indonesia country manager', 'nhi.ty+mgr.id@holistics.io'),
      ('GB', 'United Kingdom country manager', 'nhi.ty+mgr.gb@holistics.io'),
      ('KR', 'Korea country manager', 'nhi.ty+mgr.kr@holistics.io'),
      ('SG', 'Singapore country manager', 'nhi.ty+mgr.sg@holistics.io')
    ) as t(country_code, manager_name, manager_email);;

  dimension country_code {
    label: 'Country code'
    type: 'text'
    definition: @sql {{ #SOURCE.country_code }};;
    primary_key: true
  }
  dimension manager_name {
    label: 'Manager name'
    type: 'text'
    definition: @sql {{ #SOURCE.manager_name }};;
  }
  dimension manager_email {
    label: 'Manager email'
    type: 'text'
    definition: @sql {{ #SOURCE.manager_email }};;
  }
}
