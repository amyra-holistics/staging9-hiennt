Model qa6_list_bulk {
  type: 'query'
  label: 'QA6 Partners (large network)'
  description: 'QA6 test data for AI Delivery QA round 6 (per-row recipients). Fictional. Safe to delete.'
  data_source_name: 'demodb'
  query: @sql
    select * from (values
      ('Bulk Partner 01', 'nhi.ty+bulk01@holistics.io', 2),
      ('Bulk Partner 02', 'nhi.ty+bulk02@holistics.io', 3),
      ('Bulk Partner 03', 'nhi.ty+bulk03@holistics.io', 4),
      ('Bulk Partner 04', 'nhi.ty+bulk04@holistics.io', 5),
      ('Bulk Partner 05', 'nhi.ty+bulk05@holistics.io', 1),
      ('Bulk Partner 06', 'nhi.ty+bulk06@holistics.io', 2),
      ('Bulk Partner 07', 'nhi.ty+bulk07@holistics.io', 3),
      ('Bulk Partner 08', 'nhi.ty+bulk08@holistics.io', 4),
      ('Bulk Partner 09', 'nhi.ty+bulk09@holistics.io', 5),
      ('Bulk Partner 10', 'nhi.ty+bulk10@holistics.io', 1),
      ('Bulk Partner 11', 'nhi.ty+bulk11@holistics.io', 2),
      ('Bulk Partner 12', 'nhi.ty+bulk12@holistics.io', 3),
      ('Bulk Partner 13', 'nhi.ty+bulk13@holistics.io', 4),
      ('Bulk Partner 14', 'nhi.ty+bulk14@holistics.io', 5),
      ('Bulk Partner 15', 'nhi.ty+bulk15@holistics.io', 1),
      ('Bulk Partner 16', 'nhi.ty+bulk16@holistics.io', 2),
      ('Bulk Partner 17', 'nhi.ty+bulk17@holistics.io', 3),
      ('Bulk Partner 18', 'nhi.ty+bulk18@holistics.io', 4),
      ('Bulk Partner 19', 'nhi.ty+bulk19@holistics.io', 5),
      ('Bulk Partner 20', 'nhi.ty+bulk20@holistics.io', 1),
      ('Bulk Partner 21', 'nhi.ty+bulk21@holistics.io', 2),
      ('Bulk Partner 22', 'nhi.ty+bulk22@holistics.io', 3),
      ('Bulk Partner 23', 'nhi.ty+bulk23@holistics.io', 4),
      ('Bulk Partner 24', 'nhi.ty+bulk24@holistics.io', 5),
      ('Bulk Partner 25', 'nhi.ty+bulk25@holistics.io', 1)
    ) as t(partner, contact_email, policies_approaching_cancellation);;

  dimension partner {
    label: 'Partner'
    type: 'text'
    definition: @sql {{ #SOURCE.partner }};;
    primary_key: true
  }
  dimension contact_email {
    label: 'Contact email'
    type: 'text'
    definition: @sql {{ #SOURCE.contact_email }};;
  }
  dimension policies_approaching_cancellation {
    label: 'Policies approaching cancellation'
    type: 'number'
    definition: @sql {{ #SOURCE.policies_approaching_cancellation }};;
  }
}
