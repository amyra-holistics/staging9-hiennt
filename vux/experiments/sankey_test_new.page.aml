const ikea_local_tokens = {
  primary: "oklch(0.45 0.15 250)"
  secondary: "oklch(0.88 0.17 92)"
  background: "oklch(0.96 0.01 90)"
  canvas_bg: "oklch(0.975 0.005 90)"
  block_bg: "oklch(1 0 0)"
  text_primary: "oklch(0.28 0.06 250)"
  text_muted: "oklch(0.45 0.03 250)"
  text_subtle: "oklch(0.60 0.02 250)"
  border: "oklch(0.86 0.02 250)"
  success: "oklch(0.55 0.14 145)"
  danger: "oklch(0.54 0.19 28)"
  font: "Inter"
}

ColorPalette ikea_local_palette {
  title: "IKEA-inspired local palette"
  categorical {
    colors: [
      "oklch(0.45 0.15 250)",
      "oklch(0.88 0.17 92)",
      "oklch(0.62 0.16 35)",
      "oklch(0.58 0.15 145)",
      "oklch(0.60 0.14 190)",
      "oklch(0.57 0.17 315)",
      "oklch(0.62 0.15 55)",
      "oklch(0.52 0.13 285)"
    ]
  }
}

Dashboard sankey_test_new {
  title: 'Sankey Test New'
  description: ''''''
  block f1: FilterBlock {
    label: 'This is a Filter Block'
    type: 'text'
    default {
      operator: 'is'
      value: 'default'
    }
  }
  block v4: VizBlock {
    label: 'Name and Parent'
    viz: DataTable {
      dataset: ecommerce_dataset
      fields: [
        VizFieldFull {
          ref: ref('ecommerce_categories_2', 'name')
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: ref('ecommerce_categories_2', 'parent_id')
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        show_row_number: true
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v5: VizBlock {
    label: 'Sum of Cost and Sum of Sales by Month'
    viz: LineChart {
      dataset: ecommerce_dataset
      x_axis: VizFieldFull {
        ref: ref('ecommerce_financial', 'month_')
        format {
          type: 'date'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: ref('ecommerce_financial', 'cost')
            aggregation: 'sum'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#0058A3'
            color_palette: 'seq-magma'
          }
        }
        series {
          field: VizFieldFull {
            ref: ref('ecommerce_financial', 'sales')
            aggregation: 'sum'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#C89211'
            color_palette: 'seq-magma'
          }
        }
      }
    }
  }
  block v6: VizBlock {
    label: 'Untitled Report'
    viz: DataTable {
      dataset: vinhhh_test_activities
      theme {

      }
      fields: [
        VizFieldFull {
          ref: ref('public_activities', 'trackable_type')
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: ref('public_activities', 'owner_type')
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: ref('public_activities', 'key')
          format {
            type: 'text'
          }
        }
      ]
      settings {
        show_row_number: true
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_rtlz: VizBlock {
    label: 'Source, Target, and Sum of Weight'
    viz: CustomChart {
      dataset: sankey_test
      custom_chart_id: 21692
      field source: VizFieldFull {
        ref: r(sankey_data_csv.source)
        format {
          type: 'text'
        }
      }
      field target: VizFieldFull {
        ref: r(sankey_data_csv.target)
        format {
          type: 'text'
        }
      }
      field volume: VizFieldFull {
        ref: r(sankey_data_csv.weight)
        aggregation: 'sum'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      setting margin_top: 10
      setting node_align: 'justify'
      setting node_width: 15
      setting margin_left: 10
      setting margin_right: 10
      setting node_padding: 10
      setting margin_bottom: 10
    }
  }
  block v_6xjx: VizBlock {
    label: 'Source, Target, and Sum of Weight copy'
    viz: DataTable {
      dataset: sankey_test
      fields: [
        VizFieldFull {
          ref: r(sankey_data_csv.source)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(sankey_data_csv.target)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(sankey_data_csv.weight)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        show_row_number: true
      }
    }
  }
  view: TabLayout {
    label: 'View 1'
    tab tab1: CanvasLayout {
      label: 'Tab 1'
      width: 950
      height: 680
      block v_rtlz {
        position: pos(10, 10, 930, 420)
        layer: 2
      }
      block v_6xjx {
        position: pos(10, 430, 930, 240)
        layer: 2
      }
      mobile {
        mode: 'manual'
        block v1
        block filter_block
        block v2
      }
    }
    tab tab2: CanvasLayout {
      label: 'Tab 2'
      height: 800
      grid_size: 20
      mobile {
        mode: 'auto'
      }
      block f1 {
        position: pos(20, 20, 400, 80)
        layer: 1
      }
      block v4 {
        position: pos(440, 20, 620, 420)
        layer: 2
      }
      block v5 {
        position: pos(20, 460, 620, 320)
        layer: 3
      }
      block v6 {
        position: pos(20, 120, 330, 220)
        layer: 4
      }
    }
  }
  theme: DynamicPageTheme {
    light {
      background {
        bg_color: 'oklch(0.96 0.01 90)'
      }
      canvas {
        border {
          border_width: 0
          border_radius: 4
          border_color: 'oklch(0.86 0.02 250)'
          border_style: 'none'
        }
        background {
          bg_color: 'oklch(0.975 0.005 90)'
        }
        shadow: 'none'
        opacity: 1
      }
      block {
        label {
          font_family: 'Inter'
          font_color: 'oklch(0.28 0.06 250)'
          font_size: 14
          font_weight: 'semibold'
          font_style: 'normal'
          letter_spacing: '0'
        }
        text {
          font_family: 'Inter'
          font_color: 'oklch(0.45 0.03 250)'
          font_size: 13
          font_weight: 'normal'
          font_style: 'normal'
        }
        border {
          border_width: 1
          border_radius: 4
          border_color: 'oklch(0.86 0.02 250)'
          border_style: 'solid'
        }
        background {
          bg_color: 'oklch(1 0 0)'
        }
        padding: 16
        shadow: 'none'
        opacity: 1
      }
      custom_css: @css .dac-text-block {
  font-family: Inter;
  font-size: 14px;
  color: oklch(0.45 0.03 250);
  line-height: 1.6;
}
.dac-text-block h1, .dac-text-block h2, .dac-text-block h3, .dac-text-block h4, .dac-text-block h5, .dac-text-block h6 {
  font-family: Inter;
  color: oklch(0.28 0.06 250);
  line-height: 1.3;
  margin-top: 0;
  margin-bottom: 0.5em;
  font-weight: 600;
};;
      viz {
        table {
          general {
            bg_color: 'oklch(1 0 0)'
